{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh *)",
      "Bash(make *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(mypy *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(isort *)",
      "Bash(pylint *)",
      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(stylelint *)",
      "Bash(source *)",
      "Bash(./*)",
      "Bash(curl -sf http://localhost:*)",
      "mcp__playwright",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__get_page_text",
      "Skill"
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v caffeinate >/dev/null 2>&1 || exit 0; sid=$(jq -r '.session_id // \"default\"'); pf=\"/tmp/claude-caffeinate-$sid.pid\"; if ! { [ -f \"$pf\" ] && kill -0 \"$(cat \"$pf\")\" 2>/dev/null; }; then caffeinate -dimsu -w $PPID >/dev/null 2>&1 & echo $! > \"$pf\"; fi",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "make yo 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sid=$(jq -r '.session_id // \"default\"'); pf=\"/tmp/claude-caffeinate-$sid.pid\"; [ -f \"$pf\" ] && kill \"$(cat \"$pf\")\" 2>/dev/null; rm -f \"$pf\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "make yo 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "remember@claude-plugins-official": true
  }
}
