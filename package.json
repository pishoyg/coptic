{
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/jest": "^30.0.0",
    "clean-css": "^5.3.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-yml": "^3.3.2",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "prettier": "^3.8.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "webpack": "^5.106.2",
    "yaml-eslint-parser": "^2.0.0",
    "zod": "^4.4.3"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.json"
        ],
        "options": {
          "printWidth": 1
        }
      },
      {
        "files": [
          "docs/**/*.json"
        ],
        "options": {
          "tabWidth": 1
        }
      }
    ],
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true
  },
  "dependencies": {
    "@playwright/cli": "^0.1.8",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.4.0"
  }
}
