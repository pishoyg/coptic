      }
    ],
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true
  },
  "dependencies": {
    "@playwright/cli": "^0.1.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "jiti": "^2.7.0",
    "js-yaml": "^4.3.0",
    "jsdom": "^27.4.0",
    "marked": "^18.0.5"
  }
}
