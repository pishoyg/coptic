{
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml-eslint-parser": "^2.1.0",
    "zod": "^4.6.5"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.json"
        ],
        "options": {
          "printWidth": 1
        }
      },
      {
        "files": [
          "docs/**/*.json"
        ],
        "options": {
          "tabWidth": 1
        }
      }
    ],
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true
  },
  "dependencies": {
    "@types/jsdom": "^30.0.0",
    "jiti": "^2.7.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14"
  }
}
