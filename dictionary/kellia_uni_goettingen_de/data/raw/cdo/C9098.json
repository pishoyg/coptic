  "examples": [
    {
      "coptic": "ⲉϣϫⲉ ⲟⲩ**ⲉⲩⲫⲣⲟⲥⲩⲛⲏ** ⲛⲛⲣⲱⲙⲉ ⲡⲉ ⲡⲏⲣⲡ ⲛϩⲩⲗⲓⲕⲟⲥ ⲡⲁⲓ ⲉⲩϣⲁⲛⲣϩⲟⲩⲟ ⲥⲱ ⲉⲃⲟⲗ ⲛϩⲏⲧϥ ϣⲁⲩϯϩⲉ · ⲁⲩⲱ ϣⲁⲣⲉⲟⲩⲙⲛⲧϣⲛⲁ ϣⲱⲡⲉ ⲛϩⲏⲧϥ · ⲉⲓⲉ ⲟⲩⲏⲣ ⲧⲉ ⲧⲉⲩⲫⲣⲟⲥⲩⲛⲏ ⲙⲛⲡⲣⲁϣⲉ ⲛⲛⲣⲱⲙⲉ ⲛⲧⲁⲩⲥⲱ ⲉⲃⲟⲗ ϩⲛⲧⲡⲏⲅⲏ ⲙⲙⲟⲟⲩ ⲛⲱⲛϩ ⲡⲉⲭⲣⲓⲥⲧⲟⲥ ·",
      "english": "If material wine be the joy of men, the which when they drink it to excess causeth them to become drunk, and there is arrogance therein, how very much more joy and gladness will those men have who have drunk of the Fountain of living water, the Christ!",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯⲥⲱⲧⲙ ⲉⲡⲁϯⲧⲁⲡⲣⲟ ⲉⲧϩⲟⲗϭ ⲁⲩⲱ ⲉⲧⲙⲏϩ ⲛ**ⲉⲩⲫⲣⲟⲥⲩⲛⲏ** ⲛⲓⲙ",
      "english": "Hearken unto my speech, which is sweet and is filled with gladness of every kind!",
      "source": "Discourse on Abbaton part 1",
      "urn": "urn:cts:copticLit:pstimothy.abbaton.budge:1-21",
      "dialect": "sahidic"
    },
