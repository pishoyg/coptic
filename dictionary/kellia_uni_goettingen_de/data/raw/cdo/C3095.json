  "examples": [
    {
      "coptic": "ϯⲟⲩⲱϣ ⲇⲉ ⲛⲧⲉ**ⲣⲱⲙⲓ** ⲛⲓⲃⲉⲛ ϣⲱⲡⲓ ⲙⲡⲁⲣⲏϯ ⲁⲗⲗⲁ ⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ⲟⲩⲟⲛⲧⲉϥ ⲟⲩϩⲙⲟⲧ ⲙⲙⲁⲩ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲫⲛⲟⲩϯ ⲡⲓⲟⲩⲁⲓ ⲙⲉⲛ ⲙⲡⲁⲓⲣⲏϯ ⲕⲉⲟⲩⲁⲓ ⲇⲉ ⲙⲡⲁⲓⲕⲉⲣⲏϯ .",
      "english": "Yet I wish that all men were like me. However each man has his own gift from God, one of this kind, and another of that kind.",
      "source": "Bohairic 1 Corinthians 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲁⲓ ⲉⲣⲉⲡⲉϥⲣⲁⲛ ⲙⲉⲛ ϩⲛⲛ**ⲣⲱⲙⲉ** ⲡⲉ ⲁⲫⲟⲩ",
      "english": "The one whose name among men is Aphou",
      "source": "Life of Apa Aphou part 1",
      "urn": "urn:cts:copticLit:lives.aphou.paths_ed:0-61",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣⲱⲡ ⲅⲁⲣ ⲛⲧⲉⲟⲩⲁⲓ ϫⲟⲥ ϫⲉⲁⲛⲟⲕ ⲙⲉⲛ ⲁⲛⲟⲕ ⲫⲁⲡⲁⲩⲗⲟⲥ ⲕⲉⲟⲩⲁⲓ ⲇⲉ ϫⲉⲁⲛⲟⲕ ⲫⲁⲁⲡⲟⲗⲗⲱ ⲟⲩⲭⲓ ⲛⲑⲱⲧⲉⲛ ϩⲁⲛ**ⲣⲱⲙⲓ** .",
      "english": "For when one says, 'I follow Paul,' and another, 'I follow Apollos,' aren't you fleshly?",
      "source": "Bohairic 1 Corinthians 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲓⲙ ⲅⲁⲣ ⲛ**ⲣⲱⲙⲉ** ⲡⲉⲧⲥⲟⲟⲩⲛ ⲛⲛⲁⲡⲣⲱⲙⲉ ⲉⲓⲙⲏⲧⲓ ⲡⲉⲡⲛⲉⲩⲙⲁ ⲙⲡⲣⲱⲙⲉ ⲉⲧⲛϩⲏⲧϥ . ⲧⲁⲓ ⲟⲛ ⲧⲉ ⲧϩⲉ ⲛⲛⲁⲡⲛⲟⲩⲧⲉ ⲙⲡⲉⲗⲁⲁⲩ ⲥⲟⲩⲱⲛⲟⲩ ⲛⲥⲁⲡⲉⲡⲛⲉⲩⲙⲁ ⲙⲡⲛⲟⲩⲧⲉ .",
      "english": "For who among men knows the things of a man, except the spirit of the man, which is in him? Even so, no one knows the things of God, except God&apos;s Spirit.",
      "source": "46_1 Corinthians_2",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲫⲣⲏϯ ⲛⲟⲩ**ⲣⲱⲙⲓ** ⲉⲁϥⲙⲟϣⲓ ⲉⲡϣⲉⲙⲙⲟ ⲉⲁϥⲭⲱ ⲙⲡⲉϥⲏⲓ ⲟⲩⲟϩ ⲁϥϯ ⲛⲛⲉϥⲉⲃⲓⲁⲓⲕ ⲙⲡⲓⲉⲣϣⲓϣⲓ ⲫⲟⲩⲁⲓ ⲫⲟⲩⲁⲓ ⲙⲡⲉϥϩⲱⲃ ⲟⲩⲟϩ ⲁϥϩⲟⲛϩⲉⲛ ⲉⲧⲟⲧϥ ⲙⲡⲓⲉⲙⲛⲟⲩⲧ ϩⲓⲛⲁ ⲛⲧⲉϥⲣⲱⲓⲥ",
      "english": "It is like a man, traveling to another country, having left his house, and given authority to his servants, and to each one his work, and also commanded the doorkeeper to keep watch.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣⲱⲡⲉ ⲅⲁⲣ ⲉⲣϣⲁⲛⲟⲩ**ⲣⲱⲙⲉ** ⲕⲱ ⲛⲥⲱϥ ⲛⲟⲩⲁ ϩⲛⲛⲁⲓ · ϥⲣⲱϣⲉ ⲁⲛ ⲛϭⲓⲡⲕⲉⲟⲩⲁ ⲉⲧⲁϩⲉ ⲡⲣⲱⲙⲉ ⲉⲣⲁⲧϥ ·",
      "english": "Now if it happen that a man omitteth (to keep) one of those precepts, it will not be sufficient for him to put another in its place;",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
