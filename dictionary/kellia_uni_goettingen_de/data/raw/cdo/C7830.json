  "examples": [
    {
      "coptic": "ⲁⲓⲁⲙⲁϩⲧⲉ ⲉϫⲛⲧⲉϥⲙⲉⲥⲧϩⲏⲧ ϩⲛⲛⲁⲟⲩⲉⲣⲏⲧⲉ ⲉⲓⲁϩⲉⲣⲁⲧ ⲉⲓⲙⲟⲩⲧⲉ ⲟⲩⲃⲉⲛⲉⲥⲛⲏⲩ ⲉϯⲛⲁⲩ ⲉⲣⲟⲟⲩ ⲙⲡⲁⲕⲱⲧⲉ ⲉⲩⲥⲟⲛⲧ ⲛⲥⲱⲓ ϩⲙⲡⲉⲓⲁⲅⲱⲛ ⲧⲏⲣϥ ϫⲉ**ϭⲱⲡⲉ** ⲙⲡⲉⲓⲕⲉⲟⲩⲁ .",
      "english": "I prevailed against his hatred with my feet, as I stood calling to the brethren I saw around me looking after me in all this struggle: 'seize this other one!'",
      "source": "In the Night: BV278-282",
      "urn": "urn:cts:copticLit:shenoute.night.monbbv:1-7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧⲉⲩⲛⲟⲩ ⲛⲉⲧⲟⲩⲁⲁⲃ ⲧⲏⲣⲟⲩ ⲛⲁϯ ⲙⲡⲉⲩⲟⲩⲟⲓ ⲉϩⲟⲩⲛ ⲉⲣⲟⲟⲩ ⲡⲟⲩⲁ ⲡⲟⲩⲁ ⲛⲁ**ϭⲱⲡⲉ** ⲛⲛⲉⲧⲉⲛⲟⲩϥ ⲛⲉ ⲟⲩⲟⲛ ⲛⲓⲙ ·",
      "english": "And straightaway all the saints shall rush forward towards them, and each one shall seize upon those that belong to him.",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲡⲁⲉⲓⲱⲧ ⲧϩⲏⲙⲉ ⲙⲡϫⲟⲉⲓ ⲟⲩⲛⲟϭ ⲧⲉ ⲁⲩⲱ ⲡⲉⲧϣϣⲉ ⲉⲣⲟⲕ ⲡⲉ ⲉⲧⲣⲉⲛⲃⲱⲕ ⲛⲁⲛ ⲧⲁⲭⲏ · ⲙⲏⲡⲟⲧⲉ ⲛⲥⲉⲉⲓ ⲉϫⲱⲛ ⲥⲉⲥⲟⲩⲛⲉⲛ ⲛⲥⲉ**ϭⲟⲡ**ⲛ ⲛⲧⲉⲟⲩϣⲓⲡⲉ ϣⲱⲡⲉ ⲛⲁⲛ · ϫⲉⲁⲛⲡⲱⲧ ⲛϫⲓⲟⲩⲉ ·",
      "english": "and he said unto him, 'My father, the ship's fare is large, and it is meet for thee that we should depart quickly, lest some people meet us, and they recognize us, and they seize us, and we be put to shame. Therefore, let us flee secretly.'",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    }
