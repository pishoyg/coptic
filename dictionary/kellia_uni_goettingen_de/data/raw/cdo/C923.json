  "examples": [
    {
      "coptic": "ⲡⲁⲗⲓⲛ ⲟⲛ ⲉϣϫⲉ ⲉⲕϫⲡⲟ ⲉⲃⲟⲗ ϩⲛϩⲉⲛϩⲓⲥⲉ ⲛⲇⲓⲕⲁⲓⲟⲛ **ⲛⲅⲧⲙⲉⲓⲛⲉ **ⲉϩⲟⲩⲛ**** ⲙⲡⲛⲟⲩⲧⲉ ⲛϩⲉⲛⲡⲣⲟⲥⲫⲟⲣⲁ · ⲛⲁⲓ ⲉϣⲁⲣⲉⲛϩⲏⲕⲉ ⲥⲁⲛϣ ⲉⲃⲟⲗ ⲛϩⲏⲧⲟⲩ · ⲥⲉⲛⲁⲟⲡⲟⲩ ⲉⲣⲟⲕ ⲉⲩⲧⲱⲣⲡ ·",
      "english": "And moreover, if thou dost acquire possessions through thine honest labour, and thou dost not bring unto God offerings from the same, whereon the poor shall feed themselves, yet they shall be accounted unto you as things plundered,",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲟⲛ ϩⲱⲱⲛ **ⲙⲁⲣⲛⲉⲓⲛⲉ **ⲉϩⲟⲩⲛ**** ⲛⲧⲉⲛⲁⲥⲕⲏⲥⲓⲥ ·",
      "english": "let us bring as an offering (to Him) our life of self-denial.",
      "source": "On Penitence and Abstinence, part 2",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:120-241",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ **ⲛⲧⲛⲉⲓⲛⲉ **ⲉϩⲟⲩⲛ**** ⲙⲡϣⲁϫⲉ ⲙⲡⲛⲟⲩⲧⲉ · ⲛⲧⲛⲕⲁⲁϥ ⲛⲁⲛⲟⲩ · ⲛⲧⲛⲟϫϥ ⲉⲡⲉⲥⲏⲧ ⲉϩⲉⲛⲕⲁⲍⲟⲫⲩⲗⲁⲕⲓⲟⲛ · ⲙⲯⲩⲭⲓⲕⲟⲛ · ⲉⲧⲣⲉⲛϯⲛⲏⲧⲛ ⲙⲡⲉⲧⲁⲣⲟⲛ ·",
      "english": "and we will bring this address as (an offering) to God, and will set it aside and cast it into the spiritual treasury, and (thus) shall we discharge our debt (of a discourse) to you.",
      "source": "On Susanna",
      "urn": "urn:cts:copticLit:pschrysostom.susanna.budge:1-63",
      "dialect": "sahidic"
    }
  ],
