  "examples": [
    {
      "coptic": "ⲁⲙⲏⲛ ϯϫⲱ ⲙⲙⲟⲥ ⲛⲱⲧⲉⲛ ϫⲉⲛⲛⲉⲧⲁⲓ**ⲅⲉⲛⲉⲁ** ⲥⲓⲛⲓ ϣⲁⲧⲉⲛⲁⲓ ⲧⲏⲣⲟⲩ ϣⲱⲡⲓ .",
      "english": "Most certainly I say to you, this generation will not pass away until all these things happen.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲁϥⲟⲩⲱϣⲃ ⲉϥϫⲱ ⲙⲙⲟⲥ ⲛⲁⲩ . ϫⲉⲱ ⲧ**ⲅⲉⲛⲉⲁ** ⲛⲁⲧⲛⲁϩⲧⲉ ϣⲁⲧⲛⲁⲩ ⲉⲓⲛⲁϣⲱⲡⲉ ⲛⲙⲙⲏⲧⲛ . ϣⲁⲧⲛⲁⲩ ⲉⲓⲛⲁⲁⲛⲉⲭⲉ ⲙⲙⲱⲧⲛ ⲁⲩⲉⲓⲥϥ ⲛⲁⲓ .",
      "english": "He answered him, &apos;Unbelieving generation, how long shall I be with you? How long shall I bear with you? Bring him to me.&apos;",
      "source": "41_Mark_9",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲑⲁⲓ ⲧⲉ ϯ**ⲅⲉⲛⲉⲁ** ⲛⲧⲉⲛⲏⲉⲧⲕⲱϯ ⲛⲥⲁⲡϭⲟⲓⲥ: ⲉⲧⲕⲱϯ ⲛⲥⲁⲡϩⲟ ⲙⲫⲛⲟⲩϯ ⲛⲓⲁⲕⲱⲃ .",
      "english": "This is the generation of them that seek him, that seek the face of the God of Jacob. Pause.",
      "source": "19_Psalmi_23",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:23",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉϥⲁϣⲁϩⲟⲙ ϩⲙⲡⲉϥⲡⲛⲉⲩⲙⲁ ⲡⲉϫⲁϥ ϫⲉⲉⲧⲃⲉⲟⲩ ⲧⲉⲓⲅⲉⲛⲉⲁ ⲕⲱⲧⲉ ⲛⲥⲁⲟⲩⲙⲁⲉⲓⲛ ϩⲁⲙⲏⲛ ϯϫⲱ ⲙⲙⲟⲥ ⲛⲏⲧⲛ ϫⲉⲉϣⲱⲡⲉ ⲥⲉⲛⲁϯⲙⲁⲉⲓⲛ ⲛⲧⲉⲓ**ⲅⲉⲛⲉⲁ** .",
      "english": "He sighed deeply in his spirit, and said, &apos;Why does this generation seek a sign? Most certainly I tell you, no sign will be given to this generation.&apos;",
      "source": "Mark Chapter 8",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:8",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲓⲛⲁⲧⲉⲛⲑⲱⲛ ⲧⲁⲓ**ⲅⲉⲛⲉⲁ** ⲇⲉ ⲉⲛⲓⲙ ⲥⲟⲛⲓ ⲛϩⲁⲛⲁⲗⲱⲟⲩⲓ ⲉⲩϩⲉⲙⲥⲓ ϩⲓⲛⲓⲁⲅⲟⲣⲁ ⲛⲁⲓ ⲉⲑⲙⲟⲩϯ ⲟⲩⲃⲉ ⲛⲟⲩⲉⲣⲏⲩ",
      "english": "'But to what shall I compare this generation? It is like children sitting in the marketplaces, who call to their companions",
      "source": "01_Matthew_11",
      "urn": "urn:cts:copticLit:nt.matt.bohairic:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲕϣⲱⲡⲉ ⲙⲡⲓⲥⲧⲟⲥ ϩⲛⲧⲉⲛ**ⲅⲉⲛⲉⲁ** · ⲁⲩⲱ ⲛⲇⲓⲕⲁⲓⲟⲥ ϩⲛⲛⲉⲛϩⲟⲟⲩ ⁛—",
      "english": "Thou wast a man who was a believer in our generation, and a man who was righteous in our days.",
      "source": "Life of Pisentius part 2",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:32-58",
      "dialect": "sahidic"
    }
  ],
