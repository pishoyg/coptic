  "examples": [
    {
      "coptic": "ⲥⲱⲧⲉⲙ ⲉⲡⲥⲁϫⲓ ⲙⲡϭⲟⲉⲓⲥ ⲛⲏⲉⲧ**ⲥⲑⲉⲣⲧⲉⲣ** ϧⲁⲧϩⲏ ⲛⲛⲉϥⲥⲁϫⲓ ⲁϫⲟⲥ ⲛⲛⲏⲉⲑⲙⲟⲥϯ ⲙⲙⲱⲧⲉⲛ ⲟⲩⲟϩ ⲉⲧⲱⲣⲉⲃ ⲙⲙⲱⲧⲉⲛ ϫⲉⲛⲑⲱⲧⲉⲛ ⲛⲉⲛⲥⲛⲏⲟⲩ ϩⲓⲛⲁ ⲛⲧⲉⲫⲣⲁⲛ ⲙⲡϭⲟⲉⲓⲥ : ϭⲓⲱⲟⲩ ⲟⲩⲟϩ ⲛⲧⲉϥⲟⲩⲟⲛϩϥ ϧⲉⲛⲡⲟⲩⲟⲩⲛⲟϥ ⲟⲩⲟϩ ⲛⲏⲉⲧⲉⲙⲙⲁⲩ ⲛⲧⲟⲩϭⲓϣⲓⲡⲓ .",
      "english": "Hear the words of the Lord, ye that tremble at his word; speak ye, our brethren, to them that hate you and abominate you, that the name of the Lord may be glorified, and may appear their joy; but they shall be ashamed.",
      "source": "23_Isaias_66",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:66",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲟⲧⲉ ⲁⲥϣⲓⲃⲉ ⲛϭⲓⲧⲙⲟⲣⲫⲏ ⲙⲡⲣⲣⲟ ⲁⲩⲱ ⲁⲩϣⲧⲣⲧⲱⲣϥ ⲛϭⲓⲛⲉϥⲙⲉⲉⲩⲉ ⲁⲩⲃⲱⲗ ⲉⲃⲟⲗ ⲛϭⲓⲛⲙⲣⲣⲉ ⲛⲧⲉϥϯⲡⲉ ⲁⲛⲉϥⲡⲁⲧ **ⲥⲧⲣⲧⲣ**",
      "english": "Then the king's countenance changed, and his thoughts troubled him, and the joints of his loins were loosed, and his knees smote one another.",
      "source": "Daniel 5",
      "urn": "urn:cts:copticLit:ot.dan.coptot:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲛⲁⲩ ⲉⲣⲟϥ ⲛϫⲉⲡⲓⲡⲛⲉⲩⲙⲁ ⲥⲁⲧⲟⲧϥ ⲁϥϣⲧⲉⲣⲑⲱⲣϥ ⲟⲩⲟϩ ⲉⲧⲁϥϩⲉⲓ ⲉϫⲉⲛⲡⲕⲁϩⲓ ⲛⲁϥ**ⲥⲑⲉⲣⲧⲉⲣ** ⲡⲉ ⲉⲣⲉⲣⲱϥ ϫⲉϣⲥⲫⲏⲓϯ ⲉⲃⲟⲗ .",
      "english": "They brought him to him, and when he saw him, immediately the spirit convulsed him, and he fell on the ground, wallowing and foaming at the mouth.",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
