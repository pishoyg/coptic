  "examples": [
    {
      "coptic": "ϣⲁⲩⲧⲣⲉⲩⲕⲱⲧⲉ ϩⲛⲟⲩ**ϫⲛⲁϩ** ϣⲁⲛⲧⲟⲩⲟⲩⲃⲁϣ ·",
      "english": "until it turns white,",
      "source": "Apophthegmata Patrum Sahidic 029",
      "urn": "urn:cts:copticLit:ap.29.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉⲥϫⲓⲧϥ ⲇⲉ ⲛ**ϫⲛⲁϩ**",
      "english": "But when she had compelled him by force,",
      "source": "Apophthegmata Patrum Sahidic 099: Anonymous N 293",
      "urn": "urn:cts:copticLit:ap.99.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲛⲟⲙⲟⲥ ⲅⲁⲣ ⲕⲉⲗⲉⲩⲉ ϫⲉⲉⲣϣⲁⲛⲟⲩⲣⲱⲙⲉ ⲛⲕⲟⲧⲕ ⲙⲛⲟⲩϣⲉⲉⲣⲉ ϣⲏⲙ · ⲙⲡⲟⲩϣⲡⲧⲟⲟⲧⲥ · ⲛϥϫⲓⲧⲥ ⲛ**ϫⲛⲁϩ** · ⲛϥϣⲱⲡⲉ ⲛⲙⲙⲁⲥ · ⲉϥⲉϯⲧⲉϭⲣⲏⲏⲡⲉ ⲛⲁⲥ ⲛⲁⲧϣⲁⲩ ⲛⲧⲉϭⲣⲏⲏⲡⲉ ⲛⲙⲡⲁⲣⲑⲉⲛⲟⲥ ·",
      "english": "For the Law commandeth : 'If a man lie with a maiden unto whom he hath not been betrothed, and he take her by force, and he be [found] with her, he shall give fifty 'crowns' to her [father], now fifty shekels is the proper price of a virgin,",
      "source": "Life of Pisentius part 3",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:58-84",
      "dialect": "sahidic"
    }
