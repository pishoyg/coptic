  "examples": [
    {
      "coptic": "ⲉⲧⲁⲩⲥⲱⲧⲉⲙ ⲇⲉ ⲉⲛⲁⲓ ⲛϫⲉⲛⲓⲥⲛⲏⲟⲩ ⲛⲧⲟⲧϥ ⲙⲡⲓϧⲉⲗⲗⲟ ⲉⲑⲟⲩⲁⲃ ⲁⲩⲉⲣϣⲫⲏⲣⲓ ⲟⲩⲟϩ ⲁⲩϯⲱⲟⲩ ⲙⲫⲛⲟⲩϯ ⲫⲁⲓ ⲉⲧ**ϭⲱⲣⲡ** ⲛⲛⲉϥⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲉⲃⲟⲗ ⲛⲛⲏ ⲉⲧⲉⲙⲡϣⲁ ⲙⲙⲱⲟⲩ ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲥϧⲏⲟⲩⲧ ϫⲉⲉⲩⲉⲛⲁⲩ ⲛϫⲉⲛⲏ ⲉⲧⲉⲙⲡⲟⲩⲛⲁⲩ ⲟⲩⲟϩ ⲛⲏ ⲉⲧⲥⲱⲧⲉⲙ ⲙⲡⲟⲩⲕⲁϯ .",
      "english": "When the brethren heard these words of the holy old man, they were filled with admiration and gave glory to God, who has made his mysteries manifest to those who are worthy, for it is written, ‘They that see not shall see, and those that hear shall not understand.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛϥ**ϭⲱⲗⲡ** ⲁⲛ ⲉⲣⲱⲧⲛ ⲛⲛⲉϥⲙⲩⲥⲧⲏⲣⲓⲟⲛ .",
      "english": "as he doesn’t reveal his mysteries to you.”",
      "source": "Apophthegmata Patrum Sahidic 090: Olympius",
      "urn": "urn:cts:copticLit:ap.90.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲓ ϣⲁⲣⲟϥ ⲉϥϯϩⲟ ⲉⲣⲟϥ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲉⲡⲉⲓⲇⲏ ⲁⲡⲟⲩⲣⲟ ⲟⲩⲱⲣⲡ ⲛⲥⲱⲓ ⲛⲧⲁϯ ⲡⲗⲟⲅⲟⲥ ⲛⲛⲓⲇⲏⲙⲟⲥⲓⲟⲛ ⲛⲁϥ ⲉϧⲟⲩⲛ ⲉⲑⲃⲉⲫⲁⲓ ϯϯϩⲟ ⲉⲣⲟⲕ ⲉⲑⲣⲉⲕⲧⲱⲃϩ ⲙⲡϭⲟⲉⲓⲥ ⲉϩⲣⲏⲓ ⲉϫⲱⲓ ⲛⲧⲉϥ**ϭⲱⲣⲡ** ⲛⲁⲕ ⲉⲃⲟⲗ ⲛⲛⲏ ⲉⲑⲛⲁϣⲱⲡⲓ ⲙⲙⲟⲓ ϩⲓⲛⲁ ⲛⲧⲁϯ ⲡⲑⲱϣ ⲙⲡⲁⲏⲓ",
      "english": "And he went to him to beseech him, and said, “Since the king has sent for me to give him an account of the public money, I beg you to implore the Lord for me in this matter, that he may reveal to you what will happen to me, and that I may put my house in order.”",
      "source": "Life of Isaac of Alexandria - part 2",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:20-41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲁⲡⲥⲱⲧⲏⲣ **ϭⲗⲡ**ⲛⲁⲓ ⲛⲁⲛ ⲉⲃⲟⲗ",
      "english": "because the Saviour hath revealed this unto us,",
      "source": "Pistis Sophia Book 1 Part 1",
      "urn": "urn:cts:copticLit:pistissophia.1.petermann:1-13",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩϣⲓⲡⲓ ⲛⲧⲉⲧϣⲉⲣⲓ ⲛⲟⲩϣⲏⲣⲓ ⲛⲧⲁⲕ ⲓⲉ ⲧϣⲉⲣⲓ ⲛⲟⲩϣⲉⲣⲓ ⲛⲛⲉⲕ**ϭⲟⲣⲡ**ϥ ⲉⲃⲟⲗ ϫⲉⲟⲩⲏⲓ ⲅⲁⲣ ⲟⲩϣⲓⲡⲓ ⲛⲧⲁⲕ ⲡⲉ",
      "english": "The nakedness of thy son's daughter, or thy daughter's daughter, their nakedness thou shalt not uncover; because it is thy nakedness.",
      "source": "03_Leviticus_18",
      "urn": "urn:cts:copticLit:ot.lev.bohairic_ed:18",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲙⲛⲡⲉⲧϩⲟⲃⲥ ⲅⲁⲣ ⲉⲛⲥⲉⲛⲁ**ϭⲟⲗⲡ**ϥ ⲁⲛ ⲉⲃⲟⲗ . ⲟⲩⲇⲉ ⲙⲙⲛⲡⲉⲧϩⲏⲡ ⲉⲛϥⲛⲁⲟⲩⲱⲛϩ ⲁⲛ ⲉⲃⲟⲗ .",
      "english": "For there is nothing hidden, except that it should be made known; neither was anything made secret, but that it should come to light.",
      "source": "Mark Chapter 4",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:4",
      "dialect": "sahidic"
    }
