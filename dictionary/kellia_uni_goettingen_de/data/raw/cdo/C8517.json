  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲙⲡⲣϭⲱⲛⲧ ⲉⲣⲟⲓ ⲉⲓϣⲓⲛⲉ ⲅⲁⲣ ⲛⲥⲁϩⲱⲃ ⲛⲓⲙ ϩⲛⲟⲩⲱⲣϫ ⲙⲛⲟⲩ**ⲁⲥⲫⲁⲗⲓⲁ** ⲉⲧⲃⲉⲧϩⲉ ⲉⲛⲛⲁⲕⲏⲣⲩⲥⲥⲉ ⲙⲙⲟⲥ ⲛⲣⲣⲱⲙⲉ ⲙⲡⲕⲟⲥⲙⲟⲥ ·",
      "english": "“and be not wroth with me, for I question concerning all things with surety and certainty for knowledge of the manner, how we are to herald it to the men of the world.”",
      "source": "Pistis Sophia Book 3 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:82-86",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲁⲓ ϭⲉ ⲛⲧⲉⲣⲉϥϫⲟⲟⲩ ⲛϭⲓⲡⲥⲱⲧⲏⲣ ⲁⲥϥⲟϭⲥ ⲉⲃⲟⲗ ⲛϭⲓⲙⲁⲣⲓⲁ ⲧⲙⲁⲅⲇⲁⲗⲏⲛⲏ ⲡⲉϫⲁⲥ · ϫⲉⲡⲁϫⲟⲉⲓⲥ ϥⲓ ϩⲁⲣⲟⲓ ⲁⲩⲱ ⲙⲡⲣϭⲱⲛⲧ ⲉⲣⲟⲓ ⲉⲓϣⲓⲛⲉ ⲛⲥⲁϩⲱⲃ ⲛⲓⲙ ϩⲛⲟⲩⲱⲣϫ ⲙⲛⲟⲩ**ⲁⲥⲫⲁⲗⲓⲁ** · ⲧⲉⲛⲟⲩ ϭⲉ ⲡⲁϫⲟⲉⲓⲥ ⲉⲓⲉ ⲟⲩⲉⲧⲡϣⲁϫⲉ ⲙⲡⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲙⲡⲓⲁⲧϣⲁϫⲉ ⲉⲣⲟϥ ⲁⲩⲱ ⲟⲩⲉⲧⲡϣⲁϫⲉ ⲙⲡⲥⲟⲟⲩⲛ ⲧⲏⲣϥ ·",
      "english": "“When then the Saviour had said this, Mary Magdalene started forward and said: My Lord, bear with me and be not wroth with me, if I question on all things with precision and certainty. Now, therefore, my Lord, is then another the word of the mystery of the Ineffable and another the word of the whole gnosis?”",
      "source": "Pistis Sophia Book 2 Part 7",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:66-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲉⲛⲟⲩ ϭⲉ ⲙⲁⲣⲓⲁ ⲡⲁⲓ ⲡⲉ ⲡϣⲁϫⲉ ⲉⲧⲉϣⲓⲛⲉ ⲙⲙⲟⲓ ⲉⲣⲟϥ ϩⲛⲟⲩⲱⲣϫ ⲙⲛⲟⲩ**ⲁⲥⲫⲁⲗⲓⲁ** ⲗⲟⲓⲡⲟⲛ ϭⲉ ⲧⲉⲛⲟⲩ ⲡⲉⲧⲉⲟⲩⲛⲙⲁⲁϫⲉ ⲙⲙⲟϥ ⲉⲥⲱⲧⲙ · ⲙⲁⲣⲉϥⲥⲱⲧⲙ ·",
      "english": "“Now, therefore, Mary, this is the word concerning which thou dost question me with precision and certainty. For the rest now then, who hath ears to hear, let him hear.”",
      "source": "Pistis Sophia Book 2 Part 5",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:49-58",
      "dialect": "sahidic"
    }
  ],
