  "examples": [
    {
      "coptic": "ⲉⲛⲁϥⲙⲉⲩⲓ ⲇⲉ ⲡⲉ ϫⲉⲥⲉⲛⲁⲕⲁϯ ⲛϫⲉⲛⲉϥⲥⲛⲏⲟⲩ ϫⲉⲫⲛⲟⲩϯ ⲛⲁϯ ⲛⲟⲩ**ⲟⲩϫⲁⲓ** ⲛⲱⲟⲩ ⲉⲃⲟⲗ ϩⲓⲧⲟⲧϥ ⲛⲑⲱⲟⲩ ⲇⲉ ⲙⲡⲟⲩⲕⲁϯ .",
      "english": "He supposed that his brothers understood that God, by his hand, was giving them deliverance; but they didn't understand.",
      "source": "05_Acts_07",
      "urn": "urn:cts:copticLit:nt.acts.bohairic:07",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲕⲁⲕⲏⲕⲉⲫⲁⲗⲏ · ⲉⲕⲥⲱⲃⲉ ⲙⲙⲟⲓ ϩⲛϩⲉⲛϩⲃⲏⲩⲉ ⲙⲙⲁⲅⲓⲁ · ϣⲉⲡ**ⲟⲩϫⲁⲓ** ⲙⲡⲁⲡⲟⲗⲗⲱⲛ · ⲧⲉⲕϯⲙⲱⲣⲓⲁ ⲡⲉ ⲁⲛϩⲁⲗⲓⲥⲕⲉ ⲙⲡⲉⲕⲥⲱⲙⲁ ϩⲙⲡⲕⲱϩⲧ ·",
      "english": "O wicked head! I swear by the health of Apollo that thy punishment shall be the destruction of thy body by fire.'",
      "source": "Martyrdom of Victor part 7",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:67-85",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥϣⲉⲛⲁϥ ⲇⲉ ⲛϫⲉⲙⲱⲩⲥⲏⲥ ⲟⲩⲟϩ ⲁϥⲧⲁⲥⲑⲟ ϩⲁⲓⲟⲑⲟⲣ ⲡⲉϥϣⲟⲙ ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉϯⲛⲁϣⲉⲛⲏⲓ ⲟⲩⲟϩ ⲛⲧⲁⲧⲁⲥⲑⲟ ϩⲁⲛⲁⲥⲛⲏⲟⲩ ⲉⲧϧⲉⲛⲭⲏⲙⲓ ⲟⲩⲟϩ ⲛⲧⲁⲛⲁⲩ ϫⲉⲁⲛ ⲉⲧⲓ ⲥⲉⲟⲛϧ ⲟⲩⲟϩ ⲡⲉϫⲉ ⲓⲟⲑⲟⲣ ⲙⲙⲱⲩⲥⲏⲥ ϫⲉⲙⲁϣⲉⲛⲁⲕ ϧⲉⲛⲟⲩ**ⲟⲩϫⲁⲓ** ⲙⲉⲛⲉⲛⲥⲁⲛⲓⲉϩⲟⲟⲩ ⲇⲉ ⲉⲧⲟϣ ⲉⲧⲉⲙⲙⲁⲩ ⲁϥⲙⲟⲩ ⲛϫⲉⲡⲟⲩⲣⲟ ⲛⲭⲏⲙⲓ",
      "english": "And Moses went and returned to Jothor his father-in-law, and says, I will go and return to my brethren in Egypt, and will see if they are yet living. And Jothor said to Moses, Go in health. And in those days after some time, the king of Egypt died.",
      "source": "02_Exodus_04",
      "urn": "urn:cts:copticLit:ot.exod.bohairic_ed:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϣⲉⲡ**ⲟⲩϫⲁⲓ** ⲙⲡⲁⲡⲟⲗⲗⲱⲛ · ⲧⲉⲕϯⲙⲱⲣⲓⲁ ⲡⲉ ⲁⲛϩⲁⲗⲓⲥⲕⲉ ⲙⲡⲉⲕⲥⲱⲙⲁ ϩⲙⲡⲕⲱϩⲧ · ⲛⲅⲥⲟⲟⲩⲛ ⲁⲛ ϫⲉⲛⲧⲁⲡⲣⲣⲟ · ϫⲟⲟⲩ ⲛⲁⲓ ⲉⲧⲣⲁⲣⲟⲩ ⲛⲁⲕ ·",
      "english": "By the health of Apollo, this is thy punishment: we are to destroy thy body by fire. Knowest thou not that it is the emperor who hath commanded me what I am to do unto thee?",
      "source": "Martyrdom of Victor part 4",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:23-32",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲙⲟⲛ **ⲟⲩϫⲁⲓ** ϣⲟⲡ ⲛⲧⲁⲥⲁⲣ ⲉⲃⲟⲗ ϩⲁⲡϩⲟ ⲙⲡⲉⲕϫⲱⲛⲧ ⲟⲩⲟϩ ⲙⲙⲟⲛ ϩⲓⲣⲏⲛⲏ ϣⲟⲡ ⲛⲛⲁⲕⲁⲥ ⲉⲃⲟⲗ ϩⲁⲡϩⲟ ⲛⲛⲁⲛⲟⲃⲓ .",
      "english": "For there is no health in my flesh because of thine anger; there is no peace to my bones because of my sins.",
      "source": "19_Psalmi_37",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:37",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲛϥⲓⲡⲣⲟⲟⲩϣ ϭⲉ ⲛⲧⲁⲓ · ⲛⲧⲛⲧⲙⲕⲁϭⲉⲗⲁⲁⲩ ⲛⲧⲡⲉ ⲙⲡⲉⲥ**ⲟⲩϫⲁⲓ** ⲉⲃⲟⲗ ϫⲉⲧⲁⲓ ⲧⲉⲧⲟⲩⲛⲁⲧⲁϩⲟⲥ ⲉⲣⲁⲧⲥ ⲉⲕⲣⲓⲛⲉ ⲙⲙⲟⲥ ⲁⲩⲱ ⲉⲧⲣⲉⲥⲁⲡⲟⲗⲟⲅⲓⲍⲉ ϩⲓⲡⲃⲏⲙⲁ ⲉⲧⲙⲙⲁⲩ ·",
      "english": "Let us take exceedingly great care that we do not permit anything whatsoever to become of more importance than the health of the soul, for it is the soul which will be set up to be judged, and it is the soul which will have to defend (the body) before that Throne.",
