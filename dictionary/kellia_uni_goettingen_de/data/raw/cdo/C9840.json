      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓⲥϩⲏⲏⲧⲉ ⲁⲓⲟⲩⲱⲛϩ ⲉⲣⲟⲕ ⲁⲓⲟⲩⲱⲛϩ ⲉⲣⲟⲕ ⲛⲙ**ⲙⲩⲥⲧⲏⲣⲓⲟⲛ** ⲧⲏⲣⲟⲩ ·",
      "english": "Behold, I have made clear to you all mysteries.'",
      "source": "Mysteries of John the Evangelist part 2",
      "urn": "urn:cts:copticLit:misc.mysteries_john.budge:13-28",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲡⲁⲓⲱⲧ ⲙⲡⲣⲟⲫⲏⲧⲏⲥ ⲛⲏⲓ ϫⲉⲡϭⲟⲉⲓⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲭⲣⲓⲥⲧⲟⲥ ⲡⲉ ⲡⲉⲧⲁϥⲕⲏⲛ ϧⲁⲧⲟⲧ ϯⲛⲟⲩ ⲉϥϫⲱ ⲉⲣⲟⲓ ⲛϩⲁⲛ**ⲙⲩⲥⲧⲏⲣⲓⲟⲛ** .",
      "english": "He replied, ‘It was the Lord Jesus Christ himself, speaking to me in divine mysteries.’",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲱ ⲡⲉⲓ**ⲙⲩⲥⲧⲏⲣⲓⲟⲛ** ⲛⲛⲃⲣⲣⲉ ⲁⲩⲱ ⲛⲁⲧⲧⲁϩⲟϥ ·",
      "english": "O what a new and incomprehensible mystery!",
      "source": "On the Soul and Body",
      "urn": "urn:cts:copticLit:psathanasius.soul_body.budge:1-91",
      "dialect": "sahidic"
