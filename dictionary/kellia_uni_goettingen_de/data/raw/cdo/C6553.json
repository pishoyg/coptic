  "examples": [
    {
      "coptic": "ⲁⲗⲗⲁ ⲉϥϣⲁⲛ**ⲣϩⲗⲗⲟ** · ⲁϥⲙⲧⲟⲛ ⲛⲁϣ ⲛϩⲉ ·",
      "english": "But surely when he shall have become an old man (he will rejoice, and take rest)? In what way, then, will he have rest?",
      "source": "On the Soul and Body",
      "urn": "urn:cts:copticLit:psathanasius.soul_body.budge:1-91",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲣⲁ ⲉⲕⲉⲩⲫⲣⲁⲛⲉ ⲛⲧⲉⲣⲉⲕ**ⲣϩⲗⲗⲟ** ·",
      "english": "Didst thou, peradventure, enjoy thyself when thou didst become an old man?",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲙⲡⲧⲣⲉϥϫⲟⲟⲥ ϫⲉⲟⲩⲃⲣⲣⲉ ⲁϥⲣⲧϣⲟⲣⲡ ⲛⲁⲥ . ⲡⲉⲛⲧϥⲣⲁⲥ ⲇⲉ ⲁⲩⲱ ⲁϥ**ⲣϩⲗⲗⲟ** ϥϩⲏⲛ ⲉϩⲟⲩⲛ ⲉⲡⲧⲁⲕⲟ .",
      "english": "In that he says, 'A new covenant,' he has made the first old. But that which is becoming old and grows aged is near to vanishing away.",
      "source": "58_Hebrews_8",
      "urn": "urn:cts:copticLit:nt.heb.sahidica:8",
      "dialect": "sahidic"
    }
