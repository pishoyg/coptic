  "examples": [
    {
      "coptic": "ⲙⲡⲣⲧⲣⲉⲡⲁⲅⲁⲑⲟⲥ ⲛⲛⲟⲩⲧⲉ ⲗⲩⲡⲉⲓ ⲉⲧⲃⲉⲧⲏⲩⲧⲛ · ⲡⲛⲁⲏⲧ ⲛϣⲁⲛϩⲧⲏϥ · ⲡ**ⲁⲧⲧⲱⲗⲙ** · ⲡⲁⲧϫⲃⲓⲛ · ⲡⲁⲧⲧⲁϩⲟϥ · ⲡⲟⲩⲁ ⲙⲁⲩⲁⲁϥ · ⲡⲁⲧⲡⲱⲱⲛⲉ · ⲡⲁⲧⲕⲣⲟϥ · ⲡⲁⲧϭⲱⲛⲧ · ⲡⲣⲁⲛ ⲉⲧϩⲓϫⲛⲣⲁⲛ ⲛⲓⲙ · ⲉϣⲁⲩⲛⲟⲉⲓ ⲙⲙⲟϥ ·",
      "english": "Do not make to grieve through you the Good God, the Merciful, the Long-suffering, Him Who is without spot, Him Who is without blemish, the Ineffable, the God Who is One alone, the Unchanging One, Him Who is without guile, Him Who is without wrath, the Name which is above every name which men can comprehend.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉⲥⲥⲱⲧⲙ ⲇⲉ ⲉⲛⲉⲓϣⲁϫⲉ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧ ⲁⲛⲥⲙⲛⲧⲥ ⲙⲛⲛⲉⲛⲉⲣⲏⲩ ⲉⲧⲣⲉⲛϩⲁⲣⲉϩ ⲉⲛⲉⲛⲥⲱⲙⲁ ⲉⲩⲟ ⲛ**ⲁⲧⲧⲱⲗⲙ** ·",
      "english": "And when she had heard these words from me we made a compact together to keep our bodies unpolluted.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣϫⲉ ⲛⲧⲟⲕ ϭⲉ · ⲛⲧⲕⲟⲩϥⲛⲧ ⲛⲅⲛⲁϣϥⲓ ⲉⲣⲟⲕ ⲁⲛ ⲉⲡⲁⲓ ⲉⲓⲉ ⲛⲁϣ ⲛϩⲉ ⲡⲛⲟⲩⲧⲉ ⲡⲉⲓ**ⲁⲧⲧⲱⲗⲙ** · ⲡⲁⲧϣⲃⲓⲛ · ⲡⲉⲧⲟⲩⲁⲁⲃ ⲉϥⲛⲁⲟⲩⲱϩ ϩⲛϩⲏⲧⲕ ⲉⲕϣⲟⲟⲡ ϩⲙⲡⲗⲟⲓϩⲉ ⲙⲡⲧⲱⲗⲙ ⲙⲡⲉⲥϯⲃⲱⲱⲛ ·",
      "english": "If now, thou who art a worm, art not able to endure this (mire), how is it possible for God, Who is spotless, and without blemish, and holy, to dwell within thee when thou art immersed in the mire of filth and corruption?",
      "source": "The Asceticon of Apa Ephrem part 1",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:1-23",
      "dialect": "sahidic"
    }
