  "examples": [
    {
      "coptic": "ⲉⲧⲁϥⲛⲁⲩ ⲇⲉ ⲛϫⲉⲡⲟⲩⲣⲟ ⲉⲡⲁⲓⲛⲓϣϯ ⲛϭⲱⲣⲡ ⲉⲃⲟⲗ ⲁϥⲧⲱⲙⲧ ⲟⲩⲟϩ ⲁϥϫⲟⲥ ⲛⲟⲩⲁⲓ ⲛⲛⲏ ⲉⲑⲙⲟϣⲓ ⲛⲉⲙⲁϥ ϫⲉⲙⲁϣⲉ ⲛⲁⲕ ⲙⲟⲩϯ ⲉⲡⲓⲁⲣⲭⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲛⲏⲓ ⲉϥⲟⲩⲱϣ ⲉⲉⲙⲓ ⲉⲑⲃⲉϫⲉϯ**ⲇⲩⲛⲁⲙⲓⲥ** ⲉⲧⲕⲱϯ ⲉⲣⲟϥ ϫⲉⲛⲓⲙ ⲡⲉ ⲫⲁⲓ ⲉⲧⲥⲁϫⲓ ⲛⲉⲙⲁϥ ϧⲉⲛⲡⲓⲙⲱⲓⲧ ⲉⲧⲉϥⲟϩⲓ ⲉⲣⲁⲧϥ ϩⲓϫⲱϥ .",
      "english": "When the king saw this great vision, he was amazed and said to one of those who accompanied him: “Go, call the archbishop”; for he wanted to know why this virtue surrounded him and who it was that spoke to him in the place and stood above him.",
      "source": "Life of Isaac of Alexandria - part 3",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:42-48",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲉϥϩⲣⲟⲕ ⲛϭⲓⲡⲕⲱϩⲧ · ⲛⲧⲉⲡⲕⲁⲕⲉ ⲁⲛⲁⲭⲱⲣⲉⲓ ⲛⲁϥ · ⲛⲧⲉⲡⲉⲭⲁⲟⲥ ⲣϭⲱⲃ · ⲛⲧⲉⲧⲉϩⲣⲱ ⲛⲥⲁⲧⲉ ϣⲱⲡⲉ ⲛⲁⲧϭⲟⲙ · ⲛⲧⲉⲧⲅⲉϩⲉⲛⲛⲁ ⲱϣⲙ · ⲁⲩⲱ ⲛⲥⲉⲟⲩⲁϩⲟⲩ ⲛⲥⲱⲓ ⲛϭⲓⲛⲁⲅⲅⲉⲗⲟⲥ ⲉⲧⲟⲩⲁⲁⲃ · ⲛⲧⲉⲛⲇⲁⲓⲙⲟⲛⲓⲟⲛ ⲣϩⲟⲧⲉ · ⲛⲥⲉⲟⲩⲱϣϥ ⲛϭⲓⲛⲁⲣⲭⲱⲛ · ⲛⲧⲉⲛ**ⲇⲩⲛⲁⲙⲓⲥ** ⲙⲡⲕⲁⲕⲉ ⲁⲛⲁⲭⲱⲣⲉⲓ ⲛⲁⲩ ⲛⲥⲉϩⲉ ⲉⲡⲉⲥⲏⲧ ⲛⲧⲉⲛⲧⲟⲡⲟⲥ ⲉⲧϩⲓⲟⲩⲛⲁⲙ ⲁϩⲉⲣⲁⲧⲟⲩ ·",
      "english": "Let the fire die down, and let the darkness withdraw itself, and let Chaos become helpless, and let the furnace of blazing fire be without power, and let Gehenna be extinguished, and let the holy angels accompany me. Let the Places which are on the right hand stand on their feet.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲙⲟⲩ ⲉⲣⲟϥ ⲛⲉϥⲁⲅⲅⲉⲗⲟⲥ ⲧⲏⲣⲟⲩ ⲥⲙⲟⲩ ⲉⲣⲟϥ ⲛⲉϥ**ⲇⲩⲛⲁⲙⲓⲥ** ⲧⲏⲣⲟⲩ",
      "english": "Praise ye him, all his angels: praise ye him, all his hosts.",
      "source": "19_Psalmi_148",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:148",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲙⲁⲕⲁⲣⲓⲟⲥ ⲡⲁⲩⲗⲟⲥ ⲡⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲛⲛϩⲉⲑⲛⲟⲥ ⲡⲉⲛⲧⲁϥϣⲱⲡⲉ ⲛⲥⲁϩ ⲛⲧⲉⲕⲕⲗⲏⲥⲓⲁ ⲡⲉⲛⲧⲁϥⲁⲅⲱⲛⲓⲍⲉ ⲉⲧⲛⲧⲱⲛϥ ⲉⲛ**ⲇⲩⲛⲁⲙⲓⲥ** ⲛⲁⲥⲱⲙⲁⲧⲟⲥ ϩⲛⲧⲉϥⲡⲟⲗⲩⲧⲧⲓⲁ ·",
      "english": "If the blessed man Paul, the Apostle of the Gentiles,",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϧⲉⲛⲡⲥⲁϫⲓ ⲙⲡϭⲟⲓⲥ ⲁⲩⲧⲁϫⲣⲟ ⲛϫⲉⲛⲓⲫⲏⲟⲩⲓ: ⲟⲩⲟϩ ⲛⲟⲩ**ⲇⲩⲛⲁⲙⲓⲥ** ⲧⲏⲣⲟⲩ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲡⲓⲡⲛⲉⲩⲙⲁ ⲛⲧⲉⲣⲱϥ",
      "english": "By the word of the Lord the heavens were established; and all the host of them by the breath of his mouth.",
      "source": "19_Psalmi_32",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:32",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲇⲓⲱⲕⲉ ⲛⲧⲥⲟⲫⲓⲁ ϩⲣⲁⲓ ϩⲙⲡⲙⲉϩⲙⲛⲧϣⲟⲙⲧⲉ ⲛⲁⲓⲱⲛ ⲉⲧⲣⲉⲥϭⲱϣⲧ ⲉⲙⲙⲉⲣⲟⲥ ⲙⲡⲉⲥⲏⲧ . ϫⲉⲉⲥⲉⲛⲁⲩ ⲉⲧⲉϥ**ⲇⲩⲛⲁⲙⲓⲥ** ⲛⲟⲩⲟⲉⲓⲛ ⲙⲡⲙⲁ ⲉⲧⲙⲙⲁⲩ . ⲧⲁⲓ ⲉⲧⲟ ⲛϩⲟ ⲙⲙⲟⲩⲓ . ⲁⲩⲱ ⲛⲥⲉⲡⲓⲑⲩⲙⲓ ⲉⲣⲟⲥ . ⲛⲥⲉⲓ ⲉⲡⲧⲟⲡⲟⲥ ⲉⲧⲙⲙⲁⲩ ⲛⲥⲉϥⲓ ⲙⲡⲉⲥⲟⲩⲟⲉⲓⲛ ⲛϩⲏⲧⲥ .",
      "english": "pursued Sophia in the thirteenth æon, in order that she should look towards the parts below, so that she might see in that region his lion-faced light-power and long after it and go to that region, so that her light might be taken from her.",
      "source": "Pistis Sophia Book 1 Part 3",
      "urn": "urn:cts:copticLit:pistissophia.1.petermann:25-35",
      "dialect": "sahidic"
    }
