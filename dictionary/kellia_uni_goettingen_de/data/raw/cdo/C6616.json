  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲓⲱϩⲁⲛⲛⲏⲥ ⲁϥϣⲁϫⲉ ⲙⲛⲡⲛⲉⲉϥ ⲙⲡϫⲟⲉⲓ ⲉϥϫⲱ ⲙⲙⲟⲥ · ϫⲉϯⲡⲁⲣⲁⲕⲁⲗⲉⲓ ⲙⲙⲟⲕ ⲡⲁⲥⲟⲛ ⲉⲧⲣⲕⲡⲉⲗⲕⲧ**ϩⲏⲙⲉ** ⲛⲙⲙⲁⲛ · ϫⲉⲕⲁⲥ ⲉⲕⲉϫⲓ ⲙⲙⲟⲛ ⲙⲡⲉⲥⲛⲁⲩ ⲉⲧⲙⲟⲛⲏ ⲛⲛⲉⲧⲉⲙⲉⲩⲛⲕⲟⲧⲕ ·",
      "english": "And John spake unto the captain of a ship, saying, 'I charge thee, my brother, to halve the fare in our case, for then thou wilt be able to take the two of us to the Monastery of the Sleepless Ones.'",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁϥⲧⲱⲟⲩⲛ ⲛϭⲓⲓⲱⲛⲁⲥ ⲉⲡⲱⲧ ⲉⲑⲁⲣⲥⲉⲓⲥ ⲛⲛⲁϩⲣⲛⲡϩⲟ ⲙⲡϫⲟⲉⲓⲥ : ⲁⲩⲱ ⲁϥⲃⲱⲕ ⲉϩⲣⲁⲓ ⲉⲓⲟⲡⲏ : ⲁϥϭⲛⲟⲩϫⲟⲉⲓ ⲉϥⲛⲁⲥϭⲏⲣ ⲉⲑⲁⲣⲥⲉⲓⲥ ⲁϥϯⲧⲉϥ**ϩⲏⲙⲉ** ⲁϥⲧⲁⲗⲉ ⲉⲣⲟϥ : ⲉⲥϭⲏⲣ ⲛⲙⲙⲁϥ ⲉⲑⲁⲣⲥⲉⲓⲥ ⲛⲛⲁϩⲣⲛⲡϩⲟ ⲙⲡϫⲟⲉⲓⲥ :",
      "english": "But Jonas rose up to flee to Tharsis from the presence of the Lord. And he went down to Joppa, and found a ship going to Tharsis: and he paid his fare, and went up into it, to sail with them to Tharsis from the presence of the Lord.",
      "source": "Jonah Chapter 1 (Sahidic)",
      "urn": "urn:cts:copticLit:ot.jonah.coptot_ed:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉϥⲡⲱϩ ⲇⲉ ⲉⲡⲉⲕⲣⲟ ⲛⲧϩⲁⲗⲁⲥⲁ · ⲁϥϣⲓⲛⲉ ⲛⲥⲁⲧⲉϥ**ϩⲏⲙⲉ** ⲛⲧⲟⲟⲧϥ ⲉⲙⲛⲧⲁϥ ⲇⲉ ⲙⲙⲁⲩ ⲉϯ ·",
      "english": "And when the captain arrived at the shore of the sea he asked Eustathius for his passage money, but he had it not to give to him;",
      "source": "History of Eustathius and Theopiste part 1",
      "urn": "urn:cts:copticLit:lives.eustathius.budge:1-30",
      "dialect": "sahidic"
    }
