  "examples": [
    {
      "coptic": "ⲡⲁⲗⲓⲛ ⲟⲩⲛ ⲛⲁⲩϣⲓⲛⲓ ⲙⲙⲟϥ ⲛϫⲉⲛⲓⲫⲁⲣⲓⲥⲁⲓⲟⲥ ϫⲉⲡⲱⲥ ⲁⲕⲛⲁⲩ ⲙⲃⲟⲗ ⲛⲑⲟϥ ⲇⲉ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲟⲩ**ⲟⲙⲓ** ⲡⲉⲧⲁϥⲭⲁϥ ⲉϫⲉⲛⲛⲁⲃⲁⲗ ⲟⲩⲟϩ ⲁⲓⲓⲁⲧ ⲉⲃⲟⲗ ⲁⲓⲛⲁⲩ ⲙⲃⲟⲗ .",
      "english": "Again therefore the Pharisees also asked him how he received his sight. He said to them, 'He put mud on my eyes, I washed, and I see.'",
      "source": "04_John_09",
      "urn": "urn:cts:copticLit:nt.john.bohairic:09",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥϫⲓ ⲙⲡ**ⲟⲙⲉ** ⲛⲧⲟⲟⲧϥ ⲙⲡⲁⲅⲅⲉⲗⲟⲥ ⲁϥⲧⲁⲙⲓⲟ ⲛⲁⲇⲁⲙ · ⲕⲁⲧⲁⲡⲉⲛⲉⲓⲛⲉ ⲙⲛⲧⲉⲛϩⲓⲕⲱⲛ · ⲁϥⲕⲁⲁϥ ⲉϥⲛⲏϫ ⲉⲃⲟⲗ ⲛϩⲙⲉ ⲛϩⲟⲟⲩ ⲙⲛϩⲙⲉ ⲛⲟⲩϣⲏ ⲙⲡⲉϥϯⲡⲛⲉⲩⲙⲁ ⲉⲣⲟϥ ·",
      "english": "And He took the clay from the hand of the angel, and made Adam according to Our image and likeness, and He left him lying for forty days and forty nights without putting breath into him.",
      "source": "Discourse on Abbaton part 1",
      "urn": "urn:cts:copticLit:pstimothy.abbaton.budge:1-21",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲙⲱⲟⲩ ⲉϥⲑⲟⲩⲏⲧ ⲥⲟⲕϥ ⲛⲉ ⲁⲙⲟⲛⲓ ⲛⲛⲉⲧⲁϫⲣⲟ ⲙⲁϣⲉⲛⲉ ⲉϧⲣⲏⲓ ⲉⲟⲩ**ⲟⲙⲓ** ⲟⲩⲟϩ ϩⲱⲙⲓ ϧⲉⲛϩⲁⲛⲧⲟϩ ⲟⲩⲟϩ ⲁⲙⲟⲛⲓ ⲉϩⲟⲧⲉ ⲟⲩⲧⲱⲃⲓ .",
      "english": "Draw thee water for a siege, and well secure thy strong-holds: enter into the clay, and be thou trodden in the chaff, make the fortifications stronger than brick.",
      "source": "34_Nahum_03",
      "urn": "urn:cts:copticLit:ot.nah.bohairic_ed:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲏⲏⲧⲕ ⲱ ⲁⲇⲁⲙ ⲡϣⲏⲣⲉ ⲙⲡⲛⲟⲩⲧⲉ ⲛⲁϣⲡ ⲛⲁⲓ ⲧⲏⲣⲟⲩ ϣⲁⲛⲧⲉϥⲥⲱⲧⲉ ⲙⲙⲟⲕ ⲛϥⲕⲟⲧⲕ ⲉⲡⲡⲁⲣⲁⲇⲓⲥⲟⲥ ⲛⲕⲉⲥⲟⲡ · ⲉⲡⲙⲁ ⲛⲧⲁⲕⲉⲓ ⲉⲃⲟⲗ ⲛϩⲏⲧϥ ⲛϣⲟⲣⲡ ϫⲉⲁϥϣⲡⲧⲱⲱⲣⲉ ⲙⲙⲟⲕ ⲉⲕⲟ ⲛ**ⲟⲙⲉ** ⲙⲡⲁⲧϥϯⲡⲛⲉⲩⲙⲁ ⲉⲣⲟⲕ ·",
      "english": "For thy sake, O Adam, the Son of God shall suffer all these things until He hath redeemed thee, and restored thee to Paradise, unto the place whence thou didst come, for He made Himself to be thy advocate (or, protector), when thou wast clay, before He put spirit (or, breath) into thee.'",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲩⲉϣⲱⲡⲓ ⲙⲫⲣⲏϯ ⲛϩⲁⲛⲣⲉϥϯ ⲉⲩϩⲱⲙⲓ ⲛⲟⲩ**ⲟⲙⲓ** ϧⲉⲛⲛⲓⲙⲱⲓⲧ ϧⲉⲛⲟⲩⲡⲟⲗⲉⲙⲟⲥ ⲟⲩⲟϩ ⲉⲩⲉⲃⲱⲧⲥ ϫⲉⲟⲩⲏⲓ ⲡϭⲥ ⲭⲏ ⲛⲉⲙⲱⲟⲩ ⲟⲩⲟϩ ⲉⲩⲉϭⲓϣⲓⲡⲓ ⲛϫⲉⲛⲏⲉⲧⲧⲁⲗⲏⲟⲩⲧ ⲉⲛⲓϩⲑⲱⲣ .",
      "english": "And they shall be as warriors treading clay in the ways in war; and they shall set the battle in array, because the Lord is with them, and the riders on horses shall be put to shame.",
      "source": "38_Zacharias_10",
      "urn": "urn:cts:copticLit:ot.zach.bohairic_ed:10",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩϭⲓϫ ⲛ**ⲟⲙⲉ** ⲟⲩϭⲓϫ ⲛⲕⲁϩ ϩⲓⲕⲣⲙⲉⲥ ⲉⲁⲩⲡⲗⲁⲥⲥⲉ ⲙⲙⲟⲥ ⲉⲃⲟⲗ ϩⲙⲡⲕⲁϩ · ⲁⲥⲧⲟⲗⲙⲁ ⲁⲥϯⲁⲁⲥ ⲉϩⲟⲩⲛ ϩⲙⲡϩⲟ ⲙⲡⲭⲣⲓⲥⲧⲟⲥ ⲡⲉ ⲛⲧⲁϥⲡⲗⲁⲥⲥⲉ ⲛⲧⲡⲉ ⲙⲛⲡⲕⲁϩ · ⲁⲩⲱ ⲁϥϥⲓ ⲉⲣⲟϥ ϩⲛⲟⲩⲑⲃⲃⲓⲟ ·",
      "english": "A hand made of mud, a hand of clay, a hand of dust and ashes, which was fashioned out of the earth, dared to thrust itself into the Face of Christ, Who fashioned the heavens and the earth, and He endured it with humility!",
