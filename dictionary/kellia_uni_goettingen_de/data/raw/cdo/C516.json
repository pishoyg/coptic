  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲩⲉⲣϩⲟϯ ⲧⲏⲣⲟⲩ ϩⲱⲥⲧⲉ ⲛⲧⲟⲩⲕⲱϯ ⲛⲉⲙⲛⲟⲩⲉⲣⲏⲟⲩ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲟⲩ ⲡⲉ ⲫⲁⲓ ⲟⲩⲥⲃⲱ ⲙ**ⲃⲉⲣⲓ** ⲡⲉ ϫⲉϧⲉⲛⲟⲩⲉⲣϣⲓϣⲓ ϥⲟⲩⲁϩⲥⲁϩⲛⲓ ⲛⲛⲓⲡⲛⲉⲩⲙⲁ ⲛⲁⲕⲁⲑⲁⲣⲧⲟⲛ ⲥⲉⲥⲱⲧⲉⲙ ⲛⲁϥ",
      "english": "They were all amazed, so that they questioned among themselves, saying, 'What is this? A new teaching? For with authority he commands even the unclean spirits, and they obey him!'",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲑⲁⲗⲁⲥⲥⲁ ⲛ**ⲃⲣⲣⲉ** ⲉⲥϩⲗⲟⲩⲗⲱⲟⲩ · ⲏ ⲉⲥϫⲟⲥⲉ ·",
      "english": "The new sea, which is vast and deep",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩ ⲅⲁⲣ ⲙⲡⲁⲣⲉϩⲗⲓ ϩⲓⲟⲩⲧⲱⲓⲥ ⲙⲃⲉⲣⲓ ⲉⲟⲩϩⲃⲟⲥ ⲛⲁⲡⲁⲥ ⲙⲙⲟⲛ ϣⲁⲣⲉⲡⲓ**ⲃⲉⲣⲓ** ⲉⲗⲡⲓⲙⲟϩ ⲛⲧⲉⲡⲓⲁⲡⲁⲥ ⲟⲩⲟϩ ⲛⲧⲉⲟⲩⲫⲱϧ ϣⲱⲡⲓ ⲉϥϩⲱⲟⲩ ⲛϩⲟⲩⲟ .",
      "english": "No one sews a piece of unshrunk cloth on an old garment, or else the patch shrinks and the new tears away from the old, and a worse hole is made.",
      "source": "Bohairic Gospel of Mark 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲁⲛⲅⲟⲩⲣⲱⲙⲉ ⲛⲣⲉϥⲣⲛⲟⲃⲉ · ⲁⲩⲱ ⲛ**ⲃⲣⲣⲉ** ·",
      "english": "Rather, I am a sinful and young human.'",
      "source": "Apophthegmata Patrum Sahidic 070",
      "urn": "urn:cts:copticLit:ap.70.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲁⲧⲟⲩⲃⲉⲡⲓϣⲉⲙⲏⲣ ⲛⲁⲡⲁⲥ ⲉⲃⲟⲗ ϧⲉⲛⲑⲏⲛⲟⲩ ϩⲓⲛⲁ ⲛⲧⲉⲧⲉⲛϣⲱⲡⲓ ⲛⲟⲩⲱϣⲉⲙ ⲙ**ⲃⲉⲣⲓ** ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲉⲧⲉⲛⲟⲓ ⲛⲁⲧϣⲉⲙⲏⲣ ⲕⲉ ⲅⲁⲣ ⲡⲉⲛⲡⲁⲥⲭⲁ ⲁⲩϣⲁⲧϥ ⲡⲭⲣⲓⲥⲧⲟⲥ .",
      "english": "Purge out the old yeast, that you may be a new lump, even as you are unleavened. For indeed Christ, our Passover, has been sacrificed in our place.",
      "source": "Bohairic 1 Corinthians 5 (Digital Edition)",
