  "examples": [
    {
      "coptic": "ⲁⲛⲟⲛ ϩⲉⲛϣⲃⲣⲣϩⲱⲃ ⲅⲁⲣ ⲛⲧⲉⲡⲛⲟⲩⲧⲉ ⲟⲩⲙⲁ ⲛ**ⲟⲩⲟⲉⲓⲉ** ⲛⲧⲉⲡⲛⲟⲩⲧⲉ ⲡⲉ . ⲛⲧⲉⲧⲛ ⲟⲩⲕⲱⲧ ⲛⲧⲉⲡⲛⲟⲩⲧⲉ .",
      "english": "For we are God&apos;s fellow workers. You are God&apos;s farming, God&apos;s building.",
      "source": "1 Corinthians 3",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲙⲁⲣⲉⲡⲉⲓϣⲏⲛ ⲛⲧⲉⲓⲙⲓⲛⲉ ⲣⲁⲛⲁϥ ⲉⲛⲉϩ ⲙⲡ**ⲟⲩⲟⲉⲓⲉ** ⲉⲧⲏⲡ ⲉⲧⲡⲉ · ⲡⲁⲓ ⲉⲧϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲓⲉⲓ ⲉⲓϣⲓⲛⲉ ⲛⲥⲁⲕⲁⲣⲡⲟⲥ ⲛⲧⲉⲓⲃⲱ ⲛⲕⲛⲧⲉ · ⲁⲩⲱ ⲙⲡⲉⲓϩⲉ ⲉⲟⲩⲟⲛ ·",
      "english": "In this manner this tree will never give pleasure to the Husbandman Who appertaineth to heaven, Who spake saying, 'I came seeking for fruit on this fig-tree, and I have found none",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ϣⲁⲣⲉⲡ**ⲟⲩⲟⲉⲓⲏ** ⲡⲱϩ ⲙⲡⲉⲧⲗⲟⲙ ⲛⲧⲥⲱϣⲉ ϩⲙⲡϩⲃⲃⲉ · ⲛⲥⲉⲛⲟⲩϫⲉ ⲉⲣⲟϥ ⲙⲡⲉϭⲣⲟϭ ⲙⲡⲥⲏⲩ ⲛⲧⲕⲁⲧⲁⲥⲡⲟⲣⲁ · ⲛⲥⲁⲣⲭⲉⲓ ⲛϯⲟⲩⲱ ⲉϩⲣⲁⲓ ⲛϩⲉⲛϭⲣⲟϭ ⲛϫⲱ ⲕⲁⲧⲁⲅⲉⲛⲟⲥ ·",
      "english": "and the husbandman cleaveth the furrows of the meadow wdth the plough, and casteth the seed into them at the season of sowing. And the grain beginneth to sprout, and the plants which bear grain grow up and ripen, according to their kind.",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    }
