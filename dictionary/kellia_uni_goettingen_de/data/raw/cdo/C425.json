  "examples": [
    {
      "coptic": "ⲛⲁⲓ ⲇⲉ ⲛⲁⲥⲛⲏⲟⲩ ⲁⲓϣⲟⲡⲧⲟⲩ ⲛⲥⲭⲏⲙⲁ ⲉⲣⲟⲓ ⲛⲉⲙⲁⲡⲟⲗⲗⲱ ⲉⲑⲃⲉⲑⲏⲛⲟⲩ ϩⲓⲛⲁ ⲛϧⲣⲏⲓ ⲛϧⲏⲧⲉⲛ ⲛⲧⲉⲧⲉⲛϭⲓⲥⲃⲱ ⲉϣⲧⲉⲙⲉⲣ **ⲥⲁⲃⲟⲗ** ⲛⲛⲏ ⲉⲧⲥϧⲏⲟⲩⲧ ϩⲓⲛⲁ ϫⲉⲛⲛⲉⲟⲩⲁⲓ ϭⲓⲥⲓ ⲙⲙⲟϥ ⲉⲑⲃⲉⲟⲩⲁⲓ ⲉϩⲣⲏⲓ ⲉϫⲉⲛⲡⲉϥϣⲫⲏⲣ .",
      "english": "Now these things, brothers, I have in a figure transferred to myself and Apollos for your sakes, that in us you might learn not to think beyond the things which are written, that none of you be puffed up against one another.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲧⲛⲟⲩϫⲉ ⲛⲧⲁⲓ **ⲥⲁⲃⲟⲗ** ⲙⲙⲟϥ . ⲟⲩϩⲧⲟ ⲛⲗⲁⲃⲥϩⲓⲙⲉ ⲡⲉ ·",
      "english": "The one who casts this away from himself is like a lustful horse.”",
      "source": "Apopthegmata Patrum Sahidic 009: Hyperechius 2",
      "urn": "urn:cts:copticLit:ap.9.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲙⲟⲛ ϩⲗⲓ **ⲥⲁⲃⲟⲗ** ⲙⲡⲓⲣⲱⲙⲓ ⲉϥⲛⲁ ⲉϧⲟⲩⲛ ⲉⲣⲱϥ ⲉⲟⲩⲟⲛ ϣϫⲟⲙ ⲙⲙⲟϥ ⲉⲥⲟϥϥ ⲁⲗⲗⲁ ⲛⲏ ⲉⲑⲛⲏⲟⲩ ⲉⲃⲟⲗ ϧⲉⲛⲣⲱϥ ⲙⲡⲓⲣⲱⲙⲓ .",
      "english": "There is nothing from outside of the man, that going into him can defile him; but the things which proceed out of the man are those that defile the man.",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲏⲡⲟⲧⲉ ⲛⲧⲉⲡⲛⲟⲩⲧⲉ ⲕⲧⲉⲡⲉϥϩⲟ **ⲥⲁⲃⲟⲗ** ⲙⲙⲟ ⲉⲧⲃⲉⲧⲙⲛⲧϫⲁⲥⲓϩⲏⲧ ·",
      "english": "lest God turn His face away from thee because of thine exaltation of heart (or, pride).",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁϥϫⲱ ⲙⲙⲟⲥ ⲛⲱⲟⲩ ⲡⲉ ϫⲉⲛⲑⲱⲧⲉⲛ ⲉⲧⲉⲛⲓⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲧⲟⲓ ⲛⲱⲧⲉⲛ ⲛⲧⲉϯⲙⲉⲧⲟⲩⲣⲟ ⲛⲧⲉⲫⲛⲟⲩϯ ⲛⲏ ⲇⲉ ⲛⲑⲱⲟⲩ ⲉⲧ**ⲥⲁⲃⲟⲗ** ϣⲁⲣⲉⲡⲧⲏⲣϥ ϣⲱⲡⲓ ⲛⲱⲟⲩ ϧⲉⲛϩⲁⲛⲡⲁⲣⲁⲃⲟⲗⲏ",
      "english": "He said to them, 'To you is given the mystery of the Kingdom of God, but to those who are outside, all things are done in parables,",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲓⲱϩⲁⲛⲛⲏⲥ ⲛⲁϥ · ϫⲉⲃⲱⲕ ⲛⲅϫⲟⲟⲥ ⲛⲁⲥ ϫⲉⲡⲉϫⲉⲡⲉⲓⲣⲱⲙⲉ ⲛϩⲏⲕⲉ ⲁⲩⲱ ⲛϭⲱⲃ ⲉⲧ**ⲥⲁⲃⲟⲗ** ⲙⲡⲟⲩⲣⲟ ⲡⲁⲓ ⲛⲧⲁⲣϫⲟⲟⲥ ϫⲉⲛⲟϫϥ ⲉⲃⲟⲗ ·",
      "english": "And John said iinto him, ' Go, and say unto her thus : This poor and diseased man, who is outside the door, and of whom thou didst say, 'Cast him outside,'",
      "source": "The Life of John the Kalybites part 2",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:46-90",
      "dialect": "sahidic"
    }
