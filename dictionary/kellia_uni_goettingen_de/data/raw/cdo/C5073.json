  "examples": [
    {
      "coptic": "ⲛⲑⲟϥ ⲇⲁⲩⲓⲇ ⲁϥϫⲟⲥ ϧⲉⲛⲡⲓⲡⲛⲉⲩⲙⲁ ⲉⲧⲟⲩⲁⲃ ϫⲉⲡⲉϫⲉ ⲡϭⲟⲓⲥ ⲙⲡⲁϭⲟⲓⲥ ϫⲉϩⲉⲙⲥⲓ ⲥⲁⲧⲁ**ⲟⲩⲓⲛⲁⲙ** ϣⲁϯⲭⲁⲛⲉⲕϫⲁϫⲓ ⲥⲁⲡⲉⲥⲏⲧ ⲛⲛⲉⲕϭⲁⲗⲁⲩϫ .",
      "english": "For David himself said in the Holy Spirit, 'The Lord said to my Lord, 'Sit at my right hand, until I make your enemies the footstool of your feet.''",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲙⲉⲛ ϣⲁϥϩⲱⲥ ⲙⲙⲟⲓ ϩⲙⲡⲉϥⲧⲛϩ ⲛ**ⲟⲩⲛⲁⲙ** ·",
      "english": "and me he used to place under his right wing,",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲩϣⲉ ⲛⲱⲟⲩ ⲉϧⲟⲩⲛ ⲉⲡⲓⲙϩⲁⲩ ⲁⲩⲛⲁⲩ ⲉⲟⲩϧⲉⲗϣⲓⲣⲓ ⲉϥϩⲉⲙⲥⲓ ⲥⲁ**ⲟⲩⲓⲛⲁⲙ** ⲉϥϫⲏⲗ ⲛⲟⲩⲥⲧⲟⲗⲏ ⲉⲥⲟⲩⲟⲃϣ ⲟⲩⲟϩ ⲁⲩⲉⲣϩⲟϯ .",
      "english": "Entering into the tomb, they saw a young man sitting on the right side, dressed in a white robe, and they were amazed.",
      "source": "Bohairic Gospel of Mark 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲧⲉⲕ**ⲟⲩⲛⲁⲙ** ⲧⲉ ⲛⲧⲁⲥϣⲟⲡⲧ ⲉⲣⲟⲥ ·",
      "english": "and it is Thy right hand which hath received it.'",
      "source": "On Susanna",
      "urn": "urn:cts:copticLit:pschrysostom.susanna.budge:1-63",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲁⲓ ⲟⲛ ϫⲉⲡⲓⲫⲁϣ ⲁϥϧⲟⲙϧⲉⲙ ⲟⲩⲟϩ ⲟⲛ ϫⲉⲧⲉⲕ**ⲟⲩⲓⲛⲁⲙ** ⲛϭⲟⲉⲓⲥ ⲁⲥⲓⲣⲓⲛⲟⲩϫⲟⲙ .",
      "english": "and also this: ‘the trap has been broken’; and also, ‘Thy right hand, O Lord, hath done wonders.’",
      "source": "Life of Isaac of Alexandria - part 1",
