  "examples": [
    {
      "coptic": "ⲉⲡⲓⲇⲏ ⲛⲓⲓⲟⲩⲇⲁⲓ ⲥⲉⲉⲣⲉⲧⲓⲛ ⲛϩⲁⲛⲙⲏⲓⲛⲓ ⲟⲩⲟϩ ⲛⲓⲟⲩⲉⲓⲛⲓⲛ ⲥⲉⲕⲱϯ ⲛⲥⲁϯ**ⲥⲟⲫⲓⲁ** .",
      "english": "For Jews ask for signs, Greeks seek after wisdom,",
      "source": "Bohairic 1 Corinthians 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲡⲉⲓⲇⲏ ⲛⲓⲟⲩⲇⲁⲓ ϩⲉⲛⲙⲁⲉⲓⲛ ⲛⲉⲧⲟⲩⲁⲓⲧⲉⲓ ⲙⲙⲟⲟⲩ . ⲛϩⲉⲗⲗⲏⲛ ⲇⲉ ⲉⲩϣⲓⲛⲉ ⲛⲥⲁⲟⲩ**ⲥⲟⲫⲓⲁ** .",
      "english": "For Jews ask for signs, Greeks seek after wisdom,",
      "source": "1 Corinthians 1",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲥⲁⲙⲁϩⲓ ⲛϫⲉϯ**ⲥⲟⲫⲓⲁ** ⲉⲃⲟⲗ ϧⲉⲛⲛⲉⲥϩⲃⲏⲟⲩⲓ .",
      "english": "Thus, Wisdom was fulfilled by its deeds.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲱⲧⲛ ⲇⲉ ⲛⲧⲉⲧⲛ ϩⲉⲛⲉⲃⲟⲗ ⲛϩⲏⲧϥ ϩⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲁⲓ ⲉⲛⲧⲁϥϣⲱⲡⲉ ⲛⲁⲛ ⲛ**ⲥⲟⲫⲓⲁ** ⲉⲃⲟⲗ ϩⲓⲧⲙⲡⲛⲟⲩⲧⲉ ⲛⲇⲓⲕⲁⲓⲟⲥⲩⲛⲏ ⲁⲩⲱ ⲛⲧⲃⲃⲟ ⲁⲩⲱ ⲛⲥⲱⲧⲉ .",
      "english": "But of him, you are in Christ Jesus, who was made to us wisdom from God, and righteousness and sanctification, and redemption:",
      "source": "46_1 Corinthians_1",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲟⲩ**ⲥⲟⲫⲓⲁ** ⲛⲧⲉⲫⲛⲟⲩϯ ⲉⲧⲉⲛⲥⲁϫⲓ ⲙⲙⲟⲥ ϧⲉⲛⲟⲩⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲑⲏ ⲉⲧϩⲏⲡ ⲑⲏ ⲉⲧⲁϥⲉⲣϣⲟⲣⲡ ⲛⲑⲁϣⲥ ⲛϫⲉⲫⲛⲟⲩϯ ϧⲁϫⲱⲟⲩ ⲛⲛⲓⲉⲛⲉϩ ⲉⲩⲱⲟⲩ ⲛⲁⲛ .",
      "english": "But we speak God's wisdom in a mystery, the wisdom that has been hidden, which God foreordained before the worlds for our glory,",
      "source": "Bohairic 1 Corinthians 2 (Digital Edition)",
