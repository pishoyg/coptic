  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲩⲉⲣϩⲏⲧⲥ ⲛϯϩⲟ ⲉⲣⲟϥ ϫⲉ**ⲛⲧⲉ**ϥϣⲉ ⲛⲁϥ ⲉⲃⲟⲗ ϧⲉⲛⲛⲟⲩⲑⲟϣ",
      "english": "They began to beg him to depart from their region.",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲛ **ⲛⲧⲉ**ⲡϫⲟⲉⲓⲥ ⲧⲱⲧ ⲛϩⲏⲧ ⲉϫⲱⲛ :",
      "english": "And God will be pleased with us too.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏⲡⲱⲥ **ⲛⲧⲉ**ϥⲓ ⲛⲟⲩϩⲟϯ ϧⲉⲛⲟⲩϩⲟϯ ⲛⲧⲉϥϫⲉⲙⲑⲏⲛⲟⲩ ⲉⲣⲉⲧⲉⲛⲛⲕⲟⲧ .",
      "english": "lest coming suddenly he might find you sleeping.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲛ**ⲧⲉⲧⲛⲧⲙϩⲉⲡⲗⲁⲁⲩ ⲛϩⲱⲃ ⲉⲣⲟⲟⲩ ·",
      "english": "As you do not hide anything from them",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲟⲡⲱⲥ **ⲛⲧⲉ**ϣⲧⲉⲙⲥⲁⲣⲝ ⲛⲓⲃⲉⲛ ϣⲟⲩϣⲟⲩ ⲙⲙⲱⲟⲩ ⲙⲡⲉⲙⲑⲟ ⲙⲫⲛⲟⲩϯ .",
      "english": "that no flesh should boast before God.",
      "source": "Bohairic 1 Corinthians 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ **ⲛ**ⲧⲉⲙⲉⲣⲉⲡⲡⲉⲧϩⲟⲟⲩ , ⲉϩⲟⲩⲉⲡⲡⲉⲧⲛⲁⲛⲟⲩϥ .",
      "english": "And as you loved what is evil, instead of what is good.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    }
  ],
