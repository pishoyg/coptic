  "examples": [
    {
      "coptic": "ⲟⲩ ⲅⲁⲣ ⲙⲡⲁⲣⲉϩⲗⲓ ϩⲓⲟⲩⲧⲱⲓⲥ ⲙⲃⲉⲣⲓ ⲉⲟⲩϩⲃⲟⲥ ⲛ**ⲁⲡⲁⲥ** ⲙⲙⲟⲛ ϣⲁⲣⲉⲡⲓⲃⲉⲣⲓ ⲉⲗⲡⲓⲙⲟϩ ⲛⲧⲉⲡⲓⲁⲡⲁⲥ ⲟⲩⲟϩ ⲛⲧⲉⲟⲩⲫⲱϧ ϣⲱⲡⲓ ⲉϥϩⲱⲟⲩ ⲛϩⲟⲩⲟ .",
      "english": "No one sews a piece of unshrunk cloth on an old garment, or else the patch shrinks and the new tears away from the old, and a worse hole is made.",
      "source": "Bohairic Gospel of Mark 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲱⲥⲧⲉ ⲙⲁⲣⲛⲣϣⲁ ϩⲛⲟⲩⲑⲁⲃ ⲁⲛ ⲛ**ⲁⲥ** . ⲟⲩⲇⲉ ϩⲛⲟⲩⲑⲁⲃ ⲁⲛ ⲛⲕⲁⲕⲓⲁ ϩⲓⲡⲟⲛⲏⲣⲓⲁ . ⲁⲗⲗⲁ ϩⲛϩⲉⲛⲁⲧⲑⲁⲃ ⲛⲧⲃⲃⲟ ϩⲓⲙⲉ .",
      "english": "Therefore let us keep the feast, not with old yeast, neither with the yeast of malice and wickedness, but with the unleavened bread of sincerity and truth.",
      "source": "46_1 Corinthians_5",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲁⲧⲟⲩⲃⲉⲡⲓϣⲉⲙⲏⲣ ⲛ**ⲁⲡⲁⲥ** ⲉⲃⲟⲗ ϧⲉⲛⲑⲏⲛⲟⲩ ϩⲓⲛⲁ ⲛⲧⲉⲧⲉⲛϣⲱⲡⲓ ⲛⲟⲩⲱϣⲉⲙ ⲙⲃⲉⲣⲓ ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲉⲧⲉⲛⲟⲓ ⲛⲁⲧϣⲉⲙⲏⲣ ⲕⲉ ⲅⲁⲣ ⲡⲉⲛⲡⲁⲥⲭⲁ ⲁⲩϣⲁⲧϥ ⲡⲭⲣⲓⲥⲧⲟⲥ .",
      "english": "Purge out the old yeast, that you may be a new lump, even as you are unleavened. For indeed Christ, our Passover, has been sacrificed in our place.",
      "source": "Bohairic 1 Corinthians 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϥⲓ ⲙⲡⲓⲑⲁⲃ ⲛ**ⲁⲥ** ⲉⲃⲟⲗ ⲛϩⲏⲧⲧⲏⲩⲧⲛ ϫⲉⲉⲧⲉⲧⲛⲉϣⲱⲡⲉ ⲛⲟⲩⲟⲩⲱϣⲙ ⲛⲃⲣⲣⲉ ⲕⲁⲧⲁⲧϩⲉ ⲉⲛⲧⲉⲧⲛϩⲉⲛⲁⲧⲑⲁⲃ . ⲕⲁⲓ ⲅⲁⲣ ⲁⲩϣⲱⲱⲧ ⲙⲡⲉⲛⲡⲁⲥⲭⲁ ϩⲁⲣⲟⲛ ⲡⲉⲭⲣⲓⲥⲧⲟⲥ .",
      "english": "Purge out the old yeast, that you may be a new lump, even as you are unleavened. For indeed Christ, our Passover, has been sacrificed in our place.",
      "source": "1 Corinthians 5",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲙⲡⲁⲩϩⲓⲏⲣⲡ ⲙⲃⲉⲣⲓ ⲉⲁⲥⲕⲟⲥ ⲛ**ⲁⲡⲁⲥ** ⲙⲙⲟⲛ ϣⲁⲣⲉⲡⲓⲏⲣⲡ ⲫⲉϧ ⲛⲓⲁⲥⲕⲟⲥ ⲟⲩⲟϩ ϣⲁⲣⲉⲡⲓⲏⲣⲡ ⲧⲁⲕⲟ ⲛⲉⲙⲛⲓⲁⲥⲕⲟⲥ ⲁⲗⲗⲁ ϣⲁⲩϩⲓⲏⲣⲡ ⲙⲃⲉⲣⲓ ⲉⲁⲥⲕⲟⲥ ⲙⲃⲉⲣⲓ .",
      "english": "No one puts new wine into old wineskins, or else the new wine will burst the skins, and the wine pours out, and the skins will be destroyed; but they put new wine into fresh wineskins.'",
      "source": "Bohairic Gospel of Mark 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲙⲉⲣⲉⲗⲁⲁⲩ ⲛⲉϫⲏⲣⲡ ⲛⲃⲣⲣⲉ ⲉϩⲱⲧ ⲛ**ⲁⲥ** ⲉϣⲱⲡⲉ ⲙⲙⲟⲛ ⲡⲏⲣⲡ ⲛⲁⲡⲉϩⲛϩⲱⲧ ⲛⲧⲉⲡⲏⲣⲡ ⲡⲱⲛ ⲉⲃⲟⲗ ⲛⲧⲉⲛϩⲱⲧ ⲧⲁⲕⲟ . ⲁⲗⲗⲁ ⲉϣⲁⲩⲛⲉϫⲏⲣⲡ ⲛⲃⲣⲣⲉ ⲉϩⲱⲧ ⲛⲃⲣⲣⲉ .",
