  "examples": [
    {
      "coptic": "ⲛⲁⲓ ⲇⲉ ⲙⲉⲩⲣⲃⲟⲗ ⲉ**ϣⲏⲃⲉ** ϩⲓϫⲟⲟⲗⲉⲥ ⲉϣⲁⲩϭⲟⲗⲟⲩ ⲇⲉ ⲛϩⲉⲛϩⲟⲉⲓⲧⲉ ⲛϫⲏϭⲉ",
      "english": "Yet cannot these gods save themselves from rust and moth, though they be covered with purple raiment.",
      "source": "Epistle of Jeremiah 1",
      "urn": "urn:cts:copticLit:ot.epjer.coptot:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲛⲟⲩⲃ ⲅⲁⲣ ⲉⲧⲟⲩϭⲟⲟⲗⲉ ⲙⲙⲟϥ ⲉⲩⲥⲁ ⲛⲁⲩ ⲉⲩⲧⲙϥⲱⲧⲉ ⲉⲃⲟⲗ ⲙⲡⲉϥ**ϣⲏⲃⲉ** ⲉⲙⲉⲩϯⲥⲁ ϩⲁⲣⲟⲟⲩ ⲙⲡⲉⲟⲩⲟⲉⲓϣ ⲅⲁⲣ ⲉⲩⲟⲩⲱⲧϩ ⲙⲙⲟⲟⲩ ⲙⲉⲩⲁⲓⲥⲑⲁⲛⲉ",
      "english": "Notwithstanding the gold that is about them to make them beautiful, except they wipe off the rust, they will not shine: for neither when they were molten did they feel it.",
      "source": "Epistle of Jeremiah 1",
      "urn": "urn:cts:copticLit:ot.epjer.coptot:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛϥⲧⲙⲉⲓ ⲉⲃⲟⲗ ⲛϩⲏⲧⲥ ⲛϭⲓⲡⲉⲥ**ϣⲏⲃⲉ** ⲉⲧⲛⲁϣⲱϥ ⲛϥϫⲓϣⲓⲡⲉ ⲛϭⲓⲡⲉⲥϣⲏⲃⲉ",
      "english": "and her abundant scum may not come forth of her.",
      "source": "Ezekiel 24",
