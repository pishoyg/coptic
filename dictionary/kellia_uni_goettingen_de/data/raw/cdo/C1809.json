  "examples": [
    {
      "coptic": "ⲡⲓⲙⲁ ⲉⲧⲉⲙⲡⲁⲣⲉⲡⲟⲩϥⲉⲛⲧ **ⲙⲟⲩ** ⲟⲩⲟϩ ⲡⲟⲩⲭⲣⲱⲙ ⲙⲡⲁϥϭⲉⲛⲟ .",
      "english": "where their worm doesn't die, and the fire is not quenched.'",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲕⲛⲁ**ⲙⲟⲩ** ϩⲛⲛⲃⲁⲥⲁⲛⲟⲥ ·",
      "english": "or wilt thou die by torture?'",
      "source": "Martyrdom of Victor part 5",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:33-48",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲉⲣⲟⲩⲱ ⲛϫⲉⲡⲓⲁⲗⲟⲩ ⲉⲑⲟⲩⲁⲃ ⲓⲥⲁⲁⲕ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲕⲁⲗⲱⲥ ⲙⲉⲛ ⲁⲕϯⲥⲃⲱ ⲛⲏⲓ ⲱ ⲡⲁⲓⲱⲧ ⲉⲑⲟⲩⲁⲃ ⲟⲩ ⲙⲟⲛⲟⲛ ⲉϭⲟϫⲓ ⲛⲥⲱⲕ ⲁⲗⲗⲁ ϯⲥⲉⲃⲧⲱⲧ ⲉ**ⲙⲟⲩ** ⲉϫⲉⲛⲫⲣⲁⲛ ⲙⲡⲉⲛϭⲟⲉⲓⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲭⲣⲓⲥⲧⲟⲥ ⲫⲁⲓ ⲉⲧⲁⲓⲭⲁϩⲱⲃ ⲛⲓⲃⲉⲛ ⲛⲥⲱⲓ ⲟⲩⲟϩ ⲁⲓⲟⲩⲁϩⲅ ⲛⲥⲱϥ ⲉϣⲱⲡ ϯⲛⲁⲉⲣⲡⲉⲙⲡϣⲁ ⲙⲡⲓⲱⲛϧ ⲛⲉⲛⲉϩ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲧⲉϥⲙⲉⲧⲁⲅⲁⲑⲟⲥ .",
      "english": "The young and holy boy Isaac answered him and said to him, ‘Truly you give me excellent teachings, O my holy father; not only will I follow you, but I am also ready to die for the name of my Lord Jesus the Messiah, for whom I have left everything behind, in order to make myself worthy of eternal life, thanks to his goodness.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲁⲣⲁⲕⲉⲕⲟⲩⲓ ⲇⲉ ⲉⲓⲛⲁ**ⲙⲟⲩ** ⲡⲉ .",
      "english": "And I was almost going to die.",
      "source": "Apophthegmata Patrum Sahidic 101: Macarius 1",
      "urn": "urn:cts:copticLit:ap.101.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏ ⲛⲑⲟⲕ ⲁⲛ ⲡⲉ ⲡϭⲟⲉⲓⲥ ⲡⲁⲛⲟⲩϯ ⲫⲏ ⲉⲑⲟⲩⲁⲃ ⲛⲧⲏⲓ ⲓⲥϫⲉⲛϩⲏ ⲟⲩⲟϩ ⲛⲛⲉⲛ**ⲙⲟⲩ** ⲡϭⲟⲉⲓⲥ ⲁⲕⲑⲁϣϥ ⲉⲩϩⲁⲡ ⲟⲩⲟϩ ⲁϥⲙⲟⲛⲕⲧ ⲉⲥⲟϩⲓ ϧⲉⲛⲧⲉϥⲥⲃⲱ .",
      "english": "Art not thou from the beginning, O Lord God, my Holy One? and surely we shall not die. O Lord, thou hast established it for judgment, and he has formed me to chasten with his correction.",
      "source": "Bohairic Habakkuk 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
