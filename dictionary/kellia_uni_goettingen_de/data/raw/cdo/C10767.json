  "examples": [
    {
      "coptic": "**ⲧⲟⲧⲉ** ⲁϥⲉⲣⲟⲩⲱ ⲡⲉϫⲁϥ ϫⲉⲁⲛⲟⲕ ⲡⲉ ⲓⲥⲁⲁⲕ .",
      "english": "Then Isaac said, ‘I am Isaac.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲱⲥⲧⲉ ⲙⲡⲣⲕⲣⲓⲛⲉ ⲛⲗⲁⲁⲩ ϩⲁⲧϩⲏ ⲙⲡⲉⲩⲟⲉⲓϣ ϣⲁⲛⲧⲉⲡϫⲟⲉⲓⲥ ⲉⲓ . ⲡⲁⲓ ⲉⲧⲛⲁⲣⲟⲩⲟⲉⲓⲛ ⲉⲛⲉⲧϩⲏⲡ ϩⲙⲡⲕⲁⲕⲉ ⲁⲩⲱ ⲛϥⲟⲩⲱⲛϩ ⲉⲃⲟⲗ ⲛⲛϣⲟϫⲛⲉ ⲛⲛϩⲏⲧ . **ⲧⲟⲧⲉ** ⲡⲧⲁⲉⲓⲟ ⲙⲡⲟⲩⲁ ⲡⲟⲩⲁ ⲛⲁϣⲱⲡⲉ ⲉⲃⲟⲗ ϩⲓⲧⲙⲡⲛⲟⲩⲧⲉ .",
      "english": "Therefore judge nothing before the time, until the Lord comes, who will both bring to light the hidden things of darkness, and reveal the counsels of the hearts. Then each man will get his praise from God.",
      "source": "1 Corinthians 4",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲧⲟⲧⲉ** ⲁⲡⲓⲣⲱⲙⲓ ⲧⲁⲙⲟϥ ⲉϯⲁⲓⲧⲓⲁ ⲛⲧⲉⲡⲓϩⲱⲃ .",
      "english": "Then the man told him the cause (of his sadness).",
      "source": "Life of Isaac of Alexandria - part 3",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:42-48",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲧⲟⲧⲉ** ⲙⲡⲛⲁⲩ ⲉⲧⲙⲙⲁⲩ · ϣⲁⲣⲉⲡⲉⲕⲣⲓⲧⲏⲥ ⲱϣ ⲉⲃⲟⲗ · ϫⲉⲛⲟⲩϫⲉ ⲙⲙⲟϥ ⲉⲡⲕⲁⲕⲉ ⲉⲧϩⲓⲃⲟⲗ · ϥⲛⲁϣⲱⲡⲉ ⲙⲙⲁⲩ ⲛϭⲓⲡⲣⲓⲙⲉ ⲁⲩⲱ ⲡϭⲁϩϭⲉϩ ⲛⲛⲟⲃϩⲉ ·",
      "english": "Then, at that moment, the Judge shall cry out, 'Cast him into the outer darkness, where there is weeping and gnashing of teeth.'",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϫⲟⲥ ⲛⲁϥ ϫⲉⲑⲙⲏⲓ ⲧⲉ ⲟⲩⲟϩ ⲡⲁⲓⲣⲏϯ ϥⲛⲁϧⲟⲑⲃⲕ ⲛⲉⲙⲱⲟⲩ **ⲧⲟⲧⲉ** ⲭⲛⲁϩⲱⲗ ⲉϧⲟⲩⲛ ⲉⲡⲓⲱⲛϧ ⲛⲉⲛⲉϩ ⲛⲧⲉⲫⲛⲟⲩϯ .",
      "english": "Join them, and when they say to the duke, ‘This man was among us,’ and he questions you, respond, ‘Yes, it is true.’ He will order your death with the others, and in this way, you will enter the everlasting life of God.’",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲧⲟⲧⲉ** ⲁⲩⲡⲁϩⲧⲟⲩ ⲉϫⲛⲧⲉϥⲙⲉⲥⲑⲏⲧ ⲁⲩⲱⲗⲙ ⲉϩⲟⲩⲛ ⲉⲣⲟϥ ⲛⲟⲩⲛⲟϭ ⲛⲛⲁⲩ ϫⲓⲛⲧϣⲟⲣⲡ ⲛⲟⲩⲣϣⲉ ⲛⲧⲉⲩϣⲏ · ϣⲁϫⲡⲥⲟ ϩⲱⲥⲧⲉ ⲛⲥⲉⲉⲓ ⲧⲏⲣⲟⲩ ⲛϭⲓⲛⲛⲟϭ ⲙⲡⲡⲁⲗⲗⲁϯⲟⲛ · ⲛⲥⲉⲣⲓⲙⲉ ⲧⲏⲣⲟⲩ ⲛⲙⲙⲁⲩ · ⲉⲧⲃⲉϫⲉⲛⲧⲁⲩϭⲛⲓⲱϩⲁⲛⲛⲏⲥ ϩⲛϩⲛⲟⲩⲛⲟϭ ⲛⲑⲃⲃⲓⲟ ·",
      "english": "Then they threw themselves on his breast, and they mourned over him for a very long time, from the first watch of the night until the sixth hour. And at length all the nobles of the palace a came and wept with them because John had been found in such a miserable condition.",
      "source": "The Life of John the Kalybites part 2",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:46-90",
      "dialect": "sahidic"
    }
  ],
