  "examples": [
    {
      "coptic": "ⲧⲟⲧⲉ ⲉϥⲉⲟⲩⲱⲧⲉⲃ ⲛϫⲉⲡⲓⲡⲛⲉⲩⲙⲁ ⲟⲩⲟϩ ⲉϥⲉ**ⲥⲓⲛⲓ** ⲟⲩⲟϩ ⲉϥⲉⲭⲱ ⲉⲃⲟⲗ ⲑⲁⲓ ⲡⲉ ϯϫⲟⲙ ⲛⲧⲉⲡⲁⲛⲟⲩϯ .",
      "english": "Then shall he change his spirit, and he shall pass through, and make an atonement, saying, This strength belongs to my god.",
      "source": "Bohairic Habakkuk 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲡⲉ ⲛⲙⲡⲕⲁϩ ⲛⲁ**ⲥⲓⲛⲉ** ⲛⲁϣⲁϫⲉ ⲇⲉ ⲛⲥⲉⲛⲁⲥⲓⲛⲉ ⲁⲛ .",
      "english": "Heaven and earth will pass away, but my words will by no means pass away.",
      "source": "42_Luke_21",
      "urn": "urn:cts:copticLit:nt.luke.sahidica:21",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲁⲓ ⲇⲉ ⲛⲉ ⲛⲓⲥⲁϫⲓ ⲉⲧⲁϥϫⲟⲧⲟⲩ ⲛⲱⲟⲩ ϫⲉⲱ ⲛⲁⲓⲟϯ ϯϯϩⲟ ⲉⲣⲱⲧⲉⲛ ⲙⲡⲣⲭⲁϩⲑⲏⲧⲉⲛ ⲉⲧⲁⲓⲙⲉⲧⲣⲁⲙⲁⲟ ⲉⲧⲉⲛⲥⲙⲟⲛⲧ ⲁⲛ ⲟⲩⲇⲉ ⲙⲡⲣϣⲟⲩϣⲟⲩ ⲙⲙⲱⲧⲉⲛ ϩⲓⲧⲉⲛⲡⲁϣⲁⲓ ⲛⲛⲉⲧⲉⲛϩⲩⲡⲁⲣⲭⲟⲛⲧⲁ ϫⲉⲛⲁⲓ ⲧⲏⲣⲟⲩ ⲥⲉⲛⲁ**ⲥⲓⲛⲓ** ⲛⲭⲱⲗⲉⲙ",
      "english": "And these are the words he said to them: ‘O my parents, I beseech you, do not rest your hearts on these unstable riches; do not glory in the abundance of your goods, they will pass away quickly.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲉⲩⲣⲟⲙⲡⲉ ⲛⲁϣⲱⲡⲉ ⲛⲁⲩ ⲛⲥⲱϣϥ ⲥⲉⲛⲁ**ⲥⲓⲛⲉ** ⲉϩⲧⲟⲟⲩⲉ ⲛⲧϩⲉ ⲛⲟⲩⲟⲩⲟⲧⲟⲩⲉⲧ",
      "english": "Years shall be vanity to them: let the morning pass away as grass.",
      "source": "Psalms 89",
      "urn": "urn:cts:copticLit:ot.pss.coptot:89",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲫⲉ ⲛⲉⲙⲡⲓⲕⲁϩⲓ ⲥⲉⲛⲁⲥⲓⲛⲓ ⲛⲁⲥⲁϫⲓ ⲇⲉ ⲛⲛⲟⲩ**ⲥⲓⲛⲓ** .",
