      "urn": "urn:cts:copticDoc:papyri_info.tm82127.cpr_2_237",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲟⲕ ⲇⲉ ⲥⲁϫⲓ ⲛⲛⲏ ⲉⲧⲥⲁⲓⲱⲟⲩ ⲛϯⲥⲃⲱ ⲉⲑ**ⲟⲩⲟϫ** .",
      "english": "But say the things which fit sound doctrine,",
      "source": "17_Titus_02",
      "urn": "urn:cts:copticLit:nt.titus.bohairic:02",
      "dialect": "bohairic"
    },
    {
