  "examples": [
    {
      "coptic": "ⲧⲁⲓⲙⲉⲧⲙⲉⲑⲣⲉ ⲟⲩⲙⲏⲓ ⲧⲉ ⲉⲑⲃⲉⲧⲁⲓⲗⲱⲓϫⲓ ⲥⲟϩⲓ ⲙⲙⲱⲟⲩ ϧⲉⲛⲟⲩϣⲱⲧ ⲉⲃⲟⲗ ϩⲓⲛⲁ ⲛⲥⲉ**ⲟⲩϫⲁⲓ** ϧⲉⲛⲫⲛⲁϩϯ .",
      "english": "This testimony is true. For this cause, reprove them sharply, that they may be sound in the faith,",
      "source": "17_Titus_01",
      "urn": "urn:cts:copticLit:nt.titus.bohairic:01",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲁϫⲓⲟⲩϣⲁϫⲉ ⲉⲣⲟⲓ ⲁⲡⲁ ⲛ**ⲟⲩϫⲁⲓ** .",
      "english": "'Father, tell me a whole story.",
