  "examples": [
    {
      "coptic": "ⲡⲉⲛⲧⲁϥϫⲓ ⲇⲉ ϥϥⲓⲣⲟⲟⲩϣ ⲉⲛⲁⲡⲕⲟⲥⲙⲟⲥ ϫⲉⲉϥⲛⲁ**ⲁⲣⲉⲥⲕⲉ** ⲛⲧⲉϥⲥϩⲓⲙⲉ ⲛⲁϣ ⲛϩⲉ .",
      "english": "but he who is married is concerned about the things of the world, how he may please his wife.",
      "source": "1 Corinthians 7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣϫⲉ ⲡⲉⲓϩⲱⲃ ϭⲉ **ⲁⲣⲉⲥⲕⲉ** ⲁⲛ ⲙⲡⲣⲱⲙⲉ ⲛϣⲟⲩϣⲟⲩ ⲙⲁⲣⲉϥⲣⲡⲙⲉⲉⲩⲉ ϫⲉⲟⲩⲛⲟⲩⲕⲁⲓⲣⲟⲥ ⲛⲏⲩ ⲉⲣⲉⲡⲛⲟⲩⲧⲉ ⲁⲩⲱ ⲡⲉϥⲭⲣⲓⲥⲧⲟⲥ ⲓⲏⲥⲟⲩⲥ ⲉⲧϩⲓϫⲛⲟⲩⲟⲛ ⲛⲓⲙ ⲉⲧⲣⲉⲙⲡⲏⲩⲉ ⲙⲛⲡⲕⲁϩ ⲙⲛⲛⲉⲧⲛϩⲏⲧⲟⲩ ⲧⲏⲣⲟⲩ ϩⲛⲛⲉϥϭⲓϫ ⲛⲧϩⲉ ⲛⲛⲉⲓⲗⲁⲁⲩ ⲛⲁⲟⲩⲉϩⲥⲁϩⲛⲉ ⲁⲩⲱ ⲛϥⲧⲁⲁⲥ ⲛⲛⲉⲧⲟⲩⲁⲁⲃ ⲉⲧⲣⲉⲩⲕⲣⲓⲛⲉ ⲙⲡⲕⲟⲥⲙⲟⲥ ⲧⲏⲣϥ",
      "english": "If this matter does not please the proud person, then let him remember that there is a time coming when God and his Christ Jesus who is over everything so that the heavens and earth and all the things in them are in his hands, in the way of these things, (they) will rule, and he will have the saints judge all of the world.",
      "source": "God Who Alone Is True BV 119-122",
      "urn": "urn:cts:copticLit:shenoute.true.amelineau:201-207",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ϥⲡⲏϣ ⲁⲩⲱ ⲧⲉⲥϩⲓⲙⲉ ⲉⲧⲉⲙⲛⲧⲥϩⲁⲓ ⲙⲛⲧⲡⲁⲣⲑⲉⲛⲟⲥ ϥⲓⲣⲟⲟⲩϣ ⲉⲛⲁⲡϫⲟⲉⲓⲥ ϫⲉⲕⲁⲁⲥ ⲉⲥⲉϣⲱⲡⲉ ⲉⲥⲟⲩⲁⲁⲃ ϩⲙⲡⲉⲥⲥⲱⲙⲁ ⲙⲛⲡⲉⲥⲡⲛⲉⲩⲙⲁ ⲧⲉⲛⲧⲁⲥϫⲓϩⲁⲓ ⲇⲉ ϥⲓⲣⲟⲟⲩϣ ⲉⲛⲁⲡⲕⲟⲥⲙⲟⲥ ϫⲉⲛⲁϣ ⲛϩⲉ ⲉⲥⲛⲁ**ⲁⲣⲉⲥⲕⲉ** ⲙⲡⲉⲥϩⲁⲓ .",
      "english": "There is also a difference between a wife and a virgin. The unmarried woman cares about the things of the Lord, that she may be holy both in body and in spirit. But she who is married cares about the things of the world--how she may please her husband.",
      "source": "46_1 Corinthians_7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:7",
      "dialect": "sahidic"
    }
