  "examples": [
    {
      "coptic": "ⲁϥⲁϣϣⲕⲁⲕ ⲉⲃⲟⲗ ϩⲛⲟⲩⲛⲟϭ ⲛⲥⲙⲏ ⲛⲧϩⲉ ⲛⲟⲩⲙⲟⲩⲓ ⲉϥⲗϩⲏⲙ ⲛⲧⲉⲣⲉϥ**ⲁϣⲕⲁⲕ** ⲇⲉ ⲉⲃⲟⲗ ⲁⲩϣⲁϫⲉ ⲛϭⲓⲧⲥⲁϣϥⲉ ⲛϩⲣⲟⲩⲃⲃⲁⲓ ϩⲛⲛⲉⲩⲁⲥⲡⲉ .",
      "english": "He cried with a loud voice, as a lion roars. When he cried, the seven thunders uttered their voices.",
      "source": "66_Revelation_10",
      "urn": "urn:cts:copticLit:nt.rev.sahidica:10",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲟⲩϭⲥ ⲛⲓⲙ ϭⲱⲛⲧ ⲛⲓⲙ ⲟⲣⲅⲏ ⲛⲓⲙ **ⲁϣⲕⲁⲕ** ⲛⲓⲙ ϩⲓϫⲓⲟⲩⲁ ϥⲓⲧⲟⲩ ⲛϩⲏⲧ ⲧⲏⲩⲧⲛ ⲙⲛⲕⲁⲕⲓⲁ ⲛⲓⲙ .",
      "english": "Let all bitterness, wrath, anger, outcry, and slander, be put away from you, with all malice.",
      "source": "49_Ephesians_4",
      "urn": "urn:cts:copticLit:nt.eph.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉⲣⲉ ⲡⲙⲏⲏϣⲉ ⲇⲉ **ⲁϣⲕⲁⲕ** ⲉⲃⲟⲗ ⲡⲟⲩⲁ ⲡⲟⲩⲁ ⲙⲛⲡⲉϥϣⲁϫⲉ . ⲙⲡϥⲉϣϭⲙϭⲟⲙ ⲉⲉⲓⲙⲉ ⲉⲡⲱⲣϫ ⲉⲧⲃⲉⲡⲉϣⲧⲟⲣⲧⲣ . ⲁϥⲟⲩⲉϩⲥⲁϩⲛⲉ ⲉϫⲓⲧϥ ⲉϩⲣⲁⲓ ⲉⲧⲡⲁⲣⲉⲙⲃⲟⲗⲏ .",
      "english": "Some shouted one thing, and some another, among the crowd. When he couldn't find out the truth because of the noise, he commanded him to be brought into the barracks.",
      "source": "44_Acts of the Apostles_21",
      "urn": "urn:cts:copticLit:nt.acts.sahidica:21",
      "dialect": "sahidic"
    }
