  "examples": [
    {
      "coptic": "ⲉⲃⲟⲗ ϫⲉⲁⲣϯ**ϣⲟⲟⲩ** , ⲁⲩⲱ ⲙⲉⲥⲟⲩⲁⲫⲓ ⲛⲟⲩⲗⲉⲗⲟⲩ ⲉⲥϩⲙⲡⲏⲓ ⲛⲙⲙⲉ",
      "english": "because you gave perfume and mesouaphi to a maiden while she was in the house with you",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "—ⲡⲉⲓⲃⲓⲟⲥ ⲅⲁⲣ ⲧⲉⲛⲟⲩ ⲉⲧⲓⲛⲁϣⲁϫⲉ ⲛⲙⲙⲏⲧⲛ ⲉⲧⲃⲏⲏⲧϥ · ⲡⲁⲣⲁⲟⲩⲣⲱⲙⲉ ⲛⲧⲉⲡⲛⲟⲩⲧⲉ ⲡⲉ ⲁⲩⲱ ⲛ**ϣⲟⲩ**ⲣϣⲡⲏⲣⲉ ⲙⲙⲟϥ ⲛⲧⲁϥϣⲱⲡⲉ ϩⲙⲡⲉⲛⲟⲩⲟⲉⲓϣ ·",
      "english": "This life which I will now describe unto you is that of a man of God, who lived in our time, and it must be regarded with wonder.",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲉϣⲡⲏⲣⲉ ⲇⲉ ⲛⲧⲁⲥϣⲱⲡⲉ ⲙⲡⲛⲁⲩ ⲉⲧⲙⲙⲁⲩ ⲛⲟⲩ**ϣⲟⲩ** ⲥⲁⲁⲧⲥ ⲁⲛ ⲧⲉ ·",
      "english": "And the miracle that took place at that moment is one the mention of which must not be omitted.",
      "source": "Encomium on Victor part 2",
