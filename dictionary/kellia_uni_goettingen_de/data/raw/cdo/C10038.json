  "examples": [
    {
      "coptic": "ⲙⲫⲣⲏϯ ⲅⲁⲣ ⲛⲟⲩ**ⲡⲁⲣⲁⲇⲓⲥⲟⲥ** ⲉⲣⲉⲟⲩⲟⲛ ⲟⲩⲙⲏϣ ⲛϣϣⲏⲛ ⲛϧⲏⲧϥ ⲟⲩⲉⲧ ⲡⲟⲩⲧⲁϩ ⲙⲫⲁⲓ ⲟⲩⲉⲧ ⲡⲟⲩⲧⲁϩ ⲙⲡⲁⲓⲭⲉⲧ ⲁⲗⲗⲁ ⲟⲩⲙⲱⲟⲩ ⲛⲟⲩⲱⲧ ⲉⲧⲧⲥⲓⲟ ⲙⲙⲱⲟⲩ ⲧⲏⲣⲟⲩ ⲫⲁⲓ ⲡⲉ ⲙⲫⲣⲏϯ ⲛⲛⲓϧⲉⲗⲗⲟⲓ ⲉⲑⲟⲩⲁⲃ ⲟⲩⲉⲧ ⲧⲁⲣⲉⲧⲏ ⲙⲫⲁⲓ ⲟⲩⲉⲧ ⲧⲁⲣⲉⲧⲏ ⲙⲡⲁⲓⲭⲉⲧ ⲟⲩⲁⲓ ϧⲉⲛⲟⲩⲙⲉⲧⲛⲁⲏⲧ ⲟⲩⲁⲓ ϧⲉⲛⲟⲩⲁⲥⲕⲩⲥⲓⲥ ⲟⲩⲁⲓ ϧⲉⲛⲟⲩϧⲓⲥⲓ ⲛⲥⲱⲙⲁ ⲟⲩⲁⲓ ϧⲉⲛⲟⲩϫⲱⲗ ⲉⲃⲟⲗ ⲕⲉⲟⲩⲁⲓ ϧⲉⲛⲟⲩϭⲛⲉϫⲱϥ",
      "english": "For just as in a garden there are many trees, each bearing different fruits, but all watered by the same source, so these holy elders were adorned with different virtues: one with mercy, another with ascetic practices, another with bodily afflictions, another with self-denial, another with humility.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣϫⲉ ⲧⲉⲧⲙⲙⲁⲩ ⲙⲡϥⲕⲁⲁⲥ ϩⲙⲡ**ⲡⲁⲣⲁⲇⲉⲓⲥⲟⲥ** ⲉϥⲛⲁϯⲥⲟ ⲉⲣⲟ .",
      "english": "If he didn&apos;t leave the one who is there in paradise, is it you (Aphthonia) that he will spare?",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥϩⲟⲛϩⲉⲛ ⲛϫⲉⲡϭⲟⲓⲥ ⲫⲛⲟⲩϯ ⲛⲧⲟⲧϥ ⲛⲁⲇⲁⲙ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲉⲃⲟⲗ ϧⲉⲛϣϣⲏⲛ ⲛⲓⲃⲉⲛ ⲉⲧϧⲉⲛⲡⲓ**ⲡⲁⲣⲁⲇⲓⲥⲟⲥ** ⲉⲕⲉⲟⲩⲱⲙ ⲉⲃⲟⲗ ⲙⲙⲱⲟⲩ ⲉⲩϧⲣⲉ .",
      "english": "And the Lord God gave a charge to Adam, saying, Of every tree which is in the garden thou mayest freely eat,",
      "source": "01_Genesis_02",
      "urn": "urn:cts:copticLit:ot.gen.bohairic_ed:02",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓⲥϩⲏⲏⲧⲉ ⲉⲛⲛⲁⲙⲟⲩ ϫⲓⲛⲡϩⲟⲟⲩ ⲉⲃⲟⲗ · ⲁⲩⲱ ⲡϫⲟⲉⲓⲥ ⲛⲁϭⲱⲛⲧ ⲉⲣⲟⲛ ⲛϥⲛⲟϫⲛ ⲉⲃⲟⲗ ϩⲙⲡ**ⲡⲁⲣⲁⲇⲉⲓⲥⲟⲥ**",
      "english": "Behold, from this day forward we shall die, and God will be wroth with us, and He will cast us forth from Paradise.",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁ ⲗⲱⲧ ϥⲁⲓ ⲛⲛⲉϥⲃⲁⲗ ⲉⲡϣⲱⲓ ⲁϥⲛⲁⲩ ⲉϯⲡⲉⲣⲓⲭⲱⲣⲟⲥ ⲧⲏⲣⲥ ⲛⲧⲉⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ϫⲉⲛⲉ ϣⲁⲥⲥⲱ ⲡⲉ ⲙⲡⲁⲧⲉ ⲫⲛⲟⲩϯ ⲣⲱϧⲧ ⲛⲥⲟⲇⲟⲙⲁ ⲛⲉⲙⲅⲟⲙⲟⲣⲣⲁ ⲙⲫⲣⲏϯ ⲙⲡⲓ**ⲡⲁⲣⲁⲇⲓⲥⲟⲥ** ⲛⲧⲉⲫⲛⲟⲩϯ ⲛⲉⲙⲙⲫⲣⲏϯ ⲙⲡⲓⲕⲁϩⲓ ⲛⲧⲉⲭⲏⲙⲓ ϣⲁⲧⲉⲕⲓ ⲉϧⲣⲏⲓ ⲉⲍⲟⲅⲟⲣⲁ",
      "english": "And Lot having lifted up his eyes, observed all the country round about Jordan, that it was all watered, before God overthrew Sodom and Gomorrha, as the garden of the Lord, and as the land of Egypt, until thou come to Zogora.",
      "source": "01_Genesis_13",
      "urn": "urn:cts:copticLit:ot.gen.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲡⲉϫⲁϥ ϫⲉϩⲛⲟⲩⲱⲙ ⲁⲡϫⲟⲉⲓⲥ ϫⲟⲟⲥ ⲛⲁⲛ ⲧⲁⲣⲛⲟⲩⲱⲙ ⲉⲃⲟⲗ ϩⲛϣⲏⲙ ⲛⲓⲙ ⲉⲧϩⲙⲡ**ⲡⲁⲣⲁⲇⲉⲓⲥⲟⲥ** ⲉⲓ ⲙⲏ ⲧⲉⲓⲡϣⲏⲛ ⲛⲥⲟⲩⲛⲡⲡⲉⲧⲛⲁⲛⲟⲩϥ ⲙⲛⲡⲡⲉⲧϩⲟⲟⲩ ϩⲙⲡⲉϩⲟⲟⲩ ⲉⲧⲉⲧⲛⲛⲁⲟⲩⲱⲙ ⲉⲃⲟⲗ ⲛϩⲏⲧϥ ϩⲛⲟⲩⲙⲟⲩⲧⲉ ⲧⲛⲁⲙⲟⲩ ·",
      "english": "And [Eve] said, 'God said unto us, Ye may certainly eat of every tree which is in Paradise with the exception of the tree of knowledge of the good and and of the evil; in the day wherein ye eat thereof ye shall surely die.'",
      "source": "Discourse on Abbaton part 1",
      "urn": "urn:cts:copticLit:pstimothy.abbaton.budge:1-21",
      "dialect": "sahidic"
    }
  ],
