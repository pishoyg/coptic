  "examples": [
    {
      "coptic": "ϫⲉⲁⲛⲟⲛ ⲁⲛⲥⲱⲧⲉⲙ ⲉⲣⲟϥ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲛⲟⲕ ϯⲛⲁ**ⲃⲱⲗ** ⲙⲡⲁⲓⲉⲣⲫⲉⲓ ⲉⲃⲟⲗ ⲡⲁⲓⲙⲟⲩⲛⲕ ⲛϫⲓϫ ⲟⲩⲟϩ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲅ ⲛⲉϩⲟⲟⲩ ⲕⲉⲟⲩⲁⲓ ⲛⲁⲑⲙⲟⲩⲛⲕ ⲛϫⲓϫ ϯⲛⲁⲕⲟⲧϥ",
      "english": "We heard him say, 'I will destroy this temple that is made with hands, and in three days I will build another made without hands.''",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁⲩ ⲇⲉ ⲛⲁϥ ϫⲉ**ⲃⲱⲗ** ⲉⲣⲟⲛ ⲛⲧⲉⲓⲡⲁⲣⲁⲃⲟⲗⲏ .",
      "english": "They said to him, “Explain this parable to us.”",
      "source": "Apophthegmata Patrum Sahidic 097: Poemen 109",
      "urn": "urn:cts:copticLit:ap.97.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲕⲁⲛ ⲁⲕϣⲁⲛϫⲟⲥ ϫⲉⲥⲉⲛⲁⲉⲣⲃⲗⲁⲡⲧⲓⲛ ⲙⲙⲟⲓ ⲁⲛ ⲉⲑⲃⲉⲡⲓⲥⲙⲟⲧ ⲛⲧⲉⲧⲉⲕⲙⲉⲧⲉⲩⲥⲉⲃⲏⲥ ϫⲉⲥⲉⲛⲁϣ**ⲃⲱⲗ** ⲙⲡⲉⲧϭⲱⲗⲕ ⲉⲃⲟⲗ ⲁⲛ ⲓⲉ ⲁⲣⲏⲟⲩ ⲭⲛⲁϭⲁⲥⲕ ⲉϫⲱⲟⲩ ⲓⲉ ⲛⲧⲉⲕⲥⲱⲃⲓ ⲙⲙⲱⲟⲩ",
      "english": "Even if you say, “They will not harm me,” because of the strength of your piety, do not let them weaken your fervor, nor make yourself proud before them, nor mock them.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲉϥⲧⲁϣⲉⲟⲉⲓϣ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉϥⲛⲏⲩ ⲙⲛⲛⲥⲱⲓ ⲛϭⲓⲡⲉⲧϫⲟⲟⲣ ⲉⲣⲟⲓ ⲉⲁⲛⲅⲟⲩϩⲓⲕⲁⲛⲟⲥ ⲁⲛ ⲉⲡⲁϩⲧ ⲉ**ⲃⲱⲗ** ⲉⲃⲟⲗ ⲙⲡⲙⲟⲩⲥ ⲙⲡⲉϥⲧⲟⲟⲩⲉ .",
      "english": "He preached, saying, &apos;After me comes he who is mightier than I, the thong of whose sandals I am not worthy to stoop down and loosen.",
      "source": "41_Mark_1",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲏ ⲉⲛⲁⲩⲥⲓⲛⲓ ⲛⲁⲩϫⲉⲟⲩⲁ ⲉⲣⲟϥ ⲉⲩⲕⲓⲙ ⲛⲛⲟⲩⲁⲫⲏⲟⲩⲓ ⲟⲩⲟϩ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲫⲏ ⲉⲧⲛⲁ**ⲃⲉⲗ**ⲡⲓⲉⲣⲫⲉⲓ ⲉⲃⲟⲗ ⲟⲩⲟϩ ⲉⲧⲛⲁⲕⲟⲧϥ ⲛⲅ ⲛⲉϩⲟⲟⲩ",
      "english": "Those who passed by blasphemed him, wagging their heads, and saying, 'Ha! You who destroy the temple, and build it in three days,",
      "source": "Bohairic Gospel of Mark 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲡⲣⲛⲕⲟⲧⲕ ⲉⲕ**ⲃⲏⲗ** ⲉⲃⲟⲗ · ⲟⲩⲇⲉ ⲉϫⲙⲡⲉⲕⲥⲟⲓ · ϫⲉⲛⲛⲉⲩϣⲧⲣⲧⲱⲣⲕ ϩⲛϩⲉⲛⲣⲁⲥⲟⲩ ·",
      "english": "Do not sleep stretched out, nor upon thy back, in order that thou mayest not be disturbed by dreams.",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
