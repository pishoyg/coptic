  "examples": [
    {
      "coptic": "ⲛⲁⲓ ⲇⲉ ⲉⲧⲁϥϫⲟⲧⲟⲩ ⲛϫⲉⲡⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲉⲑⲟⲩⲁⲃ ⲁϥⲧⲏⲓϥ ⲛⲛⲉϥⲓⲟϯ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲣⲉϩ ⲉⲡⲁⲓⲁⲗⲟⲩ ϫⲉⲟⲩⲇⲱⲣⲟⲛ ⲛⲧⲉⲫⲛⲟⲩϯ ⲡⲉ ⲫⲁⲓ ⲅⲁⲣ ⲛⲁϣⲱⲡⲓ ⲛⲟⲩⲛⲓϣϯ ⲛⲁⲣⲭⲓⲉⲣⲉⲩⲥ ϧⲉⲛⲡⲏⲓ ⲙⲫⲛⲟⲩϯ ⲟⲩⲟϩ ⲥⲉⲛⲁⲧⲉⲛϩⲟⲩⲧϥ ⲉϩⲁⲛⲗⲁⲟⲥ ⲉⲩ**ⲟϣ** .",
      "english": "After saying these words, the holy bishop gave the child to his parents, saying: ‘Keep this child well, for he is a gift from God, he will be a great pontiff in the house of God and many peoples will be entrusted to him.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓⲥϩⲏⲏⲧⲉ ⲅⲁⲣ ϯⲛⲁⲥⲱⲟⲩϩ ⲉⲣⲟⲕ ⲛϩⲉⲛⲛⲟϭ ⲙⲙⲏⲏϣⲉ ⲁⲩⲱ ⲥⲉⲛⲁ**ⲁϣⲁⲓ** ⲉⲙⲁⲧⲉ · ϩⲛⲧⲉⲩⲏⲡⲉ",
      "english": "For behold, I will gather large crowds around you, and they will become very numerous in their number.",
      "source": "Life of Apa Phib part 2",
      "urn": "urn:cts:copticLit:lives.phib.paths_ed:11-18",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏ ϩⲁⲛⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲡϭⲟⲉⲓⲥ ⲡⲓⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ ⲛⲉ ⲛⲁⲓ ⲟⲩⲟϩ ⲁⲩⲙⲟⲩⲛⲕ ϧⲉⲛⲟⲩⲭⲣⲱⲙ ⲛϫⲉϩⲁⲛⲗⲁⲟⲥ ⲉⲩ**ⲟϣ** ⲟⲩⲟϩ ϩⲁⲛⲙⲏϣ ⲛⲉⲑⲛⲟⲥ ⲁⲩⲉⲣⲕⲟⲩϫⲓ ⲛϩⲏⲧ .",
      "english": "Are not these things of the Lord Almighty? surely many people have been exhausted in the fire, and many nations have fainted.",
      "source": "Bohairic Habakkuk 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲁϣⲁⲓ** ⲛⲅⲁⲓⲁⲓ ⲛⲅⲙⲉϩⲡⲕⲁϩ ⲛⲅⲣϫⲥ ⲉϩⲣⲁⲓ ⲉϫⲱϥ ·",
      "english": "Thou shalt certainly increase and multiply, and thou shalt fill the earth, and thou shalt become the lord thereof.'",
      "source": "Life of Pisentius part 1",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲁⲓ ⲟⲩⲛ ⲁϥⲓ ⲉϥϧⲉⲛⲟⲩⲛⲓϣϯ ⲛⲉⲙⲕⲁϩ ⲛϩⲏⲧ ⲉϥ**ⲟϣ** ⲟⲩⲟϩ ⲁϥⲟⲩⲱⲣⲡ ⲉϧⲟⲩⲛ ⲙⲡⲁⲓⲱⲧ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲉⲓⲟⲩⲱϣ ⲉϭⲓⲥⲙⲟⲩ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧⲕ ⲱ ⲡⲁⲓⲱⲧ ⲉⲑⲟⲩⲁⲃ ⲁⲣⲏⲟⲩ ⲛⲧⲉⲫⲛⲁⲓ ⲙⲫⲛⲟⲩϯ ⲧⲁϩⲟⲓ ⲛⲉⲙⲛⲉⲕϣⲗⲏⲗ ⲉⲑⲟⲩⲁⲃ ϩⲓⲛⲁ ⲛⲧⲉⲫⲛⲟⲩϯ ⲭⲁⲛⲁⲛⲟⲃⲓ ⲛⲏⲓ ⲉⲃⲟⲗ ϫⲉⲥⲉⲟϣ ⲛϩⲟⲩⲟ .",
      "english": "Burdened with deep sorrow, the man sent a message to my father, pleading: ‘O holy father, I seek your blessing. Perhaps through your intercession, God in his mercy will grant me forgiveness, for I carry many sins.’",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲛⲁⲓ · ϫⲉⲁϩⲉ ⲁⲓϩⲓⲥⲉ ⲧⲱⲛⲟⲩ · ⲱ ⲡⲁϣⲏⲣⲉ · ϩⲱⲥⲧⲉ ⲛⲛⲁϣⲛⲟϫⲧ · ⲉⲡⲕⲁϩ ⲉⲧⲃⲉⲡⲙⲕⲁϩ ⲛϩⲏⲧ · ϩⲱⲥⲧⲉ ⲛⲛⲁⲉϣⲛⲟϫⲧ · ⲉⲡⲕⲁϩ ⲉⲧⲃⲉⲡⲙⲕⲁϩ ⲛϩⲏⲧ · ⲉⲓⲱϣ ⲉϩⲣⲁⲓ ⲉⲡϫⲟⲉⲓⲥ ⲉⲧⲃⲉⲛⲁⲛⲟⲃⲉ ⲉⲧ**ⲟϣ** ·",
      "english": "And he said unto me, 'Yea, I did suffer greatly, so much so in fact that sometimes through the intensity of my sorrow I used to throw myself on the ground, and cry up to God because of my manifold sins.",
      "source": "Life of Onnophrius part 1",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:1-9",
      "dialect": "sahidic"
    }
  ],
