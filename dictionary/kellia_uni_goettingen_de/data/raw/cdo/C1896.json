  "examples": [
    {
      "coptic": "ⲫⲱⲧ ⲥⲁⲃⲟⲗ ⲛϯⲡⲟⲣⲛⲓⲁ ⲛⲟⲃⲓ ⲛⲓⲃⲉⲛ ⲉⲧⲉⲡⲓⲣⲱⲙⲓ ⲛⲁⲁⲓϥ ϥⲥⲁⲃⲟⲗ ⲙⲡⲓⲥⲱⲙⲁ ⲫⲏ ⲇⲉ ⲉⲧⲉⲣⲡⲟⲣⲛⲉⲩⲓⲛ ⲁϥⲉⲣⲛⲟⲃⲓ ⲉⲡⲉϥⲥⲱⲙⲁ **ⲙⲙⲓⲛⲙⲙⲟ**ϥ .",
      "english": "Flee sexual immorality! 'Every sin that a man does is outside the body,' but he who commits sexual immorality sins against his own body.",
      "source": "Bohairic 1 Corinthians 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲧϣⲟⲟⲡ ⲙⲉⲛ ⲅⲁⲣ ⲉϥϣⲟⲟⲡ ϩⲓⲧⲟⲟⲧϥ **ⲙⲙⲓⲛ** ⲙⲙⲟϥ ·",
      "english": "For He Who Is existeth of and by Himself",
      "source": "Proclus Homily 23 On the Nativity in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily23.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲓⲥϫⲉ ⲡⲥⲁⲧⲁⲛⲁⲥ ⲡⲉⲧⲁϥⲧⲱⲛϥ ⲉϫⲱϥ **ⲙⲙⲓⲛⲙⲙⲟ**ϥ ⲟⲩⲟϩ ⲁϥⲫⲱϣ ⲙⲙⲟⲛ ϣϫⲟⲙ ⲙⲙⲟϥ ⲉⲟϩⲓ ⲉⲣⲁⲧϥ ⲁⲗⲗⲁ ⲟⲩⲟⲛⲧⲉϥ ⲟⲩϫⲱⲕ .",
      "english": "If Satan has risen up against himself, and is divided, he can't stand, but has an end.",
      "source": "Bohairic Gospel of Mark 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲡⲣϯϩⲟ ⲉⲃⲟⲗ ⲛⲧϩⲉ ⲛⲛⲉⲓϩⲩⲡⲟⲕⲣⲓⲧⲏⲥ · ⲁⲗⲗⲁ ⲁⲡⲟⲧⲁⲥⲥⲉ ⲛⲛⲉⲕⲟⲩⲱϣ ⲛϩⲏⲧ ⲛⲅⲣϩⲱⲃ ⲙⲡⲛⲟⲩⲧⲉ ⲁⲩⲱ ⲉⲕⲣϩⲱⲃ ⲉⲡⲉⲕⲟⲩϫⲁⲓ **ⲙⲙⲓⲛ** ⲙⲙⲟⲕ ·",
      "english": "Do not turn away the face like the hypocrites, but treat with decision the wishes of thy heart; work for God, and work for thine own salvation.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ ⲇⲉ ⲉⲧⲟϩⲓ ⲉⲣⲁⲧϥ ϧⲉⲛⲡⲉϥϩⲏⲧ ⲉϥⲧⲁϫⲣⲏⲟⲩⲧ ⲙⲙⲟⲛⲁⲛⲁⲅⲕⲏ ⲧⲟⲓ ⲉⲣⲟϥ ⲟⲩⲟⲛⲧⲉϥ ⲉⲣϣⲓϣⲓ ⲙⲙⲁⲩ ⲉⲑⲃⲉⲡⲉⲧⲉϩⲛⲁϥ ⲙⲙⲓⲛⲙⲙⲟϥ ⲟⲩⲟϩ ⲫⲁⲓ ϥϯϩⲁⲡ ⲉⲣⲟϥ **ⲙⲙⲓⲛⲙⲙⲟ**ϥ ϧⲉⲛⲡⲉϥϩⲏⲧ ⲉⲁⲣⲉϩ ⲉⲧⲉϥⲡⲁⲣⲑⲉⲛⲟⲥ ⲕⲁⲗⲱⲥ ϥⲛⲁⲁⲓⲥ .",
