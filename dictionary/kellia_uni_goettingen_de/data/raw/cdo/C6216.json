  "examples": [
    {
      "coptic": "ⲓⲏⲥⲟⲩⲥ ⲇⲉ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲙⲡⲣⲧⲁϩⲛⲟ ⲙⲙⲟϥ ⲙⲙⲟⲛ ϩⲗⲓ ⲅⲁⲣ ⲫⲏ ⲉⲑⲛⲁⲓⲣⲓ ⲛⲟⲩϫⲟⲙ ⲉϫⲉⲛⲡⲁⲣⲁⲛ ⲟⲩⲟϩ ⲛⲧⲉϥϣϫⲉⲙϫⲟⲙ ⲛⲭⲱⲗⲉⲙ ⲉ**ⲥⲁϫⲓ** ⲉϥϩⲱⲟⲩ ϧⲁⲣⲟⲓ .",
      "english": "But Jesus said, 'Don't forbid him, for there is no one who will do a mighty work in my name, and be able quickly to speak evil of me.",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓ**ϣⲁϫⲉ** · ⲉⲧⲥⲩⲛⲁⲅⲱⲅⲏ ⲛⲛⲓⲟⲩⲇⲁⲓ",
      "english": "I speak of the synagogue of the Jews,",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉϣⲱⲡ ⲛⲧⲟⲩⲉⲛⲑⲏⲛⲟⲩ ⲉⲩϯ ⲙⲙⲱⲧⲉⲛ ⲙⲡⲣⲉⲣ=ϣⲟⲣⲡ ⲛϥⲓⲣⲱⲟⲩϣ ϫⲉⲟⲩ ⲡⲉⲧⲉⲧⲉⲛⲛⲁ**ⲥⲁϫⲓ** ⲙⲙⲟϥ ⲁⲗⲗⲁ ⲡⲉⲧⲟⲩⲛⲁⲧⲏⲓϥ ⲛⲱⲧⲉⲛ ϧⲉⲛϯⲟⲩⲛⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ ⲫⲁⲓ ⲡⲉⲧⲉⲧⲉⲛⲛⲁⲥⲁϫⲓ ⲙⲙⲟϥ ⲛⲑⲱⲧⲉⲛ ⲅⲁⲣ ⲁⲛ ⲡⲉⲧⲛⲁⲥⲁϫⲓ ⲁⲗⲗⲁ ⲡⲓⲡⲛⲉⲩⲙⲁ ⲉⲧⲟⲩⲁⲃ ⲡⲉ .",
      "english": "When they lead you away and deliver you up, don't be anxious beforehand, or premeditate what you will say, but say whatever will be given you in that hour. For it is not you who speak, but the Holy Spirit.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲣϣⲁⲛⲟⲩⲁ ⲟⲩⲱϣ ⲉ**ϣⲁϫⲉ** ⲉⲣⲟϥ · ϥⲛⲁϫⲟⲟⲥ",
      "english": "If one wants to speak about him, one would say",
      "source": "Apophthegmata Patrum Sahidic 125: Joseph",
      "urn": "urn:cts:copticLit:ap.125.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲥⲟⲫⲓⲁ ⲇⲉ ⲡⲉⲧⲉⲛ**ⲥⲁϫⲓ** ⲙⲙⲟⲥ ϧⲉⲛⲛⲏ ⲉⲧϫⲏⲕ ⲉⲃⲟⲗ ⲟⲩⲥⲟⲫⲓⲁ ⲇⲉ ⲛⲑⲁⲡⲁⲓⲉⲛⲉϩ ⲁⲛ ⲧⲉ ⲟⲩⲇⲉ ⲛⲑⲁⲛⲓⲁⲣⲭⲱⲛ ⲁⲛ ⲛⲧⲉⲡⲁⲓⲉⲛⲉϩ ⲛⲁⲓ ⲉⲑⲛⲁⲕⲱⲣϥ .",
      "english": "We speak wisdom, however, among those who are full grown; yet a wisdom not of this world, nor of the rulers of this world, who are coming to nothing.",
      "source": "Bohairic 1 Corinthians 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:2",
      "dialect": "bohairic"
