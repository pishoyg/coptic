  "examples": [
    {
      "coptic": "ⲓⲥϫⲉϯⲟⲓ ⲛⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲁⲛ ⲛϩⲁⲛⲕⲉⲭⲱⲟⲩⲛⲓ ⲁⲗⲗⲁ ϯⲟⲓ ⲛⲱⲧⲉⲛ ϯ**ⲥⲫⲣⲁⲅⲓⲥ** ⲅⲁⲣ ⲛⲧⲉⲧⲁⲙⲉⲧⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲛⲑⲱⲧⲉⲛ ⲡⲉ ϧⲉⲛⲡϭⲟⲓⲥ .",
      "english": "If to others I am not an apostle, yet at least I am to you; for you are the seal of my apostleship in the Lord.",
      "source": "Bohairic 1 Corinthians 9 (Digital Editions)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲡⲛⲉⲩⲙⲁ ⲇⲉ ⲡⲉ ⲧⲉ**ⲥⲫⲣⲁⲅⲓⲥ** ·",
      "english": "The Spirit is the seal.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲩϫⲟⲥ ⲛⲱⲟⲩ ⲉϣⲧⲉⲙⲉⲣⲁⲇⲓⲕⲓⲛ ⲛⲛⲓⲥⲙⲉϩ ⲛⲧⲉⲡⲕⲁϩⲓ ⲟⲩⲇⲉ ϣϣⲏⲛ ⲛⲓⲃⲉⲛ ⲟⲩⲇⲉ ⲉⲛⲭⲁⲓ ⲛⲓⲃⲉⲛ ⲉⲧϩⲟⲩⲉⲧⲟⲩⲱⲧ ⲉⲃⲏⲗ ⲉⲛⲓⲣⲱⲙⲓ ⲛⲏ ⲉⲧⲉϯ**ⲥⲫⲣⲁⲅⲓⲥ** ⲛⲧⲉⲫⲛⲟⲩϯ ϩⲓⲧⲟⲩⲧⲉϩⲛⲓ ⲁⲛ .",
      "english": "They were told that they should not hurt the grass of the earth, neither any green thing, neither any tree, but only those people who don't have God's seal on their foreheads.",
      "source": "27_Revelation_09",
      "urn": "urn:cts:copticLit:nt.rev.bohairic:09",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϣⲁⲥϯ ⲛⲧⲉ**ⲥⲫⲣⲁⲅⲓⲥ** ⲙⲡⲟⲩⲁ ⲡⲟⲩⲁ ⲛⲁϥ · ⲙⲛⲧⲉϥⲁⲡⲟⲗⲟⲅⲓⲁ ·",
      "english": "And it giveth every one his seal and his apology.",
      "source": "Pistis Sophia Book 3 Part 3",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:87-88",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲓⲱⲛⲓ ⲙⲁⲣⲟⲩϣⲱⲡⲓ ⲉⲃⲟⲗ ϧⲉⲛⲛⲓⲣⲁⲛ ⲛⲧⲉⲛⲉⲛϣⲏⲣⲓ ⲙⲡⲓⲥⲣⲁⲏⲗ ⲓⲃ ⲕⲁⲧⲁⲛⲟⲩϫⲓⲛⲙⲓⲥⲓ ϩⲁⲛⲫⲱⲧϩ ⲛⲧⲉϩⲁⲛ**ⲥⲫⲣⲁⲅⲓⲥ** ⲫⲟⲩⲁⲓ ⲫⲟⲩⲁⲓ ⲕⲁⲧⲁⲡⲉϥⲣⲁⲛ ⲉⲩⲉϣⲱⲡⲓ ⲉϯⲓⲃ ⲙⲫⲩⲗⲏ",
      "english": "And let the stones of the names of the children of Israel be twelve according to their names, engravings as of seals: let them be for the twelve tribes each according to the name.",
      "source": "02_Exodus_28",
      "urn": "urn:cts:copticLit:ot.exod.bohairic_ed:28",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϯⲛⲁϯ ⲛⲏⲧⲛ ⲛⲛⲉⲩⲯⲏⲫⲟⲥ ⲙⲛⲛⲉⲩ**ⲥⲫⲣⲁⲅⲓⲥ** ·",
      "english": "and I will give you their ciphers and their seals.",
      "source": "Pistis Sophia Book 4 Part 1",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:120-128",
      "dialect": "sahidic"
    }
