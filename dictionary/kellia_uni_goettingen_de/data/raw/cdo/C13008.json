  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲓⲁⲕⲱⲃⲟⲥ ⲡϣⲏⲣⲓ ⲛⲍⲉⲃⲉⲇⲉⲟⲥ ⲛⲉⲙⲓⲱⲁⲛⲛⲏⲥ ⲡⲥⲟⲛ ⲛⲓⲁⲕⲱⲃⲟⲥ ⲟⲩⲟϩ ⲁϥϯ ⲛϩⲁⲛⲣⲁⲛ ⲉⲣⲱⲟⲩ ϫⲉⲃⲟⲁⲛⲏⲣⲅⲉⲥ ⲉⲧⲉⲫⲁⲓ ⲡⲉ ϫⲉⲛⲓϣⲏⲣⲓ ⲛⲧⲉϯ**ϧⲁⲣⲁⲃⲁⲓ** .",
      "english": "James the son of Zebedee; John, the brother of James, and he surnamed them Boanerges, which means, Sons of Thunder;",
      "source": "Bohairic Gospel of Mark 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲛⲛⲉ**ϩⲣⲟⲩⲃⲃⲁⲓ** ⲛⲉⲧⲉⲛⲣⲱⲙⲉ ⲣϩⲟⲧⲉ ϩⲏⲧⲟⲩ ·",
      "english": "and thunders of which men are afraid.",
      "source": "Mysteries of John the Evangelist part 2",
      "urn": "urn:cts:copticLit:misc.mysteries_john.budge:13-28",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲭⲛⲁⲥⲱⲧⲉⲙ ⲉⲧⲉϥⲥⲙⲏ : ⲉϥⲉⲉⲣ**ϧⲁⲣⲁⲃⲁⲓ** ⲛϩⲁϣⲫⲏⲣⲓ ϧⲉⲛⲧⲉϥⲥⲙⲏ ⲛϫⲉⲡⲓϫⲱⲣⲓ:ⲁϥⲑⲱϣ ⲛⲟⲩⲟⲩⲛⲟⲩ ⲛⲛⲓⲧⲉⲃⲛⲱⲟⲩⲓ : ⲥⲉⲥⲱⲟⲩⲛ ⲇⲉ ⲛϯⲧⲁⲝⲓⲥ ⲛⲧⲉⲧⲟⲩϣⲁⲓⲣⲓ : ⲉϫⲉⲛⲛⲁⲓ ⲧⲏⲣⲟⲩ ⲡⲉⲕⲕⲁϯ ⲧⲟⲙⲧ ⲁⲛ ⲟⲩⲇⲉ ϥⲛⲁϣⲟⲃⲧ ⲁⲛ ⲛϫⲉⲡⲉⲕϩⲏⲧ ⲉⲃⲟⲗϩⲁ ⲡⲉⲕⲥⲱⲙⲁ : ⲁϥⲑⲁⲙⲓⲟ ⲅⲁⲣ ⲛϩⲁⲛⲛⲓϣϯ : ⲛⲁⲓ ⲉⲛⲁⲛⲉⲙⲓ ⲉⲣⲱⲟⲩ ⲁⲛ .",
      "english": "The Mighty One shall thunder wonderfully with his voice: for he has done great things which we knew not;",
      "source": "18_Iob_37",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:37",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲕⲁϩ ⲅⲁⲣ ⲛⲁⲛⲟⲉⲓⲛ ⲛϥⲕⲱ ϩⲁⲣⲱⲟⲩ · ⲛⲉ**ϩⲣⲟⲩⲃⲃⲁⲓ** ⲛⲁϯϩⲟⲧⲉ ⲛⲁⲩ · ⲛⲉⲃⲣⲏϭⲉ ⲛⲕⲱϩⲧ ⲛⲁϣⲧⲣⲧⲱⲣⲟⲩ · ⲛⲧⲏⲩⲛⲁⲣⲁϩⲧⲟⲩ ⲉⲩⲛⲟⲉⲓⲛ ⲉⲣⲟⲟⲩ ·",
      "english": "For the earth shall shake under them, the thunders shall strike terror into them, the lightnings of fire shall alarm them, and the winds shall buffet them and shake them violently.",
      "source": "The Asceticon of Apa Ephrem part 2",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:24-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲓⲙⲏϣ ⲟⲩⲛ ⲉⲛⲁϥⲟϩⲓ ⲉⲣⲁⲧϥ ⲉⲧⲁⲩⲥⲱⲧⲉⲙ ⲛⲁⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲟⲩ**ϧⲁⲣⲁⲃⲁⲓ** ⲡⲉⲧⲁⲥϣⲱⲡⲓ ϩⲁⲛⲕⲉⲭⲱⲟⲩⲛⲓ ⲇⲉ ⲛⲁⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲟⲩⲁⲅⲅⲉⲗⲟⲥ ⲡⲉⲧⲁϥⲥⲁϫⲓ ⲛⲉⲙⲁϥ .",
      "english": "The multitude therefore, who stood by and heard it, said that it had thundered. Others said, 'An angel has spoken to him.'",
      "source": "04_John_12",
      "urn": "urn:cts:copticLit:nt.john.bohairic:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϥϫⲱ ⲙⲙⲟⲥ ⲟⲛ ϩⲛⲛⲕⲉⲙⲁ · ϫⲉⲧⲡⲉ ⲙⲛⲡⲕⲁϩ ⲛⲁϣⲧⲟⲣⲧⲣ · ⲛϭⲟⲙ ⲛⲙⲡⲏⲩⲉ ⲥⲉⲛⲁⲛⲟⲉⲓⲛ · ϩⲙⲡⲉϩⲟⲟⲩ ⲉⲧⲙⲙⲁⲩ · ϩⲉⲛⲛⲟϭ ⲛⲕⲙⲧⲟ ⲙⲛϩⲉⲛϩⲣⲟⲟⲩ ⲛⲥⲁⲗⲡⲓⲅⲝ · ⲙⲛϩⲉⲛⲛⲟϭ ⲛ**ϩⲣⲟⲩⲃⲃⲁⲓ** ⲉⲩⲱϣ ⲉⲃⲟⲗ ϩⲛϩⲉⲛⲛⲟϭ ⲛⲥⲙⲏ ·",
      "english": "And He said also in another place, ' Heaven and earth shall be convulsed, and the powers which are in the heavens shall be shaken in that day, (and there shall be) great earthquakes, and blasts of the trumpet, and great and frequent flashes of lightning, with mighty thunderings.'",
      "source": "On the End of the World and on Temple of Solomon",
      "urn": "urn:cts:copticLit:psbasil.temple.budge:1-47",
      "dialect": "sahidic"
    }
  ],
