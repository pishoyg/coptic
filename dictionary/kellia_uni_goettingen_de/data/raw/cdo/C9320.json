  "examples": [
    {
      "coptic": "ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲁϥⲥⲟⲧⲡⲉⲛ ⲛϧⲏⲧϥ ϧⲁϫⲉⲛ ⲧ**ⲕⲁⲧⲁⲃⲟⲗⲏ** ⲙⲡⲓⲕⲟⲥⲙⲟⲥ ϫⲉⲛⲧⲉⲛϣⲱⲡⲓ ⲉⲛⲟⲩⲁⲃ ⲉⲛⲟⲓ ⲛⲁⲧⲑⲱⲗⲉⲃ ⲙⲡⲉϥⲙⲑⲟ ϧⲉⲛⲟⲩⲁⲅⲁⲡⲏ .",
      "english": "even as he chose us in him before the foundation of the world, that we would be holy and without blemish before him in love;",
      "source": "10_Ephesians_01",
      "urn": "urn:cts:copticLit:nt.eph.bohairic:01",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲁⲓ ⲅⲁⲣ ⲛⲉⲧⲁϩⲉⲣⲁⲧⲟⲩ ⲛⲥⲁⲟⲩⲛⲁⲙ ⲙⲡϫⲟⲉⲓⲥ · ⲛⲁⲓ ⲉⲛⲧϥϫⲟⲟⲥ ⲛⲁⲩ ⲉϥϣⲁⲛⲉⲓ ⲛϭⲓⲡⲣⲣⲟ ϫⲉⲁⲙⲏⲉⲓⲛ ⲛⲉⲧⲥⲙⲁⲁⲧ ⲛⲧⲉⲡⲁⲉⲓⲱⲧ ⲛⲧⲉⲧⲛⲕⲗⲏⲣⲟⲛⲟⲙⲉⲓ ⲛⲧⲙⲛⲧⲣⲣⲟ ⲉⲛⲧⲁⲩⲥⲃⲧⲱⲧⲥ ⲛⲏⲧⲛ ϫⲓⲛⲛⲧ**ⲕⲁⲧⲁⲃⲟⲗⲏ** ⲙⲡⲕⲟⲥⲙⲟⲥ ·",
      "english": "For these are they who shall take their stand at the right hand of God, and these are they unto whom the King, when He shall come, shall speak saying, ' Come, ye blessed of My Father, and ye shall inherit the kingdom which hath been prepared for you from the foundation of the world.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲁⲩⲉⲣϣⲟⲣⲡ ⲙⲉⲛ ⲛⲥⲟⲩⲱⲛϥ ⲓⲥϫⲉⲛ ⲧ**ⲕⲁⲧⲁⲃⲟⲗⲏ** ⲙⲡⲓⲕⲟⲥⲙⲟⲥ ⲉⲁϥⲟⲩⲱⲛϩ ⲇⲉ ⲉⲃⲟⲗ ⲉⲡϧⲁⲉ ⲛⲧⲉⲛⲓⲥⲏⲟⲩ ⲉⲑⲃⲉⲑⲏⲛⲟⲩ",
      "english": "who was foreknown indeed before the foundation of the world, but was revealed at the end of times for your sake,",
      "source": "21_I Peter_01",
      "urn": "urn:cts:copticLit:nt.1pet.bohairic:01",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲧⲉⲙⲡⲉϥϭⲱ ⲉⲛⲉϩ · ⲉϥⲣⲡⲉⲧⲛⲁⲛⲟⲩϥ · ϫⲓⲛⲧ**ⲕⲁⲧⲁⲃⲟⲗⲏ** ⲙⲡⲕⲟⲥⲙⲟⲥ · ⲉϥⲧⲟⲩϫⲟ ⲛⲟⲩⲟⲛ ⲛⲓⲙ · ⲉⲧⲉⲙⲛϭⲟⲙ ⲙⲙⲟⲟⲩ ·",
      "english": "Who hast never ceased from doing that which is good since the foundation of the world. Who deliverest every one who hath no strength.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲓⲛⲁ ⲛⲧⲉϥϫⲱⲕ ⲉⲃⲟⲗ ⲛϫⲉⲫⲏ ⲉⲧⲁϥϫⲟϥ ⲉⲃⲟⲗ ϩⲓⲧⲟⲧϥ ⲙⲡⲓⲡⲣⲟⲫⲏⲧⲏⲥ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲓⲛⲁⲟⲩⲱⲛ ⲛⲣⲱⲓ ϧⲉⲛϩⲁⲛⲡⲁⲣⲁⲃⲟⲗⲏ ⲟⲩⲟϩ ⲛⲧⲁⲥⲁϫⲓ ⲛⲛⲏ ⲉⲧϩⲏⲡ ⲓⲥϫⲉⲛ ⲧ**ⲕⲁⲧⲁⲃⲟⲗⲏ** ⲙⲡⲓⲕⲟⲥⲙⲟⲥ .",
      "english": "that it might be fulfilled which was spoken through the prophet, saying, 'I will open my mouth in parables; I will utter things hidden from the foundation of the world.'",
      "source": "01_Matthew_13",
      "urn": "urn:cts:copticLit:nt.matt.bohairic:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉϥⲟⲩⲱϣ ⲇⲉ ⲉϯⲡⲛⲉⲩⲙⲁ ⲉⲣⲟϥ ⲁϥϫⲓ ⲙⲡϫⲱⲱⲙⲉ ⲁϥⲥϩⲁⲓ ⲛⲛⲉⲧⲛⲁⲉⲓ ⲉⲃⲟⲗ ⲛϩⲏⲧϥ ⲉⲧⲛⲁⲃⲱⲕ ⲉϩⲟⲩⲛ ⲉⲧⲙⲛⲧⲣⲣⲟ · ⲛⲙⲡⲏⲩⲉ · ⲕⲁⲧⲁⲧϩⲉ ⲉⲧⲥⲏϩ ϫⲉⲛⲁⲓ ⲉⲣⲉⲛⲉⲩⲣⲁⲛ ⲥⲏϩ · ⲉⲡϫⲱⲱⲙⲉ ⲙⲡⲱⲛϩ ϫⲓⲛⲧ**ⲕⲁⲧⲁⲃⲟⲗⲏ** ⲙⲡⲕⲟⲥⲙⲟⲥ ·",
      "english": "And whilst He was wishing to put breath into him He took a book, and wrote therein [the names of] those who should come forth from him and who should enter into the kingdom which is in the heavens, according to what is written, 'These are they whose names are written in the Book of Life from the foundation of the world.'",
      "source": "Discourse on Abbaton part 1",
      "urn": "urn:cts:copticLit:pstimothy.abbaton.budge:1-21",
      "dialect": "sahidic"
    }
