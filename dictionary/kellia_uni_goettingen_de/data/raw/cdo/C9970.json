      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲡⲉ ⲛⲧⲁⲓⲥⲙⲟⲩ ⲉⲛ**ⲟⲩⲥⲓⲁ** ⲙⲡⲉⲕⲉⲓⲱⲧ ·",
      "english": "I am he who blessed the possessions of thy father.",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲓⲓⲟϩ ⲛⲉⲙⲛⲓⲥⲓⲟⲩ ⲉⲩⲉ**ⲟⲩⲥⲓⲁ** ⲛⲧⲉⲡⲓⲉϫⲱⲣϩ ϫⲉⲡⲉϥⲛⲁⲓ ϣⲟⲡ ϣⲁⲉⲛⲉϩ",
      "english": "The moon and the stars to rule the night; for his mercy endures for ever.",
      "source": "19_Psalmi_135",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:135",
      "dialect": "bohairic"
    },
    {
