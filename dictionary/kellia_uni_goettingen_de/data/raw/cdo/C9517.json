  "examples": [
    {
      "coptic": "ⲁⲟⲩⲙⲏϣ ϩⲓⲧⲟⲧⲟⲩ ⲉⲥϧⲉ ϩⲁⲛⲙⲏϣ ⲛⲃⲱⲗ ⲕⲁⲧⲁⲥⲏⲟⲩ ⲟⲩⲟϩ ⲁⲩⲭⲁⲩ ϧⲉⲛⲡⲓⲕⲟⲥⲙⲟⲥ ⲉⲡϫⲓⲛⲧⲟⲩϣⲟⲩϣⲟⲩ ⲉϫⲱⲟⲩ ⲁⲛ ⲁⲗⲗⲁ ϫⲉϩⲓⲛⲁ ⲛⲧⲉⲡⲓ**ⲕⲟⲥⲙⲟⲥ** ⲛⲁⲩ ⲙⲃⲟⲗ ⲛϧⲏⲧⲟⲩ .",
      "english": "Many over time have endeavored to write numerous explanations, not to gain glory for themselves, but so that through them the world might see external matters.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲟⲓⲛⲉ ⲁⲩⲁⲡⲟⲧⲁⲥⲥⲉ ⲙⲡ**ⲕⲟⲥⲙⲟⲥ** ·",
      "english": "Some withdrew themselves from the world,",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲟⲛ ϫⲉⲛⲭⲁⲓ ⲛⲓⲃⲉⲛ ⲉⲧϧⲉⲛ ⲡⲓ**ⲕⲟⲥⲙⲟⲥ** ϯⲉⲡⲓⲑⲩⲙⲓⲁ ⲛⲧⲉⲛⲓⲃⲁⲗ ⲛⲉⲙϯⲉⲡⲓⲑⲩⲙⲓⲁ ⲛⲧⲉϯⲥⲁⲣⲝ ϩⲁⲛⲁⲧϣⲧⲁϩⲱⲟⲩ ⲛⲉ ϧⲉⲛⲡⲟⲩϭⲓⲙⲡϣⲓϣ",
      "english": "and also: ‘All the things of this world, desires of the eyes and desires of the flesh, are unattainable in their violent desire",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲛ ϫⲉⲛⲧⲱⲧⲛ ⲡⲉ ⲡⲟⲩⲟⲉⲓⲛ ⲙⲡ**ⲕⲟⲥⲙⲟⲥ** ·",
      "english": "And again, 'Ye are the light of the world.'",
      "source": "Life of Pisentius part 1",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:1-31",
