  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲙⲙⲟⲛⲛⲟⲩⲛⲓ ⲛϧⲏⲧⲟⲩ ⲁⲗⲗⲁ ϩⲁⲛⲡⲣⲟⲥⲟⲩⲥⲏⲟⲩ ⲛⲉ **ⲓⲧⲁ** ⲁⲣⲉϣⲁⲛⲟⲩϩⲟϫϩⲉϫ ϣⲱⲡⲓ ⲓⲉ ⲟⲩⲇⲓⲱⲅⲙⲟⲥ ⲉⲑⲃⲉⲡⲓⲥⲁϫⲓ ⲥⲁⲧⲟⲧⲟⲩ ϣⲁⲩⲉⲣⲥⲕⲁⲛⲇⲁⲗⲓⲍⲉⲥⲑⲉ .",
      "english": "They have no root in themselves, but are short-lived. When oppression or persecution arises because of the word, immediately they stumble.",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲉⲓⲧⲁ** ϫⲉⲛⲛⲉⲛϫⲱⲱⲣⲉ ⲉⲃⲟⲗ ⲙⲡϣⲁϫⲉ ⁛—",
      "english": "let us then not be troubled at the words.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲇⲁⲙ ⲅⲁⲣ ⲁⲩⲉⲣⲡⲗⲁⲍⲓⲛ ⲙⲙⲟϥ ⲛϣⲟⲣⲡ **ⲓⲧⲁ** ⲉⲩⲁ .",
      "english": "For Adam was first formed, then Eve.",
      "source": "15_I Timothy_02",
      "urn": "urn:cts:copticLit:nt.1tim.bohairic:02",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲉⲓⲧⲁ** ⲡⲉϫⲉⲡⲁⲡⲁⲥ ϫⲉⲧⲱⲟⲩⲛ ⲛⲧⲛϣⲗⲏⲗ",
      "english": "Then the Papa said, 'Rise up, let us pray'",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲧⲁ ⲁϥⲟⲩⲟⲛϩϥ ⲉⲓⲁⲕⲱⲃⲟⲥ **ⲓⲧⲁ** ⲁϥⲟⲩⲟⲛϩϥ ⲉⲛⲓⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲧⲏⲣⲟⲩ .",
      "english": "Then he appeared to James, then to all the apostles,",
      "source": "Bohairic 1 Corinthians 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲉⲓⲧⲁ** ⲁϥⲟⲩⲉϩⲥⲁϩⲛⲉ ⲉⲧⲣⲉⲩⲉⲓⲛⲉ ⲉϩⲟⲩⲛ ⲛⲁϥ ⲛⲛϣⲏⲣⲉ ⲛⲧⲉⲥϩⲓⲙⲉ ⲛⲣⲙⲧⲁⲛⲧⲓⲟⲭⲓⲁ ⲙⲡⲙⲉϩϣⲟⲙⲛⲧ ⲛⲥⲟⲡ · ⲁⲩⲱ ⲛⲧⲉⲩⲛⲟⲩ ⲁⲡⲙⲟⲟⲩ ⲛⲧⲕⲟⲗⲩⲙⲃⲏⲑⲣⲁ ϫⲱⲥ ⲁϥⲣⲧϩⲉ ⲛⲟⲩⲱⲛⲉ ·",
      "english": "Then the Archbishop commanded [him] to bring in to him the children of the wife of the man of Antioch a third time, and straightway the water in the font congealed and became like stone.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 2",
