  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲁⲩⲛⲟϭ ⲛⲁⲓⲥⲑⲏⲥⲓⲥ · ϣⲱⲡⲉ ϩⲙⲡⲁⲥⲁ **ⲛϩⲟⲩⲛ** ·",
      "english": "and a mighty ecstasy took place within me,",
      "source": "Life of Onnophrius part 2",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:9-16",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲛⲉⲟⲩⲛⲉⲡⲓⲥⲧⲏⲙⲏ ⲅⲁⲣ ⲙⲙⲟ . ⲕⲁⲛ ⲁⲩⲙⲓϣⲉ ⲛⲙⲙⲉ ⲛⲁⲙⲉ ⲧⲉⲏⲡ ⲉⲕⲁⲣⲱⲙⲉ ⲉⲉⲓⲙⲉ ϫⲉⲉⲧⲉⲧⲛⲟ ⲛⲁϣ ⲛϩⲉ **ⲛϩⲟⲩⲛ** ⲙⲡⲉⲧⲛⲙⲁ ·",
      "english": "For if there had been knowledge in you, even if they truly fought with you, then you ought to let a man know how they are inside your place.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲛⲛⲥⲁⲛⲁⲓ ⲁⲡⲥⲟⲛ ⲣⲟⲩⲱ ⲛⲁⲓ ϩⲙⲡⲥⲁ **ⲛϩⲟⲩⲛ** · ⲉϥϫⲱ ⲙⲙⲟⲥ · ϫⲉⲭⲁⲓⲣⲉ ⲁⲡⲁ ⲡⲁⲙⲃⲱ ⲡⲉⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ ⲛⲧⲉⲕⲕⲗⲏⲥⲓⲁ · ⲛϣⲓⲏⲧ ⲁⲩⲱ ⲡⲛⲟϭ ⲛϫⲟⲓ ⲉⲧⲣϩⲱⲧ ϩⲙⲡϫⲁⲓⲉ ⲛⲁⲧⲙⲟⲟⲩ ·",
      "english": "And after these things the brother answered me from within, saying, 'Hail, Apa Pambo, thou elder of the church of Shiet, thou mighty ship that sailest over the desert that is without water.",
      "source": "Life of Cyrus in Budge ed. part 1",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:1-9",
      "dialect": "sahidic"
    }
