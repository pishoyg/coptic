  "examples": [
    {
      "coptic": "ⲛⲉⲁⲛⲉⲩⲃⲁⲗ ⲅⲁⲣ **ϩⲧⲟⲙⲧⲙ** ⲡⲉ ⲉⲃⲟⲗ ⲙⲡⲛⲟϭ ⲛⲟⲩⲟⲉⲓⲛ ⲉⲛϥϣⲟⲟⲡ ⲛϩⲏⲧϥ ·",
      "english": "for their eyes were darkened because of the great light in which he was.",
      "source": "Pistis Sophia Book 1 Part 1",
      "urn": "urn:cts:copticLit:pistissophia.1.petermann:1-13",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲙⲙⲟⲛ ⲁⲛⲉⲛⲃⲁⲗ **ϩⲧⲟⲙⲧⲙ** ⲁⲩⲱ ⲁⲛϣⲧⲟⲣⲧⲣ ⲁⲩⲱ ⲟⲛ ⲁϥϣⲧⲟⲣⲧⲣ ⲛϭⲓⲡⲕⲟⲥⲙⲟⲥ ⲧⲏⲣϥ ⲉⲃⲟⲗ ⲙⲡⲛⲟϭ ⲛⲟⲩⲟⲉⲓⲛ ⲉⲧϣⲟⲟⲡ ⲙⲙⲟⲕ :",
      "english": "“otherwise our eyes are darkened, and we are agitated, and the whole world also is in agitation because of the great light which is about thee.”",
