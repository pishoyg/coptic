  "examples": [
    {
      "coptic": "ⲡⲱⲥ ⲁϥϯⲙⲁϯ ⲡⲱⲥ ⲁϥⲫⲱⲛϩ ⲛⲧⲉϥ**ϭⲓⲥⲓ** ⲛϫⲉⲙⲱⲁⲃ ⲁϥϭⲓϣⲓⲡⲓ ⲟⲩⲟϩ ⲁϥϣⲱⲡⲓ ⲛϫⲉⲙⲱⲁⲃ ⲉⲩⲥⲱⲃⲓ ⲛⲉⲙⲟⲩϫⲱⲛⲧ ⲛⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲧⲕⲱϯ ⲉⲣⲟϥ .",
      "english": "How has he changed! how has Moab turned his back! Moab is put to shame, and become a laughing-stock, and an object of anger to all that are round about him.",
      "source": "24_Ieremias_31",
      "urn": "urn:cts:copticLit:ot.jer.bohairic_ed:31",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϣⲁⲣⲉⲛⲧⲁϭⲥⲉ ⲅⲁⲣ ⲙⲡⲁϣⲃⲣϩⲙϩⲁⲗ ⲧϩⲣϣⲟ ⲛⲧⲁ**ϫⲓⲥⲉ** ·",
      "english": "The footsteps of my fellow-servant (Peter) did indeed press upon my back,",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲟⲩⲇⲁⲥ ⲉⲩⲉⲥⲙⲟⲩ ⲉⲣⲟⲕ ⲛϫⲉⲛⲉⲕⲥⲛⲏⲟⲩ ⲛⲉⲕϫⲓϫ ⲉⲩⲉϣⲱⲡⲓ ϩⲓϫⲉⲛⲧ**ϭⲓⲥⲓ** ⲛⲧⲉⲛⲉⲕϫⲁϫⲓ ⲉⲩⲉⲟⲩⲱϣⲧ ⲙⲙⲟⲕ ⲛϫⲉⲛⲉⲛϣⲏⲣⲓ ⲙⲡⲉⲕⲉⲓⲱⲧ",
      "english": "Juda, thy brethren have praised thee, and thy hands shall be on the back of thine enemies; thy father's sons shall do thee reverence.",
      "source": "01_Genesis_49",
      "urn": "urn:cts:copticLit:ot.gen.bohairic_ed:49",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲛⲉϫ ⲇⲉ ⲛⲁϣⲏ ⲛⲉⲓⲧⲛ ⲉⲡ**ϫⲓⲥⲉ** ⲉⲁⲩⲛⲟϭ ⲛϣⲟⲉⲓϣ ⲧⲱⲟⲩⲛ ⲉϫⲱⲓ ·",
      "english": "now they ejected a lot of dung on my back, and threw up very much dust about me,",
      "source": "Life of Pisentius part 3",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:58-84",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲟⲩⲃⲁⲗ ⲙⲁⲣⲟⲩⲉⲣⲭⲣⲉⲙⲧⲥ ⲉϣⲧⲉⲙⲛⲁⲩ ⲙⲃⲟⲗ ⲧⲟⲩ**ϭⲓⲥⲓ** ⲙⲁⲣⲉⲥⲕⲱⲗϫ ⲛⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ .",
      "english": "Let their eyes be darkened, that they may not see. Bow down their back always.'",
      "source": "06_Romans_11",
      "urn": "urn:cts:copticLit:nt.rom.bohairic:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϣⲁϥϭⲱϣⲧ ⲉⲃⲟⲗ ϩⲙⲡ**ϫⲓⲥⲉ** ϩⲛⲛⲁⲟⲩⲛⲁⲙ ⲛϭⲓⲡⲛⲟϭ ⲛⲥⲁⲃⲁⲱⲑ ⲡⲁⲅⲁⲑⲟⲥ ⲛⲧⲉⲡⲕⲟⲥⲙⲟⲥ ⲧⲏⲣϥ ⲙⲛⲧⲉⲥⲫⲁⲓⲣⲁ ⲧⲏⲣⲥ ϩⲁⲧϩⲏ ⲉⲙⲡⲁⲧϥϭⲱϣⲧ · ⲛϥϭⲱϣⲧ ⲉⲡⲉⲥⲏⲧ ⲉϫⲛⲛⲧⲟⲡⲟⲥ ⲛⲧⲡⲁⲣⲁⲡⲗⲏⲝ ⲛⲧⲉⲛⲉⲥⲧⲟⲡⲟⲥ ⲃⲱⲗ ⲉⲃⲟⲗ · ⲛⲥⲉⲧⲁⲕⲟ · ⲁⲩⲱ ⲛⲉⲯⲩⲭⲟⲟⲩⲉ ⲧⲏⲣⲟⲩ ⲉⲧϩⲛⲛⲉⲥⲕⲟⲗⲁⲥⲓⲥ ϣⲁⲩϥⲓⲧⲟⲩ ⲛⲥⲉⲧⲥⲧⲟⲟⲩ ⲉⲧⲉⲥⲫⲁⲓⲣⲁ ⲛⲕⲉⲥⲟⲡ ⲉⲃⲟⲗ ϫⲉⲁⲩⲧⲁⲕⲟ ϩⲛⲛⲕⲟⲗⲁⲥⲓⲥ ⲛⲧⲡⲁⲣⲁⲡⲗⲏⲝ ·",
      "english": "“draw themselves aside, and there looketh from the height out of those of the Right the | great Sabaōth, the Good; and the whole world and the total sphere [become alarmed] before he hath looked forth. And he looketh down on the regions of Paraplēx, so that her regions may be dissolved and perish. And all the souls which are in her chastisements, are carried and cast back [up] into the sphere anew, because they are ruined in the chastisements of Paraplēx.”",
      "source": "Pistis Sophia Book 4 Part 1",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:120-128",
      "dialect": "sahidic"
    }
