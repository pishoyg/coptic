  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥϫⲟⲥ ⲛⲱⲟⲩ ϫⲉⲙⲁϣⲉ ⲛⲱⲧⲉⲛ ⲉⲡⲓⲕⲟⲥⲙⲟⲥ ⲟⲩⲟϩ ϧⲉⲛϩⲱⲃ ⲛⲓⲃⲉⲛ ϩⲓⲱⲓϣ ⲙⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ⲙⲡⲓ**ⲥⲱⲛⲧ** ⲧⲏⲣϥ .",
      "english": "He said to them, 'Go into all the world, and preach the Good News to the whole creation.",
      "source": "Bohairic Gospel of Mark 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲡⲁⲓ ⲙⲡⲣⲧⲣⲉⲛⲁⲡⲟⲧⲁⲥⲥⲉ ⲉⲧⲙϥⲓ ϩⲁⲛⲉⲛⲉⲣⲏⲩ ϫⲉⲛⲛⲉⲡⲛⲟⲩⲧⲉ ϭⲱⲛⲧ ⲉⲣⲟⲛ ϫⲉⲙⲡⲁⲧⲛⲱⲥⲕ ⲅⲁⲣ ⲉⲛϥⲓ ϩⲁⲛⲉⲛⲉⲣⲏⲩ ⲛⲧϩⲉ ⲙⲡϫⲟⲉⲓⲥ ⲁⲩⲱ ⲡⲉϥⲭⲣⲓⲥⲧⲟⲥ ⲙⲛⲛⲉϥⲁⲅⲅⲉⲗⲟⲥ ⲉⲧⲟⲩⲁⲁⲃ ⲉⲧϥⲓ ϩⲁⲣⲟⲛ ϫⲓⲛⲧⲁⲣⲭⲏ ⲙⲡ**ⲥⲱⲛⲧ** ϣⲁϩⲣⲁⲓ ⲉⲡϩⲟⲟⲩ ⲛϩⲟⲟⲩ ⲁⲩⲱ ⲟⲛ ϣⲁⲉⲛⲉϩ ·",
      "english": "For this reason, let us not give up to not support each other that God may not be mad at us that we have indeed not yet continued to support each other like the Lord and his Christ and His angels that are holy, which support us since the beginning of creation and up until the day of days and also forever.",
      "source": "Abraham Our Father XL 93-94",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbxl:23-24",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲥϫⲉⲛⲧⲁⲣⲭⲏ ⲇⲉ ⲙⲡⲓ**ⲥⲱⲛⲧ** ⲟⲩϩⲱⲟⲩⲧ ⲛⲉⲙⲥϩⲓⲙⲓ ⲡⲉⲧⲁϥⲥⲟⲛⲧⲟⲩ",
      "english": "But from the beginning of the creation, God made them male and female.",
      "source": "Bohairic Gospel of Mark 10 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:10",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡ**ⲥⲱⲛⲧ** ⲛⲁϣϩⲱⲃⲥ ⲁⲛ ⲛⲧⲉⲫⲩⲥⲓⲥ ·",
      "english": "And creation could not clothe herself with (her covering of) nature",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲱⲥⲧⲉ ⲫⲏ ⲉⲧϧⲉⲛⲡⲭⲣⲓⲥⲧⲟⲥ ⲟⲩ**ⲥⲱⲛⲧ** ⲙⲃⲉⲣⲓ ⲡⲉ ⲛⲓⲁⲣⲭⲉⲟⲥ ⲁⲩⲥⲓⲛⲓ ⲓⲥ ϩⲁⲛⲃⲉⲣⲓ ⲁⲩϣⲱⲡⲓ .",
      "english": "Therefore if anyone is in Christ, he is a new creation. The old things have passed away. Behold, all things have become new.",
      "source": "08_II Corinthians_05",
      "urn": "urn:cts:copticLit:nt.2cor.bohairic:05",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲉϥϣⲁⲛⲉⲓ ⲉⲃⲟⲗ ⲉⲡⲱϩⲥ · ⲙⲉⲩⲧⲁϩⲙⲉϥ ⲟⲩⲇⲉ ⲉⲧⲕⲉⲉⲕⲕⲗⲏⲥⲓⲁ · ϩⲱⲥ ⲉⲡ**ⲥⲱⲛⲧ** ⲡⲉ ⲉⲧⲁϩⲙⲟⲩ ⲉⲧⲁⲅⲁⲡⲏ ⲻ",
