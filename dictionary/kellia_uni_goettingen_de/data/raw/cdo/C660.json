  "examples": [
    {
      "coptic": "ⲟⲩϫⲱϥ ϧⲁⲟⲩϫⲱϥ ⲟⲩⲫⲱϧ ϧⲁⲟⲩⲫⲱϧ ⲟⲩⲗⲉⲗⲉⲭⲏⲙⲓ ϧⲁⲟⲩ**ⲗⲉⲗⲉⲭⲏⲙⲓ**",
      "english": "burning for burning, wound for wound, stripe for stripe.",
      "source": "02_Exodus_21",
      "urn": "urn:cts:copticLit:ot.exod.bohairic_ed:21",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲧϯⲥⲃⲱ ⲛⲛⲉⲧϩⲟⲟⲩ ⲉϥⲛⲁϫⲓ ⲛⲁϥ ⲛϩⲉⲛⲥⲱϣ ⲉⲣⲉⲟⲩⲥⲱϣ ⲇⲉ ⲛⲏⲩ ⲉϫⲛⲛⲉⲧϩⲟⲟⲩ ϩⲙⲡⲉⲧⲟⲩϭⲱϣⲧ ⲉⲃⲟⲗ ϩⲏⲧϥ ϩⲉⲛ**ⲉⲗⲉⲗⲕⲏⲙⲉ** ⲛⲉ ⲛⲉϫⲡⲓⲟ ⲉⲧϣⲟⲟⲡ ⲙⲡⲁⲥⲉⲃⲏⲥ",
      "english": "He that reproves evil men shall get dishonour to himself; and he that rebukes an ungodly man shall disgrace himself.",
      "source": "Proverbs 9",
      "urn": "urn:cts:copticLit:ot.prov.coptot:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲭⲱⲛⲥ ⲟⲩⲟϩ ⲁⲩⲉⲣϩⲟⲗⲓ ⲛϫⲉⲛⲁ**ⲗⲉⲗⲉⲭⲏⲙⲓ** ⲉⲃⲟⲗ ϩⲁⲡϩⲟ ⲛⲧⲉⲧⲁⲙⲉⲧⲁⲧⲉⲙⲓ .",
      "english": "My bruises have become noisome and corrupt, because of my foolishness.",
      "source": "19_Psalmi_37",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:37",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲇⲉ ⲛϭⲓⲗⲁⲙⲉⲭ ⲛⲛⲉϥϩⲓⲟⲙⲉ ϫⲉⲁⲧⲇⲁ ⲙⲛⲥⲗⲗⲁ ⲥⲱⲧⲙ ⲉⲡⲁϩⲣⲟⲟⲩ ⲛⲉϩⲓⲟⲙⲉ ⲛⲗⲁⲙⲉⲭ ϫⲓⲥⲙⲏ ⲉⲛⲁϣⲁϫⲉ ϫⲉⲁⲓⲙⲟⲩⲟⲩⲧ ⲛⲟⲩⲣⲱⲙⲉ ⲉⲩⲥⲁϣ ⲛⲁⲓ ⲁⲩⲱ ⲟⲩϩⲉⲣϣⲓⲣⲉ ⲉⲩ**ⲉⲗⲉⲗⲕⲏⲙⲉ** ⲛⲁⲓ",
      "english": "And Lamech said to his wives, Ada and Sella, Hear my voice, ye wives of Lamech, consider my words, because I have slain a man to my sorrow and a youth to my grief.",
      "source": "Genesis 4",
      "urn": "urn:cts:copticLit:ot.gen.coptot:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲟϥ ⲇⲉ ⲁϥϭⲓⲉⲣϧⲟⲧ ⲉⲑⲃⲉⲛⲉⲛⲛⲟⲃⲓ ⲟⲩⲟϩ ⲁϥϣⲱⲛⲓ ⲉⲑⲃⲉⲛⲉⲛⲁⲛⲟⲙⲓⲁ : ⲧⲥⲃⲱ ⲛⲧⲉⲧⲉⲛϩⲓⲣⲏⲛⲏ ⲉϩⲣⲏⲓ ⲉϫⲱϥ ϧⲉⲛⲛⲉϥ**ⲗⲉⲗⲉⲭⲏⲙⲓ** ⲁⲛⲟⲛ ⲁⲛⲟⲩϫⲁⲓ .",
      "english": "But he was wounded on account of our sins, and was bruised because of our iniquities: the chastisement of our peace was upon him; and by his bruises we were healed.",
      "source": "23_Isaias_53",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:53",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲉⲛ**ⲉⲗⲉⲗⲕⲏⲙⲉ** ⲙⲛϩⲛⲟⲩⲱϣϥ ⲛⲉⲧⲛⲁⲧⲱⲙⲛⲧ ⲉⲛⲉⲑⲟⲟⲩ ϩⲉⲛⲡⲗⲏⲅⲏ ⲇⲉ ⲛⲉ ⲛⲧⲁⲙⲉⲓⲟⲛ ⲛϩⲏⲧⲟⲩ",
      "english": "Bruises and contusions befall bad men; and plagues shall come in the inward parts of their belly.",
      "source": "Proverbs 20",
      "urn": "urn:cts:copticLit:ot.prov.coptot:20",
      "dialect": "sahidic"
    }
