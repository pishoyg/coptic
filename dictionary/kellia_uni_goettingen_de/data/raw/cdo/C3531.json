  "examples": [
    {
      "coptic": "ⲉϣϫⲉ ⲉⲣϣⲁⲛⲟⲩϩⲙϩⲁⲗ ⲥⲟϣⲕ ⲙⲉⲕϩⲓⲟⲩⲉ ⲉⲣⲟϥ ⲁⲗⲗⲁ ϣⲁⲕ**ⲥⲙⲙⲉ** ⲉⲣⲟϥ ⲙⲡⲉϥϫⲟⲉⲓⲥ ·",
      "english": "If a servant were to treat thee with insolence thou wouldst not thyself beat him, but wouldst make an accusation against him to his master.",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲡⲁⲓ ⲟⲛ ⲟⲩⲛϭⲟⲙ ⲙⲙⲟϥ ⲉⲧⲟⲩϫⲟ ⲛⲟⲩⲟⲉⲓϣ ⲛⲓⲙ ⲛⲛⲉⲧⲛⲁϯⲡⲉⲩⲟⲩⲟⲓ ⲉⲡⲛⲟⲩⲧⲉ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧϥ . ⲉϥⲟⲛϩ ⲛⲟⲩⲟⲉⲓϣ ⲛⲓⲙ ⲉϥ**ⲥⲙⲙⲉ** ϩⲁⲣⲟⲟⲩ .",
      "english": "Therefore he is also able to save to the uttermost those who draw near to God through him, seeing that he lives forever to make intercession for them.",
      "source": "58_Hebrews_7",
      "urn": "urn:cts:copticLit:nt.heb.sahidica:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣϫⲉ ⲧⲩⲙⲏⲧⲣⲓⲟⲥ ϭⲉ ⲁⲩⲱ ⲛⲉϥϣⲃⲣⲧⲉⲭ ⲛⲓⲧⲏⲥ ⲟⲩⲛⲧⲟⲩ ⲟⲩϣⲁϫⲉ ⲙⲙⲁⲩ . ϣⲁⲩⲛ ϩⲉⲛⲁⲅⲟⲣⲁⲓⲟⲥ . ⲁⲩⲱ ⲟⲩⲛ ϩⲉⲛⲁⲛⲑⲩⲡⲁⲧⲟⲥ ⲙⲁⲣⲟⲩ**ⲥⲙⲙⲉ** ⲛⲁⲩ .",
      "english": "If therefore Demetrius and the craftsmen who are with him have a matter against anyone, the courts are open, and there are proconsuls. Let them press charges against one another.",
      "source": "44_Acts of the Apostles_19",
      "urn": "urn:cts:copticLit:nt.acts.sahidica:19",
      "dialect": "sahidic"
    }
