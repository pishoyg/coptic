  "examples": [
    {
      "coptic": "ⲉⲓⲛⲁϣ**ϫⲱⲱⲃⲉ** ⲛⲁϣ ⲛϩⲉ ⲙⲡⲡⲉⲗⲁⲅⲟⲥ ⲛⲛⲉⲕⲕⲁ ⲧⲟⲣⲑⲱⲙⲁ · ⲉⲧⲃⲉⲡⲁⲓ ⲣⲱ ⲁⲓⲕⲁⲡⲁⲧⲏⲃⲉ ϩⲓⲣⲛⲣⲱⲓ ·",
      "english": "How can I possibly pass over the sea of thy splendid deeds? For this reason I lay my finger on my mouth",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲡⲁⲣⲭⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ϫⲉϯⲣϩⲟⲧⲉ ⲉϫⲟⲟⲥ ⲉⲩⲣⲱⲙⲉ ⲛⲣⲉϥϣⲱⲛⲉ ⲛⲣⲉϥϣⲡϩⲓⲥⲉ ϫⲉⲉϥⲫⲟⲣⲉⲓ ⲛⲧϩⲓⲕⲱⲛ ⲙⲡⲛⲟⲩⲧⲉ ⲛⲁⲡⲁⲑⲏⲥ ⲛⲉⲩⲧⲏⲗⲉⲥ ⲉϣⲁϥϩⲙⲟⲟⲥ ϩⲓⲃⲟⲗ ⲛϥⲡⲁⲣⲁⲥⲕⲉⲩⲁⲍⲉ ⲛⲁϣⲛϩⲉ ⲕⲛⲁⲙⲉⲉⲩⲉ ⲉⲣⲟϥ ⲙⲛⲡⲟⲩⲟⲉⲓⲛ ⲙⲙⲉ ⲉⲧⲉⲙⲉⲣⲉⲗⲁⲁⲩ **ϫⲟⲟⲃⲉ**ϥ",
      "english": "The archbishop said: I am afraid to tell a sick man or a suffering man that he carries the image of God, the one unaffected by the vulgar, who stands (lit.: sits) beyond and commands - how can you think of him and the light of Truth which no-one can surpass?",
      "source": "Life of Apa Aphou part 1",
      "urn": "urn:cts:copticLit:lives.aphou.paths_ed:0-61",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉⲧⲉⲟⲩⲛⲧⲁϥ ⲙⲙⲁⲩ ⲛⲧⲙⲛⲧⲁⲧⲙⲟⲩ ⲙⲁⲩⲁⲁϥ . ⲡⲉⲧⲟⲩⲏϩ ϩⲙⲡⲟⲩⲟⲉⲓⲛ ⲉⲧⲉⲙⲉⲣⲉ ⲗⲁⲁⲩ **ϫⲟⲟⲃⲉ**ϥ ⲡⲉⲧⲉⲙⲡⲉ ⲗⲁⲁⲩ ⲛⲣⲱⲙⲉ ⲛⲁⲩ ⲉⲣⲟϥ ⲟⲩⲇⲉ ⲟⲛ ⲙⲛϣϭⲟⲙ ⲉⲧⲣⲉⲩⲛⲁⲩ . ⲡⲁⲓ ⲉⲧⲉⲡⲱϥ ⲡⲉ ⲡⲧⲁⲉⲓⲟ ⲙⲛⲡⲁⲙⲁϩⲧⲉ ϣⲁⲉⲛⲉϩ ⲛⲉⲛⲉϩ ϩⲁⲙⲏⲛ .",
      "english": "who alone has immortality, dwelling in unapproachable light; whom no man has seen, nor can see: to whom be honor and eternal power. Amen.",
      "source": "54_1 Timothy_6",
      "urn": "urn:cts:copticLit:nt.1tim.sahidica:6",
