  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲩϭⲓⲧϥ ⲁⲩϩⲓⲟⲩⲓ ⲉⲣⲟϥ ⲟⲩⲟϩ ⲁⲩⲟⲩⲟⲣⲡϥ ⲉϥ**ϣⲟⲩⲓⲧ** .",
      "english": "They took him, beat him, and sent him away empty.",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲙⲉⲣⲉⲛⲛⲏⲏⲃⲉ **ϣⲟⲩⲟ** ⲉϩⲣⲁⲓ ⲙⲡⲁⲩⲉⲓⲛ ⲉⲧⲃⲉⲡⲁϣⲁⲓ ⲛⲛⲧⲏⲩ ⲛⲧⲁⲩⲉⲓ ⲉϫⲱⲟⲩ .",
      "english": "but the sailors don't empty out the cargo because of the multitude of winds that come against them.",
      "source": "Apophthegmata Patrum Sahidic 041: Syncletica 9 (11)",
      "urn": "urn:cts:copticLit:ap.41.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲅ ⲛⲥⲏⲟⲩ ⲛϯⲣⲟⲙⲡⲓ ⲉϥⲉⲟⲩⲟⲛϩϥ ⲛϫⲉϩⲱⲟⲩⲧ ⲛⲓⲃⲉⲛ ⲛⲧⲁⲕ ⲙⲡⲉⲙⲑⲟ ⲙⲡϭⲟⲓⲥ ⲡⲉⲕⲛⲟⲩϯ ϧⲉⲛⲡⲓⲙⲁ ⲉⲧⲉϥⲛⲁⲥⲟⲧⲡϥ ⲛⲁϥ ⲛϫⲉⲡϭⲟⲓⲥ ⲡⲉⲕⲛⲟⲩϯ ϧⲉⲛⲡϣⲁⲓ ⲛⲧⲉⲛⲓⲁⲧϣⲉⲙⲏⲣ ⲛⲉⲙϧⲉⲛⲡϣⲁⲓ ⲛⲧⲉⲛⲓⲁⲛⲍ ⲛⲉⲙϧⲉⲛⲡϣⲁⲓ ⲛⲧⲉϯⲥⲕⲏⲛⲟⲡⲏⲕⲓⲁ ⲛⲛⲉⲕⲟⲩⲟⲛϩⲕ ⲙⲡⲉⲙⲑⲟ ⲙⲡϭⲟⲓⲥ ⲡⲉⲕⲛⲟⲩϯ ⲉⲕ**ϣⲟⲩⲓⲧ**",
      "english": "Three times in the year shall all thy males appear before the Lord thy God in the place which the Lord shall choose in the feast of unleavened bread, and in the feast of weeks, and in the feast of tabernacles: thou shalt not appear before the Lord thy God empty.",
      "source": "05_Deuteronomium_16",
      "urn": "urn:cts:copticLit:ot.deut.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁⲥ ⲟⲛ ⲛⲁⲥ ϫⲉⲡⲉⲓⲥⲟⲟⲩ ⲛϣⲓ ⲛⲉⲓⲱⲧ ⲁϥⲧⲁⲁⲩ ⲛⲁⲓ ⲉⲧⲃⲉϫⲉⲁϥϫⲟⲟⲥ ⲛⲁⲓ ϫⲉⲙⲡⲣⲃⲱⲕ ⲉϩⲟⲩⲛ ⲉϩⲣⲁⲥ ⲛⲧⲟⲩϣⲱⲙⲉ ⲉⲣⲉ**ϣⲟⲩⲉⲓⲧ**",
      "english": "And she said to her, He gave me these six measures of barley, for he said to me, Go not empty to thy mother-in-law.",
      "source": "Ruth Chapter 3",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏ ⲥⲉⲛⲁⲟⲩⲉⲙ ⲱⲓⲕ ⲛⲁⲧϩⲙⲟⲩ ⲭ ⲓⲉ ⲟⲩⲟⲛ ϩⲗⲏϫⲓ ⲛⲧⲉϩⲁⲛⲥⲁϫⲓ ⲉⲩ**ϣⲟⲩⲓⲧ** .",
      "english": "Shall bread be eaten without salt? or again, is there taste in empty words?",
      "source": "18_Iob_06",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:06",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲁⲓⲃⲱⲕ ⲉⲓⲙⲉϩ ⲡϫⲟⲉⲓⲥ ⲇⲉ ⲁϥⲕⲧⲟⲓ ⲉⲓ**ϣⲟⲩⲉⲓⲧ** ⲁⲩⲱ ⲉⲧⲃⲉⲟⲩ ⲉⲧⲉⲧⲛⲛⲁⲙⲟⲩⲧⲉ ⲉⲣⲟⲓ ϫⲉⲛⲟⲉⲙⲓⲛ ⲁⲩⲱ ⲡϫⲟⲉⲓⲥ ⲁϥⲑⲃⲃⲓⲟⲓ ⲁⲩⲱ ⲡϩⲓⲕⲁⲛⲟⲥ ⲁϥⲑⲙⲕⲟⲓ",
      "english": "I went out full, and the Lord has brought me back empty: and why call ye me Noemin, whereas the Lord has humbled me and the Mighty One has afflicted me?",
      "source": "Ruth Chapter 1",
