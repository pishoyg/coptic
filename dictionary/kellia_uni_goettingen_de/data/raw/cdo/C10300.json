  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲛϩⲟⲥⲱⲛ ⲉⲕⲉⲓⲣⲉ ϩⲓⲛⲁⲓ · ϣⲁⲣⲉⲧⲉ**ⲡⲣⲟⲑⲉⲥⲙⲓⲁ** ⲙⲡⲉⲕⲁϩⲉ ϫⲱⲕ ⲉⲃⲟⲗ · ⲛⲥⲉϫⲟⲗϩⲕ ⲛⲧϩⲉ ⲛⲟⲩⲉⲗⲗϩⲙϫ ⲛⲥⲉϥⲓⲧϥ ·",
      "english": "And whilst thou art occupied in doing these things the period of thy life which is appointed unto thee cometh to an end, and thou art rejected, like a sour grape, and they bear thee away.",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲕⲉϭⲱ ⲛⲧⲉⲓϩⲉ ⲉⲕⲟ ⲛⲣⲣⲟ ⲉϩⲣⲁⲓ ⲉϫⲱⲟⲩ ϣⲁⲛⲧⲉⲧ**ⲡⲣⲟⲑⲉⲥⲙⲓⲁ** · ⲛⲧⲁⲓⲧⲁⲁⲥ ⲙⲡⲕⲟⲥⲙⲟⲥ ϫⲱⲕ ⲉⲃⲟⲗ ·",
      "english": "Thus thou shalt continue to be king over them until the period for which I have ordained the world [to last] shall be ended.",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡϥⲟⲩⲱϣ ⲉϭⲱ ϣⲁⲧⲉ**ⲡⲣⲟⲑⲉⲥⲙⲓⲁ** ⲙⲡⲉϥⲁϩⲉ · ⲁⲗⲗⲁ ⲛⲉϥⲣⲟⲕϩ ⲉⲓ ⲉⲃⲟⲗ ϩⲙⲡⲉⲓⲙⲁ ⲛϥⲛⲁⲩ ⲉⲡⲉⲧϥⲙⲉ ⲙⲙⲟϥ ·",
      "english": "He did not wish to wait until the appointed time in his life, but he burned with desire to come forth from this place (or, world), and to see Him Whom he loved.",
      "source": "On Penitence and Abstinence, part 2",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:120-241",
      "dialect": "sahidic"
    }
