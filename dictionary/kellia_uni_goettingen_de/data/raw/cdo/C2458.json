  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲉⲙⲡⲟⲩϣϫⲉⲙϫⲟⲙ ⲛⲉⲛϥ ⲉϧⲟⲩⲛ ⲉⲑⲃⲉⲡⲓⲙⲏϣ ⲁⲩϣⲉ ⲛⲱⲟⲩ ⲉϫⲉⲛⲡϫⲉⲛⲉⲫⲱⲣ ⲁⲩϭⲱⲣⲡ ⲛϯⲟⲩⲁϩⲥⲟⲓ ⲉⲃⲟⲗ ⲛⲧⲉⲡⲓⲏⲓ ⲉⲛⲁⲩⲭⲏ ⲛϧⲏⲧϥ ⲟⲩⲟϩ ⲉⲧⲁⲩϣⲱⲕⲓ ⲁⲩⲭⲱ ⲙⲡⲓϭⲗⲟϫ ⲉⲡⲉⲥⲏⲧ ⲉⲧⲉⲫⲏ ⲉⲧϣⲏⲗ ⲉⲃⲟⲗ **ⲛⲕⲟⲧ** ϩⲓⲱⲧϥ .",
      "english": "When they could not come near to him for the crowd, they removed the roof where he was. When they had broken it up, they let down the mat that the paralytic was lying on.",
      "source": "Bohairic Gospel of Mark 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ ⲙⲉⲓ**ⲛⲕⲟⲧⲕ** ⲉⲛⲉϩ ·",
      "english": "I never go to sleep.",
      "source": "Apophthegmata Patrum Sahidic 102: Macarius 11",
      "urn": "urn:cts:copticLit:ap.102.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧϣⲱⲙⲓ ⲇⲉ ⲛⲥⲓⲙⲱⲛ ⲛⲁⲥ**ⲛⲕⲟⲧ** ⲡⲉ ⲉⲥϧⲏⲙ ⲟⲩⲟϩ ⲥⲁⲧⲟⲧⲟⲩ ⲁⲩϫⲟⲥ ⲛⲁϥ ⲉⲑⲃⲏⲧⲥ .",
      "english": "Now Simon’s wife’s mother lay sick with a fever, and immediately they told him about her.",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲃⲟⲉⲥ ⲁϥⲟⲩⲱⲙ ⲁⲩⲱ ⲁϥⲥⲱ ⲁⲡⲉϥϩⲏⲧ ⲟⲩⲛⲟϥ ⲁϥⲉⲓ ⲉⲧⲣⲉϥⲛⲕⲟⲧⲕ ϩⲛⲧⲙⲉⲣⲓⲥ ⲉⲧϩⲟⲣϭ ⲛⲧⲟⲥ ⲇⲉ ϩⲣⲟⲩⲑ ⲁⲥⲉⲓ ⲛϩⲱⲡ ⲁⲥϭⲱⲗⲡ ϩⲁⲣⲁⲧϥ ⲉⲃⲟⲗ ⲁⲩⲱ ⲁⲥ**ⲛⲕⲟⲧⲕ**",
      "english": "And Booz ate and drank, and his heart was glad, and he came to lie down by the side of the heap of corn; and she came secretly, and lifted up the covering of his feet.",
      "source": "Ruth Chapter 3",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲑⲟϥ ⲛⲁϥ**ⲛⲕⲟⲧ** ϩⲓⲫⲁϩⲟⲩ ϩⲓϫⲉⲛⲡⲓϣϣⲟⲧ ⲟⲩⲟϩ ⲁⲩⲛⲉϩⲥⲓ ⲙⲙⲟϥ ⲟⲩⲟϩ ⲡⲉϫⲱⲟⲩ ⲛⲁϥ ϫⲉⲫⲣⲉϥϯⲥⲃⲱ ⲥⲉⲣⲙⲉⲗⲓⲛ ⲛⲁⲕ ⲁⲛ ϫⲉⲧⲉⲛⲛⲁⲧⲁⲕⲟ",
      "english": "He himself was in the stern, asleep on the cushion, and they woke him up, and told him, 'Teacher, don't you care that we are dying?'",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁⲧⲉⲧⲛϩⲱⲣⲡ ⲙⲙⲉⲉⲣⲉ ⲛⲧϩⲉ ⲛⲛⲉⲧ**ⲛⲕⲟⲧⲕ** ⲛⲧⲉⲩϣⲏ ·",
