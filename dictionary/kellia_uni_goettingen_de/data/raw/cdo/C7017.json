  "examples": [
    {
      "coptic": "ⲉϣϫⲉ ⲕϥⲓⲣⲟⲟⲩϣ ϩⲁⲡϩⲏⲕⲉ ⲱ ⲡⲉⲡⲣⲟⲇⲟⲧⲏⲥ ⲁϩⲣⲟⲕ ⲕ**ϩⲱϥⲧ** ⲛⲛⲉⲩⲛⲕⲁ ϩⲙⲡⲉⲕⲗⲟⲥⲟⲅⲟⲙⲱⲛ ·",
      "english": "If thou didst care for the poor, O betrayer, why didst thou steal their property from the coffer of the treasury?",
      "source": "Homily on Matthew 20",
      "urn": "urn:cts:copticLit:psathanasius.matthew20.budge:1-56",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲣⲉϥϫⲓⲟⲩⲉ ⲙⲉϥⲉⲓ ⲉⲧⲃⲉⲗⲁⲁⲩ . ⲉⲓ ⲙⲏⲧⲓ ϫⲉⲕⲁⲁⲥ ⲉϥⲉ**ϩⲱϥⲧ** ⲁⲩⲱ ⲛϥϣⲱⲱⲧ ⲁⲩⲱ ⲛϥⲧⲁⲕⲟ . ⲁⲛⲟⲕ ⲛⲧⲁⲓⲉⲓ ϫⲉⲕⲁⲁⲥ ⲉⲩⲉϫⲓ ⲛⲟⲩⲱⲛⲁϩ ⲁⲩⲱ ⲛⲥⲉϫⲓ ⲟⲩϩⲟⲩⲟ .",
      "english": "The thief only comes to steal, kill, and destroy. I came that they may have life, and may have it abundantly.",
      "source": "43_John_10",
      "urn": "urn:cts:copticLit:nt.john.sahidica:10",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲁϥϫⲉ ⲡⲁⲓ ⲇⲉ . ⲉⲃⲟⲗ ⲁⲛ ϫⲉⲡⲉϥⲣⲟⲟⲩϣ ⲡⲉ ⲉⲧⲃⲉⲛϩⲏⲕⲉ . ⲁⲗⲗⲁ ϫⲉⲛⲉⲩⲣⲉϥϫⲓⲟⲩⲉ ⲡⲉ ⲁⲩⲱ ⲉⲣⲉⲡⲉⲅⲗⲱⲥ ⲥⲟⲕⲟⲙⲟⲛ ⲛⲧⲟⲟⲧϥ ⲛⲉϥ**ϩⲱϥⲧ** ⲛⲛⲉⲧⲟⲩⲛⲟⲩ ϫⲉⲙⲙⲟⲟⲩ ⲉⲣⲟϥ .",
      "english": "Now he said this, not because he cared for the poor, but because he was a thief, and having the money box, used to steal what was put into it.",
      "source": "43_John_12",
