  "examples": [
    {
      "coptic": "ⲉⲗⲓⲟⲩⲥ ⲇⲉ ⲁϥⲉⲣ**ϩⲩⲡⲟⲙⲉⲛⲓⲛ** ⲛⲟⲩⲟϩⲉⲙ ⲛⲓⲱⲃ : ϫⲉⲛⲁϥⲟⲓ ⲛⲛⲓϣϯ ⲉⲣⲟϥ ⲡⲉ ⲛϩⲁⲛⲉϩⲟⲟⲩ .",
      "english": "But Elius had forborne to give an answer to Job, because they were older than he.",
      "source": "18_Iob_32",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:32",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲛⲁⲩ ⲇⲉ ⲛϭⲓⲡⲛⲟⲩⲧⲉ ⲉⲡⲉϥⲑⲃⲃⲓⲟ ϫⲉⲁϥ**ϩⲩⲡⲟⲙⲓⲛⲉ** ⲛⲧⲉⲓϩⲉ ⲉⲡⲛⲟϭⲛⲉϭ ⲛⲛⲣⲱⲙⲉ ·",
      "english": "And God saw his humility, that he was patient with the insults of the men in this way.",
      "source": "Apophthegmata Patrum Sahidic 126: N 123 E",
      "urn": "urn:cts:copticLit:ap.126.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲕⲉⲣϩⲟϯ ⲇⲉ ⲁⲛ ϫⲉϥⲥⲉⲃⲧⲱⲧ ⲛⲏⲓ : ⲛⲓⲙ ⲅⲁⲣ ϥϯ ⲉϧⲟⲩⲛ ⲉϩⲣⲁⲓ: ⲓⲉ ⲛⲓⲙ ⲡⲉ ⲉⲧⲁϥⲟϩⲓ ⲉⲣⲁⲧϥ ⲟⲩⲃⲏⲓ: ⲟⲩⲟϩ ⲁϥⲉⲣ**ϩⲩⲡⲟⲙⲉⲛⲓⲛ** ⲓⲥϫⲉ ⲉⲛⲭⲁⲓ ⲛⲓⲃⲉⲛ ⲉⲧⲥⲁⲡⲉⲥⲏⲧ ⲛⲧⲫⲉ ⲛⲟⲩⲓ ⲛⲉ .",
      "english": "Or who will resist me, and abide, since the whole world under heaven is mine?",
      "source": "18_Iob_41",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥϫⲟⲟⲥ ⲛϭⲓⲁⲡⲁ ϩⲱⲣⲥⲓⲏⲥⲓ . ϫⲉⲟⲩⲧⲱⲱⲃⲉ ⲛⲟⲙⲉ ⲉⲩϣⲁⲛⲛⲟϫⲥ ⲉⲩⲥⲛⲧⲉ ϩⲁⲧⲙⲡⲓⲉⲣⲟ . ⲛⲥⲛⲁ**ϩⲩⲡⲟⲙⲓⲛⲉ** ⲁⲛ ⲛⲟⲩϩⲟⲟⲩ ⲛⲟⲩⲱⲧ .",
      "english": "Apa Orsisius said, 'A mud brick that is laid as a foundation by the river will not last a single day.",
      "source": "Apophthegmata Patrum Sahidic 124: Orsisius 1",
      "urn": "urn:cts:copticLit:ap.124.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉⲛⲧⲁⲩ**ϩⲩⲡⲟⲙⲓⲛⲉ** ⲅⲁⲣ ϩⲙⲡⲁⲓ ⲟⲩⲛⲧⲁⲩ ⲙⲙⲁⲩ ⲛⲟⲩⲑⲗⲓⲯⲓⲥ ϩⲛⲧⲥⲁⲣⲝ ·",
      "english": "For those who bear this have suffering in the flesh,",
      "source": "Apophthegmata Patrum Sahidic 029",
      "urn": "urn:cts:copticLit:ap.29.monbeg",
      "dialect": "sahidic"
    }
  ],
