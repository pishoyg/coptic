  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉϣⲱⲡ ⲛⲧⲉⲡⲉⲕⲃⲁⲗ ⲉⲣⲥⲕⲁⲛⲇⲁⲗⲓⲍⲉⲥⲑⲉ ⲙⲙⲟⲕ ⲫⲟⲣⲕϥ ⲉⲃⲟⲗ ⲛⲁⲛⲉⲥ ⲛⲁⲕ ⲛⲧⲉⲕⲓ ⲉϧⲟⲩⲛ ⲉϯⲙⲉⲧⲟⲩⲣⲟ ⲛⲧⲉⲫⲛⲟⲩϯ ⲉⲟⲩⲃⲁⲗ ⲙⲙⲁⲩⲁⲧϥ ⲉⲧⲉⲣⲟⲕ ⲉϩⲟⲧⲉ ⲉⲟⲩⲟⲛ **ⲃⲁⲗ** ⲙⲙⲟⲕ ⲛⲥⲉϩⲓⲧⲕ ⲉϯⲅⲉⲉⲛⲛⲁ",
      "english": "If your eye causes you to stumble, cast it out. It is better for you to enter into the Kingdom of God with one eye, rather than having two eyes to be cast into the Gehenna of fire,",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲏ ⲡ**ⲃⲁⲗ** ⲉⲛⲧⲁϥⲛⲁⲩ ⲉⲣⲟϥ ·",
      "english": "Or what eye hath ever seen it?",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲓⲙⲉⲧϭⲓⲛϫⲟⲛⲥ ⲛⲓⲙⲉⲧⲡⲉⲧϩⲱⲟⲩ ⲛⲓⲙⲉⲧⲇⲟⲗⲟⲥ ⲛⲓⲥⲱϥ ⲛⲓ**ⲃⲁⲗ** ⲉⲧϩⲱⲟⲩ ⲛⲓϫⲉⲟⲩⲁ ⲟⲩϭⲓⲥⲓ ⲛϩⲏⲧ ⲟⲩⲙⲉⲧⲁⲧⲕⲁϯ",
      "english": "covetings, wickedness, deceit, lustful desires, an evil eye, blasphemy, pride, and foolishness.",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲏ ϫⲉⲡⲉⲕ**ⲃⲁⲗ** ⲟⲩⲡⲟⲛⲏⲣⲟⲥ ⲡⲉ · ϫⲉⲁⲛⲅⲟⲩⲁⲅⲁⲑⲟⲥ ⲁⲛⲟⲕ ·",
      "english": "Or was thine eye evil because I am good?",
      "source": "Homily on Matthew 20",
      "urn": "urn:cts:copticLit:psathanasius.matthew20.budge:1-56",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲥϧⲏⲟⲩⲧ ϫⲉⲛⲏ ⲉⲧⲉⲙⲡⲉ**ⲃⲁⲗ** ⲛⲁⲩ ⲉⲣⲱⲟⲩ ⲟⲩⲇⲉ ⲙⲡⲉⲙⲁϣϫ ⲥⲟⲑⲙⲟⲩ ⲟⲩⲟϩ ⲙⲡⲟⲩϣⲉ ⲉϩⲣⲏⲓ ⲉϫⲉⲛⲡϩⲏⲧ ⲛⲣⲱⲙⲓ ⲛⲏ ⲉⲧⲁⲫⲛⲟⲩϯ ⲥⲉⲃⲧⲱⲧⲟⲩ ⲛⲛⲏ ⲉⲑⲛⲁⲙⲉⲛⲣⲓⲧϥ .",
      "english": "But as it is written, 'Things which an eye didn't see, and an ear didn't hear, which didn't enter into the heart of man, these God has prepared for those who love him.'",
