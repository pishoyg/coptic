  "examples": [
    {
      "coptic": "ⲱ ⲡϩⲁⲅⲓⲟⲥ ⲃⲓⲕⲧⲱⲣ · ⲁⲡⲉⲕⲥⲛⲟϥ ⲛⲧⲁⲩⲡⲁϩⲧϥ ⲉⲃⲟⲗ · **ϣⲟⲣϣⲣ** ⲛⲧⲉⲥⲧⲩⲗⲏ ⲛⲧⲃⲁϩⲁⲗ · ⲛⲧϩⲉ ⲛϩⲏⲗⲓⲁⲥ · ⲁⲩⲱ ⲁⲕⲧⲁⲕⲟ ⲛⲛⲉⲓⲇⲱⲗⲟⲛ ⲙⲛⲛⲉⲥⲧⲩⲗⲏ ·",
      "english": "O Saint Victor, thy blood which hath been shed hath overthrown the pillar of Baal, even as did Elijah and thou hast destroyed the idols and the pillars (thereof).",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲉⲓⲙⲁ ⲉⲛ**ϣⲟⲣϣⲣ** ⲙⲡⲧⲩⲣⲁⲛⲛⲟⲥ ⲛⲁⲣⲭⲁⲓⲟⲥ · ⲁⲩⲱ ⲉⲛⲡⲣⲟⲥⲕⲩⲛⲉⲓ ⲙⲡⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲡⲉ ⲉⲃⲟⲗ ϩⲛⲧⲡⲁⲣⲑⲉⲛⲟⲥ ·",
      "english": "In this world we overthrow the ancient tyrant, and we adore the Mystery, which is of the Virgin.",
      "source": "Proclus Homily 23 On the Nativity in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily23.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲕⲁⲗⲱⲥ ⲟⲩⲛ ⲁⲡϫⲟⲉⲓⲥ ⲛⲟⲩϫⲉ ⲙⲡⲉⲓϣⲁϫⲉ ⲉⲣⲱϥ ⲛⲥⲟⲗⲟⲙⲱⲛ ⲉⲧⲣⲉϥϫⲟⲟϥ · ϫⲉϣⲁⲣⲉϩⲉⲛⲥⲁⲃⲏ ⲛⲥϩⲓⲙⲉ ⲕⲉⲧϩⲉⲛⲏⲓ ⲧⲉⲧⲛⲛⲁⲣⲁⲧϩⲏⲧ ⲇⲉ ϣⲁⲥ**ϣⲣϣⲱⲣ**ϥ ⲛⲛⲉⲥϭⲓϫ ·",
      "english": "Rightly therefore did God put the following proverb in the mouth of Solomon and make him say, 'The wise among women build up houses, but the worker of folly destroyeth it with her hands.'",
      "source": "On the End of the World and on Temple of Solomon",
      "urn": "urn:cts:copticLit:psbasil.temple.budge:1-47",
      "dialect": "sahidic"
    }
  ],
