  "examples": [
    {
      "coptic": "ⲉⲧⲁⲩⲙⲟϩ ⲇⲉ ⲉⲃⲟⲗ ⲛϫⲉⲛⲓⲉϩⲟⲟⲩ ϫⲉϩⲓⲛⲁ ⲛⲧⲟⲩϯⲱⲙⲥ ⲛⲁϥ ⲕⲁⲧⲁⲛⲓⲡⲁⲣⲁⲇⲟⲥⲓⲥ ⲛⲧⲉⲛⲓⲭⲣⲓⲥⲧⲓⲁⲛⲟⲥ ⲁⲩϭⲓⲧϥ ⲛϫⲉⲛⲉϥⲓⲟϯ ⲉⲣⲁⲧϥ ⲙⲡⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲛⲧⲉⲡⲓⲥⲏⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ **ⲉ**ⲟⲩⲣⲱⲙⲓ ⲡⲉ ⲙⲡⲛⲉⲩⲙⲁⲧⲟⲫⲟⲣⲟⲥ ⲡⲉ .",
      "english": "When the day came to baptize him according to the traditions of the Christians, his parents took him to the bishop of that time: he was an inspired man.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ϩⲓⲛⲁⲓ ϫⲉϫⲓⲛⲉⲕⲥⲟⲃⲕ ⲕⲥⲟⲟⲩⲛ ⲛϩⲉⲛⲥϩⲁⲓ ⲉⲩⲟⲩⲁⲁⲃ ⲛⲁⲓ ⲉⲧⲛⲁⲉϣϭⲙϭⲟⲙ · **ⲉ**ⲧⲟⲩϫⲟⲕ ·",
      "english": "He said, 'Besides, from the time when thou wast a child thou didst know the Holy Scriptures, which have the power to save thee.'",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡϭⲟⲉⲓⲥ ⲁⲓⲥⲱⲧⲉⲙ ⲉⲡⲉⲕϧⲣⲱⲟⲩ ⲟⲩⲟϩ ⲁⲓⲉⲣϩⲟϯ ⲁⲓϯ ⲛⲓⲁⲧ ⲛⲛⲉⲕϩⲃⲏⲟⲩⲓ ⲟⲩⲟϩ ⲁⲓⲧⲱⲙⲧ ⲉⲩⲉⲉⲙⲓ **ⲉⲣⲟ**ⲕ ϧⲉⲛⲑⲙⲏϯ ⲛⲍⲱⲟⲛ ⲃ ϧⲉⲛⲡϫⲓⲛⲑⲣⲟⲩϧⲱⲛⲧ ⲉϧⲟⲩⲛ ⲛϫⲉⲛⲓⲣⲟⲙⲡⲓ ⲉⲩⲉⲥⲟⲩⲱⲛⲕ ϧⲉⲛⲡϫⲓⲛⲑⲣⲉϥⲓ ⲛϫⲉⲡⲓⲥⲏⲟⲩ ⲉⲕⲉϭⲱⲣⲡ ⲉⲃⲟⲗ ϧⲉⲛⲡϫⲓⲛⲑⲣⲉⲥϣⲑⲟⲣⲧⲉⲣ ⲛϫⲉⲧⲁⲯⲩⲭⲏ ϧⲉⲛⲟⲩⲙⲃⲟⲛ ⲭⲛⲁⲉⲣⲫⲙⲉⲩⲓ ⲙⲫⲛⲁⲓ .",
      "english": "O Lord, I have heard thy report, and was afraid: I considered thy works, and was amazed: thou shalt be known between the two living creatures, thou shalt be acknowledged when the years draw nigh; thou shalt be manifested when the time is come; when my soul is troubled, thou wilt in wrath remember mercy.",
      "source": "Bohairic Habakkuk 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲉ**ⲕⲧⲙϫⲓⲃⲁⲡⲧⲓⲥⲙⲁ ⲅⲁⲣ ⲙⲉⲕϫⲓ ⲡⲉⲥⲛⲟϥ ·",
      "english": "for unless thou thou art baptized, thou receivest not the Blood.",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲓⲁⲕⲱⲃⲟⲥ ⲡϣⲏⲣⲓ ⲛⲍⲉⲃⲉⲇⲉⲟⲥ ⲛⲉⲙⲓⲱⲁⲛⲛⲏⲥ ⲡⲥⲟⲛ ⲛⲓⲁⲕⲱⲃⲟⲥ ⲟⲩⲟϩ ⲁϥϯ ⲛϩⲁⲛⲣⲁⲛ **ⲉⲣⲱ**ⲟⲩ ϫⲉⲃⲟⲁⲛⲏⲣⲅⲉⲥ ⲉⲧⲉⲫⲁⲓ ⲡⲉ ϫⲉⲛⲓϣⲏⲣⲓ ⲛⲧⲉϯϧⲁⲣⲁⲃⲁⲓ .",
      "english": "James the son of Zebedee; John, the brother of James, and he surnamed them Boanerges, which means, Sons of Thunder;",
      "source": "Bohairic Gospel of Mark 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲛⲧⲁϥϫⲡⲉ ⲡⲉⲑⲃⲃⲓⲟ ⲛⲁϥ ⲙⲉⲕϩⲉ **ⲉ**ⲗⲁⲁⲩ ⲛⲗⲟⲓϭⲉ ⲛⲥⲱϥ ϩⲓⲁⲗⲗⲁ ϫⲉⲁϥϣⲱⲡⲉ ⲉϥⲑⲃⲃⲓⲏⲩ ·",
      "english": "but for him that hath produced humility in himself thou wilt find no excuse whatsoever needed, besides that he hath become humble.",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    }
