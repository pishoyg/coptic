  "examples": [
    {
      "coptic": "ϩⲱⲥ ⲟⲩⲛ ⲉⲕⲉⲙⲓ ⲉⲛⲁⲓ . ⲱ **ⲡⲓⲥⲧⲟⲥ** ⲟⲩⲟϩ ⲛⲥⲉⲙⲛⲟⲥ ⲟⲩⲟϩ ⲙⲃⲱⲕ ⲛⲧⲉⲡⲭⲣⲓⲥⲧⲟⲥ ⲗⲁⲩⲥⲓⲉ ϣⲱⲡⲓ ⲉⲕϯⲛⲟⲙϯ ⲛⲁⲕ ⲙⲙⲁⲩⲁⲧⲕ ϧⲉⲛϯⲙⲉⲗⲉⲧⲏ ⲛⲛⲓϫⲱⲙ ⲉⲑⲟⲩⲁⲃ ⲟⲩⲟϩ ⲧⲁⲙⲉⲧⲣⲉϥⲉⲣϩⲟⲩⲟⲥⲁϫⲓ ⲉⲧⲁⲥϣⲱⲡⲓ ϩⲁⲣⲟⲕ ⲉⲑⲃⲉⲡⲁⲣⲉϩ ⲉϯⲅⲛⲱⲙⲏ ⲛⲉⲩⲥⲉⲃⲏⲥ ϣⲟⲡⲥ ⲉⲣⲟⲕ",
      "english": "Therefore, knowing these things, O faithful and venerable servant of Christ, Lausus, strengthen yourself in the meditation of the holy books, and receive my verbosity, which is presented before you, so that you may preserve holy thoughts.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩ**ⲡⲓⲥⲧⲟⲥ** ⲡⲉ ⲡⲛⲟⲩⲧⲉ ⲡⲁⲓ ⲉⲛⲧⲁϥⲧⲉϩⲙⲧⲏⲩⲧⲛ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧϥ ⲉⲧⲕⲟⲓⲛⲱⲛⲓⲁ ⲙⲡⲉϥϣⲏⲣⲉ ⲓⲏⲥⲟⲩⲥ ⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲡⲉⲛϫⲟⲉⲓⲥ .",
      "english": "God is faithful, through whom you were called into the fellowship of his Son, Jesus Christ, our Lord.",
      "source": "1 Corinthians 1",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲑⲃⲉⲫⲁⲓ ⲁⲓⲟⲩⲱⲣⲡ ⲛⲱⲧⲉⲛ ⲛⲧⲓⲙⲟⲑⲉⲟⲥ ⲉⲧⲉⲡⲁϣⲏⲣⲓ ⲙⲙⲉⲛⲣⲓⲧ ⲡⲉ ⲟⲩⲟϩ ⲙ**ⲡⲓⲥⲧⲟⲥ** ϧⲉⲛⲡϭⲟⲓⲥ ⲫⲁⲓ ⲉⲑⲛⲁⲑⲣⲉⲧⲉⲛⲉⲣⲫⲙⲉⲩⲓ ⲛⲛⲁⲙⲱⲓⲧ ϧⲉⲛⲡⲭⲣⲓⲥⲧⲟⲥ ⲓⲏⲥⲟⲩⲥ ⲕⲁⲧⲁⲫⲣⲏϯ ⲉϯϯⲥⲃⲱ ϧⲉⲛⲙⲁⲓ ⲛⲓⲃⲉⲛ ϧⲉⲛⲛⲓⲉⲕⲕⲗⲏⲥⲓⲁ ⲧⲏⲣⲟⲩ .",
      "english": "Because of this I have sent Timothy to you, who is my beloved and faithful child in the Lord, who will remind you of my ways which are in Christ, even as I teach everywhere in every assembly.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲡⲁⲓ ⲁⲓ‎ⲧⲛⲛⲉⲩⲧⲓⲙⲟⲑⲉⲟⲥ ⲛⲏⲧⲛ ⲉⲧⲉⲡⲁⲓ ⲡⲉ ⲡⲁϣⲏⲣⲉ ⲙⲙⲉⲣⲓⲧ ⲁⲩⲱ ⲙ**ⲡⲓⲥⲧⲟⲥ** ϩⲙⲡϫⲟⲉⲓⲥ ⲡⲁⲓ ⲉⲧⲛⲁⲧⲣⲉⲧⲛⲣ‎ⲡⲙⲉⲉⲩⲉ ⲛⲛⲁϩⲓⲟⲟⲩⲉ ⲉⲧϩⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲛⲧϩⲉ ⲉϯϯⲥⲃⲱ ⲙⲙⲟⲥ ϩⲛⲛⲉⲕⲕⲗⲏⲥⲓⲁ ⲧⲏⲣⲟⲩ ϩⲙⲙⲁ ⲛⲓⲙ .",
      "english": "Because of this I have sent Timothy to you, who is my beloved and faithful child in the Lord, who will remind you of my ways which are in Christ, even as I teach everywhere in every assembly.",
      "source": "46_1 Corinthians_4",
