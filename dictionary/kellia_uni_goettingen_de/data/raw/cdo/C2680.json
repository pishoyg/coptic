  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲑⲟϥ ⲉⲧⲁϥⲉⲣⲟⲩⲱ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲱⲡⲓϫⲱⲟⲩ ⲛ**ⲁⲑⲛⲁϩϯ** ϣⲁⲑⲛⲁⲩ ϯⲛⲁϣⲱⲡⲓ ⲛⲉⲙⲱⲧⲉⲛ ϣⲁⲑⲛⲁⲩ ϯⲛⲁⲉⲣⲁⲛⲉⲭⲉⲥⲑⲉ ⲙⲙⲱⲧⲉⲛ ⲁⲛⲓⲧϥ ϩⲁⲣⲟⲓ .",
      "english": "He answered him, 'Unbelieving generation, how long shall I be with you? How long shall I bear with you? Bring him to me.'",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲁϥⲟⲩⲱϣⲃ ⲉϥϫⲱ ⲙⲙⲟⲥ ⲛⲁⲩ . ϫⲉⲱ ⲧⲅⲉⲛⲉⲁ ⲛ**ⲁⲧⲛⲁϩⲧⲉ** ϣⲁⲧⲛⲁⲩ ⲉⲓⲛⲁϣⲱⲡⲉ ⲛⲙⲙⲏⲧⲛ . ϣⲁⲧⲛⲁⲩ ⲉⲓⲛⲁⲁⲛⲉⲭⲉ ⲙⲙⲱⲧⲛ ⲁⲩⲉⲓⲥϥ ⲛⲁⲓ .",
      "english": "He answered him, &apos;Unbelieving generation, how long shall I be with you? How long shall I bear with you? Bring him to me.&apos;",
      "source": "Mark Chapter 9",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲱⲟⲩ ⲇⲉ ⲉⲧⲁⲩⲥⲱⲧⲉⲙ ϫⲉϥⲟⲛϧ ⲟⲩⲟϩ ϫⲉⲁⲛⲛⲁⲩ ⲉⲣⲟϥ ⲛⲁⲩⲟⲓ ⲛ**ⲁⲑⲛⲁϩϯ** ⲡⲉ",
      "english": "When they heard that he was alive, and had been seen by her, they disbelieved.",
      "source": "Bohairic Gospel of Mark 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲥⲉⲥⲱⲧⲙ ⲁⲛ ⲛⲥⲁⲛⲉⲩⲉⲓⲟⲧⲉ · ⲛⲁⲧϩⲏⲧ ⲛ**ⲁⲧⲛⲁϩⲧⲉ** ⲛⲟⲩⲁϩⲓⲏⲧ ⲛⲁⲧⲛⲁϩⲧⲉ · ⲛⲟⲩⲁϩⲓⲏⲧ ⲛⲁⲧⲛⲁ ·",
      "english": "And they hearkened not to the words of their parents; and were fools, and men without belief; and were arrogant, without mercy.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲧⲟⲩⲃⲟ ⲅⲁⲣ ⲛϫⲉⲡⲓϩⲁⲓ ⲛⲁⲑⲛⲁϩϯ ϧⲉⲛϯⲥϩⲓⲙⲓ ⲟⲩⲟϩ ⲁⲥⲧⲟⲩⲃⲟ ⲛϫⲉϯⲥϩⲓⲙⲓ ⲛ**ⲁⲧϩⲛⲁϩϯ** ϧⲉⲛⲡⲓⲥⲟⲛ ⲙⲙⲟⲛ ϩⲁⲣⲁ ⲛⲉⲧⲉⲛϣⲏⲣⲓ ⲥⲉϭⲁϧⲉⲙ ϯⲛⲟⲩ ⲇⲉ ⲥⲉⲟⲩⲁⲃ .",
      "english": "For the unbelieving husband is sanctified in the wife, and the unbelieving wife is sanctified in the husband. Otherwise your children would be unclean, but now they are holy.",
      "source": "Bohairic 1 Corinthians 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲛⲛⲥⲁϩ ⲧⲏⲣⲟⲩ ⲛⲛⲟⲩϫ ⲙⲛⲟⲩⲟⲛ ⲛⲓⲙ ⲉⲧⲟ ⲛ**ⲁⲧⲛⲁϩⲧⲉ** ⲉⲡⲉⲛϫⲟⲉⲓⲥ ⲓⲏⲥⲟⲩⲥ ϫⲓⲛⲛϣⲟⲣⲡ ϣⲁϩⲣⲁⲓ ⲉⲧⲉⲛⲟⲩ ·",
