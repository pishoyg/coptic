  "examples": [
    {
      "coptic": "ⲛⲑⲟ ϩⲱⲓ ϭⲓ ⲛⲧⲉ**ⲃⲁⲥⲁⲛⲟⲥ** ⲑⲁⲓ ⲉⲧⲉⲣⲁϭⲱϧⲉⲙ ⲛⲧⲉⲥⲱⲛⲓ ⲛϧⲏⲧⲥ ϧⲉⲛⲛⲉⲛⲟⲃⲓ ⲉⲧⲁⲣⲉⲁⲓⲧⲟⲩ ⲉϩⲟⲧⲉⲣⲱⲟⲩ ⲟⲩⲟϩ ⲁⲣⲉⲑⲙⲁⲓⲱⲟⲩ ⲉϩⲟⲧⲉⲣⲟ ϯⲛⲟⲩ ⲛⲑⲟ ϩⲱⲓ ϭⲓϣⲓⲡⲓ ⲟⲩⲟϩ ϭⲓ ⲛⲧⲉⲁⲛⲟⲙⲓⲁ ϧⲉⲛⲡϫⲓⲛⲑⲣⲉⲑⲙⲁⲓⲉ ⲧⲉⲥⲱⲛⲓ .",
      "english": "Thou therefore bear thy punishment, for that thou hast corrupted thy sisters by thy sins which thou hast committed beyond them; and thou hast made them appear more righteous than thyself: thou therefore be ashamed, and bear thy dishonour, in that thou hast justified thy sisters.",
      "source": "26_Ezechiel_16",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲕⲛⲁⲙⲟⲩ ϩⲛⲛ**ⲃⲁⲥⲁⲛⲟⲥ** ·",
      "english": "or wilt thou die by torture?'",
      "source": "Martyrdom of Victor part 5",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:33-48",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲡϣⲏⲣⲓ ⲙⲫⲣⲱⲙⲓ ⲁⲟⲩⲱⲙ ⲙⲡⲉⲕⲱⲓⲕ ϧⲉⲛⲟⲩⲙⲕⲁϩⲛϩⲏⲧ ⲟⲩⲟϩ ⲥⲱ ⲡⲉⲕⲙⲱⲟⲩ ϧⲉⲛⲟⲩ**ⲃⲁⲥⲁⲛⲟⲥ** ⲛⲉⲙⲟⲩϩⲟϫϩⲉϫ .",
      "english": "And thou shalt say to the people of the land, Thus saith the Lord to the inhabitants of Jerusalem, on the land of Israel; They shall eat their bread in scarcity, and shall drink their water in desolation, that the land may be desolate with all that it contains: for all that dwell in it are ungodly.",
      "source": "26_Ezechiel_12",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲉⲛⲟⲩ ϭⲉ ⲛⲥⲙⲉⲗⲉⲓ ⲛⲁⲓ ⲁⲛ ϩⲁⲛⲉⲕ**ⲃⲁⲥⲁⲛⲟⲥ** ·",
      "english": "Now, therefore, I care nothing for thy tortures.'",
      "source": "Martyrdom of Victor part 7",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:67-85",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲩⲉϩⲓⲟⲩⲓ ⲙⲡⲟⲩϩⲁⲧ ϧⲉⲛⲛⲓⲡⲗⲁⲧⲓⲁ ⲟⲩⲟϩ ⲡⲟⲩⲛⲟⲩⲃ ⲛⲥⲉⲥⲟⲙⲥ ⲉⲣⲟϥ ⲁⲛ ⲟⲩⲟϩ ⲛⲟⲩⲯⲩⲭⲏ ⲛⲁⲥⲓ ⲁⲛ ⲟⲩⲟϩ ϧⲏⲧⲟⲩ ⲛⲁⲙⲟϩ ⲁⲛ ϫⲉϯ**ⲃⲁⲥⲁⲛⲟⲥ** ⲛⲛⲟⲩϭⲓⲛϫⲟⲛⲥ ⲛⲁϣⲱⲡⲓ ⲛⲱⲟⲩ .",
      "english": "Their silver shall be cast forth in the streets, and their gold shall be despised: their souls shall not be satisfied, and their bellies shall not be filled: for it was the punishment of their iniquities.",
      "source": "26_Ezechiel_07",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:07",
      "dialect": "bohairic"
    },
