  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲁⲥⲁϫⲓ ⲛⲉⲙ ⲡⲁϩⲓⲱⲓϣ ⲛⲁϥϧⲉⲛϩⲁⲛⲑⲱⲧ ⲛϩⲏⲧ ⲁⲛ ⲛⲧⲉϩⲁⲛⲥⲁϫⲓ ⲛⲥⲟⲫⲓⲁ ⲛ**ⲣⲱⲙⲓ** ⲁⲗⲗⲁ ϧⲉⲛⲟⲩⲱⲛϩ ⲉⲃⲟⲗ ⲛⲧⲉⲟⲩⲡⲛⲉⲩⲙⲁ ⲛⲉⲙⲟⲩϫⲟⲙ .",
      "english": "My speech and my preaching were not in persuasive words of human wisdom, but in demonstration of the Spirit and of power,",
      "source": "Bohairic 1 Corinthians 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲁⲛⲅⲟⲩ**ⲣⲱⲙⲉ** ⲛⲣⲉϥⲣⲛⲟⲃⲉ · ⲁⲩⲱ ⲛⲃⲣⲣⲉ ·",
      "english": "Rather, I am a sinful and young human.'",
      "source": "Apophthegmata Patrum Sahidic 070",
      "urn": "urn:cts:copticLit:ap.70.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲃⲟⲗ ⲅⲁⲣ ϩⲓⲧⲉⲛⲡⲁⲓϩⲱⲃ ⲉⲕⲉϫⲫⲟ ⲛⲁⲕ ⲛⲛⲓⲁⲣⲉⲧⲏ ⲧⲏⲣⲟⲩ ⲟⲩⲟϩ ⲉⲕⲉⲁⲣⲉϩ ⲉⲣⲟⲕ ⲉⲃⲟⲗ ϩⲁϯⲙⲉⲧⲣⲁⲛⲁϥ ⲛ**ⲣⲱⲙⲓ** ⲉⲧⲧⲁⲕⲏⲟⲩⲧ",
      "english": "For in this way, you will acquire all virtues and guard yourself from corruptible human vanity.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲡ**ⲣⲱⲙⲉ** ϣⲱⲡⲉ ⲉⲩⲯⲩⲭⲏ ⲉⲥⲟⲛϩ ·",
      "english": "The human being became as a living soul,",
      "source": "Abraham Our Father: YA 535-40",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbya:21-27",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲁⲡⲁ ⲉⲩⲁⲅⲣⲓ ⲛⲁϥ ϫⲉⲉⲛⲉⲙⲡⲉϥϭⲓⲕⲁϯ ⲛⲣⲱⲙⲓ ⲡⲉ ⲛⲁϥⲛⲁϭⲓⲥⲁⲣⲝ ⲛⲣⲱⲙⲓ ⲁⲛ ⲟⲛ ⲡⲉ ⲓⲉ ϫⲉⲟⲩⲛ ⲁϥϭⲓⲥⲁⲣⲝ ⲛ**ⲣⲱⲙⲓ** ⲉⲃⲟⲗ ϧⲉⲛⲙⲁⲣⲓⲁ ϯⲡⲁⲣⲑⲉⲛⲟⲥ ⲉⲑⲟⲩⲁⲃ ⲓⲉ ⲁϥⲉⲣⲣⲱⲙⲓ ⲟⲛ ⲛⲉⲙⲯⲩⲭⲏ ⲛⲉⲙⲟⲩⲕⲁϯ ⲉϥϫⲏⲕ ⲉⲃⲟⲗ ϧⲉⲛϩⲱⲃ ⲛⲓⲃⲉⲛ ⲛⲧⲉϯⲙⲉⲧⲣⲱⲙⲓ ϣⲁⲧⲉⲛⲫⲛⲟⲃⲓ ⲙⲙⲁⲩⲁⲧϥ ⲙⲙⲟⲛ ϣϫⲟⲙ ⲅⲁⲣ ⲛⲧⲉⲡⲥⲱⲙⲁ ϣⲱⲡⲓ ....... ⲉⲯⲩⲭⲏ ⲛⲉⲙⲕⲁϯ ⲓⲥϫⲉ ⲇⲉ ⲙⲡⲉϥϭⲓ ⲛⲛⲁⲓ ⲓⲉ ⲉⲩⲙⲟⲩϯ ⲉⲣⲟϥ ⲉⲫⲗⲏⲟⲩ ϫⲉⲛⲭⲣⲓⲥⲧⲟⲥ ⲡⲗⲟⲅⲟⲥ ⲟⲩⲛ ⲛⲁⲧϣⲓⲃϯ ⲡⲓⲙⲟⲛⲟⲅⲉⲛⲏⲥ ⲛϣⲏⲣⲓ ⲛⲧⲉⲫⲓⲱⲧ ⲁϥϭⲓⲥⲱⲙⲁ ⲛⲣⲱⲙⲓ ⲛⲉⲙⲯⲩⲭⲏ ⲛⲉⲙⲕⲁϯ ⲛⲉⲙϩⲱⲃ ⲛⲓⲃⲉⲛ ⲛⲧⲉϯⲙⲉⲧⲣⲱⲙⲓ ⲭⲱⲣⲓⲥ ⲫⲛⲟⲃⲓ .",
      "english": "Apa Evagrius said: ‘If He had not accepted the human spirit, He would not have taken on human flesh; for the Blessed Virgin Mary did not bear one without a human soul. In every human work, free from sin, this was fitting. For it is not possible that there be a body [….] soul and spirit. For unless He had received these, Christ would be called in vain. Therefore, the immutable Word, the Only-Begotten Son of the Father, assumed a human body, as well as a soul, spirit, and all things human, without sin.",
      "source": "Bohairic Lausiac History - Part 3",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:38",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ϭⲉ ⲛⲛⲁϯⲥⲟ ⲉⲧⲛⲓⲛⲉⲩⲏ ⲧⲛⲟϭ ⲙⲡⲟⲗⲓⲥ ⲉⲩⲛϩⲏⲧⲥ ⲛϭⲓⲁϩⲟⲩⲟ ⲉⲙⲛⲧⲥⲛⲟⲟⲩⲥ ⲛⲧⲃⲁ ⲛ**ⲣⲱⲙⲉ** : ⲛⲁⲓ ⲉⲧⲉⲙⲡⲟⲩⲥⲟⲩⲛⲧⲉⲩⲟⲩⲛⲁⲙ : ⲙⲛⲧⲉⲩϩⲃⲟⲩⲣ ⲙⲛϩⲉⲛⲧⲃⲛⲟⲟⲩⲉ ⲉⲛⲁϣⲱⲟⲩ :",
      "english": "and shall not I spare Nineve, the great city, in which dwell more than twelve myriads of human beings, who do not know their right hand or their left hand; and also much cattle?",
      "source": "Jonah Chapter 4 (Sahidic)",
      "urn": "urn:cts:copticLit:ot.jonah.coptot_ed:4",
      "dialect": "sahidic"
    }
