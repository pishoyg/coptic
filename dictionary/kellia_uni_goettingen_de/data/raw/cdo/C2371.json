  "examples": [
    {
      "coptic": "ϫⲉⲥⲉ**ⲛⲁ** ⲉϧⲟⲩⲛ ⲉⲡⲉϥϩⲏⲧ ⲁⲛ ⲁⲗⲗⲁ ⲧⲉϥⲛⲉϫⲓ ⲟⲩⲟϩ ϣⲁⲩϣⲉ ⲛⲱⲟⲩ ⲉⲛⲓⲙⲁ ⲛϩⲉⲙⲥⲓ ⲉϥⲧⲟⲩⲃⲟ ⲛⲛⲓϧⲣⲏⲟⲩⲓ ⲧⲏⲣⲟⲩ .",
      "english": "because it doesn't go into his heart, but into his stomach, then into the latrine, thus making all foods clean?'",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲧⲉⲩⲛⲧϥ ⲛⲁⲉⲛⲧⲟⲗⲏ ⲁⲩⲱ ⲉⲧϩⲁⲣⲉϩ ⲉⲣⲟⲟⲩ ⲡⲉⲧⲙⲙⲁⲩ ⲡⲉⲧⲙⲉ ⲙⲙⲟⲓ . ⲡⲉⲧⲙⲉ ⲇⲉ ⲙⲙⲟⲓ ⲡⲁⲉⲓⲱⲧ ⲛⲁⲙⲉⲣⲓⲧϥ . ⲁⲩⲱ ⲁⲛⲟⲕ ϩⲱ ϯⲛⲁⲙⲉⲣⲓⲧϥ ⲁⲩⲱ ϯ**ⲛⲁ**ⲟⲩⲟⲛϩⲧ ⲛⲁϥ ⲉⲃⲟⲗ .",
      "english": "One who has my commandments, and keeps them, that person is one who loves me. One who loves me will be loved by my Father, and I will love him, and will reveal myself to him.'",
      "source": "43_John_14",
      "urn": "urn:cts:copticLit:nt.john.sahidica:14",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲓⲑⲏⲣⲓⲟⲛ ⲉⲧⲁⲕⲛⲁⲩ ⲉⲣⲟϥ ⲉϥϣⲟⲡ ⲟⲩⲟϩ ϥϣⲟⲡ ⲁⲛ ⲉϥⲛⲏⲟⲩ ⲉϩⲣⲏⲓ ⲉⲃⲟⲗ ϧⲉⲛⲫⲛⲟⲩⲛ ⲟⲩⲟϩ ⲉϥ**ⲛⲁ** ⲉⲡⲧⲁⲕⲟ ⲟⲩⲟϩ ⲉⲩⲉⲉⲣϣⲫⲏ ⲣⲓ ⲧⲏⲣⲟⲩ ⲛϫⲉⲛⲏ ⲉⲧϣⲟⲡ ϩⲓϫⲉⲛⲡⲕⲁϩⲓ ⲛⲏ ⲉⲧⲉⲡⲟⲩⲣⲁⲛ ⲥϧⲏⲟⲩⲧ ⲁⲛ ϩⲓⲡϫⲱⲙ ⲛⲧⲉⲡⲱⲛϧ ⲓⲥϫⲉⲛ ⲡϣⲁ ⲛⲥⲱⲛⲧ ⲙⲡⲓⲕⲟⲥⲙⲟⲥ ⲉⲩϫⲟⲩϣⲧ ⲉⲡⲓⲑⲏⲣⲓⲟⲛⲏ ϫⲉϥϣⲟⲡ ⲟⲩⲟϩ ϥϣⲟⲡ ⲁⲛ ⲟⲩⲟϩ ⲁϥϩⲉⲓ",
      "english": "The beast that you saw was, and is not; and is about to come up out of the abyss and to go into destruction. Those who dwell on the earth and whose names have not been written in the book of life from the foundation of the world will marvel when they see that the beast was, and is not, and shall be present.",
      "source": "27_Revelation_17",
      "urn": "urn:cts:copticLit:nt.rev.bohairic:17",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲁⲙⲏⲛ ϩⲁⲙⲏⲛ ϯϫⲱ ⲙⲙⲟⲥ ⲛⲏⲧⲛ ϫⲉⲡⲉⲧⲡⲓⲥⲧⲉⲩⲉ ⲉⲣⲟⲓ ⲛⲉϩⲃⲏⲩⲉ ⲉϯⲉⲓⲣⲉ ⲙⲙⲟⲟⲩ . ⲡⲏ ϩⲱⲱϥ ⲟⲛ **ⲛⲁ**ⲁⲁⲩ . ⲁⲩⲱ ϥⲛⲁⲣ ⲛⲉⲧⲛⲁⲁⲁⲩ ⲉⲣⲟⲟⲩ ϫⲉⲁⲛⲟⲕ ⲉⲉⲓⲛⲁⲃⲱⲕ ϣⲁⲡⲁⲉⲓⲱⲧ",
      "english": "Most certainly I tell you, he who believes in me, the works that I do, he will do also; and he will do greater works than these, because I am going to my Father.",
      "source": "43_John_14",
      "urn": "urn:cts:copticLit:nt.john.sahidica:14",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲁⲓ ⲉⲧⲁϥⲛⲁⲩ ⲉⲡⲉⲧⲣⲟⲥ ⲛⲉⲙⲓⲱⲁⲛⲛⲏⲥ ⲉⲩ**ⲛⲁ** ⲉϧⲟⲩⲛ ⲉⲡⲓⲉⲣⲫⲉⲓ ⲛⲁϥⲧⲱⲃϩ ⲙⲙⲱⲟⲩ ⲉϥⲟⲩⲱϣ ⲉϭⲓ ⲛⲟⲩⲙⲉⲑⲛⲁⲏⲧ ⲛⲧⲟⲧⲟⲩ .",
      "english": "Seeing Peter and John about to go into the temple, he asked to receive gifts for the needy.",
      "source": "05_Acts_03",
      "urn": "urn:cts:copticLit:nt.acts.bohairic:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϯⲕⲉⲕⲟⲩⲓ ⲡⲉ ⲁⲩⲱ ⲙⲡⲕⲟⲥⲙⲟⲥ ϭⲉ **ⲛⲁ**ⲛⲁⲩ ⲉⲣⲟⲓ ⲁⲛ . ⲛⲧⲱⲧⲛ ⲇⲉ ⲧⲉⲧⲛⲁⲛⲁⲩ ⲉⲣⲟⲓ ϫⲉⲁⲛⲟⲕ ϯⲟⲛϩ ⲁⲩⲱ ⲛⲧⲱⲧⲛ ϩⲱⲧⲧⲏⲩⲧⲛ ⲧⲉⲧⲛⲁⲱⲛϩ .",
