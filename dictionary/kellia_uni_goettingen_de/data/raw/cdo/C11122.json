  "examples": [
    {
      "coptic": "ⲁⲛⲟⲛ ⲅⲁⲣ ⲁⲛⲟⲛ ϩⲁⲛ**ⲓⲇⲓⲱⲧⲏⲥ** ⲛⲣⲱⲙⲓ ⲙⲡⲉⲛϭⲓⲥⲃⲱ ⲛⲧⲉⲡⲁⲓⲕⲟⲥⲙⲟⲥ ⲟⲩⲇⲉ ⲛⲛⲉⲥϣⲱⲡⲓ ⲙⲙⲟⲛ",
      "english": "For we are simple people and have not received the wisdom of this world (and so much the better for us).",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣⲱⲡⲉ ⲇⲉ ⲉⲩϣⲁⲛⲡⲣⲟⲫⲏⲧⲉⲩⲉ ⲧⲏⲣⲟⲩ ⲛⲧⲉ ⲟⲩⲁⲡⲓⲥⲧⲟⲥ ⲇⲉ ⲉⲓ ⲉϩⲟⲩⲛ ⲏ ⲟⲩ**ϩⲓⲇⲓⲱⲧⲏⲥ** ⲥⲉⲛⲁϫⲡⲓⲟϥ ϩⲓⲧⲛⲟⲩⲟⲛ ⲛⲓⲙ ⲥⲉⲛⲁⲁⲛⲁⲕⲣⲓⲛⲉ ⲙⲙⲟϥ ϩⲓⲧⲛⲟⲩⲟⲛ ⲛⲓⲙ .",
      "english": "But if all prophesy, and someone unbelieving or unlearned comes in, he is reproved by all, and he is judged by all.",
      "source": "1 Corinthians 14",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:14",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲉ ⲙⲙⲟⲛ ⲁⲕϣⲁⲛⲥⲙⲟⲩ ϧⲉⲛⲡⲓⲡⲛⲉⲩⲙⲁ ⲡⲉⲧϫⲱⲕ ⲙⲫⲙⲁ ⲙⲡⲓ**ⲓⲇⲓⲱⲧⲏⲥ** ⲉⲃⲟⲗ ⲡⲱⲥ ϥⲛⲁϫⲉⲡⲓⲁⲙⲏⲛ ⲉϩⲣⲏⲓ ⲉϫⲉⲛⲡⲉⲕϣⲉⲡϩⲙⲟⲧ ⲉⲡⲓⲇⲏ ⲡⲉⲧⲉⲕϫⲱ ⲙⲙⲟϥ ϥⲉⲙⲓ ⲉⲣⲟϥ ⲁⲛ .",
      "english": "Otherwise if you bless with the spirit, how will he who fills the place of the unlearned say the 'Amen' at your giving of thanks, seeing he doesn't know what you say?",
      "source": "Bohairic 1 Corinthians 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡⲉϫⲁϥ ϫⲉⲕⲱ ⲛⲁⲓ ⲉⲃⲟⲗ ⲁⲛⲅⲟⲩⲣⲱⲙⲉ ⲛ**ϩⲓⲇⲓⲱⲧⲏⲥ** · ⲁⲗⲗⲁ ⲁⲓⲃⲱⲕ ϣⲁⲁⲡⲁ ϩⲱⲣ · ⲙⲛⲁⲡⲁ ϩⲁⲧⲣⲏ ·",
      "english": "And he said: 'Forgive me. I am an unlearned man, but I went to Apa Or and Apa Hatre.'",
      "source": "Apophthegmata Patrum Sahidic 115: Pistus 1",
      "urn": "urn:cts:copticLit:ap.115.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁⲩⲛⲁⲩ ⲇⲉ ⲉⲧⲡⲁⲣⲣⲏⲥⲓⲁ ⲙⲡⲉⲧⲣⲟⲥ ⲛⲉⲙⲓⲱⲁⲛⲛⲏⲥ ⲟⲩⲟϩ ⲉⲧⲁⲩⲉⲙⲓ ϫⲉϩⲁⲛⲣⲱⲙⲓ ⲛⲉⲛⲥⲉⲥⲱⲟⲩⲛ ⲛⲥϧⲁⲓ ⲁⲛ ⲟⲩⲟϩ ϩⲁⲛ**ⲓⲇⲓⲱⲧⲏⲥ** ⲛⲉⲛⲁⲩⲉⲣϣⲫⲏⲣⲓ ⲡⲉ ⲛⲁⲩⲥⲱⲟⲩⲛ ⲇⲉ ⲙⲙⲱⲟⲩ ϫⲉⲛⲁⲩⲭⲏ ⲛⲉⲛⲓⲏⲥⲟⲩⲥ ⲡⲉ .",
      "english": "Now when they saw the boldness of Peter and John, and had perceived that they were unlearned and ignorant men, they marveled. They recognized that they had been with Jesus.",
      "source": "05_Acts_04",
      "urn": "urn:cts:copticLit:nt.acts.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲛⲛⲥⲁⲛⲁⲓ ⲇⲉ ⲁϥⲧⲁⲣⲕⲉⲡⲙⲁⲕⲁⲣⲓⲟⲥ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲙⲁⲧⲁⲙⲟⲓ ϫⲉⲟⲩ ⲡⲉ ⲡⲉⲕⲃⲓⲟⲥ ⲁⲩⲱ ⲛⲧⲕⲟⲩⲣⲙⲧⲱⲛ ϩⲙⲡⲉⲕⲅⲉⲛⲟⲥ ϯⲛⲁⲩ ⲅⲁⲣ ⲉⲡⲉⲕⲥⲙⲟⲧ ⲛⲧϩⲉ ⲛⲛⲓ**ϩⲓⲇⲓⲱⲧⲏⲥ**",
      "english": "Afterwards, he beseeched the blessed one: tell me, what has been your life and where are you from, of which people. For I see your appearance (which is) like that of a crazy person,",
      "source": "Life of Apa Aphou part 2",
      "urn": "urn:cts:copticLit:lives.aphou.paths_ed:62-132",
      "dialect": "sahidic"
    }
