  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁϥϫⲱ ⲙⲙⲟⲥ ⲛⲱⲟⲩ ⲟⲛ ϫⲉⲁⲛⲁⲩ ϫⲉⲟⲩ ⲡⲉⲧⲉⲧⲉⲛⲥⲱⲧⲉⲙ ⲉⲣⲟϥ ϧⲉⲛⲡⲓϣⲓ ⲉⲧⲉⲧⲉⲛⲛⲁ**ϣⲓ** ⲙⲙⲟϥ ⲉⲩⲛⲁϣⲓ ⲛⲱⲧⲉⲛ ⲙⲙⲟϥ ⲟⲩⲟϩ ⲛⲧⲟⲩⲧⲟⲩϩⲟ ⲛⲱⲧⲉⲛ .",
      "english": "He said to them, 'Take heed what you hear. With whatever measure you measure, it will be measured to you, and more will be given to you who hear.",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉϯϩⲧⲏⲧⲛ ϫⲉⲟⲩ ⲡⲉⲧⲧⲉⲧⲛⲥⲱⲧⲙ ⲉⲣⲟϥ . ϩⲙⲡϣⲓ ⲉⲧⲉⲧⲛⲁ**ϣⲓ** ⲙⲙⲟϥ ⲥⲉⲛⲁϣⲓ ⲛⲏⲧⲛ ⲛϩⲏⲧϥ .",
      "english": "He said to them, 'Take heed what you hear. With whatever measure you measure, it will be measured to you, and more will be given to you who hear.",
      "source": "41_Mark_4",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲑⲱⲧⲉⲛ ϩⲱⲧⲉⲛ ϫⲉⲕ **ϣⲓ** ⲛⲧⲉⲛⲉⲧⲉⲛⲓⲟϯ ⲉⲃⲟⲗ .",
      "english": "Fill up, then, the measure of your fathers.",
      "source": "01_Matthew_23",
      "urn": "urn:cts:copticLit:nt.matt.bohairic:23",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲇⲉ ⲛⲁⲩ ϫⲉⲙⲏ ⲉⲣⲉⲡϩⲏⲃⲥ ⲛⲁⲉⲓ ϫⲉⲉⲩⲉⲕⲁⲁϥ ϩⲁⲟⲩ**ϣⲓ** . ⲏ ϩⲁⲟⲩϭⲗⲟϭ ⲙⲏ ⲛⲉⲩⲛⲁⲕⲁⲁϥ ⲁⲛ ϩⲓϫⲛⲧⲗⲩⲭⲛⲓⲁ .",
      "english": "He said to them, 'Is the lamp brought to be put under a basket or under a bed? Isn't it put on a stand?",
      "source": "41_Mark_4",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲉ ⲉⲩ**ϣⲏⲟⲩ** ⲉϩⲟⲧⲉ ϯϣⲓⲏ ⲛⲧⲉⲡⲕⲁϩⲓ ⲓⲉ ⲉϩⲟⲧⲉ ⲡⲓⲟⲩⲟⲥⲑⲉⲛ ⲛⲧⲉⲫⲓⲟⲙ .",
      "english": "Or longer than the measure of the earth, or the breadth of the sea.",
      "source": "18_Iob_11",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:11",
      "dialect": "bohairic"
    },
    {
