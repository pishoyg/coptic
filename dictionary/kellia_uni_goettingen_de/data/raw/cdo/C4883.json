  "examples": [
    {
      "coptic": "ϫⲉⲛⲁⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲟⲩⲟⲛ **ⲟⲩ**ⲡⲛⲉⲩⲙⲁ ⲛⲁⲕⲁⲑⲁⲣⲧⲟⲛ ⲛⲉⲙⲁϥ .",
      "english": "--because they said, 'He has an unclean spirit.'",
      "source": "Bohairic Gospel of Mark 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥϫⲉⲩ**ⲟⲩ**ⲣⲱⲙⲉ ϩⲁⲧⲉⲩϩⲏ ⲁⲩϯ ⲛⲓⲱⲥⲏⲫ ⲉⲃⲟⲗ ⲉⲩϩⲙϩⲁⲗ",
      "english": "He sent a man before them; Joseph was sold for a slave.",
      "source": "Psalms 104",
      "urn": "urn:cts:copticLit:ot.pss.coptot:104",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯⲛⲟⲩ ⲇⲉ **ⲟⲩ**ⲙⲏϣ ⲙⲉⲛ ⲛⲉ ⲛⲓⲙⲉⲗⲟⲥ ⲟⲩⲁⲓ ⲇⲉ ⲡⲉ ⲡⲓⲥⲱⲙⲁ .",
      "english": "But now they are many members, but one body.",
      "source": "Bohairic 1 Corinthians 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓϣⲁⲛⲕⲁⲁⲩ ⲉⲃⲟⲗ ⲉⲙⲡⲟⲩⲟⲩⲱⲙ ⲥⲉⲛⲁⲥⲱϣⲙ ϩⲛⲧⲉϩⲓⲏ ⲉⲩⲛϩⲟⲓⲛⲉ ⲛϩⲏⲧ**ⲟⲩ** ϣⲟⲟⲡ ϩⲙⲡⲟⲩⲉ .",
      "english": "If I send them away fasting to their home, they will faint on the way, for some of them have come a long way.&apos;",
      "source": "Mark Chapter 8",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:8",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲉⲣⲟⲩⲱ ⲛϫⲉⲓⲏⲥⲟⲩⲥ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲭⲁ**ⲟⲩ**ⲛⲁϩϯ ⲛⲧⲉⲫⲛⲟⲩϯ ⲛⲧⲉⲛⲑⲏⲛⲟⲩ .",
      "english": "Jesus answered them, 'Have faith in God.",
      "source": "Bohairic Gospel of Mark 11 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:11",
      "dialect": "bohairic"
    },
    {
