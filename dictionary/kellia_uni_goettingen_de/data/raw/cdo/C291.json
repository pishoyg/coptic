  "examples": [
    {
      "coptic": "ⲓⲏⲥⲟⲩⲥ ⲇⲉ ⲉⲧⲁϥϫⲟⲩϣⲧ ⲉⲣⲟϥ ⲁϥⲙⲉⲛⲣⲓⲧϥ ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲕⲉⲟⲩⲁⲓ ⲡⲉⲧⲉⲕⲉⲣϧⲁⲉ ⲙⲙⲟϥ ⲙⲁϣⲉ ⲛⲁⲕ ⲙⲁ ⲡⲉⲧⲉⲛⲧⲁⲕ ⲉⲃⲟⲗ ⲙⲏⲓⲧⲟⲩ ⲛⲛⲓϩⲏⲕⲓ ⲟⲩⲟϩ ⲉⲕⲉϫⲫⲟ ⲛⲁⲕ ⲛⲟⲩ**ⲁϩⲟ** ϧⲉⲛⲧⲫⲉ ⲟⲩⲟϩ ⲁⲙⲟⲩ ⲟⲩⲁϩⲕ ⲛⲥⲱⲓ .",
      "english": "Jesus looking at him loved him, and said to him, 'One thing you lack. Go, sell whatever you have, and give to the poor, and you will have treasure in heaven; and come, follow me, taking up the cross.'",
      "source": "Bohairic Gospel of Mark 10 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:10",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲩϣⲁⲛⲡⲱⲛⲅ ⲛⲁⲓ ⲁϫⲛϯⲥⲟ ϫⲉϯⲟ ϩⲱⲱⲧ ⲛϩⲙϩⲁⲗ ⲛⲁⲩ ⲕⲁⲗⲱⲥ ϫⲉⲛⲁⲥⲛⲏⲩ ⲛⲉ ⲉⲓⲥⲱⲟⲩϩⲛⲁⲩ ⲉϩⲟⲩⲛ ⲉϩⲉⲛ**ⲁϩⲟ** ϩⲛⲧⲡⲉ ⲛⲛⲉⲧⲟⲩϯ ⲙⲙⲟⲟⲩ ⲛⲧⲁⲉⲓⲟ ⲙⲡⲛⲟⲩⲧⲉ .",
      "english": "if they transfer over to me without restraint—for I too am a good servant to them, for they are my brothers, gathering for them into treasures in heaven, the things that they give in honour of God—",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲟⲩⲟⲛⲧⲁⲛ ⲙⲙⲁⲩ ⲙⲡⲁⲓ**ⲁϩⲟ** ϧⲉⲛϩⲁⲛⲥⲕⲉⲩⲟⲥ ⲙⲃⲉⲗϫ ϩⲓⲛⲁ ϯⲙⲉⲧⲛⲓϣϯ ⲛⲧⲉⲛⲓϫⲟⲙ ⲛⲧⲉⲥϣⲱⲡⲓ ⲉⲧⲁ ⲫⲛⲟⲩϯ ⲧⲉ ⲟⲩⲟϩ ⲉⲛⲟⲩ ⲉⲃⲟⲗ ⲙⲙⲱⲧⲉⲛ ⲁⲛ ⲧⲉ .",
      "english": "But we have this treasure in clay vessels, that the exceeding greatness of the power may be of God, and not from ourselves.",
      "source": "08_II Corinthians_04",
      "urn": "urn:cts:copticLit:nt.2cor.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲛϯⲉⲟⲟⲩ ⲛⲁⲕ ⲡⲉϭⲣⲟⲟϭ · ⲡⲗⲟⲅⲟⲥ · ⲡⲉϩⲙⲟⲩ · ⲡⲱⲛⲉ ⲙⲙⲉ · ⲡ**ⲁϩⲟ** ⲉⲧⲟⲩⲁⲁⲃ · ⲡϩⲃⲃⲉ · ⲧⲁⲃⲱ · ⲧⲙⲛⲧⲛⲟϭ · ⲡⲉⲛⲧⲁⲩϫⲟⲟⲥ ⲉⲣⲟϥ · ϫⲉϣⲏⲣⲉ ⲛⲣⲱⲙⲉ ⲉⲧⲃⲏⲏⲧⲛ · ϫⲉⲕⲁⲥ ⲉϥⲉⲧⲟⲩϫⲟ ⲙⲡⲅⲉⲛⲟⲥ ⲛⲛⲣⲱⲙⲉ ·",
      "english": "We ascribe glory unto Thee, the Seed, the Word, the Salt, the True Gem, the Holy Storehouse, the Plough, the Net, the Majesty, Who was sent for the sake of us, the children of men, that He might deliver the race of man.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲩⲉⲧⲏⲓⲧⲟⲩ ϧⲉⲛⲟⲩⲛⲟⲙⲟⲥ ⲡⲉⲛⲟⲩϫⲁⲓ ⲇⲉ ⲁϥⲭⲏ ϧⲉⲛϩⲁⲛⲁϩⲱⲣ ⲁⲥ ⲙⲙⲁⲩ ⲛϫⲉϯⲉⲡⲓⲥⲧⲏⲙⲏ ⲛⲉⲙϯⲥⲟⲫⲓⲁ ⲛⲉⲙϯⲙⲉⲧⲉⲩⲥⲉⲃⲏⲥ ϩⲁⲡϭⲥ ⲛⲁⲓ ⲛⲉ ⲛⲓ**ⲁϩⲱⲣ** ⲛⲧⲉϯⲇⲓⲕⲉⲟⲥⲩⲛⲏ .",
      "english": "They shall be delivered up to the law: our salvation is our treasure: there are wisdom and knowledge and piety toward the Lord; these are the treasures of righteousness.",
      "source": "23_Isaias_33",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:33",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥϫⲟⲟⲥ ⲛϭⲓⲁⲡⲁ ϩⲩⲡⲉⲣⲉⲭⲓⲟⲥ ϫⲉⲡ**ⲁϩⲟ** ⲙⲡⲙⲟⲛⲁⲭⲟⲥ ⲡⲉ ⲧⲙϫⲡⲉⲗⲁⲁⲩ ⲛϩⲩⲗⲏ ⲛⲁϥ .",
