  "examples": [
    {
      "coptic": "ⲉⲡⲓⲇⲏ ⲛⲓ**ⲓⲟⲩⲇⲁⲓ** ⲥⲉⲉⲣⲉⲧⲓⲛ ⲛϩⲁⲛⲙⲏⲓⲛⲓ ⲟⲩⲟϩ ⲛⲓⲟⲩⲉⲓⲛⲓⲛ ⲥⲉⲕⲱϯ ⲛⲥⲁϯⲥⲟⲫⲓⲁ .",
      "english": "For Jews ask for signs, Greeks seek after wisdom,",
      "source": "Bohairic 1 Corinthians 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲡⲉⲓⲇⲏ ⲛ**ⲓⲟⲩⲇⲁⲓ** ϩⲉⲛⲙⲁⲉⲓⲛ ⲛⲉⲧⲟⲩⲁⲓⲧⲉⲓ ⲙⲙⲟⲟⲩ . ⲛϩⲉⲗⲗⲏⲛ ⲇⲉ ⲉⲩϣⲓⲛⲉ ⲛⲥⲁⲟⲩⲥⲟⲫⲓⲁ .",
      "english": "For Jews ask for signs, Greeks seek after wisdom,",
      "source": "1 Corinthians 1",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲓⲗⲁⲧⲟⲥ ⲇⲉ ⲉⲧⲁϥⲉⲣⲟⲩⲱ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲟⲩ ⲟⲩⲛ ⲡⲉϯⲛⲁⲁⲓϥ ⲙⲫⲏ ⲉⲧⲉⲧⲉⲛϫⲱ ⲙⲙⲟⲥ ⲉⲣⲟϥ ϫⲉⲡⲟⲩⲣⲟ ⲛⲧⲉⲛⲓ**ⲓⲟⲩⲇⲁⲓ**",
      "english": "Pilate again asked them, 'What then should I do to him whom you call the King of the Jews?'",
      "source": "Bohairic Gospel of Mark 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲛ ⲇⲉ ⲉⲛⲧⲁϣⲉⲟⲉⲓϣ ⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲉⲁⲩⲥⲧⲁⲩⲣⲟⲩ ⲙⲙⲟϥ . ⲛ**ⲓⲟⲩⲇⲁⲓ** ⲙⲉⲛ ⲟⲩⲥⲕⲁⲛⲇⲁⲗⲟⲛ ⲛⲁⲩ ⲡⲉ . ⲟⲩⲙⲛⲧⲥⲟϭ ⲇⲉ ⲡⲉ ⲛⲛϩⲉⲑⲛⲟⲥ .",
      "english": "but we preach Christ crucified; a stumbling block to Jews, and foolishness to Greeks,",
      "source": "46_1 Corinthians_1",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲥⲉⲏⲣⲡ ϩⲱⲟⲩ ⲛⲉⲙⲡⲉⲛϭⲟⲉⲓⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲭⲣⲓⲥⲧⲟⲥ ⲛϫⲉⲛⲁⲛⲏⲓ ⲙⲡⲉⲧⲣⲟⲥ ⲡⲓⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲛⲉⲙⲛⲉϥⲙⲁⲑⲏⲧⲏⲥ ⲧⲏⲣⲟⲩ ϩⲱⲥⲧⲉ ⲛⲥⲉⲭⲣⲉⲙⲣⲉⲙ ⲛϫⲉⲛⲓ**ⲓⲟⲩⲇⲁⲓ** ⲛⲥⲁⲡⲓⲣⲉϥϯⲥⲃⲱ ⲉⲩϫⲱ ⲙⲙⲟⲥ ⲛⲁϥ ϫⲉⲉⲑⲃⲉⲟⲩ ⲛⲉⲕⲙⲁⲑⲏⲧⲏⲥ ⲥⲉⲉⲣⲛⲏⲥⲧⲉⲩⲓⲛ ⲁⲛ ⲙⲫⲣⲏϯ ⲛⲛⲓⲙⲁⲑⲏⲧⲏⲥ ⲛⲧⲉⲓⲱⲁⲛⲛⲏⲥ",
      "english": "Those in the house of Peter and all the disciples of our Lord Jesus Christ also drank wine with Him, so much so that the Jews murmured against the Master, saying: “Why do your disciples not fast like John's disciples?”",
