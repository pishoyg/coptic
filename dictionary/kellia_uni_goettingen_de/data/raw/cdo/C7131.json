  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲛⲧⲉⲣⲉⲡⲟⲩⲟⲉⲓⲛ ⲉⲓ ⲉϩⲣⲁⲓ · ⲡⲉϫⲉⲡⲉⲧⲥⲟⲃϩ ⲙⲡⲃⲗⲗⲉ · ϫⲉϩⲁⲣⲏⲩ ⲕⲛⲁⲧⲱⲟⲩⲛ ⲛⲧⲛⲃⲱⲕ ⲉⲡⲉⲥⲏⲧ ⲉⲡⲗⲁⲕⲕⲟⲥ ⲛⲧⲛ**ϫⲱⲕⲙ** ·",
      "english": "And when the light became stronger the man with the skin disease said unto the blind man, 'Peradventure thou wilt get up, and then we will go down to the pool and wash ourselves,",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲇⲟⲩⲝ ⲇⲉ ⲁϥⲕⲁⲁϥ ⲕⲁϩⲏⲩ ϫⲉⲉϥⲛⲁⲃⲱⲕ ⲉϩⲟⲩⲛ ⲉⲧⲥⲓⲟⲟⲩⲛ ⲛϥ**ϫⲱⲕⲙ** · ⲁⲩⲱ ⲁⲙⲓⲭⲁⲏⲗ ⲧⲱⲟⲩⲛ ⲉϩⲣⲁⲓ ⲛⲛⲉⲡⲗⲁⲝ ⲛⲧⲥⲓⲟⲟⲩⲛ · ⲁϥⲛⲉϫⲁⲡⲁ ⲃⲓⲕⲧⲱⲣ ⲉϩⲣⲁⲓ ·",
      "english": "And the Duke stripped off his clothes in order that he might go into the bath to bathe, and Michael raised up the (stone) slab of the bath, and thrust Apa Victor upon it.",
      "source": "Martyrdom of Victor part 5",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:33-48",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϫⲓⲥ ϩⲱⲱⲕ ⲛⲧϩⲉ ⲛⲇⲁⲩⲉⲓⲇ ϫⲉϯⲛⲁ**ϫⲱⲕⲙ** ⲙⲡⲁϭⲗⲟϭ ⲕⲁⲧⲁⲟⲩϣⲏ ⲟⲩϣⲏ ·",
      "english": "Though thyself shalt say even as did David, 'Night after night I wash my bed,",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    }
