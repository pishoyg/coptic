  "examples": [
    {
      "coptic": "ⲙⲡⲛⲁⲩ ϩⲱⲱϥ ⲉⲧⲉⲣⲉⲡⲉⲕϫⲁϫⲉ ⲛⲁⲕⲁⲥⲕⲥ ⲉϩⲟⲩⲛ ⲉⲣⲟⲕ · ⲉⲧⲉⲡⲁⲓ ⲡⲉ ⲡⲇⲓⲁⲃⲟⲗⲟⲥ ϣⲁⲕⲣⲓⲕⲉ ⲙⲡⲉⲕⲙⲁⲁϫⲉ ⲉⲣⲟϥ ⲛϥⲡⲉϩⲧⲗⲱⲙⲥ ⲉⲡⲉⲥⲏⲧ ⲉⲣⲟϥ · ⲛⲅⲟⲩⲱⲛ ⲙⲡⲉⲕϩⲏⲧ · ⲛⲅⲱⲙⲅ ⲛⲧ**ⲙⲁⲧⲟⲩ** ⲛⲧⲁϥⲁⲡⲟⲃⲁⲗⲉ ⲙⲙⲟⲥ ⲛⲁⲕ ·",
      "english": "At the moment when thine enemy, that is to say, the Devil, whispereth unto thee, thou dost incline thine ear to him, and he poureth into it stinkingness, and thou openest thy heart, and dost swallow the venom which he poureth into thee.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛϥϫⲡⲟⲕ · ϩⲙⲡⲕⲱⲧⲉ ⲛⲧⲉⲛⲧⲟⲗⲏ · ϫⲉⲟⲩⲧⲉ ⲧⲉⲭⲣⲉⲓⲁ · ⲉⲧⲣⲉⲕⲁⲅⲱⲛⲓⲍⲉ ⲙⲁⲩⲁⲁⲕ · ⲉⲕⲧⲛⲧⲱⲛ ⲉⲩⲑⲏⲣⲓⲟⲛ ϩⲱⲥ ⲉⲣⲉⲧⲉⲓ**ⲙⲁⲧⲟⲩ** ⲛϩⲏⲧⲕ ·",
      "english": "it shall give thee birth in the circle of the commandment, and make thee to strive by thyself; thou resemblest a wild animal inasmuch as the venom is in thee.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲗⲟⲓⲡⲟⲛ ⲉϣⲱⲡⲉ ⲁⲕⲕⲁⲃⲱⲗ ⲛⲧⲉⲕⲡⲗⲁⲛⲏ ⲙⲛⲧⲉⲕ**ⲙⲁⲧⲟⲩ** · ⲱϣ ⲉⲃⲟⲗ ϩⲱⲱⲕ ⲙⲛⲡⲛⲟⲙⲟⲑⲉⲧⲏⲥ ⲙⲱⲩⲥⲏⲥ ϫⲉⲡⲁⲓ ⲡⲉ ⲡⲁⲡⲛⲟⲩⲧⲉ ϯⲛⲁϯⲉⲟⲟⲩ ⲛⲁϥ · ⲉⲧⲉⲡⲱϥ ⲡⲉ ⲡⲉⲟⲟⲩ ⲙⲛⲡⲁⲙⲁϩⲧⲉ ϣⲁⲛⲁⲓⲱⲛ ⲧⲏⲣⲟⲩ ⲛⲁⲓⲱⲛ ϩⲁⲙⲏⲛ ·",
      "english": "Finally, when thou hast vomited thine error and thy folly, do thou thyself cry out with the Lawgiver Moses, saying, 'This is my God, I will ascribe glory unto him,' (Exod. 15:2) for unto Him belong glory and power, for all ages of ages. Amen.",
      "source": "Proclus Homily 23 On the Nativity in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily23.budge",
      "dialect": "sahidic"
    }
