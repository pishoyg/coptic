  "examples": [
    {
      "coptic": "ⲡⲣⲱⲙⲉ ⲙⲡϩⲟⲟⲩ · ⲛⲣⲁⲥⲧⲉ ⲡⲕⲁϩ ⲙⲛⲡ**ⲕⲣⲙⲉⲥ** ⲡⲉ ·",
      "english": "He is a man today, tomorrow he is dust and ashes.",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩϭⲓϫ ⲛⲟⲙⲉ ⲟⲩϭⲓϫ ⲛⲕⲁϩ ϩⲓ**ⲕⲣⲙⲉⲥ** ⲉⲁⲩⲡⲗⲁⲥⲥⲉ ⲙⲙⲟⲥ ⲉⲃⲟⲗ ϩⲙⲡⲕⲁϩ · ⲁⲥⲧⲟⲗⲙⲁ ⲁⲥϯⲁⲁⲥ ⲉϩⲟⲩⲛ ϩⲙⲡϩⲟ ⲙⲡⲭⲣⲓⲥⲧⲟⲥ ⲡⲉ ⲛⲧⲁϥⲡⲗⲁⲥⲥⲉ ⲛⲧⲡⲉ ⲙⲛⲡⲕⲁϩ · ⲁⲩⲱ ⲁϥϥⲓ ⲉⲣⲟϥ ϩⲛⲟⲩⲑⲃⲃⲓⲟ ·",
      "english": "A hand made of mud, a hand of clay, a hand of dust and ashes, which was fashioned out of the earth, dared to thrust itself into the Face of Christ, Who fashioned the heavens and the earth, and He endured it with humility!",
      "source": "The Asceticon of Apa Ephrem part 2",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:24-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣϫⲉ ⲁⲩⲙⲟⲩⲧⲉ ⲉⲡⲉⲕϫⲟⲉⲓⲥ ϫⲉⲡⲉⲡⲗⲁⲛⲟⲥ · ⲁⲩⲱ ⲛⲉⲡⲣⲟⲫⲏⲧⲏⲥ ϫⲉⲛⲉⲧⲥⲟϣϥ · ⲁⲩⲱ ϩⲉⲛⲕⲟⲟⲩⲉ ϫⲉⲛⲉⲧⲗⲟⲃⲉ · ⲉⲓⲉⲡⲟⲥⲟ ⲙⲁⲗⲗⲟⲛ ⲁⲛⲟⲛ ⲛⲕⲁϩⲓ ϩⲓ**ⲕⲣⲙⲉⲥ** ·",
