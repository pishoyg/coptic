  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲉⲣⲟⲩⲱ ⲛϫⲉⲓⲏⲥⲟⲩⲥ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲭⲁⲟⲩⲛⲁϩϯ ⲛⲧⲉⲫⲛⲟⲩϯ **ⲛⲧⲉⲛ**ⲑⲏⲛⲟⲩ .",
      "english": "Jesus answered them, 'Have faith in God.",
      "source": "Bohairic Gospel of Mark 11 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲩⲙⲏⲣ **ⲛⲧⲟⲟⲧ**ⲟⲩ ⲛⲛⲉⲧⲟⲩⲁⲁⲃ ⲻ",
      "english": "but they are bound by the holy ones.'",
      "source": "Apophthegmata Patrum Sahidic 052",
      "urn": "urn:cts:copticLit:ap.52.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥϣⲉⲛⲟⲩ ϫⲉⲁⲣⲉⲧⲉⲛⲕⲱϯ ⲛⲥⲁⲟⲩ **ⲛⲧⲟⲧ**ⲟⲩ .",
      "english": "He asked the scribes, 'What are you asking them?'",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ ⲁⲓⲣϩⲛⲁⲓ ⲙⲡⲱⲧ **ⲛⲧⲟⲟⲧ**ϥ ⲙⲡⲛⲟⲃⲉ ·",
      "english": "And I wished to escape from the sin.",
