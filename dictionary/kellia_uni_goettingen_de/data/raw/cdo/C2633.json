  "examples": [
    {
      "coptic": "ⲉⲓⲥ ⲟⲩⲁⲅⲅⲉⲗⲟⲥ ⲛⲧⲉⲡⲛⲟⲩⲧⲉ ⲁϥⲟⲩⲱⲛϩ ⲛⲁϥ ⲉⲃⲟⲗ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲇⲏⲙⲏⲧⲣⲓⲟⲥ ⲇⲏⲙⲏⲧⲣⲓⲟⲥ ⲙⲡⲣϣⲓⲛⲉ ⲛⲥⲁⲧⲉⲕ**ⲛⲟϥⲣⲉ** ⲙⲁⲩⲁⲁⲕ · ⲁⲗⲗⲁ ⲛⲥⲁⲡⲉⲧϩⲓⲧⲟⲩⲱⲕ ·",
      "english": "for behold, the Angel of God appeared unto him, and he said unto him, 'Demetrius, Demetrius, seek not only thine own happiness, but that of thy neighbour.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲓϫⲱ ⲇⲉ ⲙⲡⲁⲓ ⲉⲧⲉⲧⲛ**ⲛⲟϥⲣⲉ** . ϫⲉⲕⲁⲁⲥ ⲁⲛ ⲉⲓⲉϯ ⲛⲟⲩⲉⲗⲱ ⲉϩⲏⲧⲧⲏⲩⲧⲛ ⲁⲗⲗⲁ ⲡⲣⲟⲥⲟⲩⲧⲥⲁⲛⲟ ⲙⲛⲧϭⲓⲛⲁϩⲉⲣⲁⲧⲕ ⲉⲡϫⲟⲉⲓⲥ ⲕⲁⲗⲱⲥ ⲁϫⲛⲣⲟⲟⲩϣ",
      "english": "This I say for your own profit; not that I may ensnare you, but for that which is appropriate, and that you may attend to the Lord without distraction.",
      "source": "1 Corinthians 7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲁⲣⲉⲡⲛⲟⲩⲧⲉ ⲅⲁⲣ ⲕⲟⲓⲛⲱⲛⲉⲓ ⲙⲛⲡⲗⲉⲟⲛⲉⲝⲓⲁ · ⲟⲩⲇⲉ ⲡⲛⲟⲩⲧⲉ ⲡⲕⲟⲓⲛⲱⲛⲟⲥ ⲁⲛ ⲡⲉ ⲛⲛⲥⲟⲟⲛⲉ ⲛⲛⲣⲉϥⲧⲱⲣⲡ · ⲟⲩⲇⲉ ϩⲱⲥ ⲉⲙⲛϣϭⲟⲙ ⲙⲙⲟϥ ⲁⲛ ⲉⲥⲁⲛϣ ⲛⲛϩⲏⲕⲉ ⲉⲁϥⲕⲁⲁⲩ ⲛⲁⲛ · ⲁⲗⲗⲁ ⲉϥϣⲓⲛⲉ ⲛⲥⲁⲟⲩⲙⲛⲧⲣⲉϥϯⲕⲁⲣⲡⲟⲥ ⲛⲇⲓⲕⲁⲓⲟⲛ · ⲁⲩⲱ ⲙⲙⲁⲓⲣⲱⲙⲉ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧⲛ ⲉⲧⲉⲛ**ⲛⲟⲃⲣⲉ** · ⲁⲩⲱ ⲉⲩⲡⲉⲧⲛⲁⲛⲟⲩϥ ⲛⲁⲛ ·",
      "english": "For God doth not make Himself a partner in greediness, neither doth He share with thieves and robbers. It is not impossible for Him to feed the poor whom He hath committed unto us, but He requireth the fruitfulness of righteousness, and the love of men, at our hands, whereby we shall be both of use to others, and do good to ourselves.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    }
