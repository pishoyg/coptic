  "examples": [
    {
      "coptic": "ⲛⲁϥⲥⲟⲗⲥⲉⲗ ⲛⲛⲓⲥⲁϫⲓ ⲁⲛ ϧⲉⲛⲟⲩⲙⲉⲧⲫⲓⲗⲟⲥⲟⲫⲟⲥ ϧⲁⲧⲟⲧⲟⲩ ⲛⲛⲉϥϩⲁⲅⲓⲟⲥ ⲛⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲁⲗⲗⲁ ϧⲉⲛⲟⲩⲙⲉⲧϣⲁⲙϣⲉⲛⲟⲩϯ ⲛⲉⲙⲟⲩϫⲓⲛⲕⲁϯ ⲉⲥϣⲟⲙ ⲛⲉⲙⲉⲛⲧⲟⲗⲏ ⲛⲓⲃⲉⲛ ⲛⲧⲉϯⲙⲉⲑⲙⲏⲓ ⲉϥⲟⲩⲱϣ ⲁⲛ ⲉϯⲙⲕⲁϩ ⲛϩⲏⲧ ⲛϩⲗⲓ ⲉⲃⲏⲗ ⲉⲛⲏ ⲉⲑ**ⲙⲟⲥϯ** ⲙⲡⲓⲥⲁϫⲓ ⲙⲙⲁⲩⲁⲧⲟⲩ ⲛⲉⲙⲛⲏ ⲉⲑⲙⲟⲥϯ ⲛⲛⲓⲣⲉϥϯⲥⲃⲱ .",
      "english": "He did not adorn His words in a philosophical manner for His holy apostles but instructed them in the service of God, sharp understanding, and every precept of truth, wishing to sadden no one except those who hated the Word and despised their teachers.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲛⲟⲩⲧⲉ ⲅⲁⲣ ϫⲱ ⲙⲙⲟⲥ ⲉⲣⲉⲛⲣⲙⲉⲓⲟⲟⲩⲉ ⲕⲓⲙ ⲉⲣⲟϥ ⲛⲉⲧⲟⲩϫⲓ ⲙⲙⲟⲟⲩ ⲛϭⲟⲛⲥ ϫⲉⲛⲁⲓ ⲛⲉ ϯ**ⲙⲟⲥⲧⲉ** ⲙⲙⲟⲟⲩ ⲉⲧⲉⲧⲛⲉⲓⲣⲉ ⲙⲙⲟⲟⲩ ⲡⲉ ⲛⲉ · ⲧⲉⲧⲛϩⲱⲃⲥ ⲙⲡⲁⲑⲩⲥⲓⲁⲥⲧⲏⲣⲓⲟⲛ · ⲛϩⲉⲛⲣⲙⲉⲓⲟⲟⲩⲉ ⲙⲛⲟⲩⲣⲓⲙⲉ · ⲙⲛⲟⲩⲁϣⲁϩⲟⲙ ⲉⲃⲟⲗ ϩⲛϩⲉⲛϩⲓⲥⲉ ·",
      "english": "For God spake concerning the tears that moved Him of those who were treated unjustly, saying, 'These are the things that ye do which I hate. Ye cover over (or, dress) My altar with tears, and weeping, and sighings which arise from sufferings.'",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲣⲉⲧⲉⲛⲉϣⲱⲡⲓ ⲉⲩ**ⲙⲟⲥϯ** ⲙⲙⲱⲧⲉⲛ ⲛϫⲉⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲑⲃⲉⲡⲁⲣⲁⲛ ⲫⲏ ⲇⲉ ⲉⲧⲛⲁⲁⲙⲟⲛⲓ ⲛⲧⲟⲧϥ ϣⲁⲉⲃⲟⲗ ⲫⲁⲓ ⲡⲉ ⲫⲏ ⲉⲧⲛⲁⲛⲟϩⲉⲙ .",
      "english": "You will be hated by all men for my name's sake, but he who endures to the end, the same will be saved.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϥϫⲱ ⲙⲙⲟⲥ · ϫⲉⲁⲓ**ⲙⲉⲥⲧⲉ**ⲡⲁⲁϩⲉ ⲧⲏⲣϥ ⲛⲧⲁⲓϣⲡϩⲓⲥⲉ ϩⲁⲣⲟϥ ⲙⲡⲣⲏ · ϫⲉⲕⲁⲥ ⲉⲓⲉⲕⲁⲁϥ ⲙⲡⲣⲱⲙⲉ ⲉⲧⲛⲏⲩ ⲙⲛⲛⲥⲱⲓ ·",
      "english": "who saith, 'I hate all the labour for which I had suffered under the sun, because I am obliged to leave it to the man who shall come after me?",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ ⲉⲑⲙⲟⲥϯ ⲙⲙⲟⲓ ϥ**ⲙⲟⲥϯ** ⲙⲡⲁⲕⲉⲓⲱⲧ .",
      "english": "He who hates me, hates my Father also.",
      "source": "04_John_15",
      "urn": "urn:cts:copticLit:nt.john.bohairic:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣϫⲉ ⲁⲕ**ⲙⲉⲥⲧⲱ**ⲓ ϩⲙⲡⲉⲓⲕⲟⲥⲙⲟⲥ · ⲉⲓⲉ ⲥⲁϩⲱⲱⲕ ⲉⲃⲟⲗ ⲙⲙⲟⲓ ϫⲉⲛϯⲥⲟⲟⲩⲛ ⲙⲙⲟⲕ ⲁⲛ ·",
