  "examples": [
    {
      "coptic": "ⲙⲡⲉⲣⲭⲁⲧ ⲛⲥⲱⲕ ⲡϭⲟⲓⲥ ⲡⲁⲛⲟⲩϯ ⲙⲡⲉⲣ**ⲟⲩⲉⲓ** ⲥⲁⲃⲟⲗ ⲙⲙⲟⲓ .",
      "english": "Draw nigh to my help, O Lord of my salvation.",
      "source": "19_Psalmi_37",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:37",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲩⲟⲓ ⲛⲛⲉⲧⲉⲣⲉⲡⲛⲟⲩⲧⲉ ⲛⲁϩⲟϫϩϫ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧⲟⲩ ⲁⲩⲱ ⲛϥⲕⲱⲧⲉ ⲛⲥⲁⲧϩⲉ ⲛⲉⲓ ⲉⲉⲃⲟⲗ ϩⲛⲧⲉⲩⲙⲏⲧⲉ · ⲛⲧϩⲉ ⲛⲟⲩⲣⲱⲙⲉ ⲛⲇⲓⲕⲁⲓⲟⲥ ⲉⲁϥⲕⲱⲧⲉ ⲛⲥⲁⲧϩⲉ ⲛⲕⲱ ⲛⲥⲱϥ ⲛⲟⲩⲗⲁⲟⲥ ⲉⲧⲃⲉⲛⲉⲩϩⲃⲏⲩⲉ ⲉⲧϩⲟⲟⲩ ⲕⲁⲧⲁⲡϣⲁϫⲉ ⲙⲡⲉⲡⲣⲟⲫⲏⲧⲏⲥ ϫⲉⲛⲓⲙ ⲡⲉⲧⲛⲁϯⲛⲁⲓ ϩⲙⲡϫⲁⲓⲉ ⲛⲟⲩⲙⲁ ⲛϣⲱⲡⲉ ⲉϥⲟⲩⲏⲩ ⲛⲧⲁⲕⲱ ⲛⲥⲱⲓ ⲙⲡⲉⲓⲗⲁⲟⲥ ⲛⲧⲁ**ⲟⲩⲉ** ⲉⲃⲟⲗ ⲙⲙⲟⲟⲩ ·",
      "english": "And woe to those by whom God will be distressed and from whose midst He will seek for a way to come, like a just man, having sought for a way to abandon a people because of their wicked deeds, as the prophet says: Who is it that will give to me in the desert a distant dwelling place? That I may abandon this people and remain far removed from them.'",
      "source": "Acephalous 22: YA 421-28",
      "urn": "urn:cts:copticLit:shenoute.a22.monbya:1251-1258",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ϯⲛⲁϯ ⲛⲛⲉⲧⲉⲛϣⲏⲣⲓ ⲛⲉⲙⲛⲉⲧⲉⲛϣⲉⲣⲓ ⲉϧⲣⲏⲓ ⲉⲛⲉⲛϫⲓϫ ⲉⲛⲉⲛϣⲏⲣⲓ ⲛⲓⲟⲩⲇⲁ ⲟⲩⲟϩ ⲉⲩⲉⲧⲏⲓⲧⲟⲩ ⲉⲟⲩⲉⲭⲙⲁⲗⲱⲥⲓⲁ ⲉⲟⲩⲉⲑⲛⲟⲥ ⲉϥ**ⲟⲩⲏⲟⲩ** ϩⲓⲫⲟⲩⲉⲓ ϫⲉⲡϭⲥ ⲁϥⲥⲁϫⲓ .",
      "english": "And I will sell your sons and your daughters into the hands of the children of Juda, and they shall sell them into captivity to a far distant nation: for the Lord has spoken it.",
      "source": "29_Ioel_03",
      "urn": "urn:cts:copticLit:ot.joel.bohairic_ed:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲡⲉⲓⲗⲁⲟⲥ ⲧⲁⲓⲟ ⲙⲙⲟⲓ ϩⲛⲛⲉⲩⲥⲡⲟⲧⲟⲩ · ⲡⲉⲩϩⲏⲧ ⲇⲉ **ⲟⲩⲏⲩ** ⲛⲥⲁⲛⲃⲟⲗ ⲙⲙⲟⲓ ·",
      "english": "“this people honours me with their lips, but their heart is distant far away from me.”",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲟϥ ⲇⲉ ⲁⲡⲁ ϣⲉⲛⲟⲩϯ ⲛⲉϣⲁϥϩⲱⲗ ⲉϧⲣⲏⲓ ⲉⲟⲩϣⲏⲓ ⲙⲙⲱⲟⲩ ⲉϥ**ⲟⲩⲏⲟⲩ** ⲉⲃⲟⲗ ⲙⲡϯⲙⲓ ⲛⲟⲩⲕⲟⲩϫⲓ ⲟⲩⲟϩ ⲛⲉⲡⲓⲁⲃⲟⲧ ⲧⲱⲃⲓ ⲛⲉ ⲛⲓⲉϩⲟⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ ⲟⲩⲟϩ ⲡⲁⲓⲣⲏϯ ⲛⲉϣⲁϥⲫⲱⲣϣ ⲛⲛⲉϥϫⲓϫ ⲉⲃⲟⲗ ⲛⲧⲉϥϣⲗⲏⲗ ⲉⲣⲉⲡⲓⲙⲱⲟⲩ ⲛⲏⲟⲩ ϣⲁⲡⲉϥⲙⲟⲩⲧ",
      "english": "But Apa Shenoute would always hurry down to a water cistern a little outside the village and it was the month of Tobi in those days, and so he would spread his hands out and pray with the water coming up to his neck.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲣⲉⲡⲟⲩϩⲏⲧ ⲇⲉ **ⲟⲩⲏⲩ** ⲛⲥⲁⲃⲟⲗ ⲙⲙⲟⲥ .",
      "english": "But it’s that your heart is distant far away from her.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    }
