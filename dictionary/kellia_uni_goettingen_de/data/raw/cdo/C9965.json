  "examples": [
    {
      "coptic": "ϯϯϩⲟ **ⲟⲩⲛ** ⲉⲣⲱⲧⲉⲛ ϣⲱⲡⲓ ⲉⲣⲉⲧⲉⲛⲟⲛⲓ ⲙⲙⲟⲓ .",
      "english": "I beg you therefore, be imitators of me.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲁⲧ **ⲟⲩⲛ** ⲛⲙⲡϣⲁ ⲉⲧⲣⲉⲕϯⲙⲧⲟⲛ ⲛⲁⲓ ϩⲛⲧⲉⲕⲁⲛⲁⲡⲁⲩⲥⲓⲥ ⲉⲧⲟⲩⲁⲁⲃ · ⲛⲅⲭⲁⲣⲓⲍⲉ ⲛⲁⲓ ⲛⲧⲙⲛⲧⲧⲉⲗⲓⲟⲥ ⲉⲧⲛϩⲏⲧⲕ · ⲉⲧⲉⲧⲙⲛⲧⲁⲧⲛⲟⲃⲉ ⲧⲉ · ⲙⲛⲡⲟⲩϫⲁⲓ ⲛⲁⲧϣⲁϫⲉ ⲉⲣⲟϥ · ⲁⲩⲱ ⲛⲁⲧϩⲉⲧϩⲱⲧϥ · ⲁⲩⲱ ⲛⲁⲧⲧⲁϩⲟϥ · ⲉⲓⲛⲏⲩ ϣⲁⲣⲟⲕ ⲡⲁϫⲟⲉⲓⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲉⲭⲣⲓⲥⲧⲟⲥ ·",
      "english": "make me therefore worthy to enjoy rest in Thy holy repose. Do thou bestow upon me graciously the perfection which is in Thee, that is to say, the sinlessness and the salvation, which cannot be described, and which cannot be pried into, and which are beyond the comprehension [of man]. I come unto Thee, my Lord Jesus, the Christ.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲓⲗⲁⲧⲟⲥ ⲇⲉ ⲉⲧⲁϥⲉⲣⲟⲩⲱ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲟⲩ **ⲟⲩⲛ** ⲡⲉϯⲛⲁⲁⲓϥ ⲙⲫⲏ ⲉⲧⲉⲧⲉⲛϫⲱ ⲙⲙⲟⲥ ⲉⲣⲟϥ ϫⲉⲡⲟⲩⲣⲟ ⲛⲧⲉⲛⲓⲓⲟⲩⲇⲁⲓ",
      "english": "Pilate again asked them, 'What then should I do to him whom you call the King of the Jews?'",
      "source": "Bohairic Gospel of Mark 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲕⲁⲗⲱⲥ **ⲟⲩⲛ** ⲁϥϫⲟⲟⲥ ⲛϭⲓⲡⲙⲁⲕⲁⲣⲓⲟⲥ ⲡⲁⲩⲗⲟⲥ ϫⲉⲁⲛⲁⲣⲭⲁⲓⲟⲛ ⲟⲩⲉⲓⲛⲉ · ⲉⲓⲥϩⲏⲏⲧⲉ ⲁϩⲉⲛⲃⲣⲣⲉ ϣⲱⲡⲉ ·",
      "english": "Well therefore hath the blessed Paul said, 'Old things a have departed; behold, new things exist.'",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲣⲱⲓⲥ **ⲟⲩⲛ** ⲟⲩⲟϩ ⲁⲣⲓⲡⲣⲟⲥⲉⲩⲭⲉⲥⲑⲉ ϩⲓⲛⲁ ⲛⲧⲉⲧⲉⲛϣⲧⲉⲙⲓ ⲉϧⲟⲩⲛ ⲉⲡⲓⲣⲁⲥⲙⲟⲥ ⲡⲓⲡⲛⲉⲩⲙⲁ ⲙⲉⲛ ϥⲣⲱⲟⲩⲧ ϯⲥⲁⲣⲝ ⲇⲉ ⲟⲩⲁⲥⲑⲉⲛⲏⲥ ⲧⲉ .",
      "english": "Watch and pray, that you may not enter into temptation. The spirit indeed is willing, but the flesh is weak.'",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲉⲛⲟⲩ **ⲟⲩⲛ** ϯϩⲟⲙⲟⲗⲟⲅⲉⲓ ⲁⲩⲱ ϯⲉⲅⲅⲩⲏ ⲛⲏⲧⲛ ⲙⲡⲉⲧⲣⲓⲧⲟⲛ ⲙⲉⲣⲟⲥ ϩⲛⲛⲉⲃⲓⲟⲟⲩⲉ",
      "english": "I therefore agree now and I pledge for the third part of the honey",
      "source": "Honey Delivery",
      "urn": "urn:cts:copticDoc:papyri_info.tm82149.cpr_4_16",
      "dialect": "sahidic"
    }
