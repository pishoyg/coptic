  "examples": [
    {
      "coptic": "ⲙⲏ ⲁⲩⲛⲁⲉⲡ ⲑⲏⲛⲟⲩ ⲁⲛ ⲙⲫⲣⲏϯ ⲙⲡⲓⲟⲙⲓ ⲛⲧⲉⲡⲓⲕⲉⲣⲁⲙⲉⲩⲥ ⲙⲏ ϥⲛⲁϫⲟⲥ ⲛϫⲉⲡⲓ**ⲡⲗⲁⲥⲙⲁ** ⲙⲫⲏⲉⲧⲁϥⲉⲣⲡⲗⲁⲍⲓⲛ ⲙⲙⲟϥ ϫⲉⲛⲑⲟⲕ ⲁⲛ ⲁⲕⲉⲣⲡⲗⲁⲍⲓⲛ ⲙⲙⲟⲓ ⲓⲉ ⲡⲓⲙⲟⲩⲛⲕ ⲙⲫⲏⲉⲧⲁϥϫⲉ ⲙⲡⲉⲕⲙⲟⲛⲕⲧ ϧⲉⲛⲟⲩⲕⲁϯ .",
      "english": "Shall ye not be counted as clay of the potter? Shall the thing formed say to him that formed it, Thou didst not form me? or the work to the maker, Thou hast not made me wisely?",
      "source": "23_Isaias_29",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:29",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲛⲧⲟϥ ⲁϥⲉⲓⲙⲉ ⲉⲡⲉⲛ**ⲡⲗⲁⲥⲙⲁ** ⲁⲣⲓⲡⲙⲉⲉⲩⲉ ⲡϫⲟⲉⲓⲥ ϫⲉⲁⲛⲟⲛ ⲟⲩⲕⲁϩ",
      "english": "For he knows our frame: remember that we are dust.",
      "source": "Psalms 102",
      "urn": "urn:cts:copticLit:ot.pss.coptot:102",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲁⲓ ⲡⲉ ⲡⲓϩⲟⲩⲓⲧ ⲙ**ⲡⲗⲁⲥⲙⲁ** ⲛⲧⲉⲡϭⲥ : ⲉⲁϥⲑⲁⲙⲓⲟϥ ⲉⲑⲣⲟⲩⲥⲱⲃⲓ ⲙⲙⲟϥ ⲛϫⲉⲛⲉϥⲁⲅⲅⲉⲗⲟⲥ .",
      "english": "Yet one shall take him in his sight; one shall catch him with a cord, and pierce his nose.",
