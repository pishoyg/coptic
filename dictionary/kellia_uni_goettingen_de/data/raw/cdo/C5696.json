  "examples": [
    {
      "coptic": "ⲁϥϫⲱ ⲇⲉ ⲛⲁⲩ ⲛⲕⲉⲡⲁⲣⲁⲃⲟⲗⲏ . ϫⲉⲙⲉⲣⲉⲗⲁⲁⲩ ⲥⲗⲡⲟⲩⲧⲟⲓⲥ ϩⲓⲟⲩϣⲧⲏⲛ ⲛϣⲁⲓ ⲛϥⲧⲟⲣⲡⲥ ⲉⲩϣⲧⲏⲛ ⲙⲡⲗϭⲉ . ⲉϣⲱⲡⲉ ⲙⲙⲟⲛ ϥⲛⲁⲡⲁϩⲧⲕⲉϣⲧⲏⲛ ⲛϣⲁⲓ ⲛⲧⲉⲧⲙⲧⲧⲟⲓⲥ ⲛ**ϣⲁⲓ** ⲣϣⲁⲩ ⲉⲧⲡⲗϭⲉ .",
      "english": "He also told a parable to them. 'No one puts a piece from a new garment on an old garment, or else he will tear the new, and also the piece from the new will not match the old.",
      "source": "42_Luke_5",
      "urn": "urn:cts:copticLit:nt.luke.sahidica:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲉⲣⲉⲗⲁⲁⲩ ϩⲓⲟⲩⲧⲟⲉⲓⲥ ⲛ**ϣⲁⲓ** ⲉⲩϣⲧⲏⲛ ⲙⲡⲗϭⲉ . ⲥⲛⲁϥⲓ ⲅⲁⲣ ⲙⲡⲉⲥⲕⲱⲧⲉ ⲉⲃⲟⲗ ϩⲛⲧⲉϣⲧⲏⲛ ⲛϥϣⲱⲡⲉ ⲛϭⲓⲟⲩⲛⲟϭ ⲙⲡⲱϩ .",
      "english": "No one puts a piece of unshrunk cloth on an old garment; for the patch would tear away from the garment, and a worse hole is made.",
      "source": "40_Matthew_9",
      "urn": "urn:cts:copticLit:nt.matt.sahidica:9",
      "dialect": "sahidic"
    },
    {
