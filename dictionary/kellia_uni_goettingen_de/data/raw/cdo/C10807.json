  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁϥ ⲟⲓ ⲛ**ⲧⲩⲡⲟⲥ** ⲛⲱⲟⲩ ϧⲉⲛϩⲁⲛϩⲃⲏⲟⲩⲓ ⲉⲛⲁⲛⲉⲩ .",
      "english": "He was a model for them in good works.",
      "source": "Life of Isaac of Alexandria - part 2",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:20-41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲉϥⲟ ⲛⲧⲩⲡⲟⲥ **ⲧⲩⲡⲟⲥ** ⲡⲉ ϫⲓⲛⲙⲡⲉⲥⲏⲧ ⲉⲧⲡⲉ ·",
      "english": "and it was of divers type, from below upwards,",
      "source": "Pistis Sophia Book 1 Part 1",
      "urn": "urn:cts:copticLit:pistissophia.1.petermann:1-13",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲛⲁⲩ ⲉⲡⲓϣⲟⲗ ⲛⲥⲱⲟⲩⲃⲉⲛ ⲫⲏ ⲉⲧⲧⲁⲗⲏⲟⲩⲧ ⲉⲡⲓⲁⲗⲟⲩ ⲉⲣⲉⲡ**ⲧⲩⲡⲟⲥ** ⲛⲟⲩⲥⲧⲁⲩⲣⲟⲥ ⲛⲟⲩⲱⲓⲛⲓ ⲭⲏ ϩⲓϫⲱϥ ⲉϥϩⲓ ⲉⲃⲣⲏϫ ⲛⲟⲩⲱⲓⲛⲓ ⲉⲃⲟⲗ .",
      "english": "He saw the bundle placed on the young boy having the shape of luminous crosses, throwing flashes of light.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲛⲉⲕⲗⲏⲣⲓⲕⲟⲥ ⲙⲡⲁⲣⲭⲏⲉⲡⲓⲥⲕⲟⲡⲟⲥ ϫⲉⲧⲛⲡⲁⲣⲁⲕⲁⲗⲉⲓ ⲛⲧⲉⲕⲙⲛⲧⲡⲉⲧⲟⲩⲁⲁⲃ ⲉⲧⲣⲉⲕⲧⲁⲙⲟⲛ ϫⲉⲟⲩ ⲡⲉ ⲡⲉⲓ**ⲧⲩⲡⲟⲥ** ⲛⲧⲁⲕⲁⲁϥ ϫⲉⲁⲛⲣϣⲡⲏⲣⲉ ⲧⲏⲣⲛ ⲉϩⲣⲁⲓ ⲉϫⲙⲡϩⲱⲃ ·",
      "english": "the clergy said unto the Archbishop, 'We entreat thee and the holy woman to explain unto us the meaning of this symbolic act which thou hast performed, for we are all wondering about the matter, and what it meaneth.'",
