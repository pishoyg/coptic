  "examples": [
    {
      "coptic": "ⲧⲟⲧⲉ ⲁϥⲉⲣⲟⲩⲱ ⲡⲉϫⲁϥ ϫⲉ**ⲁⲛⲟⲕ** ⲡⲉ ⲓⲥⲁⲁⲕ .",
      "english": "Then Isaac said, ‘I am Isaac.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ **ⲁⲛⲟⲕ** ⲁⲓⲥⲉⲧⲡⲧⲏⲩⲧⲛ ·",
      "english": "But I have chosen you.",
      "source": "Abraham Our Father XL 93-94",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbxl:23-24",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯϯϩⲟ ⲟⲩⲛ ⲉⲣⲱⲧⲉⲛ ϣⲱⲡⲓ ⲉⲣⲉⲧⲉⲛⲟⲛⲓ ⲙⲙⲟ**ⲓ** .",
      "english": "I beg you therefore, be imitators of me.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲣⲁⲙⲟⲟϣⲉ ⲉⲡϫⲓⲥⲉ ⲙⲙⲟ**ⲓ**",
      "english": "to move toward my exultation.",
      "source": "Apophthegmata Patrum Sahidic 136",
      "urn": "urn:cts:copticLit:ap.136.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲁⲓ ϯⲛⲟⲩ ⲉⲧ**ⲓ**ⲛⲁⲧⲁⲟⲩⲉϩⲁⲛⲕⲟⲩϫⲓ ⲉⲣⲱⲧⲉⲛ ⲉⲃⲟⲗ ⲛϧⲏⲧⲟⲩ .",
      "english": "I will now recount a few of them to you.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϫⲉ**ϯ**ⲛⲟⲉⲓ ⲡⲁⲣⲁⲣⲟϥ ·",
      "english": "And, 'I know more than he.'",
      "source": "Apophthegmata Patrum Sahidic 129: N 331",
