  "examples": [
    {
      "coptic": "ⲉϣⲱⲡ ⲇⲉ ⲛⲧⲉⲟⲩⲁⲓ ϫⲟⲥ ϫⲉϯⲙⲉⲓ ⲙⲫⲛⲟⲩϯ ⲟⲩⲟϩ ⲉϥⲙⲟⲥϯ ⲙⲡⲉϥⲥⲟⲛ ⲟⲩⲥⲁⲙⲉⲑⲛⲟⲩϫ ⲡⲉ ⲫⲏ ⲅⲁⲣ ⲉⲧⲉⲛϥⲙⲉⲓ ⲙⲡⲉϥⲥⲟⲛ ⲁⲛ ⲉⲧⲉϥⲛⲁⲩ ⲉⲣⲟϥ ⲫⲛⲟⲩϯ ⲉⲧⲉⲙⲡⲉϥⲛⲁⲩ ⲉⲣⲟϥ ⲡⲱⲥ ⲛⲁϣϫⲉⲙϫⲟⲙ ⲙ**ⲙⲉⲛⲣⲓⲧ**ϥ",
      "english": "If a man says, 'I love God,' and hates his brother, he is a liar; for he who doesn't love his brother whom he has seen, how can he love God whom he has not seen?",
      "source": "23_I John_04",
      "urn": "urn:cts:copticLit:nt.1john.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲉϥⲧⲣⲩⲫⲁ ⲉⲧⲉⲧⲛ**ⲙⲉ** ⲙⲙⲟϥ ·",
      "english": "Let Him but live delicately, and ye love Him.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲱⲧⲉⲙ ⲛⲁⲥⲛⲏⲟⲩ ⲛⲁ**ⲙⲉⲛⲣⲁϯ** ⲙⲏ ⲫⲛⲟⲩϯ ⲛⲁϥⲥⲱⲧⲡ ⲛⲛⲓϩⲏⲕⲓ ⲛⲧⲉⲡⲓⲕⲟⲥⲙⲟⲥ ⲛⲣⲁⲙⲁⲟ ϧⲉⲛⲡⲓⲛⲁϩϯ ⲟⲩⲟϩ ⲛⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ ⲛⲧⲉϯⲙⲉⲧⲟⲩⲣⲟ ⲑⲏ ⲉⲧⲁϥⲱϣ ⲙⲙⲟⲥ ⲛⲛⲏ ⲉⲑⲛⲁⲙⲉⲛⲣⲓⲧϥ",
      "english": "Listen, my beloved brothers. Didn't God choose those who are poor in this world to be rich in faith, and heirs of the Kingdom which he promised to those who love him?",
      "source": "20_James_02",
      "urn": "urn:cts:copticLit:nt.jas.bohairic:02",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣⲱⲡⲉ ⲁⲕ**ⲙⲉⲣⲉ**ⲛⲉⲕϫⲁϫⲉ",
      "english": "whether you love your enemies;",
      "source": "Apophthegmata Patrum Sahidic 128: N 299",
      "urn": "urn:cts:copticLit:ap.128.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲁ**ⲙⲉⲛⲣⲁϯ** ⲙⲁⲣⲉⲛⲙⲉⲛⲣⲉ ⲛⲉⲛⲉⲣⲏⲩ ϫⲉϯⲁⲅⲁⲡⲏ ⲟⲩⲉⲃⲟⲗ ⲙⲫⲛⲟⲩϯ ⲧⲉ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲧⲉⲣⲁⲅⲁⲡⲁⲛ ⲉⲧⲁⲩⲙⲁⲥϥ ⲉⲃⲟⲗ ϧⲉⲛⲫⲛⲟⲩϯ ⲟⲩⲟϩ ϥⲥⲱⲟⲩⲛ ⲙⲫⲛⲟⲩϯ",
      "english": "Beloved, let us love one another, for love is of God; and everyone who loves is born of God, and knows God.",
      "source": "23_I John_04",
      "urn": "urn:cts:copticLit:nt.1john.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣⲁϥ**ⲙⲉⲣⲓⲧ**ϥ ⲛⲧⲟϥ ⲛϩⲟⲩⲟ ⲁⲩⲱ ⲛϥⲣⲁϣⲉ ⲉϫⲱϥ",
      "english": "He will love them more and be happy about them.",
      "source": "In the Night: BV278-282",
      "urn": "urn:cts:copticLit:shenoute.night.monbbv:1-7",
      "dialect": "sahidic"
    }
