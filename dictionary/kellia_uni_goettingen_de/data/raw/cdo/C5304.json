  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉϣⲱⲡ ⲛⲧⲟⲩⲥⲁⲧⲥ ϣⲁⲥⲓ ⲉϩⲣⲏⲓ ⲟⲩⲟϩ ϣⲁⲥϣⲱⲡⲓ ⲉⲥⲟⲓ ⲛⲛⲓϣϯ ⲉⲛⲓⲟⲩⲟϯ ⲧⲏⲣⲟⲩ ⲟⲩⲟϩ ϣⲁⲥⲓⲣⲓ ⲛϩⲁⲛⲛⲓϣϯ ⲛϫⲁⲗ ϩⲱⲥⲧⲉ ⲛⲧⲟⲩϣϫⲉⲙϫⲟⲙ ⲛϫⲉⲛⲓϩⲁⲗⲁϯ ⲛⲧⲉⲧⲫⲉ ⲉ**ⲟⲩⲟϩ** ϧⲁⲧⲉⲥϧⲏⲓⲃⲓ",
      "english": "yet when it is sown, grows up, and becomes greater than all the herbs, and puts out great branches, so that the birds of the sky can lodge under its shadow.'",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲧⲉⲧⲛ **ⲟⲩⲱϩ** ⲟⲛ ⲉϫⲛⲛⲉⲧⲛϫⲓⲛϭⲟⲛⲥ ·",
      "english": "But rather you still add to your violence.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁϥϣⲉⲡϫⲱϥ ⲇⲉ ⲙⲡⲓⲁⲗⲟⲩ ⲁϥϯ ⲉϫⲱϥ ⲛϯϩⲉⲃⲥⲱ ⲛⲧⲉⲛⲓⲙⲟⲛⲁⲭⲟⲥ ⲁϥⲙⲟⲩϯ ⲉⲟⲩⲁⲓ ⲛⲛⲉϥⲙⲁⲑⲏⲧⲏⲥ ⲉⲡⲉϥⲣⲁⲛ ⲡⲉ ⲁⲃⲣⲁⲁⲙ ⲉⲟⲩⲁⲥⲕⲏⲧⲏⲥ ⲡⲉ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲧⲱⲛⲕ ϭⲓ ⲙⲡⲁⲓⲁⲗⲟⲩ ⲙⲁϣⲉ ⲛⲁⲕ ⲉⲡⲧⲱⲟⲩ ⲙⲡⲁⲙⲁϩⲟ ϣⲱⲡⲓ ⲛⲱⲧⲉⲛⲙⲙⲁⲩ ϣⲁⲧⲉⲡϭⲟⲉⲓⲥ ⲑⲱⲧ ⲙⲡϩⲏⲧ ⲛⲛⲉϥⲓⲟϯ **ⲟⲩⲟϩ** ϯⲛⲁⲟⲩⲱⲣⲡ ⲛⲥⲁⲑⲏⲛⲟⲩ .",
      "english": "When he had shaved the child's head, he gave him the habit of the monks and he called one of his disciples, named Abraham, who was an ascetic, and said to him, Take this young boy, go to Mount Pamaho, and stay there until God has persuaded the hearts of his parents, and I will send for you.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲓⲉⲓ ⲇⲉ ⲉⲃⲟⲗ ϩⲙⲡⲁⲩⲏⲧ ⲙⲙⲟⲛⲁⲭⲟⲥ · ⲁⲓⲕⲱⲧ ⲛⲁⲓ ⲛⲟⲩⲙⲁ ⲛϣⲱⲡⲉ ⲙⲁⲩⲁⲁⲧ ⲁⲓ**ⲟⲩⲱϩ** ⲛϩⲏⲧϥ ·",
      "english": "I came away from the house of the monks, I built myself a habitation in a place apart, and I took up my abode therein.",
      "source": "Life of Onnophrius part 1",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲟⲩⲟϩ** ⲛⲁⲩⲥⲱⲃⲓ ⲙⲙⲟϥ ⲛⲑⲟϥ ⲇⲉ ⲉⲧⲁϥϩⲓ ⲡⲧⲏⲣϥ ⲉⲃⲟⲗ ⲁϥⲱⲗⲓ ⲛⲉⲙⲁϥ ⲙⲫⲓⲱⲧ ⲛϯⲁⲗⲟⲩ ⲛⲉⲙⲧⲉⲥⲙⲁⲩ ⲛⲉⲙⲛⲏ ⲉⲑⲛⲉⲙⲁϥ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ⲉϧⲟⲩⲛ ⲉⲡⲓⲙⲁ ⲉⲛⲁⲣⲉϯⲁⲗⲟⲩ ⲭⲏ ⲙⲙⲟϥ .",
      "english": "They ridiculed him. But he, having put them all out, took the father of the child, her mother, and those who were with him, and went in where the child was lying.",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲏ ⲟⲩ ⲡⲉ ⲡⲃⲁⲣⲟⲥ ⲉⲛⲧⲁⲩ**ⲟⲩⲁϩ**ϥ ⲉϫⲱ ·",
      "english": "Or what is the weight that they put on you,",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    }
