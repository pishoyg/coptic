  "examples": [
    {
      "coptic": "ⲙⲫⲣⲏϯ ⲛⲟⲩⲣⲱⲙⲓ ⲉⲁϥⲙⲟϣⲓ ⲉⲡϣⲉⲙⲙⲟ ⲉⲁϥ**ⲭⲱ** ⲙⲡⲉϥⲏⲓ ⲟⲩⲟϩ ⲁϥϯ ⲛⲛⲉϥⲉⲃⲓⲁⲓⲕ ⲙⲡⲓⲉⲣϣⲓϣⲓ ⲫⲟⲩⲁⲓ ⲫⲟⲩⲁⲓ ⲙⲡⲉϥϩⲱⲃ ⲟⲩⲟϩ ⲁϥϩⲟⲛϩⲉⲛ ⲉⲧⲟⲧϥ ⲙⲡⲓⲉⲙⲛⲟⲩⲧ ϩⲓⲛⲁ ⲛⲧⲉϥⲣⲱⲓⲥ",
      "english": "It is like a man, traveling to another country, having left his house, and given authority to his servants, and to each one his work, and also commanded the doorkeeper to keep watch.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϯⲙⲉ ⲙⲙⲟϥ ⲛⲥⲉ**ⲕⲱ** ⲙⲙⲟⲓ ⲛϩⲏⲧϥ ⲁⲛ ⁛—",
      "english": "I love it. Will ye not leave me in it?",
      "source": "Life of Pisentius part 1",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲟϥ ⲇⲁⲩⲓⲇ ⲁϥϫⲟⲥ ϧⲉⲛⲡⲓⲡⲛⲉⲩⲙⲁ ⲉⲧⲟⲩⲁⲃ ϫⲉⲡⲉϫⲉ ⲡϭⲟⲓⲥ ⲙⲡⲁϭⲟⲓⲥ ϫⲉϩⲉⲙⲥⲓ ⲥⲁⲧⲁⲟⲩⲓⲛⲁⲙ ϣⲁϯ**ⲭⲁ**ⲛⲉⲕϫⲁϫⲓ ⲥⲁⲡⲉⲥⲏⲧ ⲛⲛⲉⲕϭⲁⲗⲁⲩϫ .",
      "english": "For David himself said in the Holy Spirit, 'The Lord said to my Lord, 'Sit at my right hand, until I make your enemies the footstool of your feet.''",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲕⲁ**ⲡⲙⲟⲩ ⲉϥϩⲏⲛ ⲉϩⲟⲩⲛ ⲉⲣⲟⲕ ⲙⲡⲉϩⲟⲟⲩ ⲙⲛⲧⲉⲩϣⲏ",
      "english": "Let death draw nigh unto thee by day and by night,",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲉⲙⲡⲟⲩϣϫⲉⲙϫⲟⲙ ⲛⲉⲛϥ ⲉϧⲟⲩⲛ ⲉⲑⲃⲉⲡⲓⲙⲏϣ ⲁⲩϣⲉ ⲛⲱⲟⲩ ⲉϫⲉⲛⲡϫⲉⲛⲉⲫⲱⲣ ⲁⲩϭⲱⲣⲡ ⲛϯⲟⲩⲁϩⲥⲟⲓ ⲉⲃⲟⲗ ⲛⲧⲉⲡⲓⲏⲓ ⲉⲛⲁⲩ**ⲭⲏ** ⲛϧⲏⲧϥ ⲟⲩⲟϩ ⲉⲧⲁⲩϣⲱⲕⲓ ⲁⲩⲭⲱ ⲙⲡⲓϭⲗⲟϫ ⲉⲡⲉⲥⲏⲧ ⲉⲧⲉⲫⲏ ⲉⲧϣⲏⲗ ⲉⲃⲟⲗ ⲛⲕⲟⲧ ϩⲓⲱⲧϥ .",
      "english": "When they could not come near to him for the crowd, they removed the roof where he was. When they had broken it up, they let down the mat that the paralytic was lying on.",
      "source": "Bohairic Gospel of Mark 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛϥⲧⲓⲭⲁⲣⲓⲥ ⲛⲁⲕ ϩⲓⲡⲁⲣϩⲏⲥⲓⲁ ⲛⲛⲉϩⲟⲟⲩ ⲧⲏⲣⲟⲩ ⲙⲡⲉⲕⲱⲛϩ ⲛϥ**ⲕⲁ** ⲡⲉⲕⲣⲁϣⲉ ϩⲓⲧⲁⲯⲩⲭⲏ ϣⲁⲡⲁϩⲁⲉ ⲛⲛⲉⲓⲃ ·",
      "english": "And may he give you grace and confidence for all the days of your life as he keeps your joy upon my soul until my end of the gaps.",
      "source": "Letter about wheat",
      "urn": "urn:cts:copticDoc:papyri_info.tm82149.cpr_31_14",
      "dialect": "sahidic"
    }
