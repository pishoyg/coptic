  "examples": [
    {
      "coptic": "ⲛⲁⲓ ⲧⲏⲣⲟⲩ ⲉⲧϩⲱⲟⲩ ⲉⲩⲛⲏⲟⲩ ⲉⲃⲟⲗ ⲥⲁϧⲟⲩⲛ ⲟⲩⲟϩ ⲥⲉ**ⲥⲱϥ** ⲙⲡⲓⲣⲱⲙⲓ .",
      "english": "All these evil things come from within, and defile the man.'",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧⲉⲧⲛ**ⲥⲱⲱϥ** ⲙⲡⲉϥⲣⲡⲉ ⲉⲧⲉⲛⲧⲱⲧⲛ ⲡⲉ ⲙⲙⲓⲛⲙⲙⲱⲧⲛ ·",
      "english": "And you defile his temple which is you yourselves.",
      "source": "To Thieving Nuns",
      "urn": "urn:cts:copticLit:besa.thieving.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲡⲁⲓⲣⲏϯ ⲛⲑⲱⲧⲉⲛ ϩⲁⲛⲁⲧⲕⲁϯ ⲛⲑⲱⲧⲉⲛ ⲙⲡⲉⲧⲉⲛⲕⲁϯ ϫⲉϩⲱⲃ ⲛⲓⲃⲉⲛ ⲉⲧⲥⲁⲃⲟⲗ ⲉⲑⲛⲁ ⲉϧⲟⲩⲛ ⲉⲣⲱϥ ⲙⲡⲓⲣⲱⲙⲓ ⲙⲙⲟⲛ ϣϫⲟⲙ ⲙⲙⲱⲟⲩ ⲉ**ⲥⲟϥ**ϥ",
      "english": "He said to them, 'Are you thus without understanding also? Don't you perceive that whatever goes into the man from outside can't defile him,",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲡⲉⲧⲛⲁ**ⲥⲱⲱϥ** ⲙⲡⲉⲣⲡⲉ ⲙⲡⲛⲟⲩⲧⲉ . ⲡⲁⲓ ⲡⲛⲟⲩⲧⲉ ⲛⲁⲧⲁⲕⲟϥ :",
      "english": "“he who will defile the temple of God, that one God will destroy.”",
      "source": "To Thieving Nuns",
      "urn": "urn:cts:copticLit:besa.thieving.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲙⲟⲛ ϩⲗⲓ ⲥⲁⲃⲟⲗ ⲙⲡⲓⲣⲱⲙⲓ ⲉϥⲛⲁ ⲉϧⲟⲩⲛ ⲉⲣⲱϥ ⲉⲟⲩⲟⲛ ϣϫⲟⲙ ⲙⲙⲟϥ ⲉ**ⲥⲟϥ**ϥ ⲁⲗⲗⲁ ⲛⲏ ⲉⲑⲛⲏⲟⲩ ⲉⲃⲟⲗ ϧⲉⲛⲣⲱϥ ⲙⲡⲓⲣⲱⲙⲓ .",
      "english": "There is nothing from outside of the man, that going into him can defile him; but the things which proceed out of the man are those that defile the man.",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϯⲛⲁⲥⲟⲧⲡⲥ ⲛⲁⲓ ⲉⲙⲟⲩ ϩⲛⲟⲩⲙⲟⲩ ⲛϫⲓⲛϭⲟⲛⲥ ⲛϩⲟⲩⲉ ⲉⲩⲙⲁ ⲛⲛⲕⲟⲧⲕ ⲉϥ**ⲥⲟⲟϥ** ·",
      "english": "and I choose to die by a violent death rather than accept a polluted couch.",
      "source": "On Susanna",
      "urn": "urn:cts:copticLit:pschrysostom.susanna.budge:1-63",
      "dialect": "sahidic"
    }
