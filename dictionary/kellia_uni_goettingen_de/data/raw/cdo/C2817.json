  "examples": [
    {
      "coptic": "ⲏ ⲛⲧⲉⲡⲉⲕϩⲏⲧ **ⲡⲱⲗϩ** ⲉⲩⲥⲟⲛ · ⲉⲕϫⲱ ⲙⲙⲟⲥ · ϫⲉⲛϥⲙⲡϣⲁ ⲛⲛⲁⲓ ⲁⲛ ·",
      "english": "or if thy heart hath been wounded by a brother, and thou sayest, 'he is not worth this ';",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲁϩⲉⲣⲁⲧϥ ⲉⲡⲉϣⲗⲏⲗ ⲁϥⲁⲓⲧⲉⲓ ⲉϫⲓⲛⲟⲩⲙⲛⲧϩⲁⲣϣϩⲏⲧ ⲉϫⲙ ⲡⲉϥⲥⲟⲛ , ⲁⲩⲱ ⲉⲡⲁⲣⲁⲅⲉ ⲙⲡⲡⲉⲓⲣⲁⲥⲙⲟⲥ ⲁϫⲙ**ⲡⲱⲗϩ** .",
      "english": "He stood up for prayer and he asked to receive patience with his brother and to pass the test without a blemish.",
      "source": "Apophthegmata Patrum Sahidic 018: Anonymous",
      "urn": "urn:cts:copticLit:ap.18.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉⲧⲛⲁⲛⲉϫⲟⲩⲱⲛⲉ ⲉⲧⲡⲉ ϥⲛⲁϩⲉ ⲉϫⲱϥ ⲟⲩⲡⲗⲏⲅⲏ ⲛⲕⲣⲟϥ ϣⲁⲥⲉⲓⲣⲉ ⲛϩⲛ**ⲡⲱⲗϩ**",
      "english": "Whoso casteth a stone on high casteth it on his own head; and a deceitful stroke shall make wounds.",
