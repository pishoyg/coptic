  "examples": [
    {
      "coptic": "**ⲕⲁⲛ** ⲉϣⲱⲡ ⲁⲕϣⲁⲛϭⲓ ⲙⲡⲉⲕⲉⲣⲛⲟⲃⲓ ⲟⲩⲟϩ ⲉϣⲱⲡ ⲁⲥϣⲁⲛϭⲓ ⲛϫⲉϯⲡⲁⲣⲑⲉⲛⲟⲥ ⲙⲡⲁⲥⲉⲣⲛⲟⲃⲓ ⲉⲩⲉϭⲓ ⲇⲉ ⲛⲟⲩϩⲟϫϩⲉϫ ⲛⲧⲟⲩⲥⲁⲣⲝ ⲛϫⲉⲛⲁⲓ ⲙⲡⲁⲓⲣⲏϯ ⲁⲛⲟⲕ ⲇⲉ ϯϯⲁⲥⲟ ⲉⲣⲱⲧⲉⲛ .",
      "english": "But if you marry, you have not sinned. If a virgin marries, she has not sinned. Yet such will have oppression in the flesh, and I want to spare you.",
      "source": "Bohairic 1 Corinthians 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲕⲁⲛ** ⲉⲕϣⲁⲛϫⲟⲟϥ ⲛⲧⲛⲧⲙⲁⲙⲁϩⲧⲉ ⲙⲙⲟϥ ⲉⲃⲟⲗ",
      "english": "Even if you tell it and we don't understand,",
      "source": "Apophthegmata Patrum Sahidic 138: Unidentified",
      "urn": "urn:cts:copticLit:ap.138.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲟϥ ⲇⲉ ⲛⲁϥⲥⲁϫⲓ ϧⲉⲛⲟⲩⲙⲉⲧϩⲟⲩⲟ ϫⲉ**ⲕⲁⲛ** ⲁⲥϣⲁⲛⲫⲟϩ ⲛⲧⲁⲙⲟⲩ ⲛⲉⲙⲁⲕ ⲛⲛⲁϫⲟⲗⲕ ⲉⲃⲟⲗ ⲡⲁⲓⲣⲏϯ ⲇⲉ ⲟⲛ ⲛⲁⲩϫⲱ ⲙⲙⲟⲥ ⲧⲏⲣⲟⲩ .",
      "english": "But he spoke all the more, 'If I must die with you, I will not deny you.' They all said the same thing.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲕⲁⲛ** ⲉⲩϣⲁⲛⲱⲛϩ ·",
      "english": "or whether they live,",
      "source": "Mysteries of John the Evangelist part 2",
      "urn": "urn:cts:copticLit:misc.mysteries_john.budge:13-28",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲓⲙⲁ ⲉϣⲁϥϣⲉ ⲛⲁϥ ⲉϧⲟⲩⲛ ⲉⲣⲟϥ ⲉⲛⲓϯⲙⲓ ⲓⲉ ⲛⲓⲃⲁⲕⲓ ⲓⲉ ⲛⲓⲓⲟϩⲓ ⲛⲁⲩⲭⲱ ⲛⲛⲏ ⲉⲧϣⲱⲛⲓ ϩⲓⲛⲓⲁⲅⲟⲣⲁ ⲟⲩⲟϩ ⲛⲁⲩϯϩⲟ ⲉⲣⲟϥ ϩⲓⲛⲁ **ⲕⲁⲛ** ⲛⲧⲟⲩϭⲓ ⲛⲉⲙⲡⲓϣⲧⲁϯ ⲛⲧⲉⲛⲉϥϩⲃⲱⲥ ⲟⲩⲟϩ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉϣⲁⲩϭⲓ ⲛⲉⲙⲁϥ ϣⲁⲩⲟⲩϫⲁⲓ .",
      "english": "Wherever he entered, into villages, or into cities, or into the country, they laid the sick in the marketplaces, and begged him that they might touch just the fringe of his garment; and as many as touched him were made well.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲛ **ⲕⲁⲛ** ⲉⲛϣⲁⲛⲉⲓⲣⲉ ⲛⲟⲩⲙⲛⲧϣⲁϥⲧⲉ ϩⲛⲟⲩⲙⲛⲧⲁⲧⲥⲟⲟⲩⲛ · ϩⲛⲟⲩϫⲡⲓⲟ ⲛⲧⲛϫⲡⲓⲟ ⲛⲛⲉⲛⲉⲣⲏⲩ ⲉⲧⲣⲉⲛⲙⲉⲧⲁⲛⲟⲉⲓ ·",
      "english": "our companions so that we repent,",
      "source": "Abraham Our Father YA 551-54",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbya:42-47",
      "dialect": "sahidic"
    }
