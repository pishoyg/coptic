  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲥⲉ**ϥⲁⲓ** ⲙⲙⲟϥ ϩⲓⲧⲟⲩⲛⲁϩⲃⲓ ⲟⲩⲟϩ ⲥⲉⲙⲟϣⲓ ⲉϣⲱⲡ ⲇⲉ ⲛⲧⲟⲩⲭⲁϥ ⲉⲡⲉⲥⲏⲧ ϣⲁϥⲟϩⲓ ⲙⲡⲉϥⲙⲁ ⲟⲩⲟϩ ⲙⲡⲉϥⲕⲓⲙ ⲟⲩⲟϩ ⲫⲏⲉⲑⲛⲁⲱϣ ⲉⲡϣⲱⲓ ϩⲁⲣⲟϥ ⲙⲡⲉϥⲥⲱⲧⲉⲙ ⲉⲣⲟϥ ⲟⲩⲇⲉ ⲛⲛⲉϥⲛⲁϩⲙⲉϥ ⲉⲃⲟⲗϩⲁ ϩⲁⲛⲡⲉⲧϩⲱⲟⲩ .",
      "english": "They bear it upon the shoulder, and go; and if they put it upon its place, it remains, it cannot move: and whosoever shall cry to it, it cannot hear; it cannot save him from trouble.",
      "source": "23_Isaias_46",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:46",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲉⲓⲛⲉ ⲇⲉ ⲉⲣⲁⲧϥ ⲛⲟⲩⲣⲱⲙⲉ ⲉϥⲥⲏϭ ⲉⲣⲉϥⲧⲟⲟⲩ ⲛⲣⲱⲙⲉ **ϥⲓ** ϩⲁⲣⲟϥ",
      "english": "Four people came, carrying a paralytic to him.",
      "source": "41_Mark_2",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲉⲛ ⲑⲏⲛⲟⲩ ⲉⲃⲟⲗ ϩⲉⲛ ⲑⲏⲛⲟⲩ ⲉⲃⲟⲗ ⲁⲙⲱⲓⲛⲓ ⲉⲃⲟⲗϧⲉⲛ ⲧⲉⲥⲙⲏϯ ⲟⲩⲟϩ ⲫⲱⲣϫ ⲉⲃⲟⲗ ⲛⲏⲉⲧ**ϥⲁⲓ** ⲛⲛⲓⲥⲕⲉⲩⲟⲥ ⲛⲧⲉⲡϭⲥ .",
      "english": "Depart ye, depart, go out from thence, and touch not the unclean thing; go ye out from the midst of her; separate yourselves, ye that bear the vessels of the Lord.",
      "source": "23_Isaias_52",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:52",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲓⲙ ⲡⲉ ⲛⲧⲁϥ**ϥⲓ** ⲙⲡⲁϩⲏⲃⲥ ⲛϩⲏⲧ ·",
      "english": "Who hath carried away the light of my body?",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲉⲛϣⲏⲣⲓ ⲛⲅⲁⲁⲑ ⲙⲡⲉϥϯ ⲛⲱⲟⲩ ϫⲉⲟⲩⲏⲓ ⲛⲓϣⲉⲙϣⲓ ⲛⲧⲉⲡⲉⲑⲟⲩⲁⲃ ⲉⲧⲉⲛⲧⲟⲧⲟⲩ ⲉⲩ**ϥⲁⲓ** ⲙⲙⲱⲟⲩ ϩⲓⲧⲟⲩⲛⲁϩⲃⲓ",
      "english": "But to the sons of Caath he gave them not, because they have the ministrations of the sacred things: they shall bear them on their shoulders.",
