  "examples": [
    {
      "coptic": "ϯⲉⲣⲭⲣⲉⲱⲥⲧⲓⲛ ⲅⲁⲣ ϧⲉⲛⲟⲩⲛⲓϣϯ ⲛⲭⲣⲉⲟⲥ ⲁⲗⲗⲁ ⲡⲓⲇⲁⲛⲓⲥⲧⲏⲥ **ϣⲑⲟⲣⲧⲉⲣ** ⲁⲛ ϧⲉⲛⲛⲉϥϩⲃⲏⲟⲩⲓ .",
      "english": "I owe a great debt, but the creditor is not disturbed in his deeds.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲛⲧⲁϥⲛⲁϩⲙⲉⲧ · ⲁⲩⲱ ⲁϥⲛⲟⲩϫⲉ ⲉⲃⲟⲗ ⲛϩⲏⲧ · ⲙⲡⲉⲧ**ϣⲧⲟⲣⲧⲣ** ⲙⲙⲟⲓ ·",
      "english": "Thou it was Who didst deliver me, and' didst east out from my heart that which disturbed me sorely.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲙⲟⲓ ⲛⲥⲉϫⲱϫⲓ ⲉⲃⲟⲗ ⲛϫⲉⲛⲏ ⲉⲧ**ϣⲑⲟⲣⲧⲉⲣ** ⲙⲙⲱⲧⲉⲛ .",
      "english": "I wish that those who disturb you would cut themselves off.",
      "source": "09_Galathians_05",
      "urn": "urn:cts:copticLit:nt.gal.bohairic:05",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲛ ⲉⲩⲉⲓⲛⲉ ⲙⲙⲟⲓ ⲉⲡⲉⲥⲏⲧ ⲉⲩⲑⲃⲃⲓⲟ ⲙⲡⲓ**ϣⲧⲟⲣⲧⲣ** .",
      "english": "And I am also not disturbed, having been brought down by humility.",
      "source": "Apophthegmata Patrum Sahidic 136",
      "urn": "urn:cts:copticLit:ap.136.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲓ ⲉϧⲟⲩⲛ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲉⲑⲃⲉⲟⲩ ⲧⲉⲧⲉⲛ**ϣⲧⲉⲣⲑⲱⲣ** ⲟⲩⲟϩ ⲧⲉⲧⲉⲛⲣⲓⲙⲓ ⲙⲡⲉⲥⲙⲟⲩ ⲛϫⲉϯⲁⲗⲟⲩ ⲁⲗⲗⲁ ⲁⲥⲛⲕⲟⲧ",
      "english": "When he had entered in, he said to them, 'Why do you make an uproar and weep? The child is not dead, but is asleep.'",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲩⲟⲛ ⲛⲓⲙ ⲉⲧϩⲙⲡⲧⲟⲡⲟⲥ ϣⲁϥ**ϣⲧⲣⲧⲱⲣ**ⲟⲩ ⲻ",
      "english": "and he shall disturb everyone in this place.'",
      "source": "Apophthegmata Patrum Sahidic 056: Daniel 6",
      "urn": "urn:cts:copticLit:ap.56.monbeg",
      "dialect": "sahidic"
    }
  ],
