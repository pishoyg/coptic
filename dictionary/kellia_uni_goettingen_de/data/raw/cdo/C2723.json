  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲥⲁⲙⲁϩⲓ **ⲛϫⲉ**ϯⲥⲟⲫⲓⲁ ⲉⲃⲟⲗ ϧⲉⲛⲛⲉⲥϩⲃⲏⲟⲩⲓ .",
      "english": "Thus, Wisdom was fulfilled by its deeds.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲥϫⲟⲟⲥ **ⲛϭⲓ**ⲧⲙⲁⲕⲁⲣⲓⲁ ⲥⲩⲅⲕⲗⲏⲧⲓⲕⲏ",
      "english": "The blessed Syncletica said,",
      "source": "Apophthegmata Patrum Sahidic 121: Syncletica 26",
      "urn": "urn:cts:copticLit:ap.121.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉ ⲥⲱⲧⲉⲙ ϩⲏⲡⲡⲉ ⲁϥⲓ **ⲛϫⲉ**ⲫⲏ ⲉⲧⲥⲓϯ .",
      "english": "Listen! Behold, the farmer went out to sow,",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲛⲁⲩ **ⲛϭⲓ**ⲡϩⲗⲗⲟ",
      "english": "The old man told them:",
      "source": "Apophthegmata Patrum Sahidic 114: Theophilus Beta",
      "urn": "urn:cts:copticLit:ap.114.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲁⲓ ⲇⲉ ⲉⲩⲉⲣⲙⲉⲑⲣⲉ ϧⲁⲣⲟϥ **ⲛϫⲉ**ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲑⲃⲉ ⲛⲉϥⲁⲣⲉⲧⲏ .",
      "english": "Everyone testified to his virtues.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
