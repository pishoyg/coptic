      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲛⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲕⲱ ⲛⲁⲓ **ⲉⲃⲟⲗ** ⲻ",
      "english": "But he said, 'Forgive me.'",
      "source": "Apophthegmata Patrum Sahidic 119: Sisoes 16",
      "urn": "urn:cts:copticLit:ap.119.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲁⲓ ⲣⲏϯ ⲁϥⲓ **ⲉⲃⲟⲗ** ϩⲓⲧⲉⲛⲛⲉϥⲓⲟϯ ⲁϥϩⲱⲗ ⲉⲡϣⲁϥⲉ .",
      "english": "Thus he left his parents and went into the desert.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲁϥϫⲱⲕ **ⲉⲃⲟⲗ** ⲛⲛⲉⲩⲁⲓⲧⲏⲙⲁ ⲧⲏⲣⲟⲩ ·",
      "english": "filling all their requests,",
      "source": "Abraham Our Father: YA 518-20",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbya:1-4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲥⲁⲙⲁϩⲓ ⲛϫⲉϯⲥⲟⲫⲓⲁ **ⲉⲃⲟⲗ** ϧⲉⲛⲛⲉⲥϩⲃⲏⲟⲩⲓ .",
      "english": "Thus, Wisdom was fulfilled by its deeds.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲁⲣⲉⲡⲛⲟⲩⲧⲉ ⲕⲁⲁⲩ ⲛⲁⲓ **ⲉⲃⲟⲗ**",
      "english": "May God forgive me these!'",
