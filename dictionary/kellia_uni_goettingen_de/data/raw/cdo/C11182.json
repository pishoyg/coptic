  "examples": [
    {
      "coptic": "ⲫⲏ ⲅⲁⲣ ⲉⲑⲛⲁϣⲓⲡⲓ ⲉⲟⲩⲟⲛϩⲧ ⲉⲃⲟⲗ ⲛⲉⲙⲛⲁⲥⲁϫⲓ ϧⲉⲛⲡⲁⲓϫⲱⲟⲩ ⲛⲛⲱⲓⲕ ⲟⲩⲟϩ ⲛⲣⲉϥⲉⲣⲛⲟⲃⲓ ⲡϣⲏⲣⲓ ϩⲱϥ ⲙⲫⲣⲱⲙⲓ ⲛⲁϯϣⲓⲡⲓ ⲛⲁϥ **ϩⲟⲧⲁⲛ** ⲁϥϣⲁⲛⲓ ϧⲉⲛⲡⲱⲟⲩ ⲛⲧⲉⲡⲉϥⲉⲓⲱⲧ ⲛⲉⲙⲛⲉϥⲁⲅⲅⲉⲗⲟⲥ ⲉⲑⲟⲩⲁⲃ .",
      "english": "For whoever will be ashamed of me and of my words in this adulterous and sinful generation, the Son of Man also will be ashamed of him, when he comes in the glory of his Father with the holy angels.'",
      "source": "Bohairic Gospel of Mark 8 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:8",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧϩⲉ ⲉⲧⲉϣⲁⲩⲣⲱϩⲧ ⲉⲡⲉⲥⲏⲧ ⲏ ⲛⲥⲉⲡⲱⲧ ⲉϩⲟⲩⲛ ⲉⲡⲕⲁⲕⲉ · ⲏ ⲉϩⲣⲁⲓ ⲉϩⲉⲛⲙⲁ ⲉⲩϣⲟⲕϩ ⲛϭⲓϩⲉⲛⲛⲩⲕⲧⲉⲣⲓⲥ ⲉⲧⲉϭⲓⲛϭⲗⲱ ⲡⲉ · **ϩⲟⲧⲁⲛ** ⲉⲩϣⲁⲛⲛⲁⲩ ⲉⲡⲟⲩⲟⲉⲓⲛ ⲙⲡϣⲁϩ ⲛϩⲉⲛϩⲏⲃⲥ ⲙⲛⲡⲟⲩⲟⲉⲓⲛ ⲙⲡⲉϩⲟⲟⲩ ·",
      "english": "And like those who are struck down or run in to the darkness or places where bats are dug deep, namely bats, whenever they see the light of the lamps&apos; flame and the light of day,",
      "source": "Acephalous 22: YA 421-28",
      "urn": "urn:cts:copticLit:shenoute.a22.monbya:1251-1258",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲙⲏⲛ ϯϫⲱ ⲙⲙⲟⲥ ⲛⲱⲧⲉⲛ ϫⲉⲛⲛⲁⲥⲱ ⲉⲃⲟⲗ ϧⲉⲛⲡⲟⲩⲧⲁϩ ⲛⲧⲉⲧⲁⲓⲃⲱ ⲛⲁⲗⲟⲗⲓ ϣⲁⲡⲓⲉϩⲟⲟⲩ ⲉⲧⲧⲏ **ϩⲟⲧⲁⲛ** ⲁⲓϣⲁⲛⲥⲟϥ ⲙⲃⲉⲣⲓ ϧⲉⲛϯⲙⲉⲧⲟⲩⲣⲟ ⲛⲧⲉⲫⲛⲟⲩϯ .",
      "english": "Most certainly I tell you, I will no more drink of the fruit of the vine, until that day when I drink it anew in the Kingdom of God.'",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ϩⲟⲧⲁⲛ** ⲉⲕϣⲁⲛⲧⲃⲃⲟⲛ · ⲧⲟⲧⲉ ⲧⲛⲛⲁⲛⲁⲩ ⲉⲣⲟⲕ ϩⲙⲡⲥⲱⲙⲁ ⲙⲁⲩⲁⲁϥ · ⲡⲁⲓ ⲛⲧⲁⲕⲁⲁϥ ⲛⲃⲣⲣⲉ ϩⲛⲟⲩⲙⲛⲧⲁⲥ ·",
      "english": "When Thou shalt have purified us, then we shall see Thee alone in the body which Thou hast changed from oldness into newness.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲉⲛⲏⲟⲩ ⲇⲉ ⲛϫⲉϩⲁⲛⲉϩⲟⲟⲩ **ϩⲟⲧⲁⲛ** ⲁⲩϣⲁⲛⲱⲗⲓ ⲙⲡⲓⲡⲁⲧϣⲉⲗⲉⲧ ⲛⲧⲟⲧⲟⲩ ⲧⲟⲧⲉ ⲥⲉⲛⲁⲉⲣⲛⲏⲥⲧⲉⲩⲓⲛ ϧⲉⲛⲛⲓⲉϩⲟⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ",
      "english": "But the days will come when the bridegroom will be taken away from them, and then they will fast in that day.",
      "source": "Bohairic Gospel of Mark 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲛϩⲉⲛϩⲟⲟⲩ ⲇⲉ ⲛⲏⲩ **ϩⲟⲧⲁⲛ** ⲉⲩϣⲁⲛϥⲓ ⲛⲧⲟⲟⲧⲟⲩ ⲙⲡⲁⲧϣⲉⲗⲉⲉⲧ ⲧⲟⲧⲉ ⲥⲉⲛⲁⲛⲏⲥⲧⲉⲩⲉ ϩⲛⲛⲉϩⲟⲟⲩ ⲉⲧⲙⲙⲁⲩ",
      "english": "But the days will come when the bridegroom will be taken away from them, and then will they fast in that day.",
      "source": "41_Mark_2",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:2",
