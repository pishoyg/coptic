  "examples": [
    {
      "coptic": "ⲡⲛⲟⲩⲃ ⲅⲁⲣ ⲙⲛⲡϩⲁⲧ ⲛⲁⲣϣⲓⲃⲉ · ⲛϩⲟⲉⲓⲧⲉ ⲛⲁ**ⲣϩⲟⲟⲗⲉ** · ⲡⲣⲱⲙⲉ ⲛⲁⲙⲟⲩ ⲛϥⲣϭⲁⲓⲉ ϩⲛⲛⲧⲁⲫⲟⲥ · ⲛⲧⲉⲡⲉϥⲣⲡⲙⲉⲉⲩⲉ ⲧⲁⲕⲟϥ ϩⲓϫⲙⲡⲕⲁϩ · ⲡⲇⲓⲕⲁⲓⲟⲥ ⲇⲉ ⲛⲧⲟϥ ⲛⲁⲕⲓⲙ ⲁⲛ ϣⲁⲉⲛⲉϩ :—",
      "english": "For gold and silver rust, (fine) raiment becometh moth-eaten and falleth into holes,- a man dieth and he turneth into corruption in the tomb, and the remembrance of him perisheth on the earth; but the righteous man shall never be moved.",
      "source": "Martyrdom of Victor part 4",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:23-32",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲛⲉϣⲁϥⲟⲩⲱϣⲃ ⲉϥϫⲱ ⲙⲙⲟⲥ · ϫⲉⲛϩⲟⲓⲧⲉ ⲛⲁ**ⲣϩⲟⲟⲗⲉ** ·",
      "english": "But he was wont to make answer [unto them], saying, ' Apparel becometh moth-eaten,",
      "source": "Martyrdom of Victor part 2",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:7-12",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲁⲓ ⲉϣⲁⲩϩⲓⲧⲉ ⲛⲧϩⲉ ⲛⲛⲉⲓⲁⲥⲕⲱⲥ ⲏ ⲛⲧϩⲉ ⲛⲟⲩϩⲟⲓⲧⲉ ⲉⲁϥ**ⲣϩⲟⲟⲗⲉ**",
      "english": "I am as that which waxes old like a bottle, or like a moth-eaten garment.",
      "source": "Job 13",
