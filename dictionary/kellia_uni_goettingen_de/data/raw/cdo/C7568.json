      "coptic": "ϣⲁⲣⲉⲧ**ⲙⲛⲧϭⲁⲃϩⲏⲧ** · ⲙⲟϩⲕ ⲛⲗⲟⲓϭⲉ · ⲙⲙⲛⲧⲣϥϫⲛⲁⲁⲩ · ϩⲓⲙⲛⲧⲁⲧⲛⲁϩⲧⲉ ϩⲓⲙⲛⲧⲁⲙⲉⲗⲏⲥ · ϣⲁⲛⲧⲉⲕⲱϫⲛ ·",
      "english": "Timidity of heart filleth thee with excuses for sloth, and unbelief, and carelessness, until thou art destroyed.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉⲁϥⲧⲱⲃⲁϩ ⲅⲁⲣ ⲙⲡϫⲟⲉⲓⲥ ⲉⲧⲣⲉϥϥⲓ ⲉⲃⲟⲗ ⲙⲙⲟϥ ⲛⲧ**ⲙⲛⲧϭⲁⲃϩⲏⲧ** .",
      "english": "For he had entreated the Lord to take fear away from him.",
      "source": "Apophthegmata Patrum Sahidic 035",
      "urn": "urn:cts:copticLit:ap.35.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲱⲕ ⲟⲩⲛ ⲙⲙⲟⲕ ⲛⲅⲣϫⲱⲱⲣⲉ ⲁϩⲣⲟⲕ ⲙⲛⲧ**ⲙⲛⲧϭⲁⲃϩⲏⲧ** ⲙⲡⲇⲓⲁⲃⲟⲗⲟⲥ ·",
      "english": "Be thou of good cheer then, play the man; what hast thou, to do with the sluggishness of the Devil?",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
