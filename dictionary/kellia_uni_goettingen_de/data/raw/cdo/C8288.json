  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲓⲉⲥⲱϫⲡ ⲉⲃⲟⲗ ⲛϧⲏⲧⲟⲩ ⲛϩⲁⲛⲣⲱⲙⲓ ϧⲉⲛⲟⲩⲏⲡⲓ ϧⲉⲛⲧⲥⲏϥⲓ ⲛⲉⲙⲫⲙⲟⲩ ⲛⲉⲙⲡⲓϩⲃⲱⲛ ϩⲓⲛⲁ ⲉⲩⲉⲙⲟⲩⲛⲕ ⲛⲛⲟⲩ**ⲁⲛⲟⲙⲓⲁ** ⲧⲏⲣⲟⲩ ϧⲉⲛⲛⲓⲉⲑⲛⲟⲥ ⲡⲓⲙⲁ ⲉϣⲁⲩϣⲉ ⲉϧⲟⲩⲛ ⲉⲣⲟϥ ⲟⲩⲟϩ ⲛⲧⲟⲩⲉⲙⲓ ϫⲉⲁⲛⲟⲕ ⲡⲉ ⲡϭⲥ .",
      "english": "And the word of the Lord came to me, saying,",
      "source": "26_Ezechiel_12",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲱⲙ ϭⲉ ⲉⲣⲛ**ⲁⲛⲟⲙⲓⲁ** ⲛⲓⲙ ·",
      "english": "Therefore, curb every lawlessness.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲛⲏⲓ ϫⲉⲡϣⲏⲣⲓ ⲙⲫⲣⲱⲙⲓ ⲁⲕⲛⲁⲩ ⲙⲏ ϩⲁⲛⲕⲟⲩϫⲓ ⲛⲉ ⲛⲁⲓ ⲙⲡⲏⲓ ⲛⲓⲟⲩⲇⲁ ⲉⲑⲣⲟⲩⲓⲣⲓ ⲛⲛⲓⲁⲛⲟⲙⲓⲁ ⲉⲧⲁⲩⲁⲓⲧⲟⲩ ϧⲉⲛⲡⲁⲓⲙⲁ ⲉⲑⲃⲉϫⲉⲁⲩⲙⲟϩ ⲙⲡⲓⲕⲁϩⲓ ⲛ**ⲁⲛⲟⲙⲓⲁ** ⲟⲩⲟϩ ϩⲏⲡⲡⲉ ⲛⲑⲱⲟⲩ ⲉⲩⲉⲗⲕϣⲁⲓ .",
      "english": "And he said to me, Son of man, thou hast seen this. Is it a little thing to the house of Juda to practise the iniquities which they have practised here? for they have filled the land with iniquity: and, behold, these are as scorners.",
      "source": "26_Ezechiel_08",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:08",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩ**ⲁⲛⲟⲙⲓⲁ** ⲧⲉ ·",
      "english": "It is lawlessness.",
      "source": "I See Your Eagerness: GL 29-30",
      "urn": "urn:cts:copticLit:shenoute.eagerness.monbgl_29_30",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲑⲁⲩ . ⲁⲥⲙⲟⲩⲛⲕ ⲛϫⲉⲧⲉⲁⲛⲟⲙⲓⲁ ⲧϣⲉⲣⲓ ⲛⲥⲓⲱⲛ ⲛⲛⲉϥⲟⲩⲁϩⲧⲟⲧϥ ϫⲉⲉⲟⲩⲟⲑⲃⲓ ⲉⲃⲟⲗ ⲁϥϫⲉⲙⲡϣⲓⲛⲓ ⲛⲛⲉ**ⲁⲛⲟⲙⲓⲁ** ⲧϣⲉⲣⲓ ⲛⲉⲇⲱⲙ ⲁϥϭⲱⲣⲡ ⲛⲛⲉⲙⲉⲧⲁⲥⲉⲃⲏⲥ ⲉⲃⲟⲗ .",
      "english": "THAU. O daughter of Sion, thine iniquity has come to an end; he shall no more carry thee captive: he has visited thine iniquities, O daughter of Edom; he has discovered thy sins.",
      "source": "25_Lamentationes_04",
      "urn": "urn:cts:copticLit:ot.lam.bohairic_ed:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲥⲉ ⲥϩⲟⲩⲟⲣⲧ ⲛϭⲓⲟⲩⲟⲛ ⲛⲓⲙ ⲉⲧⲉⲓⲣⲉ ⲛϩⲉⲛⲕⲣⲟϥ ϩⲣⲁⲓ ϩⲛⲥⲩⲛⲁⲅⲱⲅⲏ ⲧⲏⲣⲟⲩ ⲙⲡϫⲟⲉⲓⲥ · ⲉⲧⲣⲉⲡⲛⲟⲩⲧⲉ ϭⲱⲛⲧ ⲉⲩⲛⲟϭ ⲙⲙⲏⲏϣⲉ ⲛϥⲕⲧⲟ ⲙⲡⲉϥϩⲟ ⲉⲃⲟⲗ ⲙⲙⲟⲟⲩ ϩⲛⲟⲩⲟⲣⲅⲏ ⲉⲧⲃⲉⲧⲙⲛⲧϣⲁϥⲧⲉ ⲛⲛⲉⲧⲉⲓⲣⲉ ⲛⲧ**ⲁⲛⲟⲙⲓⲁ** ϩⲛⲟⲩϩⲱⲡ ⲏ ϩⲛⲟⲩⲱⲛϩ ⲉⲃⲟⲗ ϩⲣⲁⲓ ⲛϩⲏⲧⲛ ·",
      "english": "They are all accursed who practice deceit in any assembly of the Lord, so that God is angry with a great many people and turns His face from them in anger because of the iniquities of those among us who practice wrongful deeds, covertly or overtly.",
      "source": "Acephalous 22: YA 421-28",
      "urn": "urn:cts:copticLit:shenoute.a22.monbya:1251-1258",
      "dialect": "sahidic"
    }
