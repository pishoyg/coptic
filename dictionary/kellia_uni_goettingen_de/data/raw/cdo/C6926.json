  "examples": [
    {
      "coptic": "ⲡϫⲁϫⲉ ⲡⲉ ⲛⲣⲱⲙⲉ ⲛⲓⲙ · ⲡⲉⲓⲑⲏⲣⲓⲟⲛ ⲉⲧϩⲟⲟⲩ ⲛⲣⲉϥⲙⲉⲩⲧⲯⲩⲭⲏ · ⲡⲉⲓϩⲁⲗⲏⲧ ⲛⲣⲉϥⲧⲱⲣⲡ · ⲡⲉⲓϩⲟϥ ⲛⲣⲉϥⲗⲱⲕⲥ · ⲡⲕⲱϩⲧ ⲛⲣⲉϥⲣⲱⲕϩ · ⲡⲉⲓⲥⲟⲟⲛⲉ ⲛⲣⲉϥⲥⲩⲗⲁ ⲛⲛⲉⲯⲩⲭⲏ · ⲧⲏⲣⲟⲩ · ⲡⲛⲟⲃⲉ ⲡⲉⲓⲃⲁⲣⲃⲁⲣⲟⲥ ⲛ**ⲣⲉϥϩⲱⲧⲃ** · ⲡⲉⲓⲗⲏⲙⲏⲛ ⲉⲧϣⲧⲣⲧⲱⲣ ·",
      "english": "It is the Enemy of every man, this evil beast which slayeth the soul, this bird which snatcheth greedily at its prey, this serpent which biteth, this fire which blazeth fiercely, this thief who carrieth off all souls (into) sin, this murderous barbarian, this troubled pool,",
      "source": "On the End of the World and on Temple of Solomon",
      "urn": "urn:cts:copticLit:psbasil.temple.budge:1-47",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲛⲟⲩⲙⲏⲏϣⲉ ⲛ**ⲣⲉϥϩⲱⲧⲃ** ϩⲓⲣⲉϥⲡⲉ ϩⲧⲥⲛⲟϥ ⲉⲃⲟⲗ ⲛⲁϣⲱⲡⲉ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧϥ",
      "english": "and many murders and sheddings of blood shall come forth from his hand.",
      "source": "Discourse on Abbaton part 1",
      "urn": "urn:cts:copticLit:pstimothy.abbaton.budge:1-21",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲙⲁ ⲙⲡⲱⲧ ⲉⲣⲟϥ ⲙⲡ**ⲣⲉϥϩⲱⲧⲃ** ⲡⲉⲛⲧⲁϥⲣⲱϩⲧ ⲛⲟⲩⲯⲩⲭⲏ ⲉϩⲛⲁϥ ⲁⲛ ⲁⲩⲱ ⲛⲉⲓⲡⲟⲗⲓⲥ ⲉⲩⲉϣⲱⲡⲉ ⲛⲏⲧⲛ ⲙⲙⲁ ⲙⲡⲱⲧ ⲉⲣⲟⲟⲩ",
      "english": "Even a refuge to the slayer who has smitten a man unintentionally; and the cities shall be to you a refuge, and the slayer shall not be put to death by the avenger of blood, until he have stood before the congregation for judgment.",
