  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ϭⲓ ⲉⲃⲟⲗϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲉⲙⲙⲁⲩ ⲛⲟⲩⲕⲟⲩϫⲓ ⲛⲏⲡⲓ ⲙⲟⲣⲟⲩ ϧⲉⲛⲡⲓϣⲧⲁϯ ⲛⲧⲉⲡⲉⲕ**ϩⲃⲱⲥ** .",
      "english": "And thou shalt take thence a few in number, and shalt wrap them in the fold of thy garment.",
      "source": "26_Ezechiel_05",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:05",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲕⲁⲧⲉⲧⲛ**ϩⲃⲥⲱ** ⲉⲥⲡⲣⲓⲱⲟⲩ ·",
      "english": "Let your apparel be splendid.",
      "source": "The Asceticon of Apa Ephrem part 1",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁⲩϯϩⲟ ⲉⲣⲟϥ ⲡⲉ ϩⲓⲛⲁ ⲙⲟⲛⲟⲛ ⲛⲥⲉϭⲓ ⲛⲉⲙⲡϣⲧⲁϯ ⲛⲧⲉⲛⲉϥ**ϩⲃⲱⲥ** ⲟⲩⲟϩ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲧⲁⲩϭⲓ ⲁⲩⲛⲟϩⲉⲙ .",
      "english": "and they begged him that they might just touch the fringe of his garment. As many as touched it were made whole.",
      "source": "01_Matthew_14",
      "urn": "urn:cts:copticLit:nt.matt.bohairic:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲇⲉ ⲧⲟⲃⲧⲃ ⲟⲩⲇⲉ ⲙⲉϥϣⲟⲩϣⲟⲩ ⲙⲙⲟϥ ϩⲛⲟⲩ**ϩⲃⲥⲱ** ⲛϩⲟⲉⲓⲧⲉ ⲉⲛⲉϩ ·",
      "english": "He did not decorate his person, and he did not adorn himself with rich apparel and fine raiment.",
      "source": "Martyrdom of Victor part 1",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:1-6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲥⲧⲟⲗⲏ ⲛⲓⲃⲉⲛ ⲉⲁⲩⲑⲟⲩⲱⲧⲟⲩ ϧⲉⲛⲡⲭⲣⲟϥ ⲛⲉⲙ**ϩⲃⲱⲥ** ⲛⲓⲃⲉⲛ ⲉⲩⲉⲧⲟⲃⲟⲩ ϧⲉⲛⲟⲩϩⲱⲧⲡ ⲟⲩⲟϩ ⲥⲉⲛⲁⲟⲩⲱϣ ⲉⲁⲩⲣⲟⲕϩⲟⲩ ϧⲉⲛⲡⲓⲭⲣⲱⲙ .",
      "english": "For they shall compensate for every garment that has been acquired by deceit, and all raiment with restitution; and they shall be willing, even if they were burnt with fire.",
