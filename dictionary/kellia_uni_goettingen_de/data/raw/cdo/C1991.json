  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲣⲉϩⲁⲛⲭⲗⲟⲙ ⲛⲟⲩⲑⲟ ⲛⲣⲏϯ ϣⲱⲡⲓ ϩⲓϫⲉⲛⲛⲟⲩⲁⲫⲏⲟⲩⲓ ⲟⲩⲟϩ ϩⲁⲛⲁⲕⲏⲥ ⲛⲟⲩⲑⲟ ⲛⲣⲏϯ ⲉⲩⲉϣⲱⲡⲓ ⲉⲩ**ⲙⲏⲣ** ϩⲓϫⲉⲛⲧⲟⲩϯⲡⲓ ⲉⲛⲁⲩⲙⲟⲩⲣ ⲙⲙⲱⲟⲩ ϧⲉⲛⲧⲟⲩϥⲟϯ ⲁⲛ .",
      "english": "And they shall have linen mitres upon their heads, and shall have linen drawers upon their loins; and they shall not tightly gird themselves.",
      "source": "26_Ezechiel_44",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:44",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϫⲉⲁⲓⲧⲣⲉⲩ**ⲙⲟⲩⲣ** ⲙⲡⲉⲕⲥⲱϣ ⲙⲛⲡⲉⲕϣⲓⲡⲉ ⲉϩⲟⲩⲛ ⲉⲛⲟⲩⲉϭⲣⲟ ⲙⲡⲉⲕⲏⲓ",
      "english": "and since I have had them bind your contempt and your shame to the gateposts of your house,",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲙⲏⲣ** ⲑⲏⲛⲟⲩ ⲟⲩⲟϩ ⲛⲉϩⲡⲓ ⲛⲓⲟⲩⲏⲃ ⲁⲣⲓϩⲏⲃⲓ ⲛⲏⲉⲧϣⲉⲙϣⲓ ⲙⲡⲓⲙⲁⲛⲉⲣϣⲱⲟⲩϣⲓ ⲙⲁϣⲉⲛⲱⲧⲉⲛ ⲉϧⲟⲩⲛ ⲉⲛⲕⲟⲧ ϧⲉⲛϩⲁⲛⲥⲟⲕ ⲛⲏⲉⲧϣⲉⲙϣⲓ ⲙⲫⲛⲟⲩϯ ϫⲉⲁϥⲕⲏⲛ ⲉⲃⲟⲗϧⲉⲛ ⲡⲏⲓ ⲙⲡϭⲟⲉⲓⲥ ⲡⲉⲧⲉⲛⲛⲟⲩϯ ⲛϫⲉⲟⲩϣⲟⲩϣⲱⲟⲩϣⲓ ⲛⲉⲙⲟⲩⲱⲧⲉⲛ ⲉⲃⲟⲗ .",
      "english": "Gird yourselves with sackcloth, and lament, ye priests: mourn, ye that serve at the altar: go in, sleep in sackcloths, ye that minister to God: for the meat-offering and drink-offering are withheld from the house of your God.",
      "source": "29_Ioel_01",
      "urn": "urn:cts:copticLit:ot.joel.bohairic_ed:01",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϥϣⲟⲟⲡ ϩⲛⲛⲉⲙϩⲁⲟⲩ ⲉⲙⲡⲉϣⲗⲁⲁⲩ ϭⲉ ϭⲙϭⲟⲙ ⲉ**ⲙⲟⲣ**ϥ ϩⲛϩⲁⲗⲩⲥⲓⲥ ⲉⲃⲟⲗ",
      "english": "He lived in the tombs. Nobody could bind him any more, not even with chains,",
      "source": "Mark Chapter 5",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲱⲙⲧ ⲟⲩⲟϩ ⲁⲣⲓⲙⲕⲁϩⲛϩⲏⲧ ⲛⲏⲉⲧϩⲑⲏⲟⲩ ⲭⲏ ⲟⲩⲟϩ ϣⲱⲡⲓ ⲉⲣⲉⲧⲉⲛⲃⲏϣ **ⲙⲏⲣ** ⲑⲏⲛⲟⲩ ⲛϩⲁⲛⲥⲟⲕ ϩⲓϫⲉⲛⲛⲉⲧⲉⲛϯⲡⲓ .",
      "english": "Be amazed, be pained, ye confident ones: strip you, bare yourselves, gird your loins;",
      "source": "23_Isaias_32",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:32",
      "dialect": "bohairic"
    },
