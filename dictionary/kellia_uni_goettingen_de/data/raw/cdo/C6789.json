  "examples": [
    {
      "coptic": "ⲛⲁⲓ ⲅⲁⲣ ⲛⲧⲉⲓⲙⲓⲛⲉ ϩⲉⲛⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲛⲛⲟⲩϫ ⲛⲉ . ϩⲉⲛⲉⲣⲅⲁⲧⲏⲥ ⲛⲕⲣⲟϥ ⲛⲉ . ⲉⲩ**ϫⲓϩⲣⲃ** ϩⲱⲥ ⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ .",
      "english": "For such men are false apostles, deceitful workers, masquerading as Christ's apostles.",
      "source": "47_2 Corinthians_11",
      "urn": "urn:cts:copticLit:nt.2cor.sahidica:11",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲟⲛ ⲇⲉ ⲧⲏⲣⲛ ϩⲛⲟⲩϩⲟ ⲉϥϭⲟⲗⲡ ⲉⲃⲟⲗ . ⲉⲛⲉⲓⲱⲣϩ ⲙⲡⲉⲟⲟⲩ ⲙⲡⲛⲟⲩⲧⲉ ϩⲓⲧⲛⲟⲩⲉⲓⲁⲗ ⲧⲛ**ϫⲓϩⲣⲃ** ⲛϯϩⲓⲕⲱⲛ ⲛⲟⲩⲱⲧ ⲉⲃⲟⲗ ϩⲛⲟⲩⲉⲟⲟⲩ ⲉⲩⲉⲟⲟⲩ ⲕⲁⲧⲁⲧϩⲉ ⲉⲃⲟⲗ ϩⲓⲧⲙⲡϫⲟⲉⲓⲥ ⲡⲉⲡⲛⲉⲩⲙⲁ .",
      "english": "But we all, with unveiled face beholding as in a mirror the glory of the Lord, are transformed into the same image from glory to glory, even as from the Lord, the Spirit.",
      "source": "47_2 Corinthians_3",
      "urn": "urn:cts:copticLit:nt.2cor.sahidica:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲉⲧⲛⲧⲙ**ϫⲓϩⲣⲃ** ⲙⲡⲉⲓⲁⲓⲱⲛ . ⲁⲗⲗⲁ ⲛⲧⲉⲧⲛϫⲓ ⲙⲡϩⲣⲃ ⲛⲧⲙⲛⲧⲃⲣⲣⲉ ⲙⲡⲉⲧⲛϩⲏⲧ ⲉⲧⲣⲉⲧⲛⲇⲟⲕⲓⲙⲁⲍⲉ ϫⲉⲟⲩ ⲡⲉ ⲡⲟⲩⲱϣ ⲙⲡⲛⲟⲩⲧⲉ ⲉⲧⲛⲁⲛⲟⲩϥ ⲉⲧⲣⲁⲛⲁϥ ⲉⲧϫⲏⲕ ⲉⲃⲟⲗ .",
      "english": "Don't be conformed to this world, but be transformed by the renewing of your mind, so that you may prove what is the good, well-pleasing, and perfect will of God.",
      "source": "45_Romans_12",
      "urn": "urn:cts:copticLit:nt.rom.sahidica:12",
      "dialect": "sahidic"
    }
