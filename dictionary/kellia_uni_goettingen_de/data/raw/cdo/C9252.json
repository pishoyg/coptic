  "examples": [
    {
      "coptic": "ⲙⲁⲗⲓⲥⲧⲁ ⲇⲉ ⲁⲛⲥⲁⲉⲓⲛ ⲣⲥⲡⲟⲩⲇⲏ ⲛⲓⲙ ⲙⲡⲟⲩⲉϣⲑⲉⲣⲁⲡⲉⲩⲉ ⲙⲙⲟⲥ · **ⲕⲁⲓⲡⲉⲣ** ⲧⲥⲱⲛⲉ ⲧⲉ ⲙⲡⲣⲣⲟ ·",
      "english": "And the physicians used their utmost endeavours to work a cure upon her, the more so because she was a king's sister (sic),",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲕⲁⲓⲡⲉⲣ** ⲟⲩⲟⲉⲓⲕ ⲡⲉⲧⲕⲟⲩⲱⲙ ⲙⲙⲟϥ ⲛⲧϩⲉ ⲛⲟⲩⲟⲛ ⲛⲓⲙ ·",
      "english": "and yet the bread which thou eatest is like that of every other man.",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣϫⲉ ϣⲁⲣⲉⲛⲁⲣⲭⲱⲛ ⲣⲥⲡⲟⲇⲏ ⲛⲓⲙ ⲉⲧⲣⲉⲩϯⲉⲟⲟⲩ ⲛⲁⲩ ⲛϭⲓⲡⲉⲧϩⲙⲟⲟⲥ ϩⲛⲛⲉⲑⲉⲁⲧⲣⲟⲛ · **ⲕⲁⲓⲡⲉⲣ** ⲡⲉϩⲟⲩⲟ ⲛⲛⲉⲧϩⲙⲡⲙⲁ ⲉⲧⲙⲙⲁⲩ ϩⲉⲛⲣⲱⲙⲉ ⲛⲉ ⲛϩⲏⲕⲉ ⲛⲉ ⲉⲩⲥⲟϣϥ ϩⲓϩⲙϩⲁⲗ ϩⲓϣⲙⲙⲟ · ⲉⲓⲉ ⲉⲛⲙϣⲁ ϩⲱⲱⲛ ⲛⲥⲡⲟⲩⲇⲁⲍⲉ ⲛⲟⲩⲏⲣ ⲉⲧⲣⲉⲩⲉⲩⲫⲏⲙⲉⲓ ⲙⲙⲟⲛ ϩⲙⲡⲉⲑⲉⲁⲧⲣⲟⲛ ⲉⲧⲙⲙⲁⲩ · ⲡⲙⲁ ⲉⲧⲟⲩⲥⲟⲟⲩϩ ⲛϩⲏⲧϥ ⲛϭⲓⲛⲁⲅⲅⲉⲗⲟⲥ ⲙⲛⲛⲁⲣⲭⲁⲅⲅⲉⲗⲟⲥ ⲙⲛⲛⲉⲧⲟⲩⲁⲁⲃ ⲧⲏⲣⲟⲩ ·",
      "english": "If the governor (of a city) taketh the greatest pains in order to be praised by those who are sitting in the theatre, notwithstanding the fact that the greater number of those who are sitting in that place are poor men, and men of humble station, and servants, and strangers, how very much more pains ought we to take to cause ourselves to be well spoken of in that theatre of the Other World, wherein are congregated the angels, and the archangels, and all the saints?",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    }
