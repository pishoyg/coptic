  "examples": [
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ ⲁⲓⲱⲗⲓ ⲛⲧⲁ**ⲥⲏϥⲓ** ⲁⲓϭⲟϫⲓ ⲥⲁⲫⲁϩⲟⲩ ⲙⲙⲟϥ ⲁⲓϧⲟⲑⲃϥ ⲟⲩⲟϩ ⲛϯⲟⲩⲛⲟⲩ ⲁⲓⲕⲱϯ ϧⲉⲛϯⲁⲥⲟⲩⲓ ⲉⲧϧⲉⲛⲡⲉϥⲙⲟⲩⲧ ⲉⲓⲙⲉⲩⲓ ϫⲉϯⲛⲁϫⲓⲙⲓ ⲛⲟⲩⲛⲓϣϯ ⲛⲓⲇⲟⲥ ⲛⲛⲟⲩⲃ ⲛϧⲏⲧⲥ ⲛⲧⲁⲟⲗⲟⲩ ⲛⲧⲁⲟⲩⲛⲟϥ ⲙⲙⲟⲓ ⲛϧⲏⲧⲟⲩ ⲛⲟⲩⲙⲏϣ ⲛⲉϩⲟⲟⲩ .",
      "english": "I noticed it and, driven by greed, I grabbed my sword, pursued him, and struck him down. I searched the pouch, expecting to discover a large sum in gold that would allow me to live in ease for years.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲣⲉ ⲧⲉϥ**ⲥⲏϥⲉ** ϩⲛⲧⲉϥϭⲓϫ ·",
      "english": "while his sword (is) in his hand",
      "source": "Apophthegmata Patrum Sahidic 157: Papnoute",
      "urn": "urn:cts:copticLit:ap.157.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲁⲓ ⲇⲉ ⲛⲧⲉⲛⲏ ⲉⲧⲟϩⲓ ⲉⲣⲁⲧⲟⲩ ⲁϥⲑⲉⲕⲉⲙϯ**ⲥⲏϥⲓ** ⲉⲁϥϯ ⲛⲟⲩϣⲁϣ ⲙⲫⲃⲱⲕ ⲙⲡⲓⲁⲣⲭⲓⲉⲣⲉⲩⲥ ⲟⲩⲟϩ ⲁϥⲱⲗⲓ ⲙⲡⲉϥⲙⲁϣϫ ⲉⲃⲟⲗ .",
      "english": "But a certain one of those who stood by drew his sword, and struck the servant of the high priest, and cut off his ear.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁϥϩⲟⲕϥ ⲛⲧ**ⲥⲏϥⲉ** ·",
      "english": "and (Horion) girded on the sword.",
      "source": "Martyrdom of Victor part 8",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:86-90",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲑⲱⲧⲉⲛ ϧⲁⲛⲓⲉⲑⲁⲩϣ ⲛⲑⲱⲧⲉⲛ ϩⲁⲛϧⲱⲧⲉⲃ ⲛⲧⲉⲧⲁ**ⲥⲏϥⲓ** .",
      "english": "Ye Ethiopians also are the slain of my sword.",
      "source": "36_Sophonias_02",
      "urn": "urn:cts:copticLit:ot.zeph.bohairic_ed:02",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡⲉⲧⲛⲁϫⲟⲟⲥ ⲛϩⲏⲧⲟⲩ ϫⲉⲁⲛⲅ ⲟⲩⲭⲣⲓⲥϯⲁⲛⲟⲥ · ⲉⲩⲉϯⲙⲉⲉⲩⲉ ⲙⲙⲟϥ ⲛϥⲙⲟⲩ ϩⲛⲧ**ⲥⲏϥⲉ** ·",
      "english": "And any one among these who shall say, 'I am a Christian,' shall be remembered, and he shall die by the sword.",
      "source": "Martyrdom of Victor part 1",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:1-6",
      "dialect": "sahidic"
