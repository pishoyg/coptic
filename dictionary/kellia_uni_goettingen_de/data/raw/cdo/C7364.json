  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲡⲉⲧϯ ⲛϩⲧⲏϥ ⲉⲣⲟⲟⲩ ⲛϥⲛⲁ**ϫⲓϫⲣⲟⲡ** ⲁⲛ ⲕⲁⲧⲁⲛⲉⲅⲣⲁⲫⲏ ϫⲉⲡⲉⲧⲙⲟⲟϣⲉ ϩⲛⲡⲉϩⲟⲟⲩ · ⲙⲉϥϫⲓϫⲣⲟⲡ ·",
      "english": "and the one who pays attention to them will not stumble, as it written: 'The one who walks in the day does not stumble.'",
      "source": "Acephalous 22: YA 421-28",
      "urn": "urn:cts:copticLit:shenoute.a22.monbya:1251-1258",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲕⲁⲑⲓⲥⲧⲁ ⲙⲙⲟⲛ ⲛⲣⲉϥⲣⲟⲩⲟⲉⲓⲛ ⲙⲡⲕⲟⲥⲙⲟⲥ ⲙⲡⲣⲧⲣⲉⲩ**ϫⲓϫⲣⲟⲡ** ⲉⲧⲃⲏⲏⲧⲛ ⲙⲁⲣⲛⲫⲟⲣⲉⲓ ⲙⲡⲕⲁⲣⲱϥ ·",
      "english": "Lightgivers have been placed in the world for us, let them not be offended because of us, let us bear silently,",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲡⲉⲓⲇⲏ ⲛⲧⲟⲕ ⲡⲉⲧⲛⲧⲁϫⲣⲏⲩ ⲉϫⲛⲧⲉⲕⲥⲟⲫⲓⲁ ⲉⲧⲃⲉⲡⲁⲓ ⲁⲡϫⲁϫⲉ ϩⲓⲧⲟⲟⲧϥ ⲉⲣⲡⲁⲓ ϩⲓⲧⲟⲟⲧⲕ ⲉϥⲥⲟⲟⲩⲛ ϫⲉⲟⲩⲛⲟⲩⲙⲏⲏϣⲉ ⲛⲁ**ϫⲓϫⲣⲟⲡ**",
      "english": "But since you are the one through whose wisdom we are strengthened, it is because of this that the enemy has done this against you, knowing that a multitude will stumble because of it.",
