  "examples": [
    {
      "coptic": "**ⲁϣ** ⲅⲁⲣ ⲛⲇⲓⲕⲉⲟⲛ ⲁⲛ ⲡⲉ ⲉⲥⲟⲗⲥⲉⲗ ⲙⲡⲓⲁⲧⲥⲟⲗⲥⲉⲗ ϩⲓⲧⲉⲛϩⲗⲓ ⲉⲧⲉⲫϯ ⲡⲉ ⲫⲏ ⲉⲧⲥⲟⲗⲥⲉⲗ ⲛⲛⲉϥⲥⲱⲛⲧ ⲧⲏⲣⲟⲩ ⲛⲧⲉⲕⲥⲉⲗⲥⲱⲗϥ ϧⲉⲛⲟⲩⲥⲃⲱ ⲛⲧⲉⲡⲁⲓⲕⲟⲥⲙⲟⲥ",
      "english": "How could it be just to adorn Him who cannot be adorned—that is, God—with the wisdom of this world, when He Himself adorns all His creatures?",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧϩⲉ ⲉⲛⲧⲁϥⲉⲓ ⲉϩⲟⲩⲛ ⲙⲡⲣⲣⲟ ⲉⲧⲣⲉϥϫⲟⲟⲥ ⲛⲁϥ ⲉ**ⲉⲓϣⲉ** ⲙⲙⲁⲣⲇⲟⲩⲭⲁⲓⲟⲥ ⲛⲉⲓⲡⲉⲧϩⲟⲟⲩ ⲇⲉ ⲉⲛⲧⲁϥϩⲓⲧⲟⲟⲧϥ ⲉⲣⲟⲟⲩ ⲉⲛⲧⲟⲩ ⲉϫⲱⲟⲩ ⲁⲩⲉⲓ ⲉϩⲣⲁⲓ ⲉϫⲱϥ ⲁⲩⲁϣⲧϥ ⲛⲧⲟϥ ⲙⲛⲛⲉϥⲕⲉϣⲏⲣⲉ ⲉϫⲛⲛϣⲉ",
      "english": "also how he went in to the king, telling him to hang Mardochaeus: but all the calamities he tried to bring upon the Jews came upon himself, and he was hanged, and his children.",
      "source": "Esther 9",
      "urn": "urn:cts:copticLit:ot.esth.coptot:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲱⲟⲩ ⲇⲉ ⲁⲩⲱϣ ⲉⲃⲟⲗ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉ**ⲁϣ**ϥ ⲁϣϥ .",
      "english": "but they shouted, saying, 'Crucify! Crucify him!'",
      "source": "03_Luke_23",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:23",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲇⲟⲩⲝ ⲇⲉ ⲁϥⲕⲉⲗⲉⲩⲉ ⲉⲧⲣⲉⲩ**ⲁϣⲧ**ϥ ⲛⲥⲁϫⲱϥ ⲉⲩⲥⲧⲩⲗⲗⲟⲥ :—",
      "english": "Then the Duke commanded (his servants) to hang him up on a pillar head downwards",
      "source": "Martyrdom of Victor part 7",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:67-85",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲟⲩϣⲧ ⲉⲡϣⲱⲓ ⲉⲧⲫⲉ ⲟⲩⲟϩ ⲁⲛⲁⲩ : ⲙⲁⲓⲁⲧⲕ ⲇⲉ ⲛⲛⲓϭⲏⲡⲓ ϫⲉⲁⲩϭⲟⲥⲓ ⲉⲣⲟⲕ ⲛ**ⲁϣ** ⲛⲣⲏϯ .",
      "english": "If thou hast sinned, what wilt thou do?",
      "source": "18_Iob_35",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:35",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϥⲥⲱⲙⲁ ⲇⲉ ⲁϥϭⲱ ⲉϥ**ⲁϣⲉ** ⲉϫⲙⲡϣⲉ ⲉⲧⲃⲉⲛⲉⲥⲧⲟⲓⲭⲓⲟⲛ · ⲁⲩⲱ ⲡⲉϥⲡⲛⲉⲩⲙⲁ ⲁϥⲃⲱⲕ ⲉⲡⲉⲥⲏⲧ ⲉⲁⲙⲛⲧⲉ ⲁϥⲧⲟⲩϫⲟ ⲛⲛⲉⲧϩⲙⲡⲙⲁ ⲉⲧⲙⲙⲁⲩ",
      "english": "His Body continued to hang upon the tree for the sake of the elements, and His Spirit went down into Amente, and saved those who were in that region.",
      "source": "On the Soul and Body",
