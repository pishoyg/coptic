  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁⲣⲉⲡⲓⲙⲁ ⲛⲉⲥⲱⲟⲩ ⲉⲣⲙⲉⲑⲣⲉ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲓⲛⲁⲩ ⲉⲡⲓⲓ ⲛⲧⲏⲃ ⲛⲧⲉⲡⲓⲕⲟⲩϫⲓ ⲛϣⲏⲣⲓ ⲉⲩⲟⲓ ⲙⲫⲣⲏϯ ⲙⲓ ⲛⲗⲁⲙⲡⲁⲥ ⲛⲭⲣⲱⲙ ⲟⲩⲟϩ ⲡⲁⲓⲣⲏϯ ⲁⲓ**ⲧⲁⲥⲑⲟ**ⲓ ⲉⲫⲁϩⲟⲩ ⲁⲓϣⲉ ⲛⲏⲓ ⲉⲥⲕⲉⲛⲛⲁⲉⲥⲱⲟⲩ .",
      "english": "And the shepherd was witness, saying “I saw the ten fingers of the little boy becoming as ten flaming lanterns, and so I turned back and went to my sheep.”",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲁⲓ ⲉⲧⲉⲛ**ⲥⲧⲟ** ⲁⲛ ⲉϫⲟⲟⲩ ⲉⲣⲱⲙⲉ ⁛—",
      "english": "the which it is not lawful for man to utter.",
      "source": "Life of Pisentius part 1",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲁⲣⲉⲛ**ⲧⲁⲥⲑⲟ** ⲡⲓⲥⲁϫⲓ ⲉϫⲉⲛⲡⲓⲉϩⲟⲟⲩ ⲉⲧⲁⲡⲓⲁⲗⲟⲩ ⲓⲥⲁⲁⲕ ⲓ ⲉⲃⲟⲗ ϧⲉⲛⲡⲉϥⲏⲓ ⲧⲉⲛⲛⲁⲧⲁⲙⲱⲧⲉⲛ ⲉⲡⲓϫⲱⲕ ⲉⲟⲩⲱⲟⲩ ⲙⲫⲛⲟⲩϯ .",
      "english": "Let us now bring back the discourse on the day when the young boy Isaac left his house: we will tell you everything for the glory of God.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲕⲟⲧⲟⲩ ⲇⲉ ⲁⲩⲥⲟⲃⲧⲉ ⲛϩⲉⲛϩⲏⲛⲉ ⲛⲙϩⲉⲛ**ⲥⲧⲟ** . ⲁⲩⲱ ⲁⲩϭⲱ ⲙⲡⲥⲁⲃⲃⲁⲧⲟⲛ ⲕⲁⲧⲁⲧⲉⲛⲧⲟⲗⲏ .",
      "english": "They returned, and prepared spices and ointments. On the Sabbath they rested according to the commandment.",
      "source": "42_Luke_23",
      "urn": "urn:cts:copticLit:nt.luke.sahidica:23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲩⲙⲟⲣⲟⲩ ⲛϩⲁⲛⲥⲟⲕ ⲛϫⲉⲛⲓⲣⲱⲙⲓ ⲛⲉⲙⲛⲓⲧⲉⲃⲛⲱⲟⲩⲓ ⲟⲩⲟϩ ⲁⲩⲱϣ ⲉⲡϣⲱⲓ ϩⲁⲡϭⲟⲉⲓⲥ ⲫⲛⲟⲩϯ ⲉⲙⲁϣⲱ ⲟⲩⲟϩ ⲁⲫⲟⲩⲁⲓ ⲫⲟⲩⲁⲓ ⲙⲙⲱⲟⲩ **ⲧⲁⲥⲑⲟ** ⲉⲃⲟⲗ ϩⲁⲡⲉϥⲙⲱⲓⲧ ⲉⲧϩⲱⲟⲩ ⲛⲉⲙⲉⲃⲟⲗ ϩⲁⲡⲓϭⲓⲛϫⲟⲛⲥ ⲉⲧϧⲉⲛⲛⲟⲩϫⲓϫ ⲉⲩϫⲱ ⲙⲙⲟⲥ .",
      "english": "So men and cattle were clothed with sackcloths, and cried earnestly to God; and they turned every one from their evil way, and from the iniquity that was in their hands, saying,",
      "source": "Bohairic Jonah 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.Jonah.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲏ ϩⲛⲟⲩ**ⲥⲧⲟ** ⲉⲃⲟⲗ ⲁⲕⲧⲥⲧⲟ ⲉⲃⲟⲗ ⲛⲓⲟⲩⲇⲁ ⲁⲩⲱ ⲁⲧⲉⲕⲯⲩⲭⲏ ⲟⲩⲉ ⲉⲃⲟⲗ ⲛⲥⲓⲱⲛ ⲉⲧⲃⲉⲟⲩ ⲁⲕⲑⲙⲕⲟⲛ ⲁⲩⲱ ⲙⲡⲉⲧⲁⲗϭⲟ ϣⲱⲡⲉ ⲛⲁⲛ ⲁⲛϩⲩⲡⲟⲙⲓⲛⲉ ⲉⲩⲉⲓⲣⲏⲛⲏ ⲁⲩⲱ",
