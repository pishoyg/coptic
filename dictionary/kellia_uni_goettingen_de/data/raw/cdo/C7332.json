  "examples": [
    {
      "coptic": "ⲡϭⲟⲉⲓⲥ ⲫⲛⲟⲩϯ ⲡⲉ ⲧⲁϫⲟⲙ ⲟⲩⲟϩ ⲉϥⲉⲑⲱϣ ⲛⲛⲁϭⲁⲗⲁⲩϫ ⲉⲟⲩⲥⲩⲛⲧⲉⲗⲓⲁ ϥⲛⲁⲧⲁⲗⲟⲓ ⲉϫⲉⲛⲛⲓϭⲓⲥⲓ ⲉⲑⲣⲓ**ϭⲣⲟ** ϧⲉⲛⲧⲉϥϩⲱⲇⲏ .",
      "english": "The Lord God is my strength, and he will perfectly strengthen my feet; he mounts me upon high places, that I may conquer by his song.",
      "source": "Bohairic Habakkuk 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ϫⲣⲟ** ⲁⲩⲱ ⲛⲅϭⲙϭⲟⲙ · ϫⲉⲡⲛⲟⲩⲧⲉ ⲙⲓϣⲉ ⲉϩⲣⲁⲓ ⲉϫⲱⲕ ·",
      "english": "Peace be unto thee, O God-loving Emperor! Be strong, and of good courage, for God hath fought for thee.",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲣⲱⲓⲥ ⲟⲩⲛ ⲟⲩⲟϩ ⲟϩⲓ ⲉⲣⲁⲧ ⲉⲛⲑⲏⲛⲟⲩ ϧⲉⲛⲫⲛⲁϩϯ **ϭⲣⲟ** ⲙⲙⲱⲧⲉⲛ ⲟⲩⲟϩ ϫⲉⲙⲛⲟⲙϯ .",
      "english": "Watch! Stand firm in the faith! Be courageous! Be strong!",
      "source": "Bohairic 1 Corinthians 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲁⲡⲥ ⲅⲁⲣ ⲡⲉ ⲉⲧⲣⲉⲕⲉⲓⲱⲃ ⲛⲃⲣⲣⲉ ϣⲱⲡⲉ ϩⲛⲛⲉⲓⲕⲁⲓⲣⲟⲥ · ⲡⲁⲓ ⲉⲧⲛⲁ**ϫⲣⲟ** ⲉⲡⲇⲓⲁⲃⲟⲗⲟⲥ · ϩⲙⲡⲡⲉⲓⲣⲁⲥⲙⲟⲥ ⁛",
      "english": "For needs must that thou shouldst become a second Job, in these times, who shall vanquish the Devil in temptation.",
      "source": "History of Eustathius and Theopiste part 1",
      "urn": "urn:cts:copticLit:lives.eustathius.budge:1-30",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁ ⲙⲱⲩⲥⲏⲥ ϩⲟⲛϩⲉⲛ ⲉⲧⲟⲧϥ ⲛⲓⲏⲥⲟⲩ ⲡϣⲏⲣⲓ ⲛⲛⲁⲩⲏ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉ**ϭⲣⲟ** ⲙⲙⲟⲕ ⲟⲩⲟϩ ϫⲉⲙⲛⲟⲙϯ ⲛⲑⲟⲕ ⲅⲁⲣ ⲉⲧⲛⲁϭⲓ ⲛⲛⲉⲛϣⲏⲣⲓ ⲙⲡⲓⲥⲣⲁⲏⲗ ⲉϧⲟⲩⲛ ⲉⲡⲓⲕⲁϩⲓ ⲉⲧⲁϥⲱⲣⲕ ⲛⲱⲟⲩ ⲉⲣⲟϥ ⲛϫⲉⲡϭⲟⲓⲥ ⲟⲩⲟϩ ⲛⲑⲟϥ ⲉϥⲉϣⲱⲡⲓ ⲛⲉⲙⲁⲕ",
      "english": "And he charged Joshua, and said, Be courageous and strong, for thou shalt bring the sons of Israel into the land, which the Lord sware to them, and he shall be with thee.",
      "source": "05_Deuteronomium_31",
      "urn": "urn:cts:copticLit:ot.deut.bohairic_ed:31",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϯⲛⲁϩⲩⲡⲟⲙⲉⲓⲛⲉ ⲉⲡϫⲟⲉⲓⲥ **ϫⲣⲟ** ⲁⲩⲱ ⲙⲁⲣⲉⲡⲉⲕϩⲏⲧ ⲧⲱⲕ ⲛⲅϩⲩⲡⲟⲙⲉⲓⲛⲉ ⲉⲡϫⲟⲉⲓⲥ",
      "english": "Wait on the Lord: be of good courage, and let thy heart be strengthened: yea wait on the Lord.",
      "source": "Psalms 26",
      "urn": "urn:cts:copticLit:ot.pss.coptot:26",
      "dialect": "sahidic"
    }
