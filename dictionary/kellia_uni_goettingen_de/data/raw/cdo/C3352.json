  "examples": [
    {
      "coptic": "ⲟⲩϣⲙϣⲉ ⲛⲃⲣⲣⲉ · ⲟⲩⲕⲉⲧⲓ ⲅⲁⲣ ⲙⲛⲥⲟⲩⲥⲟⲟⲩϣⲉ ⲅⲁⲣ ⲛⲕⲉⲥⲟⲡ ⲟⲩⲇⲉ **ⲥⲃⲃⲉ** · ⲁⲗⲗⲁ ⲉⲩϣⲙϣⲉ ϩⲛⲟⲩⲡⲓⲥⲧⲓⲥ ·",
      "english": "The new worship : this is not the savour of sacrifice a second time, neither is it circumcision, but it is the worshipping by faith,",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡ**ⲥⲃⲃⲉ** ⲟⲩⲗⲁⲁⲩ ⲡⲉ ⲁⲩⲱ ⲧⲙⲛⲧⲁⲧⲥⲃⲃⲉ ⲟⲩⲗⲁⲁⲩ ⲧⲉ . ⲁⲗⲗⲁ ⲡϩⲁⲣⲉϩ ⲉⲛⲉⲛⲧⲟⲗⲏ ⲙⲡⲛⲟⲩⲧⲉ ⲡⲉ .",
      "english": "Circumcision is nothing, and uncircumcision is nothing, but the keeping of the commandments of God.",
      "source": "1 Corinthians 7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲁϩ ⲅⲁⲣ ⲛⲉⲧⲉⲛⲥⲉϩⲩⲡⲟⲧⲁⲥⲥⲉ ⲁⲛ . ⲛⲣⲉϥϫⲉϣⲁϫⲉ ⲛⲉⲡⲣⲁ . ⲁⲩⲱ ⲛⲣⲉϥⲧⲁⲕⲉ ϩⲏⲧ ⲛϩⲟⲩⲟ ⲇⲉ ⲛⲉⲃⲟⲗ ϩⲙⲡ**ⲥⲃⲃⲉ** .",
      "english": "For there are also many unruly men, vain talkers and deceivers, especially those of the circumcision,",
      "source": "56_Titus_1",
      "urn": "urn:cts:copticLit:nt.titus.sahidica:1",
      "dialect": "sahidic"
    }
