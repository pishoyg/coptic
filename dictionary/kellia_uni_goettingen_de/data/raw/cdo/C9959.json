  "examples": [
    {
      "coptic": "**ⲟⲩⲇⲉ** ⲡⲁⲓⲣⲏϯ ⲛⲁⲥⲟⲓ ⲛϩⲩⲥⲟⲥ ⲁⲛ ⲛϫⲉⲧⲟⲩⲙⲉⲧⲙⲉⲑⲣⲉ .",
      "english": "Even so, their testimony did not agree.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲣⲉⲛⲉⲩⲥⲁⲛⲇⲁⲗⲓⲟⲛ ⲟⲧϩ ⲉⲣⲁⲧⲟⲩ . **ⲟⲩⲇⲉ** ⲛⲥⲉⲧⲙϯϣⲧⲏⲛ ⲥⲛⲧⲉ ϩⲓⲱⲟⲩ",
      "english": "but to wear sandals, and not put on two tunics.",
      "source": "41_Mark_6",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲁⲣⲭⲏ ⲅⲁⲣ ⲛϯⲁⲡⲟⲥⲧⲁⲥⲓⲁ ⲉⲃⲟⲗ ϩⲁⲫϯ ⲑⲁⲓ ⲧⲉ ⲟⲩⲣⲱⲙⲓ ⲁϥϣⲁⲛⲙⲁϩϧⲏⲧϥ ⲙⲡⲥⲁϫⲓ ⲛⲫϯ ⲛⲧⲉϥϣⲧⲉⲙⲉⲣⲉⲡⲓⲑⲩⲙⲓⲛ ⲉⲣⲟϥ **ⲟⲩⲇⲉ** ⲛⲧⲉϥϣⲧⲉⲙⲉⲣϩⲱⲃ ⲉⲣⲟϥ",
      "english": "From God, indeed, comes the beginning of apostasy when a person fills their heart neither desiring nor acting according to the Word of God.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲟⲩⲇⲉ** ϩⲣⲉⲕⲣⲓⲕⲉ ⲛⲛⲉⲕⲃⲟⲩϩⲉ ·",
      "english": "nor slumber to thine eyelids,",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ ⲉⲧϩⲓϫⲉⲛⲡϫⲉⲛⲉⲫⲱⲣ ⲙⲡⲉⲛⲑⲣⲉϥⲓ ⲉϧⲣⲏⲓ **ⲟⲩⲇⲉ** ⲙⲡⲉⲛⲑⲣⲉϥϣⲉ ⲉϧⲟⲩⲛ ⲉⲉⲗϩⲗⲓ ⲉⲃⲟⲗ ϧⲉⲛⲡⲉϥⲏⲓ .",
      "english": "and let him who is on the housetop not go down, nor enter in, to take anything out of his house.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲟⲩⲇⲉ** ⲟⲛ ⲛⲥϣⲁϫⲉ ⲁⲛ ⲛⲧⲉϥϩⲉ",
      "english": "nor does it speak like him.",
      "source": "Life of Apa Aphou part 1",
      "urn": "urn:cts:copticLit:lives.aphou.paths_ed:0-61",
      "dialect": "sahidic"
    }
