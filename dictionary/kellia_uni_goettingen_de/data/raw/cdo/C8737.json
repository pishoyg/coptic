  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥϫⲟⲥ ⲛⲱⲟⲩ ϫⲉⲡϩⲁⲓ ⲡⲉ ⲡⲁⲥⲛⲟϥ ⲛⲧⲉϯ**ⲇⲓⲁⲑⲏⲕⲏ** ⲉⲧⲟⲩⲛⲁⲫⲟⲛϥ ⲉⲃⲟⲗ ⲉϫⲉⲛⲟⲩⲙⲏϣ ⲉⲡϫⲓⲛⲭⲱ ⲉⲃⲟⲗ ⲛⲧⲉⲛⲟⲩⲛⲟⲃⲓ .",
      "english": "He said to them, 'This is my blood of the new covenant, which is poured out for many.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲗⲟⲓⲡⲟⲛ ⲛⲁϥⲕⲁⲧⲁⲫⲣⲟⲛⲉⲓ ⲛⲧ**ⲇⲓⲁⲑⲏⲕⲏ** ⲙⲡⲉϥⲉⲓⲱⲧ :—",
      "english": "And finally he treated with contempt his father's will and testament,",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲁⲓⲣⲏϯ ⲟⲛ ⲡⲓⲕⲉⲁⲫⲟⲧ ⲙⲉⲛⲉⲛⲥⲁⲡⲓⲇⲓⲡⲛⲟⲛ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲡⲁⲓⲁⲫⲟⲧ ϯ**ⲇⲓⲁⲑⲏⲕⲏ** ⲙⲃⲉⲣⲓ ⲧⲉ ϧⲉⲛⲡⲁⲥⲛⲟϥ ⲫⲁⲓ ⲁⲣⲓⲧϥ ⲛⲥⲟⲡ ⲛⲓⲃⲉⲛ ⲉⲧⲉⲧⲉⲛⲛⲁⲥⲱ ⲙⲙⲟϥ ⲉⲣⲉⲧⲉⲛⲓⲣⲓ ⲙⲡⲁⲙⲉⲩⲓ .",
      "english": "In the same way he also took the cup, after supper, saying, 'This cup is the new covenant in my blood. Do this, as often as you drink, in memory of me.'",
      "source": "Bohairic 1 Corinthians 11 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲟⲩⲱϣⲃ ⲛϭⲓⲁⲡⲁ ⲁⲫⲟⲩ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲕⲁⲓⲙⲏⲛ ⲙⲛⲛⲥⲁⲧⲣⲉⲡⲛⲟⲩⲧⲉ ⲥⲙⲛ**ⲇⲓⲁⲑⲏⲕⲏ** ⲙⲛⲛⲱϩⲉ ⲙⲛⲛⲥⲁⲡⲕⲁⲧⲁⲕⲗⲩⲥⲙⲟⲥ ϣⲁϥϫⲟⲟⲥ ⲛⲁϥ ϫⲉⲡⲉⲧⲛⲁⲡⲱϩⲧ ⲉⲃⲟⲗ ⲛⲟⲩⲥⲛⲟϥ ⲛⲣⲱⲙⲉ ⲥⲉⲛⲁⲡⲉϩⲧⲡⲱϥ ⲉⲃⲟⲗ ⲉⲡⲉϥⲙⲁ ϫⲉⲛⲧⲁⲩⲧⲁⲙⲓⲉ ⲡⲣⲱⲙⲉ ϩⲛⲧϩⲓⲕⲱⲛ ⲙⲡⲛⲟⲩⲧⲉ",
      "english": "Apa Aphou answered him: Certainly, when God established the covenant with Noah after the flood he said to him: he who spills human blood shall have his blood spilled in turn, for man was created in the image of God.",
      "source": "Life of Apa Aphou part 1",
      "urn": "urn:cts:copticLit:lives.aphou.paths_ed:0-61",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲓⲉⲥⲉⲙⲛⲓ ⲛⲧⲁ**ⲇⲓⲁⲑⲏⲕⲏ** ⲟⲩⲧⲱⲓ ⲛⲉⲙⲟⲩⲧⲱⲕ ⲛⲉⲙⲟⲩⲧⲉ ⲡⲉⲕϫⲣⲟϫ ⲙⲉⲛⲉⲛⲥⲱⲕ ϣⲁⲛⲟⲩⲅⲉⲛⲉⲁ ⲉⲩⲇⲓⲁⲑⲏⲕⲏ ⲛⲉⲛⲉϩ ⲉⲑⲣⲓϣⲱⲡⲓ ⲛⲁⲕ ⲛⲛⲟⲩϯ ⲛⲉⲙⲡⲉⲕϫⲣⲟϫ ⲙⲉⲛⲉⲛⲥⲱⲕ",
      "english": "And I will establish my covenant between thee and thy seed after thee, to their generations, for an everlasting covenant, to be thy God, and of thy seed after thee.",
      "source": "01_Genesis_17",
      "urn": "urn:cts:copticLit:ot.gen.bohairic_ed:17",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲁⲓ ⲛⲧⲁⲩϣⲱⲡⲉ ϩⲛⲧⲡⲁⲗⲁⲓⲁ **ⲇⲓⲁⲑⲏⲕⲏ** ⲙⲛⲧⲕⲩⲛⲏ ˽ ϫⲉⲕⲁⲥ ⲛⲛⲁⲥⲱⲧⲙ ⲉⲣⲟⲟⲩ ⲙⲙⲁⲧⲉ ⲁⲛ ⲁⲗⲗⲁ ϫⲉⲕⲁⲥ ⲉⲛⲛⲁⲧⲛⲧⲱⲛⲛ ⲉⲡⲉⲩⲥⲙⲟⲧ ⲧⲛⲕⲗⲏⲣⲟⲛⲟⲙⲉⲓ ϩⲱⲱⲛ ⲛⲛⲉⲣⲏⲧ ⲛⲧⲁⲡⲛⲟⲩⲧⲉ ⲉⲣⲏⲧ ⲙⲙⲟⲟⲩ ⲛⲛⲉⲧⲙⲉ ⲙⲙⲟϥ ·",
      "english": "who were in the Old Testament and the New, so that we would not only hear about them, but also liken ourselves to their example. We, too, inherit the promises God made to those who love him.”",
      "source": "Life of Longinus and Lucius part 1",
      "urn": "urn:cts:copticLit:lives.longinus_lucius.paths_ed:0-9",
      "dialect": "sahidic"
    }
