  "examples": [
    {
      "coptic": "ⲁⲓϯⲱⲙⲥ ⲇⲉ ⲙⲡⲕⲉⲏⲓ ⲛⲥⲧⲉⲫⲁⲛⲁ **ⲗⲟⲓⲡⲟⲛ** ⲛϯⲉⲙⲓ ⲁⲛ ϫⲉⲁⲛ ⲁⲓϯⲱⲙⲥ ⲛⲕⲉⲟⲩⲁⲓ .",
      "english": "(I also baptized the household of Stephanas; besides them, I don't know whether I baptized any other.)",
      "source": "Bohairic 1 Corinthians 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲩⲥⲟⲟⲩⲛ ⲧⲏⲣⲟⲩ ⲛⲁⲡⲁ ⲗⲟⲩⲕⲓⲟⲥ ⲁⲩⲱ ⲉⲩϭⲱϣⲧ ⲛⲥⲱϥ ⲧⲏⲣⲟⲩ ϩⲱⲥ ⲛⲧⲟϥ ⲡⲉⲧⲛⲁⲡⲣⲟϩⲓⲥⲧⲁ ⲙⲙⲟⲟⲩ ⲙⲛⲛⲥⲁⲡⲉⲛⲧⲁϥⲛⲕⲟⲧⲕ · **ⲗⲟⲓⲡⲟⲛ** ⲛⲧⲉⲣⲉⲡⲡⲉⲧⲟⲩⲁⲁⲃ ⲕⲁⲧⲁⲗⲁⲙⲃⲁⲛⲉ ⲙⲙⲟϥ ⲙⲡⲉϣⲧⲟⲣⲧⲣ ⲉⲧⲧⲏϣ ⲉϣⲱⲡⲉ ⲛⲧⲉϥⲁⲫⲟⲣⲙⲏ ,",
      "english": "They all knew Apa Lucius, and they all anticipated him to be the one who'd preside as abbot over them after whoever passed away. At any rate, when the saint comprehended the disorder that was destined to happen because of him,",
      "source": "Life of Longinus and Lucius part 1",
      "urn": "urn:cts:copticLit:lives.longinus_lucius.paths_ed:0-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲗⲟⲓⲡⲟⲛ** ⲙⲡⲉⲛⲑⲣⲉⲛⲓⲡⲣⲟⲥⲟⲩⲥⲏⲟⲩ ⲧⲁⲕⲟ ⲛⲛⲓϣⲁⲉⲛⲉϩ ⲛⲧⲟⲧⲑⲏⲛⲟⲩ",
      "english": "Moreover, let not ephemeral things cause us to lose eternity.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲗⲟⲓⲡⲟⲛ** ϩⲙⲡⲉⲓⲙⲁ · ⲧⲉⲛⲟⲩ ⲙⲁⲣⲉⲡⲟⲩⲁ ⲡⲟⲩⲁ ⲉⲝⲉⲧⲁⲍⲉ ⲙⲙⲟϥ ·",
      "english": "Finally, let each one of us now in this place (i.e., world) examine himself.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲗⲟⲓⲡⲟⲛ** ⲥⲉⲕⲱϯ ⲙⲡⲁⲓⲙⲁ ϧⲉⲛⲛⲓⲟⲓⲕⲟⲛⲟⲙⲟⲥ ϩⲓⲛⲁ ⲛⲥⲉϫⲉⲙⲟⲩⲁⲓ ⲉϥⲉⲛϩⲟⲧ .",
      "english": "Here, moreover, it is required of stewards, that they be found faithful.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲣⲡⲙⲉⲉⲩⲉ **ⲗⲟⲓⲡⲟⲛ** ⲙⲡϣⲁϫⲉ · ⲛⲧⲁⲡϫⲟⲉⲓⲥ ϫⲟⲟϥ ⲙⲡⲉⲧⲣⲟⲥ ϫⲉⲉⲓϣⲁⲛⲟⲩⲱϣ ⲉⲧⲣⲉϥϭⲱ ϣⲁⲛϯⲉⲓ · ⲛⲧⲕ ⲛⲓⲙ ⲛⲧⲟⲕ ⲟⲩⲁϩⲕ ⲛⲥⲱⲓ ·",
      "english": "Finally they remembered the word which the Lord had spoken to Peter, saying, 'If I will to make him remain until I come, what [is that] to thee? Follow thou Me.'",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    }
