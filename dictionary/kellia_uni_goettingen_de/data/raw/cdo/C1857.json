  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥⲱⲗⲓ ⲛⲉⲙⲁϥ ⲙⲡⲉⲧⲣⲟⲥ ⲛⲉⲙⲓⲁⲕⲱⲃⲟⲥ ⲛⲉⲙⲓⲱⲁⲛⲛⲏⲥ ⲟⲩⲟϩ ⲁϥⲉⲣϩⲏⲧⲥ ⲛϣⲑⲟⲣⲧⲉⲣ ⲟⲩⲟϩ ⲛⲉⲣ**ⲙⲕⲁϩ** ⲛϩⲏⲧ .",
      "english": "He took with him Peter, James, and John, and began to be greatly troubled and distressed.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡⲉϫⲉⲡϫⲟⲉⲓⲥ ⲛⲓⲱⲛⲁ ϫⲉⲉⲛⲉⲁⲕ**ⲙⲕⲁϩ** ⲛϩⲏⲧ ⲛⲧⲟⲕ ⲉⲙⲁⲧⲉ :",
      "english": "And the Lord said to Jonas, Art thou very much grieved?",
      "source": "Jonah Chapter 4 (Sahidic)",
      "urn": "urn:cts:copticLit:ot.jonah.coptot_ed:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲡϩⲏⲧ ⲙⲡⲟⲩⲣⲟ **ⲙⲕⲁϩ** ⲉⲑⲃⲉⲛⲓⲁⲛⲁⲩϣ ⲛⲉⲙⲛⲏ ⲉⲑⲣⲟⲧⲉⲃ ⲛⲉⲙⲁϥ ⲙⲡⲉϥⲟⲩⲱϣ ⲉϥⲟϫⲥ .",
      "english": "The king was exceedingly sorry, but for the sake of his oaths, and of his dinner guests, he didn't wish to refuse her.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧⲉⲣⲉϥϭⲱϣⲧ ⲉϩⲟⲩⲛ ⲉϩⲣⲁⲩ ϩⲛⲟⲩⲟⲣⲅⲏ ⲉϥ**ⲙⲟⲕϩ** ⲛϩⲏⲧ ⲉϫⲙⲡⲧⲱⲙ ⲛϩⲏⲧ ⲙⲡⲉⲩϩⲏⲧ ⲡⲉϫⲁϥ ⲙⲡⲣⲱⲙⲉ ϫⲉⲥⲟⲩⲧⲛⲧⲉⲕϭⲓϫ ⲉⲃⲟⲗ ⲁϥⲥⲟⲩⲧⲱⲛⲥ ⲁⲩⲱ ⲁⲥⲗⲟ ⲛϭⲓⲧⲉϥϭⲓϫ .",
      "english": "When he had looked around at them with anger, being grieved at the hardening of their hearts, he said to the man, 'Stretch out your hand.' He stretched it out, and his hand was restored as healthy as the other.",
      "source": "Mark Chapter 3",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥϫⲟⲩϣⲧ ⲉⲣⲱⲟⲩ ϧⲉⲛⲟⲩⲙⲃⲟⲛ ⲉϥ**ⲙⲟⲕϩ** ⲛϩⲏⲧ ⲉϩⲣⲏⲓ ⲉϫⲉⲛⲡⲓⲑⲱⲙ ⲛⲧⲉⲡⲟⲩϩⲏⲧ ⲡⲉϫⲁϥ ⲙⲡⲓⲣⲱⲙⲓ ϫⲉ ⲥⲟⲩⲧⲉⲛⲧⲉⲕϫⲓϫ ⲉⲃⲟⲗ ⲟⲩⲟϩ ⲉⲧⲁϥⲥⲟⲩⲧⲱⲛⲥ ⲁⲥⲟⲩϫⲁⲓ ⲛϫⲉⲧⲉϥϫⲓϫ .",
      "english": "When he had looked around at them with anger, being grieved at the hardening of their hearts, he said to the man, 'Stretch out your hand.' He stretched it out, and his hand was restored as healthy as the other.",
      "source": "Bohairic Gospel of Mark 3 (Digital Edition)",
