      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩ**ⲭⲉⲣⲟⲩⲃⲓⲛ** ⲅⲁⲣ ⲁⲛ ⲙⲙⲟⲩⲛⲅ ⲛϭⲓϫ ⲛⲣⲱⲙⲉ ·",
      "english": "It was not (the work of) the Cherubim, neither was it wrought by the hand of man;",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥⲑⲁⲙⲓⲟ ⲛ**ⲭⲉⲣⲟⲩⲃⲓⲙ** ⲃ ⲛⲛⲟⲩⲃ",
