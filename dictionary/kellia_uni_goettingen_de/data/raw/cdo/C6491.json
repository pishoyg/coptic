  "examples": [
    {
      "coptic": "ⲉϣⲁϥ**ⲣϩⲏⲕⲉ** ⲉⲡⲉϩⲟⲩⲟ .",
      "english": "while he became increasingly poor.",
      "source": "Apophthegmata Patrum Sahidic 094: Anonymous Nau 286",
      "urn": "urn:cts:copticLit:ap.94.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲅ**ⲣϩⲏⲕⲉ** ϩⲱⲱⲕ ⲛⲟⲩⲥⲟⲩⲇⲁⲣⲓⲟⲛ · ⲉⲧⲉⲕⲁⲡⲉ · ⲛⲧⲉⲡⲉⲕⲙⲁ ⲛϣⲱⲡⲉ ϣⲱⲡⲉ ⲛⲁⲕ ⲛⲧⲁⲫⲟⲥ · ϣⲁⲛⲧⲉⲡⲛⲟⲩⲧⲉ ⲧⲟⲩⲛⲟⲥⲕ ⲛϥϯ ⲛⲁⲕ ⲛⲧⲉϭⲣⲏⲏⲡⲉ ⲙⲡⲉϫⲣⲟ :—",
      "english": "Make thyself to become poor, (put) a napkin on thy head, and let thy place of abode be unto thee a tomb, until God shall raise thee up and give unto thee the crown of triumph.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲣⲉϥϯϩⲉ ⲅⲁⲣ ⲛⲓⲙ ϩⲓⲡⲟⲣⲛⲟⲕⲟⲡⲟⲥ ⲛⲁ**ⲣϩⲏⲕⲉ** ⲁⲩⲱ ⲥⲁⲟⲩⲏⲣⲡ ⲛⲓⲙ ⲛⲁϯ ϩⲓⲱⲱϥ ⲛϩⲉⲛⲧⲟⲉⲓⲥ",
      "english": "for every drunkard and whoremonger shall be poor; and every sluggard shall clothe himself with tatters and ragged garments.",
      "source": "Proverbs 23",
      "urn": "urn:cts:copticLit:ot.prov.coptot:23",
      "dialect": "sahidic"
    }
  ],
