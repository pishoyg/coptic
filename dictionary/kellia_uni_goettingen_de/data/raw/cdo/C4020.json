  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲥⲓ ⲉϧⲟⲩⲛ ϧⲉⲛⲟⲩⲥⲡⲟⲩⲇⲏ ϩⲁⲡⲟⲩⲣⲟ ⲁⲥⲉⲣⲉⲧⲓⲛ ⲉⲥϫⲱ ⲙⲙⲟⲥ ϫⲉϯⲟⲩⲱϣ ϩⲓⲛⲁ ϯⲛⲟⲩ ⲛⲧⲉⲕ**ϯ** ⲛⲏⲓ ⲛⲧⲁⲫⲉ ⲛⲓⲱⲁⲛⲛⲏⲥ ⲡⲓⲣⲉϥϯⲱⲙⲥ ϩⲓⲟⲩⲃⲓⲛⲁϫ .",
      "english": "She came in immediately with haste to the king, and asked, I want you to give me right now the head of John the Baptizer on a platter.'",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲉϥⲉⲣⲭⲣⲉⲓⲁ ⲛⲟⲩⲟⲉⲓⲕ ⲙⲉⲣⲉⲗⲁⲁⲩ **ϯ** ⲛⲁϥ ⲉⲡⲉⲩϣⲁⲡ ⲻ",
      "english": "And if he needed bread, no one would give him any.",
      "source": "Apophthegmata Patrum Sahidic 045",
      "urn": "urn:cts:copticLit:ap.45.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ ⲅⲁⲣ ⲉⲧⲉⲡⲓⲣⲱⲙⲓ ⲛⲁ**ⲧⲏⲓ**ϥ ⲛⲧϣⲉⲃⲓⲱ ⲛⲧⲉϥⲯⲩⲭⲏ .",
      "english": "For what will a man give in exchange for his life?",
      "source": "Bohairic Gospel of Mark 8 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:8",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ϯ**ⲟⲩⲫⲣⲁⲅⲉⲗⲗⲓⲟⲛ ⲛⲁϥ · ⲛⲅⲧⲣⲉϥⲙⲟⲟⲛⲉ ⲛⲛⲣⲓⲣ · ⲻ",
      "english": "Give him a whip and make him tend the pigs.'",
      "source": "Apophthegmata Patrum Sahidic 126: N 123 E",
      "urn": "urn:cts:copticLit:ap.126.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲓ ⲉϣⲓⲏⲧ ⲡⲓⲧⲱⲟⲩ ⲉⲑⲟⲩⲁⲃ ⲛⲧⲉⲫⲛⲟⲩϯ ⲛⲁϥϫⲱ ⲙⲡⲥⲁϫⲓ ⲙⲡⲓⲑⲉⲟⲗⲟⲅⲟⲥ ϫⲉ**ⲙⲟⲓ** ⲛⲏⲓ ⲙⲡϣⲁϥⲉ ⲛⲉⲙⲡⲭⲣⲓⲥⲧⲟⲥ",
      "english": "And when he arrived at Skete, the holy mountain of God, he repeated the words of the Theologian: ‘Give me the wilderness with Christ.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓ ⲇⲉ ⲙⲡⲓ**ⲧⲁⲁ**ⲩ ⲛⲏⲧⲛ ⲡⲣⲟⲥⲧϩⲉ ⲛⲧⲁⲓϣⲏⲣⲡⲥϩⲁⲓ",
      "english": "If I do not give them to you as I wrote earlier",
      "source": "Honey Delivery",
      "urn": "urn:cts:copticDoc:papyri_info.tm82149.cpr_4_16",
      "dialect": "sahidic"
    }
