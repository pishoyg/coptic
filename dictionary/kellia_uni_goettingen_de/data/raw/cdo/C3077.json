  "examples": [
    {
      "coptic": "ϣⲁⲣⲉⲡⲣⲟⲟⲩϣ ⲛⲟⲩⲟⲩϣⲏ ⲛⲣⲟⲉⲓⲥ ⲁⲡⲁⲓⲧⲉⲓ ⲛⲟⲩ**ⲣⲉⲕⲣⲓⲕⲉ** ⲁⲩⲱ ϣⲁⲣⲉⲟⲩϩⲓⲛⲏⲃ ⲧⲁⲗϭⲉⲟⲩϣⲱⲛⲉ ⲉϥⲛⲁϣⲧ",
      "english": "Whoso regardeth dreams is like him that catcheth at a shadow, and followeth after the wind.",
      "source": "Sirach 34",
      "urn": "urn:cts:copticLit:ot.sir.coptot:34",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲣϯϩⲓⲛⲏⲃ ⲛⲛⲉⲕⲃⲁⲗ ⲁⲩⲱ ⲙⲡⲣϯ**ⲣⲉⲕⲣⲓⲕⲉ** ⲛⲛⲉⲕⲃⲟⲩϩⲉ",
      "english": "Give not sleep to thine eyes, nor slumber with thine eyelids;",
      "source": "Proverbs 6",
      "urn": "urn:cts:copticLit:ot.prov.coptot:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲧⲉ **ⲣⲉⲕⲣⲓⲕⲉ** ⲛⲛⲉⲛⲛⲟⲩϩⲉ · ϣⲁⲛⲧⲉⲡϫⲟⲉⲓⲥ ⲛⲁϩⲙⲛ ⲉⲡⲉⲓⲣⲁⲥⲙⲟⲥ ⲛⲓⲙ ⲛⲧⲉⲡϫⲁϫⲉ ·",
      "english": "We will not allow our eyes sleep and our eyelids slumber until the Lord saves us from any temptation by the enemy.",
      "source": "On Vigilance",
      "urn": "urn:cts:copticLit:besa.vigilance.monbba",
      "dialect": "sahidic"
    }
