  "examples": [
    {
      "coptic": "ⲡⲛⲟⲩⲧⲉ ⲇⲉ ϩⲱⲱϥ ⲡⲁⲅⲁⲑⲟⲥ ⲡⲉⲧⲉⲛⲉϥⲟⲩⲱϣ ⲁⲛ ⲉⲧⲣⲉⲛⲉϥⲡⲉⲧⲟⲩⲁⲁⲃ ϭⲱ ⲉⲩϩⲏⲡ ⲁⲗⲗⲁ ⲁϥⲟⲩⲱϣ ⲉⲟⲩⲟⲛϩⲟⲩ ⲉⲃⲟⲗ ⲁⲩⲱ ⲛϥ**ϫⲓⲉⲟⲟⲩ** ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧⲟⲩ ⲕⲁⲧⲁⲡⲉⲛⲧⲁϥϫⲟⲟϥ ϩⲙⲡⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ϫⲉⲙⲉⲩϫⲉⲣⲉⲟⲩϩⲏⲃⲥ ⲛⲥⲉⲕⲁⲁϥ ϩⲁⲟⲩϣⲓ ⲁⲗⲗⲁ ⲉϣⲁⲩⲕⲁⲁϥ ⲉϫⲛⲧⲗⲩⲭⲛⲓⲁ ⲉⲧⲣⲉϥⲣⲟⲩⲟⲉⲓⲛ ⲉⲛⲉⲧϣⲟⲟⲡ ⲧⲏⲣⲟⲩ ϩⲙⲡⲏⲓ ·",
      "english": "But it is God Himself, the Good, Who did not wish the [virtue of the] holy man to remain hidden, and He desired to make him manifest, and [to make him] to be glorified by the people, according to what He said in the Gospel,' Men do not light a lamp and put it under a bushel, but they place it upon a candlestick, so that it may give light to all those who are in the house.'",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲉⲩϣⲁⲛⲉⲓ ⲛⲥⲉϭⲛⲧⲛ ⲉⲛⲣⲏⲥ ⲧⲛⲛⲁ**ϫⲓⲉⲟⲟⲩ** ·",
      "english": "and if in their coming they find us being watchful, we are glorified.'",
      "source": "Apophthegmata Patrum Sahidic 044: Hyperechius",
      "urn": "urn:cts:copticLit:ap.44.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉⲧⲉⲛⲥⲉϯⲉⲟⲟⲩ ⲛⲁϥ ⲁⲛ ϩⲛⲛⲣⲱⲙⲉ ϣⲁϥ**ϫⲓⲉⲟⲟⲩ** ϩⲛⲙⲡⲏⲩⲉ ·",
      "english": "The one who is not glorified among men will receive glory in heaven.'",
      "source": "Apophthegmata Patrum Sahidic 130: N 300",
      "urn": "urn:cts:copticLit:ap.130.monbeg",
      "dialect": "sahidic"
