  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲓϫⲓⲛⲕⲓⲙ ⲛⲧⲉϯⲕⲁⲕⲓⲁ ⲉⲧⲟⲓ ⲙⲫⲣⲏϯ ⲛⲛⲓϩⲱⲓⲙⲓ ⲛⲧⲉⲫⲓⲟⲙ ⲉⲩϩⲓⲥⲫⲏⲓϯ ⲉⲧ**ⲧⲱⲟⲩⲛ**ⲟⲩ ⲙⲙⲱⲟⲩ ⲉϩⲣⲏⲓ ⲉϫⲱⲛ ⲙⲁⲣⲉⲛⲛⲟϣⲡⲟⲩ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛϯⲡⲣⲟⲥⲉⲩⲭⲏ ⲛⲉⲙⲛⲓϥⲓⲣⲱⲟⲩϣ ⲛⲧⲉϯⲙⲉⲧⲣⲉϥϯϩⲑⲏϥ ⲉⲣⲟⲛ",
      "english": "The movements of depravity, which are like the waves of the sea foaming and rising against us, should be cast far away from us through prayer and attentiveness.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲁⲓ ⲧⲉ ⲧϩⲉ ⲙⲡⲕⲉ**ⲧⲱⲟⲩⲛ** ⲛⲛⲉⲧⲙⲟⲟⲩⲧ . ⲥⲉⲛⲁϫⲟϥ ϩⲛⲟⲩⲧⲁⲕⲟ ⲛϥⲧⲱⲟⲩⲛ ϩⲛⲟⲩⲙⲛⲧⲁⲧⲧⲁⲕⲟ .",
      "english": "So also is the resurrection of the dead. It is sown in corruption; it is raised in incorruption.",
      "source": "1 Corinthians 15",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:15",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲥϫⲉ ⲇⲉ ⲙⲙⲟⲛⲁⲛⲁⲥⲧⲁⲥⲓⲥ ⲛⲧⲉⲛⲓⲣⲉϥⲙⲱⲟⲩⲧ ⲛⲁϣⲱⲡⲓ ⲓⲉ ⲟⲩⲇⲉ ⲙⲡⲉⲡⲭⲣⲓⲥⲧⲟⲥ **ⲧⲱⲛ**ϥ .",
      "english": "But if there is no resurrection of the dead, neither has Christ been raised.",
      "source": "Bohairic 1 Corinthians 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲡⲉⲓⲇⲏ ⲅⲁⲣ ⲛⲧⲁⲡⲙⲟⲩ ϣⲱⲡⲉ ⲉⲃⲟⲗ ϩⲓⲧⲛⲟⲩⲣⲱⲙⲉ . ⲉⲃⲟⲗ ϩⲓⲧⲛⲟⲩⲣⲱⲙⲉ ⲟⲛ ⲡⲉ ⲡ**ⲧⲱⲟⲩⲛ** ⲛⲛⲉⲧⲙⲟⲟⲩⲧ .",
      "english": "For since death came by man, the resurrection of the dead also came by man.",
      "source": "46_1 Corinthians_15",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:15",
      "dialect": "sahidic"
    },
    {
