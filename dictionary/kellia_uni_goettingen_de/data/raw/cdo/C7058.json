  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲓⲙⲁ ⲉϣⲁϥϣⲉ ⲛⲁϥ ⲉϧⲟⲩⲛ ⲉⲣⲟϥ ⲉⲛⲓϯⲙⲓ ⲓⲉ ⲛⲓⲃⲁⲕⲓ ⲓⲉ ⲛⲓⲓⲟϩⲓ ⲛⲁⲩⲭⲱ ⲛⲛⲏ ⲉⲧϣⲱⲛⲓ ϩⲓⲛⲓⲁⲅⲟⲣⲁ ⲟⲩⲟϩ ⲛⲁⲩϯϩⲟ ⲉⲣⲟϥ ϩⲓⲛⲁ ⲕⲁⲛ ⲛⲧⲟⲩ**ϭⲓ** ⲛⲉⲙⲡⲓϣⲧⲁϯ ⲛⲧⲉⲛⲉϥϩⲃⲱⲥ ⲟⲩⲟϩ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉϣⲁⲩϭⲓ ⲛⲉⲙⲁϥ ϣⲁⲩⲟⲩϫⲁⲓ .",
      "english": "Wherever he entered, into villages, or into cities, or into the country, they laid the sick in the marketplaces, and begged him that they might touch just the fringe of his garment; and as many as touched him were made well.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ϫⲓ** ⲛⲁⲕ ⲛⲁⲇⲁⲙ ⲉϥⲟⲩⲟϫ ⲛⲧⲉϥϩⲉ ·",
      "english": "Take Thou Adam, being complete in his likeness.'",
      "source": "On the Soul and Body",
      "urn": "urn:cts:copticLit:psathanasius.soul_body.budge:1-91",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲟⲧⲁⲛ ⲅⲁⲣ ⲁⲩϣⲁⲛⲧⲱⲟⲩⲛⲟⲩ ϧⲉⲛⲛⲏ ⲉⲧⲙⲱⲟⲩⲧ ⲟⲩⲇⲉ ⲙⲡⲁⲩ**ϭⲓ** ⲟⲩⲇⲉ ⲙⲡⲁⲩϭⲓⲧⲟⲩ ⲁⲗⲗⲁ ⲁⲩⲙⲫⲣⲏϯ ⲛⲛⲓⲁⲅⲅⲉⲗⲟⲥ ϧⲉⲛⲛⲓⲫⲏⲟⲩⲓ .",
      "english": "For when they will rise from the dead, they neither marry, nor are given in marriage, but are like angels in heaven.",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ϫⲓ** ⲛⲁⲕ ⲙⲡⲣⲡⲙⲉⲉⲩⲉ ⲛⲛⲉⲕⲛⲟⲃⲉ ·",
      "english": "and take to thyself the remembrance of the sins",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁⲓ ⲟⲛ ⲙⲡⲁⲓⲣⲏϯ ⲛⲉ ⲛⲏ ⲉⲧⲁⲩⲥⲁⲧⲟⲩ ϩⲓϫⲉⲛⲛⲓⲙⲁ ⲙⲡⲉⲧⲣⲁ ⲛⲏ ⲉⲧⲁⲩϣⲁⲛⲥⲱⲧⲉⲙ ⲉⲡⲓⲥⲁϫⲓ ϣⲁⲩ**ϭⲓⲧ**ϥ ϧⲉⲛⲟⲩⲣⲁϣⲓ",
      "english": "These in like manner are those who are sown on the rocky places, who, when they have heard the word, immediately receive it with joy.",
