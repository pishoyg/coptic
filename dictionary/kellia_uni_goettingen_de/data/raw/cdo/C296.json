  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲩⲉϭⲓⲫⲉⲓ ⲛϫⲉⲛⲉϥϩⲑⲱⲣ ⲉϩⲟⲧⲉ ⲛⲓⲡⲁⲣⲇⲁⲗⲓⲥ ⲥⲉⲁⲥⲓⲱⲟⲩ ⲉϩⲟⲧⲉ ⲛⲓⲟⲩⲱⲛϣ ⲛⲧⲉϯⲁⲣⲁⲃⲓⲁ ⲟⲩⲟϩ ⲉⲩⲉⲫⲱⲧ ⲛϫⲉⲛⲓϭⲁⲥⲓϩⲑⲟ ϩⲓϫⲉⲛⲛⲓϩⲑⲱⲣ ⲟⲩⲟϩ ⲉⲩⲉϯ ⲙⲡⲟⲩⲟⲩⲟⲓ ϩⲓⲫⲟⲩⲉⲓ ⲟⲩⲟϩ ⲉⲩⲉϩⲁⲗⲁⲓ ⲙⲫⲣⲏϯ ⲛⲟⲩ**ⲁϧⲱⲙ** ⲉϥⲥⲉⲃⲧⲱⲧ ⲉⲟⲩⲱⲙ .",
      "english": "And his horses shall bound more swiftly than leopards, and they are fiercer than the wolves of Arabia: and his horsemen shall ride forth, and shall rush from far; and they shall fly as an eagle hasting to eat.",
      "source": "Bohairic Habakkuk 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲕⲣⲉⲧⲧⲛϩ ⲛⲧϩⲉ ⲛⲟⲩⲁⲉⲧⲟⲥ ⁛— ⲁⲩⲱ ⲁⲕϣⲓⲃⲉ ϩⲛⲧϭⲟⲙ ⲛⲧⲙⲛⲧⲣⲉϥϣⲙϣⲉⲛⲟⲩⲧⲉ · ⲛⲧϩⲉ ⲛⲟⲩ**ⲁϩⲱⲙ** ·",
      "english": "Thou didst spread out thy wing like the eagle, and thou wast transformed in the strength of the service of God like a young, strong eagle.",
      "source": "Life of Pisentius part 2",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:32-58",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲛⲑⲱⲧⲉⲛ ⲡⲉ ⲉⲧⲁⲣⲉⲧⲉⲛⲛⲁⲩ ⲉϩⲱⲃ ⲛⲓⲃⲉⲛ ⲉⲧⲁⲓⲁⲓⲧⲟⲩ ⲛⲛⲓⲣⲉⲙⲛⲭⲏⲙⲓ ⲟⲩⲟϩ ⲁⲓϭⲓ ⲑⲏⲛⲟⲩ ⲙⲫⲣⲏϯ ϩⲓϫⲉⲛϩⲁⲛⲧⲉⲛϩ ⲛⲧⲉϩⲁⲛ**ⲁϧⲱⲙ** ⲟⲩⲟϩ ⲁⲓⲥⲉⲕ ⲑⲏⲛⲟⲩ ϩⲁⲣⲟⲓ",
      "english": "Ye have seen all that I have done to the Egyptians, and I took you up as upon eagles' wings, and I brought you near to myself.",
      "source": "02_Exodus_19",
      "urn": "urn:cts:copticLit:ot.exod.bohairic_ed:19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲟⲧⲉ ⲁϥϫⲱⲣⲡ ⲛϭⲓⲛϯⲃⲥ ⲙⲡⲉϩⲧⲟ ϩⲛⲟⲩϣⲧⲟⲣⲧⲣ ⲁⲩⲱ ⲡⲁϯⲃⲥ ⲛ**ⲁϩⲱⲙ** ⲉϩⲣⲁⲓ ⲉϫⲱⲟⲩ ⲉⲩⲛⲁⲡⲱⲧ ⲉⲧⲱⲛ ⲛϭⲓⲛⲉϥϫⲱⲱⲣⲉ",
      "english": "When the hoofs of the horse were entangled, his mighty ones earnestly hasted",
      "source": "Judges 5",
      "urn": "urn:cts:copticLit:ot.judg.coptot:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁⲓ ⲛⲛⲉⲧⲉⲛⲟⲩⲱⲙ ⲉⲃⲟⲗ ⲛϧⲏⲧⲟⲩ ⲡⲓ**ⲁϧⲱⲙ** ⲡⲓⲛⲟⲩⲣⲓ ⲡⲓⲛⲟϣⲉⲣ ⲡⲓⲁⲗⲓⲉⲧⲟⲛ",
      "english": "And these of them ye shall not eat; the eagle, and the ossifrage, and the sea-eagle,",
      "source": "05_Deuteronomium_14",
      "urn": "urn:cts:copticLit:ot.deut.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲉϩⲓⲏ ⲛⲟⲩ**ⲁϩⲱⲙⲉ** ⲉϥϩⲏⲗ ⲁⲩⲱ ⲛⲉϩⲓⲟⲟⲩⲉ ⲛⲟⲩϩⲟϥ ϩⲓⲟⲩⲡⲉⲧⲣⲁ ⲙⲛⲛⲉϩⲓⲟⲟⲩⲉ ⲛⲟⲩϫⲟⲉⲓ ⲉϥⲣϩⲱⲧ ⲁⲩⲱ ⲛⲉϩⲓⲟⲟⲩⲉ ⲛⲟⲩⲣⲱⲙⲉ ⲉϥϩⲛⲧⲉϥⲙⲛⲧⲕⲟⲩⲓ",
      "english": "the track of a flying eagle; and the ways of a serpent on a rock; and the paths of a ship passing through the sea; and the ways of a man in youth.",
      "source": "Proverbs 30",
      "urn": "urn:cts:copticLit:ot.prov.coptot:30",
      "dialect": "sahidic"
    }
