  "examples": [
    {
      "coptic": "ϥⲱϯ ⲛⲟⲩ**ⲥⲡⲉⲣⲙⲁ** ⲉⲃⲟⲗϧⲉⲛ ⲃⲁⲃⲩⲗⲱⲛ ⲛⲉⲙⲫⲏⲉⲧⲁⲙⲟⲛⲓ ⲛⲟⲩⲱⲥϧ ϧⲉⲛⲡⲥⲏⲟⲩ ⲙⲡⲱⲥϧ ⲉⲃⲟⲗϩⲁ ⲡϩⲟ ⲛⲟⲩⲥⲏϥⲓ ⲛⲟⲩⲉⲓⲛⲓⲛ ⲟⲩⲟϩ ⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ⲉϥⲉⲫⲱⲧ ⲉϧⲟⲩⲛ ⲉⲡⲉϥⲕⲁϩⲓ .",
      "english": "Utterly destroy seed out of Babylon, and him that holds a sickle in time of harvest: for fear of the Grecian sword, they shall return every one to his people, and every one shall flee to his own land.",
      "source": "24_Ieremias_27",
      "urn": "urn:cts:copticLit:ot.jer.bohairic_ed:27",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲉⲛⲉⲃⲟⲗ ⲧⲏⲣⲟⲩ ⲛⲉ ϩⲙⲡⲉ**ⲥⲡⲉⲣⲙⲁ** ⲙⲡⲉⲛⲉⲓⲱⲧ ⲁⲃⲣⲁϩⲁⲙ ·",
      "english": "are all from the seed of our father Abraham,",
      "source": "Abraham Our Father: YA 547-50",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbya:37-42",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥϫⲱⲛⲧ ⲛϫⲉⲡⲓⲇⲣⲁⲕⲱⲛ ϩⲓϫⲉⲛϯⲥϩⲓⲙⲓ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ⲉⲓⲣⲓ ⲛⲟⲩⲃⲱⲧⲥ ⲛⲉⲙⲡⲥⲉⲡⲓ ⲙⲡ**ⲥⲡⲉⲣⲙⲁ** ⲛϯⲥϩⲓⲙⲓ ⲛⲏ ⲉⲧⲁⲣⲉϩ ⲉⲛⲓⲉⲛⲧⲟⲗⲏ ⲛⲧⲉⲫⲛⲟⲩϯ ⲛⲉⲙϯⲙⲉⲧⲙⲉⲑⲣⲉ ⲛⲧⲉⲓⲏⲥⲟⲩⲥ .",
      "english": "The dragon grew angry with the woman, and went away to make war with the rest of her seed, who keep God's commandments and hold Jesus' testimony.",
      "source": "27_Revelation_12",
      "urn": "urn:cts:copticLit:nt.rev.bohairic:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧⲉⲡⲉⲕⲏⲓ ϣⲱⲡⲉ ⲛⲧϩⲉ ⲙⲡⲏⲓ ⲙⲫⲁⲣⲉⲥ ⲡⲁⲓ ⲉⲛⲧⲁⲑⲁⲙⲁⲣ ϫⲡⲟϥ ⲛⲓⲟⲩⲇⲁⲥ ⲉⲃⲟⲗ ϩⲙⲡⲉⲕ**ⲥⲡⲉⲣⲙⲁ** ⲉⲧⲉⲣⲉⲡϫⲟⲉⲓⲥ ⲛⲁⲧⲁⲁϥ ⲛⲁⲕ ⲉⲃⲟⲗ ϩⲛⲧⲉⲓϣⲉⲉⲣⲉ ϣⲏⲙ",
      "english": "And let thy house be as the house of Phares, whom Thamar bore to Juda, of the seed which the Lord shall give thee of this handmaid.",
      "source": "Ruth Chapter 4",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲉⲣⲟⲩⲱ ⲉⲩϫⲱ ⲙⲙⲟⲥ ⲛⲁϥ ϫⲉⲁⲛⲟⲛ ⲛⲁⲡ**ⲥⲡⲉⲣⲙⲁ** ⲛⲁⲃⲣⲁⲁⲙ ⲟⲩⲟϩ ⲙⲡⲉⲛⲉⲣⲃⲱⲕ ⲛϩⲗⲓ ⲉⲛⲉϩ ⲡⲱⲥ ⲛⲑⲟⲕ ⲕϫⲱ ⲙⲙⲟⲥ ϫⲉⲉⲣⲉⲧⲉⲛⲉⲣⲣⲉⲙϩⲉ .",
      "english": "They answered him, 'We are Abraham's seed, and have never been in bondage to anyone. How do you say, 'You will be made free?''",
      "source": "04_John_08",
      "urn": "urn:cts:copticLit:nt.john.bohairic:08",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡⲙⲉϩⲥⲛⲁⲩ ⲁϥϫⲓⲧⲥ ⲁⲩⲱ ⲁϥⲙⲟⲩ ⲉⲙⲡϥⲕⲁ**ⲥⲡⲉⲣⲙⲁ** . ⲁⲩⲱ ⲡⲙⲉϩϣⲟⲙⲛⲧ ϩⲟⲙⲟⲓⲱⲥ",
