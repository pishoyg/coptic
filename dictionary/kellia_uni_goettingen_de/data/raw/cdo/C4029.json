  "examples": [
    {
      "coptic": "ⲧⲟⲧⲉ ⲗⲟⲓⲡⲟⲛ ⲁⲓⲉⲓⲙⲉ ⲉⲡⲁⲓ ϫⲉϩⲱⲃ ⲛⲓⲙ ⲉⲧⲉⲣⲉⲛⲉⲧⲟⲩⲁⲁⲃ ⲉⲓⲣⲉ ⲙⲙⲟⲟⲩ ⲡⲛⲟⲩⲧⲉ **ϯ **ⲛⲧⲟⲟⲧ**ⲟⲩ** ·",
      "english": "And finally I understood that in everything that the saints perform it is God Who helpeth them.",
      "source": "Life of Cyrus in Budge ed. part 1",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲟⲟⲩ ⲇⲉ ϩⲱⲟⲩ ⲛⲧⲉⲣⲟⲩⲉⲓ ⲉⲃⲟⲗ ⲁⲩⲧⲁϣⲉⲟⲉⲓϣ ϩⲙⲙⲁ ⲛⲓⲙ ⲉⲣⲉⲡϫⲟⲉⲓⲥ **ϯⲛⲧⲟⲟⲧ**ⲟⲩ . ⲁⲩⲱ ⲉϥⲧⲁϫⲣⲟ ⲙⲡϣⲁϫⲉ ϩⲓⲧⲛⲙⲙⲁⲉⲓⲛ ⲉⲧⲟⲩⲏϩ ⲛⲥⲱⲟⲩ .",
      "english": "They went out, and preached everywhere, the Lord working with them, and confirming the word by the signs that followed. Amen.",
      "source": "41_Mark_16",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:16",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲉϥϯ **ⲛⲧⲟⲟⲧ**ⲟⲩ** ⲛⲛⲉⲧⲟⲩϫⲓ ⲙⲙⲟⲟⲩ ⲛϭⲟⲛⲥ · ⲛⲉⲧⲕⲏⲕⲁϩⲏⲩ ϥϯϩⲓⲱⲟⲩ · ⲛⲉⲧϩⲕⲟⲉⲓⲧ ⲉϥⲥⲁⲛϣ ⲙⲙⲟⲟⲩ ·",
      "english": "He helped those who were suffering oppression, and those who were naked he clothed, and he provided food for those who were hungry,",
      "source": "History of Eustathius and Theopiste part 1",
      "urn": "urn:cts:copticLit:lives.eustathius.budge:1-30",
      "dialect": "sahidic"
    }
  ],
