  "examples": [
    {
      "coptic": "ⲕⲁⲓ ⲟⲩⲁⲓ ⲇⲉ ⲟⲛ ⲉⲡⲉϥⲣⲁⲛ ⲡⲉ ⲓⲁⲛⲛⲏ ⲫⲁⲓ ⲇⲉ ⲟⲩⲅⲉⲛⲟⲥ ⲉⲧϭⲟⲥⲓ ⲡⲉ ⲉϥⲟⲓ ⲛϣⲏⲣⲓ ⲙⲫⲏ ⲉⲑⲟⲩⲁⲃ ⲛⲉⲟⲩⲉⲃⲟⲗ ⲡⲉ ϧⲉⲛⲧϩⲁⲓⲣⲉⲥⲓⲥ ⲛⲛⲓⲁⲧⲥⲙⲟⲩ ⲛⲁⲓ ⲉⲧϫⲱ ⲙⲙⲟⲥ ϫⲉⲓⲥϫⲉⲛ ⲡⲓϩⲁⲅⲓⲟⲥ ⲇⲓⲟⲥⲕⲟⲣⲟⲥ ⲙⲡⲉⲁⲣⲭⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ϣⲱⲡⲓ ⲉϫⲱⲟⲩ ϧⲉⲛⲫⲁⲓ ⲁⲩⲡⲱⲣϫ ⲥⲁⲃⲟⲗ ⲛⲛⲓⲉⲕⲕⲗⲏⲥⲓⲁ ⲁⲩ**ϣⲱⲡⲓ** ⲛϩⲁⲓⲣⲉⲧⲓⲕⲟⲥ .",
      "english": "And another whose name was Ianni, who came from a high family and became the son of the saint, and belonged to the heresy of the accursed ones who say that, since the time of the holy Dioscorus, there has been no patriarch for them: in this they have divided the churches and become heretics.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲉ ⲭⲣⲏⲙⲁ ϩⲁⲙⲟⲓ ⲛⲧⲟⲟⲩⲛ · ⲉⲛⲉⲙⲡⲉ ⲡⲛⲟⲩⲃ **ϣⲱⲡⲉ**",
      "english": "For money, oh would that gold did not exist!",
      "source": "I See Your Eagerness: GL 29-30",
      "urn": "urn:cts:copticLit:shenoute.eagerness.monbgl_29_30",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲧⲉⲕϣⲱⲡⲓ ⲉⲕⲛⲏⲟⲩ ⲉⲧϩⲏ ϧⲉⲛϯⲡⲣⲟⲕⲟⲡⲏ ⲛⲧⲉⲛⲓⲙⲉⲩⲓ ⲛⲧⲉⲫⲛⲟⲩϯ ⲛⲉⲙϯⲙⲉⲧϣⲁⲙϣⲉⲛⲟⲩϯ ⲉⲧⲧⲟⲩⲃⲏⲟⲩⲧ ⲟⲩⲟϩ ⲛⲧⲉⲕ**ϣⲱⲡⲓ** ⲉⲕⲟⲓ ⲉϭⲁⲩⲙⲱⲓⲧ ⲛⲁⲕ ⲛⲉⲙⲛⲏ ⲉⲑⲛⲉⲙⲁⲕ ⲛⲉⲙⲛⲏ ⲉⲑⲛⲏⲟⲩ ϩⲁⲣⲟⲕ ⲛⲉⲙⲛⲓϣⲁⲙϣⲉⲛⲟⲩϯ ⲛⲟⲩⲣⲱⲟⲩ",
      "english": "In this way, you will become one who progresses in the thought of God and sincere piety, becoming a guide for yourself and for those who are with you, as well as for those who will come to you, and for pious kings.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲇⲉ ⲙⲡⲉⲡⲁⲑⲟⲥ · ⲏ ⲙⲟⲩ ⲛⲧⲟϥ ⲛⲁⲧⲛⲟⲃⲉ **ϣⲱⲡⲉ** ⲉⲛⲉϩ ⲙⲙⲁ ⲛⲟⲩⲱⲧϩ ⲙⲡⲛⲟⲃⲉ ·",
      "english": "Never before did there exist passion and death, which were without sin, in the smelting furnace of sin.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ϥⲛⲁ**ϣⲱⲡⲓ** ⲛⲥⲟⲗⲥⲉⲗ ⲛⲉⲙⲥⲕⲉⲡⲓ ⲛⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲑⲛⲁϣⲉ ⲉⲣⲁⲧϥ ⲙⲡⲉϥⲧⲟⲡⲟⲥ ⲟⲩⲟϩ ⲧⲉϥⲉⲕⲕⲗⲏⲥⲓⲁ ⲥⲛⲁϣⲱⲡⲓ ⲉⲥⲙⲏⲛ ⲉⲃⲟⲗ ϣⲁϩⲁⲛϫⲱⲟⲩ .",
      "english": "He will build a monastery, and he will become a jewel and a protector for anyone who will come before his place, and his church will remain for generations.”",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲛⲧⲁϥⲁⲁⲧ ⲛϣⲙⲙⲟ ⲉⲧⲙⲁⲛⲓⲁ ⲉⲧϩⲟⲟⲩ · ⲧⲁⲓ ⲉⲧ**ϣⲟⲟⲡ** ϩⲛⲧⲥⲁⲣⲝ ⲉⲁϥⲧⲣⲁⲟⲩⲉ ⲉⲃⲟⲗ ⲙⲡⲙⲟⲩ ⲉⲧⲥⲁϣⲉ ·",
      "english": "Thou it was Who didst make me to become a stranger to the madness of evil which ariseth in the flesh, and didst make me to be remote from the death which is bitter.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    }
  ],
