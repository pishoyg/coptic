  "examples": [
    {
      "coptic": "ⲉⲧⲁϥⲛⲁⲩ ⲇⲉ ⲛϫⲉⲡⲓⲉⲕⲁⲧⲟⲛⲧⲁⲣⲭⲟⲥ ⲫⲏ ⲉⲧⲟϩⲓ ⲉⲣⲁⲧϥ ⲙⲡⲉϥⲙⲑⲟ ϫⲉⲁϥϯ ⲙⲡⲓⲡⲛⲉⲩⲙⲁ ⲡⲉϫⲁϥ ϫⲉⲁⲗⲏⲑⲱⲥ ⲡⲁⲓⲣⲱⲙⲓ ⲛⲉⲡ**ϣⲏⲣⲓ** ⲙⲫⲛⲟⲩϯ ⲡⲉ",
      "english": "When the centurion, who stood by opposite him, saw that he cried out like this and breathed his last, he said, 'Truly this man was the Son of God!'",
      "source": "Bohairic Gospel of Mark 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲱ ⲓⲱϩⲁⲛⲛⲏⲥ ⲡⲁ**ϣⲏⲣⲉ** ⲙⲙⲉⲣⲓⲧ ·",
      "english": "O John, my beloved son!",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲑⲃⲉⲫⲁⲓ ⲁⲓⲟⲩⲱⲣⲡ ⲛⲱⲧⲉⲛ ⲛⲧⲓⲙⲟⲑⲉⲟⲥ ⲉⲧⲉⲡⲁ**ϣⲏⲣⲓ** ⲙⲙⲉⲛⲣⲓⲧ ⲡⲉ ⲟⲩⲟϩ ⲙⲡⲓⲥⲧⲟⲥ ϧⲉⲛⲡϭⲟⲓⲥ ⲫⲁⲓ ⲉⲑⲛⲁⲑⲣⲉⲧⲉⲛⲉⲣⲫⲙⲉⲩⲓ ⲛⲛⲁⲙⲱⲓⲧ ϧⲉⲛⲡⲭⲣⲓⲥⲧⲟⲥ ⲓⲏⲥⲟⲩⲥ ⲕⲁⲧⲁⲫⲣⲏϯ ⲉϯϯⲥⲃⲱ ϧⲉⲛⲙⲁⲓ ⲛⲓⲃⲉⲛ ϧⲉⲛⲛⲓⲉⲕⲕⲗⲏⲥⲓⲁ ⲧⲏⲣⲟⲩ .",
      "english": "Because of this I have sent Timothy to you, who is my beloved and faithful child in the Lord, who will remind you of my ways which are in Christ, even as I teach everywhere in every assembly.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲁⲓ ⲛⲉ ⲛⲁⲣⲉⲧⲏ ⲙⲡⲉⲑⲃⲃⲓⲟ · ⲡⲁ**ϣⲏⲣⲉ**",
      "english": "My son, these are the virtues of humility.",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲥⲓ ⲉϧⲟⲩⲛ ⲛϫⲉⲧ**ϣⲉⲣⲓ** ⲛⲏⲣⲱⲇⲓⲁⲥ ⲟⲩⲟϩ ⲉⲧⲁⲥϭⲟⲥϫⲉⲥ ⲁⲥⲣⲁⲛⲁϥ ⲛⲏⲣⲱⲇⲏⲥ ⲛⲉⲙⲛⲏ ⲉⲑⲣⲟⲧⲉⲃ ⲛⲉⲙⲁϥ ⲡⲉϫⲉⲡⲟⲩⲣⲟ ⲇⲉ ⲛϯⲁⲗⲟⲩ ϫⲉⲁⲣⲓⲉⲧⲓⲛ ⲙⲙⲟⲓ ⲙⲡⲉⲧⲉⲟⲩⲁϣϥ ⲛⲧⲁⲧⲏⲓϥ ⲛⲉ .",
      "english": "When the daughter of Herodias herself came in and danced, she pleased Herod and those sitting with him. The king said to the young lady, 'Ask me whatever you want, and I will give it to you.'",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲧⲛⲛⲁⲩ ⲉⲓⲏⲥⲟⲩ ⲡ**ϣⲏⲣⲉ** ⲛⲛⲁⲩⲏ",
