  "examples": [
    {
      "coptic": "ⲡⲉⲟⲟⲩ ⲇⲉ ⲙⲛⲡⲧⲁⲉⲓⲟ ⲙⲛⲧⲉⲓⲣⲏⲛⲏ ⲛⲟⲩⲟⲛ ⲛⲓⲙ ⲉⲧⲣϩⲱⲃ ⲉⲡⲡⲉⲧⲛⲁⲛⲟⲩϥ ⲙⲡⲓⲟⲩⲇⲁⲓ ⲛϣⲟⲣⲡ ⲙⲛⲡ**ⲟⲩⲉⲉⲓⲉⲛⲓⲛ** .",
      "english": "But glory, honor, and peace go to every man who works good, to the Jew first, and also to the Greek.",
      "source": "45_Romans_2",
      "urn": "urn:cts:copticLit:nt.rom.sahidica:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲛⲡⲱⲣϫ ⲅⲁⲣ ϣⲟⲟⲡ ⲙⲡⲓⲟⲩⲇⲁⲓ ⲙⲛⲡ**ⲟⲩⲉⲉⲓⲉⲛⲓⲛ** . ⲡⲓϫⲟⲉⲓⲥ ⲅⲁⲣ ⲛⲟⲩⲱⲧ ⲡⲉ ⲙⲙⲟⲟⲩ ⲧⲏⲣⲟⲩ ⲉϥⲟ ⲛⲣⲙⲙⲁⲟ ⲉⲟⲩⲟⲛ ⲛⲓⲙ . ⲉⲟⲩⲟⲛ ⲛⲓⲙ ⲉⲧⲛⲁⲉⲡⲓⲕⲁⲗⲉⲓ ⲙⲙⲟϥ .",
      "english": "For there is no distinction between Jew and Greek; for the same Lord is Lord of all, and is rich to all who call on him.",
      "source": "45_Romans_10",
      "urn": "urn:cts:copticLit:nt.rom.sahidica:10",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁϥⲕⲁⲧⲁⲛⲧⲁ ⲉⲇⲉⲣⲃⲏ ⲙⲛⲗⲩⲥⲧⲣⲁ . ⲛⲉⲩⲛ ⲟⲩⲙⲁⲑⲏⲧⲏⲥ ⲇⲉ ⲙⲙⲁⲩ ⲉⲡⲉϥⲣⲁⲛ ⲡⲉ ⲧⲓⲙⲟⲑⲉⲟⲥ ⲉⲡϣⲏⲣⲉ ⲡⲉ ⲛⲟⲩⲥϩⲓ ⲙⲉ ⲛⲓⲟⲩⲇⲁⲓ ⲙⲡⲓⲥⲧⲏ . ⲡⲉϥⲉⲓⲱⲧ ⲇⲉ **ⲟⲩⲉⲉⲓⲉⲛⲓⲛ** ⲡⲉ .",
      "english": "He came to Derbe and Lystra: and behold, a certain disciple was there, named Timothy, the son of a Jewess who believed; but his father was a Greek.",
      "source": "44_Acts of the Apostles_16",
      "urn": "urn:cts:copticLit:nt.acts.sahidica:16",
      "dialect": "sahidic"
    }
