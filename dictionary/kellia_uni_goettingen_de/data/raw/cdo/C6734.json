  "examples": [
    {
      "coptic": "ⲫⲏ ⲉⲧⲁϥⲛⲁϩϯ ⲟⲩⲟϩ ⲉⲧⲁϥϭⲓⲱⲙⲥ ⲉϥⲉⲛⲟϩⲉⲙ ⲫⲏ ⲇⲉ ⲉⲧⲁϥⲉⲣⲁⲑⲛⲁϩϯ ⲥⲉⲛⲁ**ϯϩⲁⲡ** ⲉⲣⲟϥ .",
      "english": "He who believes and is baptized will be saved; but he who disbelieves will be condemned.",
      "source": "Bohairic Gospel of Mark 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲗⲏⲛ **ϯϩⲁⲡ** ⲉⲣⲟⲕ ⲙⲙⲏⲛⲉ ·",
      "english": "thou shall pass judgement on thyself daily.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϣⲁⲛ ⲧⲉⲧⲉⲛⲉⲙⲓ ⲁⲛ ϫⲉⲛⲓⲁⲅⲓⲟⲥ ⲉⲑⲛⲁϯϩⲁⲡ ⲉⲡⲓⲕⲟⲥⲙⲟⲥ ⲟⲩⲟϩ ⲓⲥϫⲉ ⲡⲓⲕⲟⲥⲙⲟⲥ ⲉⲩⲛⲁ**ϯϩⲁⲡ** ⲉⲣⲟϥ ϧⲉⲛⲑⲏⲛⲟⲩ ⲛⲁⲣⲉⲧⲉⲛⲙⲡϣⲁ ⲁⲛ ϫⲉⲛϩⲁⲛⲕⲟⲩϫⲓ ⲙⲙⲁ ⲛϯϩⲁⲡ .",
      "english": "Don't you know that the saints will judge the world? And if the world is judged by you, are you unworthy to judge the smallest matters?",
      "source": "Bohairic 1 Corinthians 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲥϣⲱⲡⲉ ⲇⲉ ⲛⲧⲉⲣⲉⲛⲉⲕⲣⲓⲧⲏⲥ ϩⲙⲟⲟⲥ ⲉ**ϯϩⲁⲡ** ⲁⲩϩⲉⲃⲱⲱⲛ ϣⲱⲡⲉ ϩⲙⲡⲕⲁϩ ⲁⲩⲱ ⲁϥⲃⲱⲕ ⲛϭⲓⲟⲩⲣⲱⲙⲉ ⲉⲟⲩⲉⲃⲟⲗ ⲡⲉ ϩⲛⲃⲏⲑⲗⲉⲉⲙ ⲙⲡⲕⲁϩ ⲛⲓⲟⲩⲇⲁ ⲉⲧⲣⲉϥϭⲟⲓⲗⲉ ⲉⲧⲥⲱϣⲉ ⲙⲙⲱⲁⲃ ⲛⲧⲟϥ ⲙⲛⲧⲉϥⲥϩⲓⲙⲉ ⲙⲛⲡⲉϥϣⲏⲣⲉ ⲥⲛⲁⲩ",
      "english": "And it came to pass when the judges ruled, that there was a famine in the land: and a man went from Bethleem Juda to sojourn in the land of Moab, he, and his wife, and his two sons.",
      "source": "Ruth Chapter 1",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲣⲟⲩ ⲅⲁⲣ ⲛⲏⲓ ⲉϯϩⲁⲡ ⲉⲛⲏ ⲉⲧⲥⲁⲃⲟⲗ ⲛⲏ ⲉⲧⲥⲁϧⲟⲩⲛ ⲛⲑⲱⲧⲉⲛ **ⲙⲁϩⲁⲡ** ⲉⲣⲱⲟⲩ",
      "english": "For what have I to do with also judging those who are outside? Don't you judge those who are within?",
      "source": "Bohairic 1 Corinthians 5 (Digital Edition)",
