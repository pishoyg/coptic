  "examples": [
    {
      "coptic": "ⲫⲏ ⲇⲉ ⲉⲧⲟϩⲓ ⲉⲣⲁⲧϥ ϧⲉⲛⲡⲉϥϩⲏⲧ ⲉϥⲧⲁϫⲣⲏⲟⲩⲧ ⲙⲙⲟⲛ**ⲁⲛⲁⲅⲕⲏ** ⲧⲟⲓ ⲉⲣⲟϥ ⲟⲩⲟⲛⲧⲉϥ ⲉⲣϣⲓϣⲓ ⲙⲙⲁⲩ ⲉⲑⲃⲉⲡⲉⲧⲉϩⲛⲁϥ ⲙⲙⲓⲛⲙⲙⲟϥ ⲟⲩⲟϩ ⲫⲁⲓ ϥϯϩⲁⲡ ⲉⲣⲟϥ ⲙⲙⲓⲛⲙⲙⲟϥ ϧⲉⲛⲡⲉϥϩⲏⲧ ⲉⲁⲣⲉϩ ⲉⲧⲉϥⲡⲁⲣⲑⲉⲛⲟⲥ ⲕⲁⲗⲱⲥ ϥⲛⲁⲁⲓⲥ .",
      "english": "But he who stands steadfast in his heart, having no necessity, but has power over his own heart, to keep his own virgin, does well.",
      "source": "Bohairic 1 Corinthians 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓⲥϩⲏⲏⲧⲉ ⲕⲛⲁⲩ ⲉⲣⲟⲓ ϩⲛⲧⲁ**ⲁⲛⲁⲅⲕⲏ** ·",
      "english": "Behold thou seest me thyself in my necessity.",
      "source": "Life of Pisentius part 3",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:58-84",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲩϩⲟⲕⲉⲣ ⲟⲩⲟϩ ⲉⲩⲟⲃⲓ ⲁⲥⲙⲟⲩⲛⲕ ⲛϧⲏⲧⲟⲩ ⲛϫⲉⲧⲟⲩⲩⲭⲏ ⲟⲩⲟϩ ⲁⲩⲱϣ ⲉϩⲣⲏⲓ ϩⲁⲡϭⲟⲓⲥ ϧⲉⲛⲡϫⲓⲛⲧⲟⲩϩⲟϫϩⲉϫ ⲟⲩⲟϩ ⲁϥⲛⲁϩⲙⲟⲩ ⲉⲃⲟⲗ ϧⲉⲛⲛⲟⲩ**ⲁⲛⲁⲅⲕⲏ**",
      "english": "Hungry and thirsty, their soul fainted in them.",
      "source": "19_Psalmi_106",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:106",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲣⲓⲡⲙⲉⲉⲩⲉ ⲛⲧ**ⲁⲛⲁⲅⲕⲏ** ⲛⲛⲕⲟⲗⲁⲥⲓⲥ ·",
      "english": "Remember the tribulations and the punishments.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲡⲁⲅⲅⲉⲗⲟⲥ ⲛⲁϥ ϫⲉⲓⲥϫⲉ ⲭⲛⲁⲥⲱⲧⲉⲙ ⲛⲥⲱⲓ ⲁⲛⲟⲕ ϧⲁⲡⲉⲕϣⲫⲏⲣ ⲓⲉ ⲥⲉⲣⲛⲟϥⲣⲓ ⲛⲁⲕ ⲁⲛ ϫⲉⲉϣⲱⲡⲓ ϧⲉⲛⲧⲁⲓⲃⲁⲕⲓ . ⲡⲉϫⲉⲉⲩⲁⲅⲣⲓ ⲛⲁϥ ϫⲉⲉϣⲱⲡ ⲛⲧⲉⲫⲛⲟⲩϯ ⲥⲟⲧⲧ ⲉⲃⲟⲗ ϧⲉⲛⲧⲁⲓ**ⲁⲛⲁⲅⲕⲏ** ⲟⲩⲟϩ ⲛⲧⲉⲕⲛⲁⲩ ⲉⲣⲟⲓ ϧⲉⲛⲧⲁⲓⲃⲁⲕⲓ ⲕⲱⲥⲧⲁⲛⲧⲓⲛⲟⲩⲡⲟⲗⲓⲥ ⲁϫⲟⲥ ϫⲉⲕⲁⲗⲱⲥ ⲁⲕϭⲓ ⲛⲧⲁⲓⲇⲓⲙⲱⲣⲓⲁ ⲑⲁⲓ . ⲡⲉϫⲉⲡⲓⲁⲅⲅⲉⲗⲟⲥ ⲛⲁϥ ⲉϥⲟⲓ ⲙⲫⲣⲏϯ ⲛⲟⲩϣⲫⲏⲣ ⲛⲧⲁϥ ϫⲉϯⲛⲁⲓⲛⲓ ⲛⲁⲕ ⲙⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ⲱⲣⲕ ⲛⲏⲓ ϫⲉϯⲛⲁϣⲱⲡⲓ ⲁⲛ ϫⲉϧⲉⲛⲧⲁⲓⲡⲟⲗⲓⲥ ⲟⲩⲟϩ ⲭⲛⲁϥⲓⲣⲱⲟⲩϣ ϧⲁⲡⲟⲩϫⲁⲓ ⲛⲧⲉⲕⲯⲩⲭⲏ ⲁⲛⲟⲕ ϯⲛⲁⲛⲁϩⲙⲉⲕ ⲉⲃⲟⲗ ϧⲉⲛⲧⲁⲓⲁⲅⲁⲡⲏ .",
      "english": "The angel said to him: 'If you listen to me, your friend, surely it is not good for you to remain in this city.’ Evagrius said: ‘If God frees me from this necessity and you see me again in this city of Constantinople, say to me: 'You have deserved this punishment by right.'‘ But the angel, who had taken the form of a friend, said to him: ‘I will bring you the Gospel; swear to me: 'I will not remain in this city.' What is good for your soul, the Lord will provide, and I will free you from this necessity.’",
      "source": "Bohairic Lausiac History - Part 3",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:38",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϯⲙⲉⲉⲩⲉ ϭⲉ ϫⲉⲛⲁⲛⲟⲩⲡⲁⲓ ⲉⲧⲃⲉⲧ**ⲁⲛⲁⲅⲕⲏ** ⲉⲧϣⲟⲟⲡ . ϫⲉⲛⲁⲛⲟⲩⲥ ⲙⲡⲣⲱⲙⲉ ⲉϭⲱ ⲛⲧⲉⲓϩⲉ .",
      "english": "I think that it is good therefore, because of the distress that is on us, that it is good for a man to be as he is.",
      "source": "1 Corinthians 7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:7",
      "dialect": "sahidic"
    }
