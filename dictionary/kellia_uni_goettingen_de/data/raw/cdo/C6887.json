  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲣⲉⲡⲓⲟⲩⲏⲃ ⲱⲗⲓ ⲉⲃⲟⲗ ϧⲉⲛⲡⲓⲥⲛⲟϥ ⲛⲧⲉⲫⲏ ⲉⲧⲉⲉⲑⲃⲉϯⲙⲉⲧϣⲁϥⲧ ⲟⲩⲟϩ ⲉϥⲉⲧⲁⲗⲟ ⲛϫⲉⲡⲓⲟⲩⲏⲃ ⲉϫⲉⲛⲡⲓⲗⲟⲃⲟⲥ ⲛⲧⲉⲫⲙⲁϣϫ ⲛⲟⲩⲓⲛⲁⲙ ⲛⲧⲉⲫⲏ ⲉⲧⲧⲟⲩⲃⲟ ⲙⲙⲟϥ ⲛⲉⲙⲉϫⲉⲛ**ϩⲏⲧ**ⲥ ⲛⲧⲉϥϫⲓϫ ⲛⲟⲩⲓⲛⲁⲙ ⲛⲉⲙⲉϫⲉⲛϩⲏⲧⲥ ⲛⲧⲉϥⲫⲁⲧ ⲛⲟⲩⲓⲛⲁⲙ",
      "english": "And the priest shall take of the blood of the trespass-offering, and the priest shall put it on the tip of the right ear of the person under cleansing, and on the thumb of his right hand, and on the great toe of his right foot.",
      "source": "03_Leviticus_14",
      "urn": "urn:cts:copticLit:ot.lev.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϩⲉⲛⲕⲟⲟⲩⲉ ⲇⲉ ⲙⲕⲁϩ ⲛ**ϩⲏⲧ** ·",
      "english": "But some others were troubled,",
      "source": "Apophthegmata Patrum Sahidic 139: N 306",
      "urn": "urn:cts:copticLit:ap.139.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲕⲉϧⲉⲗϧⲱⲗϥ ⲟⲩⲟϩ ⲉⲕⲉϭⲓ ⲉⲃⲟⲗ ϧⲉⲛⲡⲉϥⲥⲛⲟϥ ⲟⲩⲟϩ ⲉⲕⲉⲭⲱ ϩⲓϫⲉⲛⲡⲓⲗⲟⲃⲟⲥ ⲛⲧⲉⲫⲙⲁϣϫ ⲛⲟⲩⲓⲛⲁⲙ ⲛⲁⲁⲣⲱⲛ ⲛⲉⲙϩⲓϫⲉⲛ**ϩⲏⲧ**ⲥ ⲛϯϫⲓϫ ⲛⲟⲩⲓⲛⲁⲙ ⲛⲉⲙϩⲓϫⲉⲛϩⲏⲧⲥ ⲛϯⲫⲁⲧ ⲛⲟⲩⲓⲛⲁⲙ ⲛⲉⲙϩⲓϫⲉⲛⲛⲓⲗⲟⲃⲟⲥ ⲛⲧⲉⲛⲉⲛⲙⲁϣϫ ⲛⲟⲩⲓⲛⲁⲙ ⲛⲧⲉⲛⲉϥϣⲏⲣⲓ ⲛⲉⲙϩⲓϫⲉⲛϩⲏⲧⲟⲩ ⲛⲛⲟⲩϫⲓϫ ⲛⲟⲩⲓⲛⲁⲙ ⲛⲉⲙϩⲓϫⲉⲛϩⲏⲧⲟⲩ ⲛⲛⲟⲩⲫⲁⲧ ⲛⲟⲩⲓⲛⲁⲙ",
      "english": "And thou shalt kill it, and take of the blood of it, and put it on the tip of Aaron's right ear, and on the thumb of his right hand, and on the great toe of his right foot, and on the tips of the right ears of his sons, and on the thumbs of their right hands, and on the great toes of their right feet.",
      "source": "02_Exodus_29",
      "urn": "urn:cts:copticLit:ot.exod.bohairic_ed:29",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲡⲁⲉⲓⲱⲧ ⲁⲃⲣⲁϩⲁⲙ ⲙⲁⲧⲛⲛⲟⲟⲩ ⲗⲁⲍⲁⲣⲟⲥ ⲛϥⲥⲡ**ϩⲧⲏ**ϥ ⲙⲡⲉϥⲧⲏⲏⲃⲉ ⲙⲙⲟⲟⲩ ⲛϥⲕⲃⲉⲡⲁⲗⲁⲥ · ϫⲉϯⲙⲟⲕϩ ⲁⲛⲟⲕ ϩⲙⲡⲉⲓⲕⲱϩⲧ ⲟⲩⲇⲉ ϩⲱⲱϥ ⲛϫⲡⲓⲟ · ⲡⲉⲛⲧⲁϥⲥⲱⲧⲙ ⲉⲣⲟϥ ·",
      "english": "'My father Abraham, let them send Lazarus, and let him dip the tip of his finger in water, and cool my tongue therewith, for I am tortured in this fire.' And what he heard was it not words of rebuke?",
      "source": "Life of Pisentius part 2",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:32-58",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲑⲟϥ ⲉⲧⲁϥⲙⲟⲩϯ ⲡⲉϫⲁϥ ϫⲉⲡⲁⲓⲱⲧ ⲁⲃⲣⲁⲁⲙ ⲛⲁⲓ ⲛⲏⲓ ⲟⲩⲟϩ ⲟⲩⲱⲣⲡ ⲛⲗⲁⲍⲁⲣⲟⲥ ϩⲓⲛⲁ ⲛⲧⲉϥⲥⲉⲡ **ϩⲑⲏ**ϥ ⲙⲡⲉϥⲧⲏⲃ ⲙⲙⲱⲟⲩ ⲟⲩⲟϩ ⲛⲧⲉϥϯⲭⲃⲟⲃ ⲙⲡⲁⲗⲁⲥ ϫⲉϯⲙⲟⲕϩ ⲛϧⲣⲏⲓ ϧⲉⲛⲡⲁⲓϣⲁϩ .",
      "english": "He cried and said, 'Father Abraham, have mercy on me, and send Lazarus, that he may dip the tip of his finger in water, and cool my tongue! For I am in anguish in this flame.'",
      "source": "03_Luke_16",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:16",
      "dialect": "bohairic"
    },
