  "examples": [
    {
      "coptic": "ϩⲏⲡⲡⲉ ⲁⲓⲁⲓⲕ ⲙⲫⲣⲏϯ ⲛϩⲁⲛⲧⲣⲟⲭⲟⲥ ⲛⲉⲃⲣⲉϩⲓ ⲉⲩϩⲓ ⲉⲩⲟⲓ ⲙⲃⲉⲣⲓ ⲛⲣⲟ ⲙ**ⲃⲁϣⲟⲩⲣ** ⲉⲕⲉϩⲓ ⲛⲛⲓⲧⲱⲟⲩ ⲟⲩⲟϩ ⲉⲕⲉⲧϣⲙⲟ ⲛⲛⲓⲕⲁⲗⲁⲙⲫⲟ ⲉⲕⲉⲭⲁⲩ ⲙⲫⲣⲏϯ ⲛⲟⲩⲣⲏⲓⲥⲓ .",
      "english": "Behold, I have made thee as new saw-shaped threshing wheels of a waggon; and thou shalt thresh the mountains, and beat the hills to powder, and make them as chaff:",
      "source": "23_Isaias_41",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲡϫⲁϫⲉ ⲕⲱϩ ⲉⲣⲟⲕ ⲉⲣⲟⲕ ⲛⲧϩⲉ ⲛⲏⲥⲁⲓⲁⲥ ⲡⲉⲡⲣⲟⲫⲏⲧⲏⲥ · ⲡⲁⲓ ⲛⲧⲁⲩⲟⲩⲁⲥⲧϥ ϩⲛⲟⲩ**ⲃⲁϣⲟⲩⲣ** ⲛϣⲉ · ⲁⲩⲱ ⲙⲡⲉⲡⲕⲱϩⲧ ϫⲱϩ ⲉⲣⲟⲕ ⲛⲧϩⲉ ⲙⲡϣⲟⲙⲛⲧ ⲛϩⲁⲅⲓⲟⲥ · ⲉⲧⲉⲙⲡⲉⲡⲕⲱϩⲧ ⲛⲛⲁⲃⲟⲩⲭⲟⲇⲟⲛⲟⲥⲟⲣ ϫⲱϩ ⲉⲣⲟⲟⲩ ·",
      "english": "The Enemy hath been envious of thee as he was of Isaiah the Prophet, whose body they sawed in twain lengthwise with a wood saw. And the fire hath not touched thee, even as the fire of Nebuchadnezzar touched not the Three Holy (Children).",
      "source": "Martyrdom of Victor part 7",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:67-85",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏ ϥⲛⲁϭⲓⲱⲟⲩ ⲛϫⲉⲟⲩⲕⲉⲗⲉⲃⲓⲛ ⲁⲧϭⲛⲉⲫⲏⲉⲧⲕⲱⲣϫ ⲙⲙⲟϥ ⲓⲉ ⲥⲛⲁϭⲓⲥⲓ ⲛϫⲉⲟⲩ**ⲃⲁϣⲟⲩⲣ** ⲁⲧϭⲛⲉⲫⲏⲉⲧⲥⲱⲕ ⲙⲙⲟⲥ ⲡⲁⲓⲣⲏϯ ⲟⲛ ⲁⲣⲉϣⲁⲛ ⲟⲩⲁⲓ ϭⲓ ⲛⲟⲩϣⲃⲱⲧ ⲓⲉ ⲟⲩϣⲉ ⲟⲩⲟϩ ⲙⲡⲁⲓⲣⲏϯ ⲁⲛ .",
      "english": "Shall the axe glorify itself without him that hews with it? or shall the saw lift up itself without him that uses it, as if one should lift a rod or staff? but it shall not be so;",
      "source": "23_Isaias_10",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:10",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓⲥ ϩⲏⲏⲧⲉ ⲁⲓⲧⲁⲙⲓⲟⲕ ⲛⲧϩⲉ ⲛϩⲉⲛⲕⲟⲧ ⲛⲁϭⲟⲗⲧⲉ ⲛⲃⲣⲣⲉ ⲛⲣⲉ ⲛ**ⲃⲁϣⲟⲩⲣ** ⲉⲩϩⲓ ⲁⲩⲱ ⲕⲛⲁϩⲓ ⲛⲛⲧⲟⲟⲩ ⲁⲩⲱ ⲛⲅϩⲓⲧⲉ ⲉⲃⲟⲗ ⲛⲛⲥⲓⲃⲧ ⲛⲅⲁⲁⲩ ⲛⲧϩⲉ ⲛⲟⲩϣⲉⲓϣ",
      "english": "Behold, I have made thee as new saw-shaped threshing wheels of a waggon; and thou shalt thresh the mountains, and beat the hills to powder, and make them as chaff:",
      "source": "Isaiah 41",
      "urn": "urn:cts:copticLit:ot.isa.coptot:41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲉϫⲉ ⲡϭⲟⲉⲓⲥ ϫⲉⲉϫⲉⲛϯⲙⲉⲧⲅ ⲛⲁⲥⲉⲃⲏⲥ ⲛⲧⲉⲇⲁⲙⲁⲥⲕⲟⲥ ⲛⲉⲙⲉϫⲉⲛϯⲙⲁϩⲇ ⲛⲛⲁⲧⲁⲥⲑⲟ ⲉⲃⲟⲗϩⲁⲣⲟⲥ ⲉⲫⲙⲁ ϫⲉⲛⲁⲩⲃⲓⲥⲓ ⲡⲉ ϧⲉⲛϩⲁⲛ**ⲃⲁϣⲟⲩⲣ** ⲙⲃⲉⲛⲓⲡⲓ ⲛⲛⲏⲉⲧⲉⲙⲃⲟⲕⲓ ⲛⲧⲉⲛⲏⲉⲧϧⲉⲛ ⲅⲁⲗⲁⲁⲇ .",
      "english": "And the Lord said, For three sins of Damascus, and for four, I will not turn away from it; because they sawed with iron saws the women with child of the Galaadites.",
      "source": "30_Amos_01",
      "urn": "urn:cts:copticLit:ot.amos.bohairic_ed:01",
      "dialect": "bohairic"
    },
