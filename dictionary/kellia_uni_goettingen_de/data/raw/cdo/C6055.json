  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲧⲱⲛϥ ⲇⲉ ⲛ**ϣⲟⲣⲡ** ⲙⲡⲓⲉϩⲟⲟⲩ ⲛϩⲟⲩⲓⲧ ⲛⲧⲉⲛⲓⲥⲁⲃⲃⲁⲧⲟⲛ ⲁϥⲟⲩⲟⲛϩϥ ⲛϣⲟⲣⲡ ⲙⲙⲁⲣⲓⲁ ϯⲙⲁⲅⲇⲁⲗⲓⲛⲏ ⲑⲏ ⲉⲧⲁϥϩⲓ ⲡⲓⲍ ⲛⲇⲁⲓⲙⲱⲛ ⲉⲃⲟⲗ ϩⲓⲱⲧⲥ",
      "english": "Now when he had risen early on the first day of the week, he appeared first to Mary Magdalene, from whom he had cast out seven demons.",
      "source": "Bohairic Gospel of Mark 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲧⲙⲉ ⲙⲙⲟⲥ ⲉϥⲙⲉ ⲙⲡⲱⲛϩ ⲁⲩⲱ ⲛⲉⲧ**ϣⲱⲣⲡ** ⲙⲙⲟⲟⲩ ⲉⲣⲟⲥ ⲥⲉⲛⲁⲥⲓ ⲛⲟⲩⲟⲩⲛⲟϥ",
      "english": "He that loveth her loveth life; and they that seek to her early shall be filled with joy.",
      "source": "Sirach 4",
      "urn": "urn:cts:copticLit:ot.sir.coptot:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲧⲱⲛϥ ⲛϩⲁⲛⲁⲧⲟⲟⲩⲓ ⲛ**ϣⲟⲣⲡ** ⲉⲙⲁϣⲱ ⲁϥⲓ ⲉⲃⲟⲗ ⲉⲩⲙⲁ ⲛϣⲁϥⲉ ⲟⲩⲟϩ ⲛⲁϥⲉⲣⲡⲣⲟⲥⲉⲩⲭⲉⲥⲑⲉ ⲙⲙⲁⲩ",
      "english": "Early in the morning, while it was still dark, he rose up and went out, and departed into a deserted place, and prayed there.",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ϣⲟⲣⲡ**ⲕ ⲟⲩⲛ ⲉϩⲧⲟⲟⲩⲉ ·",
      "english": "Rise thou up then early in the morning,",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲟⲕ ⲇⲉ **ϣⲟⲣⲡ**ⲕ ϩⲁⲡϭⲥ ⲡⲓⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ ⲉⲕⲧⲱⲃϩ ⲙⲙⲟϥ .",
      "english": "But be thou early in prayer to the Lord Almighty.",
