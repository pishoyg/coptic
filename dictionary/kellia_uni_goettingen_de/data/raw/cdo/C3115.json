  "examples": [
    {
      "coptic": "ⲡⲓⲃⲱⲕ ⲅⲁⲣ ⲉⲧⲁⲩⲑⲁϩⲙⲉϥ ϧⲉⲛⲡϭⲟⲓⲥ ⲟⲩⲁⲡⲉⲗⲉⲩⲑⲉⲣⲟⲥ ⲛⲧⲉⲡϭⲟⲓⲥ ⲡⲉ ⲡⲁⲓⲣⲏϯ ⲟⲛ ⲡⲓ**ⲣⲉⲙϩⲉ** ⲉⲧⲁⲩⲑⲁϩⲙⲉϥ ⲟⲩⲃⲱⲕ ⲛⲧⲉⲡⲭⲣⲓⲥⲧⲟⲥ ⲡⲉ .",
      "english": "For he who was called in the Lord being a bondservant is the Lord's free man. Likewise he who was called being free is Christ's bondservant.",
      "source": "Bohairic 1 Corinthians 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡϩⲙϩⲁⲗ ⲅⲁⲣ ⲉⲛⲧⲁⲩⲧⲁϩⲙⲉϥ ϩⲙⲡϫⲟⲉⲓⲥ ⲡⲁⲡⲉⲗⲉⲩⲑⲉⲣⲟⲥ ⲙⲡϫⲟⲉⲓⲥ ⲡⲉ . ϩⲟⲙⲟⲓⲱⲥ ⲡ**ⲣⲙϩⲉ** ⲉⲛⲧⲁⲩⲧⲁϩⲙⲉϥ ⲡϩⲙϩⲁⲗ ⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲡⲉ .",
      "english": "For he who was called in the Lord being a bondservant is the Lord&apos;s free man. Likewise he who was called being free is Christ&apos;s bondservant.",
      "source": "1 Corinthians 7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁⲩϣⲱⲡⲓ ⲟⲩⲛ ϧⲉⲛⲡⲓⲧⲱⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ ⲛⲟⲩⲙⲏϣ ⲛⲉϩⲟⲟⲩ ϣⲁⲋ ⲛⲁⲃⲟⲧ ⲁϥⲥⲁϫⲓ ⲛϫⲉⲫⲏ ⲉⲑⲟⲩⲁⲃ ⲓⲥⲁⲁⲕ ⲛⲉⲙⲡⲓϧⲉⲗⲗⲟ ⲁⲃⲣⲁⲁⲙ ϫⲉⲧⲱⲛⲕ ⲁⲙⲟⲩ ⲛⲉⲙⲏⲓ ϣⲁⲛⲁⲓⲟϯ ⲛⲧⲁⲟⲩⲟⲛϩⲧ ⲉⲣⲱⲟⲩ ϫⲉⲟⲩⲏⲓ ⲁⲓϣⲧⲉⲙⲟⲩⲟⲛϩⲧ ⲉⲣⲱⲟⲩ ⲥⲉⲛⲁⲁⲓⲧ ⲛ**ⲣⲉⲙϩⲉ** ⲁⲛ .",
      "english": "And after they remained on this mountain for a multitude of days, up to six months, Saint Isaac spoke to the old man Abraham and said to him, ‘Arise, come with me to my parents to show me to them, for surely if I do not show myself to them, they will not make me a free man.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ ⲛⲧⲁϣⲱⲡⲉ ⲛⲁⲧⲣⲟⲟⲩϣ ⲁⲩⲱ ⲛ**ⲣⲙϩⲉ**",
      "english": "and I shall be without anxiety and free from blame.'",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲕⲉ ⲅⲁⲣ ⲁⲛⲟⲛ ⲧⲏⲣⲉⲛ ⲉⲧⲁⲛϭⲓⲱⲙⲥ ϧⲉⲛⲟⲩⲡⲛⲉⲩⲙⲁ ⲛⲟⲩⲱⲧ ⲉⲩⲥⲱⲙⲁ ⲛⲟⲩⲱⲧ ⲓⲧⲉ ⲛⲓⲓⲟⲩⲇⲁⲓ ⲓⲧⲉ ⲛⲓⲟⲩⲉⲓⲛⲓⲛ ⲓⲧⲉ ⲃⲱⲕ ⲓⲧⲉ **ⲣⲉⲙϩⲉ** ⲟⲩⲟϩ ⲁⲛⲟⲛ ⲧⲏⲣⲉⲛ ⲁⲩⲧⲥⲟⲛ ⲛⲟⲩⲡⲛⲉⲩⲙⲁ ⲛⲟⲩⲱⲧ .",
      "english": "For in one Spirit we were all baptized into one body, whether Jews or Greeks, whether bond or free; and were all given to drink into one Spirit.",
      "source": "Bohairic 1 Corinthians 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲓⲟⲕⲗⲏϯⲁⲛⲟⲥ ⲡⲣⲣⲟ · ϯⲕⲉⲗⲉⲩⲉ ϫⲓⲛⲧⲉϩⲣⲱⲙⲁⲛⲓⲁ ϣⲁⲣⲏⲥ ⲉⲡⲉⲗⲁⲕ · ϫⲉⲉⲓⲧⲉ ⲉⲡⲁⲣⲭⲟⲥ · ⲉⲓⲧⲉ ⲥⲧⲣⲁⲧⲏⲗⲁⲧⲏⲥ · ⲉⲓⲧⲉ ⲕⲟⲙⲉⲥ · ⲉⲓⲧⲉ ⲉⲡⲓⲥⲕⲟⲡⲟⲥ · ⲉⲓⲧⲉ ⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ · ⲉⲓⲧⲉ ⲇⲓⲁⲕⲟⲛⲟⲥ · ⲉⲓⲧⲉ ⲁⲛⲁⲅⲛⲱⲥⲧⲏⲥ · ⲉⲓⲧⲉ ϩⲙϩⲁⲗ · ⲉⲓⲧⲉ **ⲣⲙϩⲉ** · ⲉⲓⲧⲉ ⲙⲁⲧⲟⲓ · ⲉⲓⲧⲉ ⲡⲁⲅⲁⲛⲱⲥ ⲉⲩⲉϣⲙϣⲉ ⲧⲏⲣⲟⲩ ⲛⲛⲁⲛⲟⲩⲧⲉ ·",
      "english": "I, the Emperor Diocletian, [hereby] command that from Romania [in the north] to Pelak (Philac) in the south, every man, whether he be eparch, or general, or count, or bishop, or elder, or deacon, or reader, or servant, or free man, or soldier, or countryman, shall worship my gods.",
      "source": "Martyrdom of Victor part 1",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:1-6",
      "dialect": "sahidic"
    }
