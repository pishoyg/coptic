  "examples": [
    {
      "coptic": "ⲟⲩⲙⲟⲛⲟⲛ ⲙⲡⲣⲇⲓⲥⲧⲁⲍⲉ ⲟⲩⲇⲉ ⲙⲡⲣ**ⲕⲣⲙⲣⲙ**",
      "english": "only ye must neither feel any doubt [about what I say], nor must ye murmur.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩ ⲡⲉⲧϯⲛⲁϫⲟⲟϥ ⲛⲁⲩ · ϯⲣϩⲟⲧⲉ · ⲉϫⲟⲟⲥ · ϫⲉⲙⲡⲣⲧⲣϥⲥⲱ ⲉⲡⲧⲏⲣϥ ϫⲉⲛⲛⲉⲟⲩⲁ · ⲉϥⲙⲟⲥⲧⲉ ⲙⲡⲉϥⲟⲩϫⲁⲓ **ⲕⲣⲙⲣⲙ** ⲉⲣⲟⲓ ·",
      "english": "I am afraid to say it: Let no man drink wine at all, so that he may not hate his own salvation (and) murmur against me.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲓⲟⲩⲱϣ ⲭⲱⲣⲓⲥⲛⲕⲁⲛⲱⲛ ⲉⲧⲕⲏ ⲛⲁⲛ ⲉϩⲣⲁⲓ ⲉⲧⲙⲧⲣⲉⲗⲁⲁⲩ ϩⲣⲁⲓ ⲛϩⲏⲧⲛ **ⲕⲣⲙⲣⲙ** ⲏ ϭⲛⲁⲣⲓⲕⲉ ⲁⲩⲱ ⲉⲧⲙⲧⲣⲉⲡⲉϥⲁⲅⲁⲑⲟⲛ ϣⲱⲡⲉ ⲕⲁⲧⲁⲟⲩϩⲧⲟⲣ ⲁⲗⲗⲁ ⲉϩⲛⲁϥ .",
      "english": "But what I want, apart from the Rule which is laid down for us, is to not cause any of you to be vexed or to make accusations, and to not make their goodness be according to necessity, but rather their wish.",
      "source": "So Concerning the Little Place BV 277-278",
      "urn": "urn:cts:copticLit:shenoute.place.amelineau:55-56",
      "dialect": "sahidic"
    }
  ],
