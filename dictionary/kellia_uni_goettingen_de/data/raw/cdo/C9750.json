  "examples": [
    {
      "coptic": "ϯⲛⲟⲩ ⲇⲉ ⲟⲩⲙⲏϣ **ⲙⲉⲛ** ⲛⲉ ⲛⲓⲙⲉⲗⲟⲥ ⲟⲩⲁⲓ ⲇⲉ ⲡⲉ ⲡⲓⲥⲱⲙⲁ .",
      "english": "But now they are many members, but one body.",
      "source": "Bohairic 1 Corinthians 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲉⲓⲙⲉⲉⲩⲉ **ⲙⲉⲛ** ⲡⲉ ⲉⲉⲓ ϣⲁⲣⲱⲧⲛ ϩⲛⲟⲩⲧⲱⲧ ⲛϩⲏⲧ ·",
      "english": "I actually thought to come to you in good faith,",
      "source": "To Thieving Nuns",
      "urn": "urn:cts:copticLit:besa.thieving.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲁⲓ ⲇⲉ ϯϫⲱ ⲙⲙⲟϥ ϫⲉⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ⲙⲙⲱⲧⲉⲛ ϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲛⲟⲕ **ⲙⲉⲛ** ⲁⲛⲟⲕ ⲫⲁⲡⲁⲩⲗⲟⲥ ⲁⲛⲟⲕ ⲇⲉ ⲁⲛⲟⲕ ⲫⲁⲁⲡⲟⲗⲗⲱ ⲁⲛⲟⲕ ⲇⲉ ⲁⲛⲟⲕ ⲫⲁⲕⲏⲫⲁ ⲁⲛⲟⲕ ⲇⲉ ⲁⲛⲟⲕ ⲫⲁⲡⲭⲣⲓⲥⲧⲟⲥ .",
      "english": "Now I mean this, that each one of you says, 'I follow Paul,' 'I follow Apollos,' 'I follow Cephas,' and, 'I follow Christ.'",
      "source": "Bohairic 1 Corinthians 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ **ⲙⲉⲛ** ϣⲁϥϩⲱⲥ ⲙⲙⲟⲓ ϩⲙⲡⲉϥⲧⲛϩ ⲛⲟⲩⲛⲁⲙ ·",
      "english": "and me he used to place under his right wing,",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲏⲇⲏ **ⲙⲉⲛ** ϩⲟⲗⲱⲥ ⲟⲩⲑⲉⲃⲓⲟ ⲛⲱⲧⲉⲛ ⲡⲉ ϫⲉⲟⲩⲟⲛⲧⲉⲧⲉⲛ ϩⲁⲡ ⲙⲙⲁⲩ ⲟⲩⲧⲱⲧⲉⲛ ⲛⲉⲙⲛⲉⲧⲉⲛⲉⲣⲏⲟⲩ ⲉⲑⲃⲉⲟⲩ ⲙⲁⲗⲗⲟⲛ ⲥⲉϭⲓ ⲙⲙⲱⲧⲉⲛ ⲛϫⲟⲛⲥ ⲁⲛ ⲉⲑⲃⲉⲟⲩ ⲙⲁⲗⲗⲟⲛ ⲥⲉϥⲱϫⲓ ⲙⲙⲱⲧⲉⲛ ⲁⲛ .",
      "english": "Therefore it is already altogether a defect in you, that you have lawsuits one with another. Why not rather be wronged? Why not rather be defrauded?",
      "source": "Bohairic 1 Corinthians 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲁⲓ ⲇⲉ ⲧⲉϥⲥⲁⲣⲝ **ⲙⲉⲛ** ⲡⲉ ⲡⲱⲛϩ ·",
      "english": "now this was His flesh, the life.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
