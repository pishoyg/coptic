  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲡⲉϫⲉⲡϫⲟⲉⲓⲥ ⲛⲁⲓ ϫⲉⲁⲓϣⲁϫⲉ ⲛⲙⲙⲁⲕ ⲛⲟⲩⲥⲟⲡ ⲁⲩⲱ ⲛⲥⲛⲁⲩ ⲉⲓϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲓⲛⲁⲩ ⲉⲡⲉⲓⲗⲁⲟⲥ ⲁⲩⲱ ⲉⲓⲥ ϩⲏⲏⲧⲉ ⲟⲩⲗⲁⲟⲥ ⲛ**ⲛⲁϣⲧⲙⲁⲕϩ** ⲡⲉ",
      "english": "And the Lord spoke to me, saying, I have spoken to thee once and again, saying, I have seen this people, and, behold, it is a stiff-necked people.",
      "source": "Deuteronomy 9",
      "urn": "urn:cts:copticLit:ot.deut.coptot:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲁⲛⲟⲩⲟⲩⲣⲱⲙⲉ ⲉϥϫⲡⲓⲟ ⲉⲩ**ⲛⲁϣⲧⲙⲁⲕϩ** ϥⲛⲁϫⲉⲣⲟ ⲅⲁⲣ ϩⲛⲟⲩϣⲥⲛⲉ ⲛϥⲧⲙⲧⲁⲗϭⲟ",
      "english": "A reprover is better than a stiff-necked man: for when the latter is suddenly set on fire, there shall be no remedy.",
      "source": "Proverbs 29",
      "urn": "urn:cts:copticLit:ot.prov.coptot:29",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲁϫⲓⲧⲏⲩⲧⲛ ⲉϩⲟⲩⲛ ⲉⲩⲕⲁϩ ⲉϥϣⲟⲩⲉ ⲉⲣⲱⲧⲉ ⲉⲃⲟⲗ ϩⲓⲉⲃⲓⲱ ⲛⲛⲁⲉⲓ ⲅⲁⲣ ⲛⲙⲙⲁⲕ ϫⲉⲡⲉⲓⲗⲁⲟⲥ ⲟⲩ**ⲛⲁϣⲧⲙⲁⲕϩ** ⲡⲉ ϫⲉⲕⲁⲥ ⲛⲛⲁϥⲟⲧⲕ ⲉⲃⲟⲗ ϩⲣⲁⲓ ϩⲛⲧⲉϩⲓⲏ",
      "english": "And I will bring thee into a land flowing with milk and honey; for I will not go up with thee, because thou art a stiff-necked people, lest I consume thee by the way.",
      "source": "Exodus 33",
      "urn": "urn:cts:copticLit:ot.exod.coptot:33",
      "dialect": "sahidic"
    }
