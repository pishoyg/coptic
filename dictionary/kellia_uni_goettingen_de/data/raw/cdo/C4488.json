  "examples": [
    {
      "coptic": "ⲡⲁⲓ ⲣⲏϯ ⲁϥⲓ ⲉⲃⲟⲗ **ϩⲓⲧⲉⲛ**ⲛⲉϥⲓⲟϯ ⲁϥϩⲱⲗ ⲉⲡϣⲁϥⲉ .",
      "english": "Thus he left his parents and went into the desert.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "☧ **ϩⲓⲧⲛ**ⲡⲁϩⲱⲙⲱ υἱό ⲑⲉⲟⲇⲱⲣ ⲉⲩⲭⲁⲣⲓⲥⲧⲟⲩ ⲛⲏⲧⲛ",
      "english": "By Pachomo, son of Theodore, I thank you.",
      "source": "Letter about wheat",
      "urn": "urn:cts:copticDoc:papyri_info.tm82149.cpr_31_14",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲟϥ ⲇⲉ ⲁϥⲉⲣⲟⲩⲱ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲟⲩ ⲡⲉⲧⲁϥϩⲟⲛϩⲉⲛ ⲙⲙⲟϥ **ϩⲓⲧⲉⲛ**ⲑⲏⲛⲟⲩ ⲛϫⲉⲙⲱⲩⲥⲏⲥ .",
      "english": "He answered, 'What did Moses command you?'",
      "source": "Bohairic Gospel of Mark 10 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:10",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲩϣⲟⲟⲡ ⲁⲛ ⲉⲧⲃⲉⲡⲧⲁⲉⲓⲟ ⲡⲉ ⲉⲃⲟⲗ **ϩⲓⲧⲙ**ⲡⲛⲟⲩⲧⲉ ·",
      "english": "and not for the approbation which is from God.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥϣⲉ ⲉⲃⲟⲗ **ϩⲓⲧⲟⲧ**ϥ .",
      "english": "He then departed from him.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϩⲉⲛⲕⲟⲟⲩⲉ ⲃⲱⲕ ϣⲁⲣⲟϥ ⲉⲧⲣⲉⲩⲥⲱⲧⲙ ⲉⲩϣⲁϫⲉ ⲉⲃⲟⲗ **ϩⲓⲧⲟⲟⲧ**ϥ ·",
      "english": "Some others went to him to hear a story from him.",
