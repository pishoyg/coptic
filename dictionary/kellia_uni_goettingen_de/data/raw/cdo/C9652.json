  "examples": [
    {
      "coptic": "ⲁⲩⲕⲱϯ ⲉⲣⲟⲓ ⲛϩⲁⲛ**ⲗⲟⲅⲭⲏ** ⲁⲩϩⲓⲟⲩⲓ ⲙⲙⲱⲟⲩ ⲛⲛⲁϭⲗⲱⲧ ⲛⲥⲉϯⲁⲥⲟ ⲁⲛ : ⲁⲩⲫⲱⲛ ⲙⲡⲁϣⲁϣⲓ ϩⲓϫⲉⲛⲡⲓⲕⲁϩⲓ .",
      "english": "They surrounded me with spears, aiming at my reins: without sparing me they poured out my gall upon the ground.",
      "source": "18_Iob_16",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲥⲧⲁⲩⲣⲟⲩ ⲙⲙⲟϥ · ⲁⲩⲕⲟⲛⲥϥ ϩⲛⲟⲩ**ⲗⲟⲅⲭⲏ** · ⲁϥⲉⲓ ⲉⲃⲟⲗ ⲛϭⲓⲡⲉⲛⲟⲩϫⲁⲓ ·",
      "english": "They crucified Him. They pierced Him with a spear. There came out our salvation,",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲁⲓ ⲫⲏⲉⲑⲛⲁϧⲱⲧⲉⲃ ⲛⲛⲉϣⲉⲣⲓ ⲛⲏⲉⲧϧⲉⲛ ⲧⲕⲟⲓ ϧⲉⲛⲧⲥⲏϥⲓ ⲉϥⲉϣⲱⲡⲓ ⲉϥⲣⲱⲓⲥ ⲉϥⲉⲧⲁⲥⲑⲟ ⲛⲛⲉⲥⲟⲃⲧ ⲉⲣⲟⲉϥⲉⲥⲉⲙⲛⲏ ⲛϩⲁⲛϩⲟⲡⲗⲟⲛ ⲟⲩⲟϩ ⲛⲉϥ**ⲗⲟⲅⲭⲏ** ⲙⲡⲟⲩⲙⲑⲟ ⲉⲃⲟⲗ .",
      "english": "He shall slay thy daughters that are in the field with the sword, and shall set a watch against thee, and build forts around thee, and carry a rampart round against thee, and set up warlike works, and array his spears against thee.",
      "source": "26_Ezechiel_26",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϥⲛⲁϯ ⲙⲡⲉϥⲡⲛⲉⲩⲙⲁ ϩⲓⲡⲉⲥⲧⲁⲩⲣⲟⲥ · ⲛⲥⲉⲕⲉⲛⲥ ⲡⲉϥⲥⲡⲓⲣ ⲛⲟⲩ**ⲗⲟⲅⲭⲏ** ⲛⲧⲉⲟⲩⲙⲟⲟⲩ ⲙⲛⲟⲩⲥⲛⲟϥ ⲉⲓ ⲉⲃⲟⲗ ⲛϩⲏⲧϥ ⁛— ⲛⲁⲓ ⲉⲧⲛⲁⲧⲃⲃⲟ ⲛⲛⲛⲟⲃⲉ ⲙⲡⲕⲟⲥⲙⲟⲥ",
      "english": "He shall yield up His Spirit on the Cross. They shall pierce His side with a spear so that water and blood shall flow forth therefrom, and it is these which shall cleanse the sins of the world.",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩϣⲁⲛⲑⲟⲛⲧⲉⲛ ⲛϩⲁⲛ**ⲗⲟⲅⲭⲏ** ⲉⲣⲟϥ ⲙⲡⲁⲩⲉⲣ ϩⲗⲓ ⲛⲁϥ: ⲟⲩⲛⲁϩⲃⲓ ⲉϥⲧⲁⲓⲏⲟⲩⲧ ⲉⲣⲁⲧϥ ⲛⲉⲙⲟⲩϧⲉⲗⲓⲃϣ .",
      "english": "If spears should come against him, men will effect nothing, either with the spear or the breast-plate.",
      "source": "18_Iob_41",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡⲉⲛⲧⲁⲣⲉⲓ ⲉⲣⲁⲧϥ ⲙⲡⲛⲁⲩ ⲛⲧⲁⲣⲡⲱⲧⲥ ⲛⲧⲟⲩⲉⲕⲓⲃⲉ ⲛⲟⲩⲛⲁⲙ · ⲉⲁⲣϯ ⲙⲡⲉⲥⲛⲟϥ ⲉⲧⲉϩⲛⲉ ⲛⲛⲟⲩϣⲏⲣⲉ ⁛ ⲡⲉⲛⲧⲁⲩⲣⲉϩⲧⲡⲉϥⲥⲡⲓⲣ ⲛⲟⲩ**ⲗⲟⲅⲭⲏ** ϩⲓⲡⲉⲥⲧⲁⲩⲣⲟⲥ",
      "english": "And He to Whom thou didst come when thou didst pierce thy right breast, and didst put the blood on the foreheads of thy sons, was He Whose side was pierced by the spear on the Cross.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 2",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:24-42",
      "dialect": "sahidic"
    }
