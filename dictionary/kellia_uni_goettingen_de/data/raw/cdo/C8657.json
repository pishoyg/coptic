      "dialect": "bohairic"
    },
    {
      "coptic": "ϥⲥⲏϩ **ⲅⲁⲣ** ϫⲉϣⲡϩⲓⲥⲉ ·",
      "english": "for it is written, 'Suffer.'",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ **ⲅⲁⲣ** ⲉⲧⲉⲛϥⲟⲩⲃⲏⲛ ⲁⲛ ⲁϥϯ ⲉϫⲱⲛ .",
      "english": "For whoever is not against us is on our side.",
