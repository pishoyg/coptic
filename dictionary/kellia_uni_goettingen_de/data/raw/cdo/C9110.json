  "examples": [
    {
      "coptic": "ⲧⲉⲛⲟⲩ ϭⲉ ⲉϣϫⲉ ϩⲉⲛ**ⲍⲏⲧⲏⲙⲁ** ⲛⲉ ⲉⲧⲃⲉⲟⲩϣⲁϫⲉ . ⲏϩⲉⲛⲣⲁⲛ ⲉⲧⲃⲉⲡⲉⲧⲛⲛⲟⲙⲟⲥ ⲧⲉⲧⲛⲣⲱϣⲉ ⲛⲧⲱⲧⲛ . ⲁⲛⲟⲕ ⲅⲁⲣ ⲛϯⲟⲩⲱϣ ⲁⲛ ⲉϯϩⲁⲡ ⲉϩⲱⲃ ⲛⲧⲉⲓⲙⲓⲛⲉ .",
      "english": "but if they are questions about words and names and your own law, look to it yourselves. For I don't want to be a judge of these matters.'",
      "source": "44_Acts of the Apostles_18",
      "urn": "urn:cts:copticLit:nt.acts.sahidica:18",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲓϭⲛⲧⲥ ⲉⲩⲉⲅⲕⲁⲗⲉⲓ ⲛⲁϥ ⲉⲧⲃⲉϩⲉⲛ**ⲍⲏⲧⲏⲙⲁ** ⲛⲧⲉⲡⲉⲩⲛⲟⲙⲟⲥ . ⲉⲙⲛⲗⲁⲁⲩ ⲇⲉ ⲛϩⲁⲡ ⲉⲣⲟϥ ⲉϥⲙⲡϣⲁ ⲙⲡⲙⲟⲩ . ⲏⲙⲣⲣⲉ .",
      "english": "I found him to be accused about questions of their law, but not to be charged with anything worthy of death or of imprisonment.",
      "source": "44_Acts of the Apostles_23",
      "urn": "urn:cts:copticLit:nt.acts.sahidica:23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲁⲗⲓⲥⲧⲁ ⲉⲕⲥⲟⲟⲩⲛ ⲛⲛⲥⲱⲛⲧ ⲧⲏⲣⲟⲩ . ⲁⲩⲱ ⲛ**ⲍⲏⲧⲏⲙⲁ** ⲛⲛⲓⲟⲩⲇⲁⲓ . ⲉⲧⲃⲉⲡⲁⲓ ϯⲥⲟⲡⲥ ⲙⲙⲟⲕ ⲉⲥⲱⲧⲙ ⲉⲣⲟⲓ ϩⲛⲟⲩⲙⲛⲧϩⲁⲣϣϩⲏⲧ .",
      "english": "especially because you are expert in all customs and questions which are among the Jews. Therefore I beg you to hear me patiently.",
      "source": "44_Acts of the Apostles_26",
      "urn": "urn:cts:copticLit:nt.acts.sahidica:26",
      "dialect": "sahidic"
    }
