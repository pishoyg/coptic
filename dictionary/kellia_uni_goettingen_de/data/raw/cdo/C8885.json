      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲛⲟⲩ**ⲉⲓⲣⲏⲛⲏ** ⲛⲧⲉⲡⲛⲟⲩⲧⲉ ϩⲁⲙⲏⲛ ·",
      "english": "IN THE PEACE OF GOD. AMEN.",
