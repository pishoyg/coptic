  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ **ⲡⲁⲗⲓⲛ** ϫⲉⲥⲉⲃⲧⲉⲛⲉⲧⲉⲛϩⲃⲏⲟⲩⲓ ϧⲉⲛⲡⲉⲧⲉⲛϫⲓⲛⲓ ⲉⲃⲟⲗ ϧⲉⲛⲥⲱⲙⲁ",
      "english": "And again: “Prepare your works for the departure of your soul from the body.”",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲡⲁⲗⲓⲛ** ⲟⲛ ϣⲁⲣⲉⲛⲁⲅⲅⲉⲗⲟⲥ ϯⲉⲟⲟⲩ ⲛⲁϥ ·",
      "english": "Moreover, when the angels glorify him,",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲉⲣϥⲉϫⲛⲉⲧⲉⲛⲉⲣⲏⲟⲩ ⲉⲃⲏⲗ ⲁⲣⲏⲟⲩ ϧⲉⲛⲟⲩϯⲙⲁϯ ⲡⲣⲟⲥ ⲟⲩⲥⲏⲟⲩ ϩⲓⲛⲁ ⲛⲧⲉⲧⲉⲛⲥⲣⲟϥⲧ ⲉϯⲡⲣⲟⲥⲉⲩⲭⲏ ⲟⲩⲟϩ **ⲡⲁⲗⲓⲛ** ⲛⲧⲉⲧⲉⲛⲓ ⲉⲩⲙⲁ ϩⲓⲛⲁ ⲛⲧⲉ ⲛⲧⲉϣⲧⲉⲙⲡⲥⲁⲧⲁⲛⲁⲥ ⲉⲣⲡⲓⲣⲁⲍⲓⲛ ⲙⲙⲱⲧⲉⲛ ⲉⲑⲃⲉⲧⲉⲧⲉⲛⲙⲉⲧⲁⲧⲑⲱⲧ .",
      "english": "Don't deprive one another, unless it is by consent for a season, that you may give yourselves to fasting and prayer, and may be together again, that Satan doesn't tempt you because of your lack of self-control.",
      "source": "Bohairic 1 Corinthians 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "▢ **ⲡⲁⲗⲓⲛ** ⲟⲛ ⲡⲉϫⲁⲓ ⲙⲡⲉⲭⲉⲓⲣⲟⲩⲃⲉⲓⲛ ·",
      "english": "And again I said unto the Cherubim,",
      "source": "Mysteries of John the Evangelist part 2",
      "urn": "urn:cts:copticLit:misc.mysteries_john.budge:13-28",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ **ⲡⲁⲗⲓⲛ** ⲉⲧⲁϥϣⲉ ⲛⲁϥ ⲛⲁϥⲉⲣⲡⲣⲟⲥⲉⲩⲭⲉⲥⲑⲉ ⲁϥϫⲉⲡⲁⲓⲥⲁϫⲓ ⲣⲱ .",
      "english": "Again he went away, and prayed, saying the same words.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲡⲁⲗⲓⲛ** ⲟⲛ ⲉⲕⲙⲟⲟϣⲉ · ϩⲛⲧⲉϩⲓⲏ . ⲁⲩⲱ ⲉⲕⲛⲁⲩ ⲉϩⲉⲛⲱⲛⲉ ⲙⲛϩⲉⲛⲃⲉⲗϫⲉ . ⲉⲣⲉⲟⲩⲛⲟⲩⲃ ⲇⲉ ϩⲛⲧⲉⲩⲙⲏⲧⲉ ·",
      "english": "Again, if you are walking on the road, and you see some stones and some pottery pieces and gold in their midst,",
      "source": "Apophthegmata Patrum Sahidic 052",
      "urn": "urn:cts:copticLit:ap.52.monbeg",
      "dialect": "sahidic"
    }
