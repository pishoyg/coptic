  "examples": [
    {
      "coptic": "ⲟⲩⲇⲉ ⲡⲁⲓⲣⲏϯ ⲛⲁⲥⲟⲓ ⲛϩⲩⲥⲟⲥ ⲁⲛ ⲛϫⲉⲧⲟⲩ**ⲙⲉⲧⲙⲉⲑⲣⲉ** .",
      "english": "Even so, their testimony did not agree.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϩⲣⲟⲩⲑ ⲧⲙⲱⲁⲃⲓⲧⲏⲥ ⲧϩⲓⲙⲉ ⲙⲙⲁⲁⲗⲱⲛ ⲁⲓϫⲓⲧⲥ ⲉⲩⲥϩⲓⲙⲉ ⲛⲁⲓ ⲉⲧⲟⲩⲛⲉⲥ ⲡⲣⲁⲛ ⲙⲡⲉⲛⲧⲁϥⲙⲟⲩ ⲉϫⲛⲧⲉϥⲕⲗⲏⲣⲟⲛⲟⲙⲓⲁ ⲛϥⲧⲙϥⲱⲧⲉ ⲉⲃⲟⲗ ⲛϭⲓⲡⲣⲁⲛ ⲙⲡⲉⲛⲧⲁϥⲙⲟⲩ ⲉⲃⲟⲗ ϩⲛⲛⲉϥⲥⲛⲏⲩ ⲁⲩⲱ ⲉⲃⲟⲗ ϩⲛⲧⲉⲫⲩⲗⲏ ⲙⲡⲉϥⲗⲁⲟⲥ ⲛⲧⲱⲧⲛ ⲧⲉⲧⲛⲟ ⲙ**ⲙⲛⲧⲣⲉ** ⲙⲡϩⲟⲟⲩ",
      "english": "Moreover I have bought for myself for a wife Ruth the Moabitess, the wife of Maalon, to raise up the name of the dead upon his inheritance; so the name of the dead shall not be destroyed from among his brethren, and from the tribe of his people: ye are this day witnesses.",
      "source": "Ruth Chapter 4",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲙⲁ ⲛⲓⲃⲉⲛ ⲉⲧⲉⲛϥⲛⲁϣⲉⲡⲑⲏⲛⲟⲩ ⲉⲣⲟϥ ⲁⲛ ⲟⲩⲇⲉ ⲛⲧⲟⲩϣⲧⲉⲙⲥⲱⲧⲉⲙ ⲉⲣⲱⲧⲉⲛ ⲁⲛ ⲉⲣⲉⲧⲉⲛⲛⲏⲟⲩ ⲉⲃⲟⲗ ⲙⲙⲁⲩ ⲛⲉϩⲡϣⲱⲓϣ ⲉⲧⲥⲁⲉϧⲣⲏⲓ ⲛⲛⲉⲧⲉⲛϭⲁⲗⲁⲩϫ ⲉⲃⲟⲗ ⲉⲩ**ⲙⲉⲧⲙⲉⲑⲣⲉ** ⲛⲱⲟⲩ .",
      "english": "Whoever will not receive you nor hear you, as you depart from there, shake off the dust that is under your feet for a testimony against them.'",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲭⲣⲓⲥⲧⲟⲫⲟⲣⲟⲥ ϯⲥϩⲁⲓ ϩⲁⲣⲟϥ ϫⲛϥⲛⲟⲉⲓ ⲁⲛ ⲁⲩⲱ ϯⲟ ⲙ**ⲙⲛⲧⲣⲉ**",
      "english": "I Christophoros, I write instead of him since he does not know (how to write) and I am witness.",
      "source": "Honey Delivery",
      "urn": "urn:cts:copticDoc:papyri_info.tm82149.cpr_4_16",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲁⲩ ⲇⲉ ⲛⲑⲱⲧⲉⲛ ⲉⲣⲱⲧⲉⲛ ⲥⲉⲛⲁϯⲑⲏⲛⲟⲩ ⲉϩⲁⲛⲙⲁ ⲛϯϩⲁⲡ ⲟⲩⲟϩ ϧⲉⲛⲛⲓⲥⲩⲛⲁⲅⲱⲅⲏ ⲥⲉⲛⲁϩⲓⲟⲩⲓ ⲉⲣⲱⲧⲉⲛ ⲟⲩⲟϩ ⲛⲧⲟⲩⲧⲁϩⲱⲧⲉⲛ ⲉⲣⲁⲧ ⲉⲛⲑⲏⲛⲟⲩ ⲛⲁϩⲣⲉⲛϩⲁⲛϩⲏⲅⲉⲙⲱⲛ ⲛⲉⲙϩⲁⲛⲟⲩⲣⲱⲟⲩ ⲉⲑⲃⲏⲧ ⲉⲩ**ⲙⲉⲧⲙⲉⲑⲣⲉ** ⲛⲱⲟⲩ ⲛⲉⲙⲛⲓⲉⲑⲛⲟⲥ ⲧⲏⲣⲟⲩ .",
      "english": "But watch yourselves, for they will deliver you up to councils. You will be beaten in synagogues. You will stand before rulers and kings for my sake, for a testimony to them.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩ ⲛϩⲱⲃ ⲏ ⲁϣ ⲛϣⲁϫⲉ ϩⲛⲛⲉⲛⲧⲁⲕϫⲟⲟⲩ ⲛⲉⲧⲟ ⲙ**ⲙⲛⲧⲣⲉ** ⲉⲣⲟⲕ ⲁⲛ ϫⲉⲉⲕⲏⲡ ⲉⲡⲥⲁⲧⲁⲛⲁⲥ .",
