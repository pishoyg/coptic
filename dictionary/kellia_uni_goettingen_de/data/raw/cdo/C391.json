  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥⲟⲩⲱⲣⲡ ϩⲁⲛⲓⲟⲩⲓⲏ ϧⲉⲛⲡⲥⲏⲟⲩ ⲛⲟⲩ**ⲃⲱⲕ** ϩⲓⲛⲁ ⲛⲧⲉϥϭⲓ ⲛⲧⲟⲧⲟⲩ ⲛⲛⲓⲟⲩⲓⲏ ⲉⲃⲟⲗ ϧⲉⲛⲡⲟⲩⲧⲁϩ ⲛⲧⲉⲡⲓⲓⲁϩⲁⲗⲟⲗⲓ .",
      "english": "When it was time, he sent a servant to the farmer to get from the farmer his share of the fruit of the vineyard.",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲛⲧⲁϥⲧⲥⲁⲃⲟⲛ ⲉⲧⲉϩⲓⲏ ⲛ**ⲃⲱⲕ** ⲉϩⲣⲁⲓ ⲉⲧⲡⲉ ·",
      "english": "who hath taught unto us the way whereby to enter into heaven,",
