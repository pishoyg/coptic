  "examples": [
    {
      "coptic": "ⲡⲉⲧⲟⲩⲱϣ ⲇⲉ ⲉⲟⲩⲁϩϥ ⲛⲥⲁⲡⲥⲱⲧⲏⲣ · ⲁⲡϫⲟⲉⲓⲥ ⲧⲟⲩⲛⲉⲓⲁⲧϥ ⲉⲃⲟⲗ · **ⲉⲧⲣⲉϥϯ **ⲉⲃⲟⲗ**** ϩⲛⲧⲉϥⲕⲉⲟⲩⲥⲓⲁ ⲧⲏⲣⲥ ⲉⲩⲡⲉⲧⲛⲁⲛⲟⲩϥ ⲛⲛϩⲏⲕⲉ · ⲁⲩⲱ ⲛⲧⲉⲓϩⲉ ⲛϥⲟⲩⲁϩϥ ⲛⲥⲱϥ ·",
      "english": "Unto him that wisheth to follow in the steps of the Saviour will the Lord reveal His Divine Person, and He will make him to give of all his substance, and to do that which is good to the poor; and in this wise he shall follow in His footsteps.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩ ⲅⲁⲣ ⲡⲉⲧϥϣⲓⲛⲉ ⲛⲥⲱϥ **ⲛϭⲓⲡⲉⲧϯ **ⲉⲃⲟⲗ**** ⲙⲛⲧⲁⲛⲭⲣⲏⲙⲁ ⲙⲙⲁⲩ ⲉϯ ·",
      "english": "Now he who seeketh after that which is sold may not have with him the means (or, possessions) to give in exchange for it.",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏ ⲉⲧⲉⲧⲛⲙⲉⲉⲩⲉ ϫⲉⲁⲛⲅⲓⲟⲩⲇⲁⲥ ϩⲱ **ⲡⲉⲛⲧⲁϥϯ **ⲉⲃⲟⲗ**** ⲙⲡⲉϥϫⲟⲉⲓⲥ ϩⲁⲙⲁⲁⲃ ⲛϩⲁⲧ · ⲉⲧⲃⲉⲡⲁⲓ ⲁϥⲕⲗⲏⲣⲟⲛⲟⲙⲉⲓ ⲙⲡⲕⲁⲕⲉ ⲉⲧⲉⲧϩⲓⲃⲟⲗ ϣⲁⲉⲛⲉϩ ·",
      "english": "Do they not think that I myself am Judas who betrayed (or, gave away) his Lord for thirty pieces of silver, for which reason he inherited the outer darkness for ever?",
      "source": "Martyrdom of Victor part 2",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:7-12",
      "dialect": "sahidic"
    }
  ],
