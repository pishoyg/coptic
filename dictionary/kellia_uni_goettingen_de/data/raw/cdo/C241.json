  "examples": [
    {
      "coptic": "ⲭⲁⲓⲣⲉ ⲡⲁⲙⲉⲣⲓⲧ ⲛⲥⲟⲛ ⲡⲁⲧⲉϣⲧⲏⲛ ⲛⲁⲩⲁⲛ **ⲁⲩⲁⲛ** ⲛⲧϩⲉ ⲛⲧⲉϣⲧⲏⲛ · ⲛⲓⲱⲥⲏⲫ ⲡⲇⲓⲕⲁⲓⲟⲥ ·",
      "english": "Hail, my beloved brother, unto whom belongeth the coat of many colours, which is like unto the coat of Joseph the righteous man.",
      "source": "Life of Cyrus in Budge ed. part 1",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:1-9",
      "dialect": "sahidic"
