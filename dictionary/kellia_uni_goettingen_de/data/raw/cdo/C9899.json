  "examples": [
    {
      "coptic": "ⲙⲡϥⲧⲁⲕⲟ ⲅⲁⲣ ⲛϭⲓⲡⲉⲛⲧⲁⲩⲧⲟⲙⲥϥ ⲛϩⲏⲏⲧϥ : ⲁⲗⲗⲁ ⲛⲧⲁϥϣⲱⲡⲉ ⲛ**ⲛⲩⲙⲫⲓⲟⲥ** ⲛϭⲓⲡⲉⲛⲧⲁϥⲃⲱⲕ ⲉⲡⲉⲥⲏⲧ ·",
      "english": "He Whom they buried therein did not suffer corruption; on the contrary, He Who went down into it became a bridegroom.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲕⲁⲥ ϩⲙⲡⲧⲣⲉⲡ**ⲛⲩⲙⲫⲓⲟⲥ** ⲑⲉⲱⲣⲉⲓ ⲙⲡⲥⲁ ⲛⲧⲉⲯⲩⲭⲏ ⲉϥⲉϫⲟⲟⲥ ϫⲉⲛⲁⲛⲟⲩ ⲧⲏⲣⲉⲧⲁϣⲃⲉⲉⲣⲉ ⲁⲩⲱ ⲙⲛⲗⲁⲁⲩ ⲛϫⲃⲓⲛ ⲛϩⲏⲧⲉ ·",
      "english": "so that when the Bridesgroom looketh upon the beauty of the soul He shall say, 'Though art wholly beautiful , my love, and there is not blemesh in thee.",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲱ ⲛⲁⲓⲁⲧⲟⲩ ⲛⲛⲉⲧⲛⲁⲣⲡⲙⲡϣⲁ ⲛⲧⲡⲁⲣⲟⲩⲥⲓⲁ ⲉⲧⲙⲙⲁⲩ ϫⲉⲥⲉⲛⲁⲧⲱⲙⲛⲧ ⲉⲛⲁⲅⲅⲉⲗⲟⲥ ⲉⲩⲙⲟⲟϣⲉ ⲙⲛⲛⲉⲧⲟⲩⲁⲁⲃ · ⲉⲧⲱⲙⲛⲧ ⲉⲡϫⲟⲉⲓⲥ ⲉⲡⲁⲏⲣ ⲛⲛⲉⲕⲗⲟⲟⲗⲉ ⲛⲉⲟⲟⲩ ⲛⲥⲉⲣϣⲁ ⲙⲛⲡ**ⲛⲩⲙⲫⲓⲟⲥ** ⲛⲁⲧⲙⲟⲩ",
      "english": "O blessed shall be those who shall be found worthy of that state of being, for they shall hold intercourse with the angels, and walk wnth the saints, and converse with God in the uppermost heights amid the clouds of glory, and they shall keep the feast with the Immortal Bridegroom.",
      "source": "The Asceticon of Apa Ephrem part 2",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:24-55",
