  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲏ ⲉⲧⲉⲛⲙⲉⲩⲓ ⲉⲣⲱⲟⲩ ⲛⲧⲉⲡⲓⲥⲱⲙⲁ ϫⲉⲥⲉϣⲏϣ ⲛⲁⲓ ⲇⲉ ⲛϯ ⲛⲱⲟⲩ ⲛⲟⲩ**ⲧⲁⲓⲟ** ⲛϩⲟⲩⲟ ⲟⲩⲟϩ ⲛⲏ ⲉⲧⲁϫⲁⲓⲱⲟⲩ ⲛⲧⲁⲛ ⲟⲩⲟⲛⲛⲧⲱⲟⲩ ⲛϩⲟⲩⲟ ⲉⲥⲁⲓ ⲙⲙⲁⲩ .",
      "english": "Those parts of the body which we think to be less honorable, on those we bestow more abundant honor; and our unpresentable parts have more abundant propriety;",
      "source": "Bohairic 1 Corinthians 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲧⲁⲓⲉ** ⲛⲉⲭⲏⲣⲁ . ⲛⲉⲭⲏⲣⲁ ⲛⲁⲙⲉ .",
      "english": "Honor widows who are widows indeed.",
      "source": "54_1 Timothy_5",
      "urn": "urn:cts:copticLit:nt.1tim.sahidica:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲓ ⲉϥⲙⲟϣⲓ ⲉϥϩⲏⲗ ϣⲁⲡⲟⲩⲣⲟ ⲁϥⲛⲁⲩ ⲉⲣⲱⲙⲓ ⲃ ⲉⲩϭⲟⲥⲓ ⲉⲩⲉⲣⲫⲟⲣⲉⲓⲛ ⲛϩⲁⲛϩⲉⲃⲥⲱ ⲛⲟⲩⲱⲃϣ ⲙⲙⲟⲛ ϩⲗⲓ ⲛⲗⲁⲥ ⲛⲥⲁⲣⲝ ⲛⲁϣⲥⲁϫⲓ ⲙⲡⲟⲩⲱⲟⲩ ⲛⲉⲙⲡⲟⲩ**ⲧⲁⲓⲟ** .",
      "english": "He was still walking, praying, towards the king, when he saw two tall men walking wearing white garments - no tongue of flesh could speak of their glory and honor!",
      "source": "Life of Isaac of Alexandria - part 3",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:42-48",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲛ ⲁⲛⲣⲥⲟϭ ⲉⲧⲃⲉⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲛⲧⲱⲧⲛ ⲇⲉ ⲛⲧⲉⲧⲛ ϩⲉⲛⲥⲁⲃⲉ ϩⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲁⲛⲟⲛ ⲧⲛϭⲟⲟⲃ ⲛⲧⲱⲧⲛ ⲇⲉ ⲧⲉⲧⲛϫⲟⲟⲣ ⲛⲧⲱⲧⲛ ⲧⲉⲧⲛ**ⲧⲁⲉⲓⲏⲩ** ⲁⲛⲟⲛ ⲇⲉ ⲧⲛⲥⲏϣ",
      "english": "We are fools for Christ&apos;s sake, ·but you are wise in Christ. We are weak, but you are strong. You have honor, but we have dishonor.",
      "source": "46_1 Corinthians_4",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲱⲧⲉⲛ ⲇⲉ ⲧⲉⲧⲉⲛϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲣⲉϣⲁⲛⲟⲩⲣⲱⲙⲓ ϫⲟⲥ ⲙⲡⲉϥⲓⲱⲧ ⲛⲉⲙⲧⲉϥⲙⲁⲩ ϫⲉⲕⲟⲣⲃⲁⲛ ⲉⲧⲉⲟⲩ**ⲧⲁⲓⲟ** ⲡⲉ ⲁⲕϣⲁⲛϫⲉⲙϩⲏⲟⲩ ⲙⲙⲟϥ ⲉⲃⲟⲗ ⲙⲙⲟⲓ",
      "english": "But you say, 'If a man tells his father or his mother, 'Whatever profit you might have received from me is Corban, that is to say, given to God;''",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "▢▢▢ ⲁ ▢▢▢ ⲱ ▢▢▢▢ ⲓⲏⲥⲟⲩⲥ ▢✠▢ ⲭⲣⲓⲥⲧⲟⲥ ▢ ⲟⲩⲉⲅⲕⲱⲙⲓⲟⲛ ⲉⲁϥⲧⲁⲩⲟⲟϥ ⲛϭⲓⲡⲉⲛⲡⲉⲧⲟⲩⲁⲁⲃ ⲛⲉⲓⲱⲧ ⲉⲧ**ⲧⲁⲓⲏⲩ** ⲕⲁⲧⲁⲥⲙⲟⲧ ⲛⲓⲙ · ⲁⲡⲁ ⲧⲓⲙⲟⲑⲉⲟⲥ ⲡⲁⲣⲭⲏⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲛⲣⲁⲕⲟⲧⲉ · ⲛⲧⲁϥⲧⲁⲩⲟⲟϥ ⲇⲉ ⲉⲧⲃⲉⲡⲧⲁϩⲟ ⲉⲣⲁⲧϥ ⲛⲁⲃⲃⲁⲧⲱⲛ ⲡⲁⲅⲅⲉⲗⲟⲥ ⲙⲡⲙⲟⲩ ·",
