  "examples": [
    {
      "coptic": "ⲛⲅⲛⲟⲩϫⲉ ⲙⲡⲉⲕⲕⲗⲏⲣⲟⲥ ⲛⲙⲙⲁⲛⲧⲉⲟⲩ**ⲧⲱⲱⲙⲉ** ⲛⲟⲩⲱⲧ ϣⲱⲡⲉ ⲛⲁⲛ",
      "english": "but do thou cast in thy lot with us, and let us all provide a common purse, and let us have one pouch:",
      "source": "Proverbs 1",
      "urn": "urn:cts:copticLit:ot.prov.coptot:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉⲧϣⲱⲡ ⲛⲟⲩⲛⲟⲩⲃ ⲉⲃⲟⲗ ϩⲛⲛⲉⲩ**ⲧⲱⲱⲙⲉ** ⲁⲩⲱ ⲛⲉⲧϣⲓ ⲙⲡϩⲁⲧ ϩⲛⲟⲩⲙⲁϣⲉ ϩⲛⲟⲩϣⲓ ⲁⲩⲱ ⲁⲩⲑⲛⲟ ⲛⲟⲩϩⲁⲩⲛⲟⲩⲃ ⲁⲩⲧⲁⲙⲓⲟ ⲛϩⲉⲛⲙⲟⲩⲛⲅ ⲛϭⲓϫ ⲁⲩⲱ ϣⲁϥⲡⲁⲧϥ ⲛϥⲟⲩⲱϣⲧ ⲛⲁϥ",
      "english": "They that furnish gold out of a purse, and silver by weight, will weigh it in a scale, and they hire a goldsmith and make idols, and bow down, and worship them.",
      "source": "Isaiah 46",
      "urn": "urn:cts:copticLit:ot.isa.coptot:46",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲣϣⲱⲡⲉ ⲉⲕϯⲥⲩⲙⲃⲟⲗⲏ ⲉⲕϫⲓ ⲉϫⲱⲕ ⲉⲛⲧⲕ ⲟⲩϩⲏⲕⲉ ⲁⲩⲱ ⲉⲙⲛⲗⲁⲁⲩ ϣⲟⲟⲡ ⲛⲁⲕ ϩⲛⲧⲉⲕ**ⲧⲱⲱⲙⲉ**",
