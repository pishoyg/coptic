  "examples": [
    {
      "coptic": "ⲁⲗⲗⲁ ϩⲛⲛⲉϩⲟⲟⲩ ⲉⲧⲙⲙⲁⲩ ⲙⲛⲛⲥⲁⲧⲉⲑⲗⲓⲯⲓⲥ ⲉⲧⲙⲙⲁⲩ ⲡⲣⲏⲛⲁ**ⲣⲉⲃⲏ** . ⲁⲩⲱ ⲡⲟⲟϩ ⲛϥⲛⲁϯⲡⲉϥⲟⲩⲟⲉⲓⲛ ⲁⲛ .",
      "english": "But in those days, after that oppression, the sun will be darkened, the moon will not give its light,",
      "source": "Mark Chapter 13",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:13",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲡⲣⲏ **ⲣⲉⲃⲏ** ⲛϩⲁϩ ⲛⲥⲟⲡ · ⲁⲩⲱ ⲁϥⲣⲕⲁⲕⲉ ϩⲛⲧⲡⲁϣⲉ ⲙⲡⲉϩⲟⲟⲩ · ⲁⲡⲕⲁⲕⲉ ϩⲟⲃⲥⲛ ⲙⲡⲛⲁⲩ ⲙⲙⲉⲉⲣⲉ · ⲛⲧⲉⲓϩⲉ ⲟⲛ ⲙⲡⲛⲣϩⲟⲧⲉ ⲙⲡⲉⲡⲉⲛϩⲏⲧ ⲁⲓⲥⲑⲁⲛⲉ · ⲟⲩⲇⲉ ⲙⲡⲉⲛϣⲧⲟⲣⲧⲣ · ⲁⲙⲡⲟⲗⲉⲙⲟⲥ ⲛⲙⲡⲣⲥⲱⲥ ⲙⲛⲛⲕⲉⲃⲁⲣⲃⲁⲣⲟⲥ ·",
      "english": "Similarly, if the sun were to hide itself times without number, and were to become dark at midday, and the darkness were to envelop us at noontide, still we should not be afraid, and our hearts would never feel troubled concerning it. And we should not be disturbed at the wars which break out with the Persians, and with the other barbarians,",
      "source": "The Asceticon of Apa Ephrem part 1",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲁⲧⲉⲡⲣⲏ **ⲣⲉⲃⲏ** ⲙⲛⲡⲟⲩⲟⲉⲓⲛ ⲁⲩⲱ ⲡⲟⲟϩ ⲙⲛⲛⲥⲓⲟⲩ ⲛⲧⲉⲛⲉⲕⲗⲟⲟⲗⲉ ⲕⲧⲟⲟⲩ ⲉⲟⲩⲁϩⲟⲩ ⲛⲥⲁⲡϩⲟⲩⲙⲡⲉ",
      "english": "While the sun and light are not darkened, nor the moon and the stars; nor the clouds return after the rain:",
      "source": "Ecclesiastes 12",
      "urn": "urn:cts:copticLit:ot.eccl.coptot:12",
      "dialect": "sahidic"
    }
