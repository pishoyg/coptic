  "examples": [
    {
      "coptic": "ⲅⲣⲁⲫⲏ ⲛⲓⲃⲉⲛ ⲛⲛⲓϥⲓ ⲛⲧⲉⲫⲛⲟⲩϯ ⲥⲉⲟⲓ ⲛϩⲏⲟⲩ ⲉⲩⲥⲃⲱ ⲉⲩⲥⲟϩⲓ ⲉⲩⲧⲁϩⲟ ⲉⲣⲁⲧϥ ⲉⲩⲥⲃⲱ ⲑⲏ ⲉⲧϧⲉⲛϯ**ⲇⲓⲕⲉⲟⲥⲩⲛⲏ** .",
      "english": "Every Scripture is God-breathed and profitable for teaching, for reproof, for correction, and for instruction in righteousness,",
      "source": "16_II Timothy_03",
      "urn": "urn:cts:copticLit:nt.2tim.bohairic:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϣⲓⲛⲉ ⲛⲧⲟϥ ⲛⲥⲁⲧⲉϥⲙⲛⲧⲣⲣⲟ ⲙⲛⲧⲉϥ**ⲇⲓⲕⲁⲓⲟⲥⲩⲛⲏ** ·",
      "english": "Seek ye His kingdom and His righteousness,",
      "source": "Life of Onnophrius part 2",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:9-16",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲩⲉϣⲱⲡⲓ ⲛϫⲉⲛⲓϩⲃⲏⲟⲩⲓ ⲛⲧⲉϯⲇⲓⲕⲉⲟⲥⲩⲛⲏ ⲉⲩϩⲓⲣⲏⲛⲏ ⲟⲩⲟϩ ϯ**ⲇⲓⲕⲉⲟⲥⲩⲛⲏ** ⲉⲥⲉⲁⲙⲁϩⲓ ⲛⲟⲩⲙⲧⲟⲛ ⲟⲩⲟϩ ⲉⲩⲉϣⲱⲡⲓ ⲉⲩⲑⲏⲧⲛϩⲏⲧ ϣⲁⲉⲛⲉϩ .",
      "english": "And the works of righteousness shall be peace; and righteousness shall ensure rest, and the righteous shall be confident for ever.",
      "source": "23_Isaias_32",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:32",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲱⲧⲛ ⲇⲉ ⲛⲧⲉⲧⲛ ϩⲉⲛⲉⲃⲟⲗ ⲛϩⲏⲧϥ ϩⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲁⲓ ⲉⲛⲧⲁϥϣⲱⲡⲉ ⲛⲁⲛ ⲛⲥⲟⲫⲓⲁ ⲉⲃⲟⲗ ϩⲓⲧⲙⲡⲛⲟⲩⲧⲉ ⲛ**ⲇⲓⲕⲁⲓⲟⲥⲩⲛⲏ** ⲁⲩⲱ ⲛⲧⲃⲃⲟ ⲁⲩⲱ ⲛⲥⲱⲧⲉ .",
      "english": "But of him, you are in Christ Jesus, who was made to us wisdom from God, and righteousness and sanctification, and redemption:",
      "source": "46_1 Corinthians_1",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉϥⲉϣⲱⲡⲓ ⲉϥⲙⲏⲣ ⲛϯ**ⲇⲓⲕⲉⲟⲥⲩⲛⲏ** ⲉϫⲉⲛⲧⲉϥϯⲡⲓ ⲟⲩⲟϩ ϯⲙⲉⲑⲙⲏⲓ ⲉⲥⲉϫⲟⲗϩ ⲉⲛⲉϥⲥⲫⲓⲣⲱⲟⲩⲓ .",
      "english": "And he shall have his loins girt with righteousness, and his sides clothed with truth.",
      "source": "23_Isaias_11",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲉϥϯϩⲧⲏϥ ⲉⲛⲉⲧϥϫⲡⲟ ⲙⲙⲟⲟⲩ ⲛϭⲓⲡⲣⲙⲙⲁⲟ : ⲛⲁⲓ ⲉⲧϥⲙⲉⲉⲩⲉ ⲉⲛⲇⲱⲣⲟⲛ ⲙⲡⲛⲟⲩⲧⲉ ⲉⲃⲟⲗ ⲛϩⲏⲧⲟⲩ · ϫⲉⲙⲏⲧⲓ ⲁϥϫⲓ ⲡϩⲏⲕⲉ ⲛϭⲟⲛⲥ · ⲙⲏⲧⲓ ⲁϥⲥⲓⲁⲍⲉ ⲙⲡϭⲱⲃ ⲉⲣⲟϥ · ⲙⲏⲧⲓ ⲁϥⲡⲗⲉⲟⲛⲉⲕⲧⲉ ⲙⲡⲉⲧϩⲁⲣⲁⲧϥ · ⲉϥⲭⲣⲱ ⲛⲟⲩⲉⲝⲟⲩⲥⲓⲁ · ⲉⲡⲙⲁ ⲛⲟⲩ**ⲇⲓⲕⲁⲓⲟⲥⲩⲛⲏ** ·",
      "english": "Let the rich man consider most carefully concerning the things which he hath gotten, and among which he considereth the gifts of God to be, whether he hath acted unjustly towards the poor man, or whether he hath taken advantage of his weakness, or whether he hath claimed more than his share of that which belongeth to him, (or whether) he hath employed force (in his dealing with him) instead of righteousness.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    }
  ],
