  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁⲩ**ⲕⲱϯ** ⲛⲥⲁⲁⲙⲟⲛⲓ ⲙⲙⲟϥ ⲡⲉ ⲟⲩⲟϩ ⲁⲩⲉⲣϩⲟϯ ϧⲁⲧϩⲏ ⲙⲡⲓⲙⲏϣ ⲁⲩⲉⲙⲓ ⲅⲁⲣ ϫⲉⲉⲧⲁϥϫⲉⲧⲁⲓⲡⲁⲣⲁⲃⲟⲗⲏ ⲉⲑⲃⲏⲧⲟⲩ ⲟⲩⲟϩ ⲉⲧⲁⲩⲭⲁϥ ⲁⲩϣⲉ ⲛⲱⲟⲩ",
      "english": "They tried to seize him, but they feared the multitude; for they perceived that he spoke the parable against them. They left him, and went away.",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲉⲣⲉⲗⲁⲁⲩ ϩⲓⲟⲩⲧⲟⲉⲓⲥ ⲛϣⲁⲓ ⲉⲩϣⲧⲏⲛ ⲙⲡⲗϭⲉ . ⲥⲛⲁϥⲓ ⲅⲁⲣ **ⲙⲡⲉⲥⲕⲱⲧⲉ **ⲉⲃⲟⲗ**** ϩⲛⲧⲉϣⲧⲏⲛ ⲛϥϣⲱⲡⲉ ⲛϭⲓⲟⲩⲛⲟϭ ⲙⲡⲱϩ .",
      "english": "No one puts a piece of unshrunk cloth on an old garment; for the patch would tear away from the garment, and a worse hole is made.",
      "source": "40_Matthew_9",
      "urn": "urn:cts:copticLit:nt.matt.sahidica:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲓⲥⲣⲁⲏⲗ ⲧⲏⲣϥ ⲉⲧ**ⲕⲱϯ** ⲉⲣⲱⲟⲩ ⲁⲩⲫⲱⲧ ⲉⲃⲟⲗ ϧⲉⲛⲧⲟⲩⲥⲙⲏ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲙⲏⲡⲟⲧⲉ ⲛⲧⲉⲡⲕⲁϩⲓ ⲟⲙⲕⲧⲉⲛ ϩⲱⲛ",
      "english": "And all Israel round about them fled from the sound of them, for they said, Lest the earth swallow us up also.",
      "source": "04_Numeri_16",
      "urn": "urn:cts:copticLit:ot.num.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛ ⲟⲩⲃⲏⲃ ⲛϩⲱϯ ⲧⲉ ⲧⲁⲕⲗⲏⲣⲟⲛⲟⲙⲓⲁ ⲛⲏⲓ ⲙⲏ ⲁⲛ ⲟⲩⲙϩⲁⲩ ⲉⲧ**ⲕⲱϯ** ⲉⲣⲟⲥ ⲙⲁϣⲉⲛⲱⲧⲉⲛ ⲑⲱⲟⲩϯ ⲛⲛⲓⲑⲏⲣⲓⲟⲛ ⲧⲏⲣⲟⲩ ⲛⲧⲉⲧⲕⲟⲓ ⲟⲩⲟϩ ⲙⲁⲣⲟⲩⲓ ⲉⲑⲣⲟⲩⲟⲩⲟⲙⲥⲟⲩ .",
      "english": "Is not my inheritance to me a hyaena's cave, or a cave round about her? Go ye, gather together all the wild beasts of the field, and let them come to devour her.",
