  "examples": [
    {
      "coptic": "ⲁϥⲙⲟⲩⲧⲉ ⲉⲡⲉϥϣⲏⲣⲉ ⲡⲉϫⲁϥ ⲛⲁϥ · ϫⲉⲡⲁϣⲏⲣⲉ ⲉⲓⲥϩⲏⲏⲧⲉ ⲁⲛⲟⲕ **ϯⲛⲁⲃⲱⲕ **ϩⲓ**ⲧⲉϩⲓⲏ** ⲙⲡⲕⲁϩ ⲧⲏⲣϥ ·",
      "english": "And ho called his son and said unto him, 'My son, behold I am going the way of all the earth.",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ **ⲉⲓⲛⲁⲃⲱⲕ **ϩⲓ**ⲧⲉϩⲓⲏ** ⲕⲁⲧⲁⲡⲧⲱϣ ⲛⲣⲱⲙⲉ ⲛⲓⲙ ⲉⲧϩⲓϫⲙ ⲡⲕⲁϩ ⲁⲩⲱ ⲧⲉⲧⲛⲁⲉⲓⲙⲉ ϩⲙⲡⲉⲧⲛϩⲏⲧ ⲙⲛⲧⲉⲧⲛⲯⲩⲭⲏ ϫⲉⲙⲡⲉⲟⲩϣⲁϫⲉ ⲛⲟⲩⲱⲧ ⲉⲓ ⲉⲡⲁϩⲟⲩ ⲉⲃⲟⲗ ϩⲛⲛϣⲁϫⲉ ⲧⲏⲣⲟⲩ ⲉⲛⲧⲁϥϫⲟⲟⲩ ⲛϭⲓⲡϫⲟⲉⲓⲥ ⲡⲉⲛⲛⲟⲩⲧⲉ ⲕⲁⲧⲁϩⲱⲃ ⲛⲓⲙ ⲉⲧϫⲓ ⲉϩⲟⲩⲛ ⲉⲣⲟⲛ ⲙⲡⲉⲟⲩϣⲁϫⲉ ⲛⲟⲩⲱⲧ ⲣϭⲟⲗ ⲛϩⲏⲧⲟⲩ",
      "english": "But I hasten to go the way of death, as all that are upon the earth also do: and ye know in your heart and in your soul, that not one word has fallen to the ground of all the words which the Lord our God has spoken respecting all that concerns us; there has not one of them failed.",
      "source": "Joshua 23",
      "urn": "urn:cts:copticLit:ot.josh.coptot:23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲛⲉⲛⲧⲁⲡⲁⲗⲁⲟⲥ ⲥⲱⲧⲙ ⲛⲥⲱⲓ ⲡⲓⲥⲣⲁⲏⲗ **ⲉⲛⲉⲛⲧⲁϥⲃⲱⲕ **ϩⲓ**ⲛⲁϩⲓⲟⲟⲩⲉ**",
      "english": "If my people had hearkened to me, if Israel had walked in my ways,",
      "source": "Psalms 80",
      "urn": "urn:cts:copticLit:ot.pss.coptot:80",
      "dialect": "sahidic"
    }
