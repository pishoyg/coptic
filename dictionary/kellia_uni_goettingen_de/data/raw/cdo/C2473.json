  "examples": [
    {
      "coptic": "ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁϧⲟⲕ ⲛⲉⲙⲁⲛ ⲓⲏⲥⲟⲩⲥ ⲡⲓⲣⲉⲙⲛⲁⲍⲁⲣⲉⲑ ⲉⲧⲁⲕⲓ ⲉⲧⲁⲕⲟⲛ ⲧⲉⲛⲥⲱⲟⲩⲛ ⲙⲙⲟⲕ ϫⲉⲛⲑⲟⲕ **ⲛⲓⲙ** ⲡⲓϩⲁⲅⲓⲟⲥ ⲛⲧⲉⲫⲛⲟⲩϯ .",
      "english": "saying, 'Ha! What do we have to do with you, Jesus, you Nazarene? Have you come to destroy us? I know you who you are: the Holy One of God!'",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁⲩ ⲇⲉ ⲛϭⲓϩⲟⲓⲛⲉ ϫⲉ**ⲛⲓⲙ** ⲡⲉ ⲡⲉⲓⲕⲉⲟⲩⲁ ·",
      "english": "Some said, 'Who even is this person?'",
      "source": "Apophthegmata Patrum Sahidic 139: N 306",
      "urn": "urn:cts:copticLit:ap.139.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁϥϣⲓⲛⲓ ⲙⲙⲟϥ ϫⲉ**ⲛⲓⲙ** ⲡⲉ ⲡⲉⲕⲣⲁⲛ ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲗⲉⲅⲓⲱⲛ ⲡⲉ ⲡⲁⲣⲁⲛ ϫⲉⲧⲉⲛⲉⲣⲟⲩⲙⲏϣ",
      "english": "He asked him, 'What is your name?' He said to him, 'My name is Legion, for we are many.'",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲛⲓⲙ** ⲡⲉ ⲛⲧⲁϥϥⲓ ⲙⲡⲁϩⲏⲃⲥ ⲛϩⲏⲧ ·",
      "english": "Who hath carried away the light of my body?",
