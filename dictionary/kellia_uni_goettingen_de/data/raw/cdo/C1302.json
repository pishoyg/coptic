  "examples": [
    {
      "coptic": "ⲫⲏ ⲉⲧⲉⲡⲉϥϩⲱⲃ ⲛⲁⲣⲱⲕϩ ϥⲛⲁϯⲟⲥⲓ ⲛⲑⲟϥ ⲇⲉ ϥⲛⲁⲛⲟϩⲉⲙ ⲡⲁⲓⲣⲏϯ ⲇⲉ ϩⲱⲥ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲟⲩ**ⲭⲣⲱⲙ** .",
      "english": "If any man's work is burned, he will suffer loss, but he himself will be saved, but as through fire.",
      "source": "Bohairic 1 Corinthians 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϫⲓⲥ ⲉⲣⲟⲟⲩ ϫⲉⲁⲡⲟⲧⲁⲥⲥⲉ ⲛⲛⲓϣⲁϫⲉ ⲉⲧϩⲟⲟⲩ ϫⲉⲉⲧⲉⲧⲛⲙⲡϣⲁ ⲛⲙⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲙⲡⲟⲩⲟⲉⲓⲛ ⲛⲧⲉⲧⲛⲛⲟⲩϩⲙ ⲉⲛⲓⲕⲟⲗⲁⲥⲓⲥ ⲛⲓⲉⲣⲟ ⲛ**ⲕⲣⲱⲙ** ·",
      "english": "“Say unto them: Renounce evil conversation, that ye may be worthy of the mysteries of the Light and be saved from the chastisements of the fire-rivers . . . .”",
      "source": "Pistis Sophia Book 3 Part 1",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:77-81",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲁⲧⲟⲧϥ ⲁϥⲟⲩⲱⲧⲉⲛ ⲛϯⲟⲩⲛⲟⲩ ⲙⲫⲣⲏϯ ⲛⲟⲩⲙⲟⲩⲗϩ ⲛⲁϩⲣⲉⲛⲟⲩ**ⲭⲣⲱⲙ** ⲟⲩⲟϩ ⲁϥϯⲛⲟϩ ⲉϧⲟⲩⲛ ⲉⲡⲓⲱⲛⲓ ⲁϥⲁⲙⲟⲛⲓ ⲙⲙⲟϥ",
      "english": "Instantly, the stone gave way, pierced as effortlessly as wax before a flame. He threaded the rope through the opening and fastened it.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲉⲯⲩⲭⲟⲟⲩⲉ ϭⲉ ⲉⲧϥⲛⲁϥⲓⲧⲟⲩ ⲛⲥⲧⲉⲣⲉⲥⲓⲙⲟⲛ ⲛϭⲓⲡⲉⲓⲁⲣⲭⲱⲛ ϣⲁⲩϣⲱⲡⲉ ϩⲛⲛⲉϥⲕⲟⲗⲁⲥⲓⲥ ⲛϣⲉ ⲧⲁⲉⲓⲟⲩ ⲛⲣⲟⲙⲡⲉ ⲙⲛϣⲙⲟⲩⲛ ⲛⲉⲃⲟⲧ ⲛϥⲁⲛϩⲁⲗⲓⲥⲕⲉ ⲙⲙⲟⲟⲩ ϩⲓⲧⲙⲡⲉϥ**ⲕⲣⲱⲙ** ⲛⲕⲁⲕⲉ ⲙⲛⲡⲉϥⲕⲱϩⲧ ⲙⲡⲟⲛⲏⲣⲟⲛ ⲉⲩⲑⲗⲓⲃⲉ ⲙⲙⲟⲟⲩ ⲉⲙⲁⲧⲉ ϩⲓⲧⲙⲡϣⲁϩ ⲙⲡⲉϥⲕⲱϩⲧ ·",
      "english": "“The souls then which this ruler will carry off in ravishment, are in his chastisements one-hundred-and-fifty years and eight months; and he destroyeth them through his dark smoke and his wicked fire, while they are exceedingly afflicted through the flames of his fire.”",
      "source": "Pistis Sophia Book 4 Part 1",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:120-128",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲟⲩⲙⲏϣ ⲛⲥⲟⲡ ϣⲁϥϩⲓⲧϥ ⲉⲡⲓ**ⲭⲣⲱⲙ** ⲛⲉⲙⲡⲓⲙⲱⲟⲩ ϩⲓⲛⲁ ⲛⲧⲉϥⲧⲁⲕⲟϥ ⲁⲗⲗⲁ ⲡⲉⲧⲉⲟⲩⲟⲛ ϣϫⲟⲙ ⲙⲙⲟⲕ ⲉⲣⲟϥ ⲁⲣⲓⲃⲟⲏⲑⲓⲛ ⲉⲣⲟⲛ ⲉⲁⲕϣⲉⲛϩⲏⲧ ⲉϫⲱⲛ .",
      "english": "Often it has cast him both into the fire and into the water, to destroy him. But if you can do anything, have compassion on us, and help us.'",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
