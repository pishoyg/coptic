  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ϥⲛⲁϣⲱⲡⲓ ⲛⲥⲟⲗⲥⲉⲗ ⲛⲉⲙⲥⲕⲉⲡⲓ ⲛⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲑⲛⲁϣⲉ ⲉⲣⲁⲧϥ ⲙⲡⲉϥ**ⲧⲟⲡⲟⲥ** ⲟⲩⲟϩ ⲧⲉϥⲉⲕⲕⲗⲏⲥⲓⲁ ⲥⲛⲁϣⲱⲡⲓ ⲉⲥⲙⲏⲛ ⲉⲃⲟⲗ ϣⲁϩⲁⲛϫⲱⲟⲩ .",
      "english": "He will build a monastery, and he will become a jewel and a protector for anyone who will come before his place, and his church will remain for generations.”",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲁⲣⲉⲛⲃⲱⲕ ϣⲁⲡⲉⲓ**ⲧⲟⲡⲟⲥ**",
      "english": "and we will go to that place.”",
      "source": "Apophthegmata Patrum Sahidic 100: Anonymous N 294",
      "urn": "urn:cts:copticLit:ap.100.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣⲱⲡ ⲁⲓϣⲁⲛⲉⲣϩⲏⲧⲥ ⲙⲫⲓⲣⲓ ⲉⲡⲓϫⲓⲛⲱⲛϧ ⲛⲧⲉⲛⲉⲛⲓⲟϯ ϯⲛⲁⲭⲁⲟⲩ**ⲧⲟⲡⲟⲥ** ⲉⲃⲟⲗ ⲁⲛ ⲉⲁⲓϩⲱⲗ ⲉⲣⲟϥ ⲛⲧⲁϣⲧⲉⲙⲧⲁⲙⲟⲕ ⲉⲣⲟϥ ⲓⲧⲉ ⲛⲏ ⲉⲧϧⲉⲛⲛⲓⲃⲁⲕⲓ ⲓⲧⲉ ⲛⲏ ⲉⲧϧⲉⲛⲛⲓϯⲙⲓ ⲓⲧⲉ ⲛⲏ ⲉⲧϧⲉⲛⲡϣⲁϥⲉ ⲓⲧⲉ ⲛⲏ ⲉⲧϧⲉⲛⲧⲁⲛⲓⲣⲱⲙⲓ ⲛⲟⲩⲕⲟⲩϫⲓ",
      "english": "When I begin to tell you the lives of our Fathers, I will omit no place into which I have entered to instruct you—neither those who dwell in cities, nor in villages, nor in the desert, nor those who live only briefly among others.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲃⲟⲧⲉ ϩⲛⲛ**ⲧⲟⲡⲟⲥ** ⲉⲧⲟⲩⲁⲁⲃ",
      "english": "The abominations in the holy places",
      "source": "I See Your Eagerness: GL 29-30",
      "urn": "urn:cts:copticLit:shenoute.eagerness.monbgl_29_30",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉ ⲟⲩⲟⲛ ⲟⲩ**ⲧⲟⲡⲟⲥ** ⲛⲧⲉⲛⲉϥⲓⲟϯ ⲥⲁⲃⲟⲗ ⲙⲡⲓⲧⲓⲙⲓ ⲉϥϣⲟⲡ ⲛϧⲏⲧϥ ⲛϫⲉⲟⲩϧⲉⲗⲗⲟ ⲙⲙⲟⲛⲁⲭⲟⲥ ⲁⲩϫⲱⲓⲗⲓ ⲉⲡⲓⲧⲟⲡⲟⲥ ⲛⲉⲁⲫⲣⲏ ϩⲱⲧⲡ ⲡⲉ .",
      "english": "There was a place outside the village belonging to his parents, and inhabited by an old monk, and there they sought hospitality at the moment when the sun had set.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲧⲁⲁⲩ ⲉϩⲟⲩⲛ ⲉⲡ**ⲧⲟⲡⲟⲥ** ⲙⲡϩⲁⲅⲓⲟⲥ ⲃⲓⲕⲧⲱⲣ ·",
      "english": "and he gave them to the shrine of Saint Victor;",
