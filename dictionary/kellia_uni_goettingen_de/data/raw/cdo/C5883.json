  "examples": [
    {
      "coptic": "ⲡⲓⲥⲧⲉⲩⲉ ⲛⲁⲓ ⲱ ⲡⲁⲙⲉⲣⲓⲧ ⲛⲉⲓⲱⲧ ϫⲉⲉⲓⲥϫⲟⲩⲱⲧⲉ ⲛⲣⲟⲙⲡⲉ · ϫⲓⲛⲛⲧⲁⲓⲉⲓ ⲉⲡⲉⲓⲙⲁ ⲧⲉⲓϩⲃⲥⲱ ⲛⲟⲩⲱⲧ ⲧⲉⲧⲓϭⲓⲛⲉ ⲛⲧⲁϩⲙⲙⲉ ⲛϩⲏⲧⲥ · ⲛⲧⲉⲡⲣⲱ · ⲁⲩⲱ ⲧⲕⲉⲕⲣⲁⲥⲓⲥ ⲙⲡⲁⲏⲣ ⲙⲡ**ϣⲱⲙ** ·",
      "english": "Believe me, O my beloved father, behold, it is twenty years ago since I came to this place, and with this single garment I have found means to keep myself warm during the winter, and to moderate the heat of the atmosphere in summer time.",
      "source": "Life of Cyrus in Budge ed. part 1",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲃⲟⲗ ⲇⲉ ⲛⲧⲃⲱ ⲛⲕⲛⲧⲉ ⲉⲧⲉⲧⲛⲉⲉⲓⲙⲉ ⲉⲧⲡⲁⲣⲁⲃⲟⲗⲏ . ⲉⲣϣⲁⲛⲡⲉⲥⲕⲗⲁⲇⲟⲥ ⲏⲇⲏ ⲗⲱⲕ ⲛⲧⲉⲛⲉⲥϭⲱⲃⲉ ϯⲟⲩⲱ ⲛϣⲁⲧⲉⲧⲛⲉⲓⲙⲉ ϫⲉⲁⲡ**ϣⲱⲙ** ϩⲱⲛ ⲉϩⲟⲩⲛ .",
      "english": "Now from the fig tree, learn this parable. When the branch has now become tender, and puts forth its leaves, you know that the summer is near;",
      "source": "41_Mark_13",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:13",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲣϣⲁⲛⲡϣⲱⲙ ⲇⲉ ϣⲱⲡⲉ ϣⲁⲩϫⲟⲟⲥ · ϫⲉⲉⲣϣⲁⲛⲡ**ϣⲱⲙ** ⲡⲁⲣⲁⲅⲉ ⲧⲛⲛⲁⲡⲱⲱⲛⲉ ⲉⲃⲟⲗ ϩⲙⲡⲉⲓⲙⲁ .",
      "english": "And when summer came, they would say, 'When summer ends, we will flee this place.'",
      "source": "Apophthegmata Patrum Sahidic 036",
      "urn": "urn:cts:copticLit:ap.36.monbeg",
      "dialect": "sahidic"
    }
  ],
