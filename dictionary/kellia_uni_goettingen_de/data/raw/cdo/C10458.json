  "examples": [
    {
      "coptic": "ⲧⲉⲛⲟⲩ ϭⲉ ⲛⲟⲩⲇⲓⲕⲁⲓⲟⲛ ⲡⲉ ⲉⲓⲣⲉ ⲕ**ⲥⲕⲁⲛⲇⲁⲗⲓⲍⲉ** ⲙⲡⲗⲁⲟⲥ ⲛⲧⲁⲡⲛⲟⲩⲧⲉ ⲕⲁⲑⲓⲥⲧⲁ ⲙⲙⲟⲕ ⲉϫⲱϥ ·",
      "english": "Now, therefore, is it a right thing for thee to cause a scandal among the people over whom God hath set thee?'",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲣϣⲁⲛⲧⲉⲕϭⲓϫ **ⲥⲕⲁⲛⲇⲁⲗⲓⲍⲉ** ⲙⲙⲟⲕ ϣⲁⲁⲧⲥ ⲉⲃⲟⲗ ⲙⲙⲟⲕ ⲛⲁⲛⲟⲩⲥ ⲛⲁⲕ ⲉⲃⲱⲕ ⲉϩⲟⲩⲛ ⲉⲡⲱⲛϩ ⲉⲕⲟ ⲛϭⲁⲛⲁϩ ⲉϩⲟⲩ ⲉⲣⲟⲥ ⲉⲣⲉϭⲓϫ ⲥⲛⲧⲉ ⲙⲙⲟⲕ ⲛⲅⲃⲱⲕ ⲅⲉϩⲉⲛⲛⲁ ⲉⲧⲥⲁⲧⲉ ⲉⲙⲉⲥϫⲉⲛⲁ .",
      "english": "If your hand causes you to stumble, cut it off. It is better for you to enter into life maimed, rather than having your two hands to go into Gehenna, into the unquenchable fire,",
      "source": "41_Mark_9",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲁⲓ ⲁⲛ ⲡⲉ ⲡϩⲁⲙϣⲉ ⲡϣⲏⲣⲉ ⲙⲙⲁⲣⲓⲁ . ⲁⲩⲱ ⲡⲥⲟⲛ ⲛⲓⲁⲕⲱⲃⲟⲥ ⲛⲙⲓⲱⲥⲏ ⲛⲙⲓⲟⲩⲇⲁ ⲛⲙⲥⲓⲙⲱⲛ . ⲁⲩⲱ ⲛⲉϥⲥⲱⲛⲉ ⲛⲉⲩⲛⲡⲉⲓⲙⲁ ⲁⲛ ϩⲁϩⲧⲏⲛ ⲁⲩ**ⲥⲕⲁⲛⲇⲁⲗⲓⲍⲉ** ϩⲣⲁⲓ ⲛϩⲏⲧϥ .",
      "english": "Isn't this the carpenter, the son of Mary, and brother of James, Joses, Judah, and Simon? Aren't his sisters here with us?' They were offended at him.",
      "source": "Mark Chapter 6",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:6",
      "dialect": "sahidic"
    }
  ],
