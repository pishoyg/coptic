  "examples": [
    {
      "coptic": "ⲛⲓⲛⲱⲓⲕ ⲛⲧⲉⲧⲉⲛⲉⲙⲓ ⲁⲛ ϫⲉϯⲙⲉⲧϣⲫⲏⲣ ⲛⲧⲉⲡⲓⲕⲟⲥⲙⲟⲥ ⲟⲩⲙⲉⲧϫⲁϫⲓ ⲧⲉ ⲛⲧⲉⲫⲛⲟⲩϯ ⲫⲏ ⲇⲉ ⲉⲑⲟⲩⲱϣ ⲉⲉⲣϣⲫⲏⲣ ⲉⲡⲓⲕⲟⲥⲙⲟⲥ ϥⲛⲁϣⲱⲡⲓ ⲉϥⲟⲓ ⲛ**ϫⲁϫⲓ** ⲉⲫⲛⲟⲩϯ",
      "english": "You adulterers and adulteresses, don't you know that friendship with the world is enmity with God? Whoever therefore wants to be a friend of the world makes himself an enemy of God.",
      "source": "20_James_04",
      "urn": "urn:cts:copticLit:nt.jas.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲥϫⲟⲟⲥ ⲛⲁⲓ ⲟⲛ ⲉⲧⲃⲉϩⲉⲛⲕⲟⲟⲩⲉ · ⲁⲩⲱ ⲛⲧⲉⲣⲉⲧⲥⲩⲛⲏⲑⲓⲁ ϣⲱⲡⲉ · ⲉⲧⲣⲛⲁⲡⲁⲛⲧⲁ ⲉⲛⲉⲛⲉⲣⲏⲩ · ⲁⲡ**ϫⲁϫⲉ** ⲧⲁⲁⲥ ⲉⲡⲁϩⲏⲧ · ⲉⲧⲣⲁϫⲓϩⲱⲃ ⲛϭⲓϫ ⲛⲧⲟⲟⲧⲥ ·",
      "english": "and she talked to me about further work. And it became a customary thing for us to meet each other, and the Enemy put it into my heart to take work of the hands from her.",
      "source": "Life of Onnophrius part 1",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉϣⲱⲡ ⲁⲣⲉϣⲁⲛ ⲡⲉⲕ**ϫⲁϫⲓ** ϩⲕⲟ ⲙⲁⲧⲉⲙⲙⲟϥ ⲁϥϣⲁⲛⲓⲃⲓ ⲙⲁⲧⲥⲟϥ ⲫⲁⲓ ⲅⲁⲣ ⲉⲕⲣⲁ ⲙⲙⲟϥ ⲉⲕⲉⲑⲱⲟⲩϯ ⲛϩⲁⲛϫⲉⲃⲥ ⲛⲭⲣⲱⲙ ϩⲓϫⲉⲛⲧⲉϥⲁⲫⲉ .",
      "english": "Therefore 'If your enemy is hungry, feed him. If he is thirsty, give him a drink; for in doing so, you will heap coals of fire on his head.'",
      "source": "06_Romans_12",
      "urn": "urn:cts:copticLit:nt.rom.bohairic:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲏ ⲙⲡⲓϯⲉⲝⲟⲩⲥⲓⲁ ⲛⲁⲕ ⲉϩⲱⲙ ⲉϫⲛⲛϩⲟϥ ⲙⲛⲛⲟⲩⲟⲟϩⲉ · ⲁⲩⲱ ⲉϫⲛⲧϭⲟⲙ ⲧⲏⲣⲥ ⲙⲡ**ϫⲁϫⲉ** ⁛—",
      "english": "Did I not give unto thee the power to trample under thy feet vipers and scorpions, and all the might of the Enemy?",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲱⲧⲉⲙ ⲫⲛⲟⲩϯ ⲉⲧⲁⲡⲣⲟⲥⲉⲩⲭⲏ ϧⲉⲛⲡϫⲓⲛⲧⲁⲧⲱⲃϩ: ⲛⲟϩⲉⲙ ⲛⲧⲁ\\'ⲩⲭⲏ ⲉⲃⲟⲗ ϧⲉⲛⲧϩⲟϯ ⲛⲟⲩ**ϫⲁϫⲓ** ⲁⲕⲉⲣⲥⲕⲉⲡⲁⲍⲓⲛ ⲙⲙⲟⲓ ⲉⲃⲟⲗ ϩⲁϯⲙⲉⲧⲥⲁⲛⲕⲟⲧⲥ ⲛⲧⲉⲛⲓⲣⲉϥⲉⲣⲡⲉⲧϩⲱⲟⲩ .",
      "english": "Hear my prayer, O God, when I make my petition to thee; deliver my soul from fear of the enemy.",
      "source": "19_Psalmi_63",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:63",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲩϣⲁⲛⲣϫⲟⲉⲓⲥ ⲇⲉ ⲟⲛ ⲉⲣⲟϥ ⲉⲃⲟⲗ ϩⲓⲧⲛⲧⲉⲭⲙⲁⲗⲱⲥⲓⲁ ⲙⲡ**ϫⲁϫⲉ** · ϣⲁⲣⲉⲡⲉⲡⲛⲉⲩⲙⲁ ⲟⲛ ⲙⲡⲛⲟⲩⲧⲉ ⲃⲱⲕ ϣⲁⲣⲟϥ ⲛϩⲛⲥⲟⲡ ⲥⲟⲡ ·",
      "english": "Ⲓf, on the contrary, the captivity of the enemy rules them, then the spirit of God will still visit them on occasion.",
      "source": "Apophthegmata Patrum Sahidic 067",
      "urn": "urn:cts:copticLit:ap.67.monbeg",
      "dialect": "sahidic"
    }
  ],
