  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲣⲟⲩϩⲓ ϣⲱⲡⲓ ⲁϥ**ⲓ** ⲛⲉⲙⲡⲓⲓⲃ .",
      "english": "When it was evening he came with the twelve.",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲉⲓ** ⲇⲉ ⲙⲡⲓⲧⲁⲁⲩ ⲛⲏⲧⲛ ⲡⲣⲟⲥⲧϩⲉ ⲛⲧⲁⲓϣⲏⲣⲡⲥϩⲁⲓ",
      "english": "If I do not give them to you as I wrote earlier",
      "source": "Honey Delivery",
      "urn": "urn:cts:copticDoc:papyri_info.tm82149.cpr_4_16",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲑⲃⲉⲟⲩ ϫⲉⲟⲩϩⲟⲣⲁⲥⲓⲥ ⲧⲉ ⲛⲧⲉⲟⲩⲥⲏⲟⲩ ⲟⲩⲟϩ ⲉⲥⲉⲉⲣⲟⲩⲱⲓⲛⲓ ⲉⲩϧⲁⲉ ⲟⲩⲟϩ ⲡⲉⲧϣⲟⲩⲓⲧ ⲁⲛ ⲉϣⲱⲡ ⲁϥϣⲁⲛϭⲓϩⲟ ϫⲟⲩϣⲧ ϧⲁϫⲱϥ ϫⲉϧⲉⲛⲟⲩ**ⲓ** ϥⲛⲁⲓ ⲟⲩⲟϩ ⲛⲛⲉϥⲱⲥⲕ .",
      "english": "For the vision is yet for a time, and it shall shoot forth at the end, and not in vain: though he should tarry, wait for him; for he will surely come, and will not tarry.",
      "source": "Bohairic Habakkuk 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲉⲓ** ⲙⲏ ⲛⲧϩⲉ ⲉⲛⲧⲁⲡϫⲟⲉⲓⲥ ⲧⲉϣⲡⲟⲩⲁ ⲡⲟⲩⲁ ⲙⲙⲟⲥ . ⲡⲟⲩⲁ ⲡⲟⲩⲁ ⲛⲧϩⲉ ⲉⲛⲧⲁⲡⲛⲟⲩⲧⲉ ⲧⲁϩⲙⲉϥ ⲙⲁⲣⲉϥⲙⲟⲟϣⲉ ⲙⲙⲟⲥ . ⲁⲩⲱ ⲧⲁⲓ ⲧⲉ ⲧϩⲉ ⲉϯⲧⲱϣ ⲙⲙⲟⲥ ϩⲛⲛⲉⲕⲕⲗⲏⲥⲓⲁ ⲛⲓⲙ .",
      "english": "Only, as the Lord has distributed to each man, as God has called each, so let him walk. So I command in all the assemblies.",
      "source": "1 Corinthians 7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏⲡⲱⲥ ⲛⲧⲉϥ**ⲓ** ⲛⲟⲩϩⲟϯ ϧⲉⲛⲟⲩϩⲟϯ ⲛⲧⲉϥϫⲉⲙⲑⲏⲛⲟⲩ ⲉⲣⲉⲧⲉⲛⲛⲕⲟⲧ .",
      "english": "lest coming suddenly he might find you sleeping.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲉⲡⲉⲓⲇⲏ ⲁϩⲉⲛⲉⲃⲓⲁⲧⲉ **ⲉⲓ** ⲁⲩⲟⲩⲱϩ ϩⲙⲡⲁⲣⲓⲅⲟⲣⲓ",
