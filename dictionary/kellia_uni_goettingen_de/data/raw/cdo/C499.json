  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲓⲍ ⲉϩⲣⲉⲛⲡⲓⲇ ⲛϣⲟ ϫⲉⲁⲧⲉⲧⲉⲛⲉⲗⲟⲩⲏⲣ ⲙ**ⲃⲓⲣ** ⲉⲩⲙⲉϩ ⲛⲗⲁⲕϩ ⲟⲩⲟϩ ⲡⲉϫⲱⲟⲩ ⲛⲁϥ ϫⲉⲍ .",
      "english": "When the seven loaves fed the four thousand, how many baskets full of broken pieces did you take up?' They told him, 'Seven.'",
      "source": "Bohairic Gospel of Mark 8 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:8",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲉⲧⲉⲧⲛⲣⲟⲩ ⲛⲛⲉⲓ**ⲃⲓⲣ** ·",
      "english": "What are you doing with these baskets?'",
      "source": "Apophthegmata Patrum Sahidic 119: Sisoes 16",
      "urn": "urn:cts:copticLit:ap.119.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲩⲟⲩⲱⲙ ⲟⲩⲟϩ ⲁⲩⲥⲓ ⲟⲩⲟϩ ⲁⲩⲱⲗⲓ ⲛⲛⲓϩⲟⲩⲟ ⲛⲧⲉⲛⲓⲗⲁⲕϩ ⲍ ⲙ**ⲃⲓⲣ** .",
      "english": "They ate, and were filled. They took up seven baskets of broken pieces that were left over.",
      "source": "Bohairic Gospel of Mark 8 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:8",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲟⲧⲉ ⲡⲉϫⲁϥ ⲛⲃⲓⲃⲣⲟⲥ ϫⲉϫⲓ ⲛⲙⲙⲁⲕ ⲛⲥⲟⲛ ⲥⲛⲁⲩ · ⲉⲩⲛϩⲉⲛ**ⲃⲓⲣ** ⲛⲧⲟⲟⲧⲟⲩ · ⲙⲛϩⲉⲛⲧⲱⲣⲉ · ⲛⲧⲉⲧⲛⲟⲩⲉϩⲧⲏⲩⲧⲛ ⲛⲥⲱⲓ ·",
      "english": "Then he said to Birros, 'Take with thee two brethren, and let them have baskets in their hands, and digging tools, and follow ye me.'",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲓⲍ ⲉϩⲣⲉⲛⲡⲓⲇ ⲛϣⲟ ϫⲉⲁⲧⲉⲧⲉⲛⲉⲗ ⲟⲩⲏⲣ ⲙ**ⲃⲓⲣ** ⲉⲩⲙⲉϩ ⲛⲗⲁⲕϩ ⲟⲩⲟϩ ⲡⲉϫⲱⲟⲩ ⲛⲁϥ ϫⲉⲍ .",
