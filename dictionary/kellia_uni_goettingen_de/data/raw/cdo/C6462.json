  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲓⲙⲁ ⲉϣⲁϥϣⲉ ⲛⲁϥ ⲉϧⲟⲩⲛ ⲉⲣⲟϥ ⲉⲛⲓϯⲙⲓ ⲓⲉ ⲛⲓⲃⲁⲕⲓ ⲓⲉ ⲛⲓⲓⲟϩⲓ ⲛⲁⲩⲭⲱ ⲛⲛⲏ ⲉⲧϣⲱⲛⲓ ϩⲓⲛⲓⲁⲅⲟⲣⲁ ⲟⲩⲟϩ ⲛⲁⲩϯϩⲟ ⲉⲣⲟϥ ϩⲓⲛⲁ ⲕⲁⲛ ⲛⲧⲟⲩϭⲓ ⲛⲉⲙⲡⲓϣⲧⲁϯ ⲛⲧⲉⲛⲉϥ**ϩⲃⲱⲥ** ⲟⲩⲟϩ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉϣⲁⲩϭⲓ ⲛⲉⲙⲁϥ ϣⲁⲩⲟⲩϫⲁⲓ .",
      "english": "Wherever he entered, into villages, or into cities, or into the country, they laid the sick in the marketplaces, and begged him that they might touch just the fringe of his garment; and as many as touched him were made well.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲉⲛⲉϥⲁϩⲉⲣⲁⲧϥ · ⲉⲣⲉⲟⲩϣⲧⲏⲛ ⲛ**ϩⲃⲟⲟⲥ** ϩⲓⲱⲱϥ · ⲙⲁⲩⲁⲁⲥ · ⲉⲥϫⲓ ⲧⲟⲧⲉ ⲉⲡⲥⲁ ⲥⲛⲁⲩ ·",
      "english": "Then John stood on his feet — now the only garment which he had on him was a tunic which came down on both sides",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉⲙⲟⲩⲥⲉϩⲧ ϧⲉⲛⲟⲩ**ϩⲃⲱⲥ** ⲛⲉⲙⲟⲩⲏⲓ",
      "english": "and of the leprosy of a garment, and of a house,",
      "source": "03_Leviticus_14",
      "urn": "urn:cts:copticLit:ot.lev.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟⲕ ⲇⲉ ⲱ ⲓⲱϩⲁⲛⲛⲏⲥ ϣⲟⲡϥ ⲛ**ϩⲃⲟⲟⲥ** ⲡⲁⲥⲱⲙⲁ · ⲁⲩⲱ ⲙⲡⲣⲛⲉϫⲕⲉⲗⲁⲁⲩ ⲉⲣⲟⲓ · ⲉⲓⲙⲏⲧⲓ ⲧⲗⲉⲃⲓⲧⲟⲛ ⲛⲧⲁⲩⲙⲟⲣⲧ ⲙⲙⲟⲥ ⲙⲛⲡⲁⲥⲭⲏⲙⲁ ⲙⲛⲧⲁⲕⲟⲩⲕⲗⲉ · ⲙⲛⲡⲁⲙⲟϫⲕϥ · ⲙⲛⲧⲁϭⲟⲟⲗⲉⲥ · ⲙⲙⲁⲧⲉ · ⲛⲧⲉⲧⲛⲕⲟⲥⲧ ⲛⲧⲉⲧⲛⲧⲟⲙⲥⲧ ·",
      "english": "Do thou then, O John, buy a covering for my body, and do not put on me anything except the shroud wherein I am wrapped, and my monk's dress, and my skull-cap, and my girdle, and my tunic—only these—and ye shall prepare me for burial and ye shall bury me.",
      "source": "Life of Pisentius part 3",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:58-84",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲟⲩⲕⲁⲕⲥⲉϩⲧ ⲫⲏ ⲉⲧⲉⲡⲓϭⲟϩ ϩⲓϫⲱϥ ⲛⲉϥ**ϩⲃⲱⲥ** ⲉⲩⲉϣⲱⲡⲓ ⲉⲩⲫⲉⲣⲫⲱⲣ ⲟⲩⲟϩ ⲛⲧⲉϥⲁⲫⲉ ⲉⲥϩⲟⲃⲥ ⲁⲛ ⲟⲩⲟϩ ⲉϥⲉϩⲱⲃⲥ ⲙⲡⲕⲱϯ ⲛⲣⲱϥ ⲟⲩⲟϩ ⲉⲩⲉⲙⲟⲩϯ ⲉⲣⲟϥ ϫⲉϥϭⲁϧⲉⲙ",
      "english": "And the leper in whom the plague is, let his garments be ungirt, and his head uncovered; and let him have a covering put upon his mouth, and he shall be called unclean.",
      "source": "03_Leviticus_13",
      "urn": "urn:cts:copticLit:ot.lev.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
