  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲡϩⲏⲧ ⲙⲡⲟⲩⲣⲟ ⲙⲕⲁϩ ⲉⲑⲃⲉⲛⲓⲁⲛⲁⲩϣ ⲛⲉⲙⲛⲏ ⲉⲑⲣⲟⲧⲉⲃ ⲛⲉⲙⲁϥ ⲙⲡⲉϥ**ⲟⲩⲱϣ** ⲉϥⲟϫⲥ .",
      "english": "The king was exceedingly sorry, but for the sake of his oaths, and of his dinner guests, he didn't wish to refuse her.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲩⲉ ⲉϥϫⲱ ⲙⲙⲟⲥ . ϫⲉⲉⲓ**ⲟⲩⲱϣ** ⲉⲧⲟⲩϫⲉⲧⲁⲯⲩⲭⲏ .",
      "english": "…he saying, “I desire to save my soul.”",
      "source": "Apophthegmata Patrum Sahidic 001: Anonymous Nau 135",
      "urn": "urn:cts:copticLit:ap.1.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩ ϫⲉⲡⲉⲧⲉⲧⲉⲛ**ⲟⲩⲁϣ**ϥ ⲛⲧⲁⲓ ϩⲁⲣⲱⲧⲉⲛ ϧⲉⲛⲟⲩϣⲃⲱⲧ ϣⲁⲛ ϧⲉⲛⲟⲩⲁⲅⲁⲡⲏ ⲙⲡⲛⲉⲩⲙⲁ ⲙⲙⲉⲧⲣⲉⲙⲣⲁⲩϣ .",
      "english": "What do you want? Shall I come to you with a rod, or in love and a spirit of gentleness?",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲡϩⲗⲗⲟ ϫⲉⲉⲛ**ⲟⲩⲉϣ**ⲡⲕⲁⲣⲱϥ ·",
      "english": "The monk said, 'What we desire is silence,",
      "source": "Apophthegmata Patrum Sahidic 133: N 303",
      "urn": "urn:cts:copticLit:ap.133.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯ**ⲟⲩⲉϣ**ⲑⲏⲛⲟⲩ ⲇⲉ ⲉⲣⲉⲧⲉⲛⲟⲓ ⲛⲁⲧⲣⲱⲟⲩϣ .",
      "english": "but I desire that you should all now be without disquiet’;",
      "source": "Life of Isaac of Alexandria - part 1",
