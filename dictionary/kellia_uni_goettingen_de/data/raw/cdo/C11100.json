  "examples": [
    {
      "coptic": "ⲙⲏ ⲟⲩⲟⲛⲛⲧⲱⲟⲩ ⲧⲏⲣⲟⲩ ⲛϩⲁⲛϩⲙⲟⲧ ⲛⲧⲁⲗϭⲟ ⲙⲏ ⲥⲉⲛⲁⲥⲁϫⲓ ⲧⲏⲣⲟⲩ ϧⲉⲛϩⲁⲛⲗⲁⲥ ⲙⲏ ⲥⲉⲛⲁ**ⲉⲣⲙⲉⲛⲉⲩⲓⲛ** ⲧⲏⲣⲟⲩ .",
      "english": "Do all have gifts of healings? Do all speak with various languages? Do all interpret?",
      "source": "Bohairic 1 Corinthians 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲉⲩⲉϣ**ϩⲉⲣⲙⲏⲛⲉⲩⲉ** ⲙⲙⲟⲥ ϩⲛⲗⲁⲁⲩ ⲙⲙⲁ ·",
      "english": "and in no place whatsoever can any interpret it.",
      "source": "Proclus Homily 23 On the Nativity in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily23.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲧⲉ ⲡⲉⲧⲥⲁϫⲓ ϧⲉⲛⲫⲗⲁⲥ ⲕⲁⲧⲁ ⲃ ⲓⲉ ⲡⲓϩⲟⲩⲟ ⲅ ⲟⲩⲟϩ ⲟⲩⲙⲉⲣⲟⲥ ⲉⲫⲟⲩⲁⲓ ⲟⲩⲟϩ ⲙⲁⲣⲉⲟⲩⲁⲓ **ⲉⲣⲙⲉⲛⲉⲩⲓⲛ** .",
      "english": "If any man speaks in another language, let it be two, or at the most three, and in turn; and let one interpret.",
      "source": "Bohairic 1 Corinthians 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁϥⲛⲧϥ ⲉϩⲣⲁⲓ ⲉⲡⲙⲁ ϫⲉⲅⲟⲗⲅⲟⲑⲁ ⲡⲁⲓ ⲉϣⲁⲩ**ϩⲉⲣⲙⲏⲛⲉⲩⲉ** ⲙⲙⲟϥ ϫⲉⲡⲧⲟⲡⲟⲥ ⲙⲡⲉⲕⲣⲁⲛⲓⲟⲛ",
      "english": "They brought him to the place called Golgotha, which is, being interpreted, &apos;The place of a skull.&apos;",
      "source": "41_Mark_15",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:15",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯⲟⲩⲉϣ ⲑⲏⲛⲟⲩ ⲇⲉ ⲧⲏⲣⲟⲩ ⲉⲣⲉⲧⲉⲛⲥⲁϫⲓ ϧⲉⲛϩⲁⲛⲗⲁⲥ ⲙⲁⲗⲗⲟⲛ ⲇⲉ ϩⲓⲛⲁ ⲛⲧⲉⲧⲉⲛⲉⲣⲡⲣⲟⲫⲏⲧⲉⲩⲓⲛ ⲛⲁⲁ ⲡⲉⲧⲉⲣⲡⲣⲟⲫⲏⲧⲉⲩⲓⲛ ⲇⲉ ⲉϩⲟⲧⲉ ⲡⲉⲧⲥⲁϫⲓ ϧⲉⲛⲫⲗⲁⲥ ⲥⲁⲃⲟⲗ ⲓⲙⲏⲧⲓ ⲛⲧⲉϥ**ⲉⲣⲙⲉⲛⲉⲩⲓⲛ** ϩⲓⲛⲁ ⲛⲧⲉϯⲉⲕⲕⲗⲏⲥⲓⲁ ϭⲓ ⲛⲟⲩⲕⲱⲧ .",
