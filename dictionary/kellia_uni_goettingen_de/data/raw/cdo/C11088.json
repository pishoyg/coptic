  "examples": [
    {
      "coptic": "ⲡⲉϫⲉ ⲡⲓϧⲉⲗⲗⲟ ⲛⲁϥ ϫⲉⲡⲁϣⲏⲣⲓ ϯⲛⲁϣϯⲉⲛⲧⲟⲗⲏ ⲉⲧⲟⲧⲕ ⲁⲛ ⲉⲑⲃⲉⲡⲉⲕⲓⲱⲧ ϫⲉⲛⲑⲟⲕ ⲟⲩϣⲏⲣⲓ ⲛⲕⲟⲓⲛⲱⲛⲓⲁ ⲁⲗⲗⲁ ⲙⲁϣⲉ ⲛⲁⲕ ⲉⲫⲙⲁ ⲙⲡⲉⲕⲉⲓⲱⲧ ⲫⲏ ⲉⲧⲉϥⲛⲁϫⲟϥ ⲛⲁⲕ ⲁⲣⲓⲧϥ ϯ**ⲉⲣϩⲉⲗⲡⲓⲥ** ⲉⲫⲛⲟⲩϯ ϫⲉⲭⲛⲁⲙⲧⲟⲛ .",
      "english": "The old man said to him, ‘My son, I cannot give you orders for your father's sake, for you are a child of cenobitism; but go to your father, what he tells you, do it; I hope God will give you rest.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲉⲃⲟⲗ ϫⲉⲙⲡⲁⲧⲕⲉⲓⲱⲣϩ ⲙⲡⲙⲧⲟⲛ ⲉⲧⲛ**ϩⲉⲗⲡⲓⲍⲉ** ⲉⲣⲟϥ · ⲟⲩⲇⲉ ⲧⲕⲟⲗⲁⲥⲓⲥ ⲉⲧⲛⲁϣⲱⲡⲉ ·",
      "english": "Because you have not yet looked at the repose that we hope for, nor the punishment that will come.",
      "source": "Apophthegmata Patrum Sahidic 006: anonymous Nau 196",
      "urn": "urn:cts:copticLit:ap.6.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲓⲉⲑⲛⲟⲥ ⲉⲩⲉ**ⲉⲣϩⲉⲗⲡⲓⲥ** ⲉⲡⲉϥⲣⲁⲛ .",
      "english": "In his name, the nations will hope.'",
      "source": "01_Matthew_12",
      "urn": "urn:cts:copticLit:nt.matt.bohairic:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲓⲏⲥⲟⲩⲥ ⲟⲛ ⲣⲱϣⲉ ⲉⲣⲟⲕ ⲛⲧⲟⲕ ⲙⲛⲡⲉⲕⲉⲓⲱⲧ ⲡⲇⲓⲁⲃⲟⲗⲟⲥ ⲉⲧⲟⲩⲏϩ ⲛϩⲏⲧⲕ ⲉⲧⲕ**ϩⲉⲗⲡⲓⲍⲉ** ⲉⲣⲟϥ ·",
      "english": "Jesus still conquers you yourself and your father the devil who dwells inside you, for which you hope.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲣⲉϩ ⲉⲣⲟⲓ ⲡϭⲟⲓⲥ ϫⲉⲁⲓ**ⲉⲣϩⲉⲗⲡⲓⲥ** ⲉⲣⲟⲕ . ⲁⲓϫⲟⲥ ⲙⲡϭⲟⲓⲥ ϫⲉⲛⲑⲟⲕ ⲡⲉ ⲡⲁϭⲟⲓⲥ ϫⲉⲛⲁⲁⲅⲁⲑⲟⲛ ⲕⲉⲣⲭⲣⲓⲁ ⲙⲙⲱⲟⲩ ⲁⲛ .",
      "english": "Keep me, O Lord; for I have hoped in thee.",
      "source": "19_Psalmi_15",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟⲕ ⲡⲉⲧⲥⲕⲩⲡⲁⲍⲉ ⲛⲟⲩⲟⲛ ⲛⲓⲙ ⲉⲧ**ϩⲉⲗⲡⲓⲍⲉ** ⲉⲣⲟⲕ · ϩⲛⲛⲉⲕⲇⲱⲣⲉⲁ ⲙⲛⲛⲉⲕⲙⲛⲧⲛⲁ · ⲉⲕⲥⲟⲟⲩⲛ ⲛⲧⲉⲭⲛⲏ ⲛⲓⲙ ⲙⲛⲉⲡⲏⲣⲉⲓⲁ ⲛⲓⲙ ⲛⲧⲉⲡϫⲁϫⲉ ⲉⲧϯⲟⲩⲃⲏⲛ ⲛⲟⲩⲟⲉⲓϣ ⲛⲓⲙ ·",
      "english": "Thou art He Who sheltereth every one who putteth his hope in Thee, with Thy gift, and with Thy compassion. Thou knowest every wile and every crafty deed of the Enemy who doth wage war against us at all times.'",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    }
  ],
