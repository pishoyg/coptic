  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲏⲓ ⲛϫⲉⲡⲓⲁⲅⲅⲉⲗⲟⲥ ⲉⲧⲥⲁϫⲓ ⲛϧⲣⲏⲓ ⲛϧⲏⲧ ϫⲉⲱϣ ⲉⲃⲟⲗ ⲉⲕϫⲱ ⲙⲙⲟⲥ ϫⲉⲛⲁⲓ ⲛⲉ ⲛⲏⲉⲧⲉϥϫⲱ ⲙⲙⲱⲟⲩ ⲛϫⲉⲡϭⲥ ⲡⲓⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ ϫⲉⲉⲧⲓ ⲉⲩⲉⲫⲱⲛ ⲉⲃⲟⲗ ⲛϫⲉⲛⲓⲃⲁⲕⲓ ϧⲉⲛϩⲁⲛⲁⲅⲁⲑⲟⲛ ⲟⲩⲟϩ ⲉⲧⲓ ⲉϥⲉⲛⲁⲓ ⲛⲥⲓⲱⲛ ⲛϫⲉⲡϭⲥ ⲟⲩⲟϩ ⲉϥⲉ**ⲥⲱⲧⲡ** ⲉⲧⲓ ⲛⲓⲗⲏⲙ .",
      "english": "And the angel that spoke with me said to me, Cry yet, and say, Thus saith the Lord Almighty; Yet shall cities be spread abroad through prosperity; and the Lord shall yet have mercy upon Sion, and shall choose Jerusalem.",
      "source": "38_Zacharias_01",
      "urn": "urn:cts:copticLit:ot.zach.bohairic_ed:01",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲙⲁⲣⲉϥ**ⲥⲱⲧⲡ** ⲛⲁϥ ⲙⲡⲕⲁⲣⲱϥ ⲻ",
      "english": "'Let him choose to be silent.'",
      "source": "Apophthegmata Patrum Sahidic 137: P263",
      "urn": "urn:cts:copticLit:ap.137.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲉⲣⲟⲩⲱ ⲛϫⲉⲓⲏⲥⲟⲩⲥ ⲡⲉϫⲁϥ ϫⲉⲙⲏ ⲁⲛⲟⲕ ⲁⲛ ⲁⲓ**ⲥⲉⲧⲡ** ⲑⲏⲛⲟⲩ ϧⲁⲡⲓⲓⲃ ⲟⲩⲟϩ ⲟⲩⲁⲓ ⲉⲃⲟⲗ ϧⲉⲛⲑⲏⲛⲟⲩ ⲉⲟⲩⲇⲓⲁⲃⲟⲗⲟⲥ ⲡⲉ .",
      "english": "Jesus answered them, 'Didn't I choose you, the twelve, and one of you is a devil?'",
      "source": "04_John_06",
      "urn": "urn:cts:copticLit:nt.john.bohairic:06",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲥⲱⲧⲡ** ⲛⲁⲕ ⲟⲛ ⲛⲧⲙⲛⲧⲣⲙⲣⲁϣ ⲙⲙⲱⲩⲥⲏⲥ .",
      "english": "But also choose for yourself the gentleness of Moses,",
      "source": "Apophthegmata Patrum Sahidic 123: Syncletica 11",
      "urn": "urn:cts:copticLit:ap.123.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ϧⲉⲛⲡⲓⲙⲁ ⲉⲧⲉⲡϭⲟⲓⲥ ⲡⲉⲕⲛⲟⲩϯ ⲛⲁ**ⲥⲟⲧⲡ**ϥ ⲉⲙⲟⲩϯ ⲉⲡⲉϥⲣⲁⲛ ⲙⲙⲁⲩ ⲉⲕⲉϣⲱⲧ ⲙⲡⲓⲡⲁⲥⲭⲁ ⲙⲙⲁⲩ ⲙⲫⲛⲁⲩ ⲛⲣⲟⲩϩⲓ ⲉⲣⲉⲫⲣⲏ ⲛⲁϩⲱⲧⲡ ⲕⲁⲧⲁⲡⲓⲥⲏⲟⲩ ⲉⲧⲁⲕⲓ ⲉⲃⲟⲗ ϧⲉⲛⲡⲕⲁϩⲓ ⲛⲭⲏⲙⲓ",
      "english": "But in the place which the Lord thy God shall choose, to have his name called there, thou shalt sacrifice the passover at even at the setting of the sun, at the time when thou camest out of Egypt.",
      "source": "05_Deuteronomium_16",
      "urn": "urn:cts:copticLit:ot.deut.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϣ ⲡⲉ ⲡⲉⲥⲙⲟⲧ ⲛⲛⲉⲡⲣⲟⲫⲏⲧⲏⲥ ⲙⲛⲛⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲉⲓⲙⲏⲧⲓ ⲉⲧⲣⲉⲩ**ⲥⲟⲧⲡ**ⲥ ⲛⲁⲩ . ⲉϣⲡϩⲓⲥⲉ ⲙⲛϩⲉⲛⲕⲟⲟⲩⲉ ϣⲁϩⲣⲁⲓ ⲉⲡⲙⲟⲩ ·",
      "english": "What is the pattern of the prophets and apostles except to choose to suffer with others even unto death?",
      "source": "Abraham Our Father: ZH fragments 1a-d",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbzh:18-22",
      "dialect": "sahidic"
    }
