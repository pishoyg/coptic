  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲓⲙⲏϣ ⲧⲏⲣⲟⲩ ⲉⲧⲁⲩⲓ ⲉϫⲉⲛⲧⲁⲓ**ⲑⲉⲱⲣⲓⲁ** ⲉⲧⲁⲩⲛⲁⲩ ⲉⲛⲏ ⲉⲧⲁⲩϣⲱⲡⲓ ⲁⲩⲧⲁⲥⲑⲟ ⲉⲩⲕⲱⲗϩ ϧⲉⲛⲧⲟⲩⲙⲉⲥⲧⲉⲛϩⲏⲧ .",
      "english": "All the multitudes that came together to see this, when they saw the things that were done, returned home beating their breasts.",
      "source": "03_Luke_23",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:23",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲧⲣⲉⲛⲡⲗⲏⲥⲥⲉ ⲛⲧⲟϥ ⲉϫⲛⲧⲉϥ**ⲑⲉⲱⲣⲓⲁ** ·",
      "english": "but in order that we might not be struck dumb at the sight of Him.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲥⲱⲟⲩϩ ⲇⲉ ⲛϭⲓⲡⲙⲏⲏϣⲉ ⲉⲛⲁⲩ ⲉⲡⲁⲅⲱⲛ · ⲙⲛⲧⲉ**ⲑⲉⲱⲣⲓⲁ** ⲛⲛⲉⲧⲟⲩⲁⲁⲃ ·",
      "english": "And the multitude gathered together to see the strife, and the spectacle of the saints",
      "source": "History of Eustathius and Theopiste part 2",
      "urn": "urn:cts:copticLit:lives.eustathius.budge:31-56",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲉⲥⲧⲟⲓⲭⲓⲟⲛ ⲣϩⲟⲧⲉ · ⲁⲩⲱ ⲁⲧⲉⲕⲧⲏⲥⲓⲥ ⲧⲏⲣⲥ ϣⲧⲟⲣⲧⲣ ⲛⲧⲉⲣⲟⲩⲛⲁⲩ ⲉⲡⲉⲓⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲛⲃⲣⲣⲉ ⲙⲛⲧⲉⲓ**ⲑⲉⲱⲣⲓⲁ** ⲛϩⲟⲧⲉ ·",
      "english": "The elements were terror-stricken, and all created things were shaken when they saw this new mystery, and this awful sight.",
      "source": "On the Soul and Body",
      "urn": "urn:cts:copticLit:psathanasius.soul_body.budge:1-91",
