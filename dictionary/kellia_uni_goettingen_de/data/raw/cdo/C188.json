  "examples": [
    {
      "coptic": "ⲁϥⲟⲩⲱⲣⲡ ⲇⲉ ⲛϫⲉⲙⲡⲓⲙⲁⲥ ⲙⲃⲁⲉⲙⲡⲓ ϧⲉⲛⲧϫⲓϫ ⲙⲡⲉϥⲙⲁⲛⲉⲥⲱⲟⲩ ⲡⲓⲟⲇⲟⲗⲁⲙⲓⲧⲏⲥ ϩⲓⲛⲁ ⲛⲧⲉϥϭⲓ ⲙⲡⲓ**ⲁⲣⲏⲃ** ⲉⲃⲟⲗ ⲛⲧⲟⲧⲥ ⲛϯⲥϩⲓⲙⲓ ⲟⲩⲟϩ ⲙⲡⲉϥϫⲉⲙⲥ",
      "english": "And Judas sent the kid of the goats by the hand of his shepherd the Odollamite, to receive the pledge from the woman; and he found her not.",
      "source": "01_Genesis_38",
      "urn": "urn:cts:copticLit:ot.gen.bohairic_ed:38",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲛⲧⲏⲧⲛ ⲙⲙⲁⲩ ⲙⲡ**ⲁⲣⲏⲃ** ⲛⲧⲉϥⲙⲛⲧⲣⲣⲟ ·",
      "english": "There is for you the pledge of His kingdom",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ ⲇⲉ ⲉⲧⲁϥⲉⲣϩⲱⲃ ⲉⲣⲟⲛ ⲉⲫⲁⲓ ⲫⲛⲟⲩϯ ⲡⲉ ⲫⲏ ⲉⲧⲁϥϯ ⲛⲁⲛ ⲙⲡⲁⲓ**ⲁⲣⲏⲃ** ⲛⲧⲉⲡⲓⲡⲛⲉⲩⲙⲁ .",
      "english": "Now he who made us for this very thing is God, who also gave to us the down payment of the Spirit.",
      "source": "08_II Corinthians_05",
      "urn": "urn:cts:copticLit:nt.2cor.bohairic:05",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϣⲗⲏⲗ ⲙⲛⲧⲡⲓⲥⲧⲓⲥ ⲛⲁⲃⲟⲏⲑⲉⲓ ⲉⲣⲟⲕ · ⲧⲉⲅⲣⲁⲫⲏ ⲉⲧⲟⲩⲁⲁⲃ ϯⲥⲃⲱ ⲛⲁⲕ · ⲟⲩⲛⲧⲁⲕ ⲙⲙⲁⲩ ϫⲓⲛⲙⲡⲉⲓⲙⲁ ⲙⲡ**ⲁⲣⲏⲃ** ⲛⲙⲙⲁⲛ ⲙⲧⲟⲛ ⲉⲧϩⲛⲙⲡⲏⲩⲉ ·",
      "english": "Prayer and faith shall help thee, and the Holy Scriptures shall give thee instruction, and thou shalt have from this world, according to (His) pledge to us, the rest which is in the heavens.",
      "source": "On Penitence and Abstinence, part 2",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:120-241",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥⲟⲩⲱⲙ ⲛϫⲉⲓⲁⲕⲱⲃ ⲟⲩⲟϩ ⲁϥⲥⲓ ⲁϥϧⲑⲁⲓ ⲟⲩⲟϩ ⲁϥϩⲓⲧ**ⲣⲏⲃ** ⲉⲃⲟⲗ ⲛϫⲉⲡⲓⲙⲉⲛⲣⲓⲧ ⲁϥⲕⲉⲛⲓ ⲟⲩⲟϩ ⲁϥϧⲑⲁⲓ ⲟⲩⲟϩ ⲁϥⲟⲩⲱϣⲥ ⲉⲃⲟⲗ ⲟⲩⲟϩ ⲁϥⲭⲁ ⲫⲛⲟⲩϯ ⲛⲥⲱϥ ⲫⲏ ⲉⲧⲁϥⲑⲁⲙⲓⲟϥ ⲁϥϣⲉⲛⲁϥ ⲉⲃⲟⲗ ϩⲁⲫⲛⲟⲩϯ ⲡⲉϥⲥⲱⲧⲏⲣ",
