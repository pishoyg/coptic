  "examples": [
    {
      "coptic": "ⲉϯ ⲙⲫⲁⲓ ⲙⲡⲁⲓⲣⲏϯ ⲉⲧⲟⲧϥ ⲙⲡⲥⲁⲧⲁⲛⲁⲥ ⲉⲡ**ⲧⲁⲕⲟ** ⲛⲧⲉϯⲥⲁⲣⲝ ϩⲓⲛⲁ ⲛⲧⲉⲡⲓⲡⲛⲉⲩⲙⲁ ⲛⲟϩⲉⲙ ϧⲉⲛⲡⲉϩⲟⲟⲩ ⲙⲡⲉⲛϭⲟⲓⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲭⲣⲓⲥⲧⲟⲥ .",
      "english": "are to deliver such a one to Satan for the destruction of the flesh, that the spirit may be saved in the day of the Lord Jesus.",
      "source": "Bohairic 1 Corinthians 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲡⲁⲅⲅⲉⲗⲟⲥ ⲛⲁϥ ϫⲉⲕⲥⲟⲟⲩⲛ ϩⲱⲱⲕ ⲱ ⲇⲏⲙⲏⲧⲣⲓⲟⲥ ⲙⲡⲉⲧⲥⲏϩ ϫⲉⲡⲁⲧⲥⲱⲧⲙ ⲛⲁϣⲱⲡⲉ ϩⲙⲡ**ⲧⲁⲕⲟ** ·",
      "english": "The Angel said unto him, 'Thou knowest, O Demetrius, what is written, namely, ‘The disobedient shall end in destruction.’",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁⲩⲥⲱⲧⲉⲙ ⲇⲉ ⲛϫⲉⲛⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲛⲉⲙⲛⲓⲙⲏϣ ⲁⲩⲉⲣⲁⲛⲁⲑⲉⲙⲁⲧⲓⲍⲉⲓⲛ ⲙⲙⲟϥ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲡⲉⲕϩⲁⲧ ⲛⲉⲙⲁⲕ ⲉⲩⲉϣⲱⲡⲓ ⲉⲡ**ⲧⲁⲕⲟ** ϫⲉⲉⲭⲟⲩⲱϣ ⲉϫⲫⲟ ⲛⲁⲕ ⲛϯⲇⲱⲣⲉⲁ ⲛⲧⲉⲫⲛⲟⲩϯ ϩⲓⲧⲉⲛϩⲁⲛⲭⲣⲏⲙⲁ .",
      "english": "And when the bishops and the crowds heard these words, they anathematized him, saying, “Let your money be with you in perdition, for you want to acquire the gift of God with riches.”",
      "source": "Life of Isaac of Alexandria - part 2",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:20-41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϯⲛⲁϭⲱϣⲧ ⲉϫⲙⲡⲁⲡⲗⲁⲥⲙⲁ ⲧⲏⲣϥ ⲛⲧⲁⲛⲁⲩ ϫⲉϥⲛⲁⲃⲱⲕ ⲉⲡⲧⲁⲕⲟ · ϯⲛⲁⲱϣ ⲉϩⲣⲁⲓ ⲉⲡⲁⲉⲓⲱⲧ · ϫⲉⲡⲁⲉⲓⲱⲧ ⲟⲩ ⲡⲉ ϩⲏⲩ ⲙⲡⲁⲥⲛⲟϥ ⲉϥⲛⲁⲃⲱⲕ ⲉⲡ**ⲧⲁⲕⲟ** ⁛—",
      "english": "I shall look upon all My clay, and when I see that he is going to destruction I shall try out to My Father, saying, 'My Father, what profit is there My Blood if he goeth to destruction?'",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟⲛ ⲅⲁⲣ ⲛⲓⲃⲉⲛ ⲉⲧϫⲱ ⲙⲙⲟⲥ ϫⲉⲧⲉⲛⲉⲣⲭⲣⲓⲁ ⲁⲛ ⲛⲣⲉϥϯⲥⲃⲱ ⲟⲩⲟϩ ⲉⲣⲉⲡⲟⲩϩⲏⲧ ⲑⲏⲧ ⲁⲛ ⲛⲉⲙⲛⲏ ⲉⲧϯⲥⲃⲱ ⲛⲱⲟⲩ ⲛⲁⲓ ⲉⲧⲉⲙⲙⲁⲩ ⲉⲩϣⲱⲛⲓ ϧⲉⲛⲡⲓϣⲱⲛⲓ ⲛϯⲙⲉⲧⲁⲧⲉⲙⲓ ⲉⲧⲉⲧⲙⲁⲩ ⲧⲉ ⲛϯⲙⲉⲧϭⲁⲥⲓϩⲏⲧ ⲑⲏ ⲉⲧⲁⲩⲙⲉⲛⲣⲓⲧⲥ ⲛϫⲉⲛⲏ ⲉⲧⲁⲩⲥⲉⲃⲧⲱⲧⲟⲩ ⲉⲡ**ⲧⲁⲕⲟ** ⲓⲥϫⲉⲛ ϣⲟⲣⲡ ⲉⲧⲉⲛⲓⲇⲁⲓⲙⲱⲛ ⲛⲉ ⲛⲏ ⲉⲧⲁⲩⲃⲉⲣⲃⲱⲣⲟⲩ ⲉⲡⲉⲥⲏⲧ ⲉⲃⲟⲗ ϧⲉⲛⲧⲫⲉ ⲛⲁⲓ ⲉⲧⲁⲩⲥⲱⲕ ⲛⲱⲟⲩ ⲛⲟⲩⲙⲉⲧϭⲁⲥⲓϩⲏⲧ ⲙⲡⲟⲩⲟⲩⲱϣ ⲉϭⲛⲉϫⲱⲟⲩ ⲛⲛⲓϫⲟⲙ ⲛⲥⲁⲡϣⲱⲓ ⲁⲗⲗⲁ ⲁⲩⲫⲱⲧ ⲛⲧⲟⲧⲟⲩ ⲛⲛⲓⲣⲉϥϯⲥⲃⲱ ⲉⲧϧⲉⲛⲛⲓⲫⲏⲟⲩⲓ .",
      "english": "All those who say, “We do not need to be taught,” or who do not submit in their hearts to those who teach, suffer from the disease of ignorance, which is the mother of pride. This pride was loved by those who, from the beginning, were prepared for destruction, those who were cast down from heaven, having been led astray by the pride of their own hearts, they did not subject themselves to those superior in virtue, but fled from their heavenly teachers.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲕ ⲟⲩⲛ ⲙⲁⲣⲛϭⲉⲡⲏ ⲉⲃⲱⲕ ⲉϩⲟⲩⲛ ϩⲓⲧⲛⲧⲡⲩⲗⲏ ⲉⲧϭⲏⲩ · ⲁⲩⲱ ⲙⲡⲣⲧⲣⲉⲛⲙⲟⲟϣⲉ ϩⲛⲧⲉⲧⲟⲩⲟϣⲥ · ⲉⲛⲥⲟⲟⲩⲛ ⲇⲉ ⲉⲣⲉⲛⲉϩⲃⲏⲩⲉ ⲧⲏⲣⲟⲩ ⲙⲡⲉⲕⲟⲥⲙⲟⲥ ⲉⲩⲧⲛⲧⲱⲛ ⲉϩⲉⲛⲣⲁⲥⲟⲩ ⲁⲩⲱ ⲥⲉϭⲏⲡ ⲧⲏⲣⲟⲩ ⲉⲡ**ⲧⲁⲕⲟ** ·",
      "english": "Ought we not, therefore, to make haste to enter in through the narrow gate, and not to walk about in the broad way? Now we know that all the works of the world are like unto dreams, and that they all pass away into destruction.",
      "source": "On Penitence and Abstinence, part 2",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:120-241",
      "dialect": "sahidic"
    }
