  "examples": [
    {
      "coptic": "ⲁϥⲓ ⲟⲛ ⲉⲧⲕⲁⲛⲁ ⲛⲧⲉϯⲅⲁⲗⲓⲗⲉⲁ ⲡⲓⲙⲁ ⲉⲧⲁϥⲑⲣⲉ ⲡⲓⲙⲱⲟⲩ ⲉⲣⲏⲣⲡ ⲙⲙⲟϥ ⲛⲉⲟⲩⲟⲛ ⲟⲩ**ⲃⲁⲥⲓⲗⲓⲕⲟⲥ** ⲡⲉ ⲉⲟⲩⲟⲛ ⲛⲧⲁϥ ⲛⲟⲩϣⲏ ⲣⲓ ⲙⲙⲁⲩ ⲉϥϣⲱⲛⲓ ϧⲉⲛⲕⲁⲫⲁⲣⲛⲁⲟⲩⲙ .",
      "english": "Jesus came therefore again to Cana of Galilee, where he made the water into wine. There was a certain nobleman whose son was sick at Capernaum.",
      "source": "04_John_04",
      "urn": "urn:cts:copticLit:nt.john.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲛⲁⲣⲭⲱⲛ ⲛⲛⲥⲁⲧⲣⲁⲡⲏⲥ ⲙⲛⲛⲧⲩⲣⲁⲛⲛⲟⲥ ⲁⲩⲱ ⲛ**ⲃⲁⲥⲓⲗⲓⲕⲟⲥ** ⲛⲅⲣⲁⲙⲙⲁⲧⲉⲩⲥ ⲛⲛⲉⲩⲧⲙⲁⲓⲟ ⲅⲁⲣ ⲛⲓⲟⲩⲇⲁⲓⲟⲥ ⲧϩⲟⲧⲉ ⲅⲁⲣ ⲙⲙⲁⲣⲇⲟⲩⲭⲁⲓⲟⲥ ⲛⲛⲉⲥϩⲓϫⲱⲟⲩ",
      "english": "For the chiefs of the satraps, and the princes and the royal scribes, honoured the Jews; for the fear of Mardochaeus lay upon them.",
      "source": "Esther 9",
      "urn": "urn:cts:copticLit:ot.esth.coptot:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉ ⲡⲓ**ⲃⲁⲥⲓⲗⲓⲕⲟⲥ** ⲛⲁϥ ϫⲉⲡⲁϭⲟⲓⲥ ⲁⲙⲟⲩ ⲉϧⲣⲏⲓ ⲙⲡⲁⲧϥⲙⲟⲩ ⲛϫⲉⲡⲁⲁⲗⲟⲩ .",
      "english": "The nobleman said to him, 'Sir, come down before my child dies.'",
      "source": "04_John_04",
      "urn": "urn:cts:copticLit:nt.john.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲛⲁϥ ⲛϭⲓⲡ**ⲃⲁⲥⲓⲗⲓⲕⲟⲥ** . ϫⲉⲡϫⲟⲉⲓⲥ ⲁⲙⲟⲩ ⲉⲡⲉⲥⲏⲧ ⲉⲙⲡⲁⲧⲉ ⲡⲁϣⲏⲣⲉ ⲙⲟⲩ .",
      "english": "The nobleman said to him, 'Sir, come down before my child dies.'",
      "source": "43_John_4",
      "urn": "urn:cts:copticLit:nt.john.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲁⲓ ⲇⲉ ⲁⲡⲁⲣⲭⲏⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲡⲁⲣⲁⲕⲁⲗⲉⲓ ⲙⲙⲟϥ ⲁϥⲧⲛⲛⲟⲟⲩϥ ⲙⲛⲡⲉⲃⲉⲗⲉⲧⲁⲣⲓⲟⲥ ϣⲁⲡⲣⲣⲟ ⲁϥⲥϩⲁⲓ ⲛⲁϥ ⲛⲟⲩⲉⲡⲓⲥⲧⲟⲗⲏ ⲙⲡⲉⲥⲧⲩⲡⲟⲥ . ϫⲉⲑⲉⲟⲇⲱⲥⲓⲟⲥ ⲡⲁⲣⲭⲏⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲛⲣⲁⲕⲟⲧⲉ ⲡⲉⲧⲧⲟⲗⲙⲁ ⲉϥⲥϩⲁⲓ ⲉⲣⲁⲧϥ ⲙⲡⲁⲩⲅⲟⲩⲥⲧⲟⲥ ⲛⲣⲣⲟ ⲛⲣⲉϥϫⲣⲟ ⲁⲩⲱ ⲡⲁⲡⲁⲙⲁϩⲧⲉ ⲉⲧⲧⲁⲉⲓⲏⲩ **ⲃⲁⲥⲓⲗⲓⲕⲟⲥ** ⲭⲁⲓⲣⲉⲧⲉ .",
