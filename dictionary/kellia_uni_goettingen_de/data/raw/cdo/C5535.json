  "examples": [
    {
      "coptic": "ⲕⲁⲓ ⲅⲁⲣ ⲉϣϫⲉ ⲁⲓϫⲓ ⲡⲉϫⲁϥ ⲉⲡⲁϩⲁⲙⲏⲣ ⲛⲧⲉϥⲥⲁⲣⲝ ϩⲙⲡⲟⲩⲟⲙϥ · ⲁⲗⲗⲁ ⲙⲡⲉⲓⲉϣ**ⲱⲣⲃ** ⲉϩⲟⲩⲛ ⲙⲡⲁⲙⲁϩⲧⲉ ⲛⲧⲉϥⲙⲛⲧⲛⲟⲩⲧⲉ ·",
      "english": "It saith also, 'Now though I took His flesh into my bosom when He was in the manger, I could not include within my dominion His Divinity.'",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲕⲛⲁⲉⲩⲫⲣⲁⲛⲉ ⲛⲁϣ ⲛϩⲉ · ⲉⲕ**ⲟⲣⲃ** ⲉϩⲟⲩⲛ ⲉⲡⲕⲁⲕⲉ ⲙⲛⲡⲉⲥϯⲃⲱⲱⲛ · ⲛⲅⲥⲟⲟⲩⲛ ⲁⲛ ⲙⲡⲉϩⲟⲟⲩ ⲟⲩⲇⲉ ⲧⲉⲩϣⲏ ·",
      "english": "If so, what kind of enjoyment hadst tbou? Thou wast shut up in the darkness and in the humour of her body, and thou didst not know when it was day, or when it was night.",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϥⲛⲟⲩϫⲉ ⲉⲡⲣⲱⲙⲉ ⲛⲟⲩⲟⲉⲓϣ ⲛⲓⲙ ⲛⲛⲉϥⲁⲛⲟⲙⲓⲁ · ϣⲁⲛⲧϥⲟⲣϫϥ ϩⲁⲧⲟⲟⲧϥ ⲙⲡⲙⲟⲩ · ⲁⲩⲱ ⲁϥ**ⲟⲣⲃⲉ**ϥ ⲉϩⲟⲩⲛ ⲉⲡⲉϣⲧⲉⲕⲟ · ⲛⲁⲙⲛⲧⲉ ·",
      "english": "And he hurleth his wickedness against man at all times, until at length he bringeth him under the power of death, and he shutteth him up in the prison of Amente.",
      "source": "On the Soul and Body",
      "urn": "urn:cts:copticLit:psathanasius.soul_body.budge:1-91",
      "dialect": "sahidic"
    }
  ],
