  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲛⲓⲥⲛⲏⲟⲩ ⲭⲣⲉⲙⲣⲉⲙ ⲉⲑⲃⲉϫⲉⲁⲩ**ϧⲓⲥⲓ** ⲙⲡⲟⲩϣϫⲉⲙϫⲟⲙ ⲛⲕⲟⲗϥ ⲉⲃⲟⲗ .",
      "english": "Worn out and unable to keep pace with the abundance, they began to voice their frustration.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϥⲉⲓⲱⲧ ⲇⲉ ⲁϥ**ϩⲓⲥⲉ** ⲛⲙⲙⲁϥ · ϫⲉⲉⲓⲛⲁϫⲓ ⲛⲁⲕ ⲛⲧϣⲉⲉⲣⲉ ⲛⲃⲁⲥⲓⲗⲉⲓⲧⲏⲥ ⲡⲉⲥⲧⲣⲁⲧⲏⲗⲁⲧⲏⲥ ·",
      "english": "And his father wearied him exceedingly, saying, 'I shall take the daughter of Basileides the general for thee to wife,'",
      "source": "Martyrdom of Victor part 1",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:1-6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲥϭⲓ ⲛⲟⲩⲙⲏϣ ⲛ**ϧⲓⲥⲓ** ⲛⲧⲟⲧⲟⲩ ⲛⲛⲓⲙⲏϣ ⲛⲥⲏⲓⲛⲓ ⲟⲩⲟϩ ⲁⲥϭⲉ ⲛⲉⲧⲉⲛⲧⲁⲥ ⲛⲓⲃⲉⲛ ⲉⲃⲟⲗ ⲟⲩⲟϩ ⲙⲡⲉⲥϫⲉⲙϩⲏⲟⲩ ⲛϩⲗⲓ ⲁⲗⲗⲁ ⲙⲁⲗⲗⲟⲛ ⲁⲥⲧϩⲟ ⲛϩⲟⲩⲟ .",
      "english": "and had suffered many things by many physicians, and had spent all that she had, and was no better, but rather grew worse,",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲉⲡⲉⲕⲛⲁ ⲧⲁϩⲟⲓ ⲛⲅⲭⲁⲣⲓⲍⲉ ⲛⲁⲓ ⲙⲡⲧⲁⲗϭⲟ · ϫⲉⲁⲓ**ϩⲓⲥⲉ** ⲉⲙⲁⲧⲉ ·",
      "english": "Let thy mercy come upon me, and do thou graciously grant healing unto me, for I am suffering very greatly.'",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲉⲛ**ϧⲟⲥⲓ** ⲉⲛⲉⲣϩⲱⲃ ⲛⲛⲉⲛϫⲓϫ ⲙⲙⲓⲛⲙⲙⲟⲛ ⲥⲉϩⲱⲟⲩϣ ⲉⲣⲟⲛ ⲟⲩⲟϩ ⲧⲉⲛⲥⲙⲟⲩ ⲉⲣⲱⲟⲩ ⲉⲩϭⲟϫⲓ ⲛⲥⲱⲛ ⲧⲉⲛⲱⲟⲩ ⲛϩⲏⲧ .",
      "english": "We toil, working with our own hands. When people curse us, we bless. Being persecuted, we endure.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲛ**ϩⲟⲥⲉ** ⲉⲛⲣϩⲱⲃ ϩⲛⲛⲉⲛϭⲓϫ ⲙⲙⲓⲛⲙⲙⲟ ⲛ ⲉⲩⲥⲁϩⲟⲩ ⲙⲙⲟⲛ ⲧⲛⲥⲙⲟⲩ ⲉⲣⲟⲟⲩ ⲉⲩⲡⲏⲧ ⲛⲥⲱⲛ ⲧⲛⲁⲛⲉⲭⲉ ⲙⲙⲟⲟⲩ .",
