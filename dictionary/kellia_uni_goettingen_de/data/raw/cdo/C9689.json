  "examples": [
    {
      "coptic": "ⲁⲛⲁⲩ ⲉⲡⲓ**ⲙⲁⲕⲁⲣⲓⲟⲥ** ⲓⲱⲥⲏⲫ ϫⲉⲁϥⲥⲉⲏⲣⲡ ϧⲉⲛⲟⲩⲥⲟϭⲛⲓ ϧⲉⲛⲡⲓⲕⲁϩⲓ ⲛⲭⲏⲙⲓ ⲁⲗⲗⲁ ⲙⲡⲉϥϣⲓⲃϯ ⲛϫⲉⲡⲉϥⲕⲁϯ ⲟⲩⲇⲉ ⲙⲡⲉⲧⲉϥⲥⲃⲱ ⲧⲁⲕⲟ",
      "english": "Look at the blessed Joseph: he drank wine with good judgment in the land of Egypt, but his mind was not changed, nor was his discipline corrupted.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲉⲓ ⲧⲏⲣⲟⲩ ⲉⲩⲱϣ ⲉⲛⲁⲩ ⲉⲡ**ⲙⲁⲕⲁⲣⲓⲟⲥ** ⲓⲱϩⲁⲛⲛⲏⲥ ·",
      "english": "all came wishing to see the blessed John.",
      "source": "The Life of John the Kalybites part 2",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:46-90",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯⲛⲁⲉⲣϩⲏⲧⲥ ⲛⲥⲁϫⲓ ⲉⲑⲃⲉⲛⲓϫⲟⲙ ⲛⲉⲙⲛⲓϣⲫⲏⲣⲓ ⲉⲧⲁϥⲁⲓⲧⲟⲩ ⲛϫⲉⲫⲛⲟⲩϯ ⲉⲃⲟⲗ ϩⲓⲧⲟⲧϥ ⲙⲡⲉⲛ**ⲙⲁⲕⲁⲣⲓⲟⲥ** ⲛⲓⲱⲧ ⲉⲑⲟⲩⲁⲃ ⲁⲡⲁ ϣⲉⲛⲟⲩϯ ⲛⲁⲓ ⲉⲧⲁⲓⲛⲁⲩ ⲉⲣⲱⲟⲩ ϧⲉⲛⲛⲁⲃⲁⲗ ⲁⲛⲟⲕ ⲃⲏⲥⲁ ⲡⲉϥⲙⲁⲑⲏⲧⲏⲥ ⲛⲉⲙⲛⲓⲕⲉⲭⲱⲟⲩⲛⲓ ⲟⲛ ⲉⲧⲁⲡⲉⲛⲓⲱⲧ ⲉⲑⲟⲩⲁⲃ ⲁⲡⲁ ϣⲉⲛⲟⲩϯ ϫⲟⲧⲟⲩ ⲉⲣⲟⲓ ϧⲉⲛⲡⲉϥⲣⲱϥ ⲉⲧⲉⲙⲙⲟⲛ ϩⲗⲓ ⲙⲙⲉⲑⲛⲟⲩϫ ⲛϧⲏⲧϥ",
      "english": "I shall begin to tell about the miracles and wonders which God performed through our blessed father Apa Shenoute, the ones which I saw with my own eys, I, Besa, his disciple, and also the other things that our holy father Apa Shenoute said to me with his mouth, in which there is no guile.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲥⲱϩⲙ · ⲉϫⲙⲡⲥⲱⲙⲁ ⲙⲡ**ⲙⲁⲕⲁⲣⲓⲟⲥ** ·",
      "english": "and He was dragging the body of the blessed man",
      "source": "Life of Cyrus in Budge ed. part 2",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:10-17",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁϥⲓ ⲇⲉ ⲉϣⲓⲏⲧ ⲁϥϫⲱⲓⲗⲓ ⲙⲫⲙⲟⲛⲁⲥⲧⲏⲣⲓⲟⲛ ⲙⲫⲁ ⲡⲓⲉⲣⲫⲙⲉⲩⲓ ⲉⲑⲛⲁⲛⲉϥ ⲁⲃⲃⲁ ⲍⲁⲭⲁⲣⲓⲁⲥ ⲡⲓⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ ⲟⲩⲟϩ ⲛϩⲏⲅⲟⲩⲙⲉⲛⲟⲥ ⲛⲧⲉϯⲗⲁⲩⲣⲁ ⲉⲑⲟⲩⲁⲃ ⲛⲧⲉⲁⲃⲃⲁ **ⲙⲁⲕⲁⲣⲓⲟⲥ** ⲫⲁⲓ ⲉⲧⲁϥⲉⲣⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲉϯⲡⲟⲗⲓⲥ ⲥⲁⲓ ⲉⲟⲩⲣⲱⲙⲓ ⲡⲉ ⲉϥⲟⲩⲁⲃ ⲫⲁⲓ ⲉⲑⲛⲁⲩ ⲉϩⲁⲛϭⲱⲣⲡ ⲉⲃⲟⲗ .",
      "english": "When he arrived at Skete, he dwelt as a guest in the monastery of Abba Zacharias of good memory, the priest and hegumen of the holy Laura of Abba Macarius and bishop of the city of Sais, who was a holy man with visions.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲃⲱⲕ ⲛϭⲓⲁⲡⲁ **ⲙⲁⲕⲁⲣⲓⲟⲥ** ⲡⲛⲟϭ ϣⲁ ⲁⲡⲁ ⲁⲛⲧⲱⲛⲓⲟⲥ",
      "english": "Abba Macarius the Great went to Abba Antony.",
