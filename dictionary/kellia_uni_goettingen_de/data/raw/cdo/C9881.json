  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥⲉⲣⲟⲩⲱ ⲛϫⲉⲓⲏⲥⲟⲩⲥ ⲡⲉϫⲁϥ ⲛⲛⲓ**ⲛⲟⲙⲓⲕⲟⲥ** ⲛⲉⲛⲛⲓⲫⲁⲣⲓⲥⲉⲟⲥ ⲉϥϫⲱ ⲙⲙⲟⲥ ⲥϣⲉ ⲛⲉⲣⲡⲉⲑⲛⲁⲛⲉϥ ϧⲉⲛⲡⲥⲁⲃⲃⲁⲧⲟⲛ ϣⲁⲛ ⲙⲙⲟⲛ .",
      "english": "Jesus, answering, spoke to the lawyers and Pharisees, saying, 'Is it lawful to heal on the Sabbath?'",
      "source": "03_Luke_14",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓⲥⲟⲩ**ⲛⲟⲙⲓⲕⲟⲥ** ⲇⲉ ⲁϥⲧⲱⲟⲩⲛ ⲉϥⲡⲉⲓⲣⲁⲍⲉ ⲙⲙⲟϥ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲡⲥⲁϩ ⲉⲓⲛⲁⲣⲟⲩ ⲧⲁⲕⲗⲏⲣⲟⲛⲟⲙⲉⲓ ⲙⲡⲱⲛϩ ϣⲁⲉⲛⲉϩ .",
      "english": "Behold, a certain lawyer stood up and tested him, saying, 'Teacher, what shall I do to inherit eternal life?'",
      "source": "42_Luke_10",
      "urn": "urn:cts:copticLit:nt.luke.sahidica:10",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲓⲫⲁⲣⲓⲥⲁⲓⲟⲥ ⲇⲉ ⲛⲉⲙⲛⲓ**ⲛⲟⲙⲓⲕⲟⲥ** ⲁⲩⲉⲣⲁⲑⲉⲧⲓⲛ ⲙⲡⲓⲥⲟϭⲛⲓ ⲛⲧⲉⲫⲛⲟⲩϯ ⲛϧⲣⲏⲓ ⲛϧⲏⲧⲟⲩ ⲙⲡⲟⲩϭⲓⲱⲙⲥ ⲛⲧⲟⲧϥ .",
      "english": "But the Pharisees and the lawyers rejected the counsel of God, not being baptized by him themselves.",
      "source": "03_Luke_07",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:07",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲡⲉϫⲁϥ ⲛⲁⲩ ϫⲉ . ⲛⲧⲱⲧⲛ ϩⲱⲧⲧⲏⲩⲧⲛ ⲛ**ⲛⲟⲙⲓⲕⲟⲥ** ⲟⲩⲟⲓ ⲛⲏⲧⲛ ϫⲉⲧⲉⲧⲛⲧⲁⲗⲟ ⲛϩⲉⲛⲉⲧⲡⲱ ⲉⲩϩⲟⲣϣ ⲉϫⲛⲛⲣⲱⲙⲉ ⲉⲛⲧⲉⲧⲛϫⲱϩ ⲁⲛ ⲉⲛⲉⲧⲡⲱ ⲟⲩⲁ ⲛⲛⲉⲧⲛⲧⲏⲏⲃⲉ .",
      "english": "He said, 'Woe to you lawyers also! For you load men with burdens that are difficult to carry, and you yourselves won't even lift one finger to help carry those burdens.",
      "source": "42_Luke_11",
      "urn": "urn:cts:copticLit:nt.luke.sahidica:11",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲉⲣⲟⲩⲱ ⲇⲉ ⲛϫⲉⲟⲩⲁⲓ ⲛⲛⲓ**ⲛⲟⲙⲓⲕⲟⲥ** ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲡⲓⲣⲉϥϯⲥⲃⲱ ⲛⲁⲓ ⲉⲕϫⲱ ⲙⲙⲱⲟⲩ ⲕϣⲱϣ ⲙⲙⲟⲛ ϩⲱⲛ .",
      "english": "One of the lawyers answered him, 'Teacher, in saying this you insult us also.'",
      "source": "03_Luke_11",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲍⲏⲛⲁ ⲡ**ⲛⲟⲙⲓⲕⲟⲥ** ⲙⲛⲁⲡⲟⲗⲗⲱ ⲧⲛⲛⲟⲟⲩⲥⲟⲩ ϩⲛⲟⲩϭⲉⲡⲏ ϫⲉⲛⲛⲉⲩϣⲱⲱⲧ ⲛⲗⲁⲁⲩ .",
      "english": "Send Zenas, the lawyer, and Apollos on their journey speedily, that nothing may be lacking for them.",
      "source": "56_Titus_3",
      "urn": "urn:cts:copticLit:nt.titus.sahidica:3",
      "dialect": "sahidic"
    }
  ],
