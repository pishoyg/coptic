  "examples": [
    {
      "coptic": "ⲕⲁⲓ ⲅⲁⲣ ⲛⲏ ⲉⲧⲁⲩⲥϧⲉⲕⲉϫⲱⲙ ⲛⲧⲉⲛⲉⲛⲓⲟϯ ⲉⲧϧⲉⲛⲛⲓⲅⲣⲁⲫⲏ ⲉⲑⲟⲩⲁⲃ ⲓⲥϫⲉⲛ ⲁⲇⲁⲙ ϣⲁⲁⲃⲣⲁⲁⲙ ⲛⲉⲙⲛⲏ ⲉⲧⲁⲩⲓ ⲙⲉⲛⲉⲛⲥⲱⲟⲩ ϣⲁⲉϧⲟⲩⲛ ⲉⲫⲟⲟⲩ ⲉⲧⲁⲩⲥϧⲁⲓ ⲁⲛ ϫⲉϩⲓⲛⲁ ⲛⲧⲟⲩϯⲱⲟⲩ ⲛⲛⲏ ⲉⲧⲁⲩ**ⲥϧⲁⲓ** ⲁⲗⲗⲁ ϫⲉⲛⲧⲟⲩϫⲉⲙϩⲏⲟⲩ ⲛϫⲉⲛⲏ ⲉⲑⲛⲁⲱϣ ⲙⲙⲱⲟⲩ ⲁⲩϣⲁⲛⲭⲟϩ ⲉⲡⲟⲩϫⲓⲛⲱⲛϧ",
      "english": "For those who wrote books about our Fathers, from Adam to Abraham, and about those who followed up to the present day as found in the Scriptures, did not write to bring glory to those about whom they wrote but to provide benefit to those who would read, so that they might emulate their lives.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲭⲣⲓⲥⲧⲟⲫⲟⲣⲟⲥ ϯ**ⲥϩⲁⲓ** ϩⲁⲣⲟϥ ϫⲛϥⲛⲟⲉⲓ ⲁⲛ ⲁⲩⲱ ϯⲟ ⲙⲙⲛⲧⲣⲉ",
      "english": "I Christophoros, I write instead of him since he does not know (how to write) and I am witness.",
      "source": "Honey Delivery",
      "urn": "urn:cts:copticDoc:papyri_info.tm82149.cpr_4_16",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ ⲙⲡⲓⲉⲣⲭⲣⲁⲥⲑⲉ ⲛⲟⲩⲟⲛ ⲛⲛⲁⲓ ⲛⲉⲧⲁⲓ**ⲥϧⲉ** ⲛⲁⲓ ⲇⲉ ⲁⲛ ϩⲓⲛⲁ ⲛⲥⲉϣⲱⲡⲓ ⲙⲡⲁⲓⲣⲏϯ ⲛϧⲣⲏⲓ ⲛϧⲏⲧ ⲛⲁⲛⲉⲥ ⲅⲁⲣ ⲛⲏⲓ ⲙⲁⲗⲗⲟⲛ ⲉⲙⲟⲩ ⲓⲉ ⲡⲁϣⲟⲩϣⲟⲩ ⲛⲧⲉϣⲧⲉⲙϩⲗⲓ ϣⲟⲩⲱϥ ⲉⲃⲟⲗ .",
      "english": "But I have used none of these things, and I don't write these things that it may be done so in my case; for I would rather die, than that anyone should make my boasting void.",
      "source": "Bohairic 1 Corinthians 9 (Digital Editions)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲛⲉⲉⲓϯϣⲓⲡⲉ ⲛⲏⲧⲛ ⲁⲛ ⲉⲓ**ⲥϩⲁⲓ** ⲛⲏⲧⲛ ⲛⲛⲁⲓ . ⲁⲗⲗⲁ ⲉⲓϯⲥⲃⲱ ⲛⲏⲧⲛ ϩⲱⲥ ϣⲏⲣⲉ ⲙⲙⲉⲣⲓⲧ .",
      "english": "I don&apos;t write these things to shame you, but to admonish you as my beloved children.",
      "source": "46_1 Corinthians_4",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁϥⲉⲣϣⲫⲏⲣⲓ ⲇⲉ ⲛϫⲉⲡⲓⲁⲣⲭⲱⲛ ⲉϫⲉⲛⲧⲉϥϫⲓⲛⲉⲣⲟⲩⲱ ⲟⲩⲟϩ ϩⲱⲥ ϫⲉⲉϥⲉⲣⲇⲟⲕⲓⲙⲁⲍⲓⲛ ⲙⲙⲟϥ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲙⲁϣⲉ ⲛⲁⲕ ⲉϧⲟⲩⲛ ⲉⲟⲩⲁⲓ ⲙⲙⲁ ⲛⲕⲟⲓⲧⲱⲛ **ⲥϧⲏⲧ**ⲥ ⲁⲛⲓⲧⲥ ⲛⲧⲁⲛⲁⲩ ⲉⲣⲟⲥ .",
      "english": "The prefect, surprised at his reply, said to him, as if to put him to the test: ‘Go to one of the rooms, write it down, bring it to me, so that I may see it.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲕⲟⲟⲩⲉ ⲇⲉ ⲧⲏⲣⲟⲩ ⲉⲧⲉϣϣⲉ ⲉⲥⲁϩⲟⲩ ⲉϩⲣⲁⲓ ⲉⲧⲉⲓⲉⲡⲓⲥⲧⲟⲗⲏ · ⲁⲩⲱ ⲙⲡⲛⲥⲁϩⲟⲩ · ⲉⲓⲥϩⲏⲏⲛⲉ ⲥⲉ**ⲥⲏϩ** ⲧⲏⲣⲟⲩ ϩⲛⲛⲉⲭⲁⲣⲧⲏⲥ ⲉⲧⲥⲏϩ ϫⲓⲛⲛϣⲟⲣⲡ ·",
      "english": "All the things that it is fitting to write in this letter and which we have not written, they are all written on the papers written from the beginning.",
      "source": "Acephalous 22: YA 421-28",
      "urn": "urn:cts:copticLit:shenoute.a22.monbya:1251-1258",
      "dialect": "sahidic"
    }
