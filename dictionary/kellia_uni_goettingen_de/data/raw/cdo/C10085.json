  "examples": [
    {
      "coptic": "ⲡⲗⲏⲛ ⲁⲛⲉϥⲓⲟϯ ϭⲓⲧϥ ⲛϫⲟⲛⲥ **ⲡⲁⲣⲁ**ⲡⲉϥⲟⲩⲱϣ ⲁⲩⲱⲡ ⲛⲥⲁϯⲥϩⲓⲙⲓ ⲛⲁϥ ⲟⲩⲟϩ ⲁⲩⲟϩⲓ ϣⲁⲡⲓⲥⲏⲟⲩ ⲙⲡⲓϩⲟⲡ .",
      "english": "However, against his wishes, his parents took him and betrothed him to a young woman: they waited until the day of marriage came.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥϫⲟⲟⲥ ⲛϭⲓⲟⲩϩⲗⲗⲟ · ϫⲉⲡⲉⲧⲟⲩⲧⲁⲓⲟ ⲙⲙⲟϥ **ⲡⲁⲣⲁ**ⲡⲉϥⲙⲡϣⲁ · ⲏ ⲉϥϣⲟⲩϣⲟⲩ ⲙⲙⲟϥ ⲉϫⲱϥ ϣⲁϥϯⲟⲥⲉ ⲧⲱⲛⲟⲩ",
      "english": "A monk said, 'The one who is honored beyond his worth, or who boasts about himself will lose greatly.",
      "source": "Apophthegmata Patrum Sahidic 130: N 300",
      "urn": "urn:cts:copticLit:ap.130.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ **ⲡⲁⲣⲁ**ⲡⲁⲙⲡϣⲁ ⲁⲓⲥⲱⲧⲉⲙ ⲉⲣⲟϥ ⲉϥⲥⲁϫⲓ ⲛⲉⲙⲡⲁⲓⲱⲧ ⲛⲟⲩⲥⲟⲡ ⲟⲩⲟϩ ⲁⲓϣⲱⲡⲓ ⲉⲓϣⲉⲡϩⲙⲟⲧ ⲛⲧⲟⲧϥ ⲛⲛⲓⲉϩⲟⲟⲩ ⲧⲏⲣⲟⲩ ⲛⲧⲉⲡⲁⲱⲛϧ .",
      "english": "And on that occasion—though I did not merit it—I heard him conversing with my father, and from that moment, I have given thanks for it all the days of my life.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣⲱⲡⲉ ⲕⲟ ⲛⲁϩⲣⲁⲕ ⲙⲁⲩⲁⲁⲕ ⲛⲟⲩϩⲙϩⲁⲗ ⲛⲁⲧϣⲁⲩ ⲁⲩⲱ ⲛⲣⲉϥⲣⲛⲟⲃⲉ ⲙ**ⲡⲁⲣⲁ**ⲟⲩⲟⲛ ⲛⲓⲙ",
      "english": "whether you have become a worthless slave in your own eyes and a sinner beyond everyone else.",
      "source": "Apophthegmata Patrum Sahidic 128: N 299",
      "urn": "urn:cts:copticLit:ap.128.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲁⲧⲟⲧϥ ⲁϥⲱϣ ⲉⲃⲟⲗ ⲛϫⲉⲡⲓⲁⲣⲭⲓⲇⲓⲁⲕⲱⲛ ⲉϫⲉⲛⲡⲓⲙⲁ ⲛⲉⲣϣⲱⲟⲩϣⲓ ϩⲱⲥ ϫⲉⲁⲩⲕⲓⲙ ⲉⲣⲟϥ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲫⲛⲟⲩϯ ϫⲉⲛⲛⲉⲥϣⲱⲡⲓ ⲙⲡⲁⲓⲣⲏϯ ⲉⲑⲣⲉⲛⲓⲣⲓ ⲛⲟⲩϩⲱⲃ **ⲡⲁⲣⲁ**ⲛⲓⲕⲁⲛⲱⲛ ⲁⲗⲗⲁ ⲙⲁⲣⲉⲛⲟϩⲓ ϣⲁϯⲕⲩⲣⲓⲁⲕⲏ .",
      "english": "Immediately the archdeacon at the altar cried out, as if he had been moved by God, and said: “God forbid that we should thus work against the canons; but let us wait until Sunday.”",
      "source": "Life of Isaac of Alexandria - part 2",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:20-41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲉⲧⲛϣⲓⲧⲉ ⲙⲙⲟⲟⲩ ⲛϩⲉⲛϩⲟⲙⲛⲧ **ⲡⲁⲣⲁ**ⲧⲉⲩⲁⲥⲟⲩ ϣⲁⲛⲧⲉⲧⲛⲥⲉⲩϩ ⲧⲉⲧⲓⲙⲏ ⲙⲡⲙⲁⲥⲉ ⲉϩⲟⲩⲛ ⲉⲥⲕⲏⲃ ϩⲁϩⲉⲛⲉⲗⲁⲭⲓⲥⲧⲟⲛ ⲛⲁϥ , ⲉϩⲉⲛⲕⲉⲉⲥⲛⲉ ϩⲓϩⲛⲁⲩ ⲛⲁⲧϣⲁⲩ .",
      "english": "And you extort them for copper beyond its value until you collect the price of the calf doubled for ones least of flesh, while they are bones on something useless.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    }
  ],
