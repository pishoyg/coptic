  "examples": [
    {
      "coptic": "ⲧⲁ**ⲁⲅⲁⲡⲏ** ⲛⲉⲙⲱⲧⲉⲛ ⲧⲏⲣⲟⲩ ϧⲉⲛⲡⲭⲣⲓⲥⲧⲟⲥ ⲓⲏⲥⲟⲩⲥ ⲁⲙⲏⲛ",
      "english": "My love to all of you in Christ Jesus. Amen.",
      "source": "Bohairic 1 Corinthians 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲅϫⲡⲟ ⲛⲁⲕ ⲛⲧ**ⲁⲅⲁⲡⲏ** ⲁϫⲛϩⲩⲡⲟⲕⲣⲓⲛⲉ ·",
