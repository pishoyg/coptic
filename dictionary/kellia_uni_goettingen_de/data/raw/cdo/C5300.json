  "examples": [
    {
      "coptic": "**ⲟⲩⲁϩⲓϩⲏⲧ** ⲇⲉ ⲡⲉ ⲛⲁⲧⲛⲁ ϩⲙⲡⲉϥϩⲏⲧ ·",
      "english": "and he was cruel and merciless in his heart.",
      "source": "Homily on Matthew 20",
      "urn": "urn:cts:copticLit:psathanasius.matthew20.budge:1-56",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ϩⲁⲣⲉϩ ⲉⲣⲟⲉⲣⲟ ⲛ**ⲟⲩⲁϩⲓϩⲏⲧ** ⲉϩⲟⲩⲛ ⲉⲛⲟⲩϩⲙϩⲁⲗ · ⲁⲩⲱ ϩⲁⲣⲉϩ ⲉⲣⲟ ⲉⲧⲙⲙⲟⲟϣⲉ ⲛⲕⲉⲥⲟⲡ ϩⲙⲡⲉⲓⲙⲁⲕϩ ⲉⲧϫⲟⲟⲥⲉ · ⲛⲧⲉⲥⲟⲟⲩⲧⲛ ⲛⲧⲉϭⲓϫ ⲉⲛϩⲏⲕⲉ ·",
      "english": "But take good heed that thou dost not display arrogance towards thy slave-woman, and take good heed that thou dost not in future walk haughtily and stiffneckedly, and take good heed to stretch out thy hand to the poor.",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲏⲫⲉ ϭⲉ ⲙⲙⲟⲕ ⲛⲅⲥⲟⲩⲛⲛⲉⲕⲉⲣⲏⲧ · ⲛⲅⲡⲱⲧ ⲉⲃⲟⲗ ⲙⲡⲉⲓ**ⲟⲩⲁϩⲓϩⲏⲧ** ⲛⲅⲡⲟⲣϫⲕ ⲉⲣⲟϥ · ϫⲉⲛⲛⲉϥⲡⲱⲣⲕ ⲛⲛⲃⲁⲗ ⲙⲡⲉⲕⲛⲟⲩⲥ ⲛϥⲁⲁⲕ ⲛⲃⲗⲗⲉ ⲛⲅⲧⲙⲥⲟⲩⲛⲧⲉϩⲓⲏ ⲛⲧⲡⲟⲗⲓⲥ ⲡⲉⲕⲙⲁ ⲛϣⲱⲡⲉ ·",
      "english": "Be sober therefore, and know what things are promised (to thee). Flee thou from arrogance, separate thou thyself from it, lest it put out the eyes of thine understanding, and it make thee blind, and thou art unable to find the way to the city which is thy habitation.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    }
