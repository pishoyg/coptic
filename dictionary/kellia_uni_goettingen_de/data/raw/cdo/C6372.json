      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲁⲧ**ϩⲏ** ⲛⲉⲛⲉϩ ⲁϥⲥⲟⲛⲧⲧ ϫⲓⲛⲛϣⲟⲣⲡ ⲁⲩⲱ ⲛϯⲛⲁⲱϫⲛ ⲁⲛ ⲛϣⲁⲉⲛⲉϩ",
      "english": "He created me from the beginning before the world, and I shall never fail.",
