  "examples": [
    {
      "coptic": "ⲥⲁⲇⲏ . ϧⲉⲛⲟⲩϫⲱⲣϫ ⲁⲩϫⲟⲣϫⲧ ⲛϫⲉⲛⲁ**ϫⲁϫⲓ** ⲙⲫⲣⲏϯ ⲛⲟⲩϭⲁϫ ⲡϫⲓⲛϫⲏ .",
      "english": "until the Lord look down, and behold from heaven.",
      "source": "25_Lamentationes_03",
      "urn": "urn:cts:copticLit:ot.lam.bohairic_ed:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉϥⲉϣⲱⲡⲉ ⲛⲁⲛ ⲛⲟⲩ**ϫⲁϫⲉ** ⲉⲧⲃⲉⲡⲛⲟⲩⲧⲉⲉⲡⲉⲛⲥⲟⲛ ⲡⲉ",
      "english": "But let him be an enemy for us because of God, though he is our brother.",
      "source": "Acephalous 22: YA 421-28",
      "urn": "urn:cts:copticLit:shenoute.a22.monbya:1251-1258",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁⲩⲉⲙⲓ ⲇⲉ ⲉⲛⲁⲓ ⲛϫⲉⲛⲉⲛ**ϫⲁϫⲓ** ⲙⲡⲉⲛⲛⲁϩϯ ⲁⲩⲉⲣⲇⲓⲁⲃⲁⲗⲗⲉⲓⲛ ϧⲁⲡⲓⲁⲣⲭⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ϧⲁⲧⲉⲛⲡⲟⲩⲣⲟ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲧⲉⲛⲧⲁⲙⲟ ⲙⲙⲟⲕ ⲱ ⲡⲟⲩⲣⲟ ϫⲉⲁⲡⲟⲩⲣⲟ ⲛϯⲙⲁⲕⲟⲩⲣⲓⲁ ⲟⲩⲱⲣⲡ ⲛϩⲁⲛⲣⲉⲙ ⲛⲧⲁϥ ⲛⲉⲙϩⲁⲛⲥϧⲁⲓ ⲛⲁⲃⲃⲁ ⲓⲥⲁⲁⲕ ⲡⲓⲁⲣⲭⲓⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲉⲑⲣⲉϥⲟⲑⲱϣ ⲛⲱⲟⲩ ⲛⲟⲩⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲛⲧⲟⲩⲟⲗϥ ⲉⲧⲟⲩⲭⲱⲣⲁ .",
      "english": "When the enemies of our faith learned this, they slandered the archbishop near the king, saying: “We warn you, O king, that the king of Makouria has sent servants with letters to Abba Isaac the archbishop, so that he may establish a bishop over them and send him to their country.",
      "source": "Life of Isaac of Alexandria - part 3",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:42-48",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲁⲙⲉⲣⲓⲧ ϩⲙⲡϫⲟⲉⲓⲥ ϣⲟⲣⲡ ⲙⲉⲛ ϩⲛϩⲱⲃ ⲛⲓⲙ ⲕⲁⲡⲑⲃⲃⲓⲟ ϩⲛⲧⲉⲕⲧⲁⲡⲣⲟ · ⲉⲕⲥⲃⲧⲱⲧ ϩⲛⲧⲉⲕϭⲓⲛⲟⲩⲱϣⲃ ϫⲉⲕⲱ ⲛⲁⲓ ⲉⲃⲟⲗ ⲉⲕⲥⲟⲟⲩⲛ · ϫⲉϩⲓⲧⲛⲡⲉⲑⲃⲃⲓⲟ · ϣⲁⲣⲉⲧϭⲟⲙ ⲧⲏⲣⲥ ⲙⲡ**ϫⲁϫⲉ** ⲱϫⲛ ·",
      "english": "My beloved in the Lord, before every other thing set humility in thy mouth when thou art ready to make answer, for, forgive me, thou knowest that by humility all the power of the Enemy is brought to naught.",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯⲛⲁϭⲁⲥⲕ ⲡϭⲟⲓⲥ: ϫⲉⲁⲕϣⲟⲡⲧ ⲉⲣⲟⲕ: ⲟⲩⲟϩ ⲙⲡⲉⲕⲑⲣⲉ ⲛⲁ**ϫⲁϫⲓ** ⲟⲩⲛⲟϥ ⲙⲙⲱⲟⲩ ⲉϩⲣⲏⲓ ⲉϫⲱⲓ .",
      "english": "I will exalt thee, O Lord; for thou hast lifted me up, and not caused mine enemies to rejoice over me.",
      "source": "19_Psalmi_29",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:29",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲉⲧϭⲏⲛ ϩⲓⲧⲟⲟⲧⲁⲩⲃⲱⲕ ϩⲛϩⲉⲛϩⲓⲟⲟⲩⲉ ⲉⲩⲛⲁϣⲧ ⲁⲩⲉⲓ ⲛⲧϩⲉ ⲛⲛⲓⲟϩⲉ ⲉⲛⲧⲁⲩϥⲓ ⲉⲃⲟⲗ ϩⲛⲛⲉⲩ**ϫⲓϫⲉⲉⲩⲉ**",
