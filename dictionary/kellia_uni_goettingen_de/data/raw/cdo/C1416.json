  "examples": [
    {
      "coptic": "ⲉⲡⲓⲇⲏ ⲛⲓⲓⲟⲩⲇⲁⲓ ⲥⲉⲉⲣⲉⲧⲓⲛ ⲛϩⲁⲛⲙⲏⲓⲛⲓ ⲟⲩⲟϩ ⲛⲓⲟⲩⲉⲓⲛⲓⲛ ⲥⲉ**ⲕⲱϯ** ⲛⲥⲁϯⲥⲟⲫⲓⲁ .",
      "english": "For Jews ask for signs, Greeks seek after wisdom,",
      "source": "Bohairic 1 Corinthians 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓⲟⲩⲱϣ ⲅⲁⲣ ⲉ**ⲕⲱⲧⲉ** ⲛⲥⲁⲟⲩϣⲏⲙ ⲛⲧⲃⲧ ⲛⲁⲩ ·",
      "english": "and I ought to seek for some small fish for them.'",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥϥⲓⲁϩⲟⲙ ϧⲉⲛⲡⲉϥⲡⲛⲉⲩⲙⲁ ⲡⲉϫⲁϥ ϫⲉⲁϧⲟ ⲡⲁⲓϫⲱⲟⲩ ϥ**ⲕⲱϯ** ⲛⲥⲁⲟⲩⲙⲏⲓⲛⲓ ⲁⲙⲏⲛ ϯϫⲱ ⲙⲙⲟⲥ ⲛⲱⲧⲉⲛ ϫⲉⲁⲛ ⲥⲉⲛⲁϯ ⲛⲟⲩⲙⲏⲓⲛⲓ ⲙⲡⲁⲓϫⲱⲟⲩ .",
      "english": "He sighed deeply in his spirit, and said, 'Why does this generation seek a sign? Most certainly I tell you, no sign will be given to this generation.'",
      "source": "Bohairic Gospel of Mark 8 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:8",
