  "examples": [
    {
      "coptic": "ⲇⲁⲩⲉⲓⲇ ⲙⲉⲛ ⲅⲁⲣ ⲛⲧⲁϥⲡⲁⲧⲁⲥⲥⲉ ⲙⲡ**ⲙⲟⲩⲓ** ⲙⲛⲧⲁⲣⲝ ⲛⲟⲩⲥⲟⲡ ⲏ ⲥⲛⲁⲩ ⲁⲩⲱ ϣⲁϣⲟⲙⲛⲧ ⲛⲥⲟⲡ ·",
      "english": "Now David destroyed the lion and the bear, once, or twice, and even three times,",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲣϣⲁⲛⲧⲃⲁϣⲟⲣ ⲁϣϣⲕⲁⲕ ⲉⲃⲟⲗ ⲁⲛ ⲉⲧⲉⲛⲧⲟⲕ ⲡⲉ ⲡϩⲙϩⲁⲗ ⲙⲡⲙⲁⲙⲙⲱⲛⲁⲥ ϩⲛϩⲉⲛϩⲣⲟⲟⲩ ⲉⲩⲟϣ , ⲉⲣⲉⲡ**ⲙⲟⲩⲓ**ⲧⲣⲣⲉ ⲉⲧⲉⲁⲛⲟⲕ ⲡⲉ ⲡϩⲙϩⲁⲗ ⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ,",
      "english": "It’s not when the fox cries out, which is you, oh servant of Mammon, in voices that shout, that the lion, which is I, the servant of Christ, is afraid.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
