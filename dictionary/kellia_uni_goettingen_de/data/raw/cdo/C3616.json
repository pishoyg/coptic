  "examples": [
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲣⲉϩⲁⲛⲥⲁⲛⲇⲁⲗⲓⲟⲛ ⲧⲟⲓ ⲉⲣⲁⲧ ⲉⲛⲑⲏⲛⲟⲩ ⲟⲩⲟϩ ⲙⲡⲉⲣϯϣⲑⲏⲛ **ⲥⲛⲟⲩϯ** ϩⲓⲑⲏⲛⲟⲩ",
      "english": "but to wear sandals, and not put on two tunics.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲉⲓⲥϩⲏⲏⲧⲉ ⲁⲕⲥⲱⲧⲙ ⲉⲧⲃⲉⲥⲟⲛ **ⲥⲛⲁⲩ** .",
      "english": "'Behold, you heard concerning two brothers",
      "source": "Apophthegmata Patrum Sahidic 052",
      "urn": "urn:cts:copticLit:ap.52.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁⲥⲓ ⲇⲉ ⲛϫⲉⲟⲩⲭⲏⲣⲁ ⲛϩⲏⲕⲓ ⲁⲥϩⲓⲟⲩⲓ ⲛⲧⲉⲃⲓ **ⲥⲛⲟⲩϯ** ⲉⲧⲉⲟⲩⲕⲟⲛⲇⲣⲁⲛⲧⲏⲥ ⲡⲉ",
      "english": "A poor widow came, and she cast in two small brass coins,",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲡⲁⲓ ⲁⲡⲥⲱⲙⲁ **ⲥⲛⲁⲩ** ϣⲱⲡⲉ ⲉⲃⲟⲗ ϩⲛⲟⲩⲥⲱⲙⲁ ⲛⲟⲩⲱⲧ ·",
      "english": "For this reason two bodies came from one body,",
      "source": "Mysteries of John the Evangelist part 2",
      "urn": "urn:cts:copticLit:misc.mysteries_john.budge:13-28",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉϣⲱⲡ ⲛⲧⲉⲧⲉⲕϭⲁⲗⲟϫ ⲉⲣⲥⲕⲁⲛⲇⲁⲗⲓⲍⲉⲥⲑⲉ ⲙⲙⲟⲕ ϫⲟϫⲥ ϩⲓⲧⲥ ⲉⲃⲟⲗ ⲛⲁⲛⲉⲥ ⲛⲁⲕ ⲛⲧⲉⲕⲓ ⲉϧⲟⲩⲛ ⲉⲡⲓⲱⲛϧ ⲉⲕⲟⲓ ⲛϭⲁⲗⲉ ⲉϩⲟⲧⲉ ⲉⲣⲉⲟⲩⲟⲛ ϭⲁⲗⲟϫ **ⲥⲛⲟⲩϯ** ⲉⲣⲟⲕ ⲛⲥⲉϩⲓⲧⲕ ⲉϯⲅⲉⲉⲛⲛⲁ",
      "english": "If your foot causes you to stumble, cut it off. It is better for you to enter into life lame, rather than having your two feet to be cast into Gehenna, into the fire that will never be quenched--",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲇⲁⲓⲙⲟⲛⲓⲟⲛ ϥⲟϭϥ ⲉϩⲟⲩⲛ ⲉⲧⲉⲥⲉⲕⲓⲃⲉ **ⲥⲛⲧⲉ** ·",
      "english": "that a certain demon leaped into her two breasts,",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    }
