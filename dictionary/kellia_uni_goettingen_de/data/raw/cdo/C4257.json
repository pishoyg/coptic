  "examples": [
    {
      "coptic": "ⲛⲉⲧϫⲟ ⲉⲩⲣⲓⲙⲉ ⲥⲉⲛⲁⲱϩⲥ ϩⲛⲟⲩ**ⲧⲉⲗⲏⲗ** ⲛⲉⲩⲙⲟⲟϣⲉ ⲡⲉ ⲉⲩⲃⲏⲕ ⲉⲩⲣⲓⲙⲉ ⲉⲩϥⲓ ⲛⲛⲉⲩⲉⲃⲣⲏⲩⲉ",
      "english": "They that sow in tears shall reap in joy.",
      "source": "Psalms 125",
      "urn": "urn:cts:copticLit:ot.pss.coptot:125",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲁⲣⲛϫⲟⲟⲩ ⲛⲥⲁⲛⲉⲥⲛⲏⲩ ⲉⲧϩⲙⲡⲧⲟⲟⲩ · ⲧⲏⲣⲟⲩ · ⲛⲧⲛⲉⲓⲣⲉ ⲛⲙⲙⲁⲩ ⲛⲟⲩⲁⲅⲁⲡⲏ ϩⲛⲟⲩⲣⲁϣⲉ ⲙⲛⲟⲩ**ⲧⲉⲗⲏⲗ** · ϫⲉⲛⲧⲟϥ ⲡⲉⲛⲧⲁⲡϫⲟⲉⲓⲥ ϫⲟⲟϥ · ⲛⲁⲓ ⲉⲧⲃⲏⲏⲧϥ",
      "english": "Let us send for all the brothers in the monastery, and hold a thanksgiving with them in joy and celebration, for it is him about whom the Lord has told me,",
      "source": "Life of Apa Phib part 2",
      "urn": "urn:cts:copticLit:lives.phib.paths_ed:11-18",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲁⲙⲛⲧⲣⲣⲟ · ⲉϥϣⲟⲟⲡ ϩⲛⲟⲩⲛⲟϭ ⲛⲟⲩⲟⲉⲓⲛ ⲉⲙⲛϣⲓ ⲉⲣⲟϥ · ϩⲓⲧⲛⲛⲛⲟⲩⲧⲉ ⲙⲛⲛⲁϩⲟⲣⲁⲧⲟⲥ ⲧⲏⲣⲟⲩ ⲁⲩⲱ ⲛϥϣⲱⲡⲉ ϩⲛⲟⲩⲛⲟϭ ⲛⲣⲁϣⲉ ⲙⲛⲟⲩⲛⲟϭ ⲛ**ⲧⲉⲗⲏⲗ** : ⲧⲉⲛⲟⲩ ϭⲉ ϩⲱⲱϥ ⲥⲱⲧⲙ ⲧⲁϣⲁϫⲉ ⲛⲙⲙⲏⲧⲛ ⲉⲧⲃⲉⲡⲉⲟⲟⲩ ⲛⲛⲉⲧⲛⲁϫⲓϩⲱⲟⲩ ⲙⲡⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲛⲧⲉⲡⲓϣⲟⲣⲡ ⲙⲙⲩⲥⲧⲏⲣⲓⲟⲛ ·",
      "english": "“of my kingdom, being in a great light immeasurable for the gods and all the invisibles, and he will be in great joy and great jubilation. But now, therefore, hearken, that I may discourse with you concerning the grandeur of those who shall receive the mysteries of the First Mystery.”",
