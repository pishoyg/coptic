  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥⲉⲣϩⲏⲧⲥ ⲛϯⲥⲃⲱ ⲛⲱⲟⲩ ϫⲉϩⲱϯ ⲛⲧⲉⲡϣⲏⲣⲓ ⲙⲫⲣⲱⲙⲓ ϭⲓⲟⲩⲙⲏϣ ⲛϧⲓⲥⲓ ⲟⲩⲟϩ ⲛⲧⲟⲩϣⲟϣϥ ⲉⲃⲟⲗ ϩⲓⲧⲟⲧⲟⲩ ⲛⲛⲓ**ⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ** ⲛⲉⲙⲛⲓⲁⲣⲭⲓⲉⲣⲉⲩⲥ ⲛⲉⲙⲛⲓⲥⲁϧ ⲟⲩⲟϩ ⲛⲧⲟⲩϧⲟⲑⲃϥ ⲟⲩⲟϩ ⲙⲉⲛⲉⲛⲥⲁⲅ ⲛⲉϩⲟⲟⲩ ⲛⲧⲉϥⲧⲱⲛϥ .",
      "english": "He began to teach them that the Son of Man must suffer many things, and be rejected by the elders, the chief priests, and the scribes, and be killed, and after three days rise again.",
      "source": "Bohairic Gospel of Mark 8 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:8",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱϣ ⲉⲃⲟⲗ ϩⲱⲟⲩ ⲛϭⲓⲛⲉ**ⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ** ·",
      "english": "and the elders also cried out.",
      "source": "On Susanna",
      "urn": "urn:cts:copticLit:pschrysostom.susanna.budge:1-63",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲥⲁⲧⲟⲧⲟⲩ ⲁⲩⲥⲟϭⲛⲓ ⲛⲟⲩⲥⲟϭⲛⲓ ⲛϣⲱⲣⲡ ⲛϫⲉⲛⲓⲁⲣⲭⲓⲉⲣⲉⲩⲥ ⲛⲉⲙⲛⲓ**ⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ** ⲛⲉⲙⲛⲓⲥⲁϧ ⲛⲉⲙⲡⲓⲙⲁ ⲛϯϩⲁⲡ ⲧⲏⲣϥ ⲁⲩⲥⲱⲛϩ ⲛⲓⲏⲥⲟⲩⲥ ⲁⲩϭⲓⲧϥ ⲁⲩⲧⲏⲓϥ ⲙⲡⲓⲗⲁⲧⲟⲥ .",
      "english": "Immediately in the morning the chief priests, with the elders and scribes, and the whole council, held a consultation, and bound Jesus, and carried him away, and delivered him up to Pilate.",
      "source": "Bohairic Gospel of Mark 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲃⲓⲟⲥ ⲁⲩⲱ ⲧⲡⲟⲗⲓⲧⲉⲓⲁ ⲙⲡⲉⲛⲡⲉⲧⲟⲩⲁⲁⲃ ⲛⲉⲓⲱⲧ ⲉⲧⲧⲁⲓⲏⲩ ⲕⲁⲧⲁⲥⲙⲟⲧ ⲛⲓⲙ ⲡϩⲁⲅⲓⲟⲥ ⲁⲡⲁ ⲕⲩⲣⲟⲥ · ⲡⲧⲉⲗⲓⲟⲥ ⲛⲁⲙⲉ ⲛⲧⲁϥϩⲓⲥⲧⲟⲣⲓⲍⲉ ⲙⲙⲟϥ · ⲛϭⲓⲁⲡⲁ ⲡⲁⲙⲃⲱ ⲡⲉ**ⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ** ⲛⲧⲉⲕⲕⲗⲏⲥⲓⲁ ⲛϣⲓⲏⲧ ⲛⲧⲁϥⲙⲧⲟⲛ ⲙⲙⲟϥ ⲛϭⲓⲡⲉⲧⲟⲩⲁⲁⲃ · ⲁⲡⲁ ⲕⲩⲣⲟⲥ ϩⲛⲥⲟⲩϣⲙⲟⲩⲛ ⲙⲡⲉⲃⲟⲧ ⲉⲡⲏⲡ ϩⲛⲟⲩⲉⲓⲣⲏⲛⲏ ⲛⲧⲉⲡⲛⲟⲩⲧⲉ ·",
      "english": "THE LIFE AND CONVERSATION OF OUR SAINTED FATHER, WHO WAS GLORIOUS IN EVERYTHING, SAINT APA CYRUS, THE PERFECT GOVERNOR, WHICH WAS W'RITTEN BY APA PAMBO, THE ELDER OF THE CHURCH OF SHIET. SAINT APA CYRUS DIED ON THE EIGHTH DAY OF THE MONTH EPEIPH IN THE PEACE OF GOD.",
      "source": "Life of Cyrus in Budge ed. part 1",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲁⲛⲕⲟⲩϫⲓ ⲉⲃⲟⲗ ϧⲉⲛⲛⲓϫⲟⲙ ⲛⲉⲙⲛⲓϣⲫⲏⲣⲓ ⲉⲧⲁⲫⲛⲟⲩϯ ⲁⲓⲧⲟⲩ ⲉⲃⲟⲗ ϩⲓⲧⲟⲧϥ ⲙⲡⲉⲛⲓⲱⲧ ⲉⲑⲟⲩⲁⲃ ⲙⲡⲣⲟⲫⲏⲧⲏⲥ ⲁⲡⲁ ϣⲉⲛⲟⲩϯ ⲡⲓ**ⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ** ⲟⲩⲟϩ ⲡⲓⲁⲣⲭⲓⲙⲁⲛⲇⲣⲓⲧⲏⲥ ⲉⲁϥϩⲩⲥⲧⲟⲣⲓⲛ ⲙⲙⲱⲟⲩ ⲛϫⲉⲫⲏ ⲉⲑⲟⲩⲁⲃ ⲁⲡⲁ ⲃⲏⲥⲁ ⲡⲉϥⲙⲁⲑⲏⲧⲏⲥ ⲉⲩⲱⲟⲩ ⲙⲫⲛⲟⲩϯ",
      "english": "A few of the miracles and wonders which God performed through our holy father, the prophet Shenoute the Presbyter and Archimandrite, which the holy Apa Besa, his disciple, chronicled for the glory of God.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲃⲱⲕ ⲛⲟⲩⲟⲉⲓϣ ⲛϭⲓⲡⲉ**ⲡⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ** ⲛϣⲓⲏⲧ ϣⲁⲡⲁⲣⲭⲏⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲛⲣⲁⲕⲟⲧⲉ .",
      "english": "He went once, that is the presbyter of Scetis, to the archbishop of Alexandria",
      "source": "Apophthegmata Patrum Sahidic 019: Presbyter",
      "urn": "urn:cts:copticLit:ap.19.monbeg",
      "dialect": "sahidic"
    }
  ],
