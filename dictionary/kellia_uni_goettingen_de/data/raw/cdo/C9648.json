  "examples": [
    {
      "coptic": "ⲡⲁⲓⲣⲏϯ ⲁϥϫⲟⲥ ⲛϫⲉⲁⲇⲱⲛⲁⲓ ⲡϭⲥ ⲟⲩⲟϩ ⲉⲥⲉϣⲱⲡⲓ ϧⲉⲛⲡⲓⲉϩⲟⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ ⲉⲧⲣⲉ ϩⲁⲛⲥⲁϫⲓ ϣⲱⲡⲓ ⲉϧⲣⲏⲓ ϧⲉⲛⲡⲉⲕϩⲏⲧ ⲉⲕⲙⲟⲕⲙⲉⲕ ⲉⲟⲩ**ⲗⲟⲅⲓⲥⲙⲟⲥ** ⲉϥϩⲱⲟⲩ .",
      "english": "Thus saith the Lord God; It shall also come to pass in that day, that thoughts shall come up into thine heart, and thou shalt devise evil devices.",
      "source": "26_Ezechiel_38",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:38",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲏ ⲛⲧⲁⲁϣ ⲛ**ⲗⲟⲅⲓⲥⲙⲟⲥ** ⲙⲟⲕⲙⲉⲕ ⲉⲣⲟϥ ⲉⲛⲉϩ ·",
      "english": "Or what understanding hath ever been able to reason it out?",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲟⲩϩⲱⲃ ⲛⲭⲣⲏⲥⲓⲙⲟⲛ ⲁϥⲭⲁⲣⲓⲍⲉ ⲛⲟⲩ**ⲗⲟⲅⲓⲥⲙⲟⲥ** ⲛⲧⲉⲣⲩⲑⲣⲁ ⲧϩⲁⲗⲁⲥⲥⲁ ·",
      "english": "In order to make it a useful thing He bestowed reasoning power on the Red Sea.",
      "source": "Proclus Homily 23 On the Nativity in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily23.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲥⲟⲫⲟⲥ ⲥⲟⲗⲟⲙⲱⲛ ϫⲱ ⲙⲙⲟⲥ ϫⲉⲕⲁⲡⲉⲕⲥⲟⲃⲧⲉ ⲧⲏⲣϥ ϩⲁⲧⲟⲟⲧⲕ · ϫⲉⲙⲛⲥⲟⲟⲩⲛ ⲟⲩⲇⲉ **ⲗⲟⲅⲓⲥⲙⲟⲥ** ϩⲛⲁⲙⲛⲧⲉ · ⲡⲙⲁ ⲉⲧⲉⲕⲛⲁⲃⲱⲕ ⲉⲣⲟϥ · ⲉⲧⲉⲡⲁⲓ ⲡⲉ · ϫⲉⲉⲕϣⲁⲛⲉⲓ ⲉⲃⲟⲗ ϩⲙⲡⲉⲓⲕⲟⲥⲙⲟⲥ · ⲛⲅⲛⲁϣⲇⲓⲟⲣⲑⲟⲩ ⲁⲛ ⲛⲗⲁⲁⲩ · ⲁⲗⲗⲁ ⲛⲉⲛⲧⲁⲕϥⲓⲧⲟⲩ ⲉⲕⲃⲏⲕ · ⲛⲧⲟⲟⲩ ⲛⲉⲧⲟⲩⲛⲁⲕⲣⲓⲛⲉ ⲙⲙⲟⲕ ⲛϩⲏⲧⲟⲩ ϩⲁⲣⲟⲟⲩ ·",
      "english": "The wise man Solomon spake, saying, 'Leave all thy property behind thee, for there is neither knowledge nor understanding in Amente,' the place whereunto thou shalt depart'; that is to say, 'When thou shalt go forth from this world, thou wilt not have the power to order anything rightly, nay, those things which thou wouldst take with thee are the very things on account of which thou shalt be judged.'",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    }
