  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲩⲥⲱⲧⲉⲙ ⲛϫⲉⲛⲉϥⲙⲁⲑⲏⲧⲏⲥ ⲁⲩⲓ ⲁⲩⲱⲗⲓ ⲙⲡⲓⲥⲱⲙⲁ ⲟⲩⲟϩ ⲁⲩⲭⲁϥ ⲛϧⲟⲩⲛ ϧⲉⲛⲟⲩ**ⲙϩⲁⲩ** .",
      "english": "When his disciples heard this, they came and took up his corpse, and laid it in a tomb.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲗⲗⲟⲛ ⲇⲉ ϩⲛⲟⲩ**ⲙϩⲁⲁⲩ** ⲁⲛ ⲁⲗⲗⲁ ϩⲛⲟⲩⲛⲩⲙⲫⲱⲛ ·",
      "english": "it was, however, no sepulchre, but rather a bridal bed.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ ⲉⲛⲁⲣⲉⲡⲉϥⲙⲁ ⲛϣⲱⲡⲓ ϣⲟⲡ ϧⲉⲛⲛⲓ**ⲙϩⲁⲩ** ⲟⲩⲟϩ ⲟⲩⲇⲉ ϧⲉⲛⲛⲓⲕⲉϩⲁⲗⲩⲥⲓⲥ ⲙⲙⲟⲛ ϣϫⲟⲙ ⲛϩⲗⲓ ⲡⲉ ⲉⲥⲟⲛϩϥ",
      "english": "He lived in the tombs. Nobody could bind him any more, not even with chains,",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉϥⲡⲱϩ ⲇⲉ ⲉⲩⲙⲁ ⲛ**ⲙϩⲁⲁⲩ** · ⲉⲡⲁⲟⲩⲁ ⲡⲉ ϩⲛⲛⲉⲥⲛⲏⲩ ⲁϥϫⲟⲟⲥ ⲛⲛⲉϩⲣϣⲓⲣⲉ · ϫⲉϣⲓⲕⲉ ϩⲙⲡⲉⲓⲙⲁ ⲛⲁϣⲏⲣⲉ ·",
      "english": "And when he had arrived at a place in the region wherein were the tombs which were of one of the brethren, he spoke unto the young men, saying, 'My sons, dig a grave in this place",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁⲩϫⲱ ⲙⲙⲟⲥ ⲛⲛⲟⲩⲉⲣⲏⲩ ϫⲉⲛⲓⲙ ⲉⲧⲛⲁⲥⲕⲉⲣⲕⲉⲣ ⲙⲡⲓⲱⲛⲓ ⲛⲁⲛ ⲉⲃⲟⲗ ϩⲓⲣⲱϥ ⲙⲡⲓ**ⲙϩⲁⲩ** .",
      "english": "They were saying among themselves, 'Who will roll away the stone from the door of the tomb for us?'",
      "source": "Bohairic Gospel of Mark 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁϥϣⲉⲡ ⲟⲩⲥⲓⲛⲇⲱⲛ ⲁϥⲙⲡⲥⲱⲙⲁ ⲉⲡⲉⲥⲏⲧⲡⲉⲥⲏⲧ ⲁϥϭⲗⲙⲗⲱⲙϥ ϩⲛⲧⲥⲓⲛⲇⲱⲛ . ⲁϥⲕⲁⲁϥ ϩⲙⲡⲉϥⲙϩⲁⲁⲩ ⲉⲁⲩϣⲉⲧϣⲱⲧϥ ⲉⲃⲟⲗ ϩⲛⲧⲡⲉⲧⲣⲁ ⲁⲩⲱ ⲁⲩⲥⲕⲣⲕⲣⲟⲩⲱⲛⲉ ⲉⲣⲟⲙⲡⲉ**ⲙϩⲁⲁⲩ** .",
