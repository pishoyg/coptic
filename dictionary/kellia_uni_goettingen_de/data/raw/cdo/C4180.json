  "examples": [
    {
      "coptic": "ⲡⲁⲓⲣⲏϯ ⲟⲛ ⲡⲉ ϯⲕⲉⲁⲛⲁⲥⲧⲁⲥⲓⲥ ⲛⲧⲉⲛⲓⲣⲉϥⲙⲱⲟⲩⲧ ⲥⲉⲥⲓϯ ⲙⲙⲟⲥ ϧⲉⲛⲟⲩⲧⲁⲕⲟ ⲥⲛⲁⲧⲱⲛⲥ ϧⲉⲛⲟⲩ**ⲙⲉⲧⲁⲧⲧⲁⲕⲟ** .",
      "english": "So also is the resurrection of the dead. It is sown in corruption; it is raised in incorruption.",
      "source": "Bohairic 1 Corinthians 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟⲕ ⲅⲁⲣ ⲡⲉ ⲡϫⲟⲉⲓⲥ · ⲧⲛⲟⲩⲛⲉ ⲛⲧⲙⲛⲧⲁⲧⲙⲟⲩ · ⲁⲩⲱ ⲧⲡⲏⲅⲏ ⲛⲧ**ⲙⲛⲧⲁⲧⲧⲁⲕⲟ** · ⲁⲩⲱ ⲡⲧⲁϫⲣⲟ ⲛⲛⲁⲓⲱⲛ ·",
      "english": "For Thou art the Lord, the Root of immortality. Thou art the Fountain which cannot be destroyed. Thou art the Strength which endureth throughout the Ages.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡϩⲙⲟⲧ ⲛⲉⲙⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲑⲙⲉⲓ ⲙⲡⲉⲛϭⲟⲓⲥ ⲓⲏⲥⲟⲩⲥ ⲡⲭⲣⲓⲥⲧⲟⲥ ϧⲉⲛⲟⲩ**ⲙⲉⲧⲁⲧⲧⲁⲕⲟ**",
      "english": "Grace be with all those who love our Lord Jesus Christ with incorruptible love. Amen.",
      "source": "10_Ephesians_06",
      "urn": "urn:cts:copticLit:nt.eph.bohairic:06",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲣⲟⲟⲩϣ ⲇⲉ ⲛⲧⲉⲥⲃⲱ ⲡⲉ ⲧⲁⲅⲁⲡⲏ ⲧⲁⲅⲁⲡⲏ ⲇⲉ ⲡⲉ ⲡϩⲁⲣⲉϩ ⲉⲡⲉⲥⲛⲟⲙⲟⲥ ⲛϯϩⲧⲏⲕ ⲇⲉ ⲉⲡⲛⲟⲙⲟⲥ ⲡⲉ ⲡⲧⲁϫⲣⲟ ⲛⲧ**ⲙⲛⲧⲁⲧⲧⲁⲕⲟ**",
      "english": "And incorruption maketh us near unto God:",
      "source": "Wisdom 6",
      "urn": "urn:cts:copticLit:ot.wis.coptot:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲏ ⲙⲉⲛ ⲉⲧⲁⲩⲁⲙⲟⲛⲓ ⲛⲧⲟⲧⲟⲩ ϧⲉⲛⲟⲩϩⲱⲃ ⲉⲛⲁⲛⲉϥ ⲟⲩⲱⲟⲩ ⲛⲉⲙⲟⲩⲧⲁⲓⲟ ⲛⲉⲙⲟⲩ**ⲙⲉⲧⲁⲧⲧⲁⲕⲟ** ⲛⲛⲏ ⲉⲧⲕⲱϯ ⲛⲥⲁⲟⲩⲱⲛϧ ⲛⲉⲛⲉϩ .",
      "english": "to those who by patience in well-doing seek for glory, honor, and incorruptibility, eternal life;",
      "source": "06_Romans_02",
      "urn": "urn:cts:copticLit:nt.rom.bohairic:02",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲁⲓ ⲇⲉ ϯϫⲱ ⲙⲙⲟϥ ⲛⲁⲥⲛⲏⲩ ϫⲉⲛⲛⲉϣⲥⲁⲣⲝ ϩⲓⲥⲛⲟϥ ⲕⲗⲏⲣⲟⲛⲟⲙⲉⲓ ⲛⲧⲙⲛⲧⲣⲣⲟ ⲙⲡⲛⲟⲩⲧⲉ . ⲟⲩⲇⲉ ⲡⲧⲁⲕⲟ ⲛⲁⲕⲗⲏⲣⲟⲛⲟⲙⲉⲓ ⲁⲛ ⲛⲧ**ⲙⲛⲧⲁⲧⲧⲁⲕⲟ** .",
      "english": "Now I say this, brothers, that flesh and blood can&apos;t inherit the Kingdom of God; neither does corruption inherit incorruption.",
      "source": "46_1 Corinthians_15",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:15",
      "dialect": "sahidic"
    }
