  "examples": [
    {
      "coptic": "ⲕⲁⲁⲩ ⲉⲃⲟⲗ ϫⲉⲉⲩⲉⲃⲱⲕ ⲉⲛⲥⲱϣⲉ ⲉⲧϩⲙⲡⲉⲩⲕⲱⲧⲉ ⲙⲛⲛⲉⲧⲙⲉ ⲛⲥⲉ**ⲧⲟⲟⲩ** ⲛⲁⲩ ⲛⲛⲉⲧⲟⲩⲛⲁⲟⲩⲟⲙⲟⲩ .",
      "english": "Send them away, that they may go into the surrounding country and villages, and buy themselves bread, for they have nothing to eat.'",
      "source": "41_Mark_6",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲁϥⲟⲩⲱϣⲃ ⲉϥϫⲱ ⲙⲙⲟⲥ ⲛⲁⲩ ϫⲉϯ ⲛⲁⲩ ⲛⲧⲱⲧⲛ ⲉⲧⲣⲉⲩⲟⲩⲱⲙ . ⲡⲉϫⲁⲩ ⲛⲁϥ ϫⲉⲙⲁⲣⲛⲃⲱⲕ ⲛⲧⲛ**ⲧⲟⲟⲩ** ⲙⲛⲧⲥⲛⲟⲟⲩⲥ ⲛϣⲉ ⲛⲟⲉⲓⲕ ⲛⲧⲛⲧⲁⲁⲩ ⲛⲁⲩ ⲉⲟⲩⲱⲙ . ⲛⲧⲟϥ ⲇⲉ ⲡⲉϫⲁϥ ⲛⲁⲩ",
      "english": "But he answered them, 'You give them something to eat.' They asked him, 'Shall we go and buy two hundred denarii worth of bread, and give them something to eat?'",
      "source": "Mark Chapter 6",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:6",
      "dialect": "sahidic"
    },
    {
