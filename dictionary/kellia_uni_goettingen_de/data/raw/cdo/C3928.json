  "examples": [
    {
      "coptic": "ⲙⲛⲧⲙⲁⲅⲓⲁ ⲛⲛⲁⲣⲭⲱⲛ ⲛⲧϩⲓⲙⲁⲣⲙⲉⲛⲏ ⲙⲛⲛⲁⲧⲉⲥⲫⲁⲓⲣⲁ ⲕⲁⲧⲁⲧϩⲉ ⲉⲛⲧⲁⲩⲧⲥⲁⲃⲟⲟⲩ ⲉⲣⲟⲟⲩ ⲛϭⲓⲛⲁⲅⲅⲉⲗⲟⲥ ⲉⲛⲧⲁⲩⲡⲁⲣⲁⲃⲁ . ⲁⲩⲱ ⲉⲩϣⲁⲛⲉⲡⲓⲕⲁⲗⲉⲓ ⲙⲙⲟⲟⲩ ϩⲛⲛⲉⲩⲙⲩⲥⲧⲏⲣⲓⲟⲛ . ⲉⲧⲉⲛⲉⲩⲙⲁⲅⲓⲁ ⲛⲉ ⲉⲧϩⲟⲟⲩ . ⲉ**ⲥⲱϣⲧ** ⲉⲛⲉϩⲃⲏⲩⲉ ⲉⲧⲛⲁⲛⲟⲩⲟⲩ . ⲥⲉⲛⲁϫⲟⲕⲟⲩ ⲉⲃⲟⲗ ⲙⲡⲉⲓϩⲉ ⲛⲁⲩ . ϫⲛⲙⲙⲟⲛ ·",
      "english": "“of the Fate and of those of the sphere, in the way in which the angels who transgressed have taught them, if they invoke them in their mysteries, that is in their evil magic, to the hindering of good deeds,--will they accomplish them henceforth from now on or not?”",
      "source": "Pistis Sophia Book 1 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.1.petermann:13-25",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲉⲕϯⲥⲟ ⲉⲧⲁϩⲓⲕⲱⲛ · ⲁⲕ**ⲥⲱϣⲧ** · ⲁⲕⲃⲁⲃⲱⲱⲧ · ⲁⲕϯϣⲓⲡⲉ ⲛⲁⲓ ·",
      "english": "Thou didst not shew compassion upon My image, thou didst treat Me with contempt, thou didst hold Me in scorn, thou didst inflict disgrace upon Me",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲱⲧⲛ ⲇⲉ ⲙⲡⲣ**ⲥⲱϣⲧ** ⲛⲛϣⲟϫⲛⲉ ⲙⲡϫⲟⲉⲓⲥ ⲡⲉⲛⲛⲟⲩⲧⲉ ϫⲉⲙⲉⲣⲉⲡⲛⲟⲩⲧⲉ ⲟ ⲛⲧϩⲉ ⲁⲛ ⲛⲟⲩⲣⲱⲙⲉ ⲉⲧⲣⲉⲩϭⲱⲛⲧ ⲉⲣⲟϥ ⲟⲩⲇⲉ ⲛⲧϩⲉ ⲁⲛ ⲛⲟⲩϣⲏⲣⲉ ⲛⲣⲱⲙⲉ ⲉⲧⲣⲉⲩϯϩⲁⲡ ⲉⲣⲟϥ",
      "english": "Do not bind the counsels of the Lord our God: for God is not as man, that he may be threatened; neither is he as the son of man, that he should be wavering.",
      "source": "Judith 8",
      "urn": "urn:cts:copticLit:ot.jdt.coptot:8",
      "dialect": "sahidic"
    }
