  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ϩⲱⲥ ⲉⲁⲩⲕⲓⲙ ⲉⲣⲟϥ ϩⲓⲧⲉⲛⲡⲓⲡⲛⲉⲩⲙⲁ ⲉⲑⲟⲩⲁⲃ ⲁϥⲱϣ ⲉⲃⲟⲗ ϧⲉⲛⲟⲩⲥⲙⲏ ⲙⲡⲣⲟⲫⲏⲧⲓⲕⲟⲛ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲛⲑⲟⲕ ⲟⲩⲛⲓϣϯ ⲡϭⲟⲉⲓⲥ ⲫⲛⲟⲩϯ ⲡⲓ**ⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ** ⲟⲩⲟϩ ⲛⲑⲟⲕ ⲙⲙⲁⲩⲁⲧⲕ ⲉⲑⲛⲁⲁϥ ⲟⲩⲟϩ ⲛϩⲣⲏⲓ ϧⲉⲛⲛⲉⲕⲙⲟⲕⲙⲉⲕ ⲙⲙⲟⲛ ⲡⲉⲧⲛⲁϣⲓⲛⲓ ⲙⲙⲟⲕ .",
      "english": "As if he had been moved by the Holy Spirit, he cried out in a prophetic voice, saying, ‘Thou art great, O Lord God, Creator of all things, thou alone art great, and no one shall question thee about thy thoughts.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲟⲩ ⲉⲧⲉⲧⲛⲉⲓⲛⲉ ⲉϩⲣⲁⲓ ⲉϫⲱⲧⲛ ⲛⲟⲩⲥⲛⲟϥ ⲙⲛⲟⲩϩⲁⲡ ϣⲁⲉⲛⲉϩ ⲙⲡⲉⲙⲧⲟ ⲉⲃⲟⲗ ⲙⲡⲛⲟⲩⲧⲉ ⲙ**ⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ** ·",
      "english": ". . .",
      "source": "Acephelous Work 22 YB 83-96",
      "urn": "urn:cts:copticLit:shenoute.a22.monbyb:220-240",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲏ ϩⲁⲛⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲡϭⲟⲉⲓⲥ ⲡⲓ**ⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ** ⲛⲉ ⲛⲁⲓ ⲟⲩⲟϩ ⲁⲩⲙⲟⲩⲛⲕ ϧⲉⲛⲟⲩⲭⲣⲱⲙ ⲛϫⲉϩⲁⲛⲗⲁⲟⲥ ⲉⲩⲟϣ ⲟⲩⲟϩ ϩⲁⲛⲙⲏϣ ⲛⲉⲑⲛⲟⲥ ⲁⲩⲉⲣⲕⲟⲩϫⲓ ⲛϩⲏⲧ .",
      "english": "Are not these things of the Lord Almighty? surely many people have been exhausted in the fire, and many nations have fainted.",
      "source": "Bohairic Habakkuk 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲗⲏⲛ ϯⲛⲁϣⲁϫⲉ ⲙⲡⲉⲕⲙⲧⲟ ⲉⲃⲟⲗ ⲡⲛⲟⲩⲧⲉⲛⲛϭⲟⲙ ⲡ**ⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ** ⲙⲡⲣϭⲱⲛⲧ ⲉⲧⲁⲙⲛⲧⲁⲑⲏⲧ ·",
      "english": "However I will say in your presence, the Lord of powers, ruler of all, don&apos;t be angry at my stupidity.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲁⲓ ⲛⲉ ⲛⲏⲉⲧⲉϥϫⲱ ⲙⲙⲱⲟⲩ ⲛϫⲉⲡϭⲥ ⲡⲓ**ⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ** ϫⲉⲭⲱ ⲛⲛⲉⲧⲉⲛϩⲏⲧ ϩⲓⲛⲛⲉⲧⲉⲛⲙⲱⲓⲧ .",
      "english": "Thus saith the Lord Almighty; Consider your ways.",
      "source": "37_Aggaeus_01",
      "urn": "urn:cts:copticLit:ot.hag.bohairic_ed:01",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲛⲡⲓⲥⲧⲉⲩⲉ ⲉⲩⲛⲟⲩⲧⲉ ⲛⲟⲩⲱⲧ ⲡⲉⲓⲱⲧ ⲡ**ⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ** ⲙⲛⲡⲉϥⲙⲟⲛⲟⲅⲉⲛⲏⲥ ⲛϣⲏⲣⲉ ⲓⲏⲥⲟⲩⲥ ⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲡⲉⲛϫⲟⲉⲓⲥ ⲡⲉⲛⲧⲁⲡⲧⲏⲣϥ ϣⲱⲡⲉ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧϥ · ⲙⲛⲡⲉⲡⲛⲉⲩⲙⲁ ⲉⲧⲟⲩⲁⲁⲃ · ⲉⲧⲉⲧⲁⲓ ⲧⲉ ⲧⲣⲓⲁⲥ ⲉⲧⲥⲙⲁⲙⲁⲁⲧ ·",
      "english": "We believe in the One God, the Father the Almighty, and in His only-begotten Son, Jesus the Christ, our Lord, through Whom the Universe came into being, and in the Holy Spirit, that is to say, in the Blessed Trinity,",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    }
