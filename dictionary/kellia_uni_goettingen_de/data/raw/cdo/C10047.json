  "examples": [
    {
      "coptic": "ⲡϣⲓⲡⲉ ⲙⲡⲉⲓⲙⲁ , ⲡⲉⲟⲟⲩ ⲙⲡⲉⲓⲙⲁ ⲁⲓ**ⲡⲁⲣⲁⲓⲧⲉⲓ** ⲙⲙⲟⲩ , ϯⲥⲟⲟⲩⲛ ⲅⲁⲣ ⲉⲡⲉⲧⲓϭⲱϣⲧ ⲉⲃⲟⲗ ϩⲏⲧϥ .",
      "english": "The shame of this place [i.e. this life], the glory of this place, I have forsaken them, for I know that which I’m looking out for.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲟⲩⲱ ⲉϥϫⲱ ⲙⲙⲟⲥ ⲛϭⲓⲡⲥⲁϩ ⲡⲁⲩⲗⲟⲥ · ϫⲉⲟⲩⲣⲱⲙⲉ ⲛϩⲁⲓⲣⲉϯⲕⲟⲥ · ⲙⲛⲛⲥⲁⲧⲣⲉⲕϯⲥⲃⲱ ⲛⲁϥ ⲛⲟⲩⲥⲟⲡ ⲏ ⲥⲛⲁⲩ · ⲛϥⲧⲙⲥⲱⲧⲙ ⲛⲥⲱⲕ **ⲡⲁⲣⲁⲓⲧⲉⲓ** ⲙⲙⲟϥ · ⲉⲕⲥⲟⲟⲩⲛ ϫⲉⲙⲛⲧϥ ⲙⲉⲣⲓⲥ ⲙⲛⲡⲛⲟⲩⲧⲉ ·",
      "english": "Truly did Paul the scribe say, 'In the case of a man who is a heretic, if after thou hast admonished him once or twice, and he doth not hearken unto thee, let him alone, for thou knowest that his portion is not with God.'",
      "source": "Martyrdom of Victor part 2",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:7-12",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲣ**ⲡⲁⲣⲁⲓⲧⲉⲓ** ⲛⲧⲧⲁⲝⲓⲥ · ⲛⲧⲁⲩⲧⲁⲛϩⲟⲩⲧⲕ ⲉⲣⲟⲥ · ⲛⲧⲙⲡⲁϫⲱϫ ⲛⲁⲡⲟⲥⲧⲟⲗⲟⲥ · ⲁⲗⲗⲁ ⲧⲱⲟⲩⲛ ⲛⲅⲟⲩⲁϩⲕ ⲛⲥⲱⲟⲩ ·",
