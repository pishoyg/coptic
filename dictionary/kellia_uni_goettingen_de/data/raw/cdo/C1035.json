  "examples": [
    {
      "coptic": "ⲛⲉⲕⲛⲁⲓ ⲡϭⲟⲓⲥ ϯⲛⲁϩⲱⲥ ⲙⲙⲱⲟⲩ ϣⲁⲉⲛⲉϩ ⲓⲥϫⲉⲛ ϫⲱⲟⲩ ϣⲁϫⲱⲟⲩ ϯⲛⲁϫⲱ ⲛⲧⲉ**ⲕ**ⲙⲉⲑⲙⲏⲓ ϧⲉⲛⲣⲱⲓ",
      "english": "I will sing of thy mercies, O Lord, for ever: I will declare thy truth with my mouth to all generations.",
      "source": "19_Psalmi_88",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:88",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲕⲉϣⲱⲡⲉ ⲉⲕⲙⲟⲟϣⲉ ⲉϫⲛϩⲏⲧ**ⲕ** ⁛— ⲛⲛⲉϩⲟⲟⲩ ⲧⲏⲣⲟⲩ ⲙⲡⲉⲕⲱⲛϩ · ⲙⲛⲡⲉⲕⲥⲡⲣⲙⲁ ⲧⲏⲣϥ ϣⲁⲛⲅⲉⲛⲉⲁ ⲧⲏⲣⲟⲩ ⲙⲡⲕⲁϩ ·",
      "english": "Thou shalt walk upon thy belly all the days of thy life, and all thy seed [shall be accursed] throughout all generations on the earth.",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲟⲩⲡⲁⲓⲣⲏϯ ⲁⲛ ⲧⲉ ⲧⲧⲟⲓ ⲛⲓⲁⲕⲱⲃ ϫⲉⲟⲩⲏⲓ ⲫⲏⲉⲧⲁϥⲙⲉⲛ**ⲕ** ϩⲱⲃ ⲛⲓⲃⲉⲛ ⲛⲑⲟϥ ⲡⲉ ⲧⲉϥⲕⲗⲏⲣⲟⲛⲟⲙⲓⲁ ⲡϭⲥ ⲡⲉ ⲡⲉϥⲣⲁⲛ .",
      "english": "Such is not the portion of Jacob; for he that formed all things, he is his inheritance; the Lord is his name.",
      "source": "24_Ieremias_10",
      "urn": "urn:cts:copticLit:ot.jer.bohairic_ed:10",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣⲱⲡⲉ ⲕⲟ ⲛⲁϩⲣⲁⲕ ⲙⲁⲩⲁⲁ**ⲕ** ⲛⲟⲩϩⲙϩⲁⲗ ⲛⲁⲧϣⲁⲩ ⲁⲩⲱ ⲛⲣⲉϥⲣⲛⲟⲃⲉ ⲙⲡⲁⲣⲁⲟⲩⲟⲛ ⲛⲓⲙ",
      "english": "whether you have become a worthless slave in your own eyes and a sinner beyond everyone else.",
      "source": "Apophthegmata Patrum Sahidic 128: N 299",
      "urn": "urn:cts:copticLit:ap.128.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲣⲉⲣⲱⲓ ⲥⲁϫⲓ ⲛⲧⲉ**ⲕ**ⲙⲉⲑⲙⲏⲓ ⲛⲉⲙⲡⲉⲕⲟⲩϫⲁⲓ ⲙⲡⲓⲉϩⲟⲟⲩ ⲧⲏⲣϥ: ϫⲉⲙⲡⲓⲉⲙⲓ ⲉϩⲁⲛⲙⲉⲧϣⲱⲧ .",
      "english": "Let those that plot against my soul be ashamed and utterly fail: let those that seek my hurt be clothed with shame and dishonour.",
      "source": "19_Psalmi_70",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:70",
      "dialect": "bohairic"
    },
    {
