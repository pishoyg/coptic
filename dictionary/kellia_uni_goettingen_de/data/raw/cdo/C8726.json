  "examples": [
    {
      "coptic": "ⲁϥⲓ ϣⲁⲣⲟϥ ⲉϥϯϩⲟ ⲉⲣⲟϥ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲉⲡⲉⲓⲇⲏ ⲁⲡⲟⲩⲣⲟ ⲟⲩⲱⲣⲡ ⲛⲥⲱⲓ ⲛⲧⲁϯ ⲡⲗⲟⲅⲟⲥ ⲛⲛⲓ**ⲇⲏⲙⲟⲥⲓⲟⲛ** ⲛⲁϥ ⲉϧⲟⲩⲛ ⲉⲑⲃⲉⲫⲁⲓ ϯϯϩⲟ ⲉⲣⲟⲕ ⲉⲑⲣⲉⲕⲧⲱⲃϩ ⲙⲡϭⲟⲉⲓⲥ ⲉϩⲣⲏⲓ ⲉϫⲱⲓ ⲛⲧⲉϥϭⲱⲣⲡ ⲛⲁⲕ ⲉⲃⲟⲗ ⲛⲛⲏ ⲉⲑⲛⲁϣⲱⲡⲓ ⲙⲙⲟⲓ ϩⲓⲛⲁ ⲛⲧⲁϯ ⲡⲑⲱϣ ⲙⲡⲁⲏⲓ",
      "english": "And he went to him to beseech him, and said, “Since the king has sent for me to give him an account of the public money, I beg you to implore the Lord for me in this matter, that he may reveal to you what will happen to me, and that I may put my house in order.”",
      "source": "Life of Isaac of Alexandria - part 2",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:20-41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϣⲁⲣⲉⲛⲟⲩⲟⲓ ⲉⲩⲫⲣⲁⲛⲉ ⲕⲁⲗⲱⲥ · ϩⲱⲥ ⲉⲩⲑⲁⲣⲉⲓ ⲉⲙⲉϩⲡⲉⲩ**ⲇⲏⲙⲟⲥⲓⲟⲛ** ϩⲛⲛⲉⲩⲉⲓⲟϩⲉ ·",
      "english": "And the husbandmen are wont to rejoice exceedingly, because they have good hope of paying the revenue tax on their flocks and herds.",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϣⲁⲓϫⲟⲟⲩ ⲛⲧⲉⲡⲣⲟⲥⲫⲟⲣⲁ ⲙⲛⲧⲁⲡⲁⲣⲭⲏ ⲛⲥⲉⲥⲩⲛⲁⲅⲉ · ⲙⲙⲟⲛ ⲧⲉⲓⲁϣⲏ ⲛⲏⲣⲡ ⲛϯⲛⲁⲧⲁⲁⲥ ⲁⲛ · ⲁⲗⲗⲁ ϯⲛⲁⲕⲁⲁⲩ ⲛⲧⲁⲧⲁⲁⲩ ⲉⲡϩⲱⲃ ⲛⲛ**ⲇⲏⲙⲟⲥⲓⲟⲛ** · ⲙⲛⲡⲁϫⲁⲓⲃⲉⲕⲉ",
      "english": "I shall certainly not give away this large quantity of wine, but I will put it aside, and will devote it to the needs of the community and to those of my own workmen.'",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥϭⲱⲛⲧ ⲇⲉ ⲛϭⲓⲡⲇⲟⲩⲝ · ⲁϥⲕⲉⲗⲉⲩⲉ ⲉⲧⲣⲉⲩⲛⲟϫϥ ⲉⲡⲉⲙⲧⲱⲕ ⲛⲧⲥⲓⲟⲟⲩⲛ ⲙⲡ**ⲇⲏⲙⲟⲥⲓⲟⲛ** ⲛⲣⲁⲕⲟⲧⲉ · ⲉϥⲥⲟⲛϩ ⲉⲧⲟⲟⲧϥ ⲙⲛⲣⲁⲧϥ · ⲉϥϫⲓ ⲡⲉⲛⲓⲡⲉ ⲉⲛⲉϥϭⲓϫ ⲙⲛⲛⲉϥⲟⲩⲣⲏⲏⲧⲉ ⲁⲩⲱ ⲉⲣⲉⲟⲩⲭⲁⲙⲱⲥ ϩⲛⲣⲱϥ ·",
      "english": "And the Duke was wroth, and he commanded his servants to throw him into the furnace of the public baths of Rakote, bound hand and foot. And he bore iron fetters on his hands and feet and there was a gag in his mouth.",
      "source": "Martyrdom of Victor part 5",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:33-48",
      "dialect": "sahidic"
    }
  ],
