  "examples": [
    {
      "coptic": "ⲁⲕⲧⲁⲕⲟϥ ϫⲉⲕⲁⲥ ⲛⲛⲉⲡⲉϥⲥⲡⲉⲣⲙⲁ ⲧⲱⲟⲩⲛ ϫⲓⲛⲙⲡⲉⲓ ⲛⲁⲩ ⲁⲩⲱ ⲡϣⲁϫⲉ ⲉⲛⲧⲁⲧⲉⲕϭⲟⲙ ϫⲟⲟϥ ϫⲉⲁⲩⲱ ⲛⲧⲟⲕ ⲛⲉⲕⲛⲙⲙⲁⲓ ⲡⲉ **ⲡⲉⲕϯ **ⲛⲧⲟⲟⲧ**** ·",
      "english": "“Thou hast destroyed it, so that its seed may not raise itself up from now on.' And the word which thy power hath spoken: 'And thou wert with me, helping me,”",
      "source": "Pistis Sophia Book 2 Part 3",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:20-36",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲥⲱϣ ⲟⲛ ⲉⲃⲟⲗ ⲉⲥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲓⲛⲟⲩϩⲙ ϩⲙⲡⲉⲭⲁⲟⲥ · ⲁⲩⲱ ⲁⲓⲃⲱⲗ ⲉⲃⲟⲗ ϩⲛⲙⲙⲣⲣⲉ ⲙⲡⲕⲁⲕⲉ · ⲁⲓⲉⲓ ⲉⲣⲁⲧⲕ ⲡⲟⲩⲟⲉⲓⲛ · ϫⲉⲁⲕϣⲱⲡⲉ ⲛⲟⲩⲟⲉⲓⲛ ϩⲓⲥⲁ ⲛⲓⲙ ⲙⲙⲟⲓ ⲉⲕⲛⲟⲩϩⲙ ⲙⲙⲟⲓ ⲁⲩⲱ **ⲉⲕϯ **ⲛⲧⲟⲟⲧ**** · ⲁⲩⲱ ⲛⲉⲡⲣⲟⲃⲟⲗⲟⲟⲩⲉ ⲙⲡⲁⲩⲑⲁⲇⲏⲥ ⲛⲁⲓ ⲉⲩϯ ⲛⲟⲩⲏⲓ · ⲁⲕⲕⲱⲗⲩ ⲙⲙⲟⲟⲩ ϩⲓⲧⲙⲡⲉⲕⲟⲩⲟⲉⲓⲛ ·",
      "english": "“that she cried out again and said: “1. I am saved out of the chaos and loosed from the bonds of the darkness. I am come unto thee, O Light. 2. For thou wert light on all sides of me, saving me and helping me. 3. And the emanations of Self-willed, which fought against me, thou hast hindered through thy light,”",
      "source": "Pistis Sophia Book 2 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:10-19",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲡⲉ ⲡϣⲁϫⲉ ⲉⲛⲧⲁⲥϫⲟⲟϥ ⲛϭⲓⲧⲡⲓⲥⲧⲓⲥ ⲥⲟⲫⲓⲁ · ϫⲉⲛⲧⲉⲣⲟⲩϥⲓ ⲛⲁⲟⲩⲟⲉⲓⲛ ⲛϩⲏⲧ · ⲁⲓϣⲱⲡⲉ ⲛⲧϩⲉ ⲛⲟⲩϩⲩⲗⲏ ⲉⲥϩⲟⲣϣ ⲛⲛⲁϩⲣⲁⲩ · ⲁⲩⲱ ⲡϣⲁϫⲉ ⲟⲛ ⲉⲛⲧⲁⲧⲉⲕϭⲟⲙ ϫⲟⲟϥ ϫⲉⲁⲩⲱ ⲁⲥϣⲱⲡⲉ ⲛⲁⲓ ⲛϭⲓⲟⲩϭⲟⲙ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧⲕ **ⲉⲥϯ **ⲛⲧⲟⲟⲧ**** ·",
      "english": "“--it is the word which Pistis Sophia hath spoken: 'When they had taken my light from me, I became as heavy-weighing matter before them.' And moreover the word which thy power hath spoken: 'Through thee | I have gotten a power for me which helped me,”",
      "source": "Pistis Sophia Book 2 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:10-19",
      "dialect": "sahidic"
    }
  ],
