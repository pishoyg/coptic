  "examples": [
    {
      "coptic": "ⲡⲉⲧⲓϫⲱ ⲙⲙⲟϥ ⲛⲱⲧⲉⲛ ϯ**ϫⲱ** ⲙⲙⲟϥ ⲛⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲣⲱⲓⲥ .",
      "english": "What I tell you, I tell all: 'Watch.'",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲩ ⲡⲉⲧϥ**ϫⲱ** ⲙⲙⲟϥ ·",
      "english": "And what doth he say?",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲱⲧⲉⲙ ⲛⲧⲁ**ϫⲱ** ⲉⲣⲱⲧⲉⲛ ⲙⲡⲁⲓⲕⲉϩⲱⲃ ⲛϣⲫⲏⲣⲓ .",
      "english": "Listen, let me tell you also this wonderful thing.",
      "source": "Life of Isaac of Alexandria - part 3",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:42-48",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲙⲡϥ**ϫⲉ**ⲗⲁⲁⲩ ⲛⲁⲩ ·",
      "english": "And he did not say anything to them.",
      "source": "Apophthegmata Patrum Sahidic 119: Sisoes 16",
      "urn": "urn:cts:copticLit:ap.119.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲁⲓⲱⲧ ⲇⲉ ⲡⲉϫⲁϥ ⲙⲫⲏ ⲉⲧⲥⲁϫⲓ ⲛⲉⲙⲁϥ ϫⲉϩⲱⲗ **ⲁϫⲟ**ⲥ ⲙⲡⲓⲣⲱⲙⲓ ⲉⲧⲁϥⲓ ϫⲉⲉϣⲱⲡ ⲭⲛⲁⲥⲱⲧⲉⲙ ⲛⲥⲱⲓ ϧⲉⲛⲫⲏ ⲉϯⲛⲁϫⲟϥ ⲛⲁⲕ ⲓⲉ ⲭⲛⲁⲛⲁⲩ ⲉⲣⲟⲓ ⲉϣⲱⲡ ⲭⲛⲁⲥⲱⲧⲉⲙ ⲛⲥⲱⲓ ⲁⲛ ⲓⲉ ⲭⲛⲁⲛⲁⲩ ⲉⲡⲁϩⲟ ⲁⲛ .",
      "english": "He instructed the messenger to return with this reply: ‘Tell him: if you are willing to follow my instruction, then you will see me. But if you refuse, I shall not reveal myself to you.’",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲕⲁⲛ ⲉⲕϣⲁⲛ**ϫⲟⲟ**ϥ ⲛⲧⲛⲧⲙⲁⲙⲁϩⲧⲉ ⲙⲙⲟϥ ⲉⲃⲟⲗ",
      "english": "Even if you tell it and we don't understand,",
      "source": "Apophthegmata Patrum Sahidic 138: Unidentified",
      "urn": "urn:cts:copticLit:ap.138.monbeg",
      "dialect": "sahidic"
    }
  ],
