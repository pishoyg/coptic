      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲥⲉⲛⲁϭⲙϭⲟⲙ ⲅⲁⲣ ⲁⲛ ⲉⲣϩⲙϩⲁⲗ ⲛⲁⲕ , ⲛⲥⲉⲣϩⲙϩⲁⲗ ⲛⲛ**ⲣⲉϥϫⲓⲛϭⲟⲛⲥ** ,",
      "english": "For they are not able to serve you, while they serve those who do violence.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟⲛ ⲟⲩⲁⲓ ⲛⲁⲉⲣⲧⲟⲗⲙⲁⲛ ϧⲉⲛⲑⲏⲛⲟⲩ ⲉⲟⲩⲟⲛⲧⲉϥ ⲟⲩϩⲱⲃ ⲟⲩⲧⲱϥ ⲛⲉⲙⲡⲉϥϣⲫⲏⲣ ⲉϭⲓϩⲁⲡ ϩⲓⲛⲓ**ⲣⲉϥϭⲓⲛϫⲟⲛⲥ** ⲟⲩⲟϩ ϩⲓⲛⲓⲁⲅⲓⲟⲥ ⲁⲛ .",
      "english": "Dare any of you, having a matter against his neighbor, go to law before the unrighteous, and not before the saints?",
      "source": "Bohairic 1 Corinthians 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲡⲣϣⲱⲡⲉ ⲛ**ⲣⲉϥϫⲓⲛϭⲟⲛⲥ** · ϫⲉⲙⲛⲣⲉϥϫⲓⲛϭⲟⲛⲥ ⲛⲁⲕⲗⲏⲣⲟⲛⲟⲙⲉⲓ ⲛⲧⲙⲛⲧⲣⲣⲟ ⲙⲡⲛⲟⲩⲧⲉ ·",
      "english": "Be not a man of violence, for no violent man shall inherit the kingdom of God.",
