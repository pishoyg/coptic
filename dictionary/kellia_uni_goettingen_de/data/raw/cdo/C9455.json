  "examples": [
    {
      "coptic": "ⲛⲓⲟⲩⲓⲏ ⲇⲉ ⲉⲧⲉⲙⲙⲁⲩ ⲛⲁⲩϫⲱ ⲙⲙⲟⲥ ⲛⲛⲟⲩⲉⲣⲏⲩ ϫⲉⲫⲁⲓ ⲡⲉ ⲡⲓ**ⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ** ⲁⲙⲱⲓⲛⲓ ⲙⲁⲣⲉⲛϧⲟⲑⲃϥ ⲛⲧⲉϯⲕⲗⲏⲣⲟⲛⲟⲙⲓⲁ ⲉⲣⲑⲱⲛ .",
      "english": "But those farmers said among themselves, 'This is the heir. Come, let's kill him, and the inheritance will be ours.'",
      "source": "Bohairic Gospel of Mark 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲉϭⲙⲏⲩ ⲇⲉ ⲉⲧⲙⲙⲁⲩ ⲁⲩϣⲁϫⲉ ⲙⲛⲛⲉⲩⲉⲣⲏⲩ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲡⲁⲓ ⲡⲉ ⲡⲉ**ⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ** . ⲁⲙⲏⲓⲧⲛ ⲛⲧⲛⲙⲟⲟⲩⲧϥ . ⲁⲩⲱ ⲧⲉⲕⲗⲏⲣⲟⲛⲟⲙⲓⲁ ⲛⲁⲣⲧⲱⲛ .",
      "english": "But those farmers said among themselves, &apos;This is the heir. Come, let&apos;s kill him, and the inheritance will be ours.&apos;",
      "source": "Mark Chapter 12",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:12",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲥϫⲉ ⲇⲉ ⲁⲛⲟⲛ ϩⲁⲛϣⲏⲣⲓ ⲓⲉ ⲁⲛⲟⲛ ϩⲁⲛⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ ⲟⲛ ϩⲁⲛⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ ⲙⲉⲛ ⲛⲧⲉⲫⲛⲟⲩϯ ϩⲁⲛϣⲫⲏⲣ ⲛ**ⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ** ⲛⲧⲉⲡⲭⲣⲓⲥⲧⲟⲥ ⲓⲥϫⲉ ⲧⲉⲛϭⲓⲙⲕⲁϩ ⲛⲉⲙⲁϥ ϩⲓⲛⲁ ⲛⲧⲉⲛϭⲓⲱⲟⲩ ⲛⲉⲙⲁϥ ⲟⲛ .",
      "english": "and if children, then heirs; heirs of God, and joint heirs with Christ; if indeed we suffer with him, that we may also be glorified with him.",
      "source": "06_Romans_08",
      "urn": "urn:cts:copticLit:nt.rom.bohairic:08",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲇⲉ ⲛⲧⲟⲟⲩ ⲛⲉ ⲛ**ⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ** ⲙⲡⲥⲱⲧⲏⲣ · ⲛⲧⲟⲟⲩ ⲛⲉ ⲡⲟⲩⲟⲉⲓⲛ ⲙⲡⲕⲟⲥⲙⲟⲥ · ⲙⲡⲟⲩⲉϣⲣⲟⲩⲟⲉⲓⲛ ⲉⲓⲟⲩⲇⲁⲥ ·",
      "english": "Now the Apostles were the heirs of the Saviour, and they were the light of the world, but Judas did not wish to give forth light.",
      "source": "Homily on Matthew 20",
      "urn": "urn:cts:copticLit:psathanasius.matthew20.budge:1-56",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲥϫⲉ ⲅⲁⲣ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲫⲛⲟⲙⲟⲥ ⲛⲉⲛⲓ**ⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ** ϩⲁⲣⲁ ⲁϥϣⲱⲡⲓ ⲉϥϣⲟⲩⲓⲧ ⲛϫⲉⲡⲓⲛⲁϩϯ ⲟⲩⲟϩ ⲁϥⲕⲱⲣϥ ⲛϫⲉⲡⲓⲱϣ .",
      "english": "For if those who are of the law are heirs, faith is made void, and the promise is made of no effect.",
      "source": "06_Romans_04",
      "urn": "urn:cts:copticLit:nt.rom.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲡⲣⲉⲓⲣⲉ ⲛϯϩⲉ ⲱ ⲡⲙⲟⲛⲁⲭⲟⲥ ⲁⲗⲗⲁ ϭⲱϣⲧ ⲉⲃⲟⲗ ϫⲉⲉⲕⲛⲁϣⲱⲡⲉ ⲛ**ⲕⲗⲏⲣⲟⲛⲟⲙⲟⲥ** ⲙⲡⲛⲟⲩⲧⲉ ·",
      "english": "Do not act in this manner, O monk, but take heed that thou mayest become an heir of God;",
      "source": "The Asceticon of Apa Ephrem part 2",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:24-55",
      "dialect": "sahidic"
    }
