  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲫⲏⲉⲧⲉ ⲛϥⲛⲁϩⲓⲧϥ ⲉϧⲣⲏⲓ ⲁⲛ ⲛⲧⲉϥⲟⲩⲱϣⲧ ϧⲉⲛϯⲟⲩⲛⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ ⲉⲩⲉϩⲓⲧϥ ⲉϯϩⲣⲱ ⲛⲭⲣⲱⲙ ⲉⲧ**ⲙⲟϩ** .",
      "english": "And whosoever shall not fall down and worship, in the same hour he shall be cast into the burning fiery furnace.",
      "source": "27_Daniel_03",
      "urn": "urn:cts:copticLit:ot.dan.bohairic_ed:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϣⲱⲡⲉ ⲉⲧⲉⲧⲛϣⲁⲛⲧⲙⲛⲁⲩ ⲉⲣⲱⲧⲛ ⲙⲙⲓⲛⲙⲙⲱⲧⲛ ⲉⲧⲉⲧⲛⲟ ⲛⲧϩⲉ ⲙⲡⲥⲁⲧⲁⲛⲁⲥ ϩⲣⲁⲓ ϩⲛⲧⲉϩⲣⲱ ⲛⲕⲱϩⲧ ⲉⲧ**ⲙⲟⲩϩ** ·",
      "english": "If you do not see yourselves then what you become is Satan's burning furnace of fire.",
      "source": "Abraham Our Father XL 93-94",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbxl:23-24",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲏ ⲉⲧⲉⲙⲙⲁⲩ ⲛⲉⲛⲑⲟϥ ⲡⲉ ⲡⲓϧⲏⲃⲥ ⲉⲧ**ⲙⲟϩ** ⲟⲩⲟϩ ⲉⲧⲉⲣⲟⲩⲱⲓⲛⲓ ⲛⲑⲱⲧⲉⲛ ⲇⲉ ⲁⲧⲉⲧⲉⲛⲟⲩⲱϣ ⲉⲑⲉⲗⲏⲗ ⲙⲙⲱⲧⲉⲛ ⲡⲣⲟⲥ ⲟⲩⲟⲩⲛⲟⲩ ϧⲉⲛⲡⲉϥⲟⲩⲱⲓⲛⲓ .",
      "english": "He was the burning and shining lamp, and you were willing to rejoice for a while in his light.",
      "source": "04_John_05",
      "urn": "urn:cts:copticLit:nt.john.bohairic:05",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲉⲛⲧⲉⲧⲛϯⲡⲉ ϣⲱⲡⲉ ⲉⲩⲙⲏⲣ ⲉⲣⲉⲛⲉⲧⲛϩⲏⲃⲥ **ⲙⲟⲩϩ** .",
      "english": "'Let your waist be girded and your lamps burning.",
      "source": "42_Luke_12",
      "urn": "urn:cts:copticLit:nt.luke.sahidica:12",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϥϣⲟⲡ ⲅⲁⲣ ϧⲉⲛⲛⲓⲫⲏⲟⲩⲓ ⲛϫⲉⲡⲉⲛⲛⲟⲩϯ ⲫⲁⲓ ⲁⲛⲟⲛ ⲉⲧⲉⲛϣⲉⲙϣⲓ ⲙⲙⲟϥ ⲉⲟⲩⲟⲛϣϫⲟⲙ ⲙⲙⲟϥ ⲉⲛⲁϩⲙⲉⲛ ⲉⲃⲟⲗϧⲉⲛ ϯϩⲣⲱ ⲛⲭⲣⲱⲙ ⲉⲧ**ⲙⲟϩ** ⲟⲩⲟϩ ⲉⲃⲟⲗϧⲉⲛ ⲛⲉⲕϫⲓϫ ⲡⲟⲩⲣⲟ ⲉϥⲉⲛⲁϩⲙⲉⲛ .",
      "english": "For our God whom we serve is in the heavens, able to deliver us from the burning fiery furnace, and he will rescue us from thy hands, O king.",
      "source": "27_Daniel_03",
      "urn": "urn:cts:copticLit:ot.dan.bohairic_ed:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲛⲁⲛ ϫⲉⲁⲥϣⲱⲡⲉ ⲛⲟⲩϩⲟⲟⲩ ⲁⲛⲛⲁⲩ ⲉⲩⲕⲱϩⲧ ⲉϥ**ⲙⲟⲩϩ** ϩⲙⲡⲉϥⲏⲓ ⲁⲛϣⲁϫⲉ ⲙⲛⲛⲉⲛⲉⲣⲏⲩ ϫⲉⲁⲣⲁ ⲉⲣⲉⲡⲉⲥⲩⲛⲑⲓⲟⲥ ϣⲏⲙ ϫⲉⲣⲉⲕⲱϩⲧ ⲉⲟⲩ ⲛⲛⲉⲓⲟⲩⲛⲟⲟⲩⲉ ·",
      "english": "Now this man said unto us, 'It came to pass on a certain day that we saw a fire burning in his house, and we said unto each other. Is it possible that Pisentius has lighted a fire? Wherefore hath he done this at this time of the year?'",
