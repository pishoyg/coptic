  "examples": [
    {
      "coptic": "ⲁϥⲛⲁⲩ ⲉⲡⲓϣⲟⲗ ⲛⲥⲱⲟⲩⲃⲉⲛ ⲫⲏ ⲉⲧⲧⲁⲗⲏⲟⲩⲧ ⲉⲡⲓⲁⲗⲟⲩ ⲉⲣⲉⲡⲧⲩⲡⲟⲥ ⲛⲟⲩⲥⲧⲁⲩⲣⲟⲥ ⲛⲟⲩⲱⲓⲛⲓ ⲭⲏ ϩⲓϫⲱϥ ⲉϥϩⲓ **ⲉⲃⲣⲏϫ** ⲛⲟⲩⲱⲓⲛⲓ ⲉⲃⲟⲗ .",
      "english": "He saw the bundle placed on the young boy having the shape of luminous crosses, throwing flashes of light.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲕⲁϩ ⲅⲁⲣ ⲛⲁⲛⲟⲉⲓⲛ ⲛϥⲕⲱ ϩⲁⲣⲱⲟⲩ · ⲛⲉϩⲣⲟⲩⲃⲃⲁⲓ ⲛⲁϯϩⲟⲧⲉ ⲛⲁⲩ · ⲛ**ⲉⲃⲣⲏϭⲉ** ⲛⲕⲱϩⲧ ⲛⲁϣⲧⲣⲧⲱⲣⲟⲩ · ⲛⲧⲏⲩⲛⲁⲣⲁϩⲧⲟⲩ ⲉⲩⲛⲟⲉⲓⲛ ⲉⲣⲟⲟⲩ ·",
      "english": "For the earth shall shake under them, the thunders shall strike terror into them, the lightnings of fire shall alarm them, and the winds shall buffet them and shake them violently.",
      "source": "The Asceticon of Apa Ephrem part 2",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:24-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲫⲣⲏϯ ⲙⲡⲓⲥⲉⲧ**ⲉⲃⲣⲏϫ** ⲉϣⲁϥⲟⲩⲟⲛϩϥ ⲉⲃⲟⲗ ϧⲉⲛⲧⲫⲉ ⲟⲩⲟϩ ⲛⲧⲉϥⲉⲣⲟⲩⲱⲓⲛⲓ ⲥⲁⲡⲉⲥⲏⲧ ⲛⲧⲫⲉ ⲫⲁⲓ ⲡⲉ ⲙⲫⲣⲏϯ ⲉⲧⲉⲡϣⲏ ⲣⲓ ⲙⲫⲣⲱⲙⲓ ⲛⲁϣⲱⲡⲓ ⲙⲙⲟϥ ⲛϩⲣⲏⲓ ϧⲉⲛⲡⲉϥⲉϩⲟⲟⲩ .",
      "english": "for as the lightning, when it flashes out of the one part under the sky, shines to the other part under the sky; so will the Son of Man be in his day.",
      "source": "03_Luke_17",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:17",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲉⲥϣⲱⲡⲉ ϩⲓϫⲱⲛ ⲛϭⲓⲟⲩⲕⲗⲟⲟⲗⲉ · ⲛⲕⲁⲕⲉ ⲙⲛⲟⲩⲕⲙⲧⲱ ⲙⲛϩⲉⲛϩⲣⲟⲩⲃⲁⲓ · ⲙⲛϩⲉⲛϩⲣⲟⲩⲙⲡⲉ ⲙⲛϩⲉⲛ**ⲉⲃⲣⲏϭⲉ** · ⲙⲛϩⲉⲛⲑⲗⲓⲯⲓⲥ ⲛⲥⲁⲥⲁ ⲛⲓⲙ · ⲛⲧⲉⲧⲛⲧⲙⲧϩⲉ ϣⲱⲡⲉ ⲛⲁⲛ ⲉⲃⲱⲕ ⲉⲗⲁⲁⲩ ⲛⲥⲁ ·",
      "english": "and there come upon us a black cloud, and earthquake, and thunders, and thunderbolts (?), and lightnings, and tribulations on every side of us, and we shall have no place whither to make our escape.",
      "source": "The Asceticon of Apa Ephrem part 1",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲫⲣⲏϯ ⲅⲁⲣ ⲙⲡⲓⲥⲉⲧ**ⲉⲃⲣⲏϫ** ⲉϣⲁϥⲓ ⲉⲃⲟⲗ ⲥⲁⲡⲉⲓⲉⲃⲧ ⲟⲩⲟϩ ⲛⲧⲉϥⲟⲩⲟⲛϩϥ ⲥⲁⲡⲉⲙⲉⲛⲧ ⲫⲁⲓ ⲡⲉ ⲙⲫⲣⲏϯ ⲙⲡϫⲓⲛⲓ ⲙⲡϣⲏⲣⲓ ⲙⲫⲣⲱⲙⲓ .",
      "english": "For as the lightning flashes from the east, and is seen even to the west, so will be the coming of the Son of Man.",
      "source": "01_Matthew_24",
      "urn": "urn:cts:copticLit:nt.matt.bohairic:24",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲉⲣⲉⲡⲉϥⲥⲱⲙⲁ ⲧⲏⲣϥ ⲙⲉϩ ⲛⲃⲁⲗ ⲉϥⲛⲏⲩ **ⲉⲃⲣⲏϭⲉ** ⲛⲟⲩⲟⲉⲓⲛ ⲉⲃⲟⲗ ·",
      "english": "and the whole of his body was full of eyes, and flashes of lightning shot out from him.",
      "source": "Mysteries of John the Evangelist part 1",
