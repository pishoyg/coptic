  "examples": [
    {
      "coptic": "ⲉⲣϫⲓϭⲟⲗ ⲉⲙⲡⲟⲩ**ⲙⲓϣⲉ** ⲛⲙⲙⲉ ⲟⲩⲧⲉ ⲙⲡⲟⲩϩⲟⲟⲩϣ ⲉⲣⲟ ·",
      "english": "It’s you lying, as they didn’t fight with you nor did they abuse you.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲣϣⲁⲛⲛⲉⲑⲏⲣⲓⲟⲛ · ⲟⲩⲱⲙ ⲙⲡⲣⲱⲙⲉ ⲙⲉⲩϩⲉ ⲉⲣⲟϥ ⲛⲕⲉⲥⲟⲡ ⲉⲧⲣⲉϥ**ⲙⲓϣⲉ** ⲛⲙⲙⲁϥ ·",
      "english": "When the wild beast devoureth a man the man is no longer forthcoming to fight with him again.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲇⲓⲁⲃⲟⲗⲟⲥ ⲛⲁϣϯ ⲙⲡⲉϥⲛⲟⲩⲟⲓ ⲉⲣⲟϥ ⲁⲛ ⲉ**ⲙⲓϣⲉ** ⲛⲙⲙⲁϥ ·",
      "english": "the mighty Devil would not be able to go against Him to fight with Him.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    }
