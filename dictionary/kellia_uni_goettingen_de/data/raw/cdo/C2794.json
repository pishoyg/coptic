  "examples": [
    {
      "coptic": "**ⲫⲏ** ⲉⲧⲥⲓϯ ⲁϥⲥⲓϯ ⲙⲡⲓⲥⲁϫⲓ .",
      "english": "The farmer sows the word.",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲧⲟⲛ ⲙⲙⲟ ⲛⲧⲉⲓⲟⲩϣⲏ ϣⲁⲛⲧⲉϣⲱⲣⲡ ϣⲱⲡⲉ ⲁⲩⲱ ⲉⲛϣⲁⲛⲉⲓ ⲉϩⲧⲟⲟⲩⲉ ⲉⲣϣⲁⲛ**ⲡⲏ** ϫⲓⲧⲉ ⲟⲩⲁⲅⲁⲑⲟⲛ ⲡⲉ ⲙⲁⲣⲉϥϫⲓⲧⲉ ⲉϥϣⲁⲛⲧⲙⲣϩⲛⲁϥ ⲇⲉ ⲉϫⲓⲧⲉ ⲁⲛⲟⲕ ϯⲛⲁϫⲓⲧⲉ ϥⲟⲛϩ ⲛϭⲓⲡϫⲟⲉⲓⲥ ⲛⲕⲟⲧⲕ ϣⲁϩⲧⲟⲟⲩⲉ",
      "english": "Lodge here for the night, and it shall be in the morning, if he will do the part of a kinsman to thee, welllet him do it: but if he will not do the part of a kinsman to thee, I will do the kinsman's part to thee, as the Lord lives; lie down till the morning.",
      "source": "Ruth Chapter 3",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲫⲏ** ⲉⲧⲧⲱⲙⲓ ⲙⲙⲟϥ ⲉⲡϭⲟⲓⲥ ⲟⲩⲡⲛⲉⲩⲙⲁ ⲛⲟⲩⲱⲧ .",
      "english": "But he who is joined to the Lord is one spirit.",
      "source": "Bohairic 1 Corinthians 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲭⲣⲱ ⲛⲧⲙⲛⲧⲙⲁⲓⲣⲱⲙⲉ ⲉϩⲟⲩⲛ ⲉ**ⲡⲏ** ⲁⲩⲱ ⲛⲅⲭⲁⲣⲓⲍⲉ ⲙⲡⲁⲓ ·",
      "english": "Do deeds of kindness and charity to this man, and act with gracious goodness to that man.",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲩⲧⲁⲙⲉⲡⲓⲡⲣⲟⲫⲏⲧⲏⲥ ⲉⲑⲟⲩⲁⲃ ⲁⲡⲁ ϣⲉⲛⲟⲩϯ ⲉ**ⲛⲏ** ⲧⲏⲣⲟⲩ ⲉⲧⲁⲡⲓⲣⲱⲙⲓ ϫⲟⲧⲟⲩ .",
      "english": "Apa Shenoute was informed of the man’s words.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ **ⲛⲏ** ⲛⲉ ⲛⲧⲁⲩϫⲟⲟⲩ ⲉϫⲙⲡⲕⲁϩ ⲉⲧⲛⲁⲛⲟⲩϥ ⲉⲩⲥⲱⲧⲙ ⲉⲡϣⲁϫⲉ ⲥⲉϣⲱⲡ ⲙⲙⲟϥ ⲉⲣⲟⲟⲩ ⲁⲩⲱ ⲥⲉⲧⲁⲩⲉⲕⲁⲣⲡⲟⲥ ⲉⲃⲟⲗ ϩⲛⲙⲁⲁⲃ ⲁⲩⲱ ϩⲛⲥⲉ ⲁⲩⲱ ϩⲛϣⲉ .",
