  "examples": [
    {
      "coptic": "ϯⲛⲁⲙⲉⲛⲣⲓⲧⲕ ⲡϭⲟⲓⲥ ⲧⲁϫⲟⲙ . ⲡϭⲟⲓⲥ ⲡⲉ ⲡⲁⲧⲁϫⲣⲟ ⲛⲉⲙⲡⲁⲙⲁⲙⲫⲱⲧ ⲛⲉⲙⲡⲁⲣⲉϥⲛⲁϩⲙⲉⲧ . ⲡⲁⲛⲟⲩϯ ⲡⲉ ⲡⲁ**ⲃⲟⲏⲑⲟⲥ** ⲉⲓⲉⲉⲣϩⲉⲗⲡⲓⲥ ⲉⲣⲟϥ .",
      "english": "I will love thee, O Lord, my strength.",
      "source": "19_Psalmi_17",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:17",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛϥⲛⲁϣϭⲙϭⲟⲙ ⲅⲁⲣ ⲁⲛ ⲉⲛⲉⲧⲣϩⲟⲧⲉ ϩⲏⲧϥ ⲙⲡⲛⲟⲩⲧⲉ . ⲛⲁⲓ ⲉⲧⲉⲣⲉⲡⲉⲭⲣⲓⲥⲧⲟⲥ ϣⲟⲟⲡ ⲛⲁⲩ ⲛ**ⲃⲟⲏⲑⲟⲥ** ⲁⲩⲱ ⲛⲥⲕⲉⲡⲁⲥⲧⲏⲥ ·",
      "english": "For he will not have power over those who fear God inside. Those for whom Christ is an aid and a protector.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁ ⲡϭⲟⲓⲥ ⲥⲱⲧⲉⲙ ⲟⲩⲟϩ ⲁϥⲛⲁⲓ ⲛⲏⲓ: ⲁ ⲡϭⲟⲓⲥ ϣⲱⲡⲓ ⲛⲏⲓ ⲛⲟⲩ**ⲃⲟⲏⲑⲟⲥ** .",
      "english": "The Lord heard, and had compassion upon me; the Lord is become my helper.",
      "source": "19_Psalmi_29",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:29",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ϫⲉⲡⲁϫⲟⲉⲓⲥ · ⲧⲉⲥϩⲓⲙⲉ ⲛⲧⲁⲕⲧⲁⲧⲁⲁⲥ ⲛⲁⲓ ⲛ**ⲃⲟⲏⲑⲟⲥ** · ⲛⲧⲟⲥ ⲁⲥⲧⲙⲙⲟⲓ ⲁⲓⲕⲱ ⲕⲁϩⲏⲩ ·",
      "english": "And Adam said, 'My Lord, the woman whom Thou didst give unto me as a helper made me eat, and I became naked.'",
      "source": "Discourse on Abbaton, part 2",
      "urn": "urn:cts:copticLit:timothy.discourses.on_abbaton:22-54",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲁⲛⲡⲁⲣⲁⲛⲟⲙⲟⲥ ⲁⲓⲙⲉⲥⲧⲱⲟⲩ ⲟⲩⲟϩ ⲡⲉⲕⲛⲟⲙⲟⲥ ⲁⲓⲙⲉⲛⲣⲓⲧϥ ϫⲉⲛⲑⲟⲕ ⲡⲉ ⲡⲁ**ⲃⲟⲏⲑⲟⲥ** ⲟⲩⲟϩ ⲡⲁⲛⲁϣϯ ⲁⲓⲉⲣϩⲉⲗⲡⲓⲥ ⲉⲡⲉⲕⲥⲁϫⲓ",
      "english": "They nearly made an end of me in the earth; but I forsook not thy commandments.",
      "source": "19_Psalmi_118",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:118",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲁϥ ⲟⲛ ⲛⲁⲓ ϫⲉⲡⲁⲓ ⲡⲉ ⲡⲣⲱⲙⲉ ⲙⲡⲉϥⲛⲕⲟⲧⲕ ⲟⲩⲇⲉ ⲙⲡⲉϥⲱⲃϣ ⲟⲩⲇⲉ ⲙⲡⲉϥϫⲓⲣⲉⲕⲣⲓⲕⲉ ϣⲁⲛⲧⲉϥϭⲛⲟⲩⲙⲁ ⲙⲡϫⲟⲉⲓⲥ ⲟⲩⲙⲁ ⲛϣⲱⲡⲉ ⲙⲡⲛⲟⲩⲧⲉ ⲛⲓⲁⲕⲱⲃ ⲡⲉϥ**ⲃⲟⲏⲑⲟⲥ** ·",
      "english": "And he also said unto me, 'This is the man who did not lie down on his bed, nor slumber, nor sleep until he found the place of the Lord, the habitation of the God of Jacob, his Helper.",
      "source": "Life of Cyrus in Budge ed. part 2",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:10-17",
      "dialect": "sahidic"
    }
  ],
