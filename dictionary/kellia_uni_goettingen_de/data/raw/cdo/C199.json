  "examples": [
    {
      "coptic": "ⲧ**ⲁⲣⲭⲏ** ⲙⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ⲛⲧⲉⲓⲏⲥⲟⲩⲥ ⲡⲭⲣⲓⲥⲧⲟⲥ ⲡϣⲏⲣⲓ ⲙⲫⲛⲟⲩϯ .",
      "english": "The beginning of the Good News of Jesus Christ, the Son of God.",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϯϩⲱⲛ ⲉⲧⲟⲟⲧⲕ ⲛⲛⲉⲩⲉⲛⲧⲟⲗⲏ ϩⲛⲧⲉⲕ**ⲁⲣⲭⲏ** ·",
      "english": "I gave thee commandments in thy beginning,",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧ**ⲁⲣⲭⲏ** ⲅⲁⲣ ⲛϯⲁⲡⲟⲥⲧⲁⲥⲓⲁ ⲉⲃⲟⲗ ϩⲁⲫϯ ⲑⲁⲓ ⲧⲉ ⲟⲩⲣⲱⲙⲓ ⲁϥϣⲁⲛⲙⲁϩϧⲏⲧϥ ⲙⲡⲥⲁϫⲓ ⲛⲫϯ ⲛⲧⲉϥϣⲧⲉⲙⲉⲣⲉⲡⲓⲑⲩⲙⲓⲛ ⲉⲣⲟϥ ⲟⲩⲇⲉ ⲛⲧⲉϥϣⲧⲉⲙⲉⲣϩⲱⲃ ⲉⲣⲟϥ",
      "english": "From God, indeed, comes the beginning of apostasy when a person fills their heart neither desiring nor acting according to the Word of God.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲉⲫⲩⲥⲓⲥ ⲇⲉ ⲙⲡⲛⲟⲩⲧⲉ ⲙⲛⲧⲥ **ⲁⲣⲭⲏ** ·",
      "english": "The nature of God is without beginning.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲓⲛⲁ ⲛⲧⲉϣⲧⲉⲙⲟⲩⲁⲓ ⲙⲉⲩⲓ ⲉⲣⲟⲓ ϫⲉⲉⲓϣⲟⲩϣⲟⲩ ⲉϫⲱϥ ⲓⲉ ⲉⲓϯϩⲙⲟⲧ ⲛⲁϥ ϯϯ ⲙⲡⲭⲣⲓⲥⲧⲟⲥ ⲙⲙⲉⲑⲣⲉ ⲉⲣⲟⲓ ϫⲉⲡϩⲟⲩⲟ ⲛⲧⲉⲛⲉϥⲁⲣⲉⲧⲏ ⲁⲓⲛⲁⲩ ⲛⲁⲓ ⲉϯⲛⲁⲥϧⲏⲧⲟⲩ ⲛⲱⲧⲉⲛ ⲉⲟⲩϩⲏⲟⲩ ⲛⲛⲏ ⲉⲑⲛⲁⲱϣ ⲙⲙⲱⲟⲩ ⲛⲉⲙⲛⲏ ⲉⲑⲛⲁⲥⲱⲧⲉ ⲉⲣⲱⲟⲩ ⲛⲥⲉϯⲱⲟⲩ ⲙⲡⲭⲣⲓⲥⲧⲟⲥ ⲫⲏ ⲉⲧϯϫⲟⲙ ⲛⲛⲉϥⲉⲃⲓⲁⲓⲕ ⲉⲑⲣⲟⲩⲓⲣⲓ ⲙⲡⲉⲑⲣⲁⲛⲁϥ ⲁⲛⲟⲕ ϩⲱ ⲛⲧⲁⲉⲣⲡⲉⲙⲡϣⲁ ⲛⲧⲁⲧⲁⲙⲱⲧⲉⲛ ϫⲉⲓⲥϫⲉⲛ ⲧⲉϥ**ⲁⲣⲭⲏ** ⲡⲱⲥ ϣⲁⲧⲉϥⲓ ⲉⲛⲁⲓϣⲓ ⲛⲉⲙⲛⲁⲓⲛⲓϣϯ ⲛⲁⲥⲕⲩⲥⲓⲥ ϣⲁⲧⲉϥϫⲉⲕⲝ ⲛⲣⲟⲙⲡⲓ ⲟⲩⲟϩ ⲡⲁⲓⲣⲏϯ ⲁϥⲙⲧⲟⲛ ⲙⲙⲟϥ ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲥϧⲏⲟⲩⲧ ϫⲉϧⲉⲛⲟⲩⲕⲟⲩϫⲓ ⲛⲥⲏⲟⲩ ϥϫⲱⲕ ⲛⲟⲩⲙⲏϣ ⲛⲣⲟⲙⲡⲓ ⲉⲃⲟⲗ .",
      "english": "But lest anyone should think that I ascribe glory to him or offer him praise, I call Christ as my witness that I saw most of his virtues with my own eyes, and that the miracles he performed were not done for his own glory, but for the benefit of those who will read or hear of them, so that they may praise Christ, who gives power to his servants and fulfills His will in them. Would that I were also worthy to teach you these things—namely, how he progressed from his beginning to this perfection and great asceticism, completing sixty years, and then rested, as it is written, ‘In a short time, he fulfilled many years.’",
      "source": "Bohairic Lausiac History - Part 3",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:38",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲡⲁⲓ ⲙⲡⲣⲧⲣⲉⲛⲁⲡⲟⲧⲁⲥⲥⲉ ⲉⲧⲙϥⲓ ϩⲁⲛⲉⲛⲉⲣⲏⲩ ϫⲉⲛⲛⲉⲡⲛⲟⲩⲧⲉ ϭⲱⲛⲧ ⲉⲣⲟⲛ ϫⲉⲙⲡⲁⲧⲛⲱⲥⲕ ⲅⲁⲣ ⲉⲛϥⲓ ϩⲁⲛⲉⲛⲉⲣⲏⲩ ⲛⲧϩⲉ ⲙⲡϫⲟⲉⲓⲥ ⲁⲩⲱ ⲡⲉϥⲭⲣⲓⲥⲧⲟⲥ ⲙⲛⲛⲉϥⲁⲅⲅⲉⲗⲟⲥ ⲉⲧⲟⲩⲁⲁⲃ ⲉⲧϥⲓ ϩⲁⲣⲟⲛ ϫⲓⲛⲧ**ⲁⲣⲭⲏ** ⲙⲡⲥⲱⲛⲧ ϣⲁϩⲣⲁⲓ ⲉⲡϩⲟⲟⲩ ⲛϩⲟⲟⲩ ⲁⲩⲱ ⲟⲛ ϣⲁⲉⲛⲉϩ ·",
      "english": "For this reason, let us not give up to not support each other that God may not be mad at us that we have indeed not yet continued to support each other like the Lord and his Christ and His angels that are holy, which support us since the beginning of creation and up until the day of days and also forever.",
      "source": "Abraham Our Father XL 93-94",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbxl:23-24",
      "dialect": "sahidic"
