  "examples": [
    {
      "coptic": "ⲡⲙⲁ ⲉⲧϥⲛⲁⲧⲁϩⲟϥ ϣⲁϥⲣⲁϩⲧϥ ⲉⲡⲕⲁϩ ⲛϥⲧⲁⲩⲉⲥϩⲃⲏⲓⲧⲉ ⲉⲃⲟⲗ ⲛϥϩⲣⲁϫⲣⲉϫ ⲛⲛⲉϥⲟⲃϩⲉ ⲛϥ**ⲧⲱⲥ** . ⲁⲓϫⲟⲟⲥ ϭⲉ ⲛⲛⲉⲕⲙⲁⲑⲏⲧⲏⲥ ϫⲉⲉⲩⲉⲛⲟϫϥ ⲉⲃⲟⲗ ⲁⲩⲱ ⲙⲡⲟⲩϣⲛⲟϫϥ .",
      "english": "and wherever it seizes him, it throws him down, and he foams at the mouth, and grinds his teeth, and wastes away. I asked your disciples to cast it out, and they weren&apos;t able.&apos;",
      "source": "41_Mark_9",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩ**ⲧⲱⲥ** ⲁⲩⲣⲧϭⲟⲧ ⲛⲟⲩⲱⲛⲉ ⲉⲩⲁϣⲉ ⲛⲥⲱⲥ ·",
      "english": "and at the same time they shrivelled up, and became as hard as stones, and they hung down on her body;",
      "source": "Encomium on Victor part 1",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲛⲉⲩⲣⲱⲛ ⲛⲛⲉⲕϭⲓϫ ⲙⲛⲛⲉⲕⲟⲩⲣⲏⲏⲧⲉ **ⲧⲱⲥ** ·",
      "english": "and the veins, and tendons, and sinews of thy hands and feet shall dry up,",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    }
  ],
