  "examples": [
    {
      "coptic": "ⲫⲏ ⲉⲛⲁⲣⲉⲡⲉϥⲙⲁ ⲛ**ϣⲱⲡⲓ** ϣⲟⲡ ϧⲉⲛⲛⲓⲙϩⲁⲩ ⲟⲩⲟϩ ⲟⲩⲇⲉ ϧⲉⲛⲛⲓⲕⲉϩⲁⲗⲩⲥⲓⲥ ⲙⲙⲟⲛ ϣϫⲟⲙ ⲛϩⲗⲓ ⲡⲉ ⲉⲥⲟⲛϩϥ",
      "english": "He lived in the tombs. Nobody could bind him any more, not even with chains,",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲉⲧⲃⲉⲟⲩ ϯϩⲙⲟⲟⲥ ϩⲙⲡⲁⲙⲁ ⲛ**ϣⲱⲡⲉ** ϯϩⲗⲡⲗⲱⲡ ·ⲻ",
      "english": "Why do I sit in my cell and become distressed?",
      "source": "Apophthegmata Patrum Sahidic 006: anonymous Nau 196",
      "urn": "urn:cts:copticLit:ap.6.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲟⲩⲏⲓ ϩⲏⲡⲡⲉ ⲁⲛⲟⲕ ϯⲛⲁⲧⲟⲩⲛⲟⲥ ⲛⲓⲭⲁⲗⲇⲉⲟⲥ ⲛⲏ ⲉⲧⲟⲓ ⲛⲣⲉϥϯ ⲡⲓⲉⲑⲛⲟⲥ ⲉⲧⲁⲥⲓⲱⲟⲩ ⲟⲩⲟϩ ⲉⲧⲉⲛϣⲁϣⲓ ⲫⲏ ⲉⲑⲙⲟϣⲓ ϩⲓϫⲉⲛⲛⲓⲟⲩⲏϣⲥⲓ ⲛⲧⲉⲡⲕⲁϩⲓ ⲉⲧⲣⲉϥⲉⲣⲕⲗⲏⲣⲟⲛⲟⲙⲓⲛ ⲛϩⲁⲛⲙⲁ ⲛ**ϣⲱⲡⲓ** ⲉⲛⲟⲩϥ ⲁⲛ ⲡⲉ .",
      "english": "Wherefore, behold, I stir up the Chaldeans, the bitter and hasty nation, that walks upon the breadth of the earth, to inherit tabernacles not his own.",
      "source": "Bohairic Habakkuk 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲣⲓ ⲁⲡⲁⲧⲟⲟⲧⲕ ⲉⲕϩⲙⲡⲉⲕⲙⲁ ⲛ**ϣⲱⲡⲉ** ·",
      "english": "Do diligently whilst thou art in thy habitation.",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧϣⲉⲃⲓⲱ ⲛϩⲁⲛϧⲓⲥⲓ ⲉⲩⲉⲛⲁⲩ ⲉⲛⲉⲕⲙⲁ ⲛⲙⲟϣⲓ ⲛⲉⲛⲉϩ ⲉⲩⲉⲛⲟⲩϣⲡ ⲛϫⲉⲛⲓⲙⲁ ⲛ**ϣⲱⲡⲓ** ⲛⲧⲉⲛⲓⲉⲑⲁⲩϣ ⲛⲉⲙⲛⲓⲥⲕⲩⲛⲏ ⲛⲧⲉⲡⲕⲁϩⲓ ⲙⲙⲁⲇⲓⲁⲙ .",
      "english": "Because of troubles I looked upon the tents of the Ethiopians: the tabernacles also of the land of Madiam shall be dismayed.",
      "source": "Bohairic Habakkuk 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲉⲩⲛⲟⲩⲃⲛⲛⲉ · ⲇⲉ ⲣⲏⲧ · ⲛⲥⲁⲃⲟⲗ ⲙⲡⲉϥⲙⲁ ⲛ**ϣⲱⲡⲉ** · ⲉⲥⲧⲁⲩⲟ ⲉⲃⲟⲗ ⲙⲙⲛⲧⲥⲛⲟⲟⲩⲥ ⲛⲗⲟⲟⲩ ⲟⲩⲗⲟⲟⲩ ⲕⲁⲧⲁⲉⲃⲟⲧ ·",
      "english": "Now there was a palm-tree growing outside that cell, and it produced twelve clusters, one cluster each month,",
      "source": "Life of Cyrus in Budge ed. part 1",
      "urn": "urn:cts:copticLit:lives.cyrus.budge:1-9",
