  "examples": [
    {
      "coptic": "ⲉⲩⲉ**ⲧⲱⲟⲩⲛ**ⲟⲩ ⲅⲁⲣ ⲛϫⲉϩⲁⲛⲭⲣⲓⲥⲧⲟⲥ ⲛⲛⲟⲩϫ ⲛⲉⲙϩⲁⲛⲡⲣⲟⲫⲏⲧⲏⲥ ⲛⲛⲟⲩϫ ⲟⲩⲟϩ ⲛⲧⲟⲩϯ ⲛϩⲁⲛⲙⲏⲓⲛⲓ ⲛⲉⲙϩⲁⲛϣⲫⲏⲣⲓ ⲉⲡϫⲓⲛⲥⲱⲣⲉⲙ ⲁⲩϣⲁⲛϣϫⲉⲙϫⲟⲙ ⲛⲛⲓⲕⲉⲥⲱⲧⲡ",
      "english": "For there will arise false christs and false prophets, and will show signs and wonders, that they may lead astray, if possible, even the chosen ones.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲉϣⲁⲕ ϥⲛⲁ**ⲧⲱⲟⲩⲛ**",
      "english": "Perhaps he will arise.”",
      "source": "Apophthegmata Patrum Sahidic 100: Anonymous N 294",
      "urn": "urn:cts:copticLit:ap.100.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲉⲩⲉ**ⲧⲱⲟⲩⲛ**ⲟⲩ ⲛⲟⲩϩⲟϯ ϧⲉⲛⲟⲩϩⲟϯ ⲉⲩⲉϭⲓⲗⲁⲡⲥⲓ ⲙⲙⲟϥ ⲟⲩⲟϩ ⲉⲩⲉⲉⲣⲛⲏⲫⲓⲛ ⲛϫⲉⲛⲉⲕⲉⲡⲓⲃⲟⲩⲗⲟⲥ ⲟⲩⲟϩ ⲉⲕⲉϣⲱⲡⲓ ⲛⲱⲟⲩ ⲛⲟⲩϩⲱⲗⲉⲙ .",
      "english": "For suddenly there shall arise up those that bite him, and they that plot against thee shall awake, and thou shalt be a plunder to them.",
      "source": "Bohairic Habakkuk 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉ**ⲧⲱⲟⲩⲛ** ⲉⲓϫⲉⲣⲟⲕ ϥⲓ ⲙⲡⲉⲕϭⲗⲟϭ ⲃⲱⲕ ⲉⲡⲉⲕⲏⲓ",
      "english": "I tell you, arise, take up your mat, and go to your house.'",
      "source": "Mark Chapter 2",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁⲩϣⲱⲡⲓ ⲟⲩⲛ ϧⲉⲛⲡⲓⲧⲱⲟⲩ ⲉⲧⲉⲙⲙⲁⲩ ⲛⲟⲩⲙⲏϣ ⲛⲉϩⲟⲟⲩ ϣⲁⲋ ⲛⲁⲃⲟⲧ ⲁϥⲥⲁϫⲓ ⲛϫⲉⲫⲏ ⲉⲑⲟⲩⲁⲃ ⲓⲥⲁⲁⲕ ⲛⲉⲙⲡⲓϧⲉⲗⲗⲟ ⲁⲃⲣⲁⲁⲙ ϫⲉ**ⲧⲱⲛ**ⲕ ⲁⲙⲟⲩ ⲛⲉⲙⲏⲓ ϣⲁⲛⲁⲓⲟϯ ⲛⲧⲁⲟⲩⲟⲛϩⲧ ⲉⲣⲱⲟⲩ ϫⲉⲟⲩⲏⲓ ⲁⲓϣⲧⲉⲙⲟⲩⲟⲛϩⲧ ⲉⲣⲱⲟⲩ ⲥⲉⲛⲁⲁⲓⲧ ⲛⲣⲉⲙϩⲉ ⲁⲛ .",
      "english": "And after they remained on this mountain for a multitude of days, up to six months, Saint Isaac spoke to the old man Abraham and said to him, ‘Arise, come with me to my parents to show me to them, for surely if I do not show myself to them, they will not make me a free man.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁϥϯⲡⲉϥⲟⲩⲟⲉⲓ ⲉⲣⲟϥ ⲛϭⲓⲡⲛⲉⲉϥ ⲉⲧϩⲓϩⲏ ⲉϥϫⲱ ⲙⲙⲟⲥ ⲛⲁϥ ϫⲉⲉⲧⲃⲉⲟⲩ ⲛⲧⲟⲕ ⲕϩⲣϩⲣ : **ⲧⲱⲟⲩⲛ** ⲛⲅⲉⲡⲓⲕⲁⲗⲉⲓ ⲙⲡⲉⲕⲛⲟⲩⲧⲉ ⲙⲉϣⲁⲕ ⲉϥⲉⲛⲁϩⲙⲛ ⲛϭⲓⲡⲉⲕⲛⲟⲩⲧⲉ ⲛⲧⲛⲧⲙⲙⲟⲩ :",
      "english": "And the shipmaster came to him, and said to him, Why snorest thou? arise, and call upon thy God, that God may save us, and we perish not.",
      "source": "Jonah Chapter 1 (Sahidic)",
      "urn": "urn:cts:copticLit:ot.jonah.coptot_ed:1",
      "dialect": "sahidic"
    }
