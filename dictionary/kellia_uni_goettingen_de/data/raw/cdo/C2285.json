  "examples": [
    {
      "coptic": "ϣⲁⲣⲉⲡⲓⲕⲁϩⲓ ⲙⲙⲁⲩⲁⲧϥ ϯⲟⲩⲧⲁϩ ⲛϣⲟⲣⲡ ⲛⲟⲩⲥⲓⲙ ⲓⲧⲁ ⲟⲩϧⲉⲙⲥ ⲓⲧⲁ ϣⲁϥ**ⲙⲟϩ** ⲛϫⲉⲫⲏ ⲉⲧϧⲉⲛⲡⲓϧⲉⲙⲥ",
      "english": "For the earth bears fruit: first the blade, then the ear, then the full grain in the ear.",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲡⲉⲓⲉⲣⲟ ⲡⲛⲟⲩⲧⲉ **ⲙⲟⲩϩ** ⲙⲙⲟⲟⲩ",
      "english": "The river of God is full of water.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁϥϭⲟϫⲓ ⲛϫⲉⲟⲩⲁⲓ ⲁϥ**ⲙⲁϩ**ⲟⲩⲥⲫⲟⲅⲅⲟⲥ ⲛϩⲉⲙϫ ⲁϥⲧⲁⲗⲟϥ ⲉϫⲉⲛⲟⲩⲕⲁϣ ⲁϥⲧⲥⲟϥ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲭⲁϥ ⲛⲧⲉⲛⲛⲁⲩ ϫⲉⲏⲗⲓⲁⲥ ⲛⲏⲟⲩ ⲛⲧⲉϥⲉⲛϥ ⲉϧⲣⲏⲓ .",
      "english": "One ran, and filling a sponge full of vinegar, put it on a reed, and gave it to him to drink, saying, 'Let him be. Let's see whether Elijah comes to take him down.'",
      "source": "Bohairic Gospel of Mark 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥ**ⲙⲁϩ**ϥ ⲉⲁϥϫⲟⲕϥ ⲉⲃⲟⲗ ϩⲛⲟⲩⲉⲓⲣⲏⲛⲏ ·",
      "english": "and (the life) is full and made perfect in peace.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲩⲱⲗⲓ ⲙⲓⲃ ⲛⲕⲟⲧ ⲛⲗⲁⲕϩ ⲉⲩ**ⲙⲉϩ** ⲛⲉⲙⲉⲃⲟⲗ ϧⲉⲛⲛⲓⲕⲉⲧⲉⲃⲧ .",
