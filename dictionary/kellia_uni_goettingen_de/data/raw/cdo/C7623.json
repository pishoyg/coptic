  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲁⲟⲩⲛⲓϣϯ ⲛⲑⲏⲟⲩ ϣⲱⲡⲓ ⲟⲩⲟϩ ⲛⲓ**ϫⲟⲗ** ⲛⲁⲩϩⲓⲟⲩⲓ ⲙⲙⲱⲟⲩ ⲉⲡⲓϫⲟⲓ ϩⲱⲥⲧⲉ ϩⲏⲇⲏ ⲛⲧⲉϥⲙⲟϩ ⲛϫⲉⲡⲓϫⲟⲓ .",
      "english": "A big wind storm arose, and the waves beat into the boat, so much that the boat was already filled.",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲥⲉ**ϭⲱⲱⲗⲉ** ⲙⲙⲟⲥ ⲙⲛⲛⲉⲥⲕⲉⲩⲏ ⲧⲏⲣⲟⲩ ϩⲛⲟⲩϩⲏⲃⲥ ⲛϣⲁⲁⲣ ⲛϩⲩⲁⲕⲓⲛⲑⲓⲛⲟⲛ ⲛⲥⲉⲧⲁⲗⲟ ⲙⲙⲟⲥ ⲉϩⲣⲁⲓ ⲉϫⲛⲛⲟⲩⲁϩ",
      "english": "And they shall put it, and all its vessels, into a blue skin cover; and they shall put it on bearers.",
      "source": "Numbers 4",
      "urn": "urn:cts:copticLit:ot.num.coptot:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲓⲉϯ ⲛⲟⲩⲭⲁⲕⲓ ϩⲓⲱⲧⲥ ⲛⲧⲫⲉ ⲟⲩⲟϩ ⲉⲓⲉⲭⲱ ⲛⲟⲩⲥⲟⲕ ⲉⲡⲉⲥϩⲃⲱⲥ ⲛ**ϫⲱⲗ** .",
      "english": "I will clothe the sky with darkness, and will make its covering as sackcloth.",
      "source": "23_Isaias_50",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:50",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲉⲣϥϩⲱⲛ ⲇⲉ ⲉϩⲟⲩⲛ ⲉⲣⲟⲓ ⲛϥⲕⲏⲕⲁϩⲏⲩ ⲡⲉ · ⲁⲩⲱ ⲉⲣⲉⲡⲉϥⲃⲱ ϩⲱⲃⲥ ⲛⲧⲉϥⲁⲥⲭⲏⲙⲟⲥⲩⲛⲏ · ⲁⲩⲱ ⲉϥⲟ ⲛϩⲃⲥⲱ ⲉϥ**ϭⲟⲟⲗⲉ** ⲙⲙⲟϥ ·",
      "english": "and when he approached me he was naked, and his hair covered his shame, and it served as raiment to clothe him.",
      "source": "Life of Onnophrius part 1",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:1-9",
      "dialect": "sahidic"
    },
