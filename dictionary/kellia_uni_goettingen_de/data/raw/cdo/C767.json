  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲥⲉⲉⲛⲕⲟⲧ ϧⲉⲛⲛⲓⲙϩⲁⲩ ⲛⲉⲙϧⲉⲛⲛⲓⲥⲡⲉⲗⲉⲟⲛ ⲉⲑⲃⲉϩⲁⲛⲣⲁⲥⲟⲩⲓ ⲛⲏⲉⲑⲟⲩⲉⲙ ⲁϥ ⲛ**ⲉϣⲱ** ⲛⲉⲙⲡⲓⲍⲱⲙⲓⲛ ⲛⲧⲉⲛⲓϣⲟⲩϣⲱⲟⲩϣⲓ ⲥⲉϭⲁϧⲉⲙ ⲛϫⲉⲛⲟⲩⲥⲕⲉⲩⲟⲥ ⲧⲏⲣⲟⲩ .",
      "english": "They lie down to sleep in the tombs and in the caves for the sake of dreams, even they that eat swine's flesh, and the broth of their sacrifices: all their vessels are defiled:",
      "source": "23_Isaias_65",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:65",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥⲉⲓ ⲉϩⲣⲁⲓ ⲉϫⲱⲟⲩ ⲛϭⲓⲡϣⲁϫⲉ ⲙⲡⲡⲁⲣϩⲁⲓⲙⲓⲁ ⲙⲙⲉ . ϫⲉⲟⲩϩⲟⲣ ⲉⲁϥⲕⲟⲧϥ ⲉⲡⲉϥⲕⲁ ⲃⲁⲗ ⲁⲩⲱ ⲟⲩ**ⲉϣⲱ** ⲉⲁⲥϫⲱⲕⲙ ϩⲁⲡⲉⲥⲕⲟⲣⲕⲣ ⲙⲡⲗⲁⲓϩⲉ .",
      "english": "But it has happened to them according to the true proverb, 'The dog turns to his own vomit again,' and 'the sow that has washed to wallowing in the mire.'",
      "source": "61_2 Peter_2",
      "urn": "urn:cts:copticLit:nt.2pet.sahidica:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲏⲉⲧⲧⲟⲩⲃⲟ ⲙⲙⲱⲟⲩ ⲟⲩⲟϩ ⲉⲧⲉⲣⲕⲁⲑⲁⲣⲓⲍⲓⲛ ⲙⲙⲱⲟⲩ ϧⲉⲛⲛⲓϭⲱⲙ ⲟⲩⲟϩ ⲉⲑⲟⲩⲱⲙ ϩⲓⲣⲉⲛⲛⲓⲣⲱⲟⲩ ⲛⲛⲓⲁϥ ⲛ**ⲉϣⲱ** ⲛⲉⲙⲛⲓⲥⲱϥ ⲛⲉⲙⲛⲓⲫⲓⲛ ⲉⲩⲉⲙⲟⲩⲛⲕ ⲉⲩⲥⲟⲡ ⲡⲉϫⲉ ⲡϭⲥ .",
      "english": "They that sanctify themselves and purify themselves in the gardens, and eat swine's flesh in the porches, and the abominations, and the mouse, shall be consumed together, saith the Lord.",
      "source": "23_Isaias_66",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:66",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧϩⲉ ⲛⲟⲩϭⲁϫⲉ ⲉϥϩⲛϣⲁⲛⲧⲥ ⲛⲟⲩ**ⲉϣⲱ** ⲧⲁⲓ ⲧⲉ ⲧϩⲉ ⲙⲡⲥⲁ ⲛⲟⲩⲥϩⲓⲙⲉ ⲉⲥⲃⲟⲟⲛⲉ",
      "english": "As an ornament in a swine's snout, so is beauty to an ill-minded women.",
      "source": "Proverbs 11",
      "urn": "urn:cts:copticLit:ot.prov.coptot:11",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲁϥⲟⲩⲁϩⲥⲁϩⲛⲓ ⲛⲱⲟⲩ ⲟⲩⲟϩ ⲉⲧⲁⲩⲓ ⲉⲃⲟⲗ ⲛϫⲉⲛⲓⲡⲛⲉⲩⲙⲁ ⲛⲁⲕⲁⲑⲣⲧⲟⲛ ⲁⲩϣⲉ ⲛⲱⲟⲩ ⲉϧⲟⲩⲛ ⲉⲛⲓ**ⲉϣⲁⲩ** ⲟⲩⲟϩ ⲁⲥϩⲉⲓ ⲉϧⲣⲏⲓ ⲛϫⲉϯⲁⲅⲉⲗⲏ ϧⲁⲧⲉⲛⲡⲓϫⲁϫⲣⲓⲙ ⲉⲫⲓⲟⲙ ⲉⲩⲉⲣϣⲟ ⲥⲛⲁⲩ ⲟⲩⲟϩ ⲛⲁⲩⲱϫϩ ⲙⲙⲱⲟⲩ ϧⲉⲛⲫⲓⲟⲙ .",
      "english": "At once Jesus gave them permission. The unclean spirits came out and entered into the pigs. The herd of about two thousand rushed down the steep bank into the sea, and they were drowned in the sea.",
      "source": "Bohairic Gospel of Mark 5 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:5",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁⲩⲥⲉⲡⲥⲱⲡϥ ⲉⲩϫⲱ ⲙⲙⲟⲥ ⲛⲁϥ ϫⲉϫⲟⲟⲩⲛ ⲉϩⲟⲩⲛ ⲉⲛ**ⲉϣⲁⲩ**",
      "english": "All the demons begged him, saying, 'Send us into the pigs, that we may enter into them.'",
      "source": "41_Mark_5",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:5",
      "dialect": "sahidic"
    }
  ],
