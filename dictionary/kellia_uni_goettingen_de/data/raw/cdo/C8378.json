  "examples": [
    {
      "coptic": "**ⲁⲡⲟⲗⲟⲅⲓⲍⲉ** ⲛⲁⲛ ⲧⲉⲛⲟⲩ ⲱ ⲧⲉⲕⲧⲏⲥⲓⲥ ⲧⲏⲣⲥ ⲉⲧⲉⲙⲉⲥϣⲁϫⲉ ·",
      "english": "And now, all creation which is without speech maketh its defence before us, and saith",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲕⲥⲟⲟⲩⲛ ⲡⲁϫⲟⲉⲓⲥ · ϫⲉⲟⲩⲛϩⲁϩ ⲙⲙⲁⲓϯⲧⲱⲛ ϩⲙⲡⲕⲟⲥⲙⲟⲥ ϩⲓⲁⲡⲓⲥⲧⲟⲥ ⲥⲉⲛⲁϣⲓⲛⲉ ⲛⲥⲁϩⲱⲃ ⲛⲓⲙ ⲉⲃⲟⲗ ϩⲓⲧⲟⲟⲧⲛ · ⲉⲛⲟⲩⲱϣ ϫⲉⲕⲁⲥ ⲉⲛⲉϭ ⲛⲧϩⲉ ⲛ**ⲁⲡⲟⲗⲟⲅⲓⲍⲉ** ⲛⲁⲩ ϩⲛϩⲱⲃ ⲛⲓⲙ ·",
      "english": "And, O my Lord, Thou knowest that there are very many contentious and unbelieving people who will ask questions of us concerning everything, and we wish to be able to explain unto them everything.",
      "source": "Discourse on Abbaton part 1",
      "urn": "urn:cts:copticLit:pstimothy.abbaton.budge:1-21",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲛⲁⲩ ⲉⲧⲛⲛⲁⲁϩⲉⲣⲁⲧⲛ ϩⲓⲡⲃⲏⲙⲁ ⲉⲧⲟⲩⲁⲁⲃ ⲉⲧⲣⲉⲛ**ⲁⲡⲟⲗⲟⲅⲓⲍⲉ** ϩⲁⲛⲉⲛⲧⲁⲛⲁⲁⲩ ⲧⲏⲣⲟⲩ ϩⲙⲡⲙⲁ ⲉⲧⲟⲩⲛⲁⲧⲁϩⲟ ⲉⲣⲁⲧⲟⲩ ⲛⲛⲛⲟⲃⲉ ⲉⲛⲧⲁⲛⲁⲁⲩ ⲙⲡⲉⲙⲧⲟ ⲉⲃⲟⲗ ⲛⲛⲃⲁⲗ ⲛⲟⲩⲟⲛ ⲛⲓⲙ ·",
      "english": "and that moment when we shall take our stand before the Holy Throne, and shall have to defend every deed which we have done in this world, and when all the sins which we have committed shall be made to appear before the eyes of every one,",
      "source": "On Penitence and Abstinence, part 2",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:120-241",
      "dialect": "sahidic"
    }
