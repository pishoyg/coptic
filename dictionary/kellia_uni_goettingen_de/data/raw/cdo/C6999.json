  "examples": [
    {
      "coptic": "ⲙⲁⲗⲓⲥⲧⲁ ⲉⲁⲣϫⲟⲟⲩ ⲙⲡⲟⲩⲉⲓⲱⲧ ⲙⲛⲧⲟⲩⲙⲁⲁⲩ , ϫⲉⲁⲩⲙⲓϣⲉ ⲛⲙⲙⲁⲓ · ⲏ ϫⲉⲁⲩ**ϩⲟⲟⲩϣ** ⲉⲣⲟⲓ ·",
      "english": "Most of all when you sent to your father and your mother: “they fought with me,” or “they abused me”.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲓⲟⲩⲱϣⲃ ⲇⲉ ⲡⲉϫⲁⲓ ⲛⲁϥ ϫⲉⲛⲧⲛⲁϣϫⲓⲧⲟⲩ ⲁⲛ · ⲁϫⲛⲧⲉⲥⲃⲱ ⲙⲡⲛⲟϭ · ⲛⲣⲱⲙⲉ · ⲙⲏⲡⲟⲧⲉ ⲛϥⲉⲓⲙⲉ ⲛϥ**ϩⲟⲟⲩϣ** ⲉⲣⲟⲓ ·",
      "english": "Then I answered and said unto him, ' I will not take them without the knowledge of the great man, lest if he find it out he scold me.'",
      "source": "Life of Pisentius part 2",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:32-58",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲣϫⲓϭⲟⲗ ⲉⲙⲡⲟⲩⲙⲓϣⲉ ⲛⲙⲙⲉ ⲟⲩⲧⲉ ⲙⲡⲟⲩ**ϩⲟⲟⲩϣ** ⲉⲣⲟ ·",
      "english": "It’s you lying, as they didn’t fight with you nor did they abuse you.",
