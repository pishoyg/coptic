  "examples": [
    {
      "coptic": "ⲛⲧⲉⲣⲉⲛⲁⲩ ⲇⲉ ϣⲉ . ⲛⲉϥⲙⲁⲑⲏⲧⲏⲥ ⲁⲩϯⲡⲉⲩⲟⲩⲟⲉⲓ ⲉⲣⲟϥ ⲉⲩϫⲱ ⲙⲙⲟⲥ ⲛⲁϥ ϫⲉⲡⲙⲁ ⲟⲩϫⲁⲓⲉⲡⲉ . ⲁⲩⲱ **ⲏⲇⲏ** ⲁⲛⲁⲩ ϣⲉ .",
      "english": "When it was late in the day, his disciples came to him, and said, 'This place is deserted, and it is late in the day.",
      "source": "Mark Chapter 6",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲏⲇⲏ** ⲙⲉⲛ ϩⲟⲗⲱⲥ ⲣⲱ ⲟⲩϣⲱⲱⲧ ⲛⲏⲧⲛ ⲡⲉ ϫⲉⲟⲩⲛⲧⲏⲧⲛϩⲁⲡ ⲙⲛⲛⲉⲧⲛⲉⲣⲏⲩ . ⲉⲧⲃⲉⲟⲩ ⲣⲱ ⲥⲉⲛⲁϫⲓⲧⲏⲩⲧⲛ ⲁⲛ ⲛϭⲟⲛⲥ . ⲉⲧⲃⲉⲟⲩ ⲣⲱ ⲥⲉⲛⲁϥⲉϭⲧⲏⲩⲧⲛ ⲁⲛ .",
      "english": "Therefore it is already altogether a defect in you, that you have lawsuits one with another. Why not rather be wronged? Why not rather be defrauded?",
      "source": "1 Corinthians 6",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲃⲟⲉⲥ ⲛⲁⲥ ϫⲉ**ⲏⲇⲏ** ⲁⲡⲛⲁⲩ ⲛⲟⲩⲱⲙ ϣⲱⲡⲉ ϯⲡⲟⲩⲟⲩⲟⲓ ⲉϩⲟⲩⲛ ⲉⲡⲉⲓⲙⲁ ⲛⲧⲉⲟⲩⲱⲙ ⲉⲃⲟⲗ ϩⲛⲛⲉⲛⲟⲉⲓⲕ ⲁⲩⲱ ⲛⲧⲉⲥⲉⲡⲧⲟⲩⲗⲁⲕⲙ ϩⲙⲡϩⲙϫ ⲁⲩⲱ ϩⲣⲟⲩⲑ ⲁⲥϩⲙⲟⲟⲥ ⲉϩⲣⲁⲓ ⲛⲥⲁⲥⲡⲓⲣ ⲛⲛⲉⲧⲱϩⲥ ⲁⲃⲟⲉⲥ ⲧⲁⲙⲓⲟ ⲛⲁⲥ ⲙⲡⲉⲧⲥⲛⲁⲟⲩⲟⲙϥ ⲁⲥⲟⲩⲱⲙ ⲁⲥⲥⲉⲓ ⲁⲥⲕⲱ ⲉⲡⲁϩⲟⲩ ⲙⲡⲥⲉⲉⲡⲉ",
      "english": "And Booz said to her, Now it is time to eat; come hither, and thou shalt eat of the bread, and thou shalt dip thy morsel in the vinegar: and Ruth sat by the side of the reapers: and Booz handed her meal, and she ate, and was satisfied, and left.",
      "source": "Ruth Chapter 2",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:2",
      "dialect": "sahidic"
    }
