  "examples": [
    {
      "coptic": "**ⲁⲗⲗⲁ** ⲉⲣⲉϩⲁⲛⲥⲁⲛⲇⲁⲗⲓⲟⲛ ⲧⲟⲓ ⲉⲣⲁⲧ ⲉⲛⲑⲏⲛⲟⲩ ⲟⲩⲟϩ ⲙⲡⲉⲣϯϣⲑⲏⲛ ⲥⲛⲟⲩϯ ϩⲓⲑⲏⲛⲟⲩ",
      "english": "but to wear sandals, and not put on two tunics.",
      "source": "Bohairic Gospel of Mark 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲁⲗⲗⲁ** ⲧⲉⲧⲛ ⲟⲩⲱϩ ⲟⲛ ⲉϫⲛⲛⲉⲧⲛϫⲓⲛϭⲟⲛⲥ ·",
      "english": "But rather you still add to your violence.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉⲧⲁⲩⲉⲛⲡⲓⲣⲱⲙⲓ ⲅⲁⲣ ⲁⲛ ⲉⲃⲟⲗ ϧⲉⲛϯⲥϩⲓⲙⲓ **ⲁⲗⲗⲁ** ϯⲥϩⲓⲙⲓ ⲉⲃⲟⲗ ϧⲉⲛⲡⲓⲣⲱⲙⲓ .",
      "english": "For man is not from woman, but woman from man;",
      "source": "Bohairic 1 Corinthians 11 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲁⲗⲗⲁ** ⲛϩⲟⲩⲟ ⲛⲧⲟϥ ⲁⲙⲁϩⲧⲉ ϩⲓϫⲛ ⲙⲙⲉⲉⲩⲉ ⲙⲡⲟⲛⲏⲣⲟⲛ ·",
      "english": "But rather master evil thoughts.'",
      "source": "Apophthegmata Patrum Sahidic 059",
      "urn": "urn:cts:copticLit:ap.59.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲕⲉ ⲅⲁⲣ ⲡⲓⲥⲱⲙⲁ ⲛⲟⲩⲙⲉⲗⲟⲥ ⲛⲟⲩⲱⲧ ⲁⲛ ⲡⲉ **ⲁⲗⲗⲁ** ⲟⲩⲙⲏϣ .",
      "english": "For the body is not one member, but many.",
      "source": "Bohairic 1 Corinthians 12 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:12",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲁⲗⲗⲁ** ⲁⲛⲅⲟⲩⲣⲱⲙⲉ ⲛⲣⲉϥⲣⲛⲟⲃⲉ · ⲁⲩⲱ ⲛⲃⲣⲣⲉ ·",
      "english": "Rather, I am a sinful and young human.'",
      "source": "Apophthegmata Patrum Sahidic 070",
      "urn": "urn:cts:copticLit:ap.70.monbeg",
      "dialect": "sahidic"
    }
