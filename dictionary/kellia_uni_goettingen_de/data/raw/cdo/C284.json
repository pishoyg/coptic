  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲛⲟⲩⲙⲟⲩϯ ⲉⲣⲟⲑⲏⲉⲧⲥⲟϫⲡ ⲟⲩⲟϩ ⲡⲉⲕ**ⲁϩⲓ** ⲛⲛⲟⲩⲙⲟⲩϯ ⲉⲣⲟϥ ϫⲉⲡⲓϣⲁϥⲉ ⲛⲑⲟ ⲅⲁⲣ ⲉⲩⲉⲙⲟⲩϯ ⲉⲣⲟϫⲉⲡⲁⲟⲩⲱϣ ⲟⲩⲟϩ ⲡⲉⲕⲁϩⲓ ϫⲉϯⲟⲓⲕⲟⲩⲙⲉⲛⲏ .",
      "english": "And thou shalt no more be called Forsaken; and thy land shall no more be called Desert: for thou shalt be called My Pleasure, and thy land Inhabited: for the Lord has taken pleasure in thee, and thy land shall be inhabited.",
      "source": "23_Isaias_62",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:62",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲛ ϫⲉⲁⲛⲁ**ⲁϩⲉ**ⲱϫⲛ ϩⲛⲟⲩⲙⲕⲁϩ ⲛϩⲏⲧ ·",
      "english": ". . .",
      "source": "Acephelous Work 22 YB 83-96",
      "urn": "urn:cts:copticLit:shenoute.a22.monbyb:220-240",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲏⲡⲡⲉ ⲓⲥ ⲡⲉⲗⲁⲟⲥ ⲙⲫⲣⲏϯ ⲛϩⲁⲛϩⲓⲟⲙⲓ ⲛϧⲣⲏⲓ ⲛϧⲏϯ ⲛⲓⲡⲩⲗⲏ ⲛⲧⲉⲡⲉⲕ**ⲁϩⲓ** ϧⲉⲛⲟⲩⲁⲟⲩⲱⲛ ⲉⲩⲉⲁⲟⲩⲱⲛ ⲙⲙⲱⲟⲩ ⲛⲛⲉⲥⲁϫⲓ ⲟⲩⲭⲣⲱⲙ ⲉϥⲉⲟⲩⲱⲙ ⲛⲛⲉⲙⲟⲭⲗⲟⲥ .",
      "english": "Behold, thy people within thee are as women: the gates of thy land shall surely be opened to thine enemies: the fire shall devour thy bars.",
      "source": "34_Nahum_03",
      "urn": "urn:cts:copticLit:ot.nah.bohairic_ed:03",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉϥⲃⲱⲕ ⲇⲉ ⲛϥⲣⲙⲟⲛⲁⲭⲟⲥ ⲁϥϣⲱⲡⲉ ϩⲛⲟⲩⲁⲙⲉⲗⲓⲁ . ⲁⲩⲱ ⲁϥϫⲉⲡⲉϥ**ⲁϩⲉ** ⲉⲃⲟⲗ ⲕⲁⲕⲱⲥ .",
      "english": "When he had gone and become a monk, he became negligent, and he spent his life badly.",
      "source": "Apophthegmata Patrum Sahidic 001: Anonymous Nau 135",
      "urn": "urn:cts:copticLit:ap.1.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲫⲣⲱⲙⲓ ⲅⲁⲣ ⲙⲙⲓⲥⲓ ⲉⲃⲟⲗϧⲉⲛ ⲟⲩⲥϩⲓⲙⲓ ⲟⲩⲕⲟⲩϫⲓ ⲛ**ⲁϩⲓ** ⲡⲉ ⲟⲩⲟϩ ϥⲙⲉϩ ⲛϫⲱⲛⲧ .",
      "english": "For a mortal born of a woman is short lived, and full of wrath.",
      "source": "18_Iob_14",
      "urn": "urn:cts:copticLit:ot.job.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲕⲁⲛ ⲉⲕⲟⲩⲱⲙ ⲕⲁⲛ ⲉⲕⲥⲱ · ⲕⲁⲛ ⲉⲕⲛⲏⲥⲧⲉⲩⲉ · ⲕⲁⲛ ⲉⲕϩⲕⲁⲉⲓⲧ · ⲕⲁⲛ ⲉⲕⲟⲃⲉ · ϣⲁⲣⲉⲡⲣⲏ ϩⲱⲧⲡ ⲙⲙⲏⲛⲉ · ⲛⲥⲉϭⲱϫⲃ ϩⲙⲡⲉⲕ**ⲁϩⲉ** ⲙⲙⲏⲛⲉ ·",
      "english": "And whether thou eatest, or whether thou drinkest, or whether thou fastest, or whether thou art hungry, or whether thou art thirsty, the sun wall set every day, and the period of thy life will become less day by day.",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    }
