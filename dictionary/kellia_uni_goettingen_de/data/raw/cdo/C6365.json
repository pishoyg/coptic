  "examples": [
    {
      "coptic": "ⲡⲁⲓ ⲇⲉ ⲉⲓϫⲱ ⲙⲙⲟϥ ⲛⲁⲥⲛⲏⲩ ϫⲉⲡⲉⲩⲟⲉⲓϣ ⲛⲟⲗⲕ ⲡⲉ . ϫⲉⲕⲁⲁⲥ ϭⲉ ⲛⲕⲟⲟⲩⲉ ⲉⲧⲉⲩⲛⲧⲟⲩⲥϩⲓⲙⲉ ⲙⲙⲁⲩ ⲛⲥⲉ**ⲣⲑⲉ** ⲛⲛⲉⲧⲉⲙⲛⲧⲁⲩ .",
      "english": "But I say this, brothers: the time is short, that from now on, both those who have wives may be as though they had none;",
      "source": "46_1 Corinthians_7",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "**ⲁⲣⲓⲑⲉ** ⲛⲁⲩ ⲉⲛⲧⲁⲕⲁⲁⲥ ⲙⲙⲁⲇⲓϩⲁⲙ ⲙⲛⲥⲓⲥⲁⲣⲁ ⲁⲩⲱ ⲛⲧϩⲉ ⲛⲓⲁⲃⲉⲓⲛ ϩⲙⲡⲉⲭⲉⲓⲙⲁⲣⲣⲟⲥ ⲛⲕⲉⲓⲥⲱⲛ",
      "english": "Do thou to them as to Madiam, and to Sisera; as to Jabin at the brook of Kison.",
      "source": "Psalms 82",
      "urn": "urn:cts:copticLit:ot.pss.coptot:82",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣⲱⲡⲉ ⲉⲁⲩⲁⲁⲕ ⲛⲛⲟϭ ⲉⲩⲙⲏⲏϣⲉ ⲙⲡⲣϫⲓⲥⲉ ⲙⲙⲟⲕ ⲉϫⲱϥ: **ⲁⲣⲓⲑⲉ** ⲛⲟⲩⲁ ⲙⲙⲟⲟⲩ ⲛϩⲏⲧⲟⲩ ⲛⲅϥⲓⲡⲉⲩⲣⲟⲟⲩϣ ⲛⲅϩⲙⲟⲟⲥ",
      "english": "He that keepeth the law bringeth offerings enough: he that taketh heed to the commandment offereth a peace offering.",
