  "examples": [
    {
      "coptic": "ⲉϣϫⲉ ⲉⲓⲛⲁⲩ ⲉⲡⲉⲕⲣⲓⲙⲙⲁ ϩⲱⲱϥ ⲙⲡⲙⲧⲟ ⲛⲛⲁⲃⲁⲗ ⲉϥ**ⲁⲡⲉⲓⲗⲉ** ⲛⲁⲓ ⲛⲧⲉⲓϩⲉ ϫⲉ · ⲁⲣⲁ ⲧⲉⲓⲙⲛⲧⲣⲉϥⲣϩⲟⲧⲉ ⲛⲧⲉⲓⲙⲓⲛⲉ ⲣⲁⲛⲁϥ ⲙⲡⲛⲟⲩⲧⲉ · ⲉϣϫⲉ ϩⲟⲗⲱⲥ ⲕϩⲟⲙⲟⲗⲟⲅⲉⲓ ϫⲉϩⲉⲛⲡⲉⲧⲟⲩⲁⲁⲃ ⲛⲉ ⲁⲩⲱ ϩⲉⲛⲡⲁⲣⲁⲛⲏⲧⲟⲥ ⲛⲉ , ⲁⲩⲱ ϫⲉⲁⲛⲉⲩⲡⲟⲗⲏϯⲁ ϫⲓⲥⲉ ⲛⲧⲉⲓϩⲉ ⲧⲏⲣⲥ ⲕⲁⲧⲁⲧϩⲉ ⲉⲧⲉⲕϫⲱ ⲙⲙⲟⲥ ,",
      "english": "it's as if I'm seeing the very accusation before my eyes, threatening me like so: “Is this kind of fear pleasing to God? If you wholly acknowledge that they're saints and that they're exemplaries, and that their conduct is so exalted, just like you're saying,",
      "source": "Life of Longinus and Lucius part 1",
      "urn": "urn:cts:copticLit:lives.longinus_lucius.paths_ed:0-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲛⲉⲙⲡⲟⲩ**ⲁⲡⲉⲓⲗⲉ** ⲛⲁⲛ ϩⲟⲗⲱⲥ ⲛⲧⲅⲉϩⲉⲛⲛⲁ ⲧⲛⲙⲡϣⲁ ⲛⲣⲡⲙⲉⲉⲩⲉ ⲛⲛⲉⲛⲛⲟⲃⲉ ⲛⲟⲩⲟⲉⲓϣ ⲛⲓⲙ · ⲡⲟⲥⲟ ⲙⲁⲗⲗⲟⲛ ⲉⲣⲉⲧⲁⲓ ⲥⲃⲧⲱⲧ ⲛⲁⲛ ·",
      "english": "And even if we had not been threatened definitely with Gehenna, it would have been meet for us to keep our sins in our memory at all times, (and seeing that) this Gehenna is ready for us, how much more are we bound to keep our sins in remembrance?",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
