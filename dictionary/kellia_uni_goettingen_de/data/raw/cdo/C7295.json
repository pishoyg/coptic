  "examples": [
    {
      "coptic": "ⲛⲁⲓ**ϫⲫⲓⲟ** ⲙⲙⲱⲧⲉⲛ ⲁⲛ ⲉⲓⲥϧⲁⲓ ⲛⲛⲁⲓ ⲛⲱⲧⲉⲛ ⲁⲗⲗⲁ ⲉⲓϯⲥⲃⲱ ⲛⲱⲧⲉⲛ ⲙⲫⲣⲏϯ ⲛϩⲁⲛϣⲏⲣⲓ ⲙⲙⲉⲛⲣⲓⲧ ⲛⲧⲏⲓ .",
      "english": "I don't write these things to shame you, but to admonish you as my beloved children.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲟⲛ ⲉⲛϣⲁⲛϣⲱϥⲧ ⲛⲧⲛⲉⲓⲣⲉ ⲛⲟⲩⲙⲛⲧϣⲁϥⲧⲉ ϩⲛⲟⲩϫⲡⲓⲟ ⲙⲁⲣⲛ**ϫⲡⲓⲟ** ⲛⲛⲉⲛⲉⲣⲏⲩ",
      "english": "And if we stumble and act wickedly through a mistake, let us share blame with our companions",
      "source": "Abraham Our Father YA 551-54",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbya:42-47",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲓϫⲱ ⲙⲙⲟⲥ ⲉⲩ**ϫⲫⲓⲟ** ⲛⲱⲧⲉⲛ ⲡⲁⲓⲣⲏϯ ⲙⲙⲟⲛ ϩⲗⲓ ⲛⲥⲁⲃⲉ ϧⲉⲛⲑⲏⲛⲟⲩ ⲉⲟⲩⲟⲛϣϫⲟⲙ ⲙⲙⲟϥ ⲉⲉⲣⲇⲓⲁⲕⲣⲓⲛⲓⲛ ⲟⲩⲧⲉⲡⲉϥⲥⲟⲛ .",
      "english": "I say this to move you to shame. Isn't there even one wise man among you who would be able to decide between his brothers?",
      "source": "Bohairic 1 Corinthians 6 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:6",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲓⲙ ⲡⲉ ⲡⲁⲓ ⲉⲛⲧⲁϥϫⲓ ⲛⲉⲓ**ϫⲡⲓⲟ** ⲧⲏⲣⲟⲩ ·",
      "english": "And who was it who made all these complaints?",
      "source": "Homily on Matthew 20",
      "urn": "urn:cts:copticLit:psathanasius.matthew20.budge:1-56",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁϥⲥϧⲏⲧ ⲟⲩⲙⲏϣ ⲛⲥⲁϫⲓ ⲛⲁϥ ⲉⲡⲧⲁϩⲟ ⲉⲣⲁⲧϥ ⲛⲧⲉⲧⲉϥⲯⲩⲭⲏ ⲛⲉⲙⲡⲓⲛⲁϩϯ ⲛⲟⲣⲑⲟⲇⲟⲝⲟⲥ ⲛⲧⲉⲡϣⲏⲣⲓ ⲙⲫⲛⲟⲩϯ ⲙⲉⲛⲉⲛⲥⲱⲥ ⲁϥⲥϧⲁⲓ ⲟⲛ ⲉϣⲧⲉⲙⲉⲣⲕⲱⲗⲩⲉⲓⲛ ⲛⲛⲓⲣⲱⲙⲓ ⲛⲧⲉⲡⲓⲟⲩⲣⲟ ⲉⲧⲥⲁⲡϣⲱⲓ ⲉⲑⲣⲟⲩⲥⲓⲛⲓ ⲉⲃⲟⲗ ϩⲓⲧⲉⲙⲧⲉϥⲭⲱⲣⲁ ⲉⲩⲛⲏⲟⲩ ⲉⲑⲃⲉⲛⲟⲩⲉⲡⲓⲥⲕⲟⲡⲟⲥ ϫⲉⲛⲛⲉⲛⲓⲉⲕⲕⲗⲏⲥⲓⲁ ⲉⲣϣⲁϥⲉ ⲛⲧⲉⲕϫⲉⲙⲟⲩⲛⲓϣϯ ⲛ**ϫⲫⲓⲟ** ⲛⲁⲕ ϧⲁⲧⲉⲛⲫⲛⲟⲩϯ .",
      "english": "When he had written a multitude of words to strengthen his soul in the orthodox faith in the Son of God, he then wrote to him not to prevent the men of the king of the high country from passing through his territory, when they came about their bishops, so as not to leave the churches deserted, “so that you do not receive a great reprobation from God.”",
      "source": "Life of Isaac of Alexandria - part 3",
