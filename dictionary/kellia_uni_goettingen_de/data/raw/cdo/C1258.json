  "examples": [
    {
      "coptic": "ϫⲉⲟⲩⲏⲓ ϯⲃⲱ ⲛ**ⲕⲉⲛⲧⲉ** ⲥⲛⲁϯⲟⲩⲧⲁϩ ⲁⲛ ⲟⲩⲟϩ ⲛⲛⲉⲟⲩⲧⲁϩ ϣⲱⲡⲓ ϧⲉⲛϯⲃⲱ ⲛⲁⲗⲟⲗⲓ ⲉϥⲉϫⲉⲙⲉⲑⲛⲟⲩϫ ⲛϫⲉⲡϩⲱⲃ ⲛϯⲃⲱ ⲛϫⲱⲓⲧ ⲟⲩⲟϩ ⲛⲓⲙⲉϣϣⲟϯ ⲛⲛⲟⲩⲉⲣϧⲣⲉ ⲁⲩⲙⲟⲩⲛⲕ ⲛϫⲉⲛⲓⲉⲥⲱⲟⲩ ϫⲉⲙⲙⲟⲛϧⲣⲉ ⲛⲧⲱⲟⲩ ⲟⲩⲟϩ ⲙⲙⲟⲛⲉϩⲉ ϣⲟⲡ ϧⲉⲛⲡⲓⲟⲩⲛϩϥ ⲛⲧⲉⲡⲟⲩⲭⲱ ⲉⲃⲟⲗ .",
      "english": "For though the fig-tree shall bear no fruit, and there shall be no produce on the vines; the labour of the olive shall fail, and the fields shall produce no food: the sheep have failed from the pasture, and there are no oxen at the cribs;",
      "source": "Bohairic Habakkuk 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲙⲁⲣⲉⲡⲉⲓϣⲏⲛ ⲛⲧⲉⲓⲙⲓⲛⲉ ⲣⲁⲛⲁϥ ⲉⲛⲉϩ ⲙⲡⲟⲩⲟⲉⲓⲉ ⲉⲧⲏⲡ ⲉⲧⲡⲉ · ⲡⲁⲓ ⲉⲧϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲓⲉⲓ ⲉⲓϣⲓⲛⲉ ⲛⲥⲁⲕⲁⲣⲡⲟⲥ ⲛⲧⲉⲓⲃⲱ ⲛ**ⲕⲛⲧⲉ** · ⲁⲩⲱ ⲙⲡⲉⲓϩⲉ ⲉⲟⲩⲟⲛ ·",
      "english": "In this manner this tree will never give pleasure to the Husbandman Who appertaineth to heaven, Who spake saying, 'I came seeking for fruit on this fig-tree, and I have found none",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲃⲟⲗ ⲇⲉ ϧⲉⲛϯⲃⲱ ⲛ**ⲕⲉⲛⲧⲉ** ⲁⲣⲓⲉⲙⲓ ⲉϯⲡⲁⲣⲟⲃⲟⲗⲏ ⲉϣⲱⲡ ϩⲏⲇⲏ ⲛⲧⲉⲛⲉⲥϫⲁⲗ ϭⲛⲟⲛ ⲟⲩⲟϩ ⲛⲧⲉⲥϩⲓϫⲱⲃⲓ ⲉⲃⲟⲗ ϣⲁⲣⲉⲧⲉⲛⲉⲙⲓ ϫⲉϥϧⲉⲛⲧ ⲛϫⲉⲡⲓϣⲱⲙ .",
      "english": "Now from the fig tree, learn this parable. When the branch has now become tender, and puts forth its leaves, you know that the summer is near;",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧⲉⲣⲉϥⲣⲡⲙⲉⲉⲩⲉ ⲛϭⲓⲡⲉⲧⲣⲟⲥ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉϩⲣⲁⲃⲃⲉⲓ . ⲁⲛⲁⲩ ⲉⲧⲃⲱ ⲛ**ⲕⲛⲧⲉ** ⲛⲧⲁⲕⲥϩⲟⲩⲱⲣⲥ ⲛⲧⲁⲥϣⲟⲟⲩⲉ .",
      "english": "Peter, remembering, said to him, &apos;Rabbi, look! The fig tree which you cursed has withered away.&apos;",
      "source": "Mark Chaper 11",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:11",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁϥⲉⲣⲫⲙⲉⲩⲓ ⲛϫⲉⲡⲉⲧⲣⲟⲥ ⲡⲉϫⲁϥ ⲛⲁϥ ϫⲉⲣⲁⲃⲃⲓ ⲓⲥ ϯⲃⲱ ⲛ**ⲕⲉⲛⲧⲉ** ⲉⲧⲁⲕⲥⲁϩⲟⲩⲓ ⲉⲣⲟⲥ ⲁⲥϣⲱⲟⲩⲓ .",
      "english": "Peter, remembering, said to him, 'Rabbi, look! The fig tree which you cursed has withered away.'",
      "source": "Bohairic Gospel of Mark 11 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:11",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲧⲉⲣⲉϥⲛⲁⲩ ⲉⲩⲃⲱ ⲛⲕⲛⲧⲉ ⲙⲡⲟⲩⲉ ⲉⲣⲉϩⲉⲛϭⲱⲃⲉ ϩⲓⲱⲱⲥ ⲁϥⲃⲱⲕ ⲉⲣⲁⲧⲥ ϫⲉⲙⲉϣⲁⲕ ⲉϥⲉϭⲛⲗⲁⲁⲩ ⲛϩⲏⲧⲥ ⲁⲩⲱ ⲛⲧⲉⲣⲉϥⲉⲓ ⲙⲡϥϭⲛⲗⲁⲁⲩ ϩⲓⲱⲱⲥ ⲛⲥⲁϭⲱⲃⲉ ⲙⲙⲁⲧⲉ ⲛⲉⲡⲥⲏⲩ ⲅⲁⲣ ⲁⲛ ⲡⲉ ⲙⲡ**ⲕⲛⲧⲉ** .",
      "english": "Seeing a fig tree afar off having leaves, he came to see if perhaps he might find anything on it. When he came to it, he found nothing but leaves, for it was not the season for figs.",
      "source": "41_Mark_11",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:11",
