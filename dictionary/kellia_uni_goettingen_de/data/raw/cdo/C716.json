      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲉⲣϣⲁⲛ**ⲟⲩⲥⲟⲛ ⲉⲓ ϣⲁⲣⲟⲕ ⲣⲁϣⲉ ⲛⲙⲙⲁϥ ·",
      "english": "If a brother come to thee rejoice with him.",
