  "examples": [
    {
      "coptic": "ϧⲉⲛⲫⲁⲓ ⲅⲁⲣ ⲁϥⲟⲩⲱⲛϩ ⲉⲃⲟⲗ ⲉϥⲉⲣⲟⲩⲱⲓⲛⲓ ⲛⲧⲁⲓϧⲉ ⲧⲏⲣⲟⲩ ϩⲱⲥⲧⲉ ⲛⲥⲉⲧⲉⲛϩⲟⲩⲧϥ ⲉⲁⲙⲟⲛⲓ ⲛⲛⲓϩⲓⲏⲃ ⲛⲧⲉϯⲉⲕⲕⲗⲏⲥⲓⲁ ⲛⲧⲉϯⲛⲓϣϯ ⲙⲡⲟⲗⲓⲥ ⲣⲁⲕⲟϯ ⲛⲉⲙⲭⲏⲙⲓ ⲧⲏⲣϥ ⲙⲁⲗⲗⲟⲛ ⲇⲉ ⲛⲉⲙⲥⲁⲡⲉⲥⲏⲧ ⲛⲧ**ⲫⲉ** ⲧⲏⲣⲥ .",
      "english": "In this he manifested himself with brilliance of all kinds, so that he was entrusted with the care of the lambs of the church of the great city of Alexandria, of all Egypt and even under the whole heaven.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧϭⲓⲛⲣϩⲏⲃⲉ ⲛⲧ**ⲡⲉ** ·",
      "english": "the lamentation of heaven",
      "source": "Proclus Homily 23 On the Nativity in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily23.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲑⲃⲉⲡⲓⲉϩⲟⲟⲩ ⲇⲉ ⲉⲧⲉⲙⲙⲁⲩ ⲛⲉⲙϯⲟⲩⲛⲟⲩ ⲙⲙⲟⲛ ϩⲗⲓ ⲉⲙⲓ ⲉⲣⲱⲟⲩ ⲟⲩⲇⲉ ⲁⲅⲅⲉⲗⲟⲥ ϧⲉⲛⲧ**ⲫⲉ** ⲟⲩⲇⲉ ⲡϣⲏⲣⲓ ⲉⲃⲏⲗ ⲉⲫⲓⲱⲧ .",
      "english": "But of that day or that hour no one knows, not even the angels in heaven, nor the Son, but only the Father.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲁⲧⲟⲩⲱ ⲅⲁⲣ ⲛⲁⲕ **ⲡⲉ** ⲡⲙⲧⲟⲛ ⲛϣⲁⲉⲛⲉϩ .",
      "english": "for there is unceasing rest for you forever.'",
      "source": "Apophthegmata Patrum Sahidic 030",
      "urn": "urn:cts:copticLit:ap.30.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲟⲧⲁⲛ ⲅⲁⲣ ⲁⲩϣⲁⲛⲧⲱⲟⲩⲛⲟⲩ ϧⲉⲛⲛⲏ ⲉⲧⲙⲱⲟⲩⲧ ⲟⲩⲇⲉ ⲙⲡⲁⲩϭⲓ ⲟⲩⲇⲉ ⲙⲡⲁⲩϭⲓⲧⲟⲩ ⲁⲗⲗⲁ ⲁⲩⲙⲫⲣⲏϯ ⲛⲛⲓⲁⲅⲅⲉⲗⲟⲥ ϧⲉⲛⲛⲓ**ⲫⲏⲟⲩⲓ** .",
      "english": "For when they will rise from the dead, they neither marry, nor are given in marriage, but are like angels in heaven.",
