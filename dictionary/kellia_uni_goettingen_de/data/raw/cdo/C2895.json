  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲑⲟⲕ ϥⲁⲓ ⲙⲡⲉⲕϣⲃⲱⲧ ⲉⲡϣⲱⲓ ⲟⲩⲟϩ ⲥⲟⲩⲧⲉⲛ ⲧⲉⲕϫⲓϫ ⲉⲃⲟⲗ ⲉϫⲉⲛⲫⲓⲟⲙ ⲟⲩⲟϩ **ⲫⲟⲣϫ**ϥ ⲟⲩⲟϩ ⲙⲁⲣⲟⲩⲓ ⲉϧⲟⲩⲛ ⲛϫⲉⲛⲉⲛϣⲏⲣⲓ ⲙⲡⲓⲥⲣⲁⲏⲗ ϧⲉⲛⲧⲙⲏϯ ⲙⲫⲓⲟⲙ ⲉⲡⲉⲧϣⲟⲩⲱⲟⲩ",
      "english": "And do thou lift up thy rod, and stretch forth thy hand over the sea, and divide it, and let the children of Israel enter into the midst of the sea on the dry land.",
      "source": "02_Exodus_14",
      "urn": "urn:cts:copticLit:ot.exod.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲓⲏⲥⲟⲩⲥ ⲇⲉ ⲁϥ**ⲡⲱⲣϣ** ⲛⲛⲉϥϭⲓϫ ⲉⲃⲟⲗ ⲙⲛⲁⲡⲁ ⲃⲓⲕⲧⲱⲣ ·",
      "english": "And Jesus and Apa Victor spread out their hands,",
      "source": "Martyrdom of Victor part 6",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:49-66",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉϥⲉⲛⲁⲩ ⲛϫⲉⲡⲓⲟⲩⲏⲃ ⲉⲡⲓϭⲟϩ ϧⲉⲛⲡⲓⲉϩⲟⲟⲩ ⲙⲙⲁϩⲍ ⲟⲩⲟϩ ϩⲏⲡⲡⲉ ⲡⲓϭⲟϩ ⲉϥⲟϩⲓ ⲉⲣⲁⲧϥ ⲙⲡⲉϥⲟⲩⲱⲧⲉⲃ ⲁⲛ ⲛϫⲉⲡⲓϭⲟϩ ϧⲉⲛⲡⲓϣⲁⲣ ⲉϥⲉ**ⲫⲟⲣϫ**ϥ ⲉⲃⲟⲗ ⲛϫⲉⲡⲓⲟⲩⲏⲃ ⲛⲍ ⲛⲉϩⲟⲟⲩ ⲙⲡⲓⲙⲁϩ ⲥⲟⲡ ⲃ",
      "english": "and the priest shall look on the spot the seventh day; and, behold, if the spot remains before him, if the spot has not spread in the skin, then the priest shall separate him the second time seven days.",
      "source": "03_Leviticus_13",
      "urn": "urn:cts:copticLit:ot.lev.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥ**ⲡⲱⲣϣ** ϩⲁⲣⲟϥ ⲛⲁⲡⲁ ⲃⲓⲕⲧⲱⲣ ⲛⲧⲉϥⲥⲧⲟⲗⲏ ⲉⲧⲟⲩⲁⲁⲃ ·",
      "english": "and spread out his holy apparel over Apa Victor,",
