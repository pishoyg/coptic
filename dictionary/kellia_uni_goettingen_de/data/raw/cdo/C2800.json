  "examples": [
    {
      "coptic": "**ⲡⲁⲓ** ⲣⲏϯ ⲁϥⲓ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲛⲉϥⲓⲟϯ ⲁϥϩⲱⲗ ⲉⲡϣⲁϥⲉ .",
      "english": "Thus he left his parents and went into the desert.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲡⲁⲓ** ⲛⲟⲩⲟⲥⲉ ⲁⲛ ⲡⲉ .",
      "english": "This is not damaging.",
      "source": "Apophthegmata Patrum Sahidic 027: Pistamon 1",
      "urn": "urn:cts:copticLit:ap.27.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲱⲧⲉⲙ ⲛⲧⲁϫⲱ ⲉⲣⲱⲧⲉⲛ ⲙ**ⲡⲁⲓ**ⲕⲉϩⲱⲃ ⲛϣⲫⲏⲣⲓ .",
      "english": "Listen, let me tell you also this wonderful thing.",
      "source": "Life of Isaac of Alexandria - part 3",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:42-48",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲛⲁⲓ** ⲇⲉ ⲛⲉⲣⲉϣⲟⲙⲛⲧ ⲛϣⲏⲣⲉ ϣⲟⲟⲡ ⲛⲁⲩ ·",
      "english": "And they had three children.",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲧⲁⲩϭⲛⲟⲩϥ ϫⲉⲁⲛ ⲁⲕⲥⲱⲧⲉⲙ ⲉ**ⲧⲁⲓ**ⲥⲙⲏ ⲉⲧⲁⲥⲓ ⲉⲃⲟⲗ ϧⲉⲛⲧⲫⲉ ϯⲛⲟⲩ ;",
      "english": "They turned to him and asked, ‘Did you hear the same voice from heaven?’",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "**ⲧⲁⲓ** ⲧⲉ ⲧⲙⲛⲧϣⲙⲙⲟ · ⲻ",
      "english": "This is being a stranger.'",
      "source": "Apophthegmata Patrum Sahidic 116: Pistus 01",
      "urn": "urn:cts:copticLit:ap.116.monbeg",
      "dialect": "sahidic"
    }
  ],
