  "examples": [
    {
      "coptic": "ⲉⲣϣⲁⲛⲡⲉⲕⲉⲓⲱⲧ ⲉⲓ ⲉϩⲟⲩⲛ ⲙⲡⲛⲁⲩ ⲙ**ⲙⲉⲉⲣⲉ** ϯⲛⲁⲧⲣⲉϥⲧⲁⲁϥ ⲛⲁⲕ ϫⲉⲕⲁⲥ ⲉⲕⲛⲁⲉⲓⲣⲉ ⲙⲡⲉⲕⲟⲩⲱϣ ⲛϩⲏⲧϥ ⲙⲛⲛⲉⲕϣⲃⲏⲣ ·",
      "english": "When thy father cometh into the house at the hour of noon I will make him to give it (i.e., money) to thee, so that thou and thy companions mayest do what thou wishest therewith.'",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲃⲗⲗⲏ ⲛⲁⲙⲉ ⲉⲧϫⲟⲡϫⲡ ⲙ**ⲙⲉⲉⲣⲉ** ⲛⲧϩⲉ ⲛⲛⲉⲧϩⲛⲧⲡⲁϣⲉ ⲛⲧⲉⲩϣⲏ · ⲁⲩⲱ ⲛⲧϩⲉ ⲛⲛⲓⲃⲗⲗⲉ , ⲉⲧⲉⲙⲛⲃⲁⲗ ⲙⲙⲟⲟⲩ ·",
      "english": "Oh you truly blind one who gropes in daylight like those who are in midnight and like those blind ones, who have no eyes.",
      "source": "To Aphthonia",
      "urn": "urn:cts:copticLit:besa.aphthonia.monbba",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϫⲓⲥ ⲉⲣⲟⲛ ⲱ ⲧⲡⲉ · ϫⲉⲉⲧⲃⲉⲟⲩ ⲁⲣϯϩⲓⲱⲱⲧⲉ ⲛⲟⲩⲕⲁⲕⲉ ⲙⲡⲛⲁⲩ ⲙ**ⲙⲉⲉⲣⲉ** ·",
      "english": "Tell us, O Heaven: For what reason didst thou clothe thyself with darkness at the hour of noon?",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    }
