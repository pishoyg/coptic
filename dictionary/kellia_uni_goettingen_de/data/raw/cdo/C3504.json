  "examples": [
    {
      "coptic": "ⲙⲡⲛⲁⲩ ⲟⲛ ⲉϣⲁⲓⲣⲡⲙⲉⲉⲩⲉ ⲙⲡⲉ**ⲥⲗⲟϭⲗϭ** ⲙⲡⲉⲥⲥⲱⲙⲁ ·",
      "english": "Whensoever I remembered the softness of her body,",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 2",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:24-42",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ϯⲛⲁⲙⲟⲟϣⲉ ϩⲁⲧⲉϥϩⲏ ⲧⲁ**ⲥⲗⲟϭⲗϭ** ⲛⲛⲧⲟⲟⲩ ⲧⲁⲟⲩⲱϣϥ ⲛⲛⲣⲟ ⲛϩⲟⲙⲛⲧ ⲧⲁϩⲱⲣϥ ⲛⲛⲙⲟⲭⲗⲟⲥ ⲙⲡⲉⲛⲓⲡⲉ",
      "english": "I will go before thee, and will level mountains: I will break to pieces brazen doors, and burst iron bars.",
      "source": "Isaiah 45",
      "urn": "urn:cts:copticLit:ot.isa.coptot:45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲣⲁ ⲙⲡⲉⲡⲉ**ⲥⲗⲟϭⲗϭ** ⲙⲡⲉⲥⲥⲱⲙⲁ · ⲉⲧϭⲏⲛ ϯϩⲃⲁ ⲙⲡⲉⲕⲗⲟⲅⲓⲥⲙⲟⲥ · ⲉⲃⲟⲗ ϫⲉⲛⲧⲕⲟⲩϣⲏⲣⲉ ϣⲏⲙ · ⲙⲡⲛⲁⲩ ⲟⲛ ⲉⲕϣⲁϫⲉ ⲛⲙⲙⲁⲥ ⲉⲙⲛⲣⲱⲙⲉ ϩⲁϩⲧⲏⲕ ·",
      "english": "Did not the tender softness of her body cause thine understanding to totter? For thou wast, after all, only a youth. When thou didst talk with her and there was none present with thee, did not he who shooteth arrows of evil shoot arrows into thee?",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 2",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:24-42",
      "dialect": "sahidic"
    }
