  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲡⲁⲣⲭⲱⲛ ⲉⲧϣⲟⲟⲡ ϩⲙⲡⲙⲉϩϯⲟⲩ ⲛⲧⲁⲙⲉⲓⲟⲛ ⲟⲩ ϩⲟ ⲙⲙⲁⲥⲉ ⲛ**ⲕⲁⲙⲉ** ⲡⲉ ⲡⲉϥⲁⲩⲑⲉⲛⲧⲓⲕⲟⲛ ⲛϩⲟ ⲡⲁⲓ ⲉϣⲁⲩⲙⲟⲩⲧⲉ ⲉⲣⲟϥ ϩⲙⲡⲉⲩⲧⲟⲡⲟⲥ ϫⲉⲙⲁⲣⲭⲟⲩⲣ · ⲁⲩⲱ ⲡⲁⲣⲭⲱⲛ ⲉⲧϣⲟⲟⲡ ϩⲙⲡⲙⲉϩⲥⲟⲟⲩ ⲛⲧⲁⲙⲉⲓⲟⲛ · ⲟⲩ ϩⲟ ⲛⲣⲓⲣ ⲛⲧⲟⲟⲩ ⲡⲉ ⲡⲉϥϩⲟ ⲛⲁⲩⲑⲉⲛⲧⲏⲥ · ⲡⲁⲓ ⲉϣⲁⲩⲙⲟⲩⲧⲉ ⲉⲣⲟϥ ϩⲙⲡⲉⲩⲧⲟⲡⲟⲥ ϫⲉⲗⲁⲙⲭⲁⲙⲱⲣ ·",
      "english": "“And the ruler who is in the fifth dungeon,--a black bull's face is his authentic face. This [is] he who is called in his region 'Marchūr.' And the ruler who is in the sixth dungeon,--a wild boar's face is his authentic face. This [is] he who is called in his region 'Lamchamōr.”",
      "source": "Pistis Sophia Book 3 Part 5",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:100-108",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲧⲉⲣⲉϥⲟⲩⲱⲛ ⲇⲉ ⲛⲧⲙⲉϩϣⲟⲙⲧⲉ ⲛⲥⲫⲣⲁⲅⲓⲥ ⲁⲓⲥⲱⲧⲙ ⲉⲡⲙⲉϩϣⲟⲙⲛⲧ ⲛⲍⲱⲟⲛ ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲙⲟⲩ . ⲁⲩⲱ ⲉⲓⲥ ⲟⲩϩⲧⲟ ⲛ**ⲕⲁⲙⲏ** ⲁⲩⲱ ⲡⲉⲧⲧⲁⲗⲏⲩ ⲉⲣⲟϥ ⲉⲟⲩⲛⲟⲩⲙⲁϣⲉ ϩⲛⲧⲉϥϭⲓϫ .",
      "english": "When he opened the third seal, I heard the third living creature saying, 'Come and see!' And behold, a black horse, and he who sat on it had a balance in his hand.",
      "source": "66_Revelation_6",
      "urn": "urn:cts:copticLit:nt.rev.sahidica:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲁⲛⲅⲟⲩ**ⲕⲁⲙⲏ** ⲁⲗⲗⲁ ⲛⲉⲥⲱⲉⲓ ϩⲛⲛϣⲉⲉⲣⲉ ⲙⲡⲓⲥⲣⲁⲏⲗ ⲛⲧϩⲉ ⲛⲛⲉⲥⲕⲏⲛⲏ ⲙⲉⲛ ⲛⲕⲏⲇⲁⲣ ⲛⲧϩⲉ ⲇⲉ ⲛⲛⲇⲉⲣⲣⲓⲥ ⲛⲥⲟⲗⲟⲙⲱⲛ",
      "english": "I am black, but beautiful, ye daughters of Jerusalem, as the tents of Kedar, as the curtains of Solomon.",
      "source": "Song of Solomon 1",
