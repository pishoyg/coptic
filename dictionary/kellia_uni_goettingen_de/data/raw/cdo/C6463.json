  "examples": [
    {
      "coptic": "ⲁϥⲓ ⲇⲉ ϩⲱϥ ⲛϫⲉⲥⲓⲙⲱⲛ ⲡⲉⲧⲣⲟⲥ ⲉϥⲙⲟϣⲓ ⲛⲥⲱϥ ⲟⲩⲟϩ ⲁϥϩⲱⲗ ⲉϧⲟⲩⲛ ⲉⲡⲓⲙϩⲁⲩ ⲟⲩⲟϩ ⲁϥⲛⲁⲩ ⲉⲛⲓ**ϩⲃⲱⲥ** ⲉⲩⲭⲏ ⲉϧⲣⲏⲓ",
      "english": "Then Simon Peter came, following him, and entered into the tomb. He saw the linen cloths lying,",
      "source": "04_John_20",
      "urn": "urn:cts:copticLit:nt.john.bohairic:20",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲉⲣϥϫⲉⲛⲁⲓ ⲇⲉ · ⲁϥⲛⲕⲟⲧⲕ · ⲁⲩⲱ ⲛⲧⲉⲩⲛⲟⲩ · ⲁⲛⲉ**ϩⲃⲟⲟⲥ** · ϭⲗⲟⲙⲗⲙ ⲉϩⲟⲩⲛ ⲉⲣⲟϥ ⲛⲕⲉⲥⲟⲡ",
      "english": "When he said these things, he lay down, and his clothing immediately wrapped itself around him once more.",
      "source": "Life of Apa Phib part 2",
      "urn": "urn:cts:copticLit:lives.phib.paths_ed:11-18",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉⲧⲣⲟⲥ ⲇⲉ ⲁϥⲧⲱⲛϥ ⲁϥϭⲟϫⲓ ⲉⲡⲓⲙϩⲁⲩ ⲟⲩⲟϩ ⲉⲧⲁϥⲥⲟⲙⲥ ⲉϧⲟⲩⲛ ⲁϥⲛⲁⲩ ⲉⲛⲓ**ϩⲃⲱⲥ** ⲙⲙⲁⲩⲁⲧⲟⲩ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ⲉⲡⲉϥⲏⲓ ⲉϥⲉⲣϣⲫⲏⲣⲓ ⲙⲫⲏ ⲉⲧⲁϥϣⲱⲡⲓ .",
      "english": "But Peter got up and ran to the tomb. Stooping and looking in, he saw the strips of linen lying by themselves, and he departed to his home, wondering what had happened.",
      "source": "03_Luke_24",
      "urn": "urn:cts:copticLit:nt.luke.bohairic:24",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲁϥϯ ϩⲓⲱⲱϥ · ⲛⲟⲩⲕⲟⲩⲓ ⲛ**ϩⲃⲟⲟⲥ** ⲉⲧⲃⲉⲡⲛⲟⲩⲧⲉ · ϫⲉⲛϥⲕⲏⲕⲁϩⲏⲩ ⲅⲁⲣ ⲡⲉ ⲛⲧⲉⲩϣⲏ ⲙⲛⲡⲉϩⲟⲟⲩ · ⲟⲩϩⲟⲟⲩ ⲇⲉ ⲉⲃⲟⲗ ϩⲛⲟⲩϩⲟⲟⲩ ·",
      "english": "And he gave him a little clothing to put on for God's sake, for he was naked by day and by night.",
      "source": "The Life of John the Kalybites part 2",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:46-90",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϫⲉⲁⲥⲉⲣⲡⲟⲣⲛⲉⲩⲓⲛ ⲛϫⲉⲧⲟⲩⲙⲁⲩ ⲟⲩⲟϩ ⲁⲥϭⲓϣⲓⲡⲓ ⲛϫⲉⲑⲏⲉⲧⲁⲥⲙⲁⲥⲟⲩ ϫⲉⲁⲥϫⲟⲥ ϫⲉϯⲛⲁϣⲉⲛⲏⲓ ⲛⲧⲁⲙⲟϣⲓ ⲥⲁⲙⲉⲛϩⲉ ⲛⲛⲁⲙⲉⲛⲣⲁϯ ⲛⲏⲉⲧϯ ⲛⲏⲓ ⲙⲡⲁⲱⲓⲕ ⲛⲉⲙⲡⲁⲙⲱⲟⲩ ⲛⲉⲙⲛⲁ**ϩⲃⲱⲥ** ⲛⲉⲙⲛⲁϣⲉⲛⲧⲱ ⲛⲉⲙⲡⲁⲛⲉϩ ⲛⲉⲙϩⲱⲃ ⲛⲓⲃⲉⲛ ⲉⲧⲑⲏϣ ⲛⲏⲓ .",
      "english": "And their mother went a-whoring: she that bore them disgraced them: for she said, I will go after my lovers, that give me my bread and my water, and my garments, and my linen clothes, my oil and my necessaries.",
      "source": "28_Osee_02",
      "urn": "urn:cts:copticLit:ot.hos.bohairic_ed:02",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥϥⲟϭϥ ⲇⲉ ⲉϩⲣⲁⲓ ⲛϭⲓⲡⲕⲟⲩⲓ ⲛⲥⲟⲛ ⲍⲁⲭⲁⲣⲓⲁⲥ · ⲛⲧⲁϥⲙⲟⲩ ⲁϥϩⲙⲟⲟⲥ ⲁⲩⲱ ⲁⲛⲉ**ϩⲃⲟⲟⲥ** ⲃⲟⲣⲃⲣ ⲉⲃⲟⲗ ⲙⲙⲟϥ ·",
      "english": "And the young brother Zachariah, who had died, leapt up and sat down, and the clothing unravelled off him.",
      "source": "Life of Apa Phib part 2",
      "urn": "urn:cts:copticLit:lives.phib.paths_ed:11-18",
      "dialect": "sahidic"
