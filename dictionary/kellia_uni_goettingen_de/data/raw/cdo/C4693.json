  "examples": [
    {
      "coptic": "ⲟⲩⲟϩ ϯⲃⲁⲕⲓ ⲧⲏⲣⲥ ⲁⲥ**ⲑⲱⲟⲩϯ** ϩⲓⲣⲉⲛⲡⲓⲣⲟ .",
      "english": "All the city was gathered together at the door.",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁϥ**ⲧⲟⲟⲩⲧⲉ** ⲙⲡⲉϥⲗⲁⲟⲥ ⲉϩⲟⲩⲛ ⲉⲧⲥⲏϥⲉ ⲁⲩⲱ ⲁϥⲟⲃϣϥ ⲉⲧⲉϥⲕⲗⲏⲣⲟⲛⲟⲙⲓⲁ",
      "english": "And he gave his people to the sword; and disdained his inheritance.",
      "source": "Psalms 77",
      "urn": "urn:cts:copticLit:ot.pss.coptot:77",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲥⲱ ⲛⲟⲩϣⲱϣ ⲉϥⲟϣ ⲉⲃⲟⲗ ϧⲉⲛⲟⲩⲙⲱⲟⲩ ⲟⲩⲟϩ ⲛⲑⲟⲕ ϩⲱⲕ ⲡⲓϩⲏⲧ ⲕⲓⲙ ⲟⲩⲟϩ ⲙⲟⲛⲙⲉⲛ ϫⲉⲁϥⲕⲱϯ ⲉⲣⲟⲕ ⲛϫⲉⲡⲓⲁⲫⲟⲧ ⲛⲧⲉⲑⲟⲩⲓⲛⲁⲙ ⲙⲡϭⲟⲉⲓⲥ ⲟⲩⲟϩ ⲁϥ**ⲑⲱⲟⲩϯ** ⲛϫⲉⲟⲩϣⲱϣ ⲉϫⲉⲛⲡⲉⲕⲱⲟⲩ .",
      "english": "Drink thou also thy fill of disgrace instead of glory: shake, O heart, and quake, the cup of the right hand of the Lord has come round upon thee, and dishonour has gathered upon thy glory.",
      "source": "Bohairic Habakkuk 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲥⲩⲛⲧⲉⲗⲓⲁ ⲁϥⲥⲟⲕⲥ ⲉⲡϣⲱⲓ ϧⲉⲛⲧⲉϥⲱⲓⲙⲓ ⲟⲩⲟϩ ⲁϥⲱϣϯ ⲙⲙⲟϥ ϧⲉⲛⲡⲉϥϣⲛⲉϩⲓⲟⲩⲓ ⲟⲩⲟϩ ⲁϥ**ⲑⲟⲩⲱⲧ**ϥ ϧⲉⲛⲧⲉϥⲁⲃⲱ ⲉⲑⲃⲉⲫⲁⲓ ⲉϥⲉⲟⲩⲛⲟϥ ⲟⲩⲟϩ ⲉϥⲉⲣⲁϣⲓ ⲛϫⲉⲡⲉϥϩⲏⲧ .",
      "english": "He has brought up destruction with a hook, and drawn one with a casting net, and caught another in his drags: therefore shall his heart rejoice and be glad.",
      "source": "Bohairic Habakkuk 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:1",
      "dialect": "bohairic"
    }
