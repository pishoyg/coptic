  "examples": [
    {
      "coptic": "ϫⲉⲟⲩⲏⲓ ϯⲙⲉⲧⲁⲥⲉⲃⲏⲥ ⲛⲧⲉⲡⲓⲗⲓⲃⲁⲛⲟⲥ ⲉⲥⲉϩⲟⲃⲥⲕ ⲟⲩⲟϩ ϯⲧⲁⲗⲉⲡⲱⲣⲓⲁ ⲛⲧⲉⲛⲓ**ⲑⲏⲣⲓⲟⲛ** ⲉⲥⲉⲑⲣⲉⲕⲛⲟⲩϣⲡ ⲉⲑⲃⲉϩⲁⲛⲥⲛⲟϥ ⲛⲧⲉϩⲁⲛⲣⲱⲙⲓ ⲛⲉⲙϯⲙⲉⲧⲁⲥⲉⲃⲏⲥ ⲛⲧⲉⲡⲕⲁϩⲓ ⲛⲧⲉϯⲃⲁⲕⲓ ⲛⲉⲙⲛⲏ ⲧⲏⲣⲟⲩ ⲉⲧϣⲟⲡ ⲛϧⲏⲧⲥ .",
      "english": "For the ungodliness of Libanus shall cover thee, and distress because of wild beasts shall dismay thee, because of the blood of men, and the sins of the land and city, and of all that dwell in it.",
      "source": "Bohairic Habakkuk 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲟϥ ⲇⲉ ⲡⲉϫⲁϥ ⲛⲁⲓ ϫⲉⲟⲛⲛⲟⲫⲣⲓⲟⲥ ⲡⲉ ⲡⲁⲣⲁⲛ · ⲁⲩⲱ ⲉⲓⲥ ⲥⲉ ⲛⲣⲟⲙⲡⲉ ϯϣⲟⲟⲡ ϩⲛϯⲉⲣⲏⲙⲓⲁ · ⲉⲓⲙⲟⲟϣⲉ ϩⲛⲛⲧⲟⲟⲩ ⲛⲧϩⲉ ⲛⲛⲉ**ⲑⲏⲣⲓⲟⲛ** · ⲁⲩⲱ ⲙⲡⲓⲛⲁⲩ ⲉⲣⲱⲙⲉ ⲉⲓⲥⲟⲟⲩⲛ ⲙⲙⲟϥ ·",
      "english": "And he said unto me, 'Onnophrios is my name. And behold, I have lived in this desert for sixty years. I wander about in the mountains like the wild animals, and I never see any man who recognizeth me.",
      "source": "Life of Onnophrius part 1",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲁϥⲭⲏ ⲡⲉ ϩⲓⲡϣⲁϥⲉ ⲛⲙ ⲛⲉϩⲟⲟⲩ ⲛⲉⲙⲛⲉϫⲱⲣϩ ⲉϥⲉⲣⲡⲓⲣⲁⲍⲓⲛ ⲙⲙⲟϥ ⲛϫⲉⲡⲥⲁⲧⲁⲛⲁⲥ ⲟⲩⲟϩ ⲛⲁϥⲭⲏ ⲡⲉ ⲛⲉⲙⲛⲓ**ⲑⲏⲣⲓⲟⲛ** ⲟⲩⲟϩ ⲛⲓⲁⲅⲅⲉⲗⲟⲥ ⲛⲁⲩϣⲉⲙϣⲓ ⲙⲙⲟϥ .",
      "english": "He was there in the wilderness forty days tempted by Satan. He was with the wild animals; and the angels were serving him.",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲣϣⲁⲛⲛⲉ**ⲑⲏⲣⲓⲟⲛ** · ⲟⲩⲱⲙ ⲙⲡⲣⲱⲙⲉ ⲙⲉⲩϩⲉ ⲉⲣⲟϥ ⲛⲕⲉⲥⲟⲡ ⲉⲧⲣⲉϥⲙⲓϣⲉ ⲛⲙⲙⲁϥ ·",
      "english": "When the wild beast devoureth a man the man is no longer forthcoming to fight with him again.",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲥϫⲉϧⲉⲛⲟⲩⲙⲉⲧⲣⲱⲙⲓ ⲁⲓϯ ⲟⲩⲃⲉⲡⲓ**ⲑⲏⲣⲓⲟⲛ** ϧⲉⲛⲉⲫⲉⲥⲟⲥ ⲟⲩ ⲡⲉ ⲡⲁϩⲏⲟⲩ ⲓⲥϫⲉⲛⲓⲣⲉϥⲙⲱⲟⲩⲧ ⲛⲁⲧⲱⲟⲩⲛⲟⲩ ⲁⲛ ⲙⲁⲣⲉⲛⲟⲩⲱⲙ ⲟⲩⲟϩ ⲛⲧⲉⲛⲥⲱ ⲣⲁⲥϯ ⲅⲁⲣ ⲧⲉⲛⲛⲁⲙⲟⲩ .",
      "english": "If I fought with animals at Ephesus for human purposes, what does it profit me? If the dead are not raised, then 'let us eat and drink, for tomorrow we die.'",
      "source": "Bohairic 1 Corinthians 15 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:15",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲉϥϩⲛⲧⲉⲣⲏⲙⲟⲥ ⲛϩⲙⲉ ⲛϩⲟⲟⲩ ⲉⲣⲉⲡⲥⲁⲧⲁⲛⲁⲥ ⲡⲉⲓⲣⲁⲍⲉ ⲙⲙⲟϥ ⲉϥϣⲟⲟⲡ ⲙⲛⲛⲉ**ⲑⲏⲣⲓⲟⲛ** . ⲁⲩⲱ ⲛⲁⲅⲅⲉⲗⲟⲥ ⲛⲉⲩⲇⲓⲁⲕⲟⲛⲓ ⲛⲁϥ .",
