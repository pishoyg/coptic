  "examples": [
    {
      "coptic": "ϩⲱⲃ ⲛⲓⲙ ⲉⲝⲉⲥⲧⲉⲓ ⲛⲁⲓ . ⲁⲗⲗⲁ ϩⲱⲃ ⲛⲓⲙ ⲣⲛⲟϥⲣⲉ ⲁⲛ . ϩⲱⲃ ⲛⲓⲙ ⲉⲝⲉⲥⲧⲉⲓ ⲛⲁⲓ ⲁⲗⲗⲁ ⲛϯⲛⲁⲕⲁ ⲗⲁⲁⲩ ⲁⲛ ⲉ**ⲣϫⲟⲉⲓⲥ** ⲉⲣⲟⲓ .",
      "english": "All things are lawful for me,&apos; but not all things are expedient. &apos;All things are lawful for me,&apos; but I will not be brought under the power of anything.",
      "source": "46_1 Corinthians_6",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲣⲧⲣⲉⲟⲩϭⲱⲛⲧ **ⲣϫⲟⲉⲓⲥ** ⲉϫⲱⲕ ⲙⲛⲟⲩⲗⲩⲡⲏ · ⲏ ϭⲉⲗⲁⲁⲩ ⲙⲡⲁⲑⲟⲥ ⲛⲅⲧⲁⲩⲉϩⲉⲛϣⲁϫⲉ ⲛⲉⲡⲣⲁ · ⲁϫⲛⲙⲟⲩϣⲧ",
      "english": "Let neither anger have dominion over thee, nor grief, nor any feeling of passion whatsoever; and utter not vain words without consideration.",
