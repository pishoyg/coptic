  "examples": [
    {
      "coptic": "ⲁϥϫⲟⲟⲥ ⲛϭⲓⲁⲡⲁ ⲃⲏⲥⲁⲣⲓⲟⲛ , ϫⲉⲁⲓⲣ**ϩⲙⲉ** ⲛⲟⲩϣⲏ ϩⲛⲧⲙⲏⲧⲉ ⲛⲟⲩϩⲣⲁⲙⲛⲟⲥ ⲉⲓⲁϩⲉⲣⲁⲧ ⲙⲡⲓⲛⲕⲟⲧⲕ ·ⲻ",
      "english": "Apa Bessarion said, 'I spent forty nights in the middle of a thornbush, standing without lying down.'",
      "source": "Apophthegmata Patrum Sahidic 033",
      "urn": "urn:cts:copticLit:ap.33.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲉϥϩⲛⲧⲉⲣⲏⲙⲟⲥ ⲛ**ϩⲙⲉ** ⲛϩⲟⲟⲩ ⲉⲣⲉⲡⲥⲁⲧⲁⲛⲁⲥ ⲡⲉⲓⲣⲁⲍⲉ ⲙⲙⲟϥ ⲉϥϣⲟⲟⲡ ⲙⲛⲛⲉⲑⲏⲣⲓⲟⲛ . ⲁⲩⲱ ⲛⲁⲅⲅⲉⲗⲟⲥ ⲛⲉⲩⲇⲓⲁⲕⲟⲛⲓ ⲛⲁϥ .",
      "english": "He was there in the wilderness forty days tempted by Satan. He was with the wild animals; and the angels were serving him.",
      "source": "Mark Chapter 1",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:1",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥϫⲓ ⲙⲡⲟⲙⲉ ⲛⲧⲟⲟⲧϥ ⲙⲡⲁⲅⲅⲉⲗⲟⲥ ⲁϥⲧⲁⲙⲓⲟ ⲛⲁⲇⲁⲙ · ⲕⲁⲧⲁⲡⲉⲛⲉⲓⲛⲉ ⲙⲛⲧⲉⲛϩⲓⲕⲱⲛ · ⲁϥⲕⲁⲁϥ ⲉϥⲛⲏϫ ⲉⲃⲟⲗ ⲛ**ϩⲙⲉ** ⲛϩⲟⲟⲩ ⲙⲛϩⲙⲉ ⲛⲟⲩϣⲏ ⲙⲡⲉϥϯⲡⲛⲉⲩⲙⲁ ⲉⲣⲟϥ ·",
      "english": "And He took the clay from the hand of the angel, and made Adam according to Our image and likeness, and He left him lying for forty days and forty nights without putting breath into him.",
      "source": "Discourse on Abbaton part 1",
      "urn": "urn:cts:copticLit:pstimothy.abbaton.budge:1-21",
