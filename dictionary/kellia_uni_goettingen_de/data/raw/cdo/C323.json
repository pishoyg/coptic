  "examples": [
    {
      "coptic": "ϫⲉⲟⲩⲏⲓ ϯⲃⲱ ⲛⲕⲉⲛⲧⲉ ⲥⲛⲁϯⲟⲩⲧⲁϩ ⲁⲛ ⲟⲩⲟϩ ⲛⲛⲉⲟⲩⲧⲁϩ ϣⲱⲡⲓ ϧⲉⲛϯⲃⲱ ⲛⲁⲗⲟⲗⲓ ⲉϥⲉϫⲉⲙⲉⲑⲛⲟⲩϫ ⲛϫⲉⲡϩⲱⲃ ⲛϯ**ⲃⲱ** ⲛϫⲱⲓⲧ ⲟⲩⲟϩ ⲛⲓⲙⲉϣϣⲟϯ ⲛⲛⲟⲩⲉⲣϧⲣⲉ ⲁⲩⲙⲟⲩⲛⲕ ⲛϫⲉⲛⲓⲉⲥⲱⲟⲩ ϫⲉⲙⲙⲟⲛϧⲣⲉ ⲛⲧⲱⲟⲩ ⲟⲩⲟϩ ⲙⲙⲟⲛⲉϩⲉ ϣⲟⲡ ϧⲉⲛⲡⲓⲟⲩⲛϩϥ ⲛⲧⲉⲡⲟⲩⲭⲱ ⲉⲃⲟⲗ .",
      "english": "For though the fig-tree shall bear no fruit, and there shall be no produce on the vines; the labour of the olive shall fail, and the fields shall produce no food: the sheep have failed from the pasture, and there are no oxen at the cribs;",
      "source": "Bohairic Habakkuk 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:ot.hab.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧ**ⲃⲱ** ⲛⲉⲗⲟⲟⲗⲉ ⲅⲁⲣ ⲙⲉⲥⲧⲁⲟⲩⲉϣⲟⲛⲧⲉ ⲉⲃⲟⲗ ·",
      "english": "for the vine does not produce thorns.”",
      "source": "Apophthegmata Patrum Sahidic 013",
      "urn": "urn:cts:copticLit:ap.13.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁϥⲓ ⲇⲉ ⲉϫⲉⲛⲟⲩ**ⲃⲱ** ⲛⲥⲑⲟⲓ ϫⲉⲉϥⲛⲁϥⲟϫⲥ ⲛⲉⲟⲩⲟⲛ ⲟⲩⲁϫⲱ ϧⲉⲛⲧⲉⲥⲙⲏϯ ⲁⲥⲭⲗⲟⲙⲗⲉⲙ ⲉⲧⲉϥϫⲓϫ .",
      "english": "but when he came to a flowering shrub to gather it, a viper in the middle rushed upon his hand.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
