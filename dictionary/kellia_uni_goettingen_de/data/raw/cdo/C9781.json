  "examples": [
    {
      "coptic": "**ⲙⲏⲡⲱⲥ** ⲛⲧⲉϥⲓ ⲛⲟⲩϩⲟϯ ϧⲉⲛⲟⲩϩⲟϯ ⲛⲧⲉϥϫⲉⲙⲑⲏⲛⲟⲩ ⲉⲣⲉⲧⲉⲛⲛⲕⲟⲧ .",
      "english": "lest coming suddenly he might find you sleeping.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲕⲁⲁⲥ ⲉⲩⲛⲁⲩ ⲉⲩⲉⲛⲁⲩ ⲁⲩⲱ ⲛⲥⲉⲧⲙⲛⲁⲩ ⲁⲩⲱ ⲉⲩⲥⲱⲧⲙ ⲉⲩⲉⲥⲱⲧⲙ ⲛⲥⲉⲧⲙⲛⲟⲉⲓ . **ⲙⲏⲡⲱⲥ** ⲛⲥⲉⲕⲟⲧⲟⲩ ⲛⲥⲉⲕⲱ ⲛⲁⲩ ⲉⲃⲟⲗ .",
      "english": "that 'seeing they may see, and not perceive; and hearing they may hear, and not understand; lest perhaps they should turn again, and their sins should be forgiven them.''",
      "source": "Mark Chapter 4",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲱⲟⲩ ⲇⲉ ⲛⲁⲩⲉⲣⲁⲅⲁⲡⲁⲛ ⲙⲙⲟϥ ⲡⲉ ⲉⲩϯⲛⲟⲙϯ ⲛⲁϥ ⲉⲩⲉⲣϩⲟϯ ϫⲉ**ⲙⲏⲡⲱⲥ** ⲛⲧⲉϥⲉⲣⲁⲑⲟⲩⲱⲛϩ ⲉⲃⲟⲗ ϩⲁⲣⲱⲟⲩ ⲉⲩⲛⲁⲩ ⲉⲡⲓⲛⲓϣϯ ⲛϧⲙⲟⲙ ⲉⲧϣⲟⲡ ⲛⲁϥ ⲉϧⲟⲩⲛ ⲉⲡⲓⲁⲅⲁⲑⲟⲛ .",
      "english": "As for them, they loved and encouraged him, fearing that he would disappear from their house because they saw the great fervor he had for good.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ϯⲱϥⲉ ⲙⲡⲁⲥⲱⲙⲁ ϯⲉⲓⲣⲉ ⲙⲙⲟϥ ⲛϩⲙϩⲁⲗ . **ⲙⲏⲡⲱⲥ** ⲉⲓⲧⲁϣⲉⲟⲉⲓϣ ⲛϩⲉⲛⲕⲟⲟⲩⲉ ⲧⲁϣⲱⲡⲉ ⲁⲛⲟⲕ ⲛϫⲟⲟⲩⲧ .",
      "english": "but I beat my body and bring it into submission, lest by any means, after I have preached to others, I myself should be rejected.",
      "source": "46_1 Corinthians_9",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲥ ⲟⲩⲙⲏϣ ⲅⲁⲣ ⲛⲉϩⲟⲟⲩ ϯϧⲟⲥⲓ ⲟⲩⲟϩ ϯϣⲧⲉⲣⲧⲱⲣ ⲉⲓⲉⲣϩⲟϯ ⲉϯ ⲙⲡⲁⲟⲩⲟⲓ ⲉϧⲟⲩⲛ ⲉⲛⲓϩⲃⲏⲟⲩⲓ ⲛϣⲫⲏⲣⲓ ⲛⲧⲉⲡⲁⲓⲱⲧ ⲁⲡⲁ ϣⲉⲛⲟⲩϯ ϫⲉⲁⲛⲟⲕ ⲟⲩⲁⲥⲑⲉⲛⲏⲥ ⲟⲩⲟϩ ⲛϩⲓⲇⲓⲱⲧⲏⲥ ϧⲉⲛⲡⲥⲁϫⲓ **ⲙⲏⲡⲱⲥ** ⲛⲧⲁⲱⲙⲥ ϧⲉⲛⲡⲓⲡⲉⲗⲁⲅⲟⲥ ⲛⲧⲉⲛⲓⲙⲱⲟⲩ ⲉⲑⲃⲉϫⲉϯⲉⲙⲓ ⲛⲛⲏⲃⲓ ⲁⲛ .",
      "english": "For many days I have been troubled and disturbed, fearing to go forward into the miraculous deeds of my father Apa Shenoute, as I am weak and unskilled in speaking, for fear that I should drown in a sea of water because I don't know how to swim.",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲱⲥⲧⲉ ⲡⲉⲧϫⲱ ⲙⲙⲟⲥ ϫⲉϯⲁϩⲉⲣⲁⲧ ⲙⲁⲣⲉϥϭⲱϣⲧ **ⲙⲏⲡⲱⲥ** ⲛϥϩⲉ .",
      "english": "Therefore let him who thinks he stands be careful that he doesn&apos;t fall.",
      "source": "1 Corinthians 10",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:10",
      "dialect": "sahidic"
    }
  ],
