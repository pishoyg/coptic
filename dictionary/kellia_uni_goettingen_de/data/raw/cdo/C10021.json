  "examples": [
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ ⲁⲓⲣⲓⲙⲓ ϫⲉ**ⲡⲁⲛⲧⲱⲥ** ϯⲙⲡϣⲁ ⲁⲛ ⲛⲛⲁⲩ ⲉⲡϭⲟⲉⲓⲥ ϧⲉⲛϯⲥⲁⲣⲝ .",
      "english": "I wept and said, ‘I am not worthy to behold the Lord in his body.’",
      "source": "Life of Shenoute - part 1",
      "urn": "urn:cts:copticLit:lives.boh_shenoute.leipoldt_ed:1-26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲁⲡⲉⲓⲣⲱⲙⲉ ⲛϭⲱⲃ · ϭⲛⲡⲁⲓ ⲧⲱⲛ ⲟ **ⲡⲁⲛⲧⲱⲥ** ·",
      "english": "Where did this sick man find it?",
      "source": "The Life of John the Kalybites part 2",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:46-90",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲓϣⲱⲡⲓ ⲛⲛⲏ ⲉⲧϣⲱⲛⲓ ⲙⲫⲣⲏϯ ⲛⲟⲩⲣⲉϥϣⲱⲛⲓ ϩⲓⲛⲁ ⲛⲧⲁϫⲉⲙϩⲏⲟⲩ ⲛⲛⲏ ⲉⲧϣⲱⲛⲓ ⲁⲓϣⲱⲡⲓ ⲛⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲛⲣⲏϯ ⲛⲓⲃⲉⲛ ϩⲓⲛⲁ **ⲡⲁⲛⲧⲱⲥ** ⲛⲧⲁⲛⲟϩⲉⲙ ⲛϩⲁⲛⲟⲩⲟⲛ .",
      "english": "To the weak I became as weak, that I might gain the weak. I have become all things to all men, that I may by all means save some.",
      "source": "Bohairic 1 Corinthians 9 (Digital Editions)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩ **ⲡⲁⲛⲧⲱⲥ** ⲉⲓϫⲱ ⲙⲙⲟⲥ ϫⲉⲙⲡⲟⲣⲛⲟⲥ ⲙⲡⲉⲓⲕⲟⲥⲙⲟⲥ ⲏ ⲙⲙⲁⲓⲧⲟⲉ ⲛϩⲟⲩⲟ ⲏ ⲛⲣⲉϥⲧⲱⲣⲡ ⲏ ⲛⲣⲉϥϣⲙϣⲉⲉⲓⲇⲱⲗⲟⲛ ⲉϣϫⲉⲉϩⲉ ⲉⲓⲉ ϣϣⲉ ⲉⲣⲱⲧⲛ ⲉⲉⲓ ⲉⲃⲟⲗ ϩⲙⲡⲕⲟⲥⲙⲟⲥ .",
      "english": "yet not at all meaning with the sexual sinners of this world, or with the covetous and extortioners, or with idolaters; for then you would have to leave the world",
      "source": "1 Corinthians 5",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:5",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲑⲃⲉⲁⲡⲟⲗⲗⲱ ⲇⲉ ⲡⲓⲥⲟⲛ ⲁⲓϯϩⲟ ⲉⲣⲟϥ ⲉⲙⲁϣⲱ ϩⲓⲛⲁ ⲛⲧⲉϥⲓ ϩⲁⲣⲱⲧⲉⲛ ⲛⲉⲙⲛⲓⲥⲛⲏⲩ ⲟⲩⲟϩ **ⲡⲁⲛⲧⲱⲥ** ⲡⲉ ⲫⲟⲩⲱϣ ⲁⲛ ⲡⲉ ϩⲓⲛⲁ ⲛⲧⲉϥⲓ ϯⲛⲟⲩ ⲉϥⲉⲓ ⲇⲉ ϩⲁⲣⲱⲧⲉⲛ ⲁϥϣⲁⲛϫⲉⲙⲧⲉⲩⲕⲉⲣⲓⲁ .",
      "english": "Now concerning Apollos, the brother, I strongly urged him to come to you with the brothers; and it was not at all his desire to come now; but he will come when he has an opportunity.",
      "source": "Bohairic 1 Corinthians 16 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:16",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ **ⲡⲁⲛⲧⲱⲥ** ⲕⲛⲁϫⲟⲟⲥ ϫⲉⲟⲩⲉⲡⲓⲥⲕⲟⲡⲟⲥ ⲡⲉ · ⲛⲉϣϣⲉ ⲁⲛ ⲉⲣⲟϥ ⲉϫⲓⲥϩⲓⲙⲉ ·",
      "english": "But, notwithstanding my answer, thou wouldst say unto me in any case, 'He was a bishop, and it was not seemly for him to take a wife.'",
      "source": "Encomium on Demetrius Archbishop of Alexandria part 1",
      "urn": "urn:cts:copticLit:psflavianus.encomium.budge:1-23",
      "dialect": "sahidic"
    }
