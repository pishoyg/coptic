  "examples": [
    {
      "coptic": "ⲙⲡⲉⲛⲑⲣⲉϩⲗⲓ ⲉⲣϩⲁⲗ ⲙⲙⲟϥ ⲙⲙⲁⲩⲁⲧϥ ⲫⲏ ⲉⲑⲙⲉⲩⲓ ϧⲉⲛⲑⲏⲛⲟⲩ ϫⲉⲟⲩ**ⲥⲁⲃⲉ** ⲡⲉ ϧⲉⲛⲡⲁⲓⲉⲛⲉϩ ⲙⲁⲣⲉϥⲉⲣⲥⲟϫ ϩⲓⲛⲁ ⲛⲧⲉϥⲉⲣⲥⲁⲃⲉ .",
      "english": "Let no one deceive himself. If anyone thinks that he is wise among you in this world, let him become a fool, that he may become wise.",
      "source": "Bohairic 1 Corinthians 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲁⲛⲅⲟⲩ ⲥⲟϭ ⲁⲛ · ⲁⲗⲗⲁ ⲁⲛⲅⲟⲩ**ⲥⲁⲃⲉ** ·",
      "english": "'I am not a fool; nay, I am a wise man.",
      "source": "Martyrdom of Victor part 7",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:67-85",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲁⲩ ⲅⲁⲣ ⲉⲡⲉⲧⲉⲛⲑⲱϩⲉⲙ ⲛⲁⲥⲛⲏⲟⲩ ϫⲉⲙⲙⲟⲛ ⲟⲩⲙⲏϣ ⲛ**ⲥⲁⲃⲉ** ⲕⲁⲧⲁⲥⲁⲣⲝ ⲙⲙⲟⲛ ⲟⲩⲙⲏϣ ⲛϫⲱⲣⲓ ⲙⲙⲟⲛ ⲟⲩⲙⲏϣ ⲛⲉⲩⲅⲉⲛⲏⲥ .",
      "english": "For you see your calling, brothers, that not many are wise according to the flesh, not many mighty, and not many noble;",
      "source": "Bohairic 1 Corinthians 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲛ ⲁⲛⲣⲥⲟϭ ⲉⲧⲃⲉⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲛⲧⲱⲧⲛ ⲇⲉ ⲛⲧⲉⲧⲛ ϩⲉⲛ**ⲥⲁⲃⲉ** ϩⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ ⲁⲛⲟⲛ ⲧⲛϭⲟⲟⲃ ⲛⲧⲱⲧⲛ ⲇⲉ ⲧⲉⲧⲛϫⲟⲟⲣ ⲛⲧⲱⲧⲛ ⲧⲉⲧⲛⲧⲁⲉⲓⲏⲩ ⲁⲛⲟⲛ ⲇⲉ ⲧⲛⲥⲏϣ",
      "english": "We are fools for Christ&apos;s sake, ·but you are wise in Christ. We are weak, but you are strong. You have honor, but we have dishonor.",
      "source": "46_1 Corinthians_4",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲓϫⲱ ⲙⲙⲟⲥ ⲛⲱⲧⲉⲛ ⲙⲫⲣⲏϯ ⲛϩⲁⲛ**ⲥⲁⲃⲉⲩ** ⲙⲁϩⲁⲡ ⲛⲑⲱⲧⲉⲛ ⲉⲡⲉϯϫⲱ ⲙⲙⲟϥ .",
