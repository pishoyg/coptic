  "examples": [
    {
      "coptic": "ⲱⲟⲩⲛⲓⲁⲧ ⲥ ⲇⲉ ⲛ ϩⲟⲩⲟ ⲁⲥϣⲁⲛⲟϩⲓ ⲙⲡⲁⲓⲣⲏϯ ⲕⲁⲧⲁⲧⲁⲅⲛⲱⲙⲏ ϯ**ⲙⲉⲩⲓ** ⲇⲉ ϩⲱ ϫⲉⲟⲩⲟⲛⲟⲩⲡⲛⲉⲩⲙⲁ ⲛⲧⲉⲫⲛⲟⲩϯ ⲛϩⲣⲏⲓ ⲛϧⲏⲧ .",
      "english": "But she is happier if she stays as she is, in my judgment, and I think that I also have God's Spirit.",
      "source": "Bohairic 1 Corinthians 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉϯ**ⲙⲉⲉⲩⲉ** ϫⲉⲉⲣϣⲁⲛⲡⲣⲱⲙⲉ ⲁⲙⲁϩⲧⲉ ⲙⲡⲉϫⲡⲓⲟ ϩⲙⲡⲉϥϩⲏⲧ",
      "english": "“I think that if a man holds blame in his heart,",
      "source": "Apophthegmata Patrum Sahidic 003: Anonymous Nau 138",
      "urn": "urn:cts:copticLit:ap.3.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲁⲓⲣⲏϯ ⲟⲛ ⲙⲁⲣⲟⲩ**ⲙⲉⲩⲓ** ⲉⲣⲟⲛ ⲛϫⲉⲛⲓⲣⲱⲙⲓ ϩⲱⲥ ϩⲁⲛϩⲩⲡⲉⲣⲉⲧⲏⲥ ⲛⲧⲉⲡⲭⲣⲓⲥⲧⲟⲥ ⲛⲉⲙϩⲁⲛⲟⲓⲕⲟⲛⲟⲙⲟⲥ ⲛⲧⲉⲛⲓⲙⲩⲥⲧⲏⲣⲓⲟⲛ ⲛⲧⲉⲫⲛⲟⲩϯ .",
      "english": "So let men think of us as Christ's servants, and stewards of God's mysteries.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲧⲁⲁϣ ⲛⲛⲟⲩⲥ **ⲙⲉⲉⲩⲉ** ⲟⲛ ⲛⲧⲉⲓϩⲉ ⲉⲛⲉϩ ·",
      "english": "Moreover, what mind hath ever existed which hath been able to think it out as it really is?",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲓⲛⲁ ⲛⲧⲉϣⲧⲉⲙⲟⲩⲁⲓ **ⲙⲉⲩⲓ** ⲉⲣⲟⲓ ϫⲉⲉⲓϣⲟⲩϣⲟⲩ ⲉϫⲱϥ ⲓⲉ ⲉⲓϯϩⲙⲟⲧ ⲛⲁϥ ϯϯ ⲙⲡⲭⲣⲓⲥⲧⲟⲥ ⲙⲙⲉⲑⲣⲉ ⲉⲣⲟⲓ ϫⲉⲡϩⲟⲩⲟ ⲛⲧⲉⲛⲉϥⲁⲣⲉⲧⲏ ⲁⲓⲛⲁⲩ ⲛⲁⲓ ⲉϯⲛⲁⲥϧⲏⲧⲟⲩ ⲛⲱⲧⲉⲛ ⲉⲟⲩϩⲏⲟⲩ ⲛⲛⲏ ⲉⲑⲛⲁⲱϣ ⲙⲙⲱⲟⲩ ⲛⲉⲙⲛⲏ ⲉⲑⲛⲁⲥⲱⲧⲉ ⲉⲣⲱⲟⲩ ⲛⲥⲉϯⲱⲟⲩ ⲙⲡⲭⲣⲓⲥⲧⲟⲥ ⲫⲏ ⲉⲧϯϫⲟⲙ ⲛⲛⲉϥⲉⲃⲓⲁⲓⲕ ⲉⲑⲣⲟⲩⲓⲣⲓ ⲙⲡⲉⲑⲣⲁⲛⲁϥ ⲁⲛⲟⲕ ϩⲱ ⲛⲧⲁⲉⲣⲡⲉⲙⲡϣⲁ ⲛⲧⲁⲧⲁⲙⲱⲧⲉⲛ ϫⲉⲓⲥϫⲉⲛ ⲧⲉϥⲁⲣⲭⲏ ⲡⲱⲥ ϣⲁⲧⲉϥⲓ ⲉⲛⲁⲓϣⲓ ⲛⲉⲙⲛⲁⲓⲛⲓϣϯ ⲛⲁⲥⲕⲩⲥⲓⲥ ϣⲁⲧⲉϥϫⲉⲕⲝ ⲛⲣⲟⲙⲡⲓ ⲟⲩⲟϩ ⲡⲁⲓⲣⲏϯ ⲁϥⲙⲧⲟⲛ ⲙⲙⲟϥ ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲥϧⲏⲟⲩⲧ ϫⲉϧⲉⲛⲟⲩⲕⲟⲩϫⲓ ⲛⲥⲏⲟⲩ ϥϫⲱⲕ ⲛⲟⲩⲙⲏϣ ⲛⲣⲟⲙⲡⲓ ⲉⲃⲟⲗ .",
      "english": "But lest anyone should think that I ascribe glory to him or offer him praise, I call Christ as my witness that I saw most of his virtues with my own eyes, and that the miracles he performed were not done for his own glory, but for the benefit of those who will read or hear of them, so that they may praise Christ, who gives power to his servants and fulfills His will in them. Would that I were also worthy to teach you these things—namely, how he progressed from his beginning to this perfection and great asceticism, completing sixty years, and then rested, as it is written, ‘In a short time, he fulfilled many years.’",
      "source": "Bohairic Lausiac History - Part 3",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:38",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲧⲃⲉⲡⲁⲓ ϣϣⲉ ⲉⲣⲟⲛ ⲉ**ⲙⲉⲉⲩⲉ** ⲛⲧⲉⲓϩⲉ ϩⲱⲥ ⲉⲛⲛⲁϯⲗⲟⲅⲟⲥ ⲙⲡⲛⲟⲩⲧⲉ ⲙⲙⲏⲛⲉ . ϫⲉⲉⲩⲛⲁϣⲁⲧⲛ ϩⲁⲛⲉⲛⲧⲁⲛⲁⲁⲩ ϩⲛⲧⲉⲛϭⲓⲛⲱⲛⲁϩ .",
      "english": "Because of this, it is right for us to think in this way, if we shall give an account to God daily, that we shall be cut off because of what we have done in our daily lives.&apos;",
      "source": "Apophthegmata Patrum Sahidic 002: Anonymous Nau 136",
      "urn": "urn:cts:copticLit:ap.2.monbeg",
      "dialect": "sahidic"
    }
  ],
