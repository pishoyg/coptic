  "examples": [
    {
      "coptic": "ⲫⲏ ⲅⲁⲣ ⲉⲧⲉⲡⲓⲣⲱⲙⲓ ⲛⲁⲧⲏⲓϥ ⲛⲧϣⲉⲃⲓⲱ ⲛⲧⲉϥ**ⲯⲩⲭⲏ** .",
      "english": "For what will a man give in exchange for his life?",
      "source": "Bohairic Gospel of Mark 8 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:8",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲩⲉ ⲉϥϫⲱ ⲙⲙⲟⲥ . ϫⲉⲉⲓⲟⲩⲱϣ ⲉⲧⲟⲩϫⲉⲧⲁ**ⲯⲩⲭⲏ** .",
      "english": "…he saying, “I desire to save my soul.”",
      "source": "Apophthegmata Patrum Sahidic 001: Anonymous Nau 135",
      "urn": "urn:cts:copticLit:ap.1.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϯ**ⲯⲩⲭⲏ** ⲅⲁⲣ ⲉⲧⲉⲣⲁⲥⲕⲓⲛ ⲉⲡⲭⲣⲓⲥⲧⲟⲥ ϩⲱϯ ⲉⲣⲟⲥ ⲡⲉ ⲛⲧⲉⲥϭⲓⲥⲃⲱ ϧⲉⲛⲟⲩⲕⲁϯ ⲉⲛⲏ ⲉⲧⲉⲥⲉⲙⲓ ⲉⲣⲱⲟⲩ ⲁⲛ ⲥⲉ ⲛⲧⲉⲥϭⲓⲥⲃⲱ ⲛⲑⲟϥ ⲉⲛⲏ ⲉⲧⲁⲥⲟⲩⲱ ⲉⲙⲓ ⲉⲣⲱⲟⲩ ϧⲉⲛⲟⲩⲧⲁϫⲣⲟ ⲉϣⲱⲡ ⲥⲟⲩⲱϣ ⲁⲛ ⲉⲉⲣⲟⲩⲁⲓ ϧⲉⲛⲡⲁⲓⲃ ⲁⲣⲓⲉⲙⲓ ϫⲉⲉⲥϣⲱⲛⲓ ϧⲉⲛⲟⲩⲗⲓⲃⲓ",
      "english": "For the soul that practices asceticism in Christ and does not know how to be taught with understanding or to teach what it has firmly learned should be understood to be suffering from madness.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲉ**ⲯⲩⲭⲏ** ϩⲱⲱⲥ ϣⲁⲥϭⲃⲃⲉ .",
      "english": "the soul weakens.",
      "source": "Apophthegmata Patrum Sahidic 054: Daniel 4",
      "urn": "urn:cts:copticLit:ap.54.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉ ⲥϣⲉ ⲉⲉⲣⲡⲉⲑⲛⲁⲛⲉϥ ϧⲉⲛⲛⲓⲥⲁⲃⲃⲁⲧⲟⲛ ϣⲁⲛ ⲉⲉⲣⲡⲉⲧϩⲱⲟⲩ ⲟⲩ**ⲯⲩⲭⲏ** ⲉⲛⲁϩⲙⲉⲥ ϣⲁⲛ ⲉϧⲟⲑⲃⲉⲥ ⲛⲑⲱⲟⲩ ⲇⲉ ⲁⲩⲭⲁⲣⲱⲟⲩ",
      "english": "He said to them, 'Is it lawful on the Sabbath day to do good, or to do harm? To save a life, or to kill?' But they were silent.",
      "source": "Bohairic Gospel of Mark 3 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:3",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲛⲧⲉ**ⲯⲩⲭⲏ** ⲇⲉ ⲟⲩⲛⲧⲁⲩ ⲙⲙⲁⲩ ⲛⲟⲩϩⲙⲟⲧ .",
      "english": "but they have grace in their soul.",
      "source": "Apophthegmata Patrum Sahidic 029",
