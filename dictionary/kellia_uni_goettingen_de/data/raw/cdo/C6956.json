  "examples": [
    {
      "coptic": "ⲧⲁⲁⲡⲟⲗⲟⲅⲓⲁ ⲛⲛⲏ ⲉⲧ**ϧⲟⲧϧⲉⲧ** ⲙⲙⲟⲓ ⲑⲁⲓ ⲧⲉ .",
      "english": "My defense to those who examine me is this.",
      "source": "Bohairic 1 Corinthians 9 (Digital Editions)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲙⲓⲛⲉ ⲅⲁⲣ ⲉⲧⲕⲛⲁ**ϩⲟⲧϩⲧ** ⲛⲥⲁⲡϩⲱⲃ ⲙⲙⲟⲥ ϩⲛⲟⲩⲗⲟⲅⲓⲥⲙⲟⲥ · ⲕⲛⲁϭⲓⲛⲉ ⲛⲧⲉϣⲡⲏⲣⲉ ⲉⲥⲧⲁⲓⲏⲩ ⲛϩⲟⲩⲟ ⲉϭⲓⲛϩⲟⲧϩⲧ ⲛⲓⲙ ·",
      "english": "But if thou dost attempt to enquire deeply into the matter, by means of thy power of reasoning powers, thou wilt find that this glorious miracle is wholly beyond all investigation whatsoever.",
      "source": "Proclus Homily 23 On the Nativity in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily23.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣⲱⲡ ⲇⲉ ⲉⲩⲉⲣⲡⲣⲟⲫⲏⲧⲉⲩⲓⲛ ⲧⲏⲣⲟⲩ ⲛⲧⲉϥⲓ ⲇⲉ ⲉϧⲟⲩⲛ ⲛϫⲉⲟⲩⲁⲑⲛⲁϩϯ ⲓⲉ ⲟⲩⲓⲇⲓⲱⲧⲏⲥ ⲥⲉⲛⲁⲥⲁϩⲱϥ ⲛϫⲉⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲥⲉⲛⲁ**ϧⲉⲧϧⲱⲧ**ϥ ⲛϫⲉⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ .",
      "english": "But if all prophesy, and someone unbelieving or unlearned comes in, he is reproved by all, and he is judged by all.",
      "source": "Bohairic 1 Corinthians 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲛ**ϩⲟⲧϩⲧ** ϭⲉ ⲧⲉⲛⲟⲩ ⲛⲧⲛⲉⲓⲙⲉ ϫⲉⲁϣ ⲛⲉ ⲛⲉⲓⲉⲣⲅⲁⲧⲏⲥ · ⲏ ⲁϣ ⲡⲉ ⲡⲉⲓⲙⲁ ⲛⲉⲗⲟⲟⲗⲉ · ⲏ ⲛⲓⲙ ⲡⲉ ⲡⲉⲓⲟⲧⲏⲥⲡⲟⲇⲏⲥ ·",
      "english": "Now let us enquire carefully, and let us learn what are these kinds of labourers, and what this vineyard is, and who is this master.",
      "source": "Homily on Matthew 20",
      "urn": "urn:cts:copticLit:psathanasius.matthew20.budge:1-56",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲓⲡⲛⲁⲧⲓⲕⲱⲥ ⲇⲉ ⲛⲑⲟϥ ϣⲁϥ**ϧⲉⲧϧⲉⲧ** ⲛⲉⲛⲭⲁⲓ ⲛⲓⲃⲉⲛ ⲛⲑⲟϥ ⲇⲉ ⲙⲡⲁⲣⲉϩⲗⲓ ϣϧⲉⲧϧⲱⲧϥ .",
      "english": "But he who is spiritual discerns all things, and he himself is judged by no one.",
      "source": "Bohairic 1 Corinthians 2 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:2",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉϥϣⲁⲛⲉⲝⲉⲧⲁⲍⲉ ⲙⲙⲟⲛ ⲏ ⲉϥϣⲁⲛ**ϩⲉⲧϩⲱⲧ**ⲛ ⲉⲧⲃⲉⲛⲉⲛⲙⲛⲧⲁⲙⲉⲗⲏⲥ ⲉⲧϩⲛⲛⲉⲛϣⲗⲏⲗ · ⲙⲛⲛⲉⲛⲙⲛⲧϩⲏⲧ ϣⲏⲙ ·",
      "english": "If He were to enquire closely into our conduct, or if He were to investigate our remissnesses in prayer, and our faintheartedness, (what chance of escape would there be for us ?)",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    }
