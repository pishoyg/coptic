  "examples": [
    {
      "coptic": "ⲁϥⲉⲣⲟⲩⲱ ⲛϫⲉⲡⲓⲁⲣⲭⲱⲛ ϫⲉⲟⲩⲕⲟⲩⲛ ⲛⲑⲟⲕ ⲟⲩⲁⲓ ⲙⲡⲁⲓⲣⲏϯ ⲟⲩⲟϩ ⲙⲡⲓⲉⲙⲓ ϣⲁⲫⲟⲟⲩ ⲁⲗⲏⲑⲱⲥ ⲉⲣⲉⲡⲓⲣⲱⲙⲓ ϫⲟⲩϣⲧ ⲉⲡⲓ**ϩⲟ** ⲫⲛⲟⲩϯ ⲇⲉ ⲛⲑⲟϥ ⲉⲡⲓϩⲏⲧ",
      "english": "The prefect spoke up and said: ‘You have such merit and I have not known it until today? Truly man looks at the appearance, but God at the heart.’",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲉⲧⲓ ⲉϥⲡⲁϩⲧ ⲉϫⲙⲡⲉϥ**ϩⲟ** ·",
      "english": "when he was still lying face-down,",
      "source": "Apophthegmata Patrum Sahidic 131: N 301",
      "urn": "urn:cts:copticLit:ap.131.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϣⲱⲡ ⲇⲉ ⲉⲩⲟⲓ ⲛϩⲉⲣⲉⲥⲓⲥ ⲉⲩϯⲟⲥⲓ ϧⲉⲛⲡⲟⲩϫⲓⲛⲛⲁⲩ ⲛⲉⲙⲧⲟⲩⲙⲉⲧϣⲟⲃⲓ ⲕⲁⲛ ⲉϣⲱⲡ ⲉⲩⲣⲏⲧ ⲛⲥⲭⲓⲙ ⲟⲩⲟϩ ⲉⲣⲉⲡⲟⲩ**ϩⲟ** ⲟⲓ ⲛⲉϥϫⲓ ϧⲉⲛϯⲙⲉⲧϧⲉⲗⲗⲟ ⲉϣⲱⲡ ⲙⲙⲟⲛ ⲟⲩⲧⲁϩ ⲛⲧⲉⲫⲛⲟⲩϯ ϣⲟⲡ ⲛϧⲏⲧⲟⲩ ⲁⲛ ⲁⲣⲓⲡⲁⲣⲉⲧⲓⲥⲑⲉ ⲙⲡⲟⲩϫⲓⲛⲛⲁⲩ ⲉⲣⲱⲟⲩ",
      "english": "But if they are heretics, offering harm through their appearance and hypocrisy—even if their hair is white and their faces show the marks of old age—if they do not bear the fruits of God, avoid their company.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡⲉϫⲁϥ ϫⲉⲁⲓⲛⲁⲩ ⲉⲡⲛⲟⲩⲧⲉ ⲛϩⲟ ϩⲓ**ϩⲟ** ·",
      "english": "Then Jacob said, 'I have seen God face to face.'",
      "source": "Life of Pisentius part 1",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:1-31",
      "dialect": "sahidic"
