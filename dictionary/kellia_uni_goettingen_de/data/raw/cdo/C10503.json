  "examples": [
    {
      "coptic": "ϩⲱⲥⲇⲉ ⲛⲥⲉϭⲓ ⲛϩⲁⲛ**ⲥⲟⲩⲇⲁⲣⲓⲟⲛ** ⲛⲉⲙϩⲁⲛⲥⲓⲙⲓⲕⲩⲛⲑⲓⲛⲟⲛ ⲉⲃⲟⲗ ϩⲓⲡⲉϥⲥⲱⲙⲁ ⲛⲥⲉⲭⲁⲩ ϩⲓϫⲉⲛⲛⲏ ⲉⲧϣⲱⲛⲓ ⲟⲩⲟϩ ⲛⲉϣⲁⲩϣⲉ ⲛⲱⲟⲩ ⲉⲃⲟⲗ ϩⲓⲱⲧⲟⲩ ⲛϫⲉⲛⲓϣⲱⲛⲓ ⲟⲩⲟϩ ⲛⲓⲡⲛⲉⲩⲙⲁⲉⲧϩⲱⲟⲩ ⲛⲁⲩⲛⲏⲟⲩ ⲉⲃⲟⲗ ⲡⲉ .",
      "english": "so that even handkerchiefs or aprons were carried away from his body to the sick, and the evil spirits went out.",
      "source": "05_Acts_19",
      "urn": "urn:cts:copticLit:nt.acts.bohairic:19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲟⲣⲓⲟⲛ ⲇⲉ ⲁϥϯ ⲡⲉϥ**ⲥⲟⲩⲇⲁⲣⲓⲟⲛ** ⲉⲣⲙⲡⲉϥϩⲟ ·",
      "english": "And Horion placed his napkin before his face.",
