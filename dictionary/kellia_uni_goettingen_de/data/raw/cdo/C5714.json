  "examples": [
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲡⲓⲇⲏ ⲛⲏⲕⲉⲟⲩⲟⲛ ⲉⲑⲟⲩⲱⲙ ϧⲉⲛⲟⲩⲡⲁⲑⲟⲥ ⲛⲉⲙⲟⲩϩⲩⲇⲟⲛⲏ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉⲛⲟⲩⲱⲙ ϧⲉⲛⲟⲩⲛⲁϩϯ ⲁⲗⲗⲁ ⲥⲉⲟⲩⲱⲙ ⲁⲛ ϧⲉⲛⲟⲩ**ϣⲓ** ⲉϥⲣⲱϣⲓ ⲁⲗⲗⲁ ϧⲉⲛⲟⲩⲙⲉⲧⲁⲧⲥⲓ ⲛⲧⲉⲟⲩϩⲩⲇⲟⲛⲏ ⲡⲱⲥ ⲧⲉⲛⲛⲁⲉⲙⲓ ⲉⲣⲱⲟⲩ .",
      "english": "But since there are those who eat with passion and indulgence, saying, “We eat with faith,” and who do not eat according to the measure of sufficiency but with insatiable greed, how shall we discern them?",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲛⲟⲛ ϭⲉ ϩⲱⲱⲛ ⲁⲛⲥⲟⲩⲉⲛ ⲡⲉⲛ**ϣⲓ** ⲙⲙⲓⲛⲙⲙⲟⲛ ·",
      "english": "Then, we ourselves, too, knew our measure.",
      "source": "Apophthegmata Patrum Sahidic 125: Joseph",
      "urn": "urn:cts:copticLit:ap.125.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲓⲥ ⲟⲩⲥⲟⲃⲧ ϥⲟⲓ ⲥⲁⲃⲟⲗ ⲙⲡⲓⲏⲓ ⲉϥⲕⲱϯ ⲉⲣⲟϥ ⲟⲩⲟϩ ⲛⲁϥϧⲉⲛ ⲧϫⲓϫ ⲙⲡⲓⲣⲱⲙⲓ ⲛϫⲉⲟⲩⲕⲁϣ ⲛ**ϣⲓ** ϥⲛⲁⲉⲣⲋ ⲙⲙⲁϩⲓ ϧⲉⲛⲟⲩⲙⲁϩⲓ ⲛⲉⲙⲟⲩϣⲟⲡ ⲟⲩⲟϩ ⲁϥϣⲓ ⲙⲡⲓⲟⲩⲏϣⲥⲓ ⲙⲡⲓⲕⲱⲧ ϧⲉⲛⲟⲩⲕⲁϣ ⲛⲟⲩⲱⲧ ⲟⲩⲟϩ ⲡⲉϥϭⲓⲥⲓ ⲛⲁϥ ⲛϩⲩⲥⲟⲥ ⲛⲉⲙⲡⲓⲕⲁϣ ⲛⲥⲁⲥⲁ ⲛⲓⲃⲉⲛ .",
      "english": "And behold a wall round about the house without, and in the man's hand a reed, the measure of it was six cubits by the cubit, and a span: and he measured across the front wall; the breadth was equal to the reed, and the length of it equal to the reed.",
      "source": "26_Ezechiel_40",
      "urn": "urn:cts:copticLit:ot.ezek.bohairic_ed:40",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲟⲩⲣⲱⲙⲉ ⲉϥⲑⲃⲃⲓⲏⲩ ⲙⲛ**ϣⲓ** ⲙⲡⲉϥⲁⲛⲁⲓ ·",
      "english": "and there is no measure to his beauty.",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ϩⲏⲡⲡⲉ ⲓⲥ ⲟⲩϫⲓⲛϭⲱⲣ ⲛⲧⲁϩⲧ ⲉⲩⲓⲛⲓ ⲙⲙⲟϥ ⲉⲃⲟⲗ ⲟⲩⲟϩ ⲓⲥ ⲟⲩⲥϩⲓⲙⲓ ϧⲉⲛⲧⲙⲏϯ ⲙⲡⲓ**ϣⲓ** .",
      "english": "And behold a talent of lead lifted up: and behold a woman sat in the midst of the measure.",
      "source": "38_Zacharias_05",
      "urn": "urn:cts:copticLit:ot.zach.bohairic_ed:05",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲗⲁⲥ ⲙⲁⲣⲉϥϣⲱⲡⲉ ⲉⲩⲛⲧⲁϥ ⲙⲙⲁⲩ ⲛϩⲉⲛ**ϣⲓ** ·",
