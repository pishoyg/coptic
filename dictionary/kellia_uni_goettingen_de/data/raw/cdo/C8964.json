  "examples": [
    {
      "coptic": "ⲛⲉⲫⲁⲣⲣⲓⲥⲁⲓⲟⲥ ⲇⲉ ⲡⲉϫⲁⲩ ⲛⲁϥ ϫⲉⲁⲛⲁⲩ ϫⲉⲉⲩⲣⲟⲩ ϩⲛⲛⲥⲁⲃⲃⲁⲧⲟⲛ ⲉⲟⲩⲕ **ⲉⲝⲉⲥⲧⲓ** ⲉⲁⲁϥ .",
      "english": "The Pharisees said to him, 'Behold, why do they do that which is not lawful on the Sabbath day?'",
      "source": "41_Mark_2",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡⲉϫⲁϥ ⲛⲁⲩ ϫⲉ**ⲉⲝⲉⲥⲧⲓ** ϩⲛⲛⲥⲁⲃⲃⲁⲧⲟⲛ ⲉⲣⲡⲉⲧⲛⲁⲛⲟⲩϥ ϫⲛⲣⲡⲉⲧϩⲟⲟⲩ ⲉⲧⲁⲛϩⲉⲟⲩⲯⲩⲭⲏ ϫⲛⲉⲙⲟⲟⲩⲧⲥ . ⲛⲧⲟⲟⲩ ⲇⲉ ⲁⲩⲕⲁⲣⲱⲟⲩ",
      "english": "He said to them, 'Is it lawful on the Sabbath day to do good, or to do harm? To save a life, or to kill?' But they were silent.",
      "source": "41_Mark_3",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲓⲱϩⲁⲛⲛⲏⲥ ⲅⲁⲣ ⲛⲉϥϫⲱ ⲙⲙⲟⲥ ⲛϩⲏⲣⲱⲇⲏⲥ ϫⲉⲟⲩⲕ **ⲉⲝⲉⲥⲧⲉⲓ** ⲛⲁⲕ ⲉϫⲓ ⲛⲧϩⲓⲙⲉ ⲙⲡⲉⲕⲥⲟⲛ .",
      "english": "For John said to Herod, 'It is not lawful for you to have your brother's wife.'",
      "source": "Mark Chapter 6",
      "urn": "urn:cts:copticLit:nt.mark.sahidica_ed:6",
      "dialect": "sahidic"
