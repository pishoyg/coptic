  "examples": [
    {
      "coptic": "ⲟⲩ**ⲁⲧⲟⲩⲱ** ⲅⲁⲣ ⲛⲁⲕ ⲡⲉ ⲡⲙⲧⲟⲛ ⲛϣⲁⲉⲛⲉϩ .",
      "english": "for there is unceasing rest for you forever.'",
      "source": "Apophthegmata Patrum Sahidic 030",
      "urn": "urn:cts:copticLit:ap.30.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲕϩⲟⲥⲉ ⲉⲧⲃⲉⲧⲁϣⲉ ⲛⲛⲉⲭⲣⲏⲙⲁ · ϩⲙⲡⲉⲕⲙⲟⲩ ⲇⲉ ⲟⲛ ⲁⲕⲃⲱⲕ ⲉⲛⲕⲟⲗⲁⲥⲓⲥ ⲛ**ⲁⲧⲟⲩⲱ** · ⲛϣⲃⲃⲓⲟ ⲛⲛⲉⲕⲁⲛⲟⲙⲓⲁ ⁛",
      "english": "and thou wast weary because of the multitude of thy possessions, and at thy death thou didst depart to the punishment which is neverending, in exchange for thy wickedness.",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲉⲛⲟⲩ ϭⲉ ⲡⲁⲙⲉⲣⲓⲧ · ϫⲟⲟⲩ ⲛⲧⲉⲕⲙⲛⲧⲣⲙⲙⲁⲟ ϩⲁⲧⲉⲕϩⲏ · ϩⲛϩⲉⲛⲙⲛⲧϣⲁⲛϩⲧⲏϥ ⲉϩⲟⲩⲛ ⲉⲛϩⲏⲕⲉ · ϫⲉⲕⲁⲥ ⲉⲕⲛⲁϩⲉ ⲉⲩⲁⲡⲟⲗⲁⲩⲥⲓⲥ ⲛ**ⲁⲧⲟⲩⲱ** ·",
      "english": "Now therefore, O my beloved, distribute your riches and possessions in alms and oblations to the poor, in order that ye may obtain the happiness which shall be without end.",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    }
