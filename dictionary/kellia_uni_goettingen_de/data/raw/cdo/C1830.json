  "examples": [
    {
      "coptic": "ⲁⲩⲱ ⲛⲏ ⲛⲉ ⲛⲧⲁⲩϫⲟⲟⲩ ⲉϫⲙⲡⲕⲁϩ ⲉⲧⲛⲁⲛⲟⲩϥ ⲉⲩⲥⲱⲧⲙ ⲉⲡϣⲁϫⲉ ⲥⲉϣⲱⲡ ⲙⲙⲟϥ ⲉⲣⲟⲟⲩ ⲁⲩⲱ ⲥⲉⲧⲁⲩⲉⲕⲁⲣⲡⲟⲥ ⲉⲃⲟⲗ ϩⲛ**ⲙⲁⲁⲃ** ⲁⲩⲱ ϩⲛⲥⲉ ⲁⲩⲱ ϩⲛϣⲉ .",
      "english": "Those which were sown on the good ground are those who hear the word, and accept it, and bear fruit, some thirty times, some sixty times, and some one hundred times.",
      "source": "41_Mark_4",
      "urn": "urn:cts:copticLit:nt.mark.sahidica:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲇⲉ ⲙⲡⲟⲩⲧⲁⲁϥ ⲉⲃⲟⲗ ⲉⲛⲉϩ · ⲉⲧⲣⲉϥⲥⲱⲧⲉ ⲙⲡⲕⲟⲥⲙⲟⲥ ϩⲁ**ⲙⲁⲁⲃ** ⲛϩⲁⲧ ·",
      "english": "Never before was the redemption of the world sold for thirty (pieces) of silver.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲉⲓⲥ **ⲙⲁⲁⲃⲉ** ⲛⲣⲟⲙⲡⲉ · ϫⲓⲛⲧⲁⲓⲉⲓ ⲉⲡⲉⲓⲙⲁ · ⲉⲣⲉⲡⲁⲏⲣ ϯ ⲛⲁⲓ ⲛⲟⲩⲕⲣⲁⲥⲓⲥ · ⲉⲥϣⲏϣ ⲁⲩⲱ ⲙⲡⲓⲟⲩⲉⲙⲟⲉⲓⲕ ⲉⲡⲧⲏⲣϥ ·",
      "english": "And behold, it is thirty years since I came to this place, and the climate thereof bestoweth upon me health uniformly. And I never eat bread.'",
      "source": "Life of Onnophrius part 1",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:1-9",
