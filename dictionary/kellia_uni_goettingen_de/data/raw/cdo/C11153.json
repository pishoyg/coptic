  "examples": [
    {
      "coptic": "ⲓⲱϩⲁⲛⲛⲏⲥ ⲇⲉ ⲁϥϫⲓ ⲙⲡϣⲉ ⲛ**ϩⲟⲗⲟⲕⲟⲧⲧⲓⲛⲟⲥ** ⲁϥⲉⲓ ⲉⲡⲙⲁ ⲙⲡⲛⲟϭ ⲛⲛⲉⲉϥ ⲙⲡϫⲟⲉⲓ ·",
      "english": "And John took the hundred oboli, and came to the place of the captain of the ship,",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛϩⲱⲥⲟⲛ ⲇⲉ ϥⲁϩⲉⲣⲁⲧϥ ϩⲛⲧⲁⲅⲱⲣⲁ ⲉϯ ⲙⲡⲉϥϩⲱⲃ ⲛϭⲓϫ ⲉⲃⲟⲗ · ⲉⲓⲥϩⲏⲏⲧⲉ ϩⲛⲟⲩϣⲥⲛⲉ ⲁϥϭⲓⲛⲉ ⲛⲟⲩⲃⲁⲗⲗⲁⲧⲓⲟⲛ ⲉⲩⲛⲙⲏⲧ ⲛϣⲉ ⲛ**ϩⲟⲗⲟⲕⲟⲧⲧⲓⲛⲟⲥ** ϩⲓⲱⲱⲥ .",
      "english": "While he stood in the marketplace selling his handiwork, Behold! Suddenly he found a bag filled with a thousand gold coins!",
      "source": "Apophthegmata Patrum Sahidic 031",
      "urn": "urn:cts:copticLit:ap.31.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲥϣⲱⲡⲉ ⲇⲉ ⲟⲛ ⲁⲩⲣⲱⲙⲉ ⲉⲓ ϣⲁⲣⲟϥ ⲁϥⲥⲡϭⲱⲡϥ ⲉϥϫⲱ ⲙⲙⲟⲥ · ϫⲉⲁⲣⲓⲧⲁⲅⲁⲡⲏ ⲛⲅⲃⲟⲏⲑⲉⲓ ⲉⲣⲟⲓ · ⲡⲁⲭⲣⲓⲥⲧⲟⲥ ⲛⲉⲓⲱⲧ · ϫⲉⲟⲩⲛⲟⲩⲭⲣⲉⲱⲥ ⲉⲣⲟⲓ ϩⲁϩⲧⲛⲟⲩⲣⲱⲙⲉ ϣⲁⲃⲁⲁⲙⲧⲁⲥⲉ ⲛ**ϩⲟⲗⲟⲕⲟⲧⲧⲓⲛⲟⲥ** ⲉⲩⲁⲛⲁⲅⲕⲁⲍⲉ ⲙⲙⲟⲓ ϩⲁⲣⲟⲟⲩ ·",
      "english": "And it came to pass on another occasion that a certain man came unto him, and made supplication unto him, saying, 'I beseech thee to perform an act of love, and to help me, O my lord and father. There is an obligation on me in respect of a certain man of thirty-six 'holokottinoi' they are pressing me urgently concerning them,",
      "source": "Life of Pisentius part 3",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:58-84",
      "dialect": "sahidic"
    }
  ],
