  "examples": [
    {
      "coptic": "ϯⲥϩⲓⲙⲓ ⲇⲉ ⲛⲉⲟⲩⲉⲓⲛⲓⲛ ⲛⲧⲉⲛⲥⲩⲣⲓⲁ ⲡⲉⲥ**ⲅⲉⲛⲟⲥ** ⲟⲩⲉⲃⲟⲗ ϧⲉⲛϯⲫⲟⲓⲛⲓⲕⲏ ⲡⲉ ⲟⲩⲟϩ ⲛⲁⲥϯϩⲟ ⲉⲣⲟϥ ϩⲓⲛⲁ ⲛⲧⲉϥϩⲓⲇⲉⲙⲱⲛ ⲉⲃⲟⲗ ⲛⲧⲉⲥϣⲉⲣⲓ",
      "english": "Now the woman was a Greek, a Syrophoenician by race. She begged him that he would cast the demon out of her daughter.",
      "source": "Bohairic Gospel of Mark 7 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:7",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲃⲟⲉⲥ ⲡⲉϫⲁϥ ⲙⲡⲉⲧϩⲏⲛ ⲉϩⲟⲩⲛ ⲉⲡ**ⲅⲉⲛⲟⲥ** ϫⲉⲉⲧⲃⲉⲧⲙⲉⲣⲓⲥ ⲛⲧⲥⲱϣⲉ ⲉⲧⲧⲁⲡⲉⲛⲥⲟⲛ ⲧⲉ ⲁⲃⲓⲙⲉⲗⲉⲭ ⲧⲁⲓ ⲉⲛⲧⲁⲩⲧⲁⲁⲥ ⲛⲛⲟⲉⲙⲓⲛ ⲧⲉⲛⲧⲁⲥⲕⲧⲟⲥ ⲉⲃⲟⲗ ϩⲛⲧⲥⲱϣⲉ ⲙⲙⲱⲁⲃ",
      "english": "And Booz said to the relative, The matter regards the portion of the field which was our brother Elimelech's which was given to Noemin, now returning out of the land of Moab;",
      "source": "Ruth Chapter 4",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:4",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲁⲓϩⲁⲅⲓⲟⲥ ⲇⲉ ⲟⲩⲛ ⲛⲁⲥⲛⲏⲟⲩ ⲟⲩⲣⲉⲙⲛⲭⲏⲙⲓ ⲡⲉ ϧⲉⲛⲡⲉϥ**ⲅⲉⲛⲟⲥ** ⲟⲩⲉⲃⲟⲗ ⲡⲉ ϧⲉⲛⲟⲩϯⲙⲓ ⲉⲩⲙⲟⲩϯ ⲉⲣⲟϥ ϫⲉⲡⲓϣⲱ .",
      "english": "This saint then, my brethren, was a man of Egypt by his race, from a village called Pisho.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲛϯⲉⲟⲟⲩ ⲛⲁⲕ ⲡⲉϭⲣⲟⲟϭ · ⲡⲗⲟⲅⲟⲥ · ⲡⲉϩⲙⲟⲩ · ⲡⲱⲛⲉ ⲙⲙⲉ · ⲡⲁϩⲟ ⲉⲧⲟⲩⲁⲁⲃ · ⲡϩⲃⲃⲉ · ⲧⲁⲃⲱ · ⲧⲙⲛⲧⲛⲟϭ · ⲡⲉⲛⲧⲁⲩϫⲟⲟⲥ ⲉⲣⲟϥ · ϫⲉϣⲏⲣⲉ ⲛⲣⲱⲙⲉ ⲉⲧⲃⲏⲏⲧⲛ · ϫⲉⲕⲁⲥ ⲉϥⲉⲧⲟⲩϫⲟ ⲙⲡ**ⲅⲉⲛⲟⲥ** ⲛⲛⲣⲱⲙⲉ ·",
      "english": "We ascribe glory unto Thee, the Seed, the Word, the Salt, the True Gem, the Holy Storehouse, the Plough, the Net, the Majesty, Who was sent for the sake of us, the children of men, that He might deliver the race of man.",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉⲡⲁⲓ**ⲅⲉⲛⲟⲥ** ⲙⲙⲟⲛ ϣϫⲟⲙ ⲛⲧⲉϥⲓ ⲉⲃⲟⲗ ϧⲉⲛϩⲗⲓ ⲉⲃⲏⲗ ϧⲉⲛⲟⲩⲡⲣⲟⲥⲉⲩⲭⲏ ⲛⲉⲙⲟⲩⲛⲏⲥⲧⲓⲁ .",
      "english": "He said to them, 'This kind can come out by nothing, except by prayer and fasting.'",
      "source": "Bohairic Gospel of Mark 9 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲛⲟⲉⲙⲓⲛ ⲛⲧⲉⲥϣⲉⲗⲉⲉⲧ ϫⲉϥⲥⲙⲁⲙⲁⲁⲧ ⲙⲡϫⲟⲉⲓⲥ ϫⲉⲙⲡϥⲕⲱ ⲛⲥⲱϥ ⲙⲡⲉϥⲛⲁ ⲙⲛⲛⲉⲧⲟⲛϩ ⲁⲩⲱ ⲙⲛⲛⲉⲧⲙⲟⲟⲩⲧ ⲁⲩⲱ ⲛⲟⲉⲙⲓⲛ ⲡⲉϫⲁⲥ ⲛⲁⲥ ϫⲉⲡⲣⲱⲙⲉ ϥϩⲏⲛ ⲉⲣⲟⲛ ⲟⲩⲉⲃⲟⲗ ϩⲙⲡ**ⲅⲉⲛⲟⲥ** ⲡⲉ ⲉⲧⲛⲁϫⲓⲧⲛ",
      "english": "And Noemin said to her daughter-in-law, Blessed is he of the Lord, because he has not failed in his mercy with the living and with the dead: and Noemin said to her, The man is near akin to us, he is one of our relations.",
      "source": "Ruth Chapter 2",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:2",
      "dialect": "sahidic"
    }
