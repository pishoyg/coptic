  "examples": [
    {
      "coptic": "ϭⲱϣⲧ ⲛⲥⲁϥ ⲙⲛⲡⲟⲟⲩ ϫⲉⲁϥⲡⲁⲣⲁⲅⲉ ⲛⲧϩⲉ ⲛⲟⲩϩⲣⲏⲣⲉ ⲛⲭⲁⲣⲧⲟⲥ ⲏ ⲛⲧϩⲉ ⲛⲟⲩ**ⲣⲉϥⲡⲱⲧ** ⲉϥⲁⲥⲱⲟⲩ ·",
      "english": "Consider yesterday and to-day, how they have passed away like a pretty flower or like a swift runner.",
      "source": "The Asceticon of Apa Ephrem part 2",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:24-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲛⲛⲥⲱⲥ ϣⲁⲣⲉⲧⲙⲛⲧϩⲏⲕⲉ ⲉⲓ ⲛⲁⲕ ⲛⲧϩⲉ ⲛⲟⲩⲁ ⲉϥⲙⲟⲟϣⲉ ⲛⲙⲙⲁⲕ ϩⲓⲟⲩϩⲓⲏ ⲉϥϩⲟⲟⲩ ⲁⲩⲱ ⲡⲉϭⲣⲱϩ ⲛⲧϩⲉ ⲛⲟⲩ**ⲣⲉϥⲡⲱⲧ** ⲉⲛⲁⲛⲟⲩϥ ⲉϣⲱⲡⲉ ⲇⲉ ⲙⲉⲕϫⲛⲁⲁⲩ ⲡⲉⲕⲱϩⲥ ⲛⲏⲩ ⲛⲧϩⲉ ⲛⲟⲩⲡⲏⲅⲏ ⲁⲩⲱ ⲡⲉϭⲣⲱϩ ⲛⲁⲡⲱⲧ ⲉⲃⲟⲗ ⲙⲙⲟⲕ ⲛⲧϩⲉ ⲛⲟⲩⲣⲱⲙⲉ ⲉϥϩⲟⲟⲩ",
      "english": "Then poverty comes upon thee as an evil traveller, and want as a swift courier: but if thou be diligent, thine harvest shall arrive as a fountain, and poverty shall flee away as a bad courier.",
      "source": "Proverbs 6",
      "urn": "urn:cts:copticLit:ot.prov.coptot:6",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲁⲁϩⲉ ⲅⲁⲣ ⲁⲥⲱⲟⲩ ⲉⲩ**ⲣⲉϥⲡⲱⲧ** ⲁⲩⲡⲱⲧ ⲁⲩⲱ ⲙⲡⲟⲩⲛⲁⲩ",
      "english": "But my life is swifter than a post: my days have fled away, and they knew it not.",
      "source": "Job 9",
      "urn": "urn:cts:copticLit:ot.job.coptot:9",
      "dialect": "sahidic"
    }
