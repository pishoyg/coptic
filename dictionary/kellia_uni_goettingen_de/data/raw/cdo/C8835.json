  "examples": [
    {
      "coptic": "ⲡⲓⲁⲅⲱⲛ ⲉⲑⲛⲁⲛⲉϥ ⲁⲓⲉⲣⲁⲅⲱⲛⲓⲍⲉⲥⲑⲉ ⲙⲙⲟϥ ⲡⲓ**ⲇⲣⲟⲙⲟⲥ** ⲁⲓϫⲟⲕϥ ⲉⲃⲟⲗ ⲡⲓⲛⲁϩϯ ⲁⲓⲁⲣⲉϩ ⲉⲣⲟϥ",
      "english": "I have fought the good fight. I have finished the course. I have kept the faith.",
      "source": "16_II Timothy_04",
      "urn": "urn:cts:copticLit:nt.2tim.bohairic:04",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲛⲥⲁⲃⲏⲗ ϭⲉ ϫⲉⲁⲓⲡⲱⲱⲛⲉ ⲛⲛⲉⲩ**ⲇⲣⲟⲙⲟⲥ** ·",
      "english": "For had I not changed their courses,",
      "source": "Pistis Sophia Book 1 Part 3",
      "urn": "urn:cts:copticLit:pistissophia.1.petermann:25-35",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲧⲁⲯⲩⲭⲏ ϯⲭⲱ ⲙⲙⲟⲥ ⲁⲛ ϫⲉⲥⲧⲁⲓⲏⲟⲩⲧ ⲛⲧⲟⲧϧⲉⲛϩⲗⲓ ⲛⲥⲁϫⲓ ϣⲁϯϫⲱⲕ ⲙⲡⲁ**ⲇⲣⲟⲙⲟⲥ** ⲉⲃⲟⲗ ⲛⲉⲙϯⲇⲓⲁⲕⲟⲛⲓⲁ ⲑⲏ ⲉⲧⲁⲓϭⲓⲧⲥ ⲛⲧⲉⲛⲡϭⲟⲓⲥ ⲓⲏⲥⲟⲩⲥ ⲉⲉⲣⲙⲉⲑⲣⲉ ⲙⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ⲛⲧⲉⲡⲓϩⲙⲟⲧ ⲛⲧⲉⲫⲛⲟⲩϯ .",
      "english": "But these things don't count; nor do I hold my life dear to myself, so that I may finish my race with joy, and the ministry which I received from the Lord Jesus, to fully testify to the Good News of the grace of God.",
      "source": "05_Acts_20",
      "urn": "urn:cts:copticLit:nt.acts.bohairic:20",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ϩⲛⲟⲩϩⲃⲁ ⲁⲕⲧⲣⲉⲩⲣϩⲃⲁ ϩⲛⲧⲉⲩϭⲓⲛⲙⲟⲟϣⲉ ⲁⲩⲱ ⲁⲩⲡⲗⲁⲛⲁ ϩⲙⲡⲉⲩ**ⲇⲣⲟⲙⲟⲥ** ·",
      "english": "and made them confounded in confusion on their path and deluded in their course?",
      "source": "Pistis Sophia Book 1 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.1.petermann:13-25",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲧⲁ ⲓⲱⲁⲛⲛⲏⲥ ⲇⲉ ϫⲱⲕ ⲙⲡⲉϥ**ⲇⲣⲟⲙⲟⲥ** ⲉⲃⲟⲗ ⲛⲁϥⲭⲱ ⲙⲙⲟⲥ ϫⲉⲁⲣⲉⲧⲉⲛⲙⲉⲩⲓ ϫⲉⲁⲛⲟⲕ ⲛⲓⲙ ⲁⲛⲟⲕ ⲅⲁⲣ ⲁⲛ ⲡⲉ ⲁⲗⲗⲁ ϩⲏⲡⲡⲉ ⲉϥⲛⲏⲟⲩ ⲙⲉⲛⲉⲛⲥⲱⲓ ⲛϫⲉⲫⲏ ⲉⲧⲉⲛϯⲙⲡϣⲁ ⲁⲛ ⲉϯⲟⲩⲱ ⲙⲡⲓⲑⲱⲟⲩⲓ ⲛⲧⲉⲛⲉϥϭⲁⲗⲁⲩϫ .",
      "english": "As John was fulfilling his course, he said, 'What do you suppose that I am? I am not he. But behold, one comes after me the sandals of whose feet I am not worthy to untie.'",
      "source": "05_Acts_13",
      "urn": "urn:cts:copticLit:nt.acts.bohairic:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲛϯⲧⲙⲁⲓⲟ ⲁⲛ ⲛⲧⲁⲯⲩⲭⲏ ϩⲛⲗⲁⲁⲩ ⲛϣⲁϫⲉ ⲛⲧϩⲉ ⲛϫⲱⲕ ⲉⲃⲟⲗ ⲙⲡⲁ**ⲇⲣⲟⲙⲟⲥ** ·",
      "english": "but I do not value my soul in the very least so that I may complete my course.",
