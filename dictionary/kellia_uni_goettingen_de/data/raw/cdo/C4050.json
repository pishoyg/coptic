  "examples": [
    {
      "coptic": "ϫⲉⲁⲣⲓϫⲁϫⲓ ⲛⲉⲙⲛⲓⲙⲁⲇⲓⲁⲛⲓⲧⲏⲥ ⲟⲩⲟϩ **ϯ** ⲟⲩⲃⲏⲟⲩ",
      "english": "Plague the Madianites as enemies, and smite them,",
      "source": "04_Numeri_25",
      "urn": "urn:cts:copticLit:ot.num.bohairic_ed:25",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϯⲥⲟⲟⲩⲛ ϫⲉⲉⲕ**ϯ**ⲟⲩⲃⲏⲓ ⲁⲛ , ⲁⲗⲗⲁ ⲉⲕϯⲟⲩⲃⲉⲓⲏⲥⲟⲩⲥ ⲉⲧⲟⲩⲏϩ ϩⲛⲛⲉⲭⲣⲉⲓⲥⲧⲓⲁⲛⲟⲥ .",
      "english": "I know it’s not against me you fight, but against Jesus who dwells inside the Christians.",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲛⲟⲕ ⲇⲉ ϯϭⲟϫⲓ ⲙⲡⲁⲓⲣⲏϯ ϩⲱⲥ ϧⲉⲛⲟⲩϩⲱⲡ ⲁⲛ ⲡⲁⲓⲣⲏϯ ϯ**ϯ** ϩⲱⲥ ⲉⲓϩⲓⲟⲩⲓ ⲁⲛ ⲉⲡⲓⲁⲏⲣ .",
      "english": "I therefore run like that, as not uncertainly. I fight like that, as not beating the air,",
      "source": "Bohairic 1 Corinthians 9 (Digital Editions)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:9",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲓϣⲁⲛⲉⲓ ⲉⲧⲙⲏⲏⲧⲉ · ϣⲁϥⲙⲁϩⲟⲩ ⲉϩⲟⲩⲛ ⲉⲣⲟⲓ · ⲛⲥⲉ**ϯ** ⲛⲙⲙⲁⲓ ·",
      "english": "if I came into the middle (to fight) he would close in upon me and do battle with me",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉϥⲉ**ⲧⲏⲓⲧ**ⲟⲩ ⲛϫⲉⲡϭⲟⲓⲥ ⲡⲉⲛⲛⲟⲩϯ ⲉϧⲣⲏⲓ ⲉⲛⲉⲕϫⲓϫ ⲟⲩⲟϩ ⲉⲣⲉⲧⲉⲛⲉϣⲁⲣⲓ ⲉⲣⲱⲟⲩ ϧⲉⲛⲟⲩⲧⲁⲕⲟ ⲉⲣⲉⲧⲉⲛⲉⲧⲁⲕⲱⲟⲩ ⲛⲛⲉⲕⲥⲉⲙⲛⲓ ⲛⲟⲩⲇⲓⲁⲑⲏⲕⲏ ⲛⲉⲙⲱⲟⲩ ⲟⲩⲇⲉ ⲛⲛⲉⲧⲉⲛⲛⲁⲓ ⲛⲱⲟⲩ",
      "english": "and the Lord thy God shall deliver them into thy hands, then thou shalt smite them: thou shalt utterly destroy them: thou shalt not make a covenant with them, neither shall ye pity them:",
      "source": "05_Deuteronomium_07",
      "urn": "urn:cts:copticLit:ot.deut.bohairic_ed:07",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲗⲗⲁ ⲉⲧⲉⲧⲛⲁⲅⲱⲛⲓⲍⲉ ⲟⲩⲃⲉⲡⲛⲟⲃⲉ ⲉⲧⲉⲡⲁⲓ ⲡⲉ ϫⲉⲥⲉⲁⲡⲉⲧⲉⲓ ⲙⲙⲟⲛ ⲁⲛ ⲧⲉⲛⲟⲩ ⲉⲧⲣⲉⲛ**ϯ** ⲙⲡⲉⲛⲥⲛⲟϥ ϩⲁⲡⲉⲭⲣⲓⲥⲧⲟⲥ ·",
