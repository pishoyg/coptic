  "examples": [
    {
      "coptic": "ⲕⲁⲧⲁⲫⲣⲏϯ ⲉⲧⲥϧⲏⲟⲩⲧ ϧⲉⲛⲏⲥⲁⲓⲁⲥ ⲡⲓⲡⲣⲟⲫⲏⲧⲏⲥ ϫⲉϩⲏⲡⲡⲉ ϯⲛⲁⲟⲩⲱⲣⲡ ⲙⲡⲁⲅⲅⲉⲗⲟⲥ ϧⲁⲧϩⲏ ⲙⲡⲉⲕϩⲟ ⲫⲏ ⲉⲑⲛⲁ**ⲥⲟⲃϯ** ⲙⲡⲉⲕⲙⲱⲓⲧ ϧⲁϫⲱⲕ .",
      "english": "As it is written in the prophets; Behold, I send my messenger before your face, who will prepare your way before you.",
      "source": "Bohairic Gospel of Mark 1 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:1",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲛⲉⲉϥ ⲇⲉ ⲛⲧⲉⲣϥⲥⲱⲧⲙ ⲉⲛⲁⲓ ϫⲉⲉϥⲟⲩⲱϣ ⲉⲃⲱⲕ ⲛⲁϥ ⲛϫⲓⲟⲩⲉ · ⲡⲉϫⲁϥ ⲛⲁϥ ⲛϭⲓⲡⲛⲉⲉϥ ϫⲉⲁⲓⲟⲩⲱ ⲉⲓ**ⲥⲟⲃⲧⲉ** ⲙⲡⲁϫⲟⲉⲓ · ⲁⲩⲱ ⲁⲓⲟⲩⲱ ⲉⲓϫⲱ ⲙⲙⲟⲥ ⲛⲁⲕ ⲛⲕⲉⲥⲟⲡ ϫⲉⲧϩⲏⲙⲉ ⲙⲡⲁϫⲟⲉⲓ ⲟⲩⲛⲟϭ ⲧⲉ ·",
      "english": "And when the captain heard this, [and knew] that he wished to depart secretly, he said unto him, 'I have already finished making my ship ready to sail, and I have already told you that the passage money by my ship is high.",
      "source": "The Life of John the Kalybites part 1",
      "urn": "urn:cts:copticLit:lives.john_kalybites.budge:1-45",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲡⲁⲗⲓⲛ ϫⲉ**ⲥⲉⲃⲧⲉ**ⲛⲉⲧⲉⲛϩⲃⲏⲟⲩⲓ ϧⲉⲛⲡⲉⲧⲉⲛϫⲓⲛⲓ ⲉⲃⲟⲗ ϧⲉⲛⲥⲱⲙⲁ",
      "english": "And again: “Prepare your works for the departure of your soul from the body.”",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲉⲛⲧⲁϥ**ⲥⲟⲃⲧⲉ** ⲛⲧⲁϭⲓⲛⲃⲱⲕ ϣⲁⲣⲟϥ ⲉⲥⲟⲩⲁⲁⲃ ·",
      "english": "Thou it was Who didst prepare me to come unto Thee in a state of innoceney (or, holiness).",
      "source": "Dormition of John MERC.AD in Budge ed.",
      "urn": "urn:cts:copticLit:misc.dormition_john.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲛⲑⲟϥ ϥⲛⲁⲧⲁⲙⲉⲑⲏⲛⲟⲩ ⲉⲟⲩⲛⲓϣϯ ⲙⲙⲁ ⲉϥϭⲟⲥⲓ ⲉϥⲫⲟⲣϣ ⲉϥ**ⲥⲉⲃⲧⲱⲧ** ⲟⲩⲟϩ ⲥⲉⲃⲧⲱⲧϥ ⲛⲁⲛ ⲙⲙⲁⲩ .",
      "english": "He will himself show you a large upper room furnished and ready. Make ready for us there.'",
      "source": "Bohairic Gospel of Mark 14 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:14",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲣⲉⲡϫⲟⲉⲓⲥ ⲇⲉ ⲧⲁⲁⲥ ⲛⲁⲛ ⲉⲧⲣⲉⲩϩⲉ ⲉⲣⲟⲛ ⲉⲛⲣⲟⲉⲓⲥ · ⲁⲩⲱ ⲉⲛϯⲕⲁⲣⲡⲟⲥ ⲉⲛⲉⲓⲣⲉ ⲙⲡⲙⲉⲉⲩⲉ ⲛⲛⲉϥⲉⲛⲧⲟⲗⲏ · ⲉⲛ**ⲥⲃⲧⲱⲧ** ⲉⲧⲉϥⲁⲛⲁⲡⲁⲩⲥⲓⲥ ⲉⲧϩⲁⲉⲟⲟⲩ · ⲁⲩⲱ ⲉⲙⲛⲗⲁⲁⲩ ϯϫⲣⲟⲡ ⲛⲁⲛ :",
      "english": "Now the Lord gave this unto us that we might find ourselves keeping watch. And we must produce fruit, and labour in the remembrance of His commandments; and we must make ourselves ready for His glorious rest, and then nothing whatsoever shall give us offense;",
      "source": "On Mercy and Judgment",
      "urn": "urn:cts:copticLit:psathanasius.mercy_judgment.budge:1-41",
      "dialect": "sahidic"
    }
