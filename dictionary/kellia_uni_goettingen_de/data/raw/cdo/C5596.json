  "examples": [
    {
      "coptic": "ⲉϥϫⲱ ⲙⲙⲟⲥ ϫⲉⲁⲓϫⲓϣⲕⲁⲕ ⲉⲃⲟⲗ ϩⲛⲧⲁⲑⲗⲓⲯⲓⲥ ⲉϩⲣⲁⲓ ⲉⲡϫⲟⲉⲓⲥ ⲡⲁⲛⲟⲩⲧⲉ : ⲁϥⲥⲱⲧⲙ ⲉⲣⲟⲓ : **ⲁⲓⲱϣ **ⲉⲃⲟⲗ**** ⲉⲓⲛϩⲏⲧϥ ⲛⲁⲙⲛⲧⲉ : ⲁⲩⲱ ⲁⲕⲥⲱⲧⲙ ⲉⲡⲁϩⲣⲟⲟⲩ :",
      "english": "and said, I cried in my affliction to the Lord my God, and he hearkened to me, even to my cry out of the belly of hell: thou heardest my voice.",
      "source": "Jonah Chapter 2 (Sahidic)",
      "urn": "urn:cts:copticLit:ot.jonah.coptot_ed:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲥⲉⲛⲁⲟⲩⲱϣⲃ ⲧⲏⲣⲟⲩ **ⲉⲩⲱϣ **ⲉⲃⲟⲗ**** ⲙⲛⲡⲉⲡⲣⲟⲫⲏⲧⲏⲥ ⲇⲁⲩⲉⲓⲇ · ϫⲉⲡϫⲟⲉⲓⲥ ⲛϭⲟⲙ ⲛⲧⲟϥ ⲡⲉ ⲡⲣⲣⲟ ⲙⲡⲉⲟⲟⲩ · ⲡⲁⲓ ⲉⲧⲉⲡⲱϥ ⲡⲉ ⲡⲉⲟⲟⲩ ⲙⲛⲡⲁⲙⲁϩⲧⲉ ϣⲁⲉⲛⲉⲓⲉⲛⲉϩ ϩⲁⲙⲏⲛ · ◈ — ◈ — ◈ — ◈ — ◈ — ◈",
      "english": "And they all make answer, and cry out with the prophet David, The Lord of Might, He is the King of Glory/ unto Whom belong the Glory and the Power for [all] ages. Amen.",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧⲟⲧⲉ ⲙⲡⲛⲁⲩ ⲉⲧⲙⲙⲁⲩ · ϣⲁⲣⲉⲡⲉⲕⲣⲓⲧⲏⲥ **ⲱϣ **ⲉⲃⲟⲗ**** · ϫⲉⲛⲟⲩϫⲉ ⲙⲙⲟϥ ⲉⲡⲕⲁⲕⲉ ⲉⲧϩⲓⲃⲟⲗ · ϥⲛⲁϣⲱⲡⲉ ⲙⲙⲁⲩ ⲛϭⲓⲡⲣⲓⲙⲉ ⲁⲩⲱ ⲡϭⲁϩϭⲉϩ ⲛⲛⲟⲃϩⲉ ·",
      "english": "Then, at that moment, the Judge shall cry out, 'Cast him into the outer darkness, where there is weeping and gnashing of teeth.'",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    }
