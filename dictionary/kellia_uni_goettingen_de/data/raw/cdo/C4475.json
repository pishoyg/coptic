  "examples": [
    {
      "coptic": "ⲁⲓⲉⲓ ⲉⲣⲁⲧⲕ ⲡⲟⲩⲟⲉⲓⲛ ⲁⲩⲱ ⲡϣⲁϫⲉ ⲉⲛⲧⲁⲥϫⲟⲟϥ ⲛϭⲓⲧⲉⲕϭⲟⲙ ϫⲉⲁⲕϣⲱⲡⲉ ⲛⲁⲓ ⲛⲟⲩⲛⲁⲙ ⲉⲕⲛⲟⲩϩⲙ ⲙⲙⲟⲓ · ⲁⲩⲱ **ⲉⲕϯ **ⲛⲧⲟⲟⲧ**** ·",
      "english": "“and am come unto thee, O Light.' And the word which thy power hath spoken: 'Thou wert on my right hand, saving | and helping me,”",
      "source": "Pistis Sophia Book 2 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:10-19",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲟⲩⲱϣⲃ ⲇⲉ ⲛϭⲓⲑⲱⲙⲁⲥ ⲡⲉϫⲁϥ ϫⲉⲡⲁϫⲟⲉⲓⲥ ⲉⲧⲃⲉⲡϩⲩⲙⲛⲟⲥ ⲉⲛⲧⲁⲥϫⲟⲟϥ ⲛϭⲓⲧⲡⲓⲥⲧⲓⲥ ⲥⲟⲫⲓⲁ ϫⲉⲁⲥⲛⲟⲩϩⲙ ⲉⲃⲟⲗ ϩⲙⲡⲉⲭⲁⲟⲥ · ⲁⲧⲉⲕϭⲟⲙ ⲛⲟⲩⲟⲉⲓⲛ ⲡⲣⲟⲫⲏⲧⲉⲩⲉ ϩⲁⲣⲟϥ ⲙⲡⲓⲟⲩⲟⲉⲓϣ · ϩⲓⲧⲛⲥⲟⲗⲟⲙⲱⲛ ⲡϣⲏⲣⲉ ⲛⲇⲁⲩⲉⲓⲇ · ϩⲛⲛⲉϥⲱⲇⲏ ϫⲉⲁⲓⲛⲟⲩϩⲙ ⲉⲃⲟⲗ ϩⲛⲙⲙⲣⲣⲉ ⲁⲓⲡⲱⲧ ⲉⲣⲁⲧⲕ ⲡϫⲟⲉⲓⲥ ϫⲉⲁⲕϣⲱⲡⲉ ⲛⲁⲓ ⲛⲟⲩⲛⲁⲙ · ⲉⲕⲛⲟⲩϩⲙ ⲙⲙⲟⲓ · ⲁⲩⲱ ⲉⲕⲛⲟⲩϩⲙ ⲙⲙⲟⲓ ⲁⲩⲱ **ⲉⲕϯ **ⲛⲧⲟⲟⲧ**** ·",
      "english": "“Thomas answered and said: “My Lord, concerning the song which Pistis Sophia hath uttered, because she was saved out of the chaos, thy light-power prophesied aforetime thereon through Solomon, the son of David, in his Odes: 1. I am saved | from the bonds and am fled unto thee, O Lord. 2. For thou hast been on my right hand, saving me and helping me.”",
      "source": "Pistis Sophia Book 2 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:10-19",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁϥⲧⲁϩⲟⲓ ⲉⲣⲁⲧ ϩⲓϫⲛⲧⲉϥⲛⲟⲩⲛⲉ ϫⲉⲕⲁⲥ ⲉⲓⲉϥⲱⲧⲉ ⲉⲃⲟⲗ ⲙⲡⲉϥⲥⲡⲉⲣⲙⲁ · ⲁⲩⲱ ⲛⲧⲟⲕ ⲛⲉⲕⲙⲙⲁⲓ ⲡⲉ **ⲉⲕϯ **ⲛⲧⲟⲟⲧ**** : ϩⲣⲁⲓ ϩⲙⲙⲁ ⲛⲓⲙ · ⲁϥⲕⲱⲧⲉ ⲉⲣⲟⲓ ⲛϭⲓⲡⲉⲕⲣⲁⲛ · ⲁⲧⲉⲕⲟⲩⲛⲁⲙ ⲧⲁⲕⲉⲧⲙⲁⲧⲟⲩ ⲙⲡⲣⲉϥϫⲉⲡⲉⲧϩⲟⲟⲩ · ⲁⲧⲉⲕϭⲓϫ ⲕⲉϩⲧⲉϩⲓⲏ ⲛⲛⲉⲕⲡⲓⲥⲧⲟⲥ ·",
      "english": "“he hath set me up above its root, that I may extinguish its seed. 5. And thou wert with me, helping me; in all regions thy name surrounded me. 6. Thy right hand hath destroyed the venom of the slanderer; thy hand hath cleared the way for thy faithful.”",
      "source": "Pistis Sophia Book 2 Part 2",
      "urn": "urn:cts:copticLit:pistissophia.2.petermann:10-19",
      "dialect": "sahidic"
    }
  ],
