  "examples": [
    {
      "coptic": "ϫⲉⲁⲛⲅⲟⲩ **ⲥⲟϭ** ⲁⲛ · ⲁⲗⲗⲁ ⲁⲛⲅⲟⲩⲥⲁⲃⲉ ·",
      "english": "'I am not a fool; nay, I am a wise man.",
      "source": "Martyrdom of Victor part 7",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:67-85",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲱ ⲡⲁⲑⲏⲧ ⲁⲩⲱ ⲛ**ⲥⲟϭ** ⲉⲙⲁⲧⲉ · ⲛⲅⲥⲟⲟⲩⲛ ⲁⲛ ϫⲉⲉⲕϣⲁⲛⲉⲓ ⲉⲃⲟⲗ ϩⲛⲥⲱⲙⲁ · ⲛⲅⲟ ⲁⲛ ⲙⲡϫⲟⲉⲓⲥ ⲛⲟⲩϩⲟⲃⲟⲗⲟⲥ ⲛⲟⲩⲱⲧ · ⲟⲩⲇⲉ ⲙⲉⲣⲉⲣⲱⲙⲉ ⲣⲡⲉⲕⲙⲉⲉⲩⲉ ⲛⲕⲉⲥⲟⲡ ·",
      "english": "O thou senseless one, thou very great fool, dost thou not know that when thou shalt go forth from the body, thou wilt not be like even unto the man who is lord of one obolus? and moreover, no man will ever remember thee again.",
      "source": "Encomium on Victor part 2",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:32-55",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲧϩⲏⲇⲟⲛⲏ ⲅⲁⲣ ⲛⲧⲙⲛⲧⲁⲧⲥⲉⲓ ϣⲁⲥⲣⲡⲗⲟⲅⲓⲥⲙⲟⲥ ⲛ**ⲥⲟϭ** · ⲛⲥⲣⲧⲥⲩ ⲛⲏⲇⲏⲥⲓⲥ ⲛⲁⲧϣⲓⲡⲉ · ⲛⲥⲥⲱⲗⲡ ⲉⲃⲟⲗ ⲙⲡⲉⲭⲁⲗⲓⲛⲟⲥ ⲙⲡⲗⲁⲥ ·",
      "english": "For the pleasure which attendeth drinking in excess maketh a man of understanding- to become a fool, and it turneth the conscience into a shameless thing, and it setteth loose the bridle of the tongue.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 2",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:35-69",
      "dialect": "sahidic"
    }
  ],
