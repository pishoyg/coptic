      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:20-41",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲁⲓ ⲟⲛ ⲧⲉ ⲧϩⲉ ⲛⲧⲁϩⲁϩ ⲛϣⲏⲣⲉ ⲛ**ⲇⲓⲕⲁⲓⲟⲥ** ⲉⲩⲫⲣⲁⲛⲉ ⲙⲙⲟⲟⲩ ·",
      "english": "so also many just children bring them joy;",
      "source": "Abraham Our Father: YA 547-50",
      "urn": "urn:cts:copticLit:shenoute.abraham.monbya:37-42",
      "dialect": "sahidic"
