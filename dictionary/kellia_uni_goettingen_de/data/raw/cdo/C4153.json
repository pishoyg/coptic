  "examples": [
    {
      "coptic": "ϩⲱⲥⲧⲉ ⲙⲡⲉⲣϯϩⲁⲡ ⲉϩⲗⲓ ϧⲁⲧϩⲏ ⲙⲡⲓⲥⲏⲟⲩ ϣⲁⲧⲉϥⲓ ⲛϫⲉⲡϭⲟⲓⲥ ⲫⲏ ⲉⲑⲛⲁⲑⲣⲉⲛⲏ ⲉⲧϩⲏⲡ ⲛⲧⲉⲡⲭⲁⲕⲓ ⲉⲣⲟⲩⲱⲓⲛⲓ ⲟⲩⲟϩ ⲛⲧⲉϥⲟⲩⲟⲛϩ ⲉⲃⲟⲗ ⲛⲛⲓⲥⲟϭⲛⲓ ⲛⲧⲉⲛⲓϩⲏⲧ ⲟⲩⲟϩ ⲧⲟⲧⲉ ⲉⲣⲉⲡ**ⲧⲁⲓⲟ** ⲙⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ϣⲱⲡⲓ ⲛⲁϥ ⲉⲃⲟⲗ ϩⲓⲧⲉⲛⲫⲛⲟⲩϯ .",
      "english": "Therefore judge nothing before the time, until the Lord comes, who will both bring to light the hidden things of darkness, and reveal the counsels of the hearts. Then each man will get his praise from God.",
      "source": "Bohairic 1 Corinthians 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.1cor.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲉⲩϣⲁⲛⲡⲱⲛⲅ ⲛⲁⲓ ⲁϫⲛϯⲥⲟ ϫⲉϯⲟ ϩⲱⲱⲧ ⲛϩⲙϩⲁⲗ ⲛⲁⲩ ⲕⲁⲗⲱⲥ ϫⲉⲛⲁⲥⲛⲏⲩ ⲛⲉ ⲉⲓⲥⲱⲟⲩϩⲛⲁⲩ ⲉϩⲟⲩⲛ ⲉϩⲉⲛⲁϩⲟ ϩⲛⲧⲡⲉ ⲛⲛⲉⲧⲟⲩϯ ⲙⲙⲟⲟⲩ ⲛ**ⲧⲁⲉⲓⲟ** ⲙⲡⲛⲟⲩⲧⲉ .",
      "english": "if they transfer over to me without restraint—for I too am a good servant to them, for they are my brothers, gathering for them into treasures in heaven, the things that they give in honour of God—",
      "source": "Not Because a Fox Barks: XH 204-216",
      "urn": "urn:cts:copticLit:shenoute.fox.monbxh_204_216",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲉⲧⲟⲩⲁⲁⲃ ⲧⲏⲣⲟⲩ ⲛⲁⲛⲁⲩ ⲉⲡ**ⲧⲁⲉⲓⲟ** ⲉϯⲛⲁⲧⲁⲁϥ ⲛⲁⲕ ⲱ ⲡⲁⲙⲉⲣⲓⲧ ⲓⲱϩⲁⲛⲛⲏⲥ ·",
