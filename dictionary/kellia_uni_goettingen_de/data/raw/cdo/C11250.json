  "examples": [
    {
      "coptic": "ⲁⲗⲗⲁ **ϩⲩⲡⲟⲧⲁⲥⲥⲉ** ⲙⲡⲉⲡⲛⲉⲩⲙⲁ ⲛⲧⲙⲛⲧϩⲏⲕⲉ ⲉⲧⲃⲉⲡⲉⲭⲣⲓⲥⲧⲟⲥ ·",
      "english": "But humble yourself in the spirit of poverty on account of Christ.",
      "source": "Apophthegmata Patrum Sahidic 129: N 331",
      "urn": "urn:cts:copticLit:ap.129.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲟⲧⲁⲛ ⲇⲉ ⲉⲣϣⲁⲛⲛⲕⲁ ⲛⲓⲙ ϩⲩⲡⲟⲧⲁⲥⲥⲉ ⲛⲁϥ . ⲧⲟⲧⲉ ⲛⲧⲟϥ ⲡϣⲏⲣⲉ ϥⲛⲁ**ϩⲩⲡⲟⲧⲁⲥⲥⲉ** ⲙⲡⲉⲛⲧⲁϥⲧⲣⲉⲛⲕⲁ ⲛⲓⲙ ϩⲩⲡⲟⲧⲁⲥⲥⲉ ⲛⲁϥ . ϫⲉⲕⲁⲁⲥ ⲉⲣⲉⲡⲛⲟⲩⲧⲉ ϣⲱⲡⲉ ⲉⲡⲧⲏⲣϥ ⲡⲉ ⲉϥϩⲙⲡⲧⲏⲣϥ .",
      "english": "When all things have been subjected to him, then the Son will also himself be subjected to him who subjected all things to him, that God may be all in all.",
      "source": "1 Corinthians 15",
      "urn": "urn:cts:copticLit:nt.1cor.sahidica_ed:15",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲡϩⲗⲗⲟ ⲇⲉ ⲛⲁϥ ϫⲉⲃⲱⲕ ⲛⲅⲑⲃⲃⲓⲉ ⲡⲉⲕϩⲏⲧ ⲛⲅϭⲱ ⲙⲛϩⲛⲕⲟⲟⲩⲉ ⲉⲕ**ϩⲩⲡⲟⲧⲁⲥⲥⲉ** ⲛⲁⲩ ·ⲻ",
      "english": "And the old man said to him: “Go and humble your heart and stay with others while obeying them.”",
      "source": "Apophthegmata Patrum Sahidic 034: Theodorus",
      "urn": "urn:cts:copticLit:ap.34.monbeg",
      "dialect": "sahidic"
    }
