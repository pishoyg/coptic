  "examples": [
    {
      "coptic": "ⲙⲉⲛⲉⲛⲥⲁⲡⲁⲓ**ⲡⲟⲗⲉⲙⲟⲥ** ⲉⲑⲛⲁϣⲧ ⲉⲧⲭⲏ ϧⲁϫⲱϥ ⲁⲫⲛⲟⲩϯ ⲉⲣϩⲙⲟⲧ ⲛⲁϥ ⲛϩⲁⲛⲧⲁⲗϭⲟ ⲉⲩⲟϣ .",
      "english": "After this hard battle that he had to endure, God gave him the grace of many healings.",
      "source": "Life of Isaac of Alexandria - part 1",
      "urn": "urn:cts:copticLit:lives.boh_isaac.amelineau_ed:1-19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϩⲓⲧⲛ ⲙ**ⲡⲟⲗⲉⲙⲟⲥ** ⲅⲁⲣ ⲉϣⲁⲣⲉⲧⲉⲯⲩⲭⲏ ⲡⲣⲟⲕⲟⲡⲧⲉⲓ ·",
      "english": "For, through struggles the soul shall progress.'",
      "source": "Apophthegmata Patrum Sahidic 037",
      "urn": "urn:cts:copticLit:ap.37.monbeg",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϩⲟⲧⲁⲛ ⲇⲉ ⲁⲣⲉⲧⲉⲛϣⲁⲛⲥⲱⲧⲉⲙ ⲉϩⲁⲛ**ⲡⲟⲗⲉⲙⲟⲥ** ⲛⲉⲙϩⲁⲛⲥⲙⲏ ⲙⲡⲟⲗⲉⲙⲟⲥ ⲙⲡⲣϣⲑⲟⲣⲧⲉⲣ ϩⲱϯ ⲡⲉ ⲛⲧⲟⲩϣⲱⲡⲓ ⲁⲗⲗⲁ ⲙⲡⲁⲧϥⲓ ⲛϫⲉⲡⲓϫⲱⲕ .",
      "english": "When you hear of wars and rumors of wars, don't be troubled. For those must happen, but the end is not yet.",
      "source": "Bohairic Gospel of Mark 13 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:13",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲧⲛϣⲟⲟⲡ ϩⲛⲟⲩⲛⲟϭ ⲙ**ⲡⲟⲗⲉⲙⲟⲥ** ϩⲙⲡⲉⲓⲃⲓⲟⲥ ·",
      "english": "’ In this life we are in a mighty war.",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ϭⲓ ⲛⲱⲧⲉⲛ ⲛϩⲁⲛϩⲟⲡⲗⲟⲛ ⲛⲉⲙϩⲁⲛⲥⲃⲁⲓϩ ⲟⲩⲟϩ ⲑⲱⲟⲩϯ ⲉⲡ**ⲡⲟⲗⲉⲙⲟⲥ** .",
      "english": "Take up arms and spears, and draw nigh to battle;",
      "source": "24_Ieremias_26",
      "urn": "urn:cts:copticLit:ot.jer.bohairic_ed:26",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϫⲉⲛⲧⲕⲟⲩⲛⲟⲩⲧⲉ ⲉϥⲟⲛϩ ⲱ ⲡⲁⲡⲟⲗⲗⲱⲛ ⲡⲛⲟϭ ⲛⲛⲟⲩⲧⲉ · ⲡⲁⲓ ⲉⲧϯ ⲛⲁⲛ ⲙⲡⲉϫⲣⲟ ϩⲙⲡ**ⲡⲟⲗⲉⲙⲟⲥ** ·",
      "english": "Thou art the god who livest, O Apollo, the greatest of the gods, who dost give unto us victory in war.",
      "source": "Martyrdom of Victor part 1",
      "urn": "urn:cts:copticLit:martyrdoms.victor.budge:1-6",
      "dialect": "sahidic"
    }
