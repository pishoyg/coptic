  "examples": [
    {
      "coptic": "ⲕⲁⲓ ⲅⲁⲣ ⲛⲏ ⲉⲧⲁⲩⲥϧⲉⲕⲉϫⲱⲙ ⲛⲧⲉⲛⲉⲛⲓⲟϯ ⲉⲧϧⲉⲛⲛⲓⲅⲣⲁⲫⲏ ⲉⲑⲟⲩⲁⲃ ⲓⲥϫⲉⲛ ⲁⲇⲁⲙ ϣⲁⲁⲃⲣⲁⲁⲙ ⲛⲉⲙⲛⲏ ⲉⲧⲁⲩⲓ ⲙⲉⲛⲉⲛⲥⲱⲟⲩ ϣⲁⲉϧⲟⲩⲛ ⲉⲫⲟⲟⲩ ⲉⲧⲁⲩⲥϧⲁⲓ ⲁⲛ ϫⲉϩⲓⲛⲁ ⲛⲧⲟⲩϯⲱⲟⲩ ⲛⲛⲏ ⲉⲧⲁⲩⲥϧⲁⲓ ⲁⲗⲗⲁ ϫⲉⲛⲧⲟⲩϫⲉⲙϩⲏⲟⲩ ⲛϫⲉⲛⲏ ⲉⲑⲛⲁⲱϣ ⲙⲙⲱⲟⲩ ⲁⲩϣⲁⲛ**ⲭⲟϩ** ⲉⲡⲟⲩϫⲓⲛⲱⲛϧ",
      "english": "For those who wrote books about our Fathers, from Adam to Abraham, and about those who followed up to the present day as found in the Scriptures, did not write to bring glory to those about whom they wrote but to provide benefit to those who would read, so that they might emulate their lives.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲇⲓⲁⲃⲟⲗⲟⲥ ⲁϥ**ⲕⲱϩ** ⲙⲡⲉⲟⲩⲟⲉⲓϣ ⲉⲧⲙⲙⲁⲩ · ⲉⲡⲃⲉⲉⲕⲉ ϯϫⲡⲟ ⲙⲙⲟϥ · ⲙⲡⲙⲧⲟ ⲉⲃⲟⲗ ⲙⲡϫⲟⲉⲓⲥ ϩⲁⲡⲉⲧⲉⲓⲣⲉ ⲙⲙⲟϥ ⲛⲛϣⲙⲙⲟ · ⲙⲛⲛⲕⲟⲟⲩⲉ · ⲉⲧⲣϭⲣⲱⲱϩ · ⲉϥⲛⲁⲩ ⲉⲧϩⲉ ⲉⲧⲓⲥⲡⲟⲩⲇⲁⲍⲉ ⲉⲡⲁϩⲱⲃ ⲛϭⲓϫ ·",
      "english": "At that time the Devil became envious of me, because of the wages which I was earning before the Lord in respect of what I did for strangers and for other folk who were in want; for he saw how diligent I was in manual labour,",
      "source": "Life of Onnophrius part 1",
      "urn": "urn:cts:copticLit:lives.onnophrius.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲥⲉϣⲱⲡⲓ ⲛⲁϥ ⲛⲉⲙⲡⲉϥϫⲣⲟϫ ⲙⲉⲛⲉⲛⲥⲱϥ ⲉⲩⲇⲓⲁⲑⲏⲕⲏ ⲛⲧⲉⲟⲩⲙⲉⲧⲟⲩⲏⲃ ϣⲁⲉⲛⲉϩ ⲉⲫⲙⲁ ϫⲉⲁϥ**ⲭⲟϩ** ϧⲉⲛⲡⲉϥⲛⲟⲩϯ ⲟⲩⲟϩ ⲁϥⲉⲣⲣⲉϥⲛⲟϩⲉⲙ ⲛⲧⲉⲛⲉⲛϣⲏⲣⲓ ⲙⲡⲓⲥⲣⲁⲏⲗ",
      "english": "and he and his seed after him shall have a perpetual covenant of priesthood, because he was zealous for his God, and made atonement for the children of Israel.",
      "source": "04_Numeri_25",
      "urn": "urn:cts:copticLit:ot.num.bohairic_ed:25",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲡⲁϣⲏⲣⲉ **ⲕⲱϩ** ⲉⲡⲃⲓⲟⲥ ⲛⲛⲉⲧⲟⲩⲁⲁⲃ ⲛⲅⲡⲟⲗⲩⲧⲉⲩⲉ ϩⲛⲛⲉⲩⲁⲣⲉⲧⲏ",
      "english": "My son, emulate the lives of the saints, and follow closely their virtues in thy life and conversation.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲙⲡⲉⲣ**ⲭⲟϩ** ⲉⲛⲏⲉⲧⲓⲣⲓ ⲙⲡⲓⲡⲉⲧϩⲱⲟⲩ: ⲟⲩⲇⲉ ⲙⲡⲉⲣⲭⲟϩ ⲉⲛⲏⲉⲧⲓⲣⲓ ⲛϯⲁⲛⲟⲙⲓⲁ: ϫⲉⲙⲫⲣⲏϯ ⲛⲟⲩⲥⲓⲙ ⲥⲉⲛⲁϣⲱⲟⲩⲓ ⲛⲭⲱⲗⲉⲙ: ⲟⲩⲟϩ ⲥⲉⲛⲁϩⲉⲓ ⲉⲃⲟⲗ ⲛⲭⲱⲗⲉⲙ ⲙⲫⲣⲏϯ ⲛϩⲁⲛⲟⲩⲟϯ ⲉⲩⲟⲩⲉⲧⲟⲩⲱⲧ .",
      "english": "Fret not thyself because of evil-doers, neither be envious of them that do iniquity.",
      "source": "19_Psalmi_36",
      "urn": "urn:cts:copticLit:ot.pss.bohairic_ed:36",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲙⲁⲣⲛ**ⲕⲱϩ** ⲉⲡⲃⲓⲟⲥ ⲛⲛⲉⲛⲉⲓⲟⲟⲧⲉ · ⲛϣⲟⲣⲡ ⲉⲛⲙⲏⲛ ⲉⲃⲟⲗ ϩⲛⲟⲩϩⲩⲡⲟⲙⲟⲛⲏ ·",
      "english": "Let us emulate the life of our fathers, and first of all let us continue in patient endurance.",
      "source": "The Asceticon of Apa Ephrem part 1",
      "urn": "urn:cts:copticLit:psephrem.asceticon.budge:1-23",
