  "examples": [
    {
      "coptic": "**ⲉⲕϣⲁⲛⲙⲟⲟϣⲉ **ⲙⲛ**ⲟⲩⲥⲟⲛ** ⲉⲣⲉⲟⲩⲥⲁⲛⲇⲁⲗⲓⲟⲛ ϩⲛⲛⲉⲕⲟⲩⲣⲏⲏⲧⲉ · ⲉⲙⲛⲟⲩⲟⲛ ⲙⲡⲉⲧⲙⲟⲟϣⲉ ⲛⲙⲙⲁⲕ · ⲁⲛⲓ ⲡⲱⲕ ϩⲱⲱⲕ ⲉⲃⲟⲗ ⲛⲅⲙⲟⲟϣⲉ ⲛⲧⲉϥϩⲉ ·",
      "english": "If thou art wearing sandals on thy feet, and he who is walking with thee hath none, take off thy sandals, and walk as he is doing,",
      "source": "Letter of pseudo-Ephrem MERC.AT 126-134",
      "urn": "urn:cts:copticLit:psephrem.letter.budge:1-9",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲛⲟⲉⲙⲓⲛ ⲡⲉϫⲁⲥ ⲛϩⲣⲟⲩⲑ ⲧⲉⲥϣⲉⲗⲉⲉⲧ ϫⲉⲟⲩⲁⲅⲁⲑⲟⲛ ⲛⲉ ⲡⲉ ⲧⲁϣⲉⲉⲣⲉ **ϫⲉⲁⲙⲟⲟϣⲉ **ⲙⲛ**ⲛⲉϥϣⲉⲉⲣⲉ** ϣⲏⲙ ϫⲉⲛⲛⲉⲩⲧⲁϩⲟ ϩⲛⲕⲉⲥⲱϣⲉ",
      "english": "And Noemin said to Ruth her daughter-in-law, It is well, daughter, that thou wentest out with his damsels; thus they shall not meet thee in another field.",
      "source": "Ruth Chapter 2",
      "urn": "urn:cts:copticLit:ot.ruth.coptot_ed:2",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉⲃⲟⲗ ϫⲉⲡⲟⲩⲣⲟⲧ **ⲙⲟⲟϣⲉ **ⲙⲛ**ⲡⲉⲧⲑⲃⲃⲓⲏⲩ** · ⲁⲩⲱ ⲕⲛⲁⲥⲉⲓ ⲛⲧϩⲉ ⲉⲧⲉⲣⲉⲧⲉⲕⲯⲩⲭⲏ ⲟⲩⲁϣⲥ ·",
      "english": "For gladness goeth with him that is humble, and thou shalt be satisfied with whatsoever thy soul desireth.",
      "source": "Instructions of Apa Pachomius in MERC.AR in Budge ed. - part 1",
      "urn": "urn:cts:copticLit:pachomius.instructions.budge:1-34",
      "dialect": "sahidic"
    }
  ],
