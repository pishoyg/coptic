  "examples": [
    {
      "coptic": "ⲡϣⲁϫⲉ ⲙⲉⲛ ⲉⲧⲟⲩⲧⲛⲛⲟⲟⲩ ⲙⲙⲟϥ ϩⲛⲙⲡⲏⲩⲉ ⲙⲛⲡⲑⲟⲛⲟⲥ ⲛϩⲏⲧϥ · ⲡⲁⲓ ⲉⲧⲥⲃⲧⲱⲧ ⲉ**ϫⲱⲕⲣ** ⲛⲛⲉⲧⲙⲯⲩⲭⲏ · ⲛⲧⲱⲧⲛ ϩⲱⲧⲧⲏⲩⲧⲛ ϣⲱⲡⲉ ⲉⲧⲉⲧⲛⲥⲃⲧⲱⲧ ⲡⲣⲟⲥⲧϭⲟⲙ ⲙⲡϣⲁϫⲉ · ⲁⲗⲗⲁ ⲥⲉⲣⲭⲣⲉⲓⲁ ⲟⲛ ⲙⲡⲉⲧⲥⲱⲧⲙ ·",
      "english": "Now the word which hath been sent from heaven hath no ill-will (or, grudging) therein, and it is ready to cleanse that which is in the soul, provided that ye yourselves be prepared for the strength of the word, which, however, hath also need of him that listeneth.",
      "source": "On the Soul and Body",
      "urn": "urn:cts:copticLit:psathanasius.soul_body.budge:1-91",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲉϥⲟ ⲛϩⲙⲟⲩ ⲉϥ**ϫⲱⲕⲣ** ⲛⲟⲩⲟⲛ ⲛⲓⲙ ⲕⲁⲧⲁⲡⲉⲧⲥⲏϩ ϩⲙⲡⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ϫⲉⲛⲧⲱⲧⲛ ⲡⲉ ⲡⲉϩⲙⲟⲩ ⲙⲡⲕⲁϩ ·",
      "english": "He was salt which was purified for every one, according to that which is written in the Gospel, 'Ye are the salt of the earth.",
      "source": "Life of Pisentius part 1",
      "urn": "urn:cts:copticLit:lives.pisentius.budge:1-31",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲅϣⲱⲡⲉ ⲉⲕ**ϫⲟⲕⲣ** ϩⲙⲡⲉϩⲙⲟⲩ ⲙⲡⲉⲭⲣⲓⲥⲧⲟⲥ · ⲻ",
