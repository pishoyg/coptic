  "examples": [
    {
      "coptic": "ⲫⲏ ⲉⲛⲁⲩ**ⲥⲟϭⲛⲓ** ϧⲁⲣⲟϥ ⲉⲩϩⲱⲟⲩϣ ⲉⲣⲟϥ ⲟⲩⲟϩ ⲉⲩⲙⲃⲟⲛ ⲉⲣⲟϥ ⲛϫⲉϩⲁⲛϭⲟⲓⲥ ⲛⲧⲉϩⲁⲛⲫⲓϯ",
      "english": "Against whom men taking evil counsel reproached , and the archers pressed hard upon him.",
      "source": "01_Genesis_49",
      "urn": "urn:cts:copticLit:ot.gen.bohairic_ed:49",
      "dialect": "bohairic"
    },
    {
      "coptic": "ϯϫⲓ **ϣⲟϫⲛⲉ** ⲛⲁⲕ ⲉϣⲉⲡ ⲟⲩⲛⲟⲩⲃ ⲛⲧⲟⲟⲧⲉϥⲡⲟⲥⲉ ϩⲛⲟⲩⲕⲱϩⲧ ϫⲉⲕⲁⲁⲥ ⲉⲕⲉⲣⲣⲙⲙⲁⲟ ⲁⲩⲱ ϩⲉⲛϩⲟⲓⲧⲉ ⲛⲟⲩⲟⲃϣ ϫⲉⲉⲕⲉⲧⲁⲁⲩ ϩⲓⲱⲕ ⲛⲉϥⲧⲙⲟⲩⲱⲛϩ ⲉⲃⲟⲗ ⲛϭⲓⲡϣⲓⲡⲉ ⲙⲡⲉⲕⲕⲱ ⲕⲁϩⲏⲩ ⲁⲩⲱ ⲟⲩⲡⲁϩⲣⲉ ⲉϯ ⲉⲛⲉⲕⲃⲁⲗ ϫⲉⲉⲕⲉⲛⲁⲩ ⲉⲃⲟⲗ .",
      "english": "I counsel you to buy from me gold refined by fire, that you may become rich; and white garments, that you may clothe yourself, and that the shame of your nakedness may not be revealed; and eye salve to anoint your eyes, that you may see.",
      "source": "66_Revelation_3",
      "urn": "urn:cts:copticLit:nt.rev.sahidica:3",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ ⲉⲥⲉϣⲱⲡⲓ ⲛϫⲉⲧⲭⲱⲣⲁ ⲛⲛⲓⲓⲟⲩⲇⲁⲓ ⲛⲟⲩϩⲟϯ ⲛⲛⲓⲣⲉⲙⲛⲭⲏⲙⲓ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉⲑⲛⲁϫⲉ ⲡⲉⲥⲣⲁⲛ ⲛⲱⲟⲩ ⲉⲩⲉⲉⲣϩⲟϯ ⲉⲑⲃⲉⲡⲓⲥⲟϭⲛⲓ ⲉⲧⲁ ⲡϭⲥ **ⲥⲟϭⲛⲓ** ⲙⲙⲟϥ ⲉϫⲱⲟⲩ .",
      "english": "And the land of the Jews shall be for a terror to the Egyptians: whosoever shall name it to them, they shall fear, because of the counsel which the Lord of hosts has purposed concerning it.",
      "source": "23_Isaias_19",
      "urn": "urn:cts:copticLit:ot.isa.bohairic_ed:19",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ ⲡϣⲏⲣⲉ ⲛⲁⲣⲁⲙ ⲙⲛⲡϣⲏⲣⲉ ⲛϩⲣⲟⲙⲉⲗⲓⲁⲥ ϫⲉⲁⲩ**ϣⲟϫⲛⲉ** ⲛⲟⲩϣⲟϫⲛⲉ ⲉϥϩⲟⲟⲩ ⲉⲣⲟⲕ ⲉⲩϫⲱ ⲙⲙⲟⲥ ϫⲉ",
      "english": "And as for the son of Aram, and the son of Romelias, forasmuch as they have devised an evil counsel, saying,",
      "source": "Isaiah 7",
      "urn": "urn:cts:copticLit:ot.isa.coptot:7",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲛⲑⲱⲧⲉⲛ ⲅⲁⲣ ⲁⲣⲉⲧⲉⲛⲥⲟϭⲛⲓ ϧⲁⲣⲟⲓ ⲛϩⲁⲛⲡⲉⲧϩⲱⲟⲩ ⲫⲛⲟⲩϯ ⲇⲉ ⲁϥ**ⲥⲟϭⲛⲓ** ⲉⲑⲃⲏⲧⲛϩⲁⲛⲡⲉⲑⲛⲁⲛⲉⲩ ϣⲁⲧⲉⲧⲉⲛϣⲱⲡⲓ ϣⲁⲉϧⲟⲩⲛ ⲉⲫⲟⲟⲩ ϩⲓⲛⲁ ⲛⲧⲉϥϣⲁⲛϣ ⲛϫⲉⲟⲩⲙⲏϣ ⲉϥⲟϣ ⲛⲱⲧⲉⲛ",
      "english": "Ye took counsel against me for evil, but God took counsel for me for good, that the matter might be as it is to-day, and much people might be fed.",
