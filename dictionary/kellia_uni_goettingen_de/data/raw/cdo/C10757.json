  "examples": [
    {
      "coptic": "ⲁϫⲓⲥ ⲉⲣⲟⲛ ⲱ ⲡⲕⲁϩ ϫⲉⲉⲧⲃⲉⲟⲩ ⲁⲕⲥⲧⲱⲧ ⲉⲣⲉⲛⲉⲓⲣⲉϥⲙⲓϣⲉ ⲟⲩⲃⲉⲡⲛⲟⲩⲧⲉ ⲉⲓⲣⲉ ⲛⲧⲉⲓⲛⲟϭ ⲛ**ⲧⲟⲗⲙⲏⲣⲓⲁ** ·",
      "english": "(I will also enquire of the earth.) Tell us, O Earth: For what reason didst thou quake when these fighters against God committed this abominable deed of presumption?",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲩⲱ ϯⲛⲁⲡⲁⲧⲁⲥⲥⲉⲓ ⲛⲛⲉⲕⲃⲱ ⲛⲉⲗⲟⲟⲗⲉ ⲧⲙϯⲕⲁⲣⲡⲟⲥ ⲉⲧⲃⲉⲧⲉⲕ**ⲧⲟⲗⲙⲏⲣⲓⲁ** ·",
      "english": "And I will destroy thy vineyard also, and it shall not yield thee its fruit because of thy audacity.",
      "source": "Encomium on Victor part 3",
      "urn": "urn:cts:copticLit:pscelestinus.encomium.budge:56-103",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲁⲡⲥⲱⲛⲧ ϣⲧⲟⲣⲧⲣ ϩⲛⲟⲩϭⲱⲛⲧ ⲉϩⲣⲁⲓ ⲉϫⲛⲧ**ⲧⲟⲗⲙⲏⲣⲓⲁ** ⲛⲛⲓⲟⲩⲇⲁⲓ ⲉⲧⲥⲟⲟϥ ·",
      "english": "The whole of creation was moved with wrath because of the abominable insolence of the Jews.",
      "source": "On the Soul and Body",
      "urn": "urn:cts:copticLit:psathanasius.soul_body.budge:1-91",
      "dialect": "sahidic"
    }
