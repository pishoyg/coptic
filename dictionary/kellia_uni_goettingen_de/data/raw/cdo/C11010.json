  "examples": [
    {
      "coptic": "ⲛⲑⲟⲕ ⲇⲉ ⲓⲧⲉ ⲉⲕⲟⲩⲱⲙ ⲟⲩⲱⲙ ϧⲉⲛⲡⲉⲕⲟⲩⲱϣ ⲓⲧⲉ ⲉⲕⲁⲙⲟⲛⲓ ⲛⲧⲟⲧⲕ ⲥⲁⲃⲟⲗ ⲙⲡⲓⲟⲩⲱⲙ ⲁⲙⲟⲛⲓ ϧⲉⲛⲡⲉⲕⲉⲣϣⲓϣⲓ **ⲭⲱⲣⲓⲥ**ⲁⲛⲁϣ ⲟⲩⲟϩ ⲛⲛⲉⲕⲉⲣⲛⲟⲃⲓ ⲉⲛⲉϩ",
      "english": "Therefore, if you eat, eat according to your will; if you refrain from eating, refrain according to your ability without making an oath, and may you never sin.",
      "source": "Bohairic Lausiac History - Part 1",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:0",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲣⲁ **ⲭⲱⲣⲓⲥ**ⲧⲙⲛⲧⲣⲱⲙⲉ ·",
      "english": "Will it be without (His) manhood?",
      "source": "Proclus Homily 13 on Easter in Budge ed.",
      "urn": "urn:cts:copticLit:proclus.homily13.budge",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲟⲩⲟϩ **ⲭⲱⲣⲓⲥ** ⲡⲁⲣⲁⲃⲟⲗⲏ ⲛⲁϥⲥⲁϫⲓ ⲛⲉⲙⲱⲟⲩ ⲁⲛ ⲡⲉ ⲥⲁⲡⲥⲁ ⲇⲉ ⲛⲁϥⲃⲱⲗ ⲙⲡⲧⲏⲣϥ ⲉⲛⲉϥⲙⲁⲑⲏⲧⲏⲥ .",
      "english": "Without a parable he didn't speak to them; but privately to his own disciples he explained everything.",
      "source": "Bohairic Gospel of Mark 4 (Digital Edition)",
      "urn": "urn:cts:copticLit:nt.mark.bohairic_ed:4",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲭⲱⲣⲓⲥ ⲕⲁⲧⲏⲅⲟⲣⲟⲥ **ⲭⲱⲣⲓⲥ** ⲁⲡⲟⲇⲓⲝⲓⲥ ·",
      "english": "and without an advocate, and without proofs,",
      "source": "On Penitence and Abstinence, part 1",
      "urn": "urn:cts:copticLit:johnconst.penitence.budge:1-119",
      "dialect": "sahidic"
    },
    {
      "coptic": "ⲡⲉϫⲉⲁⲡⲁ ⲉⲩⲁⲅⲣⲓ ⲛⲁϥ ϫⲉⲉⲛⲉⲙⲡⲉϥϭⲓⲕⲁϯ ⲛⲣⲱⲙⲓ ⲡⲉ ⲛⲁϥⲛⲁϭⲓⲥⲁⲣⲝ ⲛⲣⲱⲙⲓ ⲁⲛ ⲟⲛ ⲡⲉ ⲓⲉ ϫⲉⲟⲩⲛ ⲁϥϭⲓⲥⲁⲣⲝ ⲛⲣⲱⲙⲓ ⲉⲃⲟⲗ ϧⲉⲛⲙⲁⲣⲓⲁ ϯⲡⲁⲣⲑⲉⲛⲟⲥ ⲉⲑⲟⲩⲁⲃ ⲓⲉ ⲁϥⲉⲣⲣⲱⲙⲓ ⲟⲛ ⲛⲉⲙⲯⲩⲭⲏ ⲛⲉⲙⲟⲩⲕⲁϯ ⲉϥϫⲏⲕ ⲉⲃⲟⲗ ϧⲉⲛϩⲱⲃ ⲛⲓⲃⲉⲛ ⲛⲧⲉϯⲙⲉⲧⲣⲱⲙⲓ ϣⲁⲧⲉⲛⲫⲛⲟⲃⲓ ⲙⲙⲁⲩⲁⲧϥ ⲙⲙⲟⲛ ϣϫⲟⲙ ⲅⲁⲣ ⲛⲧⲉⲡⲥⲱⲙⲁ ϣⲱⲡⲓ ....... ⲉⲯⲩⲭⲏ ⲛⲉⲙⲕⲁϯ ⲓⲥϫⲉ ⲇⲉ ⲙⲡⲉϥϭⲓ ⲛⲛⲁⲓ ⲓⲉ ⲉⲩⲙⲟⲩϯ ⲉⲣⲟϥ ⲉⲫⲗⲏⲟⲩ ϫⲉⲛⲭⲣⲓⲥⲧⲟⲥ ⲡⲗⲟⲅⲟⲥ ⲟⲩⲛ ⲛⲁⲧϣⲓⲃϯ ⲡⲓⲙⲟⲛⲟⲅⲉⲛⲏⲥ ⲛϣⲏⲣⲓ ⲛⲧⲉⲫⲓⲱⲧ ⲁϥϭⲓⲥⲱⲙⲁ ⲛⲣⲱⲙⲓ ⲛⲉⲙⲯⲩⲭⲏ ⲛⲉⲙⲕⲁϯ ⲛⲉⲙϩⲱⲃ ⲛⲓⲃⲉⲛ ⲛⲧⲉϯⲙⲉⲧⲣⲱⲙⲓ **ⲭⲱⲣⲓⲥ** ⲫⲛⲟⲃⲓ .",
      "english": "Apa Evagrius said: ‘If He had not accepted the human spirit, He would not have taken on human flesh; for the Blessed Virgin Mary did not bear one without a human soul. In every human work, free from sin, this was fitting. For it is not possible that there be a body [….] soul and spirit. For unless He had received these, Christ would be called in vain. Therefore, the immutable Word, the Only-Begotten Son of the Father, assumed a human body, as well as a soul, spirit, and all things human, without sin.",
      "source": "Bohairic Lausiac History - Part 3",
      "urn": "urn:cts:copticLit:lausiac.boh_lausiac.amelineau_ed:38",
      "dialect": "bohairic"
    },
    {
      "coptic": "ⲁⲩⲱ **ⲭⲱⲣⲓⲥ**ⲛⲁⲓ ϩⲉⲛϣⲏⲣⲉ ϣⲏⲙ ⲏ ϭⲉⲗⲁⲁⲩ ⲛⲣⲱⲙⲉ ⲉⲩϣⲁⲛⲥⲣⲣⲁⲧⲟⲩ ⲉϩⲣⲁⲓ ϩⲛⲗⲁⲁⲩ ⲛϩⲛⲁⲁⲩ ⲛⲧⲉⲓⲙⲓⲛⲉ ⲉⲩⲉϣⲱⲡⲉ ⲉⲩⲥϩⲟⲩⲟⲣⲧ",
      "english": "Apart from these, children or anyone else, if they defecate into any vessels of this sort, let them be accursed.",
